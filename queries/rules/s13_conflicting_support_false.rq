# rule:      S13
# name:      Conflicting Support (False)
# section:   Core GSN
# operation: rule
# expect:    insert
# swrl:      Solution(?A) ^ Solution(?B) ^ true(?B, false) ^ 'supported by'(?C, ?B) ^ true(?A,
#            true) ^ 'supported by'(?C, ?A) -> true(?C, false)
# reads:     IF A and B are Solutions AND B is NOT true AND B supports C AND A is true AND A
#            supports C THEN C is NOT true

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?C gsn:true ?old }
INSERT { ?C gsn:true false }
WHERE {
  ?A a gsn:Solution ; gsn:true ?tA .
  FILTER(STR(?tA) = "true")
  ?B a gsn:Solution ; gsn:true ?tB .
  FILTER(STR(?tB) = "false")
  ?C gsn:supportedBy ?A , ?B .
  OPTIONAL { ?C gsn:true ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
