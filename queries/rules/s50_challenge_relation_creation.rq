# rule:      S50
# name:      Challenge Relation Creation
# section:   Dialectic Extension
# operation: rule
# expect:    insert
# swrl:      challenges(?A, ?B) ^ swrlx:makeOWLThing(?B, ?R) -> rdf:subject(?R, ?A) ^
#            Relationship(?R) ^ rdf:object(?R, ?B)
# reads:     IF A challenges B AND we reify this challenge as a Relationship R THEN R is a
#            reified Relationship with subject A and object B

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

INSERT {
  ?R a gsn:Relationship ;
     schema:identifier ?relationshipId ;
     rdf:subject ?A ;
     rdf:predicate gsn:challenges ;
     rdf:object ?B .
}
WHERE {
  ?A gsn:challenges ?B ;
     schema:identifier ?idA .
  ?B schema:identifier ?idB .
  BIND(CONCAT("R-", ?idA, "-challenges-", ?idB) AS ?relationshipId)
  BIND(IRI(CONCAT(REPLACE(STR(?A), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?relationshipId))) AS ?R)
  FILTER NOT EXISTS {
    ?existing rdf:subject ?A ;
              rdf:predicate gsn:challenges ;
              rdf:object ?B .
  }
}
