PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT ?descendantId ?type ?statement (MIN(?hops) AS ?depth)
WHERE {
  VALUES ?rootId { "G1" }

  ?root schema:identifier ?rootId .
  ?root gsn:supportedBy+ ?descendant .
  ?descendant a ?type ;
              schema:identifier ?descendantId .
  OPTIONAL { ?descendant gsn:statement ?statement }
  {
    SELECT ?root ?descendant (COUNT(?step) AS ?hops)
    WHERE {
      ?root gsn:supportedBy* ?step .
      ?step gsn:supportedBy+ ?descendant .
    }
    GROUP BY ?root ?descendant
  }
}
GROUP BY ?descendantId ?type ?statement
ORDER BY ?depth ?descendantId
