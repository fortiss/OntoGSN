PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DELETE {
  ?element gsn:inDoubt ?doubt .
  ?element gsn:defeated ?defeated .
  ?element gsn:consistentWith ?consistent .
  ?relationship gsn:relationshipType ?type .
  ?defeater rdf:type gsn:Defeater .
}
WHERE {
  { ?element gsn:inDoubt ?doubt }
  UNION
  { ?element gsn:defeated ?defeated }
  UNION
  { ?element gsn:consistentWith ?consistent }
  UNION
  { ?relationship rdf:subject ?any ; gsn:relationshipType ?type }
  UNION
  { ?defeater rdf:type gsn:Defeater }
}
