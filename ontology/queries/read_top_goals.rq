PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT DISTINCT ?goalId ?statement ?flaggedTop ?unsupportedFromAbove
WHERE {
  ?goal a gsn:Goal ;
        schema:identifier ?goalId .
  OPTIONAL { ?goal gsn:statement ?statement }
  BIND(EXISTS { ?goal gsn:top ?t . FILTER(STR(?t) = "true") } AS ?flaggedTop)
  BIND(NOT EXISTS { ?parent gsn:supportedBy ?goal } AS ?unsupportedFromAbove)
  FILTER(?flaggedTop || ?unsupportedFromAbove)
}
ORDER BY ?goalId
