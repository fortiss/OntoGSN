# expect: rows

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT ?elementId ?type ?statement ?instantiationOfId
WHERE {
  ?element gsn:uninstantiated ?flag ;
           a ?type ;
           schema:identifier ?elementId .
  FILTER(STR(?flag) = "true")
  OPTIONAL { ?element gsn:statement ?statement }
  OPTIONAL {
    ?element gsn:instantiationOf ?source .
    ?source schema:identifier ?instantiationOfId .
  }
}
ORDER BY ?elementId
