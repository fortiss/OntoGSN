PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

SELECT ?patternId ?patternLabel ?instanceId ?hasIntent ?hasApplicability ?hasConsequences
WHERE {
  ?pattern a/rdfs:subClassOf* gsn:Pattern ;
           schema:identifier ?patternId .
  OPTIONAL { ?pattern rdfs:label ?patternLabel }
  OPTIONAL {
    ?instance gsn:instantiationOf ?pattern ;
              schema:identifier ?instanceId .
  }
  BIND(EXISTS { ?pattern gsn:intent        ?i } AS ?hasIntent)
  BIND(EXISTS { ?pattern gsn:applicability ?a } AS ?hasApplicability)
  BIND(EXISTS { ?pattern gsn:consequences  ?c } AS ?hasConsequences)
}
ORDER BY ?patternId ?instanceId
