PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT ?challengeId ?challengeKind ?challengeStatement ?targetId ?targetType
WHERE {
  ?challenge gsn:challenges ?target ;
             schema:identifier ?challengeId ;
             a ?challengeKind .
  FILTER(?challengeKind IN (gsn:Goal, gsn:Solution, gsn:Defeater))
  OPTIONAL { ?challenge gsn:statement ?challengeStatement }
  OPTIONAL {
    ?target schema:identifier ?targetId ;
            a ?targetType .
  }
}
ORDER BY ?challengeId
