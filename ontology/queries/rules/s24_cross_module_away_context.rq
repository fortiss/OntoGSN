# rule:      S24
# name:      Cross-Module Away Context
# section:   Modular Extension
# operation: rule
# expect:    insert
# swrl:      'in module'(?A, ?M) ^ 'in module'(?B, ?N) ^ Module(?N) ^ 'in context of'(?A, ?B) ^
#            Module(?M) ^ swrlb:notEqual(?M, ?N) -> away(?B, true)
# reads:     IF Module M contains A AND Module N contains B AND A is in context of B AND M and N
#            are distinct Modules THEN B is away (in another Module)

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?B gsn:away ?old }
INSERT { ?B gsn:away true }
WHERE {
  ?A gsn:inModule ?M .
  ?B gsn:inModule ?N .
  FILTER(?M != ?N)
  ?A gsn:inContextOf ?B .
  OPTIONAL { ?B gsn:away ?old }
  FILTER(!BOUND(?old) || STR(?old) != "true")
}
