# rule:      S63
# name:      Challenge Cycle Relationship Invalidation
# section:   Dialectic Extension
# operation: rule
# expect:    insert
# swrl:      Relationship(?R) ^ rdf:subject(?R, ?A) ^ rdf:object(?R, ?B) ^ challenges(?A, ?B)
#            ^ 'transitively challenges'(?B, ?A) -> valid(?R, false)
# reads:     IF R is a Relationship from A to B AND A challenges B AND B transitively
#            challenges A THEN R is NOT valid

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DELETE { ?R gsn:valid ?old }
INSERT { ?R gsn:valid false }
WHERE {
  ?R a gsn:Relationship ;
     rdf:subject ?A ;
     rdf:object ?B .
  ?A gsn:challenges ?B .
  ?B gsn:transitivelyChallenges ?A .
  OPTIONAL { ?R gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
