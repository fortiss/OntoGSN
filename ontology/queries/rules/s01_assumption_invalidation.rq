# rule:      S1
# name:      Assumption Invalidation

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?B gsn:valid ?old }
INSERT { ?B gsn:valid false }
WHERE {
  ?A a gsn:Assumption ;
     gsn:valid ?vA .
  FILTER(STR(?vA) = "false")
  ?B gsn:inContextOf ?A .
  OPTIONAL { ?B gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
