# rule:      S6
# name:      Goal Top Flag

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?A gsn:top ?old }
INSERT { ?A gsn:top false }
WHERE {
  ?A a gsn:Goal .
  {
    ?X gsn:supportedBy ?A .
    FILTER NOT EXISTS {
      ?M a gsn:Module .
      ?M gsn:contains+ ?X .
      FILTER NOT EXISTS { ?M gsn:contains+ ?A }
    }
  }
  UNION
  { ?A gsn:challenges ?target }
  OPTIONAL { ?A gsn:top ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
