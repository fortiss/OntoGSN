# rule:      S53
# name:      Module Membership

PREFIX gsn:  <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

INSERT { ?E gsn:inModule ?M }
WHERE {
  ?M a gsn:Module ;
     gsn:contains ?Arg .
  ?Arg a gsn:Argument ;
       gsn:contains ?E .
  ?E a/rdfs:subClassOf* gsn:GSNElement .
  FILTER NOT EXISTS { ?E gsn:inModule ?M }
}
