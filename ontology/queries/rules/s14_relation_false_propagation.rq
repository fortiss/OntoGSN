# rule:      S14
# name:      Relation False Propagation

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DELETE { ?A gsn:true ?old }
INSERT { ?A gsn:true false }
WHERE {
  ?R a gsn:Relationship ;
     gsn:true ?tR ;
     rdf:subject ?A ;
     rdf:object ?B .
  FILTER(STR(?tR) = "false")
  ?A gsn:inContextOf ?B .
  OPTIONAL { ?A gsn:true ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
