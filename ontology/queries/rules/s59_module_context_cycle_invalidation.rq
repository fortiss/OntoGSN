# rule:      S59
# name:      Module Context Cycle Invalidation

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?M gsn:valid ?old }
INSERT { ?M gsn:valid false }
WHERE {
  ?M gsn:transitivelyInContextOf ?M .
  OPTIONAL { ?M gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
