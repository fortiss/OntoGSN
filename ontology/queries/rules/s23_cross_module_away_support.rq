# rule:      S23
# name:      Cross-Module Away Support

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?B gsn:away ?old }
INSERT { ?B gsn:away true }
WHERE {
  ?A gsn:inModule ?M .
  ?B gsn:inModule ?N .
  FILTER(?M != ?N)
  ?A gsn:supportedBy ?B .
  OPTIONAL { ?B gsn:away ?old }
  FILTER(!BOUND(?old) || STR(?old) != "true")
}
