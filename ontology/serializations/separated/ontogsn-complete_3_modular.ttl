                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 gsnswrl:E1 ;
                                    swrl:argument2 gsnswrl:M1 ;
                                    swrl:propertyPredicate gsn:inModule ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                            swrl:argument1 gsnswrl:E2 ;
                                            swrl:argument2 gsnswrl:M2 ;
                                            swrl:propertyPredicate gsn:inModule ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                    swrl:argument1 gsnswrl:E1 ;
                                                    swrl:argument2 gsnswrl:E2 ;
                                                    swrl:propertyPredicate gsn:inContextOf ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:DifferentIndividualsAtom ;
                                                            swrl:argument1 gsnswrl:M1 ;
                                                            swrl:argument2 gsnswrl:M2 ] ;
                                                    rdf:rest () ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 gsnswrl:M1 ;
                    swrl:argument2 gsnswrl:M2 ;
                    swrl:propertyPredicate gsn:inContextOf ] ;
            rdf:rest () ] ;
    gsn:coreOrExtension "Modular Extension" .

