cc:license a owl:AnnotationProperty .

dc:contributor a owl:AnnotationProperty .

dc:creator a owl:AnnotationProperty .

dc:description a owl:AnnotationProperty .

dc:identifier a owl:AnnotationProperty .

dc:issued a owl:AnnotationProperty .

dc:modified a owl:AnnotationProperty .

dc:publisher a owl:AnnotationProperty .

dc:source a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

terms:bibliographicCitation a owl:AnnotationProperty .

terms:created a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

schema:disclaimer a owl:AnnotationProperty .

schema:url a owl:AnnotationProperty .

schema:version a owl:AnnotationProperty .

swrla:isRuleEnabled a owl:AnnotationProperty .

skos:definition a owl:AnnotationProperty .

skos:note a owl:AnnotationProperty .

gsn:ConfidenceRelationCreation a swrl:Imp ;
    rdfs:label "Confidence Relation Creation" ;
    swrla:isRuleEnabled true ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                    swrl:argument1 gsnswrl:A ;
                    swrl:argument2 true ;
                    swrl:propertyPredicate gsn:assuranceClaimPoint ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:ClassAtom ;
                            swrl:argument1 gsnswrl:A ;
                            swrl:classPredicate gsn:ArtefactReference ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:BuiltinAtom ;
                                    swrl:arguments ( gsnswrl:A gsnswrl:R ) ;
                                    swrl:builtin <http://swrl.stanford.edu/ontologies/built-ins/3.3/swrlx.owl#makeOWLThing> ] ;
                            rdf:rest () ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 gsnswrl:R ;
                    swrl:classPredicate gsn:RelationshipWithConfidence ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 gsnswrl:R ;
                            swrl:argument2 gsnswrl:A ;
                            swrl:propertyPredicate rdf:subject ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                    swrl:argument1 gsnswrl:R ;
                                    swrl:argument2 true ;
                                    swrl:propertyPredicate gsn:assuranceClaimPoint ] ;
                            rdf:rest () ] ] ] ;
    gsn:coreOrExtension "Confidence Argument Extension" .

gsn:DuplicateNameInvalidation a swrl:Imp ;
    rdfs:label "Duplicate Name Invalidation" ;
    swrla:isRuleEnabled true ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                    swrl:argument1 gsnswrl:A ;
                    swrl:argument2 gsnswrl:N ;
                    swrl:propertyPredicate schema:identifier ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                            swrl:argument1 gsnswrl:B ;
                            swrl:argument2 gsnswrl:M ;
                            swrl:propertyPredicate schema:identifier ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:BuiltinAtom ;
                                    swrl:arguments ( gsnswrl:A gsnswrl:B ) ;
                                    swrl:builtin swrlb:notEqual ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:BuiltinAtom ;
                                            swrl:arguments ( gsnswrl:N gsnswrl:M ) ;
                                            swrl:builtin swrlb:equal ] ;
                                    rdf:rest () ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                    swrl:argument1 gsnswrl:A ;
                    swrl:argument2 false ;
                    swrl:propertyPredicate gsn:valid ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                            swrl:argument1 gsnswrl:B ;
                            swrl:argument2 false ;
                            swrl:propertyPredicate gsn:valid ] ;
                    rdf:rest () ] ] ;
    gsn:coreOrExtension "Confidence Argument Extension" .

gsn:GoalConfidenceRelation a swrl:Imp ;
    rdfs:label "Goal Confidence Relation" ;
    swrla:isRuleEnabled true ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 gsnswrl:G ;
                    swrl:argument2 gsnswrl:S2 ;
                    swrl:propertyPredicate gsn:supportedBy ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:ClassAtom ;
                            swrl:argument1 gsnswrl:S1 ;
                            swrl:classPredicate gsn:Goal ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 gsnswrl:R1 ;
                                    swrl:argument2 gsnswrl:S1 ;
                                    swrl:propertyPredicate rdf:object ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:ClassAtom ;
                                            swrl:argument1 gsnswrl:R1 ;
                                            swrl:classPredicate gsn:RelationshipWithConfidence ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:BuiltinAtom ;
                                                    swrl:arguments ( gsnswrl:S2 gsnswrl:R2 ) ;
                                                    swrl:builtin <http://swrl.stanford.edu/ontologies/built-ins/3.3/swrlx.owl#makeOWLThing> ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                            swrl:argument1 gsnswrl:G ;
                                                            swrl:argument2 gsnswrl:S1 ;
                                                            swrl:propertyPredicate gsn:supportedBy ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:ClassAtom ;
                                                                    swrl:argument1 gsnswrl:S2 ;
                                                                    swrl:classPredicate gsn:Goal ] ;
                                                            rdf:rest [ a swrl:AtomList ;
                                                                    rdf:first [ a swrl:ClassAtom ;
                                                                            swrl:argument1 gsnswrl:G ;
                                                                            swrl:classPredicate gsn:Goal ] ;
                                                                    rdf:rest [ a swrl:AtomList ;
                                                                            rdf:first [ a swrl:BuiltinAtom ;
                                                                                    swrl:arguments ( gsnswrl:S1 gsnswrl:S2 ) ;
                                                                                    swrl:builtin swrlb:notEqual ] ;
                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                            swrl:argument1 gsnswrl:R1 ;
                                                                                            swrl:argument2 gsnswrl:A ;
                                                                                            swrl:propertyPredicate gsn:associatedWith ] ;
                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                                    swrl:argument1 gsnswrl:R1 ;
                                                                                                    swrl:argument2 gsnswrl:G ;
                                                                                                    swrl:propertyPredicate rdf:subject ] ;
                                                                                            rdf:rest () ] ] ] ] ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 gsnswrl:R2 ;
                    swrl:argument2 gsnswrl:S2 ;
                    swrl:propertyPredicate rdf:object ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:ClassAtom ;
                            swrl:argument1 gsnswrl:R2 ;
                            swrl:classPredicate gsn:RelationshipWithConfidence ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 gsnswrl:R2 ;
                                    swrl:argument2 gsnswrl:G ;
                                    swrl:propertyPredicate rdf:subject ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                            swrl:argument1 gsnswrl:R2 ;
                                            swrl:argument2 gsnswrl:A ;
                                            swrl:propertyPredicate gsn:associatedWith ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                    swrl:argument1 gsnswrl:R2 ;
                                                    swrl:argument2 true ;
                                                    swrl:propertyPredicate gsn:assuranceClaimPoint ] ;
                                            rdf:rest () ] ] ] ] ] ;
    gsn:coreOrExtension "Confidence Argument Extension" .

gsn:GoalStrategyConfidence a swrl:Imp ;
    rdfs:label "Goal-Strategy Confidence" ;
    swrla:isRuleEnabled true ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 gsnswrl:G2 ;
                    swrl:argument2 gsnswrl:S ;
                    swrl:propertyPredicate gsn:supportedBy ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:ClassAtom ;
                            swrl:argument1 gsnswrl:R1 ;
                            swrl:classPredicate gsn:RelationshipWithConfidence ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 gsnswrl:R1 ;
                                    swrl:argument2 gsnswrl:S ;
                                    swrl:propertyPredicate rdf:subject ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                            swrl:argument1 gsnswrl:S ;
                                            swrl:argument2 gsnswrl:G1 ;
                                            swrl:propertyPredicate gsn:supportedBy ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:BuiltinAtom ;
                                                    swrl:arguments ( gsnswrl:G2 gsnswrl:R2 ) ;
                                                    swrl:builtin <http://swrl.stanford.edu/ontologies/built-ins/3.3/swrlx.owl#makeOWLThing> ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                            swrl:argument1 gsnswrl:R1 ;
                                                            swrl:argument2 gsnswrl:G1 ;
                                                            swrl:propertyPredicate rdf:object ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:ClassAtom ;
                                                                    swrl:argument1 gsnswrl:S ;
                                                                    swrl:classPredicate gsn:Strategy ] ;
                                                            rdf:rest [ a swrl:AtomList ;
                                                                    rdf:first [ a swrl:ClassAtom ;
                                                                            swrl:argument1 gsnswrl:G1 ;
                                                                            swrl:classPredicate gsn:Goal ] ;
                                                                    rdf:rest [ a swrl:AtomList ;
                                                                            rdf:first [ a swrl:ClassAtom ;
                                                                                    swrl:argument1 gsnswrl:G2 ;
                                                                                    swrl:classPredicate gsn:Goal ] ;
                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                            swrl:argument1 gsnswrl:R1 ;
                                                                                            swrl:argument2 gsnswrl:A ;
                                                                                            swrl:propertyPredicate gsn:associatedWith ] ;
                                                                                    rdf:rest () ] ] ] ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 gsnswrl:R2 ;
                    swrl:classPredicate gsn:RelationshipWithConfidence ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 gsnswrl:R2 ;
                            swrl:argument2 gsnswrl:A ;
                            swrl:propertyPredicate gsn:associatedWith ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                    swrl:argument1 gsnswrl:R2 ;
                                    swrl:argument2 true ;
                                    swrl:propertyPredicate gsn:assuranceClaimPoint ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                            swrl:argument1 gsnswrl:R2 ;
                                            swrl:argument2 gsnswrl:G2 ;
                                            swrl:propertyPredicate rdf:subject ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                    swrl:argument1 gsnswrl:R2 ;
                                                    swrl:argument2 gsnswrl:S ;
                                                    swrl:propertyPredicate rdf:object ] ;
                                            rdf:rest () ] ] ] ] ] ;
    gsn:coreOrExtension "Confidence Argument Extension" .

gsn:SolutionConfidenceRelation a swrl:Imp ;
    rdfs:label "Solution Confidence Relation" ;
    swrla:isRuleEnabled true ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 gsnswrl:G ;
                    swrl:argument2 gsnswrl:S2 ;
                    swrl:propertyPredicate gsn:supportedBy ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:ClassAtom ;
                            swrl:argument1 gsnswrl:S1 ;
                            swrl:classPredicate gsn:Solution ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 gsnswrl:R1 ;
                                    swrl:argument2 gsnswrl:S1 ;
                                    swrl:propertyPredicate rdf:object ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:ClassAtom ;
                                            swrl:argument1 gsnswrl:R1 ;
                                            swrl:classPredicate gsn:RelationshipWithConfidence ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:BuiltinAtom ;
                                                    swrl:arguments ( gsnswrl:S2 gsnswrl:R2 ) ;
                                                    swrl:builtin <http://swrl.stanford.edu/ontologies/built-ins/3.3/swrlx.owl#makeOWLThing> ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                            swrl:argument1 gsnswrl:G ;
                                                            swrl:argument2 gsnswrl:S1 ;
                                                            swrl:propertyPredicate gsn:supportedBy ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:ClassAtom ;
                                                                    swrl:argument1 gsnswrl:G ;
                                                                    swrl:classPredicate gsn:Goal ] ;
                                                            rdf:rest [ a swrl:AtomList ;
                                                                    rdf:first [ a swrl:BuiltinAtom ;
                                                                            swrl:arguments ( gsnswrl:S1 gsnswrl:S2 ) ;
                                                                            swrl:builtin swrlb:notEqual ] ;
                                                                    rdf:rest [ a swrl:AtomList ;
                                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                    swrl:argument1 gsnswrl:R1 ;
                                                                                    swrl:argument2 gsnswrl:A ;
                                                                                    swrl:propertyPredicate gsn:associatedWith ] ;
                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                            swrl:argument1 gsnswrl:R1 ;
                                                                                            swrl:argument2 gsnswrl:G ;
                                                                                            swrl:propertyPredicate rdf:subject ] ;
                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                            rdf:first [ a swrl:ClassAtom ;
                                                                                                    swrl:argument1 gsnswrl:S2 ;
                                                                                                    swrl:classPredicate gsn:Solution ] ;
                                                                                            rdf:rest () ] ] ] ] ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 gsnswrl:R2 ;
                    swrl:argument2 gsnswrl:S2 ;
                    swrl:propertyPredicate rdf:object ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:ClassAtom ;
                            swrl:argument1 gsnswrl:R2 ;
                            swrl:classPredicate gsn:RelationshipWithConfidence ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 gsnswrl:R2 ;
                                    swrl:argument2 gsnswrl:G ;
                                    swrl:propertyPredicate rdf:subject ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                            swrl:argument1 gsnswrl:R2 ;
                                            swrl:argument2 gsnswrl:A ;
                                            swrl:propertyPredicate gsn:associatedWith ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                    swrl:argument1 gsnswrl:R2 ;
                                                    swrl:argument2 true ;
                                                    swrl:propertyPredicate gsn:assuranceClaimPoint ] ;
                                            rdf:rest () ] ] ] ] ] ;
    gsn:coreOrExtension "Confidence Argument Extension" .

gsn:StrategyConfidenceRelation a swrl:Imp ;
    rdfs:label "Strategy Confidence Relation" ;
    swrla:isRuleEnabled true ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 gsnswrl:G1 ;
                    swrl:argument2 gsnswrl:S ;
                    swrl:propertyPredicate gsn:supportedBy ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 gsnswrl:S ;
                            swrl:argument2 gsnswrl:G2 ;
                            swrl:propertyPredicate gsn:supportedBy ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:ClassAtom ;
                                    swrl:argument1 gsnswrl:R1 ;
                                    swrl:classPredicate gsn:RelationshipWithConfidence ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:BuiltinAtom ;
                                            swrl:arguments ( gsnswrl:G2 gsnswrl:R2 ) ;
                                            swrl:builtin <http://swrl.stanford.edu/ontologies/built-ins/3.3/swrlx.owl#makeOWLThing> ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:ClassAtom ;
                                                    swrl:argument1 gsnswrl:S ;
                                                    swrl:classPredicate gsn:Strategy ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:ClassAtom ;
                                                            swrl:argument1 gsnswrl:G1 ;
                                                            swrl:classPredicate gsn:Goal ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:ClassAtom ;
                                                                    swrl:argument1 gsnswrl:G2 ;
                                                                    swrl:classPredicate gsn:Goal ] ;
                                                            rdf:rest [ a swrl:AtomList ;
                                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                            swrl:argument1 gsnswrl:R1 ;
                                                                            swrl:argument2 gsnswrl:S ;
                                                                            swrl:propertyPredicate rdf:object ] ;
                                                                    rdf:rest [ a swrl:AtomList ;
                                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                    swrl:argument1 gsnswrl:R1 ;
                                                                                    swrl:argument2 gsnswrl:A ;
                                                                                    swrl:propertyPredicate gsn:associatedWith ] ;
                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                            swrl:argument1 gsnswrl:R1 ;
                                                                                            swrl:argument2 gsnswrl:G1 ;
                                                                                            swrl:propertyPredicate rdf:subject ] ;
                                                                                    rdf:rest () ] ] ] ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 gsnswrl:R2 ;
                    swrl:argument2 gsnswrl:S ;
                    swrl:propertyPredicate rdf:subject ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:ClassAtom ;
                            swrl:argument1 gsnswrl:R2 ;
                            swrl:classPredicate gsn:RelationshipWithConfidence ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 gsnswrl:R2 ;
                                    swrl:argument2 gsnswrl:G2 ;
                                    swrl:propertyPredicate rdf:object ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                            swrl:argument1 gsnswrl:R2 ;
                                            swrl:argument2 gsnswrl:A ;
                                            swrl:propertyPredicate gsn:associatedWith ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                    swrl:argument1 gsnswrl:R2 ;
                                                    swrl:argument2 true ;
                                                    swrl:propertyPredicate gsn:assuranceClaimPoint ] ;
                                            rdf:rest () ] ] ] ] ] ;
    gsn:coreOrExtension "Confidence Argument Extension" .

gsn:coreOrExtension a owl:AnnotationProperty .

gsn:renderedAs a owl:AnnotationProperty .

<https://w3id.org/OntoGSN/ontology/confidence> a owl:Ontology ;
    cc:license "https://creativecommons.org/licenses/by/4.0/" ;
    dc:contributor "Barbara Gallina, Dian Balta, Ingmar Kessler"@en ;
