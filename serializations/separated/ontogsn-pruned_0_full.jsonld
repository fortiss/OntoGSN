        "@value": "applicability"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The applicability section should state under what circumstances the pattern can be applied, making clear the assumptions and principles underlying the pattern to avoid inappropriate application in a mismatched context. This section should record what contextual information is required in order to apply the pattern."
      }
    ],
    "https://w3id.org/OntoGSN/ontology#coreOrExtension": [
      {
        "@language": "en",
