      },
      {
        "@id": "https://w3id.org/OntoGSN/ontology#GSNElement"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "An assumption, rendered as an oval with the letter 'A' at the top- or bottom-right, presents an intentionally unsubstantiated statement."
      }
    ],
    "https://w3id.org/OntoGSN/ontology#coreOrExtension": [
      {
        "@language": "en",
        "@value": "Core GSN"
      }
    ],
