    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction" />
    <owl:allValuesFrom rdf:nodeID="genid0995" />
    <owl:onProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#subject" />
  </rdf:Description>
  <rdf:Description rdf:nodeID="genid0003">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom" />
    <swrl:argument1 rdf:resource="https://w3id.org/OntoGSN/swrl#M" />
    <swrl:argument2 rdf:resource="https://w3id.org/OntoGSN/swrl#A" />
    <swrl:propertyPredicate rdf:resource="https://w3id.org/OntoGSN/ontology#contains" />
  </rdf:Description>
