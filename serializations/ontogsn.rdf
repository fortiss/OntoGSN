  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/OntoGSN/ontology#ChallengeRelationCreation">
    <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
