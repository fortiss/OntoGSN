  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/OntoGSN/ontology#CircularModuleInvalidation">
    <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp" />
    <rdfs:label>Circular Module Invalidation</rdfs:label>
    <swrl:body rdf:nodeID="genid0640" />
    <swrl:head rdf:nodeID="genid0535" />
