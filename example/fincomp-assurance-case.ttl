###############################################################################
#    Module BAIT - draw.io page "BAIT"
###############################################################################

fc:BAIT_G1 a gsn:Goal ;
    schema:identifier "BAIT:G1" ;
    rdfs:label "Goal BAIT:G1"@en ;
    gsn:statement "The [Organization]'s IT system is compliant with the BAIT requirements" ;
    gsn:top true ;
    gsn:away true ;
    gsn:public true ;
    gsn:supportedBy fc:BAIT_S1 ;
    gsn:inContextOf fc:BAIT_C1 .

fc:BAIT_C1 a gsn:Context ;
    schema:identifier "BAIT:C1" ;
    rdfs:label "Context BAIT:C1"@en ;
    gsn:statement "Bankaufsichtliche Anforderungen an die IT (BAIT) requirements" .

fc:BAIT_S1 a gsn:Strategy ;
    schema:identifier "BAIT:S1" ;
    rdfs:label "Strategy BAIT:S1"@en ;
    gsn:statement "Argument from end-of-year BAIT auditing" ;
    gsn:supportedBy fc:BAIT_G1_1 ;
    gsn:inContextOf fc:BAIT_C2 .

fc:BAIT_C2 a gsn:Context ;
    schema:identifier "BAIT:C2" ;
    rdfs:label "Context BAIT:C2"@en ;
    gsn:statement "End-of-year BAIT audits" .

fc:BAIT_G1_1 a gsn:Goal ;
    schema:identifier "BAIT:G1.1" ;
    rdfs:label "Goal BAIT:G1.1"@en ;
    gsn:statement "[Organization]'s IT system successfully passed all BAIT audits to date" ;
    gsn:top false ;
    gsn:uninstantiated true ;
    gsn:supportedBy fc:BAIT_G1_1_X ;
    gsn:inContextOf fc:BAIT_C1_1 .

fc:BAIT_C1_1 a gsn:Context ;
    schema:identifier "BAIT:C1.1" ;
    rdfs:label "Context BAIT:C1.1"@en ;
    gsn:statement "Overview of BAIT audits" .

fc:BAIT_G1_1_X a gsn:Goal ;
    schema:identifier "BAIT:G1.1.X" ;
    rdfs:label "Goal BAIT:G1.1.X"@en ;
    gsn:statement "[Organization]'s IT system successfully passed the <year> BAIT audit" ;
    gsn:top false ;
    gsn:uninstantiated true ;
    gsn:supportedBy fc:BAIT_G1_1_X_Y , fc:BAIT_G1_1_X_Y2 ;
    gsn:inContextOf fc:BAIT_C1_1_X .

fc:BAIT_C1_1_X a gsn:Context ;
    schema:identifier "BAIT:C1.1.X" ;
    rdfs:label "Context BAIT:C1.1.X"@en ;
    gsn:statement "<year> BAIT audit metadata" ;
    gsn:uninstantiated true .

fc:BAIT_G1_1_X_Y2 a gsn:Goal ;
    schema:identifier "BAIT:G1.1.X.Y2" ;
    rdfs:label "Goal BAIT:G1.1.X.Y2"@en ;
    gsn:statement "All outstanding issues that auditors have raised have been adequately addressed" ;
    gsn:top false ;
    gsn:uninstantiated true ;
    gsn:supportedBy fc:BAIT_G1_1_X_Y2_Z2 .

fc:BAIT_G1_1_X_Y_I a gsn:Goal ;
    schema:identifier "BAIT:G1.1.X.Y.I" ;
    rdfs:label "Goal BAIT:G1.1.X.Y.I"@en ;
    gsn:statement "Issues have been raised with the implementation of <req_id>" ;
    gsn:top false ;
    gsn:uninstantiated true ;
    gsn:supportedBy fc:BAIT_Sn1_1_X_Y_D ;
    gsn:challenges fc:BAIT_G1_1_X_Y .

fc:BAIT_G1_1_X_Y a gsn:Goal ;
    schema:identifier "BAIT:G1.1.X.Y" ;
    rdfs:label "Goal BAIT:G1.1.X.Y"@en ;
    gsn:statement "[Organization]'s IT system satisfies the <req_id> requirement for <year>" ;
    gsn:top false ;
    gsn:uninstantiated true ;
    gsn:supportedBy fc:BAIT_Sn1_1_X_Y ;
    gsn:inContextOf fc:BAIT_C1_1_X_Y .

fc:BAIT_C1_1_X_Y a gsn:Context ;
    schema:identifier "BAIT:C1.1.X.Y" ;
    rdfs:label "Context BAIT:C1.1.X.Y"@en ;
    gsn:statement "<req_id> Description and Requirement" ;
    gsn:uninstantiated true .

fc:BAIT_C1_1_X_Y2_Z2 a gsn:Context ;
    schema:identifier "BAIT:C1.1.X.Y2.Z2" ;
    rdfs:label "Context BAIT:C1.1.X.Y2.Z2"@en ;
    gsn:statement "Issue <issue_id> metadata" ;
    gsn:uninstantiated true .

fc:BAIT_G1_1_X_Y2_Z2 a gsn:Goal ;
    schema:identifier "BAIT:G1.1.X.Y2.Z2" ;
    rdfs:label "Goal BAIT:G1.1.X.Y2.Z2"@en ;
    gsn:statement "Issue <issue_id> has been adequately addressed" ;
    gsn:top false ;
    gsn:uninstantiated true ;
    gsn:supportedBy fc:BAIT_Sn1_1_X_Y2_Z2 ;
    gsn:inContextOf fc:BAIT_C1_1_X_Y2_Z2 ;
    gsn:challenges fc:BAIT_Sn1_1_X_Y_D .

fc:BAIT_Sn1_1_X_Y a gsn:Solution ;
    schema:identifier "BAIT:Sn1.1.X.Y" ;
    rdfs:label "Solution BAIT:Sn1.1.X.Y"@en ;
    gsn:statement "[<year> <req_id> <evid_id>] File" ;
    gsn:uninstantiated true ;
    gsn:refersTo fc:BAIT_Ev1 .

fc:BAIT_G1_1_X_Y_D a gsn:Goal ;
    schema:identifier "BAIT:G1.1.X.Y.D" ;
    rdfs:label "Goal BAIT:G1.1.X.Y.D"@en ;
    gsn:statement "Issue have been raised with [<year> <req_id> <evid_id>] file" ;
    gsn:top false ;
    gsn:uninstantiated true ;
    gsn:supportedBy fc:BAIT_Sn1_1_X_Y_D ;
    gsn:challenges fc:BAIT_Sn1_1_X_Y .

fc:BAIT_Sn1_1_X_Y2_Z2 a gsn:Solution ;
    schema:identifier "BAIT:Sn1.1.X.Y2.Z2" ;
    rdfs:label "Solution BAIT:Sn1.1.X.Y2.Z2"@en ;
    gsn:statement "<issue_id> Logs" ;
    gsn:uninstantiated true ;
    gsn:refersTo fc:BAIT_Ev2 .

fc:BAIT_Sn1_1_X_Y_D a gsn:Solution ;
    schema:identifier "BAIT:Sn1.1.X.Y.D" ;
    rdfs:label "Solution BAIT:Sn1.1.X.Y.D"@en ;
    gsn:statement "<issue_id> comment" ;
    gsn:uninstantiated true ;
    gsn:refersTo fc:BAIT_Ev3 .


