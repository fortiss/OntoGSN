###############################################################################

fc:AML_G1 a gsn:Goal ;
    schema:identifier "AML:G1" ;
    rdfs:label "Goal AML:G1"@en ;
    gsn:statement "The [Organization]'s IT system is compliant with the AML requirements" ;
    gsn:top true ;
    gsn:away true ;
    gsn:public true ;
    gsn:supportedBy fc:AML_S1 ;
    gsn:inContextOf fc:AML_C1 .

fc:AML_C1 a gsn:Context ;
    schema:identifier "AML:C1" ;
    rdfs:label "Context AML:C1"@en ;
    gsn:statement "Anti-Money Laundering (AML) requirements" .

fc:AML_S1 a gsn:Strategy ;
    schema:identifier "AML:S1" ;
    rdfs:label "Strategy AML:S1"@en ;
    gsn:statement "Argument from end-of-year AML auditing" ;
    gsn:supportedBy fc:AML_G1_1 ;
    gsn:inContextOf fc:AML_C2 .

fc:AML_C2 a gsn:Context ;
    schema:identifier "AML:C2" ;
    rdfs:label "Context AML:C2"@en ;
    gsn:statement "End-of-year AML audits" .

fc:AML_G1_1 a gsn:Goal ;
    schema:identifier "AML:G1.1" ;
    rdfs:label "Goal AML:G1.1"@en ;
    gsn:statement "[Organization]'s IT system successfully passed all AML audits to date" ;
    gsn:top false ;
    gsn:uninstantiated true ;
    gsn:supportedBy fc:AML_G1_1_X ;
    gsn:inContextOf fc:AML_C1_1 .

fc:AML_C1_1 a gsn:Context ;
    schema:identifier "AML:C1.1" ;
    rdfs:label "Context AML:C1.1"@en ;
    gsn:statement "Overview of AML audits" .

fc:AML_G1_1_X a gsn:Goal ;
    schema:identifier "AML:G1.1.X" ;
    rdfs:label "Goal AML:G1.1.X"@en ;
    gsn:statement "[Organization]'s IT system successfully passed the <year> AML audit" ;
    gsn:top false ;
    gsn:uninstantiated true ;
    gsn:supportedBy fc:AML_G1_1_X_Y , fc:AML_G1_1_X_Y2 ;
    gsn:inContextOf fc:AML_C1_1_X .

fc:AML_C1_1_X a gsn:Context ;
    schema:identifier "AML:C1.1.X" ;
    rdfs:label "Context AML:C1.1.X"@en ;
    gsn:statement "<year> AML audit metadata" ;
    gsn:uninstantiated true .

fc:AML_G1_1_X_Y2 a gsn:Goal ;
    schema:identifier "AML:G1.1.X.Y2" ;
    rdfs:label "Goal AML:G1.1.X.Y2"@en ;
    gsn:statement "All outstanding issues that auditors have raised have been adequately addressed" ;
    gsn:top false ;
    gsn:uninstantiated true ;
    gsn:supportedBy fc:AML_G1_1_X_Y2_Z2 .

fc:AML_G1_1_X_Y_I a gsn:Goal ;
    schema:identifier "AML:G1.1.X.Y.I" ;
    rdfs:label "Goal AML:G1.1.X.Y.I"@en ;
    gsn:statement "Issues have been raised with the implementation of <req_id>" ;
    gsn:top false ;
    gsn:uninstantiated true ;
    gsn:supportedBy fc:AML_Sn1_1_X_Y_D ;
    gsn:challenges fc:AML_G1_1_X_Y .

fc:AML_G1_1_X_Y a gsn:Goal ;
    schema:identifier "AML:G1.1.X.Y" ;
    rdfs:label "Goal AML:G1.1.X.Y"@en ;
    gsn:statement "[Organization]'s IT system satisfies the <req_id> requirement for <year>" ;
    gsn:top false ;
    gsn:uninstantiated true ;
    gsn:supportedBy fc:AML_Sn1_1_X_Y ;
    gsn:inContextOf fc:AML_C1_1_X_Y .

fc:AML_C1_1_X_Y a gsn:Context ;
    schema:identifier "AML:C1.1.X.Y" ;
    rdfs:label "Context AML:C1.1.X.Y"@en ;
    gsn:statement "<req_id> Description and Requirement" ;
    gsn:uninstantiated true .

fc:AML_C1_1_X_Y2_Z2 a gsn:Context ;
    schema:identifier "AML:C1.1.X.Y2.Z2" ;
    rdfs:label "Context AML:C1.1.X.Y2.Z2"@en ;
    gsn:statement "Issue <issue_id> metadata" ;
    gsn:uninstantiated true .

fc:AML_G1_1_X_Y2_Z2 a gsn:Goal ;
    schema:identifier "AML:G1.1.X.Y2.Z2" ;
    rdfs:label "Goal AML:G1.1.X.Y2.Z2"@en ;
    gsn:statement "Issue <issue_id> has been adequately addressed" ;
    gsn:top false ;
    gsn:uninstantiated true ;
    gsn:supportedBy fc:AML_Sn1_1_X_Y2_Z2 ;
    gsn:inContextOf fc:AML_C1_1_X_Y2_Z2 ;
    gsn:challenges fc:AML_Sn1_1_X_Y_D .

fc:AML_Sn1_1_X_Y a gsn:Solution ;
    schema:identifier "AML:Sn1.1.X.Y" ;
    rdfs:label "Solution AML:Sn1.1.X.Y"@en ;
    gsn:statement "[<year> <req_id> <evid_id>] File" ;
    gsn:uninstantiated true ;
    gsn:refersTo fc:AML_Ev1 .

fc:AML_G1_1_X_Y_D a gsn:Goal ;
    schema:identifier "AML:G1.1.X.Y.D" ;
    rdfs:label "Goal AML:G1.1.X.Y.D"@en ;
    gsn:statement "Issue have been raised with [<year> <req_id> <evid_id>] file" ;
    gsn:top false ;
    gsn:uninstantiated true ;
    gsn:supportedBy fc:AML_Sn1_1_X_Y_D ;
    gsn:challenges fc:AML_Sn1_1_X_Y .

fc:AML_Sn1_1_X_Y2_Z2 a gsn:Solution ;
    schema:identifier "AML:Sn1.1.X.Y2.Z2" ;
    rdfs:label "Solution AML:Sn1.1.X.Y2.Z2"@en ;
    gsn:statement "<issue_id> Logs" ;
    gsn:uninstantiated true ;
    gsn:refersTo fc:AML_Ev2 .

fc:AML_Sn1_1_X_Y_D a gsn:Solution ;
    schema:identifier "AML:Sn1.1.X.Y.D" ;
    rdfs:label "Solution AML:Sn1.1.X.Y.D"@en ;
    gsn:statement "<issue_id> comment" ;
    gsn:uninstantiated true ;
    gsn:refersTo fc:AML_Ev3 .


#  Module AML: the drawn relationships, reified so that the pattern decorators have
#  somewhere to sit. The identifiers are the ones rules S18, S19 and S50 mint.

fc:R_AML_G1_inContextOf_AML_C1 a gsn:Relationship ;
    schema:identifier "R-AML:G1-inContextOf-AML:C1" ;
    rdf:subject fc:AML_G1 ;
    rdf:predicate gsn:inContextOf ;
    rdf:object fc:AML_C1 ;
    gsn:relationshipType "contextual" .

fc:R_AML_G1_supportedBy_AML_S1 a gsn:Relationship ;
    schema:identifier "R-AML:G1-supportedBy-AML:S1" ;
    rdf:subject fc:AML_G1 ;
    rdf:predicate gsn:supportedBy ;
    rdf:object fc:AML_S1 ;
    gsn:relationshipType "inferential" .

fc:R_AML_S1_inContextOf_AML_C2 a gsn:Relationship ;
    schema:identifier "R-AML:S1-inContextOf-AML:C2" ;
    rdf:subject fc:AML_S1 ;
    rdf:predicate gsn:inContextOf ;
    rdf:object fc:AML_C2 ;
    gsn:relationshipType "contextual" ;
    gsn:optional true .

fc:R_AML_S1_supportedBy_AML_G1_1 a gsn:Relationship ;
    schema:identifier "R-AML:S1-supportedBy-AML:G1.1" ;
    rdf:subject fc:AML_S1 ;
    rdf:predicate gsn:supportedBy ;
    rdf:object fc:AML_G1_1 ;
    gsn:relationshipType "inferential" .

fc:R_AML_G1_1_inContextOf_AML_C1_1 a gsn:Relationship ;
    schema:identifier "R-AML:G1.1-inContextOf-AML:C1.1" ;
    rdf:subject fc:AML_G1_1 ;
    rdf:predicate gsn:inContextOf ;
    rdf:object fc:AML_C1_1 ;
    gsn:relationshipType "contextual" ;
    gsn:optional true .

fc:R_AML_G1_1_supportedBy_AML_G1_1_X a gsn:Relationship ;
    schema:identifier "R-AML:G1.1-supportedBy-AML:G1.1.X" ;
    rdf:subject fc:AML_G1_1 ;
    rdf:predicate gsn:supportedBy ;
    rdf:object fc:AML_G1_1_X ;
    gsn:relationshipType "inferential" ;
    gsn:multiple true ;
    gsn:minCardinality "1"^^xsd:nonNegativeInteger ;
    rdfs:comment "Labelled \"1..N years\" in the diagram."@en .

fc:R_AML_G1_1_X_inContextOf_AML_C1_1_X a gsn:Relationship ;
    schema:identifier "R-AML:G1.1.X-inContextOf-AML:C1.1.X" ;
    rdf:subject fc:AML_G1_1_X ;
    rdf:predicate gsn:inContextOf ;
    rdf:object fc:AML_C1_1_X ;
    gsn:relationshipType "contextual" ;
    gsn:optional true .

fc:R_AML_G1_1_X_supportedBy_AML_G1_1_X_Y2 a gsn:Relationship ;
    schema:identifier "R-AML:G1.1.X-supportedBy-AML:G1.1.X.Y2" ;
    rdf:subject fc:AML_G1_1_X ;
    rdf:predicate gsn:supportedBy ;
    rdf:object fc:AML_G1_1_X_Y2 ;
    gsn:relationshipType "inferential" ;
    gsn:optional true .

fc:R_AML_G1_1_X_supportedBy_AML_G1_1_X_Y a gsn:Relationship ;
    schema:identifier "R-AML:G1.1.X-supportedBy-AML:G1.1.X.Y" ;
    rdf:subject fc:AML_G1_1_X ;
    rdf:predicate gsn:supportedBy ;
    rdf:object fc:AML_G1_1_X_Y ;
    gsn:relationshipType "inferential" ;
    gsn:multiple true ;
    gsn:minCardinality "1"^^xsd:nonNegativeInteger ;
    rdfs:comment "Labelled \"1..N reqs\" in the diagram."@en .

fc:R_AML_G1_1_X_Y2_supportedBy_AML_G1_1_X_Y2_Z2 a gsn:Relationship ;
    schema:identifier "R-AML:G1.1.X.Y2-supportedBy-AML:G1.1.X.Y2.Z2" ;
    rdf:subject fc:AML_G1_1_X_Y2 ;
    rdf:predicate gsn:supportedBy ;
    rdf:object fc:AML_G1_1_X_Y2_Z2 ;
    gsn:relationshipType "inferential" ;
    gsn:multiple true ;
    gsn:minCardinality "0"^^xsd:nonNegativeInteger ;
    rdfs:comment "Labelled \"0..N issues\" in the diagram."@en .

fc:R_AML_G1_1_X_Y_I_challenges_AML_G1_1_X_Y a gsn:Relationship ;
    schema:identifier "R-AML:G1.1.X.Y.I-challenges-AML:G1.1.X.Y" ;
    rdf:subject fc:AML_G1_1_X_Y_I ;
    rdf:predicate gsn:challenges ;
    rdf:object fc:AML_G1_1_X_Y ;
    gsn:relationshipType "dialectic" ;
    gsn:multiple true ;
    gsn:minCardinality "0"^^xsd:nonNegativeInteger ;
    rdfs:comment "Labelled \"0..N issues\" in the diagram."@en .

fc:R_AML_G1_1_X_Y_I_supportedBy_AML_Sn1_1_X_Y_D a gsn:Relationship ;
    schema:identifier "R-AML:G1.1.X.Y.I-supportedBy-AML:Sn1.1.X.Y.D" ;
    rdf:subject fc:AML_G1_1_X_Y_I ;
    rdf:predicate gsn:supportedBy ;
    rdf:object fc:AML_Sn1_1_X_Y_D ;
    gsn:relationshipType "evidential" ;
    gsn:multiple true ;
    gsn:minCardinality "1"^^xsd:nonNegativeInteger ;
    rdfs:comment "Labelled \"1..N issues\" in the diagram."@en .

fc:R_AML_G1_1_X_Y_inContextOf_AML_C1_1_X_Y a gsn:Relationship ;
    schema:identifier "R-AML:G1.1.X.Y-inContextOf-AML:C1.1.X.Y" ;
    rdf:subject fc:AML_G1_1_X_Y ;
    rdf:predicate gsn:inContextOf ;
    rdf:object fc:AML_C1_1_X_Y ;
    gsn:relationshipType "contextual" ;
    gsn:optional true .

fc:R_AML_G1_1_X_Y_supportedBy_AML_Sn1_1_X_Y a gsn:Relationship ;
    schema:identifier "R-AML:G1.1.X.Y-supportedBy-AML:Sn1.1.X.Y" ;
    rdf:subject fc:AML_G1_1_X_Y ;
    rdf:predicate gsn:supportedBy ;
    rdf:object fc:AML_Sn1_1_X_Y ;
    gsn:relationshipType "evidential" ;
    gsn:multiple true ;
    gsn:minCardinality "1"^^xsd:nonNegativeInteger ;
    rdfs:comment "Labelled \"1..N files\" in the diagram."@en .

fc:R_AML_G1_1_X_Y2_Z2_inContextOf_AML_C1_1_X_Y2_Z2 a gsn:Relationship ;
    schema:identifier "R-AML:G1.1.X.Y2.Z2-inContextOf-AML:C1.1.X.Y2.Z2" ;
    rdf:subject fc:AML_G1_1_X_Y2_Z2 ;
    rdf:predicate gsn:inContextOf ;
