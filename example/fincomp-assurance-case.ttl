fc:R_AML_G1_1_X_Y2_Z2_supportedBy_AML_Sn1_1_X_Y2_Z2 a gsn:Relationship ;
    schema:identifier "R-AML:G1.1.X.Y2.Z2-supportedBy-AML:Sn1.1.X.Y2.Z2" ;
    rdf:subject fc:AML_G1_1_X_Y2_Z2 ;
    rdf:predicate gsn:supportedBy ;
    rdf:object fc:AML_Sn1_1_X_Y2_Z2 ;
    gsn:relationshipType "evidential" .

fc:R_AML_G1_1_X_Y2_Z2_challenges_AML_Sn1_1_X_Y_D a gsn:Relationship ;
    schema:identifier "R-AML:G1.1.X.Y2.Z2-challenges-AML:Sn1.1.X.Y.D" ;
    rdf:subject fc:AML_G1_1_X_Y2_Z2 ;
    rdf:predicate gsn:challenges ;
    rdf:object fc:AML_Sn1_1_X_Y_D ;
    gsn:relationshipType "dialectic" .

fc:R_AML_G1_1_X_Y_D_challenges_AML_Sn1_1_X_Y a gsn:Relationship ;
    schema:identifier "R-AML:G1.1.X.Y.D-challenges-AML:Sn1.1.X.Y" ;
    rdf:subject fc:AML_G1_1_X_Y_D ;
    rdf:predicate gsn:challenges ;
