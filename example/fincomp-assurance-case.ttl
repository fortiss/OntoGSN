fc:Arg_AML_Issues a gsn:Argument , gsn:Template ;
    schema:identifier "Arg-AML-Issues" ;
    rdfs:label "AML issues argument"@en ;
    schema:description "The dialectic half of the AML template: a challenge per requirement claim and per requirement file, and a remediation branch claiming each raised issue has been addressed."@en ;
    gsn:intent "Record the auditor’s objections as challenges rather than leaving them outside the argument, and claim their resolution where it has been shown."@en ;
    gsn:applicability "Applies where the auditor records objections against named controls or named evidence files, and where the organisation tracks each objection through to a resolution it can evidence."@en ;
    gsn:statement "The issues auditors have raised against the AML argument, and the claims that each has since been addressed." ;
    gsn:argumentType "dialectic" ;
    gsn:structured true ;
    gsn:published false ;
    gsn:final false ;
    gsn:contains fc:AML_G1_1_X_Y2 ,
