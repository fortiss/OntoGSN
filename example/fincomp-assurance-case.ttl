    gsn:multiple true ;
    gsn:minCardinality "1"^^xsd:nonNegativeInteger ;
    rdfs:comment "Labelled \"1..N issues\" in the diagram."@en .


#  Module AML: instantiation data - the labelled triangles, each attached by a dotted
#  line to the element whose subtree it fills in.

fc:AML_IDR1 a gsn:InstantiationDataReference ;
    schema:identifier "AML:IDR1" ;
    rdfs:label "<[Auditor]_AML_Prüfung_ <year>.xlsx>"@en ;
    gsn:refersTo fc:AML_Ev4 ;
    gsn:attachedTo fc:AML_G1_1_X .

fc:AML_IDR2 a gsn:InstantiationDataReference ;
    schema:identifier "AML:IDR2" ;
    rdfs:label "<Azure DevOps URL> <[Auditor]_AML_Prüfung_ <year>_[response].xlsx>"@en ;
    gsn:refersTo fc:AML_Ev5 ;
    gsn:attachedTo fc:AML_G1_1_X_Y2 .


#  Module AML: the evidence items the solutions and the instantiation data point at.
#  Every name is a placeholder; instantiating the template replaces it with the
#  identifier of a real file.

fc:AML_Ev1 a gsn:Artefact ;
    schema:identifier "AML:Ev1" ;
    rdfs:label "[<year> <req_id> <evid_id>] File"@en .

fc:AML_Ev2 a gsn:Artefact ;
    schema:identifier "AML:Ev2" ;
    rdfs:label "<issue_id> Logs"@en .

fc:AML_Ev3 a gsn:Artefact ;
    schema:identifier "AML:Ev3" ;
    rdfs:label "<issue_id> comment"@en .

fc:AML_Ev4 a gsn:Artefact ;
    schema:identifier "AML:Ev4" ;
    rdfs:label "<[Auditor]_AML_Prüfung_ <year>.xlsx>"@en .

fc:AML_Ev5 a gsn:Artefact ;
    schema:identifier "AML:Ev5" ;
    rdfs:label "<Azure DevOps URL> <[Auditor]_AML_Prüfung_ <year>_[response].xlsx>"@en .


###############################################################################
#    Views - the four pages of the diagram
###############################################################################

#  OntoGSN carries gsn:View for the Modular Extension's notion of a view, but no
#  property whose range is gsn:View, so a view cannot be attached to the module it
#  depicts. These four record the pages the case was drawn on; the module each one
#  shows is named in its label only.

fc:V_Root a gsn:View ;
    rdfs:label "Architecture view - draw.io page \"Full\""@en ;
    gsn:viewType "architecture" .

fc:V_JAP a gsn:View ;
    rdfs:label "Argument view - draw.io page \"JAP\""@en ;
    gsn:viewType "argument" .

fc:V_BAIT a gsn:View ;
    rdfs:label "Argument view - draw.io page \"BAIT\""@en ;
    gsn:viewType "argument" .

fc:V_AML a gsn:View ;
    rdfs:label "Argument view - draw.io page \"AML\""@en ;
    gsn:viewType "argument" .

