                 fc:AML_Sn1_1_X_Y2_Z2 ,
                 fc:AML_Sn1_1_X_Y_D .


#  The architecture view draws the top strategy reaching into the three audit modules.
#  Rule S34 derives the module-level dependency from that, reading the module of each
#  end off the gsn:inModule that S53 derives; it is written out here because the module
#  dependency is what the architecture view is for. Asserting it changes nothing: run
#  the rules and S34 finds these three already present.
fc:M_Root gsn:supportedBy fc:M_JAP , fc:M_BAIT , fc:M_AML .


###############################################################################
#    Top level - draw.io page "Full"
###############################################################################

fc:Root_G0 a gsn:Goal ;
    schema:identifier "G0" ;
    rdfs:label "Goal G0"@en ;
    gsn:statement "[Organization]'s IT system is compliant with all regulatory requirements" ;
    gsn:top true ;
    gsn:supportedBy fc:Root_S0 ;
    gsn:inContextOf fc:Root_C1 .

fc:Root_C1 a gsn:Context ;
    schema:identifier "C1" ;
    rdfs:label "Context C1"@en ;
    gsn:statement "[Organization]'s IT system description" .

fc:Root_S0 a gsn:Strategy ;
    schema:identifier "S0" ;
    rdfs:label "Strategy S0"@en ;
    gsn:statement "Argument over all end-of-year audits" ;
    gsn:supportedBy fc:JAP_G1 , fc:AML_G1 , fc:BAIT_G1 .


#  Top level: the drawn relationships, reified so that the pattern decorators have
#  somewhere to sit. The identifiers are the ones rules S18, S19 and S50 mint.

fc:R_G0_inContextOf_C1 a gsn:Relationship ;
    schema:identifier "R-G0-inContextOf-C1" ;
    rdf:subject fc:Root_G0 ;
    rdf:predicate gsn:inContextOf ;
    rdf:object fc:Root_C1 ;
    gsn:relationshipType "contextual" .

fc:R_G0_supportedBy_S0 a gsn:Relationship ;
    schema:identifier "R-G0-supportedBy-S0" ;
    rdf:subject fc:Root_G0 ;
    rdf:predicate gsn:supportedBy ;
    rdf:object fc:Root_S0 ;
    gsn:relationshipType "inferential" .

fc:R_S0_supportedBy_JAP_G1 a gsn:Relationship ;
    schema:identifier "R-S0-supportedBy-JAP:G1" ;
    rdf:subject fc:Root_S0 ;
    rdf:predicate gsn:supportedBy ;
    rdf:object fc:JAP_G1 ;
    gsn:relationshipType "inferential" .

fc:R_S0_supportedBy_BAIT_G1 a gsn:Relationship ;
    schema:identifier "R-S0-supportedBy-BAIT:G1" ;
    rdf:subject fc:Root_S0 ;
    rdf:predicate gsn:supportedBy ;
    rdf:object fc:BAIT_G1 ;
    gsn:relationshipType "inferential" .

fc:R_S0_supportedBy_AML_G1 a gsn:Relationship ;
    schema:identifier "R-S0-supportedBy-AML:G1" ;
    rdf:subject fc:Root_S0 ;
    rdf:predicate gsn:supportedBy ;
    rdf:object fc:AML_G1 ;
    gsn:relationshipType "inferential" .


###############################################################################
#    Module JAP - draw.io page "JAP"
###############################################################################

fc:JAP_G1 a gsn:Goal ;
    schema:identifier "JAP:G1" ;
    rdfs:label "Goal JAP:G1"@en ;
    gsn:statement "The [Organization]'s IT system is compliant with the IT General Controls requirements" ;
    gsn:top true ;
    gsn:away true ;
    gsn:public true ;
    gsn:supportedBy fc:JAP_S1 ;
    gsn:inContextOf fc:JAP_C1 .

fc:JAP_C1 a gsn:Context ;
    schema:identifier "JAP:C1" ;
    rdfs:label "Context JAP:C1"@en ;
    gsn:statement "IT General Controls (ITGC) requirements" .

fc:JAP_S1 a gsn:Strategy ;
    schema:identifier "JAP:S1" ;
    rdfs:label "Strategy JAP:S1"@en ;
    gsn:statement "Argument from end-of-year auditing (JAP)" ;
    gsn:supportedBy fc:JAP_G1_1 ;
    gsn:inContextOf fc:JAP_C2 .

fc:JAP_C2 a gsn:Context ;
    schema:identifier "JAP:C2" ;
    rdfs:label "Context JAP:C2"@en ;
    gsn:statement "End-of-year audits (Jahresabschlussprüfung)" .

fc:JAP_G1_1 a gsn:Goal ;
    schema:identifier "JAP:G1.1" ;
    rdfs:label "Goal JAP:G1.1"@en ;
    gsn:statement "[Organization]'s IT system successfully passed all JAP audits to date" ;
    gsn:top false ;
    gsn:uninstantiated true ;
    gsn:supportedBy fc:JAP_G1_1_X ;
    gsn:inContextOf fc:JAP_C1_1 .

fc:JAP_C1_1 a gsn:Context ;
    schema:identifier "JAP:C1.1" ;
    rdfs:label "Context JAP:C1.1"@en ;
    gsn:statement "Overview of JAP audits" .

fc:JAP_G1_1_X a gsn:Goal ;
    schema:identifier "JAP:G1.1.X" ;
    rdfs:label "Goal JAP:G1.1.X"@en ;
    gsn:statement "[Organization]'s IT system successfully passed the <year> JAP audit" ;
    gsn:top false ;
    gsn:uninstantiated true ;
    gsn:supportedBy fc:JAP_G1_1_X_Y , fc:JAP_S1_1_X_1 , fc:JAP_G1_1_X_Y2 ;
    gsn:inContextOf fc:JAP_C1_1_X .

fc:JAP_C1_1_X a gsn:Context ;
    schema:identifier "JAP:C1.1.X" ;
    rdfs:label "Context JAP:C1.1.X"@en ;
    gsn:statement "<year> JAP audit metadata" ;
    gsn:uninstantiated true .

fc:JAP_S1_1_X_1 a gsn:Strategy ;
    schema:identifier "JAP:S1.1.X.1" ;
    rdfs:label "Strategy JAP:S1.1.X.1"@en ;
    gsn:statement "Argument over the ITGC categories of controls relevant to [Organization]'s IT system" ;
    gsn:uninstantiated true ;
    gsn:supportedBy fc:JAP_G1_1_X_1_N .

fc:JAP_G1_1_X_Y2 a gsn:Goal ;
    schema:identifier "JAP:G1.1.X.Y2" ;
    rdfs:label "Goal JAP:G1.1.X.Y2"@en ;
    gsn:statement "All outstanding issues that auditors have raised have been adequately addressed" ;
    gsn:top false ;
    gsn:uninstantiated true ;
    gsn:supportedBy fc:JAP_G1_1_X_Y2_Z2 .

fc:JAP_G1_1_X_Y a gsn:Goal ;
    schema:identifier "JAP:G1.1.X.Y" ;
    rdfs:label "Goal JAP:G1.1.X.Y"@en ;
    gsn:statement "<software> successfully passed the <year> JAP audit" ;
    gsn:top false ;
    gsn:uninstantiated true ;
    gsn:supportedBy fc:JAP_S1_1_X_Y ;
    gsn:inContextOf fc:JAP_C1_1_X_Y .

fc:JAP_C1_1_X_Y a gsn:Context ;
    schema:identifier "JAP:C1.1.X.Y" ;
