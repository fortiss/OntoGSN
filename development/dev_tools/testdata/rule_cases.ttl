# One minimal trigger per SWRL rule, for the queries in ontology/queries/rules/.
#
# Loaded on top of example_case.ttl. That case already fires most of the rules; this file
# adds a small, isolated scenario for each of the ones it does not, so that every rule
# query can be shown to fire rather than merely to parse.
#
# This is NOT an assurance case. Each block is a contradiction, a contract breach or a
# circularity, present so a rule has something to conclude from. Identifiers are prefixed
# with the rule number to keep the blocks apart and out of the example case's way.

@prefix rc:     <https://w3id.org/OntoGSN/example/rules#> .
@prefix ex:     <https://w3id.org/OntoGSN/example#> .
@prefix gsn:    <https://w3id.org/OntoGSN/ontology#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .

<https://w3id.org/OntoGSN/example/rules> a owl:Ontology ;
    rdfs:label "OntoGSN SWRL rule triggers"@en ;
    owl:imports <https://w3id.org/OntoGSN/ontology> .


###  RL-GSN-inferential_relation  Inferential Relation - an unclassified link whose object end is a strategy

rc:inferential_relation-G a gsn:Goal ; schema:identifier "inferential_relation-G" ;
    gsn:statement "The hazard is adequately controlled." ; gsn:supportedBy rc:inferential_relation-St .
rc:inferential_relation-St a gsn:Strategy ; schema:identifier "inferential_relation-St" ;
    gsn:statement "Argument over each control measure." .
rc:inferential_relation-R a gsn:Relationship ; schema:identifier "inferential_relation-R" ;
    rdf:subject rc:inferential_relation-G ; rdf:predicate gsn:supportedBy ; rdf:object rc:inferential_relation-St .


###  RL-GSN-context_inheritance  Context Inheritance - a goal supporting a goal, under an assumption

rc:context_inheritance-G-parent a gsn:Goal ; schema:identifier "context_inheritance-Gparent" ;
    gsn:statement "The calibration procedure is followed." ;
    gsn:inContextOf rc:context_inheritance-A ; gsn:supportedBy rc:context_inheritance-G-child .
rc:context_inheritance-G-child a gsn:Goal ; schema:identifier "context_inheritance-Gchild" ;
    gsn:statement "The procedure is executed at every scheduled service." .
rc:context_inheritance-A a gsn:Assumption ; schema:identifier "context_inheritance-A" ;
    gsn:statement "The service schedule is adhered to." .


###  RL-GSN-undeveloped_defeat  Undeveloped Defeat - a fully developed challenge against a doubted element

rc:undeveloped_defeat-G a gsn:Goal ; schema:identifier "undeveloped_defeat-G" ;
    gsn:statement "The coverage target is met." ; gsn:inDoubt true .
rc:undeveloped_defeat-D a gsn:Goal ; schema:identifier "undeveloped_defeat-D" ;
    gsn:statement "The coverage measurement excluded the error-handling paths." ;
    gsn:true true ; gsn:undeveloped false ; gsn:challenges rc:undeveloped_defeat-G .


###  RL-GSN-support_closure, RL-GSN-support_cycle_invalidation, RL-GSN-support_cycle_relationship_invalidation  Support Cycle - three goals and three relationships closing a triangle
###  This was the Predicate Conflict Invalidation trigger. Predicate Conflict Invalidation was retired in 1.3.0, superseded by the rules of the group cycles. The
###  closure that RL-GSN-support_closure derives is asserted below, because each rule query runs once on
###  this file and RL-GSN-support_cycle_invalidation and RL-GSN-support_cycle_relationship_invalidation read the closure.

rc:predicate_conflict_invalidation-G-a a gsn:Goal ; schema:identifier "predicate_conflict_invalidation-Ga" ; gsn:statement "A holds because B holds." ;
    gsn:supportedBy rc:predicate_conflict_invalidation-G-b .
rc:predicate_conflict_invalidation-G-b a gsn:Goal ; schema:identifier "predicate_conflict_invalidation-Gb" ; gsn:statement "B holds because C holds." ;
    gsn:supportedBy rc:predicate_conflict_invalidation-G-c .
rc:predicate_conflict_invalidation-G-c a gsn:Goal ; schema:identifier "predicate_conflict_invalidation-Gc" ; gsn:statement "C holds because A holds." ;
    gsn:supportedBy rc:predicate_conflict_invalidation-G-a .

rc:predicate_conflict_invalidation-R-a a gsn:Relationship ; schema:identifier "predicate_conflict_invalidation-Ra" ;
    rdf:subject rc:predicate_conflict_invalidation-G-a ; rdf:predicate gsn:supportedBy ; rdf:object rc:predicate_conflict_invalidation-G-b .
rc:predicate_conflict_invalidation-R-b a gsn:Relationship ; schema:identifier "predicate_conflict_invalidation-Rb" ;
    rdf:subject rc:predicate_conflict_invalidation-G-b ; rdf:predicate gsn:supportedBy ; rdf:object rc:predicate_conflict_invalidation-G-c .
rc:predicate_conflict_invalidation-R-c a gsn:Relationship ; schema:identifier "predicate_conflict_invalidation-Rc" ;
    rdf:subject rc:predicate_conflict_invalidation-G-c ; rdf:predicate gsn:supportedBy ; rdf:object rc:predicate_conflict_invalidation-G-a .

rc:predicate_conflict_invalidation-G-a gsn:transitivelySupportedBy rc:predicate_conflict_invalidation-G-a , rc:predicate_conflict_invalidation-G-b , rc:predicate_conflict_invalidation-G-c .
rc:predicate_conflict_invalidation-G-b gsn:transitivelySupportedBy rc:predicate_conflict_invalidation-G-a , rc:predicate_conflict_invalidation-G-b , rc:predicate_conflict_invalidation-G-c .
rc:predicate_conflict_invalidation-G-c gsn:transitivelySupportedBy rc:predicate_conflict_invalidation-G-a , rc:predicate_conflict_invalidation-G-b , rc:predicate_conflict_invalidation-G-c .


###  RL-GSN-contradictory_goal_truth  Contradictory Goal Truth - a true claim resting on a false one

rc:contradictory_goal_truth-G-parent a gsn:Goal ; schema:identifier "contradictory_goal_truth-Gparent" ;
    gsn:statement "The subsystem meets its allocated target." ;
    gsn:true true ; gsn:supportedBy rc:contradictory_goal_truth-G-child .
rc:contradictory_goal_truth-G-child a gsn:Goal ; schema:identifier "contradictory_goal_truth-Gchild" ;
    gsn:statement "The measurement campaign covered the whole operating range." ;
    gsn:true false .


###  RL-GSN-contradictory_goal_truth  a true claim resting on one true and one false claim
###  This was the Tri-Goal Conflict trigger. Tri-Goal Conflict was retired in 1.3.0 as subsumed by RL-GSN-contradictory_goal_truth, which reaches the
###  same conclusion from the false goal alone.

rc:tri_goal_conflict-G-parent a gsn:Goal ; schema:identifier "tri_goal_conflict-Gparent" ;
    gsn:statement "Both allocated targets are met." ;
    gsn:true true ; gsn:supportedBy rc:tri_goal_conflict-G-true , rc:tri_goal_conflict-G-false .
rc:tri_goal_conflict-G-true a gsn:Goal ; schema:identifier "tri_goal_conflict-Gtrue" ;
    gsn:statement "The first target is met." ; gsn:true true .
rc:tri_goal_conflict-G-false a gsn:Goal ; schema:identifier "tri_goal_conflict-Gfalse" ;
    gsn:statement "The second target is met." ; gsn:true false .


###  RL-GSN-solution_propagation_true  a defeated goal over a true solution
###  RL-GSN-solution_propagation_true must not make rc:solution_propagation_true-G true. A defeated element cannot be true.

rc:solution_propagation_true-G a gsn:Goal ; schema:identifier "solution_propagation_true-G" ;
    gsn:statement "The alarm reaches the operator within two seconds." ;
    gsn:defeated true ; gsn:supportedBy rc:solution_propagation_true-Sn .
rc:solution_propagation_true-Sn a gsn:Solution ; schema:identifier "solution_propagation_true-Sn" ;
    gsn:statement "Latency measurement of the alarm path." ; gsn:true true .


###  RL-GSN-mixed_support_invalidation  Mixed Support Invalidation - one valid and one invalid support

rc:mixed_support_invalidation-G a gsn:Goal ; schema:identifier "mixed_support_invalidation-G" ;
    gsn:statement "The integration argument is complete." ;
    gsn:supportedBy rc:mixed_support_invalidation-G-valid , rc:mixed_support_invalidation-G-invalid .
rc:mixed_support_invalidation-G-valid a gsn:Goal ; schema:identifier "mixed_support_invalidation-Gvalid" ;
    gsn:statement "The interface tests passed." ; gsn:valid true .
rc:mixed_support_invalidation-G-invalid a gsn:Goal ; schema:identifier "mixed_support_invalidation-Ginvalid" ;
    gsn:statement "The timing analysis was completed." ; gsn:valid false .


###  RL-GSN-solution_propagation_false  mixed support - one solution holds, the other does not
###  This was the Conflicting Support (False) trigger. Conflicting Support (False) was retired in 1.2.3 as subsumed by RL-GSN-solution_propagation_false, which reaches the
###  same conclusion from the failing solution alone. The block is kept because mixed support
###  is the case RL-GSN-solution_propagation_true's guard turns on, and it is the one that used to make the rule set loop.

rc:conflicting_support_false-G a gsn:Goal ; schema:identifier "conflicting_support_false-G" ;
    gsn:statement "The detection threshold is correctly configured." ;
    gsn:supportedBy rc:conflicting_support_false-Sn-true , rc:conflicting_support_false-Sn-false .
rc:conflicting_support_false-Sn-true a gsn:Solution ; schema:identifier "conflicting_support_false-Sntrue" ;
    gsn:statement "Configuration audit report." ; gsn:true true .
rc:conflicting_support_false-Sn-false a gsn:Solution ; schema:identifier "conflicting_support_false-Snfalse" ;
    gsn:statement "Regression run over the shipped configuration." ; gsn:true false .


###  RL-GSN-relation_false_propagation  Relation False Propagation - a contextual link asserted not to hold

rc:relation_false_propagation-G a gsn:Goal ; schema:identifier "relation_false_propagation-G" ;
    gsn:statement "The subsystem is used only within the stated envelope." ;
    gsn:inContextOf rc:relation_false_propagation-C .
rc:relation_false_propagation-C a gsn:Context ; schema:identifier "relation_false_propagation-C" ;
    gsn:statement "The envelope is given in ENV-SPEC-01." .
rc:relation_false_propagation-R a gsn:Relationship ; schema:identifier "relation_false_propagation-R" ;
    rdf:subject rc:relation_false_propagation-G ; rdf:predicate gsn:inContextOf ; rdf:object rc:relation_false_propagation-C ;
    gsn:true false .


###  RL-GSN-final_pattern_invalidation  Final Pattern Invalidation - a finalised argument still holding a pattern

rc:final_pattern_invalidation-Arg a gsn:Argument ; schema:identifier "final_pattern_invalidation-Arg" ;
    gsn:statement "Argument declared final while a pattern is still being instantiated." ;
    gsn:structured true ; gsn:final true ;
    gsn:contains rc:final_pattern_invalidation-G , rc:final_pattern_invalidation-P .
rc:final_pattern_invalidation-P a gsn:Pattern ; schema:identifier "final_pattern_invalidation-P" ;
    schema:description "A pattern left inside a finalised argument." .
rc:final_pattern_invalidation-G a gsn:Goal ; schema:identifier "final_pattern_invalidation-G" ;
    gsn:statement "The monitored channel is trustworthy." ;
    gsn:instantiationOf rc:final_pattern_invalidation-P .


###  RL-GSN-template_undeveloped_invalidation_a, RL-GSN-template_undeveloped_invalidation_b  Template Undeveloped Invalidation - published with an undeveloped link

rc:template_undeveloped_invalidation_a-T a gsn:Template ; schema:identifier "template_undeveloped_invalidation_a-T" ;
    schema:description "A template published with an undeveloped relationship on itself." ;
    gsn:published true .
rc:template_undeveloped_invalidation_a-R a gsn:Relationship ; schema:identifier "template_undeveloped_invalidation_a-R" ;
    rdf:subject rc:template_undeveloped_invalidation_a-T ; rdf:predicate gsn:supportedBy ;
    gsn:undeveloped true .

rc:template_undeveloped_invalidation_b-T a gsn:Template ; schema:identifier "template_undeveloped_invalidation_b-T" ;
    schema:description "A template published with an undeveloped relationship inside it." ;
    gsn:published true ; gsn:contains rc:template_undeveloped_invalidation_b-G .
rc:template_undeveloped_invalidation_b-G a gsn:Goal ; schema:identifier "template_undeveloped_invalidation_b-G" ;
    gsn:statement "The instantiated channel meets its allocated interval." .
rc:template_undeveloped_invalidation_b-R a gsn:Relationship ; schema:identifier "template_undeveloped_invalidation_b-R" ;
    rdf:subject rc:template_undeveloped_invalidation_b-G ; rdf:predicate gsn:supportedBy ;
    gsn:undeveloped true .


###  RL-GSN-contract_violation_relation, RL-GSN-context_contract_invalidation  Contract violations - a contract module arguing across its own boundary

rc:contract_violation_relation-M-contract a gsn:Module ; schema:identifier "contract_violation_relation-Mcontract" ;
    gsn:statement "A contract module whose content reaches into another module directly." ;
    gsn:contract true ; gsn:contains rc:contract_violation_relation-Arg-contract .
rc:contract_violation_relation-Arg-contract a gsn:Argument ; schema:identifier "contract_violation_relation-Argcontract" ;
    gsn:statement "Argument of the contract module." ;
    gsn:contains rc:contract_violation_relation-G , rc:context_contract_invalidation-G .
rc:contract_violation_relation-M-other a gsn:Module ; schema:identifier "contract_violation_relation-Mother" ;
    gsn:statement "The module reached into." ; gsn:contract false ;
    gsn:contains rc:contract_violation_relation-Arg-other .
rc:contract_violation_relation-Arg-other a gsn:Argument ; schema:identifier "contract_violation_relation-Argother" ;
    gsn:statement "Argument of the module reached into." ;
    gsn:contains rc:contract_violation_relation-G-target .
rc:contract_violation_relation-G-target a gsn:Goal ; schema:identifier "contract_violation_relation-Gtarget" ;
    gsn:statement "The supplied component meets its published envelope." .

rc:contract_violation_relation-G a gsn:Goal ; schema:identifier "contract_violation_relation-G" ;
    gsn:statement "The contract is discharged by the other module." ;
    gsn:supportedBy rc:contract_violation_relation-M-other .
rc:contract_violation_relation-R a gsn:Relationship ; schema:identifier "contract_violation_relation-R" ;
    rdf:subject rc:contract_violation_relation-G ; rdf:predicate gsn:supportedBy ; rdf:object rc:contract_violation_relation-M-other .

rc:context_contract_invalidation-G a gsn:Goal ; schema:identifier "context_contract_invalidation-G" ;
    gsn:statement "The contract is read in the other module's context." ;
    gsn:inContextOf rc:contract_violation_relation-M-other .
rc:context_contract_invalidation-R a gsn:Relationship ; schema:identifier "context_contract_invalidation-R" ;
    rdf:subject rc:context_contract_invalidation-G ; rdf:predicate gsn:inContextOf ; rdf:object rc:contract_violation_relation-M-other .


###  RL-GSN-contract_support_invalidation  Contract Support Invalidation - awaiting a contract inside a contract module

rc:contract_support_invalidation-M a gsn:Module ; schema:identifier "contract_support_invalidation-M" ;
    gsn:statement "A contract module containing a claim that itself awaits a contract." ;
    gsn:contract true ; gsn:contains rc:contract_support_invalidation-Arg .
rc:contract_support_invalidation-Arg a gsn:Argument ; schema:identifier "contract_support_invalidation-Arg" ;
    gsn:statement "Argument of the contract module awaiting a contract." ; gsn:contains rc:contract_support_invalidation-G .
rc:contract_support_invalidation-G a gsn:Goal ; schema:identifier "contract_support_invalidation-G" ;
    gsn:statement "Timing is discharged elsewhere." ;
    gsn:toBeSupportedByContract true .


###  RL-GSN-away_goal_invalidation  Away Goal Invalidation - an away goal supported directly across modules

rc:away_goal_invalidation-M-a a gsn:Module ; schema:identifier "away_goal_invalidation-Ma" ;
    gsn:statement "The module holding the away reference." ; gsn:contains rc:away_goal_invalidation-Arg-a .
rc:away_goal_invalidation-Arg-a a gsn:Argument ; schema:identifier "away_goal_invalidation-Arga" ;
    gsn:statement "Argument holding the away reference." ; gsn:contains rc:away_goal_invalidation-G-away .
rc:away_goal_invalidation-M-b a gsn:Module ; schema:identifier "away_goal_invalidation-Mb" ;
    gsn:statement "The module holding the original." ; gsn:contains rc:away_goal_invalidation-Arg-b .
rc:away_goal_invalidation-Arg-b a gsn:Argument ; schema:identifier "away_goal_invalidation-Argb" ;
    gsn:statement "Argument holding the original." ; gsn:contains rc:away_goal_invalidation-G-home .
rc:away_goal_invalidation-G-away a gsn:Goal ; schema:identifier "away_goal_invalidation-Gaway" ;
    gsn:statement "The platform meets its published latency bound." ;
    gsn:away true ; gsn:supportedBy rc:away_goal_invalidation-G-home .
rc:away_goal_invalidation-G-home a gsn:Goal ; schema:identifier "away_goal_invalidation-Ghome" ;
    gsn:statement "The platform meets its published latency bound." .
rc:away_goal_invalidation-R a gsn:Relationship ; schema:identifier "away_goal_invalidation-R" ;
    rdf:subject rc:away_goal_invalidation-G-away ; rdf:predicate gsn:supportedBy ; rdf:object rc:away_goal_invalidation-G-home .


###  RL-GSN-contract_activation  Contract Activation - an away claim awaiting a contract from another module

rc:contract_activation-M-a a gsn:Module ; schema:identifier "contract_activation-Ma" ;
    gsn:statement "The module making the demand." ; gsn:contains rc:contract_activation-Arg-a .
rc:contract_activation-Arg-a a gsn:Argument ; schema:identifier "contract_activation-Arga" ;
    gsn:statement "Argument making the demand." ; gsn:contains rc:contract_activation-G .
rc:contract_activation-M-b a gsn:Module ; schema:identifier "contract_activation-Mb" ;
    gsn:statement "The module that becomes a contract module." ; gsn:contains rc:contract_activation-Arg-b .
rc:contract_activation-Arg-b a gsn:Argument ; schema:identifier "contract_activation-Argb" ;
    gsn:statement "Argument of the supplying module." ; gsn:contains rc:contract_activation-G-supplier .
rc:contract_activation-G a gsn:Goal ; schema:identifier "contract_activation-G" ;
    gsn:statement "The demand is discharged by the supplier." ;
    gsn:away true ; gsn:toBeSupportedByContract true ;
    gsn:supportedBy rc:contract_activation-G-supplier .
rc:contract_activation-G-supplier a gsn:Goal ; schema:identifier "contract_activation-Gsupplier" ;
    gsn:statement "The supplier's component meets the demanded bound." .


###  RL-GSN-contract_relation_invalidation  Contract Relation Invalidation - contract demand satisfied within one module

rc:contract_relation_invalidation-M a gsn:Module ; schema:identifier "contract_relation_invalidation-M" ;
    gsn:statement "One module holding both ends of a link that should cross a contract." ;
    gsn:contains rc:contract_relation_invalidation-Arg .
rc:contract_relation_invalidation-Arg a gsn:Argument ; schema:identifier "contract_relation_invalidation-Arg" ;
    gsn:statement "Argument holding both ends of the link." ;
    gsn:contains rc:contract_relation_invalidation-G , rc:contract_relation_invalidation-G-support .
rc:contract_relation_invalidation-G a gsn:Goal ; schema:identifier "contract_relation_invalidation-G" ;
    gsn:statement "Timing is discharged by contract." ;
    gsn:toBeSupportedByContract true ;
    gsn:supportedBy rc:contract_relation_invalidation-G-support .
rc:contract_relation_invalidation-G-support a gsn:Goal ; schema:identifier "contract_relation_invalidation-Gsupport" ;
    gsn:statement "The local timing analysis is sufficient." .
rc:contract_relation_invalidation-R a gsn:Relationship ; schema:identifier "contract_relation_invalidation-R" ;
    rdf:subject rc:contract_relation_invalidation-G ; rdf:predicate gsn:supportedBy ; rdf:object rc:contract_relation_invalidation-G-support .


###  RL-GSN-context_consistency  Context Consistency - context on both sides of an away support link

rc:context_consistency-G a gsn:Goal ; schema:identifier "context_consistency-G" ;
    gsn:statement "The subsystem is safe in the stated environment." ;
    gsn:inContextOf rc:context_consistency-C-local ; gsn:supportedBy rc:context_consistency-G-away .
rc:context_consistency-C-local a gsn:Context ; schema:identifier "context_consistency-Clocal" ;
    gsn:statement "The environment is defined in ENV-SPEC-02." .
rc:context_consistency-G-away a gsn:Goal ; schema:identifier "context_consistency-Gaway" ;
    gsn:statement "The supplied component is safe in its stated environment." ;
    gsn:away true ; gsn:inContextOf rc:context_consistency-C-remote .
rc:context_consistency-C-remote a gsn:Context ; schema:identifier "context_consistency-Cremote" ;
    gsn:statement "The supplier's environment is defined in SUP-ENV-01." .


###  RL-GSN-support_cycle_invalidation  Support Cycle Invalidation - three modules resting on each other
###  This was the Circular Module Invalidation trigger. Circular Module Invalidation was retired in 1.3.0, superseded by RL-GSN-support_cycle_invalidation, which finds a
###  support cycle of any length. Only the part of the closure that RL-GSN-support_cycle_invalidation reads is asserted.

rc:circular_module_invalidation-M-a a gsn:Module ; schema:identifier "circular_module_invalidation-Ma" ;
    gsn:statement "First module in the cycle." ; gsn:supportedBy rc:circular_module_invalidation-M-b ;
    gsn:contains rc:circular_module_invalidation-Arg-a .
rc:circular_module_invalidation-Arg-a a gsn:Argument ; schema:identifier "circular_module_invalidation-Arga" ;
    gsn:statement "Argument of the first module in the cycle." ; gsn:contains rc:circular_module_invalidation-G-a .
rc:circular_module_invalidation-G-a a gsn:Goal ; schema:identifier "circular_module_invalidation-Ga" ; gsn:statement "First claim in the cycle." .
rc:circular_module_invalidation-M-b a gsn:Module ; schema:identifier "circular_module_invalidation-Mb" ;
    gsn:statement "Second module in the cycle." ; gsn:supportedBy rc:circular_module_invalidation-M-c ;
    gsn:contains rc:circular_module_invalidation-Arg-b .
rc:circular_module_invalidation-Arg-b a gsn:Argument ; schema:identifier "circular_module_invalidation-Argb" ;
    gsn:statement "Argument of the second module in the cycle." ; gsn:contains rc:circular_module_invalidation-G-b .
rc:circular_module_invalidation-G-b a gsn:Goal ; schema:identifier "circular_module_invalidation-Gb" ; gsn:statement "Second claim in the cycle." .
rc:circular_module_invalidation-M-c a gsn:Module ; schema:identifier "circular_module_invalidation-Mc" ;
    gsn:statement "Third module in the cycle." ; gsn:supportedBy rc:circular_module_invalidation-M-a ;
    gsn:contains rc:circular_module_invalidation-Arg-c .
rc:circular_module_invalidation-Arg-c a gsn:Argument ; schema:identifier "circular_module_invalidation-Argc" ;
    gsn:statement "Argument of the third module in the cycle." ; gsn:contains rc:circular_module_invalidation-G-c .
rc:circular_module_invalidation-G-c a gsn:Goal ; schema:identifier "circular_module_invalidation-Gc" ; gsn:statement "Third claim in the cycle." .

rc:circular_module_invalidation-M-a gsn:transitivelySupportedBy rc:circular_module_invalidation-M-a .
rc:circular_module_invalidation-M-b gsn:transitivelySupportedBy rc:circular_module_invalidation-M-b .
rc:circular_module_invalidation-M-c gsn:transitivelySupportedBy rc:circular_module_invalidation-M-c .


###  RL-GSN-module_context_closure, RL-GSN-module_context_cycle_invalidation, RL-GSN-module_context_cycle_relationship_invalidation  Module Context Cycle - three modules, each in the context of the next
###  Only the part of the closure that RL-GSN-module_context_cycle_invalidation and RL-GSN-module_context_cycle_relationship_invalidation read is asserted, so that RL-GSN-module_context_closure still has
###  links to derive.

rc:module_context_closure-M-a a gsn:Module ; schema:identifier "module_context_closure-Ma" ;
    gsn:statement "First module in the context cycle." ; gsn:inContextOf rc:module_context_closure-M-b ;
    gsn:contains rc:module_context_closure-Arg-a .
rc:module_context_closure-Arg-a a gsn:Argument ; schema:identifier "module_context_closure-Arga" ;
    gsn:statement "Argument of the first module in the context cycle." .
rc:module_context_closure-M-b a gsn:Module ; schema:identifier "module_context_closure-Mb" ;
    gsn:statement "Second module in the context cycle." ; gsn:inContextOf rc:module_context_closure-M-c ;
    gsn:contains rc:module_context_closure-Arg-b .
rc:module_context_closure-Arg-b a gsn:Argument ; schema:identifier "module_context_closure-Argb" ;
    gsn:statement "Argument of the second module in the context cycle." .
rc:module_context_closure-M-c a gsn:Module ; schema:identifier "module_context_closure-Mc" ;
    gsn:statement "Third module in the context cycle." ; gsn:inContextOf rc:module_context_closure-M-a ;
    gsn:contains rc:module_context_closure-Arg-c .
rc:module_context_closure-Arg-c a gsn:Argument ; schema:identifier "module_context_closure-Argc" ;
    gsn:statement "Argument of the third module in the context cycle." .
rc:module_context_closure-R a gsn:Relationship ; schema:identifier "module_context_closure-R" ;
    rdf:subject rc:module_context_closure-M-a ; rdf:predicate gsn:inContextOf ; rdf:object rc:module_context_closure-M-b .

rc:module_context_closure-M-a gsn:transitivelyInContextOf rc:module_context_closure-M-a .
rc:module_context_closure-M-b gsn:transitivelyInContextOf rc:module_context_closure-M-a , rc:module_context_closure-M-b .
rc:module_context_closure-M-c gsn:transitivelyInContextOf rc:module_context_closure-M-c .


###  RL-GSN-challenge_closure, RL-GSN-challenge_cycle_invalidation, RL-GSN-challenge_cycle_relationship_invalidation  Challenge Cycle - two goals that challenge each other
###  The closure that RL-GSN-challenge_closure derives is asserted, because RL-GSN-challenge_cycle_invalidation and RL-GSN-challenge_cycle_relationship_invalidation read it.

rc:challenge_closure-D-a a gsn:Goal ; schema:identifier "challenge_closure-Da" ;
    gsn:statement "The test campaign missed the low-temperature cases." ;
    gsn:challenges rc:challenge_closure-D-b .
rc:challenge_closure-D-b a gsn:Goal ; schema:identifier "challenge_closure-Db" ;
    gsn:statement "The low-temperature cases are outside the operating range." ;
    gsn:challenges rc:challenge_closure-D-a .
rc:challenge_closure-R a gsn:Relationship ; schema:identifier "challenge_closure-R" ;
    rdf:subject rc:challenge_closure-D-a ; rdf:predicate gsn:challenges ; rdf:object rc:challenge_closure-D-b .

rc:challenge_closure-D-a gsn:transitivelyChallenges rc:challenge_closure-D-a , rc:challenge_closure-D-b .
rc:challenge_closure-D-b gsn:transitivelyChallenges rc:challenge_closure-D-a , rc:challenge_closure-D-b .


###  RL-GSN-support_doubt_propagation, RL-GSN-context_doubt_propagation  Doubt Propagation - a link in doubt puts the element that relies on it in doubt
###  Each link is asserted in doubt, as RL-GSN-challenge_doubt leaves it after a true goal challenges it.
###  rc:support_doubt_propagation-D is the subject of a challenge link in doubt. No rule puts it in doubt.

rc:support_doubt_propagation-G a gsn:Goal ; schema:identifier "support_doubt_propagation-G" ;
    gsn:statement "The controller meets its timing budget." ;
    gsn:supportedBy rc:support_doubt_propagation-G-sub .
rc:support_doubt_propagation-G-sub a gsn:Goal ; schema:identifier "support_doubt_propagation-Gsub" ;
    gsn:statement "The worst-case execution time is below the budget." .
rc:support_doubt_propagation-R a gsn:Relationship ; schema:identifier "support_doubt_propagation-R" ;
    rdf:subject rc:support_doubt_propagation-G ; rdf:predicate gsn:supportedBy ; rdf:object rc:support_doubt_propagation-G-sub ;
    gsn:inDoubt true .

rc:context_doubt_propagation-G a gsn:Goal ; schema:identifier "context_doubt_propagation-G" ;
    gsn:statement "The timing budget holds on the target hardware." ;
    gsn:inContextOf rc:context_doubt_propagation-C .
rc:context_doubt_propagation-C a gsn:Context ; schema:identifier "context_doubt_propagation-C" ;
    gsn:statement "The target hardware is given in HW-SPEC-02." .
rc:context_doubt_propagation-R a gsn:Relationship ; schema:identifier "context_doubt_propagation-R" ;
    rdf:subject rc:context_doubt_propagation-G ; rdf:predicate gsn:inContextOf ; rdf:object rc:context_doubt_propagation-C ;
    gsn:inDoubt true .

rc:support_doubt_propagation-D a gsn:Goal ; schema:identifier "support_doubt_propagation-D" ;
    gsn:statement "The measurements were taken on a different board revision." ;
    gsn:challenges rc:support_doubt_propagation-G-sub .
rc:support_doubt_propagation-R-c a gsn:Relationship ; schema:identifier "support_doubt_propagation-Rc" ;
    rdf:subject rc:support_doubt_propagation-D ; rdf:predicate gsn:challenges ; rdf:object rc:support_doubt_propagation-G-sub ;
    gsn:inDoubt true .


###  RL-GSN-goal_strategy_confidence  Goal-Strategy Confidence - a claim point below a strategy, propagated upwards

rc:goal_strategy_confidence-ConfArg a gsn:Argument ; schema:identifier "goal_strategy_confidence-ConfArg" ;
    gsn:statement "Confidence in the decomposition below this strategy." ;
    gsn:argumentType "confidence" ; gsn:structured true .
rc:goal_strategy_confidence-G-parent a gsn:Goal ; schema:identifier "goal_strategy_confidence-Gparent" ;
    gsn:statement "The decomposition below is sound." ; gsn:supportedBy rc:goal_strategy_confidence-St .
rc:goal_strategy_confidence-St a gsn:Strategy ; schema:identifier "goal_strategy_confidence-St" ;
    gsn:statement "Argument over each contributing factor." ;
    gsn:supportedBy rc:goal_strategy_confidence-G-child .
rc:goal_strategy_confidence-G-child a gsn:Goal ; schema:identifier "goal_strategy_confidence-Gchild" ;
    gsn:statement "The first contributing factor is bounded." .
rc:goal_strategy_confidence-R a gsn:RelationshipWithConfidence ; schema:identifier "goal_strategy_confidence-R" ;
    rdf:subject rc:goal_strategy_confidence-St ; rdf:predicate gsn:supportedBy ; rdf:object rc:goal_strategy_confidence-G-child ;
    gsn:assuranceClaimPoint true ; gsn:associatedWith rc:goal_strategy_confidence-ConfArg .


###  RL-GSN-solution_confidence_relation  Solution Confidence Relation - a claim point on one of two sibling solutions

rc:solution_confidence_relation-ConfArg a gsn:Argument ; schema:identifier "solution_confidence_relation-ConfArg" ;
    gsn:statement "Confidence in the evidence cited for this claim." ;
    gsn:argumentType "confidence" ; gsn:structured true .
rc:solution_confidence_relation-G a gsn:Goal ; schema:identifier "solution_confidence_relation-G" ;
    gsn:statement "The component behaves as specified." ;
    gsn:supportedBy rc:solution_confidence_relation-Sn-a , rc:solution_confidence_relation-Sn-b .
rc:solution_confidence_relation-Sn-a a gsn:Solution ; schema:identifier "solution_confidence_relation-Sna" ;
    gsn:statement "Unit test report." .
rc:solution_confidence_relation-Sn-b a gsn:Solution ; schema:identifier "solution_confidence_relation-Snb" ;
    gsn:statement "Static analysis report." .
rc:solution_confidence_relation-R a gsn:RelationshipWithConfidence ; schema:identifier "solution_confidence_relation-R" ;
    rdf:subject rc:solution_confidence_relation-G ; rdf:predicate gsn:supportedBy ; rdf:object rc:solution_confidence_relation-Sn-a ;
    gsn:assuranceClaimPoint true ; gsn:associatedWith rc:solution_confidence_relation-ConfArg .


###  RL-GSN-goal_confidence_relation  Goal Confidence Relation - a claim point on one of two sibling goals

rc:goal_confidence_relation-ConfArg a gsn:Argument ; schema:identifier "goal_confidence_relation-ConfArg" ;
    gsn:statement "Confidence in the completeness of this decomposition." ;
    gsn:argumentType "confidence" ; gsn:structured true .
rc:goal_confidence_relation-G a gsn:Goal ; schema:identifier "goal_confidence_relation-G" ;
    gsn:statement "Both failure modes are addressed." ;
    gsn:supportedBy rc:goal_confidence_relation-G-a , rc:goal_confidence_relation-G-b .
rc:goal_confidence_relation-G-a a gsn:Goal ; schema:identifier "goal_confidence_relation-Ga" ;
    gsn:statement "The first failure mode is addressed." .
rc:goal_confidence_relation-G-b a gsn:Goal ; schema:identifier "goal_confidence_relation-Gb" ;
    gsn:statement "The second failure mode is addressed." .
rc:goal_confidence_relation-R a gsn:RelationshipWithConfidence ; schema:identifier "goal_confidence_relation-R" ;
    rdf:subject rc:goal_confidence_relation-G ; rdf:predicate gsn:supportedBy ; rdf:object rc:goal_confidence_relation-G-a ;
    gsn:assuranceClaimPoint true ; gsn:associatedWith rc:goal_confidence_relation-ConfArg .


###  RL-GSN-challenge_chain_invalidation  Challenge Chain Invalidation - a challenge levied at one of several support links
###  The parent has two supporting goals, so the inference is composite and the challenge below
###  reaches only part of it. That is the situation 1:6.3.12 says requires a strategy.

rc:challenge_chain_invalidation-G-parent a gsn:Goal ; schema:identifier "challenge_chain_invalidation-Gparent" ;
    gsn:statement "The mitigation is effective." ;
    gsn:supportedBy rc:challenge_chain_invalidation-G-child , rc:challenge_chain_invalidation-G-sibling .
rc:challenge_chain_invalidation-G-child a gsn:Goal ; schema:identifier "challenge_chain_invalidation-Gchild" ;
    gsn:statement "The mitigation was tested." .
rc:challenge_chain_invalidation-G-sibling a gsn:Goal ; schema:identifier "challenge_chain_invalidation-Gsibling" ;
    gsn:statement "The mitigation is deployed on every affected unit." .
rc:challenge_chain_invalidation-R a gsn:Relationship ; schema:identifier "challenge_chain_invalidation-R" ;
    rdf:subject rc:challenge_chain_invalidation-G-parent ; rdf:predicate gsn:supportedBy ; rdf:object rc:challenge_chain_invalidation-G-child .
rc:challenge_chain_invalidation-D a gsn:Goal ; schema:identifier "challenge_chain_invalidation-D" ;
    gsn:statement "Testing the mitigation does not establish that it is effective." ;
    gsn:true true ; gsn:challenges rc:challenge_chain_invalidation-R .


###  RL-GSN-nested_module_membership  Nested Module Membership - a module inside a module

rc:nested_module_membership-M-outer a gsn:Module ; schema:identifier "nested_module_membership-Mouter" ;
    gsn:statement "The enclosing module." ;
    gsn:contains rc:nested_module_membership-M-inner , rc:nested_module_membership-Arg-outer .
rc:nested_module_membership-Arg-outer a gsn:Argument ; schema:identifier "nested_module_membership-Argouter" ;
    gsn:statement "Argument of the enclosing module." ;
    gsn:contains rc:nested_module_membership-G-outer .
rc:nested_module_membership-G-outer a gsn:Goal ; schema:identifier "nested_module_membership-Gouter" ;
    gsn:statement "The enclosing claim." .
rc:nested_module_membership-M-inner a gsn:Module ; schema:identifier "nested_module_membership-Minner" ;
    gsn:statement "The nested module." ;
    gsn:contains rc:nested_module_membership-Arg-inner .
rc:nested_module_membership-Arg-inner a gsn:Argument ; schema:identifier "nested_module_membership-Arginner" ;
    gsn:statement "Argument of the nested module." ;
    gsn:contains rc:nested_module_membership-G-inner .
rc:nested_module_membership-G-inner a gsn:Goal ; schema:identifier "nested_module_membership-Ginner" ;
    gsn:statement "The nested claim." .

# RL-GSN-nested_module_membership's premise, given so it can be exercised alone. The outer memberships are deliberately
# absent: deriving them is what RL-GSN-module_membership and RL-GSN-nested_module_membership are being tested for.
rc:nested_module_membership-G-inner gsn:inModule rc:nested_module_membership-M-inner .


#################################################################
#    Module membership, given rather than authored
#
#    gsn:inModule is derived: rule RL-GSN-module_membership reads it off Module -> Argument -> element, and RL-GSN-nested_module_membership
#    carries it up through nested modules. Every other rule of the Modular Extension consumes
#    it in a single atom.
#
#    development/dev_tools/query_check.py verifies each rule against a fresh store, so a rule whose premise
#    another rule derives would never fire and would look broken. These are the facts RL-GSN-module_membership and
#    RL-GSN-nested_module_membership produce from the two fixtures, stated here so that the fourteen rules that depend on
#    them can each be exercised alone. ontology/example/run_rules.py derives the same set for itself and
#    adds nothing, which is the check that this block has not drifted.
#################################################################


ex:A1 gsn:inModule ex:M1 .
ex:C1 gsn:inModule ex:M1 .
ex:C2 gsn:inModule ex:M1 .
ex:G1 gsn:inModule ex:M1 .
ex:G1_1 gsn:inModule ex:M1 .
ex:G1_2 gsn:inModule ex:M1 .
ex:G1_3 gsn:inModule ex:M1 .
ex:J1 gsn:inModule ex:M1 .
ex:Sn1 gsn:inModule ex:M1 .
ex:Sn2 gsn:inModule ex:M1 .
ex:Sn3 gsn:inModule ex:M1 .
ex:St1 gsn:inModule ex:M1 .

ex:C3 gsn:inModule ex:M2 .
ex:G2 gsn:inModule ex:M2 .
ex:Sn4 gsn:inModule ex:M2 .

ex:G3 gsn:inModule ex:M3 .

ex:D1 gsn:inModule ex:M4 .
ex:D2 gsn:inModule ex:M4 .
ex:Orphan1 gsn:inModule ex:M4 .
ex:X1 gsn:inModule ex:M4 .
ex:X2 gsn:inModule ex:M4 .

rc:contract_violation_relation-G gsn:inModule rc:contract_violation_relation-M-contract .
rc:context_contract_invalidation-G gsn:inModule rc:contract_violation_relation-M-contract .

rc:contract_violation_relation-G-target gsn:inModule rc:contract_violation_relation-M-other .

rc:contract_support_invalidation-G gsn:inModule rc:contract_support_invalidation-M .

rc:away_goal_invalidation-G-away gsn:inModule rc:away_goal_invalidation-M-a .

rc:away_goal_invalidation-G-home gsn:inModule rc:away_goal_invalidation-M-b .

rc:contract_activation-G gsn:inModule rc:contract_activation-M-a .

rc:contract_activation-G-supplier gsn:inModule rc:contract_activation-M-b .

rc:contract_relation_invalidation-G gsn:inModule rc:contract_relation_invalidation-M .
rc:contract_relation_invalidation-G-support gsn:inModule rc:contract_relation_invalidation-M .

rc:circular_module_invalidation-G-a gsn:inModule rc:circular_module_invalidation-M-a .

rc:circular_module_invalidation-G-b gsn:inModule rc:circular_module_invalidation-M-b .

rc:circular_module_invalidation-G-c gsn:inModule rc:circular_module_invalidation-M-c .




###  RL-GSN-duplicate_acp_identifier_invalidation  Duplicate ACP Identifier Invalidation - two assurance claim points, one identifier
###  RL-GSN-duplicate_identifier_invalidation cannot reach this: it only looks within one module. The two solutions are in
###  different arguments and in no module, and both are assurance claim points.

rc:duplicate_acp_identifier_invalidation-Arg-a a gsn:Argument ; schema:identifier "duplicate_acp_identifier_invalidation-Arga" ;
    gsn:statement "First argument." ; gsn:contains rc:duplicate_acp_identifier_invalidation-Sn-a .
rc:duplicate_acp_identifier_invalidation-Arg-b a gsn:Argument ; schema:identifier "duplicate_acp_identifier_invalidation-Argb" ;
    gsn:statement "Second argument." ; gsn:contains rc:duplicate_acp_identifier_invalidation-Sn-b .
rc:duplicate_acp_identifier_invalidation-Sn-a a gsn:Solution ; schema:identifier "ACP-1" ;
    gsn:statement "Static analysis report." ;
    gsn:assuranceClaimPoint true ; gsn:associatedWith rc:duplicate_acp_identifier_invalidation-ConfArg-a ; gsn:refersTo rc:duplicate_acp_identifier_invalidation-Ev .
rc:duplicate_acp_identifier_invalidation-Sn-b a gsn:Solution ; schema:identifier "ACP-1" ;
    gsn:statement "An unrelated review record, sharing the identifier." ;
    gsn:assuranceClaimPoint true ; gsn:associatedWith rc:duplicate_acp_identifier_invalidation-ConfArg-b ; gsn:refersTo rc:duplicate_acp_identifier_invalidation-Ev .
rc:duplicate_acp_identifier_invalidation-Ev a gsn:Artefact ; schema:identifier "duplicate_acp_identifier_invalidation-Ev" ;
    schema:description "The artefact both solutions refer to." .
rc:duplicate_acp_identifier_invalidation-ConfArg-a a gsn:Argument ; schema:identifier "duplicate_acp_identifier_invalidation-ConfArga" ;
    gsn:statement "Confidence in the static analysis report." ;
    gsn:argumentType "confidence" ; gsn:structured true .
rc:duplicate_acp_identifier_invalidation-ConfArg-b a gsn:Argument ; schema:identifier "duplicate_acp_identifier_invalidation-ConfArgb" ;
    gsn:statement "Confidence in the review record." ;
    gsn:argumentType "confidence" ; gsn:structured true .
