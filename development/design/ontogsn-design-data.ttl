    gsndesign:positionKey "S06.R028" ;
    gsndesign:part gsndesign:part-1 ;
    gsndesign:section gsndesign:sec-modular ;
    gsndesign:formalism gsndesign:SWRL ;
    gsndesign:naturalLanguage "IF A has in module M AND B has in module N AND N is a module AND A is in the context of B AND M is a module AND M is not the same as N THEN B is away"@en ;
    gsndesign:nlWrittenFor "b93add79" ;
    prov:used gsndesign:src-0143 ;
    gsndesign:hasRationale gsndesign:why-0076 ;
