    a gsndesign:StatementRecord ;
    prov:wasGeneratedBy gsndesign:dd-0928 ;
    gsndesign:inGraph gsndesign:shapes-1.0.3 ;
    gsndesign:statementText """gsnsh:ChallengesRangePropertyShape gsn:coreOrExtension "Dialectic Extension"@en ;
    rdf:type sh:NodeShape ;
    rdfs:comment "The declared rdfs:range is gsn:GSNElement only, but gsn:Goal and gsn:Solution both carry an owl:allValuesFrom restriction admitting gsn:Relationship as well, and the standard states that a challenge can be directed at any part of an argument. gsn:Relationship is therefore admitted here."@en ;
    rdfs:label "gsn:challenges — range"@en ;
    sh:message "A challenge must be directed at a GSN element or a relationship."@en ;
    sh:or ( [ sh:class gsn:GSNElement ] [ sh:class gsn:Relationship ] ) ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf gsn:challenges .""" ;
    gsndesign:statementChecksum "0b3005ee" ;
    gsndesign:structuralKey "gsnsh:ChallengesRangePropertyShape|node|" ;
    gsndesign:aboutTerm gsnsh:ChallengesRangePropertyShape ;
    gsndesign:mentionsTerm gsn:GSNElement ,
        gsn:Goal ,
        gsn:Relationship ,
        gsn:Solution ,
        gsn:challenges ,
        gsn:coreOrExtension ,
        gsnsh:ChallengesRangePropertyShape .

