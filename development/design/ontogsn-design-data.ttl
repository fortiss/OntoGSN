gsndesign:dd-0678
    a gsndesign:RetiredDecision ;
    gsndesign:positionKey "S07.R036" ;
    gsndesign:part gsndesign:part-1 ;
    gsndesign:section gsndesign:sec-confidence ;
    gsndesign:formalism gsndesign:SWRL ;
    gsndesign:naturalLanguage "IF R has an assurance claim point AND M1 contains R AND R is associated with A AND M2 contains A AND M1 is not equal to M2 AND R has identifier ID1 AND M2 has identifier ID2 AND A has identifier ID3 THEN ID3 is a concatenation of (ID1[ID2])."@en ;
