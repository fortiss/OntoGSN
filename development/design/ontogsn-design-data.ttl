    gsndesign:inGraph gsndesign:ontology-1.2.4 ;
    gsndesign:statementText """# Predicate Conflict Invalidation
object(?R3, ?A) ^ subject(?R1, ?A) ^ subject(?R2, ?B) ^ subject(?R3, ?C) ^ predicate(?R3, ?P) ^ predicate(?R2, ?P) ^ object(?R1, ?B) ^ object(?R2, ?C) ^ predicate(?R1, ?P) -> valid(?R1, false) ^ valid(?R2, false) ^ valid(?R3, false)""" ;
    gsndesign:statementChecksum "ce8fada8" ;
    gsndesign:structuralKey "rule|Predicate Conflict Invalidation" ;
