    gsndesign:statementText """# Contract Violation Relation
object(?R, ?M1) ^ Module(?M1) ^ Module(?M2) ^ contains(?M2, ?A) ^ supportedBy(?A, ?M1) ^ subject(?R, ?A) ^ contract(?M2, true) -> valid(?R, false)""" ;
