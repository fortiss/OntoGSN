    a gsndesign:RetiredDecision ;
    gsndesign:retirementReason "Superseded in 1.2.4. The permitted subjects are unchanged; the comment is, because it recorded the domain and range mismatch this shape was working around, and that mismatch was fixed in the ontology by dd-0965 and dd-0966."@en ;
    gsndesign:supersededBy gsndesign:dd-0967 ;
