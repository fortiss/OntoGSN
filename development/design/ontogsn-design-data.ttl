gsndesign:dd-0153
    a gsndesign:DesignDecision ;
    gsndesign:positionKey "S03.R067" ;
    gsndesign:part gsndesign:part-0 ;
    gsndesign:section gsndesign:sec-part0-glossary ;
    gsndesign:formalism gsndesign:OWL ;
    gsndesign:naturalLanguage "‘top (goal)’ is defined as: “A GSN Goal that presents the pinnacle claim in an argument. It is ‘top’ in terms of the argument hierarchy, rather than necessarily its physical layout. There may be more than one top goal in a GSN structure.”"@en ;
    gsndesign:nlWrittenFor "17bbda48" ;
