gsndesign:dd-0277
    a gsndesign:DesignDecision ;
    gsndesign:positionKey "S04.R117" ;
    gsndesign:part gsndesign:part-1 ;
    gsndesign:section gsndesign:sec-core ;
    gsndesign:formalism gsndesign:OWL ;
    gsndesign:naturalLanguage "Explanation of the rule “A context must have a statement”: “Two kinds of GSN context statement exist. Where a context statement draws attention to explanatory contextual information (such as the definition of some term), this information shall be stated briefly using complete sentences of a noun-phrase + verb-phrase structure. Where a context statement is a reference to an artefact of some kind, which informs the reasoning step, the context statement shall be expressed as a noun phrase.”"@en ;
    gsndesign:nlWrittenFor "5b08405c" ;
    prov:used gsndesign:src-0083 ;
    gsndesign:hasRationale gsndesign:why-0048 ;
    prov:generated gsndesign:st-0277 .

