gsndesign:dd-0052
    a gsndesign:DesignDecision ;
    gsndesign:positionKey "S01.R040" ;
    gsndesign:part gsndesign:part-0 ;
    gsndesign:section gsndesign:sec-ontology-specific ;
    gsndesign:formalism gsndesign:OWL ;
    gsndesign:naturalLanguage "The ontology's description is “OntoGSN is an ontology for managing assurance cases in the Goal Structuring Notation (GSN). The goal of the ontology is to help users in linking the elements of their cases - claims and evidence - with the internationalized resource identifiers (IRIs) of represented concepts, events and data, and in evaluating the validity of their argument.”."@en ;
    gsndesign:nlWrittenFor "08c71ac7" ;
    gsndesign:noSourceRecorded "true"^^xsd:boolean ;
    gsndesign:hasRationale gsndesign:why-0006 ;
    prov:generated gsndesign:st-0052 .

