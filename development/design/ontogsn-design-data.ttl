gsndesign:st-0497
    a gsndesign:StatementRecord ;
    prov:wasGeneratedBy gsndesign:dd-0497 ;
    gsndesign:inGraph gsndesign:ontology-1.2.4 ;
    gsndesign:statementText """# Cross-Module Away Context
inModule(?A, ?M) ^ inModule(?B, ?N) ^ Module(?N) ^ inContextOf(?A, ?B) ^ Module(?M) ^ notEqual(?M, ?N) -> away(?B, true)""" ;
    gsndesign:statementChecksum "b93add79" ;
    gsndesign:structuralKey "rule|Cross-Module Away Context" ;
    gsndesign:ruleName "Cross-Module Away Context" ;
    gsndesign:mentionsTerm gsn:Module ,
        gsn:away ,
        gsn:contains ,
        gsn:inContextOf ;
    prov:wasDerivedFrom gsndesign:src-0143 ;
    prov:qualifiedDerivation [ a prov:Derivation ; prov:entity gsndesign:src-0143 ; prov:hadActivity gsndesign:dd-0497 ] .

