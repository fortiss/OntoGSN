    gsndesign:naturalLanguage "{$this} is marked as a top goal, but {?value} supports it from within its own module, or it challenges part of the argument; the top goal presents the pinnacle claim of its argument."@en ;
    gsndesign:nlWrittenFor "c5faf79e" ;
