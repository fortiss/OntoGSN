    gsndesign:part gsndesign:part-1 ;
    gsndesign:section gsndesign:sec-confidence ;
    gsndesign:formalism gsndesign:SWRL ;
    gsndesign:naturalLanguage "IF A has schema identifier N AND B has schema identifier M AND A and B are distinct AND N and M are equal THEN A is NOT valid AND B is NOT valid"@en ;
