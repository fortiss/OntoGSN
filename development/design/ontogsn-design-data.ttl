    gsndesign:inGraph gsndesign:shapes-1.0.3 ;
    gsndesign:statementText """gsnsh:InDoubtPropertyShape gsn:coreOrExtension "Dialectic Extension"@en ;
    rdf:type sh:NodeShape ;
    rdfs:comment "The dialectic challenge within this structure asserts that if the claim presented in Goal CG1 is true then this is sufficient to establish that the claim in Goal G1 in the original structure is in doubt."@en ;
    rdfs:label "gsn:inDoubt"@en ;
    sh:message "Only an assurance case, a GSN element or a relationship may be marked as in doubt."@en ;
    sh:or ( [ sh:class gsn:AssuranceCase ] [ sh:class gsn:GSNElement ] [ sh:class gsn:Relationship ] ) ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf gsn:inDoubt .""" ;
    gsndesign:statementChecksum "a5202d1f" ;
    gsndesign:structuralKey "gsnsh:InDoubtPropertyShape|node|" ;
    gsndesign:aboutTerm gsnsh:InDoubtPropertyShape ;
    gsndesign:mentionsTerm gsn:AssuranceCase ,
        gsn:GSNElement ,
        gsn:Relationship ,
        gsn:coreOrExtension ,
        gsn:inDoubt ,
        gsnsh:InDoubtPropertyShape .

