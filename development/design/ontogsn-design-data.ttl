    gsndesign:inGraph gsndesign:shapes-1.0.3 ;
    gsndesign:statementText """gsnsh:UnparentedGoalIsTopShape gsn:coreOrExtension "Core GSN"@en ;
    rdf:type sh:NodeShape ;
    rdfs:comment "The converse direction of the general class axiom: a gsn:Goal that no gsn:Goal or gsn:Strategy of its own module supports, and that challenges nothing, is a top goal and should be asserted as such. A goal that challenges something is excluded because it is the root of a dialectic structure rather than the claim the author is asserting."@en ;
    rdfs:label "Goal without a parent goal in scope is a top goal"@en ;
    sh:severity sh:Warning ;
    sh:targetClass gsn:Goal .""" ;
