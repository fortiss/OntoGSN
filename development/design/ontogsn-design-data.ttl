gsndesign:dd-0246
    a gsndesign:RetiredDecision ;
    gsndesign:positionKey "S04.R091" ;
    gsndesign:part gsndesign:part-1 ;
    gsndesign:section gsndesign:sec-core ;
    gsndesign:formalism gsndesign:SWRL ;
    gsndesign:naturalLanguage "IF A and B were Solutions AND B was NOT true AND B supported C AND A was true AND A supported C THEN C was NOT true"@en ;
    gsndesign:nlWrittenFor "688680d7" ;
    prov:used gsndesign:src-0064 ;
    gsndesign:hasRationale gsndesign:why-0040 ;
    prov:generated gsndesign:st-0246 ;
    gsndesign:retirementReason "subsumed by rule S11, which draws the same conclusion from the failing solution alone and does not need a holding solution to be present as well. The two coexisted only because rule S10 asserted the opposite and undid S11 on the mixed case, which made S13 look load-bearing; once S10 was guarded in 1.2.3 so that it does not fire where support is mixed, S13 stopped changing anything on any case. Disabled with swrla:isRuleEnabled false rather than deleted, so the transcription of the passage is kept. Superseded by dd-0244."@en ;
    gsndesign:supersededBy gsndesign:dd-0244 .

