    gsndesign:statementText "gsnsh:ChallengesIrreflexiveShape sh:sparql [ rdf:type sh:SPARQLConstraint ; sh:message \"{$this} challenges itself; the challenged part of the argument and the element raising the challenge must be different.\"@en ; sh:prefixes <https://w3id.org/OntoGSN/shapes/dialectic> ; sh:select \"SELECT $this ?value WHERE { $this gsn:challenges ?value . FILTER ( sameTerm($this, ?value) ) }\" ; sh:severity sh:Warning ] ." ;
