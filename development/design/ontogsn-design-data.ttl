gsndesign:dd-0294
    a gsndesign:RetiredDecision ;
    gsndesign:retirementReason "the subject restriction was extended with gsn:Module and gsn:Pattern in 1.2.3. Rules S18 and S19 reify module-to-module support and rule S21 reifies a link whose subject is a template, so the restriction rejected relationships the rule set creates. Superseded by the extended restriction recorded in the same release."@en ;
    gsndesign:positionKey "S04.R125" ;
    gsndesign:part gsndesign:part-1 ;
    gsndesign:section gsndesign:sec-core ;
