    gsndesign:statementText "[ (Goal and not inverse supportedBy some (Goal or Strategy)) ] owl:equivalentClass [ top value \"true\" ] ." ;
    gsndesign:statementChecksum "d0777f6d" ;
    gsndesign:structuralKey "(Goal and not inverse supportedBy some (Goal or Strategy))|EquivalentTo|top value \"true\"" .

