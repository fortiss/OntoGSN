    gsndesign:statementText """# Strategy Confidence Relation
supportedBy(?G1, ?S) ^ supportedBy(?S, ?G2) ^ RelationshipWithConfidence(?R1) ^ makeOWLThing(?G2, ?R2) ^ Strategy(?S) ^ Goal(?G1) ^ Goal(?G2) ^ object(?R1, ?S) ^ associatedWith(?R1, ?A) ^ subject(?R1, ?G1) -> subject(?R2, ?S) ^ RelationshipWithConfidence(?R2) ^ object(?R2, ?G2) ^ associatedWith(?R2, ?A) ^ assuranceClaimPoint(?R2, true)""" ;
    gsndesign:statementChecksum "b67f77e4" ;
    gsndesign:structuralKey "rule|Strategy Confidence Relation" ;
    gsndesign:ruleName "Strategy Confidence Relation" ;
    gsndesign:mentionsTerm gsn:Goal ,
