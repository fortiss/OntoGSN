gsndesign:st-0967
    a gsndesign:StatementRecord ;
    prov:wasGeneratedBy gsndesign:dd-0967 ;
    gsndesign:inGraph gsndesign:shapes-1.0.3 ;
    gsndesign:statementText """gsnsh:ContainsPropertyShape gsn:coreOrExtension "Core GSN"@en ;
    rdf:type sh:NodeShape ;
    rdfs:comment "The class-level owl:allValuesFrom axioms on gsn:contains are each narrower than its declared rdfs:range, and narrower in different directions: gsn:Argument contains only a GSN element or a pattern, gsn:AssuranceCase only an argument or an artefact, gsn:Catalogue only a pattern. What a container may hold therefore depends on the container, and is validated per containing class rather than by one global range shape."@en ;
    rdfs:label "gsn:contains — domain"@en ;
    sh:message "Only an argument, an assurance case, a module, a pattern or a catalogue may contain other elements."@en ;
    sh:or ( [ sh:class gsn:Argument ] [ sh:class gsn:AssuranceCase ] [ sh:class gsn:Module ] [ sh:class gsn:Pattern ] [ sh:class gsn:Catalogue ] ) ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf gsn:contains .""" ;
    gsndesign:statementChecksum "baf25c1d" ;
    gsndesign:structuralKey "gsnsh:ContainsPropertyShape|node|" ;
    gsndesign:aboutTerm gsnsh:ContainsPropertyShape ;
    gsndesign:mentionsTerm gsn:Argument ,
        gsn:AssuranceCase ,
        gsn:Catalogue ,
        gsn:Module ,
        gsn:Pattern ,
        gsn:contains ,
        gsn:coreOrExtension ,
        gsnsh:ContainsPropertyShape .


