    a gsndesign:StatementRecord ;
    prov:wasGeneratedBy gsndesign:dd-0929 ;
    gsndesign:inGraph gsndesign:shapes-1.0.3 ;
    gsndesign:statementText """gsnsh:ChallengesIrreflexiveShape gsn:coreOrExtension "Dialectic Extension"@en ;
    rdf:type sh:NodeShape ;
    rdfs:comment "GSN convention rather than an explicit OWL axiom: the link between the part of the argument that is being challenged (target) and the dialectic element (source) must be self-evident, so an element cannot challenge itself."@en ;
    rdfs:label "gsn:challenges is irreflexive"@en ;
    sh:targetSubjectsOf gsn:challenges .""" ;
    gsndesign:statementChecksum "124733df" ;
    gsndesign:structuralKey "gsnsh:ChallengesIrreflexiveShape|node|" ;
    gsndesign:aboutTerm gsnsh:ChallengesIrreflexiveShape ;
    gsndesign:mentionsTerm gsn:challenges ,
        gsn:coreOrExtension ,
        gsnsh:ChallengesIrreflexiveShape .

