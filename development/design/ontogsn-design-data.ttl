gsndesign:dd-0663
    a gsndesign:DesignDecision ;
    gsndesign:positionKey "S07.R024" ;
    gsndesign:part gsndesign:part-1 ;
    gsndesign:section gsndesign:sec-confidence ;
    gsndesign:formalism gsndesign:SWRL ;
    gsndesign:naturalLanguage "IF A is an Artefact Reference marked as an assurance claim point AND we introduce a reified confidence Relationship R for A THEN R is a Relationship with Confidence whose subject is A and which is itself an assurance claim point"@en ;
    gsndesign:nlWrittenFor "e69be810" ;
    prov:used gsndesign:src-0245 ;
    gsndesign:hasRationale gsndesign:why-0129 ;
    prov:generated gsndesign:st-0663 .

gsndesign:st-0663
    a gsndesign:StatementRecord ;
    prov:wasGeneratedBy gsndesign:dd-0663 ;
    gsndesign:inGraph gsndesign:ontology-1.2.4 ;
    gsndesign:statementText """# Confidence Relation Creation
assuranceClaimPoint(?A, true) ^ ArtefactReference(?A) ^ makeOWLThing(?A, ?R) -> RelationshipWithConfidence(?R) ^ subject(?R, ?A) ^ assuranceClaimPoint(?R, true)""" ;
    gsndesign:statementChecksum "e69be810" ;
    gsndesign:structuralKey "rule|Confidence Relation Creation" ;
    gsndesign:ruleName "Confidence Relation Creation" ;
    gsndesign:mentionsTerm gsn:ArtefactReference ,
        gsn:RelationshipWithConfidence ,
        gsn:assuranceClaimPoint ;
    prov:wasDerivedFrom gsndesign:src-0245 ;
    prov:qualifiedDerivation [ a prov:Derivation ; prov:entity gsndesign:src-0245 ; prov:hadActivity gsndesign:dd-0663 ] .

