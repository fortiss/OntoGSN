    a gsndesign:RetiredDecision ;
    gsndesign:positionKey "S06.R051" ;
    gsndesign:part gsndesign:part-1 ;
    gsndesign:section gsndesign:sec-modular ;
    gsndesign:formalism gsndesign:SWRL ;
    gsndesign:naturalLanguage "IF A is supported by M1 AND M1 is a Module AND M2 contains A AND M2 is a Module AND M2 is a contract AND R has subject A AND R has predicate “supported by” AND R has object M1 THEN R is not valid."@en ;
