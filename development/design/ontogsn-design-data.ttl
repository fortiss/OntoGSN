gsndesign:dd-0685
    a gsndesign:DesignDecision ;
    gsndesign:positionKey "S07.R043" ;
    gsndesign:part gsndesign:part-1 ;
    gsndesign:section gsndesign:sec-confidence ;
    gsndesign:formalism gsndesign:SWRL ;
    gsndesign:naturalLanguage "IF Goal G1 is supported by Strategy S AND S is supported by Goal G2 AND there is a Relationship with Confidence R1 from G1 to S associated with A THEN we create a Relationship with Confidence R2 from S to G2 associated with the same A AND mark R2 as an assurance claim point"@en ;
    gsndesign:nlWrittenFor "b67f77e4" ;
    prov:used gsndesign:src-0253 ;
    gsndesign:hasRationale gsndesign:why-0136 ;
    prov:generated gsndesign:st-0685 .

