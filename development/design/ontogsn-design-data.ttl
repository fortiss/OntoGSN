    gsndesign:section gsndesign:sec-confidence ;
    gsndesign:formalism gsndesign:SWRL ;
    gsndesign:naturalLanguage "IF Goal G2 is supported by Strategy S AND S is supported by Goal G1 AND there is a Relationship with Confidence R1 from S to G1 associated with A THEN we create a Relationship with Confidence R2 from G2 to S associated with the same A AND mark R2 as an assurance claim point"@en ;
    gsndesign:nlWrittenFor "d1c0ea1b" ;
    prov:used gsndesign:src-0254 ;
    gsndesign:hasRationale gsndesign:why-0137 ;
    prov:generated gsndesign:st-0687 .

