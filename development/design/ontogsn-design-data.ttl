    gsndesign:statementText "gsn:contains rdfs:domain [ (Argument or AssuranceCase or Module) ] ." ;
    gsndesign:statementChecksum "8b74bad3" ;
    gsndesign:structuralKey "contains|domain|(Argument or AssuranceCase or Module)" ;
    gsndesign:aboutTerm gsn:contains ;
    gsndesign:mentionsTerm gsn:contains ;
    prov:wasDerivedFrom gsndesign:src-0140 ;
    prov:qualifiedDerivation [ a prov:Derivation ; prov:entity gsndesign:src-0140 ; prov:hadActivity gsndesign:dd-0475 ] .

gsndesign:dd-0476
    a gsndesign:RetiredDecision ;
    gsndesign:retirementReason "Superseded in 1.2.4. The range admitted only Argument, Artefact and Module, but gsn:Argument carries an owl:allValuesFrom of (GSNElement or Pattern) on the same property and is required to contain a goal and an artefact reference, and gsn:Catalogue contains only patterns. Since rdfs:range is generative, every goal, artefact reference and pattern held by its container was being inferred to be an argument, an artefact or a module."@en ;
    gsndesign:supersededBy gsndesign:dd-0966 ;
    gsndesign:positionKey "S06.R008" ;
    gsndesign:part gsndesign:part-1 ;
    gsndesign:section gsndesign:sec-modular ;
    gsndesign:formalism gsndesign:OWL ;
    gsndesign:naturalLanguage "Something can only contain an argument, an artefact or a module."@en ;
    gsndesign:nlWrittenFor "3372fb8b" ;
    prov:used gsndesign:src-0140 ;
    prov:generated gsndesign:st-0476 .

