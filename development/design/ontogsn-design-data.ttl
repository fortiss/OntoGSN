    gsndesign:section gsndesign:sec-core ;
    gsndesign:formalism gsndesign:SWRL ;
    gsndesign:naturalLanguage "IF R1 has subject A, predicate P, and object B AND R2 has subject B, predicate P, and object C AND R3 has subject C, predicate P, and object A THEN R1 is NOT valid AND R2 is NOT valid AND R3 is NOT valid"@en ;
