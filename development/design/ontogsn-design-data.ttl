gsndesign:dd-0958
    a gsndesign:RetiredDecision ;
    gsndesign:retirementReason "Superseded: the equivalence was global, so a goal supported from another module could not be a top goal - the away goal that is the pinnacle claim of its own module was excluded by its own reference. Scoping the parent test to the module is a condition on three individuals and is not an OWL class expression, so the axiom now holds in one direction only (SubClassOf, with challengers excluded) and the scoped definition lives in rule S06 and in gsnsh:TopGoalHasNoParentShape / gsnsh:UnparentedGoalIsTopShape."@en ;
    gsndesign:positionKey "S04.R144" ;
    gsndesign:part gsndesign:part-1 ;
    gsndesign:section gsndesign:sec-core ;
    gsndesign:formalism gsndesign:OWL ;
    gsndesign:naturalLanguage "Something is a (Goal and not inverse supportedBy some (Goal or Strategy)) exactly when it is whose ‘top (goal)’ is true."@en ;
    gsndesign:nlWrittenFor "d0777f6d" ;
    gsndesign:noSourceRecorded "true"^^xsd:boolean ;
    gsndesign:hasRationale gsndesign:why-0206 ;
    prov:generated gsndesign:st-0958 .

