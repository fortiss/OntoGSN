    prov:used gsndesign:src-0041 ;
    gsndesign:hasRationale gsndesign:why-0023 ;
    gsndesign:retirementReason "Struck through in the design document and absent from the current ontology: the statement was withdrawn during development. Where a reason was given, it is in the rationale column."@en .

gsndesign:dd-0150
    a gsndesign:RetiredDecision ;
    gsndesign:retirementReason "the inverse-support restriction was widened to gsn:Goal or gsn:Strategy in 1.2.3. Reading it over goals alone meant only a goal reached directly from another goal counted as parented, so every goal whose parent is a strategy, which is the ordinary shape of a decomposed argument, was inferred to be a top goal. Those two classes are exactly the rdfs:domain of gsn:supportedBy, so naming one of them was a formalization slip rather than a claim about the notation. Superseded by the widened axiom recorded in the same release."@en ;
    gsndesign:positionKey "S03.R064" ;
    gsndesign:part gsndesign:part-0 ;
    gsndesign:section gsndesign:sec-part0-glossary ;
    gsndesign:formalism gsndesign:OWL ;
    gsndesign:naturalLanguage "A goal is marked as a top goal exactly when it supports no other goal."@en ;
    gsndesign:nlWrittenFor "0268ec1d" ;
    prov:used gsndesign:src-0041 ;
    gsndesign:hasRationale gsndesign:why-0024 ;
    prov:generated gsndesign:st-0150 .

gsndesign:st-0150
    a gsndesign:StatementRecord ;
    prov:wasGeneratedBy gsndesign:dd-0150 ;
    gsndesign:inGraph gsndesign:ontology-1.2.4 ;
    gsndesign:statementText "[ (Goal and not inverse supportedBy some Goal) ] owl:equivalentClass [ top value \"true\" ] ." ;
    gsndesign:statementChecksum "0268ec1d" ;
    gsndesign:structuralKey "(Goal and not inverse supportedBy some Goal)|EquivalentTo|top value \"true\"" ;
    prov:wasDerivedFrom gsndesign:src-0041 ;
    prov:qualifiedDerivation [ a prov:Derivation ; prov:entity gsndesign:src-0041 ; prov:hadActivity gsndesign:dd-0150 ] .

gsndesign:dd-0151
    a gsndesign:RetiredDecision ;
    gsndesign:positionKey "S03.R065" ;
    gsndesign:part gsndesign:part-0 ;
    gsndesign:section gsndesign:sec-part0-glossary ;
    gsndesign:formalism gsndesign:SWRL ;
    gsndesign:naturalLanguage "IF A is equivalent to a top goal THEN A must be a Goal AND A must not be inverse supported by some Goal."@en ;
    prov:used gsndesign:src-0041 ;
    gsndesign:hasRationale gsndesign:why-0024 ;
    gsndesign:retirementReason "the inverse reading of the same general class axiom; merged into T03.R064."@en .

