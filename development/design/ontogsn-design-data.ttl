gsndesign:dd-0827
    a gsndesign:RetiredDecision ;
    gsndesign:retirementReason "Superseded by dd-0968 and dd-0969: the shape was rewritten from an sh:or over an inverse-path count into a SHACL-SPARQL constraint, because the parent test is now scoped to the module and a goal that challenges something is excluded - neither is expressible as a property shape."@en ;
    gsndesign:positionKey "S04.SH059" ;
    gsndesign:part gsndesign:part-1 ;
    gsndesign:section gsndesign:sec-core ;
    gsndesign:formalism gsndesign:SHACL ;
    gsndesign:naturalLanguage "A goal marked as a top goal must not itself be supporting another goal or strategy; the top goal presents the pinnacle claim in the argument."@en ;
    gsndesign:nlWrittenFor "ee143341" ;
    gsndesign:noSourceRecorded "true"^^xsd:boolean ;
    gsndesign:hasRationale gsndesign:why-0170 ;
    prov:generated gsndesign:st-0827 .

gsndesign:st-0827
    a gsndesign:StatementRecord ;
    prov:wasGeneratedBy gsndesign:dd-0827 ;
    gsndesign:inGraph gsndesign:shapes-1.0.3 ;
    gsndesign:statementText """gsnsh:TopGoalHasNoParentShape gsn:coreOrExtension "Core GSN"@en ;
    rdf:type sh:NodeShape ;
    rdfs:comment "From the general class axiom: ( Goal and not (inverse gsn:supportedBy some (Goal or Strategy)) ) EquivalentTo ( gsn:top value true ). A strategy counts as a parent: a goal reached through a strategy is not the pinnacle claim, and reading the axiom over goals alone made every strategy-parented goal a top goal."@en ;
    rdfs:label "Top goal has no supported parent goal"@en ;
    sh:message "A goal marked as a top goal must not itself be supporting another goal or strategy; the top goal presents the pinnacle claim in the argument."@en ;
    sh:or ( [ sh:not [ sh:property [ sh:hasValue "true"^^xsd:boolean ; sh:name "top (goal)" ; sh:path gsn:top ] ] ] [ sh:property [ sh:path [ sh:inversePath gsn:supportedBy ] ; sh:qualifiedMaxCount "0"^^xsd:integer ; sh:qualifiedValueShape [ sh:or ( [ sh:class gsn:Goal ] [ sh:class gsn:Strategy ] ) ] ] ] ) ;
    sh:severity sh:Violation ;
    sh:targetClass gsn:Goal .""" ;
    gsndesign:statementChecksum "ee143341" ;
    gsndesign:structuralKey "gsnsh:TopGoalHasNoParentShape|node|" ;
    gsndesign:aboutTerm gsnsh:TopGoalHasNoParentShape ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:coreOrExtension ,
        gsn:supportedBy ,
        gsn:top ,
        gsnsh:TopGoalHasNoParentShape .

gsndesign:dd-0828
    a gsndesign:RetiredDecision ;
    gsndesign:retirementReason "Superseded by dd-0970 and dd-0971: the shape was rewritten from an sh:or over an inverse-path count into a SHACL-SPARQL constraint, because the parent test is now scoped to the module and a goal that challenges something is excluded - neither is expressible as a property shape."@en ;
    gsndesign:positionKey "S04.SH060" ;
    gsndesign:part gsndesign:part-1 ;
    gsndesign:section gsndesign:sec-core ;
    gsndesign:formalism gsndesign:SHACL ;
    gsndesign:naturalLanguage "A goal that is not supporting any other goal or strategy is a top goal and should be marked as one."@en ;
    gsndesign:nlWrittenFor "174e68e9" ;
    gsndesign:noSourceRecorded "true"^^xsd:boolean ;
    gsndesign:hasRationale gsndesign:why-0171 ;
    prov:generated gsndesign:st-0828 .

gsndesign:st-0828
    a gsndesign:StatementRecord ;
    prov:wasGeneratedBy gsndesign:dd-0828 ;
    gsndesign:inGraph gsndesign:shapes-1.0.3 ;
    gsndesign:statementText """gsnsh:UnparentedGoalIsTopShape gsn:coreOrExtension "Core GSN"@en ;
    rdf:type sh:NodeShape ;
    rdfs:comment "The converse direction of the general class axiom: a gsn:Goal that does not support any other gsn:Goal or gsn:Strategy is a top goal and should be asserted as such."@en ;
    rdfs:label "Goal without a parent goal is a top goal"@en ;
    sh:message "A goal that is not supporting any other goal or strategy is a top goal and should be marked as one."@en ;
    sh:or ( [ sh:property [ sh:hasValue "true"^^xsd:boolean ; sh:name "top (goal)" ; sh:path gsn:top ] ] [ sh:property [ sh:path [ sh:inversePath gsn:supportedBy ] ; sh:qualifiedMinCount "1"^^xsd:integer ; sh:qualifiedValueShape [ sh:or ( [ sh:class gsn:Goal ] [ sh:class gsn:Strategy ] ) ] ] ] ) ;
    sh:severity sh:Warning ;
    sh:targetClass gsn:Goal .""" ;
    gsndesign:statementChecksum "174e68e9" ;
    gsndesign:structuralKey "gsnsh:UnparentedGoalIsTopShape|node|" ;
    gsndesign:aboutTerm gsnsh:UnparentedGoalIsTopShape ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:coreOrExtension ,
        gsn:supportedBy ,
        gsn:top ,
        gsnsh:UnparentedGoalIsTopShape .

