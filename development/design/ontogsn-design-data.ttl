    gsndesign:section gsndesign:sec-modular ;
    gsndesign:formalism gsndesign:SWRL ;
    gsndesign:naturalLanguage "IF Relationship R has object Module M1 AND M1 and M2 are Modules AND M2 contains A AND A is supported by M1 AND R has subject A AND M2 is under contract THEN R is NOT valid"@en ;
