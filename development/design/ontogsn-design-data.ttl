    gsndesign:statementText """gsnsh:DefeatedElementIsNotTrueShape gsn:coreOrExtension "Dialectic Extension"@en ;
    rdf:type sh:NodeShape ;
    rdfs:comment "A defeated element has been successfully challenged, so it cannot simultaneously be asserted as true."@en ;
