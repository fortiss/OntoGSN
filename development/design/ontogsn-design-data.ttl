gsndesign:dd-0296
    a gsndesign:RetiredDecision ;
    gsndesign:retirementReason "the object restriction was extended with gsn:Relationship in 1.2.3. gsn:challenges is defined as allowing a challenge to any GSN entity and its range had already been widened in the shapes to admit a relationship; the reified form had not been widened to match, so rule S51 produced a relationship the restriction rejected. Superseded by the extended restriction recorded in the same release."@en ;
    gsndesign:positionKey "S04.R127" ;
    gsndesign:part gsndesign:part-1 ;
    gsndesign:section gsndesign:sec-core ;
    gsndesign:formalism gsndesign:OWL ;
    gsndesign:naturalLanguage "A relationship can only have as its object a GSN element."@en ;
    gsndesign:nlWrittenFor "41291615" ;
    gsndesign:noSourceRecorded "true"^^xsd:boolean ;
    gsndesign:hasRationale gsndesign:why-0050 ;
    prov:generated gsndesign:st-0296 .

