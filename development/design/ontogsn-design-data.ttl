gsndesign:dd-0475
    a gsndesign:RetiredDecision ;
    gsndesign:retirementReason "domain extended with gsn:Pattern in 1.2.3. A pattern is an argument structure and holds the elements it is built from, and rule S22 matches containment by a template. gsn:Catalogue remains outside the declared domain and continues to be admitted by the shape alone, under its own decision. Superseded by the extended domain recorded in the same release."@en ;
    gsndesign:positionKey "S06.R007" ;
    gsndesign:part gsndesign:part-1 ;
    gsndesign:section gsndesign:sec-modular ;
    gsndesign:formalism gsndesign:OWL ;
    gsndesign:naturalLanguage "Only an argument, an assurance case or a module can contain something."@en ;
    gsndesign:nlWrittenFor "8b74bad3" ;
    prov:used gsndesign:src-0140 ;
    prov:generated gsndesign:st-0475 .

gsndesign:st-0475
