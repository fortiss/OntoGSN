    gsndesign:queryText """PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT DISTINCT ?affectedId ?type ?statement ?challengeId ?targetId
WHERE {
  ?challenge gsn:challenges ?target ;
