    gsndesign:path "ontology/queries/rules/s08_contradictory_goal_truth.rq" ;
    gsndesign:fileChecksum "89d694f5fa5301950821f0cc26371121cebaa0dd0becdfd97cfd4155c74d4b87" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:supportedBy ,
        gsn:true ,
        gsn:valid ;
    gsndesign:ruleName "Contradictory Goal Truth" ;
    gsndesign:translatesStatement gsndesign:st-0239 ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0161 ,
        gsndesign:st-0207 ,
        gsndesign:st-0234 ;
    gsndesign:queryText """# rule:      S8
# name:      Contradictory Goal Truth

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?B gsn:valid ?old }
INSERT { ?B gsn:valid false }
WHERE {
  ?A a gsn:Goal ;
     gsn:true ?tA .
  FILTER(STR(?tA) = "false")
  ?B gsn:supportedBy ?A ;
     gsn:true ?tB .
  FILTER(STR(?tB) = "true")
  OPTIONAL { ?B gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsndesign:query-rules-s10-solution-propagation-true
    a gsndesign:Query ;
    rdfs:label "rules/s10_solution_propagation_true.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s10_solution_propagation_true.rq" ;
    gsndesign:fileChecksum "46c92eeb40543640c93672238ddc498486fb3fbe1ad9f55b52a54d99aefbdce5" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Assumption ,
        gsn:Solution ,
        gsn:inContextOf ,
        gsn:supportedBy ,
        gsn:true ;
    gsndesign:ruleName "Solution Propagation (True)" ;
    gsndesign:translatesStatement gsndesign:st-0243 ;
    gsndesign:restsOnStatement gsndesign:st-0175 ,
        gsndesign:st-0188 ,
        gsndesign:st-0207 ,
        gsndesign:st-0218 ,
        gsndesign:st-0234 ;
    gsndesign:queryText """# rule:      S10
# name:      Solution Propagation (True)

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?B gsn:true ?old }
INSERT { ?B gsn:true true }
WHERE {
  ?A a gsn:Solution ;
     gsn:true ?tA .
  FILTER(STR(?tA) = "true")
  ?B gsn:supportedBy ?A .

  FILTER NOT EXISTS {
    ?B gsn:supportedBy ?other .
    ?other a gsn:Solution .
    FILTER NOT EXISTS { ?other gsn:true ?tOther . FILTER(STR(?tOther) = "true") }
  }
  FILTER NOT EXISTS {
    ?B gsn:inContextOf ?asm .
    ?asm a gsn:Assumption ; gsn:true ?tAsm .
    FILTER(STR(?tAsm) = "false")
  }

  OPTIONAL { ?B gsn:true ?old }
  FILTER(!BOUND(?old) || STR(?old) != "true")
}
""" .

gsndesign:query-rules-s11-solution-propagation-false
    a gsndesign:Query ;
