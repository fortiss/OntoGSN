gsndesign:query-rules-s25-duplicate-identifier-invalidation
    a gsndesign:Query ;
    rdfs:label "rules/s25_duplicate_identifier_invalidation.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s25_duplicate_identifier_invalidation.rq" ;
    gsndesign:fileChecksum "cb74c6936e62b536586ade53f790ed1c8b01864768c32c46cb2ea20d59446ce2" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:inModule ,
        gsn:valid ;
    gsndesign:ruleName "Duplicate Identifier Invalidation" ;
    gsndesign:translatesStatement gsndesign:st-1079 ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0944 ;
    gsndesign:queryText """# rule:      S25
# name:      Duplicate Identifier Invalidation

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

DELETE { ?target gsn:valid ?old }
INSERT { ?target gsn:valid false }
WHERE {
  ?A gsn:inModule ?M .
  ?B gsn:inModule ?M .
  ?A schema:identifier ?id .
  ?B schema:identifier ?id .
  FILTER(?A != ?B)
  VALUES ?slot { 1 2 }
  BIND(IF(?slot = 1, ?A, ?B) AS ?target)
  OPTIONAL { ?target gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

