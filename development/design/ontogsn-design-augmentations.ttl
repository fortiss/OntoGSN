#################################################################
#    Stored queries (135)
#    gsndesign:declaresNamespace records what each file binds its prefixes to, which is
#    how a query pointing at the wrong namespace becomes findable.
#    
#    gsndesign:queryText holds the query verbatim, so the record says what was asked at
#    a given version without the file having to still exist. gsndesign:fileChecksum is
#    what detects that it changed.
#    
#    Two links reach back into the ontology, and they are not the same strength.
#    gsndesign:translatesStatement is an exact correspondence: the files under
#    ontology/queries/rules/ ARE the SWRL rules, re-expressed for a store with no reasoner, and
#    the join is the rule's name. gsndesign:restsOnStatement is weaker and derived: the
#    axiom declaring each gsn: term the query names. Either way the target is a
#    StatementRecord, so one hop further reaches why that axiom exists at all.
#################################################################

gsndesign:query-augmentation-queries-fc01-requirement-source
    a gsndesign:Query ;
    rdfs:label "augmentation/queries/fc01_requirement_source.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/fc01_requirement_source.rq" ;
    gsndesign:fileChecksum "613bfc2cafc07c8bf3289eb756857500e1f9fedfb239344f5d5c8ecd5c71293c" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ;
    gsndesign:answersQuestion gsndesign:cq-CQ-44 ;
    gsndesign:queryText """# id:        CQ-44
# role:      Auditor
# operation: read
# question:  What law or requirement source does the case answer to?
# expect:    rows
#
# Any element may answer to a requirement, not only the top goal: a control claim usually names
# the clause it implements. A case that names none reads through CQ-07 instead, which returns
# every context in scope without saying which of them is the requirement.

PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?elementId ?source
WHERE {
  ?element gsnaug:requiredBy ?source .
  OPTIONAL { ?element schema:identifier ?elementId }
}
ORDER BY ?elementId ?source
""" .

gsndesign:query-augmentation-queries-fc02-assured-system
    a gsndesign:Query ;
    rdfs:label "augmentation/queries/fc02_assured_system.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/fc02_assured_system.rq" ;
    gsndesign:fileChecksum "e806043db229bd89d64ed0f07b7fedb2b597e9dab039888d358b06536e882530" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ;
    gsndesign:answersQuestion gsndesign:cq-CQ-45 ;
    gsndesign:queryText """# id:        CQ-45
# role:      Auditor
# operation: read
# question:  What system and organisation is this case about?
# expect:    rows
#
# The subject is an argument, an assurance case or a goal - the three granularities at which a
# reader would say the case is about something.

PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?subjectId ?system
WHERE {
  ?subject gsnaug:assures ?system .
  OPTIONAL { ?subject schema:identifier ?subjectId }
}
ORDER BY ?subjectId ?system
""" .

gsndesign:query-augmentation-queries-fc03-undeveloped-claims-for-system
    a gsndesign:Query ;
    rdfs:label "augmentation/queries/fc03_undeveloped_claims_for_system.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/fc03_undeveloped_claims_for_system.rq" ;
    gsndesign:fileChecksum "9a2f5d1a47a97f94b204cd8d40c1425ee3ddbbcaff2d09aa00c7d201407db500" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:inContextOf ,
        gsn:statement ,
        gsn:supportedBy ,
        gsn:undeveloped ;
    gsndesign:restsOnStatement gsndesign:st-0161 ,
        gsndesign:st-0200 ,
        gsndesign:st-0207 ,
        gsndesign:st-0218 ,
        gsndesign:st-0265 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-46 ;
    gsndesign:queryText """# id:        CQ-46
# role:      Compliance Officer
# operation: read
# question:  Which low-level claims need development for each system?
# expect:    rows
#
# The inverse-path walk does the context inheritance in the query, so the answer does not depend
# on S17 having been run first.

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX schema:  <http://schema.org/>

SELECT DISTINCT ?goalId ?statement ?contextStatement
WHERE {
  VALUES ?system { "IT system" }                    # PARAMETER

  ?goal a gsn:Goal ;
        schema:identifier ?goalId ;
        gsn:undeveloped true .
  OPTIONAL { ?goal gsn:statement ?statement }

  ?goal (^gsn:supportedBy)* ?ancestor .
  ?ancestor gsn:inContextOf ?context .
  ?context gsn:statement ?contextStatement .
  FILTER ( CONTAINS(LCASE(?contextStatement), LCASE(?system)) )
}
ORDER BY ?goalId
""" .

gsndesign:query-augmentation-queries-fc07-evidence-location
    a gsndesign:Query ;
    rdfs:label "augmentation/queries/fc07_evidence_location.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/fc07_evidence_location.rq" ;
    gsndesign:fileChecksum "a90a0950a38884929a40ac42adac81d8e222c56b1a8efd53b5f3071bfe17135f" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Solution ,
        gsn:refersTo ;
    gsndesign:restsOnStatement gsndesign:st-0175 ,
        gsndesign:st-0289 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-49 ;
    gsndesign:queryText """# id:        CQ-49
# role:      Developer
# operation: read
# question:  Where is the requested evidence kept and how is it fetched?
# expect:    rows

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?solutionId ?artefact ?storage ?retrieval ?automated
WHERE {
  ?solution a gsn:Solution ;
            schema:identifier ?solutionId ;
            gsn:refersTo ?artefact .
  OPTIONAL { ?artefact gsnaug:storedIn ?storage }
  OPTIONAL {
    ?artefact gsnaug:retrievableWith ?retrieval .
    OPTIONAL { ?retrieval gsnaug:automated ?automated }
  }
}
ORDER BY ?solutionId
""" .

gsndesign:query-augmentation-queries-fc08-evidence-production
    a gsndesign:Query ;
    rdfs:label "augmentation/queries/fc08_evidence_production.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/fc08_evidence_production.rq" ;
    gsndesign:fileChecksum "1952ca8d5d24f60c84cd1a5eaf48f2f7301a3d4406fe62085fbe1e633a6855a2" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Solution ,
        gsn:refersTo ;
    gsndesign:restsOnStatement gsndesign:st-0175 ,
        gsndesign:st-0289 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-50 ;
    gsndesign:queryText """# id:        CQ-50
# role:      Developer
# operation: read
# question:  Does the evidence exist yet, and how was it produced - by whom, with what, from what?
# expect:    rows
#
# A solution with no artefact is evidence that does not exist yet, so the artefact is optional.

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?solutionId ?artefact ?author ?mechanism ?source
WHERE {
  ?solution a gsn:Solution ;
            schema:identifier ?solutionId .
  OPTIONAL {
    ?solution gsn:refersTo ?artefact .
    OPTIONAL { ?artefact gsnaug:generatedBy   ?author }
    OPTIONAL { ?artefact gsnaug:generatedWith ?mechanism }
    OPTIONAL { ?artefact gsnaug:generatedFrom ?source }
  }
}
ORDER BY ?solutionId
""" .

gsndesign:query-augmentation-queries-fc10-evidence-verification
    a gsndesign:Query ;
    rdfs:label "augmentation/queries/fc10_evidence_verification.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/fc10_evidence_verification.rq" ;
    gsndesign:fileChecksum "2663b9e483185bb95cd849b62ffebdff48eb96f66e63b1a8de7bd9c6152698e4" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Solution ,
        gsn:refersTo ,
        gsn:valid ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0175 ,
        gsndesign:st-0289 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-52 ;
    gsndesign:queryText """# id:        CQ-52
# role:      Process/Software Owner
# operation: read
# question:  Was this evidence checked, by whom, with what mechanism, and did it pass?
# expect:    rows

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?solutionId ?artefact ?mechanism ?reviewer ?valid
WHERE {
  ?solution a gsn:Solution ;
            schema:identifier ?solutionId ;
            gsn:refersTo ?artefact .
  OPTIONAL { ?artefact gsnaug:checkedWith  ?mechanism }
  OPTIONAL { ?artefact gsnaug:reviewedBy   ?reviewer }
  OPTIONAL { ?solution gsn:valid ?valid }
}
ORDER BY ?solutionId
""" .

gsndesign:query-augmentation-queries-fc11-controls-ready-for-review
    a gsndesign:Query ;
    rdfs:label "augmentation/queries/fc11_controls_ready_for_review.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/fc11_controls_ready_for_review.rq" ;
    gsndesign:fileChecksum "cb4037bd18bc1fcf2a84fbd1ade2f042ced516596c143ac31b6bbbb3dfa4d806" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:Solution ,
        gsn:refersTo ,
        gsn:supportedBy ,
        gsn:undeveloped ;
    gsndesign:restsOnStatement gsndesign:st-0161 ,
        gsndesign:st-0175 ,
        gsndesign:st-0200 ,
        gsndesign:st-0207 ,
        gsndesign:st-0289 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-53 ;
    gsndesign:queryText """# id:        CQ-53
# role:      Auditor
# operation: read
# question:  Which controls are ready for review?
# expect:    rows
#
# Ready means developed and backed by an artefact. Whether it passed is CQ-54; what is still
# missing is CQ-26 and CQ-16.

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX schema:  <http://schema.org/>

SELECT ?goalId ?solutionId ?artefact
WHERE {
  ?goal a gsn:Goal ;
        schema:identifier ?goalId ;
        gsn:supportedBy ?solution .
  ?solution a gsn:Solution ;
            schema:identifier ?solutionId ;
            gsn:refersTo ?artefact .
  FILTER NOT EXISTS { ?goal     gsn:undeveloped true }
  FILTER NOT EXISTS { ?solution gsn:undeveloped true }
}
ORDER BY ?goalId ?solutionId
""" .

gsndesign:query-augmentation-queries-fc13-case-compliance
    a gsndesign:Query ;
    rdfs:label "augmentation/queries/fc13_case_compliance.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/fc13_case_compliance.rq" ;
    gsndesign:fileChecksum "bbeba3fce2ae17b274c483e4a9bb41a2550771501dcd84480f26e1fd5f7daab5" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:defeated ,
        gsn:inDoubt ;
    gsndesign:restsOnStatement gsndesign:st-0699 ,
        gsndesign:st-0731 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-55 ;
    gsndesign:queryText """# id:        CQ-55
# role:      Auditor
# operation: read
# question:  Is the case fully compliant?
# expect:    rows
#
# Compliant is all three counts at zero. The status is derived on every run rather than stored,
# so it cannot go stale; the price is that it cannot be reproduced for a past report entry.

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>

SELECT ?openIssues ?defeated ?inDoubt
WHERE {
  {
    SELECT (COUNT(DISTINCT ?issue) AS ?openIssues)
    WHERE {
      ?issue a gsnaug:Issue .
      FILTER NOT EXISTS { ?issue gsnaug:issueOutcome ?outcome }
    }
  }
  { SELECT (COUNT(DISTINCT ?e) AS ?defeated) WHERE { ?e gsn:defeated true } }
  { SELECT (COUNT(DISTINCT ?d) AS ?inDoubt)  WHERE { ?d gsn:inDoubt  true } }
}
""" .

gsndesign:query-augmentation-queries-fc14-open-clarifications
    a gsndesign:Query ;
    rdfs:label "augmentation/queries/fc14_open_clarifications.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/fc14_open_clarifications.rq" ;
    gsndesign:fileChecksum "6b246685a88236b7a9e99634f2d5a20c9e83db85050dc33b395ffee4c7f5112a" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:answersQuestion gsndesign:cq-CQ-56 ;
    gsndesign:queryText """# id:        CQ-56
# role:      Auditor
# operation: read
# question:  Which elements have an open clarification against them?
# expect:    rows
#
# Open means neither ended by an outcome nor closed by an answer.

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?issueId ?targetId ?holder ?description
WHERE {
  ?issue a gsnaug:Issue ;
         schema:identifier ?issueId ;
         gsnaug:issueType gsnaug:clarify ;
         gsnaug:raisedAgainst ?target .
  ?target schema:identifier ?targetId .
  OPTIONAL { ?issue gsnaug:heldBy ?holder }
  OPTIONAL { ?issue schema:description ?description }
  FILTER NOT EXISTS { ?issue gsnaug:issueOutcome ?outcome }
}
ORDER BY ?issueId
""" .

gsndesign:query-augmentation-queries-fc15-who-answers-for-element
    a gsndesign:Query ;
    rdfs:label "augmentation/queries/fc15_who_answers_for_element.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/fc15_who_answers_for_element.rq" ;
    gsndesign:fileChecksum "bbe67cbd29a910db9178e31e73313daae411d3e3b28abbba342ff401d2e40bf7" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:refersTo ;
    gsndesign:restsOnStatement gsndesign:st-0289 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-57 ;
    gsndesign:queryText """# id:        CQ-57
# role:      Process/Software Owner
# operation: read
# question:  Who can answer for this element - its owner, or the author of its evidence?
# expect:    rows

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?elementId ?owner ?author
WHERE {
  ?element schema:identifier ?elementId .
  OPTIONAL { ?element gsnaug:ownedBy ?owner }
  OPTIONAL {
    ?element gsn:refersTo ?artefact .
    ?artefact gsnaug:generatedBy ?author
  }
  FILTER ( BOUND(?owner) || BOUND(?author) )
}
ORDER BY ?elementId
""" .

gsndesign:query-augmentation-queries-fc16-clarification-answers
    a gsndesign:Query ;
    rdfs:label "augmentation/queries/fc16_clarification_answers.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/fc16_clarification_answers.rq" ;
    gsndesign:fileChecksum "2cc302761e9e533493eed9256f5e00287a33831b63877b0aa9d65ab18dd0a2ba" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ;
    gsndesign:answersQuestion gsndesign:cq-CQ-58 ;
    gsndesign:queryText """# id:        CQ-58
# role:      Auditor
# operation: read
# question:  What was said in reply to a clarification, and was the reply accepted?
# expect:    rows
#
# A response does not close an ask. The outcome does: "resolved" means the raiser accepted a
# response; no outcome means the ask is still open, replies or not.

PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?response ?issueId ?description ?outcome
WHERE {
  ?response a gsnaug:Response ;
            gsnaug:respondsTo ?issue .
  ?issue schema:identifier ?issueId ;
         gsnaug:issueType gsnaug:clarify .
  OPTIONAL { ?response schema:description ?description }
  OPTIONAL { ?issue gsnaug:issueOutcome ?outcome }
}
ORDER BY ?issueId
""" .

gsndesign:query-augmentation-queries-fc17-rounds-per-element
    a gsndesign:Query ;
    rdfs:label "augmentation/queries/fc17_rounds_per_element.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/fc17_rounds_per_element.rq" ;
    gsndesign:fileChecksum "bea2d09322bf380b7587c778f04ccbfc5306efd95763a1a9b4ba74ca029eb939" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ;
    gsndesign:answersQuestion gsndesign:cq-CQ-59 ;
    gsndesign:queryText """# id:        CQ-59
# role:      Auditor
# operation: read
# question:  How many rounds has this element taken, and of which kind?
# expect:    rows
#
# One issue per round is what makes this a COUNT. A flag on the target would report one.

PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?targetId ?type (COUNT(DISTINCT ?issue) AS ?rounds)
WHERE {
  ?issue a gsnaug:Issue ;
         gsnaug:raisedAgainst ?target ;
         gsnaug:issueType ?type .
  ?target schema:identifier ?targetId .
}
GROUP BY ?targetId ?type
ORDER BY DESC(?rounds) ?targetId
""" .

gsndesign:query-augmentation-queries-fc18-superseded-asks
    a gsndesign:Query ;
    rdfs:label "augmentation/queries/fc18_superseded_asks.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/fc18_superseded_asks.rq" ;
    gsndesign:fileChecksum "8b0b361fe8d6d8ce38d08aaaeea6eb0342f682e25b6cb3279a5d89e462a80720" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ;
    gsndesign:answersQuestion gsndesign:cq-CQ-60 ;
    gsndesign:queryText """# id:        CQ-60
# role:      Auditor
# operation: read
# question:  Which pending ask was displaced by a newer one?
# expect:    rows

PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?newerId ?olderId ?outcome ?holder
WHERE {
  ?newer gsnaug:supersedes ?older ;
         schema:identifier ?newerId .
  ?older schema:identifier ?olderId .
  OPTIONAL { ?older gsnaug:issueOutcome ?outcome }
  OPTIONAL { ?newer gsnaug:heldBy ?holder }
}
ORDER BY ?olderId
""" .

gsndesign:query-augmentation-queries-fc19-who-holds-the-ask
    a gsndesign:Query ;
    rdfs:label "augmentation/queries/fc19_who_holds_the_ask.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/fc19_who_holds_the_ask.rq" ;
    gsndesign:fileChecksum "b9d51ac12884c568d1531548ca004d6ad4aa7ceffac44f2e5bd2f355cabc48af" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ;
    gsndesign:answersQuestion gsndesign:cq-CQ-61 ;
    gsndesign:queryText """# id:        CQ-61
# role:      Auditor
# operation: read
# question:  Who currently holds a relayed ask - where is it stuck?
# expect:    rows

PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?issueId ?holder ?raiser ?targetId
WHERE {
  ?issue a gsnaug:Issue ;
         schema:identifier ?issueId ;
         gsnaug:heldBy ?holder ;
         gsnaug:raisedAgainst ?target .
  ?target schema:identifier ?targetId .
  OPTIONAL { ?issue gsnaug:raisedBy ?raiser }
  FILTER NOT EXISTS { ?issue gsnaug:issueOutcome ?outcome }
}
ORDER BY ?issueId
""" .

gsndesign:query-augmentation-queries-fc20-escalation-count
    a gsndesign:Query ;
    rdfs:label "augmentation/queries/fc20_escalation_count.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/fc20_escalation_count.rq" ;
    gsndesign:fileChecksum "d72eeb0143a282e055615fcd2d9b0bf99d3708a0d4d9be992434334bfeb3f028" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ;
    gsndesign:answersQuestion gsndesign:cq-CQ-62 ;
    gsndesign:queryText """# id:        CQ-62
# role:      Auditor
# operation: read
# question:  How many times was an ask escalated because the holder could not answer?
# expect:    rows
#
# An escalation is a hop whose predecessor was closed as cannot-answer, counted from the first
# ask in the chain - the one that supersedes nothing.

PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?originalId (COUNT(DISTINCT ?later) AS ?escalations)
WHERE {
  ?original a gsnaug:Issue ;
            schema:identifier ?originalId .
  FILTER NOT EXISTS { ?original gsnaug:supersedes ?earlier }

  ?later gsnaug:supersedes+ ?original ;
         gsnaug:supersedes ?predecessor .
  ?predecessor gsnaug:issueOutcome "cannot answer" .
}
GROUP BY ?originalId
ORDER BY DESC(?escalations)
""" .

gsndesign:query-augmentation-queries-fc22-what-to-revise
    a gsndesign:Query ;
    rdfs:label "augmentation/queries/fc22_what_to_revise.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/fc22_what_to_revise.rq" ;
    gsndesign:fileChecksum "1458aaebd0722a11c764f04545d3603c68d367150708a157645069046d02683f" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:Solution ;
    gsndesign:restsOnStatement gsndesign:st-0161 ,
        gsndesign:st-0175 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-64 ;
    gsndesign:queryText """# id:        CQ-64
# role:      Compliance Officer
# operation: read
# question:  What has to be revised, and by whom?
# expect:    rows
#
# The class of the target says whether the claim or the evidence is at fault. A revise issue
# against a context is a remark about wording and is deliberately not returned here.

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?issueId ?targetId ?targetKind ?owner ?description
WHERE {
  ?issue a gsnaug:Issue ;
         schema:identifier ?issueId ;
         gsnaug:issueType gsnaug:revise ;
         gsnaug:raisedAgainst ?target .
  ?target schema:identifier ?targetId ;
          a ?targetKind .
  VALUES ?targetKind { gsn:Goal gsn:Solution }
  OPTIONAL { ?target gsnaug:ownedBy ?owner }
  OPTIONAL { ?issue schema:description ?description }
}
ORDER BY ?issueId
""" .

gsndesign:query-augmentation-queries-fc23-revision-rounds
    a gsndesign:Query ;
    rdfs:label "augmentation/queries/fc23_revision_rounds.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/fc23_revision_rounds.rq" ;
    gsndesign:fileChecksum "caa4a7ed7db0a7355d38c56e01ba0796bd200bc42da6d3125ef3e4b709fa0ec3" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ;
    gsndesign:answersQuestion gsndesign:cq-CQ-65 ;
    gsndesign:queryText """# id:        CQ-65
# role:      Compliance Officer
# operation: read
# question:  How many revision rounds, and what was offered in reply to each ask?
# expect:    rows

PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?targetId (COUNT(DISTINCT ?issue) AS ?rounds)
       (GROUP_CONCAT(DISTINCT STR(?response); separator=", ") AS ?responses)
WHERE {
  ?issue a gsnaug:Issue ;
         gsnaug:issueType gsnaug:revise ;
         gsnaug:raisedAgainst ?target .
  ?target schema:identifier ?targetId .
  OPTIONAL {
    ?response a gsnaug:Response ;
              gsnaug:respondsTo ?issue
  }
}
GROUP BY ?targetId
ORDER BY DESC(?rounds)
""" .

gsndesign:query-augmentation-queries-fc24-revision-diff
    a gsndesign:Query ;
    rdfs:label "augmentation/queries/fc24_revision_diff.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/fc24_revision_diff.rq" ;
    gsndesign:fileChecksum "61308164405318a62e17caa21d2461b9d136d844c6efc9297c082da9c7aeafb0" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:inContextOf ,
        gsn:refersTo ;
    gsndesign:restsOnStatement gsndesign:st-0218 ,
        gsndesign:st-0289 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-66 ;
    gsndesign:queryText """# id:        CQ-66
# role:      Developer
# operation: read
# question:  What did a revision actually change - which artefact replaced which?
# expect:    rows
#
# Artefact versions only. A reworded claim is not a revision in this sense.
#
# The issue is the revise issue raised against an element that still refers to the older
# artefact, or the revise issue in context of one that does. A case that points the revised
# solution at the newer artefact can keep the older one in the context of the issue.

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT DISTINCT ?newer ?older ?mechanism ?issueId
WHERE {
  ?newer gsnaug:replaces ?older .
  OPTIONAL { ?newer gsnaug:generatedWith ?mechanism }
  OPTIONAL {
    {
      ?solution gsn:refersTo ?older .
      ?issue gsnaug:raisedAgainst ?solution .
    }
    UNION
    {
      ?context gsn:refersTo ?older .
      ?issue gsn:inContextOf ?context .
    }
    ?issue gsnaug:issueType gsnaug:revise ;
           schema:identifier ?issueId
  }
}
ORDER BY ?newer
""" .

gsndesign:query-augmentation-queries-fc26-unresolved-at-audit
    a gsndesign:Query ;
    rdfs:label "augmentation/queries/fc26_unresolved_at_audit.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/fc26_unresolved_at_audit.rq" ;
    gsndesign:fileChecksum "d5f4c684e64389ce38f911b0c0770d9a11664e1d2ac6878cd6be75591e780c2c" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/ns/prov#" ,
        "https://w3id.org/OntoGSN/augmentation#" ;
    gsndesign:answersQuestion gsndesign:cq-CQ-68 ;
    gsndesign:queryText """# id:        CQ-68
# role:      Auditor
# operation: read
# question:  What was left unresolved at the last audit, and what is due by the next one?
# expect:    rows
#
# Scoped by cycle rather than by date, because two audits may overlap in time and the question
# asked is always which round.

PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>
PREFIX prov:    <http://www.w3.org/ns/prov#>

SELECT ?cycleId ?issueId ?targetId ?outcome ?opened
WHERE {
  ?issue a gsnaug:Issue ;
         schema:identifier ?issueId ;
         gsnaug:issueType gsnaug:resolve ;
         gsnaug:raisedIn ?cycle ;
         gsnaug:raisedAgainst ?target .
  ?cycle schema:identifier ?cycleId .
  ?target schema:identifier ?targetId .
  OPTIONAL { ?issue gsnaug:issueOutcome ?outcome }
  OPTIONAL { ?cycle prov:startedAtTime ?opened }
}
ORDER BY ?cycleId ?issueId
""" .

gsndesign:query-augmentation-queries-fc27-resolution-state
    a gsndesign:Query ;
    rdfs:label "augmentation/queries/fc27_resolution_state.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/fc27_resolution_state.rq" ;
    gsndesign:fileChecksum "d6ccf525db705ed201b5c5b7b2e1dccc8883f35b6c185776b889c994d4eed52a" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ;
    gsndesign:answersQuestion gsndesign:cq-CQ-69 ;
    gsndesign:queryText """# id:        CQ-69
# role:      Auditor
# operation: read
# question:  Was a resolution implemented, declined, or infeasible?
# expect:    rows
#
# The state is the outcome. A response that the auditor has not accepted leaves the ask open,
# and the last column says whether one is on record.

PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?issueId ?targetId ?state ?responded
WHERE {
  ?issue a gsnaug:Issue ;
         schema:identifier ?issueId ;
         gsnaug:issueType gsnaug:resolve ;
         gsnaug:raisedAgainst ?target .
  ?target schema:identifier ?targetId .
  OPTIONAL { ?issue gsnaug:issueOutcome ?outcome }
  BIND( IF(BOUND(?outcome), STR(?outcome), "open") AS ?state )
  BIND( EXISTS { ?response gsnaug:respondsTo ?issue } AS ?responded )
}
ORDER BY ?issueId
""" .

gsndesign:query-augmentation-queries-fc28-manual-evidence
    a gsndesign:Query ;
    rdfs:label "augmentation/queries/fc28_manual_evidence.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/fc28_manual_evidence.rq" ;
    gsndesign:fileChecksum "bf666727ba643822fa84bfcd6d93ee7fc834e7ab3821abc55373235a3cad3a1c" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Solution ,
        gsn:refersTo ;
    gsndesign:restsOnStatement gsndesign:st-0175 ,
        gsndesign:st-0289 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-70 ;
    gsndesign:queryText """# id:        CQ-70
# role:      Developer
# operation: read
# question:  Which evidence needs to be generated manually?
# expect:    rows

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?solutionId ?artefact ?mechanism ?automated
WHERE {
  ?solution a gsn:Solution ;
            schema:identifier ?solutionId ;
            gsn:refersTo ?artefact .
  OPTIONAL {
    ?artefact gsnaug:generatedWith ?mechanism .
    OPTIONAL { ?mechanism gsnaug:automated ?automated }
  }
  FILTER ( !BOUND(?mechanism) || !BOUND(?automated) || ?automated = false )
}
ORDER BY ?solutionId
""" .

gsndesign:query-augmentation-queries-fc29-automated-evidence
    a gsndesign:Query ;
    rdfs:label "augmentation/queries/fc29_automated_evidence.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/fc29_automated_evidence.rq" ;
    gsndesign:fileChecksum "20b2cf4d152ad135206acb9bb8bede9a8f2d4bb5b0df992dc0f7afd912d29215" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:answersQuestion gsndesign:cq-CQ-71 ;
    gsndesign:queryText """# id:        CQ-71
# role:      Developer
# operation: read
# question:  Which evidence is generated automatically, and how or where from can it be retrieved?
# expect:    rows

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>

SELECT ?artefact ?mechanism ?source ?storage ?retrieval
WHERE {
  ?artefact gsnaug:generatedWith ?mechanism .
  ?mechanism gsnaug:automated true .
  OPTIONAL { ?artefact gsnaug:generatedFrom  ?source }
  OPTIONAL { ?artefact gsnaug:storedIn       ?storage }
  OPTIONAL { ?artefact gsnaug:retrievableWith ?retrieval }
}
ORDER BY ?artefact
""" .

gsndesign:query-augmentation-queries-fc30-alternative-provision
    a gsndesign:Query ;
    rdfs:label "augmentation/queries/fc30_alternative_provision.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/fc30_alternative_provision.rq" ;
    gsndesign:fileChecksum "d2767b8a22796ebc2cec10d2d99539d0b1eb3c9d9eb410e8ddde964bb805f552" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Solution ,
        gsn:refersTo ;
    gsndesign:restsOnStatement gsndesign:st-0175 ,
        gsndesign:st-0289 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-72 ;
    gsndesign:queryText """# id:        CQ-72
# role:      Process/Software Owner
# operation: read
# question:  Which evidence needs an alternative provision mechanism - an interview, a call, paper?
# expect:    rows
#
# Which mechanism it is - interview, paper, call - is a subclass of gsnaug:Mechanism in the
# domain ontology; this returns the ones a person has to run.

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?solutionId ?artefact ?retrieval ?automated
WHERE {
  ?solution a gsn:Solution ;
            schema:identifier ?solutionId ;
            gsn:refersTo ?artefact .
  OPTIONAL {
    ?artefact gsnaug:retrievableWith ?retrieval .
    OPTIONAL { ?retrieval gsnaug:automated ?automated }
  }
  FILTER ( !BOUND(?retrieval) || !BOUND(?automated) || ?automated = false )
}
ORDER BY ?solutionId
""" .

gsndesign:query-augmentation-queries-fc31-evidence-cannot-be-produced
    a gsndesign:Query ;
    rdfs:label "augmentation/queries/fc31_evidence_cannot_be_produced.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/fc31_evidence_cannot_be_produced.rq" ;
    gsndesign:fileChecksum "1084831fcbc4626d6a3c09a39fad0318c2af9d614b873dc7f3dec1842c28e126" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ;
    gsndesign:mentionsTerm gsn:undeveloped ,
        gsn:uninstantiated ;
    gsndesign:restsOnStatement gsndesign:st-0200 ,
        gsndesign:st-0358 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-73 ;
    gsndesign:queryText """# id:        CQ-73
# role:      Developer
# operation: read
# question:  Which evidence cannot be produced at all, as opposed to not yet produced?
# expect:    rows
#
# Not yet produced is gsn:undeveloped and gsn:uninstantiated, which CQ-26 and CQ-27 report.
# Cannot be produced is an ask closed as infeasible, which is a different answer.

PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?targetId ?issueId ?cycleId
WHERE {
  ?issue a gsnaug:Issue ;
         schema:identifier ?issueId ;
         gsnaug:issueOutcome "infeasible" ;
         gsnaug:raisedAgainst ?target .
  ?target schema:identifier ?targetId .
  OPTIONAL {
    ?issue gsnaug:raisedIn ?cycle .
    ?cycle schema:identifier ?cycleId
  }
}
ORDER BY ?targetId
""" .

gsndesign:query-augmentation-queries-fc32-cannot-resolve
    a gsndesign:Query ;
    rdfs:label "augmentation/queries/fc32_cannot_resolve.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/fc32_cannot_resolve.rq" ;
    gsndesign:fileChecksum "0186cce648bd6db8837cef0a543dcfa9501c150b9c2b4dc535c387a3c8ac4138" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ;
    gsndesign:answersQuestion gsndesign:cq-CQ-74 ;
    gsndesign:queryText """# id:        CQ-74
# role:      Auditor
# operation: read
# question:  Which issue cannot be resolved at all, as opposed to not yet resolved?
# expect:    rows

PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?issueId ?targetId ?outcome ?holder
WHERE {
  ?issue a gsnaug:Issue ;
         schema:identifier ?issueId ;
         gsnaug:issueType gsnaug:resolve ;
         gsnaug:issueOutcome ?outcome ;
         gsnaug:raisedAgainst ?target .
  ?target schema:identifier ?targetId .
  OPTIONAL { ?issue gsnaug:heldBy ?holder }
  FILTER ( ?outcome IN ( "declined", "infeasible" ) )
}
ORDER BY ?issueId
""" .

gsndesign:query-augmentation-queries-fc33-instantiated-elements
    a gsndesign:Query ;
    rdfs:label "augmentation/queries/fc33_instantiated_elements.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/fc33_instantiated_elements.rq" ;
    gsndesign:fileChecksum "3c5c78b0ba8477f430b8cdf65c5fe7a049fdba7f2f058f5719922ffc3145491a" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:InstantiationDataReference ,
        gsn:Solution ,
        gsn:attachedTo ,
        gsn:refersTo ;
    gsndesign:restsOnStatement gsndesign:st-0161 ,
        gsndesign:st-0175 ,
        gsndesign:st-0289 ,
        gsndesign:st-0456 ,
        gsndesign:st-0462 ,
        gsndesign:st-0463 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-75 ;
    gsndesign:queryText """# id:        CQ-75
# role:      Compliance Officer
# operation: read
# question:  How is the interpretation instantiated into claims and evidence?
# expect:    rows
#
# The reference says which data governs the subtree; gsnaug:instantiatedFrom says which row of it
# produced this element.

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?elementId ?kind ?data ?row
WHERE {
  ?reference a gsn:InstantiationDataReference ;
             gsn:attachedTo ?element .
  ?element schema:identifier ?elementId ;
           a ?kind .
  VALUES ?kind { gsn:Goal gsn:Solution }
  OPTIONAL { ?reference gsn:refersTo ?data }
  OPTIONAL { ?element gsnaug:instantiatedFrom ?row }
}
ORDER BY ?elementId
""" .

gsndesign:query-augmentation-queries-fc34-who-retrieves-evidence
    a gsndesign:Query ;
    rdfs:label "augmentation/queries/fc34_who_retrieves_evidence.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/fc34_who_retrieves_evidence.rq" ;
    gsndesign:fileChecksum "52c599061645f893691388c4c022e89da10283c72d05e5b6701b80b5e0a10aaf" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Solution ,
        gsn:refersTo ,
        gsn:supportedBy ;
    gsndesign:restsOnStatement gsndesign:st-0175 ,
        gsndesign:st-0207 ,
        gsndesign:st-0289 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-76 ;
    gsndesign:queryText """# id:        CQ-76
# role:      Compliance Officer
# operation: read
# question:  Who is responsible for retrieving the evidence for a particular system?
# expect:    rows
#
# gsnaug:assures is asserted, not derived. It names a gsnaug:System directly, so the answer does
# not depend on how - or whether - the case draws its top-level context.

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?system ?solutionId ?owner ?author
WHERE {
  ?goal gsnaug:assures ?system .
  ?goal gsn:supportedBy* ?descendant .
  ?descendant a gsn:Solution ;
              schema:identifier ?solutionId .
  OPTIONAL { ?descendant gsnaug:ownedBy ?owner }
  OPTIONAL {
    ?descendant gsn:refersTo ?artefact .
    ?artefact gsnaug:generatedBy ?author
  }
}
ORDER BY ?system ?solutionId
""" .

gsndesign:query-augmentation-queries-fc35-artefacts-to-change
    a gsndesign:Query ;
    rdfs:label "augmentation/queries/fc35_artefacts_to_change.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/fc35_artefacts_to_change.rq" ;
    gsndesign:fileChecksum "e89a580b48ba45bc8675d710e860b3d8ef2da76a93a8f7a02fb3dc3c7707b788" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Solution ,
        gsn:defeated ,
        gsn:refersTo ,
        gsn:supportedBy ;
    gsndesign:restsOnStatement gsndesign:st-0175 ,
        gsndesign:st-0207 ,
        gsndesign:st-0289 ,
        gsndesign:st-0699 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-77 ;
    gsndesign:queryText """# id:        CQ-77
# role:      Developer
# operation: read
# question:  Which artefacts need changing, and who owns the change?
# expect:    rows
#
# The last column is the impact of the change, which CQ-15 answers in full for a given artefact.

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?solutionId ?artefact ?owner ?author ?alsoRestingOnIt
WHERE {
  ?solution a gsn:Solution ;
            schema:identifier ?solutionId ;
            gsn:defeated true ;
            gsn:refersTo ?artefact .
  OPTIONAL { ?solution gsnaug:ownedBy ?owner }
  OPTIONAL { ?artefact gsnaug:generatedBy ?author }
  OPTIONAL {
    ?otherSolution gsn:refersTo ?artefact .
    ?claim gsn:supportedBy ?otherSolution ;
           schema:identifier ?alsoRestingOnIt
  }
}
ORDER BY ?solutionId
""" .

gsndesign:query-augmentation-queries-fc36-automation-feasibility
    a gsndesign:Query ;
    rdfs:label "augmentation/queries/fc36_automation_feasibility.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/fc36_automation_feasibility.rq" ;
    gsndesign:fileChecksum "9817ed9644f22dd997e0e2d4a529d9f806bc92e8f182273b3a2b98195eb83585" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Solution ,
        gsn:refersTo ;
    gsndesign:restsOnStatement gsndesign:st-0175 ,
        gsndesign:st-0289 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-78 ;
    gsndesign:queryText """# id:        CQ-78
# role:      Developer
# operation: read
# question:  Which evidence can be generated automatically, and which has been assessed as manual?
# expect:    rows
#
# No mechanism at all means nobody has looked; a mechanism flagged false means automation was
# assessed and rejected. The two are different answers.

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?solutionId ?artefact ?mechanism ?assessment
WHERE {
  ?solution a gsn:Solution ;
            schema:identifier ?solutionId ;
            gsn:refersTo ?artefact .
  OPTIONAL {
    ?artefact gsnaug:generatedWith ?mechanism .
    OPTIONAL { ?mechanism gsnaug:automated ?automated }
  }
  BIND( IF(!BOUND(?mechanism),  "not assessed",
        IF(!BOUND(?automated),  "mechanism named, not flagged",
        IF(?automated,          "automated",
                                "assessed: manual"))) AS ?assessment )
}
ORDER BY ?solutionId
""" .

gsndesign:query-augmentation-queries-fc37-term-impact
    a gsndesign:Query ;
    rdfs:label "augmentation/queries/fc37_term_impact.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/fc37_term_impact.rq" ;
    gsndesign:fileChecksum "521cad626d2634742635582ca22fbb0c50d584ca881dd4cd8f6a27df5d466cca" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Solution ,
        gsn:refersTo ,
        gsn:supportedBy ;
    gsndesign:restsOnStatement gsndesign:st-0175 ,
        gsndesign:st-0207 ,
        gsndesign:st-0289 ;
    gsndesign:queryText """# id:        CQ-79
# role:      Developer
# operation: read
# question:  If this domain term changes, which mechanisms, artefacts and claims are affected?
# expect:    rows
#
# Answerable without running anything, for every mechanism that declares what it reads. A
# mechanism that declares nothing is absent from the answer, so the answer is only as complete
# as the declarations are. For a mechanism that is a shape, a rule or a query in the graph the
# declaration can be derived from the node itself; for a script it has to be written by hand.

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT DISTINCT ?term ?mechanism ?use ?artefact ?solutionId ?goalId
WHERE {
  VALUES ?term { <https://example.org/case#retainedUntil> }    # PARAMETER

  ?mechanism gsnaug:readsTerm ?term .
  ?artefact  ?use ?mechanism .
  FILTER ( ?use IN ( gsnaug:retrievableWith, gsnaug:retrievedWith,
                     gsnaug:generableWith,   gsnaug:generatedWith,
                     gsnaug:checkableWith,   gsnaug:checkedWith ) )
  OPTIONAL {
    ?solution a gsn:Solution ;
              schema:identifier ?solutionId ;
              gsn:refersTo ?artefact .
    OPTIONAL { ?goal gsn:supportedBy+ ?solution ; schema:identifier ?goalId }
  }
}
ORDER BY ?mechanism ?use ?artefact ?solutionId ?goalId
""" .

gsndesign:query-augmentation-queries-fc38-inspectable-mechanisms
    a gsndesign:Query ;
    rdfs:label "augmentation/queries/fc38_inspectable_mechanisms.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/fc38_inspectable_mechanisms.rq" ;
    gsndesign:fileChecksum "47d24384bbdaed7273bada6e482a94fa0224d64bd5fed1a78608d50e59d9a486" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://spinrdf.org/sp#" ,
        "http://www.w3.org/2003/11/swrl#" ,
        "http://www.w3.org/ns/shacl#" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Solution ,
        gsn:refersTo ;
    gsndesign:restsOnStatement gsndesign:st-0175 ,
        gsndesign:st-0289 ;
    gsndesign:queryText """# id:        CQ-80
# role:      Compliance Officer
# operation: read
# question:  Which evidence rests on a mechanism that can be read without being run, and what does
#            each mechanism declare?
# expect:    rows
#
# Four states per mechanism. In the graph: a shape, a rule or a query implements the mechanism,
# so what it depends on can be read off that node. Script in the graph: a person can read what it does,
# but no tool derives the terms, so any listed are declared by hand. Declared by hand: terms are
# listed but nothing in the graph says what the mechanism does, so the list has to be trusted.
# Opaque: none of the above, so only a run tells.
#
# "In the graph" is read off the type of the node that implements the mechanism. The list below is what this query knows: SHACL shapes,
# SHACL-AF SPARQL executables, SWRL rules and SPIN queries. A new formalism is a line here.

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>
PREFIX sh:      <http://www.w3.org/ns/shacl#>
PREFIX sp:      <http://spinrdf.org/sp#>
PREFIX swrl:    <http://www.w3.org/2003/11/swrl#>

SELECT ?solutionId ?artefact ?mechanism ?state
       (GROUP_CONCAT(DISTINCT STR(?term); separator=", ") AS ?reads)
WHERE {
  ?solution a gsn:Solution ;
            schema:identifier ?solutionId ;
            gsn:refersTo ?artefact .
  ?artefact ?use ?mechanism .
  FILTER ( ?use IN ( gsnaug:retrievableWith, gsnaug:retrievedWith,
                     gsnaug:generableWith,   gsnaug:generatedWith,
                     gsnaug:checkableWith,   gsnaug:checkedWith ) )
  OPTIONAL {
    ?definition gsnaug:implements ?mechanism ;
                a ?formalism .
    FILTER ( ?formalism IN ( sh:NodeShape, sh:PropertyShape,
                             sh:SPARQLSelectExecutable, sh:SPARQLAskExecutable,
                             sh:SPARQLConstructExecutable, sh:SPARQLUpdateExecutable,
                             swrl:Imp, sp:Query ) )
  }
  OPTIONAL { ?mechanism gsnaug:script    ?script }
  OPTIONAL { ?mechanism gsnaug:readsTerm ?term }
  BIND( IF(BOUND(?formalism), "in the graph",
        IF(BOUND(?script),    "script in the graph",
        IF(BOUND(?term),      "terms declared by hand",
                              "opaque"))) AS ?state )
}
GROUP BY ?solutionId ?artefact ?mechanism ?state
ORDER BY ?solutionId ?mechanism
""" .

gsndesign:query-augmentation-queries-fc39-requirement-revised
    a gsndesign:Query ;
    rdfs:label "augmentation/queries/fc39_requirement_revised.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/fc39_requirement_revised.rq" ;
    gsndesign:fileChecksum "dc74c1eb978af124b4e8b92f3ace23da59af6f4777629c84ed21fe78108e996e" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/ns/prov#" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:queryText """# id:        CQ-81
# role:      Compliance Officer
# operation: read
# question:  Which elements answer to a requirement that has a newer revision?
# expect:    rows
#
# A changed requirement is a new gsnaug:Requirement that is prov:wasRevisionOf the old one. An
# element still linked to the old one by gsnaug:requiredBy, and not yet to the new one, is in the
# answer. Whether the change matters to the element is a judgement: whoever makes it raises a
# revise issue on the element, and rule A2 takes it from there.

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX prov:    <http://www.w3.org/ns/prov#>
PREFIX schema:  <http://schema.org/>

SELECT ?elementId ?requirement ?newerRequirement ?owner
WHERE {
  ?newerRequirement prov:wasRevisionOf+ ?requirement .
  ?element gsnaug:requiredBy ?requirement ;
           schema:identifier ?elementId .
  FILTER NOT EXISTS { ?element gsnaug:requiredBy ?newerRequirement }
  OPTIONAL { ?element gsnaug:ownedBy ?owner }
}
ORDER BY ?elementId ?requirement
""" .

gsndesign:query-augmentation-queries-fc40-system-revised
    a gsndesign:Query ;
    rdfs:label "augmentation/queries/fc40_system_revised.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/fc40_system_revised.rq" ;
    gsndesign:fileChecksum "50733d04c0475b6d20a45d3f265669ec01f38b8d1ae06e6c6c54fea0a4a97d85" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/ns/prov#" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Solution ,
        gsn:refersTo ,
        gsn:supportedBy ;
    gsndesign:restsOnStatement gsndesign:st-0175 ,
        gsndesign:st-0207 ,
        gsndesign:st-0289 ;
    gsndesign:queryText """# id:        CQ-82
# role:      Developer
# operation: read
# question:  Which evidence was drawn from a system, or a part of one, that has a newer revision?
# expect:    rows
#
# A changed system, or a changed part of one, is a new individual that is prov:wasRevisionOf the
# old one; how fine the parts are is the domain ontology's choice. An artefact drawn from the old
# one by gsnaug:generatedFrom is in the answer until a replacement drawn from the new one exists.
# The last two columns are the solution that cites the artefact and the goals above it, which
# is the reach of the change. Whether the change matters to them is a judgement: whoever makes
# it raises a revise issue on the solution, and rule A2 takes it from there.

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX prov:    <http://www.w3.org/ns/prov#>
PREFIX schema:  <http://schema.org/>

SELECT DISTINCT ?artefact ?source ?newerSource ?solutionId ?goalId
WHERE {
  ?newerSource prov:wasRevisionOf+ ?source .
  ?artefact gsnaug:generatedFrom ?source .
  FILTER NOT EXISTS {
    ?replacement gsnaug:replaces+ ?artefact ;
                 gsnaug:generatedFrom ?newerSource .
  }
  OPTIONAL {
    ?solution a gsn:Solution ;
              schema:identifier ?solutionId ;
              gsn:refersTo ?artefact .
    OPTIONAL { ?goal gsn:supportedBy+ ?solution ; schema:identifier ?goalId }
  }
}
ORDER BY ?artefact ?solutionId ?goalId
""" .

gsndesign:query-augmentation-queries-fc41-context-revised
    a gsndesign:Query ;
    rdfs:label "augmentation/queries/fc41_context_revised.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/fc41_context_revised.rq" ;
    gsndesign:fileChecksum "f520d326eb105880af3f10d1c58330f1c8471879e23b6ffebf3ccf799c9eeabb" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/ns/prov#" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Context ,
        gsn:Goal ,
        gsn:inContextOf ,
        gsn:refersTo ,
        gsn:supportedBy ;
    gsndesign:restsOnStatement gsndesign:st-0161 ,
        gsndesign:st-0181 ,
        gsndesign:st-0207 ,
        gsndesign:st-0218 ,
        gsndesign:st-0289 ;
    gsndesign:queryText """# id:        CQ-83
# role:      Process Owner
# operation: read
# question:  Which goals sit under a context whose artefact has a newer revision?
# expect:    rows
#
# The environment of a claim is what GSN puts in a context. A context that gsn:refersTo an
# artefact - a deployment list, an operating design domain, a configuration - is the hook: the
# artefact is revised with gsnaug:replaces or prov:wasRevisionOf, and the context still refers
# to the old one. A context applies to the element it is attached to and to everything that
# element supports, so the query walks gsn:supportedBy down from the holder of the context; the
# core rules do not materialise that for contexts, only for assumptions. Whether the change
# matters to a goal is a judgement: whoever makes it raises a revise issue on the goal, and rule
# A2 takes it from there.

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX prov:    <http://www.w3.org/ns/prov#>
PREFIX schema:  <http://schema.org/>

SELECT DISTINCT ?goalId ?contextId ?artefact ?newerArtefact
WHERE {
  ?context a gsn:Context ;
           schema:identifier ?contextId ;
           gsn:refersTo ?artefact .
  ?newerArtefact (gsnaug:replaces|prov:wasRevisionOf)+ ?artefact .
  FILTER NOT EXISTS { ?context gsn:refersTo ?newerArtefact }
  ?holder gsn:inContextOf ?context ;
          gsn:supportedBy* ?goal .
  ?goal a gsn:Goal ;
        schema:identifier ?goalId .
}
ORDER BY ?goalId ?contextId
""" .

gsndesign:query-create-assurance-case-skeleton
    a gsndesign:Query ;
    rdfs:label "create_assurance_case_skeleton.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/create_assurance_case_skeleton.rq" ;
    gsndesign:fileChecksum "99fe96c7562077dc87a8e58131a464b386ca5eaa4a264ec372fe4e7c9ce56b53" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://example.org/my-assurance-case#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Argument ,
        gsn:AssuranceCase ,
        gsn:Goal ,
        gsn:argumentType ,
        gsn:contains ,
        gsn:final ,
        gsn:published ,
        gsn:statement ,
        gsn:structured ,
        gsn:top ,
        gsn:undeveloped ;
    gsndesign:restsOnStatement gsndesign:st-0077 ,
        gsndesign:st-0085 ,
        gsndesign:st-0096 ,
        gsndesign:st-0144 ,
        gsndesign:st-0161 ,
        gsndesign:st-0200 ,
        gsndesign:st-0265 ,
        gsndesign:st-0330 ,
        gsndesign:st-0444 ,
        gsndesign:st-0474 ,
        gsndesign:st-0640 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-28 ;
    gsndesign:queryText """# id:        CQ-28
# operation: create
# question:  How is a new, empty assurance case started?
# expect:    insert
#
# The only query in the set that names a case namespace of its own, because there is no
# existing element to derive one from. Change the case: prefix below before running it.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>
PREFIX case:   <https://example.org/my-assurance-case#>

INSERT DATA {
  case:AC1 a gsn:AssuranceCase ;
           schema:identifier "AC1" ;
           rdfs:label "New assurance case" ;
           gsn:statement "The system is acceptably safe for its intended use." ;
           gsn:contains case:Arg1 .

  case:Arg1 a gsn:Argument ;
            schema:identifier "Arg1" ;
            rdfs:label "Top-level argument" ;
            gsn:statement "Argument over the identified hazards." ;
            gsn:argumentType "risk" ;
            gsn:structured true ;
            gsn:final false ;
            gsn:published false ;
            gsn:contains case:G1 .

  case:G1 a gsn:Goal ;
          schema:identifier "G1" ;
          rdfs:label "Goal G1" ;
          gsn:statement "The system is acceptably safe for its intended use." ;
          gsn:top true ;
          gsn:undeveloped true .
}
""" .

gsndesign:query-create-challenge-to-element
    a gsndesign:Query ;
    rdfs:label "create_challenge_to_element.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/create_challenge_to_element.rq" ;
    gsndesign:fileChecksum "9ecdaa6b9abd7310973e4c4e31e6f1930e94c572371b073a4431ec61b37dfe24" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Defeater ,
        gsn:Goal ,
        gsn:challenges ,
        gsn:statement ,
        gsn:undeveloped ;
    gsndesign:restsOnStatement gsndesign:st-0161 ,
        gsndesign:st-0200 ,
        gsndesign:st-0265 ,
        gsndesign:st-0696 ,
        gsndesign:st-0740 ,
        gsndesign:st-0760 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-29 ;
    gsndesign:queryText """# id:        CQ-29
# operation: create
# question:  How is a challenge recorded against part of the argument?
# expect:    insert
#
# A challenge shaped as a goal asserts a counter-claim and puts its target in doubt; one
# shaped as a solution cites evidence and defeats it. Change ?challengeType to pick.
# gsn:Defeater is inferred from gsn:challenges, never asserted - see the class's note.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

INSERT {
  ?challenge a ?challengeType ;
             schema:identifier ?challengeId ;
             rdfs:label ?challengeId ;
             gsn:statement ?challengeStatement ;
             gsn:undeveloped true ;
             gsn:challenges ?target .
}
WHERE {
  VALUES (?targetId ?challengeId ?challengeType ?challengeStatement) {   # PARAMETERS
    ("G1.1" "CG3" gsn:Goal
     "The field trial did not cover the night-time subset of the operational design domain.")
  }
  ?target schema:identifier ?targetId .
  FILTER NOT EXISTS { ?existing schema:identifier ?challengeId }
  BIND(IRI(CONCAT(REPLACE(STR(?target), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?challengeId))) AS ?challenge)
}
""" .

gsndesign:query-create-context-for-goal
    a gsndesign:Query ;
    rdfs:label "create_context_for_goal.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/create_context_for_goal.rq" ;
    gsndesign:fileChecksum "25305ea9b02f68914c2b8c42b6b3e8346df9123a572d3f5dfcf6ff71babdcb2a" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Artefact ,
        gsn:Context ,
        gsn:inContextOf ,
        gsn:refersTo ,
        gsn:statement ;
    gsndesign:restsOnStatement gsndesign:st-0111 ,
        gsndesign:st-0181 ,
        gsndesign:st-0218 ,
        gsndesign:st-0265 ,
        gsndesign:st-0289 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-30 ;
    gsndesign:queryText """# id:        CQ-30
# operation: create
# question:  How is a context element added to a goal or strategy, pointing at an artefact?
# expect:    insert

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

INSERT {
  ?element gsn:inContextOf ?context .
  ?context a gsn:Context ;
           schema:identifier ?contextId ;
           rdfs:label ?contextId ;
           gsn:statement ?contextStatement ;
           gsn:refersTo ?artefact .
}
WHERE {
  VALUES (?elementId ?contextId ?contextStatement ?artefactId) {   # PARAMETERS
    ("G1.2" "C4" "The braking demand arbitration is specified in ARB-SPEC-02." "Ev3")
  }
  ?element schema:identifier ?elementId .
  ?artefact a gsn:Artefact ;
            schema:identifier ?artefactId .
  FILTER NOT EXISTS { ?existing schema:identifier ?contextId }
  BIND(IRI(CONCAT(REPLACE(STR(?element), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?contextId))) AS ?context)
}
""" .

gsndesign:query-create-goal-under-parent
    a gsndesign:Query ;
    rdfs:label "create_goal_under_parent.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/create_goal_under_parent.rq" ;
    gsndesign:fileChecksum "3a7e7e1d22a180c5af67bb4c25cd9d0edc866fda20b2c1df3482efdea68ff3a7" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:statement ,
        gsn:supportedBy ,
        gsn:top ,
        gsn:undeveloped ;
    gsndesign:restsOnStatement gsndesign:st-0144 ,
        gsndesign:st-0161 ,
        gsndesign:st-0200 ,
        gsndesign:st-0207 ,
        gsndesign:st-0265 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-31 ;
    gsndesign:queryText """# id:        CQ-31
# operation: create
# question:  How is a sub-goal added beneath an existing goal or strategy?
# expect:    insert
#
# The new element's IRI is minted in the parent's own namespace, so the query never has
# to know which case it is being run against. Every create query below does the same.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

INSERT {
  ?parent gsn:supportedBy ?new .
  ?new a gsn:Goal ;
       schema:identifier ?newId ;
       rdfs:label ?newId ;
       gsn:statement ?newStatement ;
       gsn:top false ;
       gsn:undeveloped true .
}
WHERE {
  VALUES (?parentId ?newId ?newStatement) {           # PARAMETERS
    ("St1" "G1.4" "Sensor occlusion is detected before it affects the detection rate.")
  }
  ?parent schema:identifier ?parentId .
  FILTER NOT EXISTS { ?existing schema:identifier ?newId }
  BIND(IRI(CONCAT(REPLACE(STR(?parent), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?newId))) AS ?new)
}
""" .

gsndesign:query-create-solution-with-artefact
    a gsndesign:Query ;
    rdfs:label "create_solution_with_artefact.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/create_solution_with_artefact.rq" ;
    gsndesign:fileChecksum "66c5f770e616e3857d1c28332a5377b63d2570f441bf5c15d8eea3cadb3cc50f" ;
    gsndesign:declaresNamespace "http://purl.org/dc/terms/" ,
        "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "http://www.w3.org/2001/XMLSchema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Artefact ,
        gsn:Solution ,
        gsn:refersTo ,
        gsn:statement ,
        gsn:supportedBy ;
    gsndesign:restsOnStatement gsndesign:st-0111 ,
        gsndesign:st-0175 ,
        gsndesign:st-0207 ,
        gsndesign:st-0265 ,
        gsndesign:st-0289 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-32 ;
    gsndesign:queryText """# id:        CQ-32
# operation: create
# question:  How is a new piece of evidence attached to a goal?
# expect:    insert
#
# Evidence enters as two nodes, not one: the artefact is the thing that exists, the
# solution is the argument's reference to it. Conflating them is the commonest ABox error.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>
PREFIX terms:  <http://purl.org/dc/terms/>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>

INSERT {
  ?goal gsn:supportedBy ?solution .
  ?solution a gsn:Solution ;
            schema:identifier ?solutionId ;
            rdfs:label ?solutionId ;
            gsn:statement ?solutionStatement ;
            gsn:refersTo ?artefact .
  ?artefact a gsn:Artefact ;
            schema:identifier ?artefactId ;
            rdfs:label ?artefactLabel ;
            schema:description ?solutionStatement ;
            terms:created ?created .
}
WHERE {
  VALUES (?goalId ?solutionId ?solutionStatement ?artefactId ?artefactLabel ?created) {
    ("G1.2" "Sn6" "Degraded-mode arbitration test report."
     "Ev7" "ARBITRATION-TEST-2026-07" "2026-07-14"^^xsd:date)     # PARAMETERS
  }
  ?goal schema:identifier ?goalId .
  FILTER NOT EXISTS { ?existing schema:identifier ?solutionId }
  BIND(IRI(CONCAT(REPLACE(STR(?goal), "[^#/]*$", ""), ENCODE_FOR_URI(?solutionId))) AS ?solution)
  BIND(IRI(CONCAT(REPLACE(STR(?goal), "[^#/]*$", ""), ENCODE_FOR_URI(?artefactId))) AS ?artefact)
}
""" .

gsndesign:query-create-solutions-for-unreferenced-artefacts
    a gsndesign:Query ;
    rdfs:label "create_solutions_for_unreferenced_artefacts.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/create_solutions_for_unreferenced_artefacts.rq" ;
    gsndesign:fileChecksum "92851d627daf4938cb6f24150e2c8ad6a3c34db63231003009712c89ec589776" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Artefact ,
        gsn:Solution ,
        gsn:refersTo ,
        gsn:statement ;
    gsndesign:restsOnStatement gsndesign:st-0111 ,
        gsndesign:st-0175 ,
        gsndesign:st-0265 ,
        gsndesign:st-0289 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-33 ;
    gsndesign:queryText """# id:        CQ-33
# operation: create
# question:  How are artefacts already in the store turned into solutions in bulk?
# expect:    insert
#
# The import case: evidence arrives from a test pipeline as artefacts, and each one needs
# a solution before the argument can cite it. The identifier is derived from the artefact's,
# so re-running the query adds nothing the second time.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

INSERT {
  ?solution a gsn:Solution ;
            schema:identifier ?solutionId ;
            rdfs:label ?label ;
            gsn:statement ?statement ;
            gsn:refersTo ?artefact .
}
WHERE {
  ?artefact a gsn:Artefact ;
            schema:identifier ?artefactId .
  FILTER NOT EXISTS { ?anySolution gsn:refersTo ?artefact }

  OPTIONAL { ?artefact rdfs:label ?artefactLabel }
  BIND(CONCAT("Sn-", ?artefactId) AS ?solutionId)
  BIND(CONCAT("Solution ", ?solutionId) AS ?label)
  BIND(CONCAT("Reference to ", COALESCE(STR(?artefactLabel), ?artefactId), ".") AS ?statement)
  BIND(IRI(CONCAT(REPLACE(STR(?artefact), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?solutionId))) AS ?solution)
  FILTER NOT EXISTS { ?existing schema:identifier ?solutionId }
}
""" .

gsndesign:query-create-strategy-between-goals
    a gsndesign:Query ;
    rdfs:label "create_strategy_between_goals.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/create_strategy_between_goals.rq" ;
    gsndesign:fileChecksum "7c789447d74acb77fffb07656e2da2e92bfa4d3c650d0e871f85835d2b782776" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Strategy ,
        gsn:statement ,
        gsn:supportedBy ,
        gsn:undeveloped ;
    gsndesign:restsOnStatement gsndesign:st-0167 ,
        gsndesign:st-0200 ,
        gsndesign:st-0207 ,
        gsndesign:st-0265 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-34 ;
    gsndesign:queryText """# id:        CQ-34
# operation: create
# question:  How is a strategy inserted between a goal and the sub-goals it already has?
# expect:    change
#
# Inserting a strategy is a re-parenting, not an addition: the parent's existing support
# links move onto the strategy, or the argument ends up with two routes to the same place.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

DELETE {
  ?parent gsn:supportedBy ?child .
}
INSERT {
  ?parent gsn:supportedBy ?strategy .
  ?strategy a gsn:Strategy ;
            schema:identifier ?strategyId ;
            rdfs:label ?strategyId ;
            gsn:statement ?strategyStatement ;
            gsn:undeveloped false ;
            gsn:supportedBy ?child .
}
WHERE {
  VALUES (?parentId ?strategyId ?strategyStatement) {   # PARAMETERS
    ("G1.1" "St2" "Argument over each detection failure mode in turn.")
  }
  ?parent schema:identifier ?parentId ;
          gsn:supportedBy ?child .
  FILTER NOT EXISTS { ?existing schema:identifier ?strategyId }
  BIND(IRI(CONCAT(REPLACE(STR(?parent), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?strategyId))) AS ?strategy)
}
""" .

gsndesign:query-delete-assurance-case
    a gsndesign:Query ;
    rdfs:label "delete_assurance_case.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/delete_assurance_case.rq" ;
    gsndesign:fileChecksum "444ee763c1ae3f5d3b019eea266e843f539df40af41cd360317d1e80652e3454" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Artefact ,
        gsn:AssuranceCase ,
        gsn:challenges ,
        gsn:contains ,
        gsn:inContextOf ,
        gsn:supportedBy ;
    gsndesign:restsOnStatement gsndesign:st-0077 ,
        gsndesign:st-0111 ,
        gsndesign:st-0207 ,
        gsndesign:st-0218 ,
        gsndesign:st-0474 ,
        gsndesign:st-0696 ,
        gsndesign:st-0740 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-38 ;
    gsndesign:queryText """# id:        CQ-38
# operation: delete
# question:  How is a whole assurance case and everything under it removed?
# expect:    delete
#
# Follows reachability, not gsn:contains alone, which misses elements reached only through
# supportedBy. Artefacts are spared - another case may cite them; use
# delete_unreferenced_artefacts.rq for those.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

DELETE {
  ?node ?outgoing ?object .
  ?subject ?incoming ?node .
}
WHERE {
  VALUES ?caseId { "AC1" }                            # PARAMETER
  ?case a gsn:AssuranceCase ;
        schema:identifier ?caseId .
  ?case (gsn:contains|gsn:supportedBy|gsn:inContextOf|gsn:challenges)* ?node .
  FILTER NOT EXISTS { ?node a gsn:Artefact }
  {
    ?node ?outgoing ?object .
  } UNION {
    ?subject ?incoming ?node .
  }
}
""" .

gsndesign:query-delete-challenge-and-its-effects
    a gsndesign:Query ;
    rdfs:label "delete_challenge_and_its_effects.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/delete_challenge_and_its_effects.rq" ;
    gsndesign:fileChecksum "3248e8f70f1a0fc69c5e0ee3f9ce1db854a6cc0b324562a13497504b9b1c614d" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:challenges ,
        gsn:defeated ,
        gsn:inDoubt ;
    gsndesign:restsOnStatement gsndesign:st-0696 ,
        gsndesign:st-0699 ,
        gsndesign:st-0731 ,
        gsndesign:st-0740 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-39 ;
    gsndesign:queryText """# id:        CQ-39
# operation: delete
# question:  How is a challenge withdrawn, together with the doubt and defeat it caused?
# expect:    delete
#
# Withdrawing the challenge is not enough on its own: gsn:inDoubt and gsn:defeated were
# written onto the target by a rule, and nothing retracts them when the reason goes away.
# Clear them here, then re-run the dialectic updates to re-derive what still holds.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

DELETE {
  ?challenge ?outgoing ?object .
  ?subject ?incoming ?challenge .
  ?relationship ?relationshipProperty ?relationshipValue .
  ?target gsn:inDoubt ?doubt .
  ?target gsn:defeated ?defeated .
}
WHERE {
  VALUES ?challengeId { "CG1" }                       # PARAMETER
  ?challenge schema:identifier ?challengeId .
  {
    ?challenge gsn:challenges ?target .
    OPTIONAL { ?target gsn:inDoubt ?doubt }
    OPTIONAL { ?target gsn:defeated ?defeated }
  } UNION {
    ?challenge ?outgoing ?object .
  } UNION {
    ?subject ?incoming ?challenge .
  } UNION {
    ?relationship (rdf:subject|rdf:object) ?challenge ;
                  ?relationshipProperty ?relationshipValue .
  }
}
""" .

gsndesign:query-delete-element-and-its-links
    a gsndesign:Query ;
    rdfs:label "delete_element_and_its_links.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/delete_element_and_its_links.rq" ;
    gsndesign:fileChecksum "aaa56b36759483509e238e594c89017d77ad5367c95fca14d0e446e31cf5cfbf" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:answersQuestion gsndesign:cq-CQ-40 ;
    gsndesign:queryText """# id:        CQ-40
# operation: delete
# question:  How is an element removed without leaving dangling references to it?
# expect:    delete
#
# Both directions and the reifications. Deleting only the outgoing triples leaves the
# element's identifier gone but its parents still pointing at a node with no type.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

DELETE {
  ?element ?outgoing ?object .
  ?subject ?incoming ?element .
  ?relationship ?relationshipProperty ?relationshipValue .
}
WHERE {
  VALUES ?elementId { "G1.2" }                        # PARAMETER
  ?element schema:identifier ?elementId .
  {
    ?element ?outgoing ?object .
  } UNION {
    ?subject ?incoming ?element .
  } UNION {
    ?relationship (rdf:subject|rdf:object) ?element ;
                  ?relationshipProperty ?relationshipValue .
  }
}
""" .

gsndesign:query-delete-materialised-inferences
    a gsndesign:Query ;
    rdfs:label "delete_materialised_inferences.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/delete_materialised_inferences.rq" ;
    gsndesign:fileChecksum "a2ce80edf1d45ceaa9b74ed95c8b5b7112e39c10dd1b8e65549f117142927643" ;
    gsndesign:declaresNamespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Defeater ,
        gsn:away ,
        gsn:consistentWith ,
        gsn:contract ,
        gsn:defeated ,
        gsn:inDoubt ,
        gsn:public ,
        gsn:relationshipType ,
        gsn:top ,
        gsn:true ,
        gsn:valid ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0120 ,
        gsndesign:st-0144 ,
        gsndesign:st-0234 ,
        gsndesign:st-0490 ,
        gsndesign:st-0525 ,
        gsndesign:st-0534 ,
        gsndesign:st-0565 ,
        gsndesign:st-0699 ,
        gsndesign:st-0731 ,
        gsndesign:st-0760 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-41 ;
    gsndesign:queryText """# id:        CQ-41
# operation: delete
# question:  How are the conclusions written by ontology/queries/rules/ cleared before re-running them?
# expect:    delete
#
# Only the four things nothing but a rule ever writes. gsn:valid, gsn:true, gsn:away,
# gsn:top, gsn:public and gsn:contract are also set by hand, so clearing them would destroy
# assertions; the reified relationships the rules mint cannot be told from hand-drawn ones.
#
# To keep derived and asserted apart, run ontology/example/run_rules.py --out on a copy instead of
# materialising in place.

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DELETE {
  ?element gsn:inDoubt ?doubt .
  ?element gsn:defeated ?defeated .
  ?element gsn:consistentWith ?consistent .
  ?relationship gsn:relationshipType ?type .
  ?defeater rdf:type gsn:Defeater .
}
WHERE {
  { ?element gsn:inDoubt ?doubt }
  UNION
  { ?element gsn:defeated ?defeated }
  UNION
  { ?element gsn:consistentWith ?consistent }
  UNION
  { ?relationship rdf:subject ?any ; gsn:relationshipType ?type }
  UNION
  { ?defeater rdf:type gsn:Defeater }
}
""" .

gsndesign:query-delete-support-link
    a gsndesign:Query ;
    rdfs:label "delete_support_link.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/delete_support_link.rq" ;
    gsndesign:fileChecksum "0416f4d84351725f716521677b455fb5343e9c6b0f88b987bc26ce979cf3ba6c" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:supportedBy ;
    gsndesign:restsOnStatement gsndesign:st-0207 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-42 ;
    gsndesign:queryText """# id:        CQ-42
# operation: delete
# question:  How is one support or context link removed, leaving both elements in place?
# expect:    delete
#
# Detaching a branch rather than deleting it - the sub-argument survives and can be
# re-parented. The reification of the link goes with it, or it outlives what it describes.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

DELETE {
  ?from ?predicate ?to .
  ?relationship ?relationshipProperty ?relationshipValue .
}
WHERE {
  VALUES (?fromId ?toId ?predicate) {                 # PARAMETERS
    ("G1.1" "Sn2" gsn:supportedBy)
  }
  ?from schema:identifier ?fromId .
  ?to schema:identifier ?toId .
  ?from ?predicate ?to .
  OPTIONAL {
    ?relationship rdf:subject ?from ;
                  rdf:object ?to ;
                  ?relationshipProperty ?relationshipValue .
  }
}
""" .

gsndesign:query-delete-unreferenced-artefacts
    a gsndesign:Query ;
    rdfs:label "delete_unreferenced_artefacts.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/delete_unreferenced_artefacts.rq" ;
    gsndesign:fileChecksum "ecfbe561c95d89139bdf90f61683681b4bfa65c9aa44c3aba7a47b22b534c040" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Artefact ,
        gsn:refersTo ;
    gsndesign:restsOnStatement gsndesign:st-0111 ,
        gsndesign:st-0289 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-43 ;
    gsndesign:queryText """# id:        CQ-43
# operation: delete
# question:  How are artefacts no solution or context cites any more cleared out?
# expect:    delete
#
# Run read_solutions_without_artefact first. An artefact that looks unreferenced because
# the solution meant to cite it was never linked is not rubbish, it is a broken link.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>

DELETE {
  ?artefact ?property ?value .
  ?subject ?incoming ?artefact .
}
WHERE {
  ?artefact a gsn:Artefact .
  FILTER NOT EXISTS { ?reference gsn:refersTo ?artefact }
  {
    ?artefact ?property ?value .
  } UNION {
    ?subject ?incoming ?artefact .
  }
}
""" .

gsndesign:query-read-assurance-case-inventory
    a gsndesign:Query ;
    rdfs:label "read_assurance_case_inventory.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/read_assurance_case_inventory.rq" ;
    gsndesign:fileChecksum "2f59a0919c604d195396dd58797947023cf2e40f040ed2a4527b00f26e5e737a" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Argument ,
        gsn:AssuranceCase ,
        gsn:contains ,
        gsn:statement ;
    gsndesign:restsOnStatement gsndesign:st-0077 ,
        gsndesign:st-0085 ,
        gsndesign:st-0265 ,
        gsndesign:st-0474 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-01 ;
    gsndesign:queryText """# id:        CQ-01
# operation: read
# question:  What assurance cases are in the store, and what arguments does each contain?
# expect:    rows
#
# The orientation query: run this first against an unfamiliar store.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

SELECT ?caseId ?caseLabel ?argumentId ?argumentStatement
WHERE {
  ?case a gsn:AssuranceCase ;
        schema:identifier ?caseId .
  OPTIONAL { ?case rdfs:label ?caseLabel }
  OPTIONAL {
    ?case gsn:contains ?argument .
    ?argument a gsn:Argument ;
              schema:identifier ?argumentId .
    OPTIONAL { ?argument gsn:statement ?argumentStatement }
  }
}
ORDER BY ?caseId ?argumentId
""" .

gsndesign:query-read-assurance-claim-points
    a gsndesign:Query ;
    rdfs:label "read_assurance_claim_points.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/read_assurance_claim_points.rq" ;
    gsndesign:fileChecksum "b6b8ea7624ad201071feb9436e1625bf752ecf13a05fbbbc1b20eaf5ce490bc7" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:associatedWith ,
        gsn:assuranceClaimPoint ,
        gsn:statement ;
    gsndesign:restsOnStatement gsndesign:st-0265 ,
        gsndesign:st-0635 ,
        gsndesign:st-0658 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-02 ;
    gsndesign:queryText """# id:        CQ-02
# operation: read
# question:  Where are the assurance claim points, and what confidence argument backs each?
# expect:    rows

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

SELECT ?relationshipId ?subjectId ?objectId ?confidenceArgumentId ?confidenceStatement
WHERE {
  ?relationship gsn:assuranceClaimPoint ?acp ;
                schema:identifier ?relationshipId .
  FILTER(STR(?acp) = "true")
  OPTIONAL { ?relationship rdf:subject ?subject . ?subject schema:identifier ?subjectId }
  OPTIONAL { ?relationship rdf:object  ?object  . ?object  schema:identifier ?objectId }
  OPTIONAL {
    ?relationship gsn:associatedWith ?argument .
    ?argument schema:identifier ?confidenceArgumentId .
    OPTIONAL { ?argument gsn:statement ?confidenceStatement }
  }
}
ORDER BY ?relationshipId
""" .

gsndesign:query-read-away-elements
    a gsndesign:Query ;
    rdfs:label "read_away_elements.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/read_away_elements.rq" ;
    gsndesign:fileChecksum "ed83828a1994547893bad1f18f35f7139c61133bb21e3ffdcb05a2a99fd18bad" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Module ,
        gsn:away ,
        gsn:contains ,
        gsn:public ;
    gsndesign:restsOnStatement gsndesign:st-0469 ,
        gsndesign:st-0474 ,
        gsndesign:st-0490 ,
        gsndesign:st-0534 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-03 ;
    gsndesign:queryText """# id:        CQ-03
# operation: read
# question:  Which away elements are referenced, and does the module they come from exist?
# expect:    rows
#
# An away element repeats something declared elsewhere. If the elsewhere is not in the
# store, the reference is dangling and the argument is not self-contained.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT ?elementId ?type ?homeModuleId ?public
WHERE {
  ?element gsn:away ?away ;
           a ?type ;
           schema:identifier ?elementId .
  FILTER(STR(?away) = "true")
  OPTIONAL {
    ?home a gsn:Module ;
          gsn:contains+ ?element ;
          schema:identifier ?homeModuleId .
  }
  BIND(EXISTS { ?element gsn:public ?p . FILTER(STR(?p) = "true") } AS ?public)
}
ORDER BY ?elementId
""" .

gsndesign:query-read-case-summary-counts
    a gsndesign:Query ;
    rdfs:label "read_case_summary_counts.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/read_case_summary_counts.rq" ;
    gsndesign:fileChecksum "83e367a79bafed47fc4c678a116cef186e8bce7cf566aba82c29ae20f1fb4ba0" ;
    gsndesign:declaresNamespace "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:GSNElement ;
    gsndesign:restsOnStatement gsndesign:st-0132 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-04 ;
    gsndesign:queryText """# id:        CQ-04
# operation: read
# question:  How many elements of each GSN type does the case contain?
# expect:    rows
#
# rdfs:subClassOf* walks the TBox, so a Solution is counted as a Solution and the query
# still knows it is a GSN element. Nothing here needs a reasoner to have run first.

PREFIX gsn:  <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?type (COUNT(DISTINCT ?element) AS ?count)
WHERE {
  ?element a ?type .
  ?type rdfs:subClassOf* gsn:GSNElement .
}
GROUP BY ?type
ORDER BY DESC(?count) ?type
""" .

gsndesign:query-read-challenges-and-their-targets
    a gsndesign:Query ;
    rdfs:label "read_challenges_and_their_targets.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/read_challenges_and_their_targets.rq" ;
    gsndesign:fileChecksum "230d55b9f4a3f4e5124a52fa306af604a00fde65535fdc58aec7322e5999e5d1" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Defeater ,
        gsn:Goal ,
        gsn:Solution ,
        gsn:challenges ,
        gsn:statement ;
    gsndesign:restsOnStatement gsndesign:st-0161 ,
        gsndesign:st-0175 ,
        gsndesign:st-0265 ,
        gsndesign:st-0696 ,
        gsndesign:st-0740 ,
        gsndesign:st-0760 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-63 ;
    gsndesign:queryText """# id:        CQ-05
# operation: read
# question:  What challenges have been raised, against what, and by what kind of defeater?
# expect:    rows
#
# A goal-shaped challenge puts its target in doubt; a solution-shaped one cites evidence
# and defeats it. The distinction decides how urgent the row is.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT ?challengeId ?challengeKind ?challengeStatement ?targetId ?targetType
WHERE {
  ?challenge gsn:challenges ?target ;
             schema:identifier ?challengeId ;
             a ?challengeKind .
  FILTER(?challengeKind IN (gsn:Goal, gsn:Solution, gsn:Defeater))
  OPTIONAL { ?challenge gsn:statement ?challengeStatement }
  OPTIONAL {
    ?target schema:identifier ?targetId ;
            a ?targetType .
  }
}
ORDER BY ?challengeId
""" .

gsndesign:query-read-claim-points-without-confidence-argument
    a gsndesign:Query ;
    rdfs:label "read_claim_points_without_confidence_argument.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/read_claim_points_without_confidence_argument.rq" ;
    gsndesign:fileChecksum "471a118c45f8bc641f08e337f6692c785a05a0b80eedda99953956d9d5cbac47" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:argumentType ,
        gsn:associatedWith ,
        gsn:assuranceClaimPoint ;
    gsndesign:restsOnStatement gsndesign:st-0635 ,
        gsndesign:st-0640 ,
        gsndesign:st-0658 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-06 ;
    gsndesign:queryText """# id:        CQ-06
# operation: read
# question:  Which assurance claim points have no confidence argument behind them?
# expect:    rows
#
# An assurance claim point is a promise that confidence in this step has been argued
# somewhere. One with nothing associated is the promise unkept.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

SELECT ?relationshipId ?subjectId ?objectId
WHERE {
  ?relationship gsn:assuranceClaimPoint ?acp ;
                schema:identifier ?relationshipId .
  FILTER(STR(?acp) = "true")
  OPTIONAL { ?relationship rdf:subject ?subject . ?subject schema:identifier ?subjectId }
  OPTIONAL { ?relationship rdf:object  ?object  . ?object  schema:identifier ?objectId }

  FILTER NOT EXISTS {
    ?relationship gsn:associatedWith ?argument .
    ?argument gsn:argumentType "confidence" .
  }
}
ORDER BY ?relationshipId
""" .

gsndesign:query-read-context-in-scope-for-goal
    a gsndesign:Query ;
    rdfs:label "read_context_in_scope_for_goal.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/read_context_in_scope_for_goal.rq" ;
    gsndesign:fileChecksum "4608835e631e66d96c5c2d70139a3c57bdcb0c65f0c1b1aedcac83980958319e" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:GSNElement ,
        gsn:inContextOf ,
        gsn:statement ,
        gsn:supportedBy ;
    gsndesign:restsOnStatement gsndesign:st-0132 ,
        gsndesign:st-0207 ,
        gsndesign:st-0218 ,
        gsndesign:st-0265 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-44 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-45 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-46 ;
    gsndesign:queryText """# id:        CQ-07
# operation: read
# question:  What context, assumptions and justifications are in scope for a given goal?
# expect:    rows
#
# Context is inherited down the support chain (SWRL rule "Context Inheritance"), so a
# goal is read in the context declared on it AND on everything above it.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

SELECT DISTINCT ?contextId ?type ?statement ?declaredOnId ?inherited
WHERE {
  VALUES ?goalId { "G1.1" }           # PARAMETER: the goal being read

  ?goal schema:identifier ?goalId .
  ?ancestor gsn:supportedBy* ?goal .
  ?ancestor gsn:inContextOf ?context ;
            schema:identifier ?declaredOnId .
  ?context a ?type ;
           schema:identifier ?contextId .
  ?type rdfs:subClassOf* gsn:GSNElement .
  OPTIONAL { ?context gsn:statement ?statement }
  BIND(?ancestor != ?goal AS ?inherited)
}
ORDER BY ?inherited ?contextId
""" .

gsndesign:query-read-duplicate-identifiers
    a gsndesign:Query ;
    rdfs:label "read_duplicate_identifiers.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/read_duplicate_identifiers.rq" ;
    gsndesign:fileChecksum "e4877600a29008497c46ad7528f8d38f20d9e2d392907d53af064ec140501079" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Argument ,
        gsn:Artefact ,
        gsn:AssuranceCase ,
        gsn:GSNElement ,
        gsn:Pattern ,
        gsn:Relationship ;
    gsndesign:restsOnStatement gsndesign:st-0077 ,
        gsndesign:st-0085 ,
        gsndesign:st-0111 ,
        gsndesign:st-0132 ,
        gsndesign:st-0291 ,
        gsndesign:st-0369 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-08 ;
    gsndesign:queryText """# id:        CQ-08
# operation: read
# question:  Do two distinct elements share a schema:identifier?
# expect:    rows
#
# The ontology requires exactly one identifier per element and the SWRL rules invalidate
# both parties to a clash (S25, S41), because every other query addresses elements by it.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

SELECT ?identifier (COUNT(DISTINCT ?element) AS ?holders) (GROUP_CONCAT(DISTINCT STR(?element); separator=" ") AS ?elements)
WHERE {
  VALUES ?kind { gsn:GSNElement gsn:Argument gsn:Artefact gsn:AssuranceCase
                 gsn:Pattern gsn:Relationship }
  ?element a/rdfs:subClassOf* ?kind ;
           schema:identifier ?identifier .
}
GROUP BY ?identifier
HAVING (COUNT(DISTINCT ?element) > 1)
ORDER BY ?identifier
""" .

gsndesign:query-read-element-by-identifier
    a gsndesign:Query ;
    rdfs:label "read_element_by_identifier.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/read_element_by_identifier.rq" ;
    gsndesign:fileChecksum "665b5562757baf278d6632c8de9521066b33ded437130f6f8708e5e0e9e38397" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:associatedWith ,
        gsn:challenges ,
        gsn:inContextOf ,
        gsn:instantiationOf ,
        gsn:refersTo ,
        gsn:statement ,
        gsn:substitutedBy ,
        gsn:supportedBy ;
    gsndesign:restsOnStatement gsndesign:st-0207 ,
        gsndesign:st-0218 ,
        gsndesign:st-0265 ,
        gsndesign:st-0289 ,
        gsndesign:st-0305 ,
        gsndesign:st-0574 ,
        gsndesign:st-0658 ,
        gsndesign:st-0696 ,
        gsndesign:st-0740 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-09 ;
    gsndesign:queryText """# id:        CQ-09
# operation: read
# question:  What does the element with a given identifier say, and what is it linked to?
# expect:    rows
#
# The addressing primitive. Every GSN element carries exactly one schema:identifier, so
# that - not the IRI - is how a person refers to an element.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

SELECT ?element ?type ?label ?statement ?property ?linkedId
WHERE {
  VALUES ?elementId { "G1" }          # PARAMETER: the identifier to look up

  ?element schema:identifier ?elementId ;
           a ?type .
  OPTIONAL { ?element rdfs:label ?label }
  OPTIONAL { ?element gsn:statement ?statement }
  OPTIONAL {
    VALUES ?property { gsn:supportedBy gsn:inContextOf gsn:refersTo gsn:challenges
                       gsn:instantiationOf gsn:substitutedBy gsn:associatedWith }
    ?element ?property ?linked .
    ?linked schema:identifier ?linkedId .
  }
}
ORDER BY ?type ?property ?linkedId
""" .

gsndesign:query-read-element-status-flags
    a gsndesign:Query ;
    rdfs:label "read_element_status_flags.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/read_element_status_flags.rq" ;
    gsndesign:fileChecksum "1f5c76ac39a52f90207843d019b52c9d1f8ac2531c25d28b6a989cdfa144cde8" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:defeated ,
        gsn:inDoubt ,
        gsn:true ,
        gsn:valid ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0234 ,
        gsndesign:st-0699 ,
        gsndesign:st-0731 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-54 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-67 ;
    gsndesign:queryText """# id:        CQ-10
# operation: read
# question:  What is the current status of every element - valid, true, in doubt, defeated?
# expect:    rows
#
# One row per flag rather than one row per element, because the flags are set by different
# rules at different times and the useful question is usually about one of them.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT ?elementId ?flag ?value
WHERE {
  VALUES ?flag { gsn:valid gsn:true gsn:inDoubt gsn:defeated }
  ?element ?flag ?value ;
           schema:identifier ?elementId .
}
ORDER BY ?elementId ?flag
""" .

gsndesign:query-read-elements-unreachable-from-top-goal
    a gsndesign:Query ;
    rdfs:label "read_elements_unreachable_from_top_goal.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/read_elements_unreachable_from_top_goal.rq" ;
    gsndesign:fileChecksum "33caeb3a5a6ba6b0b02733f9c4a8034d7cd41535edd6c9b716e6f82a79e59edc" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:GSNElement ,
        gsn:Goal ,
        gsn:inContextOf ,
        gsn:refersTo ,
        gsn:statement ,
        gsn:supportedBy ,
        gsn:top ;
    gsndesign:restsOnStatement gsndesign:st-0132 ,
        gsndesign:st-0144 ,
        gsndesign:st-0161 ,
        gsndesign:st-0207 ,
        gsndesign:st-0218 ,
        gsndesign:st-0265 ,
        gsndesign:st-0289 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-11 ;
    gsndesign:queryText """# id:        CQ-11
# operation: read
# question:  Which elements are not reachable from any top goal - present but unargued?
# expect:    rows
#
# Reachability is over support and context together, since a context element is part of
# the argument without ever being supported by anything.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

SELECT ?elementId ?type ?statement
WHERE {
  ?element a ?type ;
           schema:identifier ?elementId .
  ?type rdfs:subClassOf* gsn:GSNElement .
  OPTIONAL { ?element gsn:statement ?statement }

  FILTER NOT EXISTS {
    ?top a gsn:Goal ;
         gsn:top ?t .
    FILTER(STR(?t) = "true")
    ?top (gsn:supportedBy|gsn:inContextOf|gsn:refersTo)* ?element .
  }
}
ORDER BY ?elementId
""" .

gsndesign:query-read-evidence-supporting-goal
    a gsndesign:Query ;
    rdfs:label "read_evidence_supporting_goal.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/read_evidence_supporting_goal.rq" ;
    gsndesign:fileChecksum "f5add6cda83ba879c298b56f8e1d95cf40247564a68b72b98313eea44fe92a58" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Solution ,
        gsn:refersTo ,
        gsn:statement ,
        gsn:supportedBy ;
    gsndesign:restsOnStatement gsndesign:st-0175 ,
        gsndesign:st-0207 ,
        gsndesign:st-0265 ,
        gsndesign:st-0289 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-51 ;
    gsndesign:queryText """# id:        CQ-12
# operation: read
# question:  What evidence ultimately supports a given goal?
# expect:    rows
#
# Solutions are references to evidence; the artefact behind the reference is what an
# auditor actually asks to see, so both are returned.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

SELECT DISTINCT ?solutionId ?solutionStatement ?artefactId ?artefactLabel
WHERE {
  VALUES ?goalId { "G1" }             # PARAMETER: the goal to trace

  ?goal schema:identifier ?goalId .
  ?goal gsn:supportedBy+ ?solution .
  ?solution a gsn:Solution ;
            schema:identifier ?solutionId .
  OPTIONAL { ?solution gsn:statement ?solutionStatement }
  OPTIONAL {
    ?solution gsn:refersTo ?artefact .
    ?artefact schema:identifier ?artefactId .
    OPTIONAL { ?artefact rdfs:label ?artefactLabel }
  }
}
ORDER BY ?solutionId
""" .

gsndesign:query-read-goal-support-tree
    a gsndesign:Query ;
    rdfs:label "read_goal_support_tree.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/read_goal_support_tree.rq" ;
    gsndesign:fileChecksum "9d9dc8c5968292ba00c14b18c96064a868c50c4bcd34289b22edb21fd7031caa" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:statement ,
        gsn:supportedBy ;
    gsndesign:restsOnStatement gsndesign:st-0207 ,
        gsndesign:st-0265 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-47 ;
    gsndesign:queryText """# id:        CQ-13
# operation: read
# question:  What is the whole argument beneath a given goal?
# expect:    rows
#
# ?depth is the length of the shortest support chain from the root, which is what makes
# the result readable as a tree rather than a bag of elements.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT ?descendantId ?type ?statement (MIN(?hops) AS ?depth)
WHERE {
  VALUES ?rootId { "G1" }             # PARAMETER: the goal to expand

  ?root schema:identifier ?rootId .
  ?root gsn:supportedBy+ ?descendant .
  ?descendant a ?type ;
              schema:identifier ?descendantId .
  OPTIONAL { ?descendant gsn:statement ?statement }
  {
    SELECT ?root ?descendant (COUNT(?step) AS ?hops)
    WHERE {
      ?root gsn:supportedBy* ?step .
      ?step gsn:supportedBy+ ?descendant .
    }
    GROUP BY ?root ?descendant
  }
}
GROUP BY ?descendantId ?type ?statement
ORDER BY ?depth ?descendantId
""" .

gsndesign:query-read-goals-affected-by-challenge
    a gsndesign:Query ;
    rdfs:label "read_goals_affected_by_challenge.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/read_goals_affected_by_challenge.rq" ;
    gsndesign:fileChecksum "5416f069e4c972b3e8e218f861cf7ec7e9e2e780b7a359b1cc0a78412f193923" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:Strategy ,
        gsn:challenges ,
        gsn:statement ,
        gsn:supportedBy ;
    gsndesign:restsOnStatement gsndesign:st-0161 ,
        gsndesign:st-0167 ,
        gsndesign:st-0207 ,
        gsndesign:st-0265 ,
        gsndesign:st-0696 ,
        gsndesign:st-0740 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-63 ;
    gsndesign:queryText """# id:        CQ-14
# operation: read
# question:  Which claims above a challenged element lose support if the challenge stands?
# expect:    rows
#
# The challenge is levied at one element; what matters is everything resting on it.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT DISTINCT ?affectedId ?type ?statement ?challengeId ?targetId
WHERE {
  ?challenge gsn:challenges ?target ;
             schema:identifier ?challengeId .
  ?target schema:identifier ?targetId .
  ?affected gsn:supportedBy* ?target ;
            a ?type ;
            schema:identifier ?affectedId .
  FILTER(?type IN (gsn:Goal, gsn:Strategy))
  OPTIONAL { ?affected gsn:statement ?statement }
}
ORDER BY ?challengeId ?affectedId
""" .

gsndesign:query-read-goals-resting-on-artefact
    a gsndesign:Query ;
    rdfs:label "read_goals_resting_on_artefact.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/read_goals_resting_on_artefact.rq" ;
    gsndesign:fileChecksum "31dad7722729a2ee585e5393d75ebec3903ca8a35ff136c714b8e883db17d98d" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:refersTo ,
        gsn:statement ,
        gsn:supportedBy ;
    gsndesign:restsOnStatement gsndesign:st-0161 ,
        gsndesign:st-0207 ,
        gsndesign:st-0265 ,
        gsndesign:st-0289 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-77 ;
    gsndesign:queryText """# id:        CQ-15
# operation: read
# question:  If a given artefact is withdrawn or superseded, which claims are affected?
# expect:    rows
#
# The impact analysis that has to be run before any evidence item is replaced.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT DISTINCT ?goalId ?statement ?solutionId
WHERE {
  VALUES ?artefactId { "Ev2" }        # PARAMETER: the artefact in question

  ?artefact schema:identifier ?artefactId .
  ?solution gsn:refersTo ?artefact ;
            schema:identifier ?solutionId .
  ?goal gsn:supportedBy+ ?solution ;
        a gsn:Goal ;
        schema:identifier ?goalId .
  OPTIONAL { ?goal gsn:statement ?statement }
}
ORDER BY ?goalId
""" .

gsndesign:query-read-goals-without-support
    a gsndesign:Query ;
    rdfs:label "read_goals_without_support.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/read_goals_without_support.rq" ;
    gsndesign:fileChecksum "0fb730490c0b533ecb77bbf85d3b986fc7763f768190076e7ef7f5b0a9e54e60" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:away ,
        gsn:statement ,
        gsn:supportedBy ,
        gsn:toBeSupportedByContract ,
        gsn:undeveloped ;
    gsndesign:restsOnStatement gsndesign:st-0161 ,
        gsndesign:st-0200 ,
        gsndesign:st-0207 ,
        gsndesign:st-0265 ,
        gsndesign:st-0490 ,
        gsndesign:st-0542 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-46 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-48 ;
    gsndesign:queryText """# id:        CQ-16
# operation: read
# question:  Which goals have no support at all and are not admitted to be undeveloped?
# expect:    rows
#
# An unadmitted gap: the argument stops, and nothing on the diagram says so. This is the
# single most useful completeness check in the set.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT ?goalId ?statement
WHERE {
  ?goal a gsn:Goal ;
        schema:identifier ?goalId .
  OPTIONAL { ?goal gsn:statement ?statement }

  FILTER NOT EXISTS { ?goal gsn:supportedBy ?anything }
  FILTER NOT EXISTS { ?goal gsn:undeveloped ?u . FILTER(STR(?u) = "true") }
  FILTER NOT EXISTS { ?goal gsn:toBeSupportedByContract ?c . FILTER(STR(?c) = "true") }
  FILTER NOT EXISTS { ?goal gsn:away ?a . FILTER(STR(?a) = "true") }
}
ORDER BY ?goalId
""" .

gsndesign:query-read-invalid-elements
    a gsndesign:Query ;
    rdfs:label "read_invalid_elements.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/read_invalid_elements.rq" ;
    gsndesign:fileChecksum "03b4c76fd1e749ef9a44d4886bb4ce178fe466406d079bb0b7de800f29dd52e0" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:defeated ,
        gsn:inDoubt ,
        gsn:statement ,
        gsn:true ,
        gsn:valid ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0234 ,
        gsndesign:st-0265 ,
        gsndesign:st-0699 ,
        gsndesign:st-0731 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-54 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-67 ;
    gsndesign:queryText """# id:        CQ-17
# operation: read
# question:  Which elements or relationships are currently invalid, in doubt or defeated?
# expect:    rows
#
# The three dialectic and validity flags collapsed into one worklist, with the reason.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT DISTINCT ?elementId ?reason ?statement
WHERE {
  ?element schema:identifier ?elementId .
  OPTIONAL { ?element gsn:statement ?statement }
  {
    ?element gsn:valid ?v . FILTER(STR(?v) = "false")
    BIND("invalid" AS ?reason)
  } UNION {
    ?element gsn:defeated ?d . FILTER(STR(?d) = "true")
    BIND("defeated" AS ?reason)
  } UNION {
    ?element gsn:inDoubt ?i . FILTER(STR(?i) = "true")
    BIND("in doubt" AS ?reason)
  } UNION {
    ?element gsn:true ?t . FILTER(STR(?t) = "false")
    BIND("asserted false" AS ?reason)
  }
}
ORDER BY ?elementId ?reason
""" .

gsndesign:query-read-module-dependencies
    a gsndesign:Query ;
    rdfs:label "read_module_dependencies.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/read_module_dependencies.rq" ;
    gsndesign:fileChecksum "ab7348099f64abe9d2bcd827e009bc50440cd5cd86cd7480fc74196dc5bbc06d" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Module ,
        gsn:contains ,
        gsn:inContextOf ,
        gsn:supportedBy ;
    gsndesign:restsOnStatement gsndesign:st-0207 ,
        gsndesign:st-0218 ,
        gsndesign:st-0469 ,
        gsndesign:st-0474 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-18 ;
    gsndesign:queryText """# id:        CQ-18
# operation: read
# question:  Which modules depend on which, and through which elements?
# expect:    rows
#
# The module-level edge is derived from the element-level one, so the witness element is
# returned with it: a dependency nobody can point at an element for is a modelling error.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT DISTINCT ?fromModuleId ?kind ?toModuleId ?viaFromId ?viaToId
WHERE {
  ?from a gsn:Module ; schema:identifier ?fromModuleId ; gsn:contains+ ?viaFrom .
  ?to   a gsn:Module ; schema:identifier ?toModuleId   ; gsn:contains+ ?viaTo .
  FILTER(?from != ?to)
  ?viaFrom schema:identifier ?viaFromId .
  ?viaTo   schema:identifier ?viaToId .
  {
    ?viaFrom gsn:supportedBy ?viaTo .
    BIND("supportedBy" AS ?kind)
  } UNION {
    ?viaFrom gsn:inContextOf ?viaTo .
    BIND("inContextOf" AS ?kind)
  }
}
ORDER BY ?fromModuleId ?toModuleId
""" .

gsndesign:query-read-pattern-instantiations
    a gsndesign:Query ;
    rdfs:label "read_pattern_instantiations.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/read_pattern_instantiations.rq" ;
    gsndesign:fileChecksum "99bb0072389050021722288ead795489c9cbf5a8749497fed6b0df94e7be1973" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Pattern ,
        gsn:applicability ,
        gsn:consequences ,
        gsn:instantiationOf ,
        gsn:intent ;
    gsndesign:restsOnStatement gsndesign:st-0305 ,
        gsndesign:st-0369 ,
        gsndesign:st-0382 ,
        gsndesign:st-0407 ,
        gsndesign:st-0412 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-75 ;
    gsndesign:queryText """# id:        CQ-19
# operation: read
# question:  Which elements instantiate which argument pattern, and is the pattern's own
#            documentation complete?
# expect:    rows
#
# The standard asks a pattern to state its intent, applicability and consequences before
# anyone reuses it. Missing sections are how a pattern gets applied out of context.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

SELECT ?patternId ?patternLabel ?instanceId ?hasIntent ?hasApplicability ?hasConsequences
WHERE {
  ?pattern a/rdfs:subClassOf* gsn:Pattern ;
           schema:identifier ?patternId .
  OPTIONAL { ?pattern rdfs:label ?patternLabel }
  OPTIONAL {
    ?instance gsn:instantiationOf ?pattern ;
              schema:identifier ?instanceId .
  }
  BIND(EXISTS { ?pattern gsn:intent        ?i } AS ?hasIntent)
  BIND(EXISTS { ?pattern gsn:applicability ?a } AS ?hasApplicability)
  BIND(EXISTS { ?pattern gsn:consequences  ?c } AS ?hasConsequences)
}
ORDER BY ?patternId ?instanceId
""" .

gsndesign:query-read-public-elements-in-contract-modules
    a gsndesign:Query ;
    rdfs:label "read_public_elements_in_contract_modules.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/read_public_elements_in_contract_modules.rq" ;
    gsndesign:fileChecksum "c50bf6532d81502e06248f087f7060711f663bc5e740ddf5a8b493f8ac59431c" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:contains ,
        gsn:contract ,
        gsn:public ;
    gsndesign:restsOnStatement gsndesign:st-0474 ,
        gsndesign:st-0525 ,
        gsndesign:st-0534 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-20 ;
    gsndesign:queryText """# id:        CQ-20
# operation: read
# question:  Which public elements sit inside a contract module, where they must not?
# expect:    rows
#
# SWRL rule "Public Contract Invalidation" (S39) as a read: a contract module mediates
# between interfaces and has no interface of its own to publish through.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT ?moduleId ?elementId ?type
WHERE {
  ?module gsn:contract ?contract ;
          gsn:contains+ ?element ;
          schema:identifier ?moduleId .
  FILTER(STR(?contract) = "true")
  ?element gsn:public ?public ;
           a ?type ;
           schema:identifier ?elementId .
  FILTER(STR(?public) = "true")
}
ORDER BY ?moduleId ?elementId
""" .

gsndesign:query-read-relationship-decorators
    a gsndesign:Query ;
    rdfs:label "read_relationship_decorators.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/read_relationship_decorators.rq" ;
    gsndesign:fileChecksum "1d4a8fd283db36e9fe6bfc76594f398facd6783f068cffd92386f2aae23aa7fb" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Relationship ,
        gsn:choice ,
        gsn:maxCardinality ,
        gsn:minCardinality ,
        gsn:multiple ,
        gsn:optional ;
    gsndesign:restsOnStatement gsndesign:st-0291 ,
        gsndesign:st-0312 ,
        gsndesign:st-0316 ,
        gsndesign:st-0334 ,
        gsndesign:st-0336 ,
        gsndesign:st-0340 ,
        gsndesign:st-0353 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-21 ;
    gsndesign:queryText """# id:        CQ-21
# operation: read
# question:  Which relationships carry pattern decorators - optional, multiple, cardinality?
# expect:    rows
#
# These say how a pattern is to be instantiated, and are the part most often lost when a
# pattern is copied into a concrete case by hand.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

SELECT ?relationshipId ?subjectId ?objectId ?optional ?multiple ?choice ?minCardinality ?maxCardinality
WHERE {
  ?relationship a/rdfs:subClassOf* gsn:Relationship ;
                schema:identifier ?relationshipId .
  OPTIONAL { ?relationship rdf:subject ?subject . ?subject schema:identifier ?subjectId }
  OPTIONAL { ?relationship rdf:object  ?object  . ?object  schema:identifier ?objectId }
  OPTIONAL { ?relationship gsn:optional       ?optional }
  OPTIONAL { ?relationship gsn:multiple       ?multiple }
  OPTIONAL { ?relationship gsn:choice         ?choice }
  OPTIONAL { ?relationship gsn:minCardinality ?minCardinality }
  OPTIONAL { ?relationship gsn:maxCardinality ?maxCardinality }
  FILTER(BOUND(?optional) || BOUND(?multiple) || BOUND(?choice)
         || BOUND(?minCardinality) || BOUND(?maxCardinality))
}
ORDER BY ?relationshipId
""" .

gsndesign:query-read-solutions-without-artefact
    a gsndesign:Query ;
    rdfs:label "read_solutions_without_artefact.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/read_solutions_without_artefact.rq" ;
    gsndesign:fileChecksum "9153b986a67079d7673790e1a5d80c6b211c3e5d73425aece6b77d7699a15924" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Solution ,
        gsn:refersTo ,
        gsn:statement ;
    gsndesign:restsOnStatement gsndesign:st-0175 ,
        gsndesign:st-0265 ,
        gsndesign:st-0289 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-48 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-51 ;
    gsndesign:queryText """# id:        CQ-22
# operation: read
# question:  Which solutions cite no artefact - evidence claimed but not identified?
# expect:    rows

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT ?solutionId ?statement
WHERE {
  ?solution a gsn:Solution ;
            schema:identifier ?solutionId .
  OPTIONAL { ?solution gsn:statement ?statement }
  FILTER NOT EXISTS { ?solution gsn:refersTo ?artefact }
}
ORDER BY ?solutionId
""" .

gsndesign:query-read-stale-evidence
    a gsndesign:Query ;
    rdfs:label "read_stale_evidence.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/read_stale_evidence.rq" ;
    gsndesign:fileChecksum "5a30c0d76ec94ad1424e205c9e72bbe278acd49496044564d97b3cce655d4e78" ;
    gsndesign:declaresNamespace "http://purl.org/dc/terms/" ,
        "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "http://www.w3.org/2001/XMLSchema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Artefact ,
        gsn:Goal ,
        gsn:refersTo ,
        gsn:supportedBy ;
    gsndesign:restsOnStatement gsndesign:st-0111 ,
        gsndesign:st-0161 ,
        gsndesign:st-0207 ,
        gsndesign:st-0289 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-23 ;
    gsndesign:queryText """# id:        CQ-23
# operation: read
# question:  Which artefacts predate a given date, and which claims still rest on them?
# expect:    rows
#
# OntoGSN dates nothing itself - an artefact is dated by whatever the ABox uses, here
# dcterms:created. Change the property below if your case records it differently.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>
PREFIX terms:  <http://purl.org/dc/terms/>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>

SELECT ?artefactId ?artefactLabel ?created ?solutionId ?goalId
WHERE {
  VALUES ?cutoff { "2025-01-01"^^xsd:date }   # PARAMETER: anything older than this

  ?artefact a gsn:Artefact ;
            schema:identifier ?artefactId ;
            terms:created ?created .
  FILTER(?created < ?cutoff)
  OPTIONAL { ?artefact rdfs:label ?artefactLabel }
  OPTIONAL {
    ?solution gsn:refersTo ?artefact ;
              schema:identifier ?solutionId .
    OPTIONAL {
      ?goal gsn:supportedBy+ ?solution ;
            a gsn:Goal ;
            schema:identifier ?goalId .
    }
  }
}
ORDER BY ?created ?artefactId
""" .

gsndesign:query-read-support-cycles
    a gsndesign:Query ;
    rdfs:label "read_support_cycles.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/read_support_cycles.rq" ;
    gsndesign:fileChecksum "44a990e8ba2dc1566333c02caf9a47f55048e15e147feedf93361e3dd9a68e8f" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:supportedBy ;
    gsndesign:restsOnStatement gsndesign:st-0207 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-24 ;
    gsndesign:queryText """# id:        CQ-24
# operation: read
# question:  Does any element support itself through a chain - a circular argument?
# expect:    rows
#
# gsn:supportedBy is asymmetric and irreflexive, so a cycle is a contradiction rather
# than a warning; an OWL reasoner would report the whole ABox inconsistent instead of
# telling you where. This says where.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT DISTINCT ?elementId ?type ?viaId
WHERE {
  ?element gsn:supportedBy+ ?element ;
           a ?type ;
           schema:identifier ?elementId .
  ?element gsn:supportedBy ?via .
  ?via schema:identifier ?viaId .
}
ORDER BY ?elementId
""" .

gsndesign:query-read-top-goals
    a gsndesign:Query ;
    rdfs:label "read_top_goals.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/read_top_goals.rq" ;
    gsndesign:fileChecksum "6bfd41458019a2d218a2029403362f6152e81c0a4055bbd2e8b8ff31966d2eba" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:statement ,
        gsn:supportedBy ,
        gsn:top ;
    gsndesign:restsOnStatement gsndesign:st-0144 ,
        gsndesign:st-0161 ,
        gsndesign:st-0207 ,
        gsndesign:st-0265 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-25 ;
    gsndesign:queryText """# id:        CQ-25
# operation: read
# question:  What is the top goal of each argument - the claim everything else supports?
# expect:    rows
#
# Two ways of being top are accepted: the gsn:top decorator, and being a goal that no
# other element supports. A case where the two disagree is worth looking at.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT DISTINCT ?goalId ?statement ?flaggedTop ?unsupportedFromAbove
WHERE {
  ?goal a gsn:Goal ;
        schema:identifier ?goalId .
  OPTIONAL { ?goal gsn:statement ?statement }
  BIND(EXISTS { ?goal gsn:top ?t . FILTER(STR(?t) = "true") } AS ?flaggedTop)
  BIND(NOT EXISTS { ?parent gsn:supportedBy ?goal } AS ?unsupportedFromAbove)
  FILTER(?flaggedTop || ?unsupportedFromAbove)
}
ORDER BY ?goalId
""" .

gsndesign:query-read-undeveloped-elements
    a gsndesign:Query ;
    rdfs:label "read_undeveloped_elements.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/read_undeveloped_elements.rq" ;
    gsndesign:fileChecksum "7641554bc40a94a8311abb4182b500e5f4073c0d316f95b26374d24940f78f43" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:statement ,
        gsn:supportedBy ,
        gsn:undeveloped ;
    gsndesign:restsOnStatement gsndesign:st-0200 ,
        gsndesign:st-0207 ,
        gsndesign:st-0265 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-46 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-53 ;
    gsndesign:queryText """# id:        CQ-26
# operation: read
# question:  Which lines of argument are declared undeveloped, and are still undeveloped?
# expect:    rows
#
# The decorator is a promise. This finds the ones still outstanding, and separately the
# ones that have since been developed and whose decorator nobody cleared.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT ?elementId ?type ?statement ?stillUndeveloped
WHERE {
  ?element gsn:undeveloped ?flag ;
           a ?type ;
           schema:identifier ?elementId .
  FILTER(STR(?flag) = "true")
  OPTIONAL { ?element gsn:statement ?statement }
  BIND(NOT EXISTS { ?element gsn:supportedBy ?child } AS ?stillUndeveloped)
}
ORDER BY DESC(?stillUndeveloped) ?elementId
""" .

gsndesign:query-read-uninstantiated-elements
    a gsndesign:Query ;
    rdfs:label "read_uninstantiated_elements.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/read_uninstantiated_elements.rq" ;
    gsndesign:fileChecksum "c49b4655a01f2e1744e5ab50b3a61a58acd37743cb1d6c4b20184746ce4ae4cc" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:instantiationOf ,
        gsn:statement ,
        gsn:uninstantiated ;
    gsndesign:restsOnStatement gsndesign:st-0265 ,
        gsndesign:st-0305 ,
        gsndesign:st-0358 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-48 ;
    gsndesign:queryText """# id:        CQ-27
# operation: read
# question:  Which elements are still uninstantiated placeholders from a pattern?
# expect:    rows
#
# The hollow triangle. A published case carrying one is a case that was never finished.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT ?elementId ?type ?statement ?patternId
WHERE {
  ?element gsn:uninstantiated ?flag ;
           a ?type ;
           schema:identifier ?elementId .
  FILTER(STR(?flag) = "true")
  OPTIONAL { ?element gsn:statement ?statement }
  OPTIONAL {
    ?element gsn:instantiationOf ?pattern .
    ?pattern schema:identifier ?patternId .
  }
}
ORDER BY ?elementId
""" .

gsndesign:query-rules-s01-assumption-invalidation
    a gsndesign:Query ;
    rdfs:label "rules/s01_assumption_invalidation.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s01_assumption_invalidation.rq" ;
    gsndesign:fileChecksum "c68a5497b161a2566d2cc29467a1b9c462f582e5517f6878278ff2dfe9e5f3e1" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Assumption ,
        gsn:inContextOf ,
        gsn:valid ;
    gsndesign:ruleName "Assumption Invalidation" ;
    gsndesign:translatesStatement gsndesign:st-0119 ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0188 ,
        gsndesign:st-0218 ;
    gsndesign:queryText """# rule:      S1
# name:      Assumption Invalidation
# section:   Core GSN
# operation: rule
# expect:    insert
# swrl:      Assumption(?A) ^ valid(?A, false) ^ 'in context of'(?B, ?A) -> valid(?B, false)
# reads:     IF A is an Assumption AND A is NOT valid AND B is in context of A THEN B is NOT
#            valid

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?B gsn:valid ?old }
INSERT { ?B gsn:valid false }
WHERE {
  ?A a gsn:Assumption ;
     gsn:valid ?vA .
  FILTER(STR(?vA) = "false")
  ?B gsn:inContextOf ?A .
  OPTIONAL { ?B gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsndesign:query-rules-s02-contextual-relation
    a gsndesign:Query ;
    rdfs:label "rules/s02_contextual_relation.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s02_contextual_relation.rq" ;
    gsndesign:fileChecksum "44e2e3ae3803341ed59e5d9748defead46234c2d33bbac9b39bc0ac9b2cfcc47" ;
    gsndesign:declaresNamespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:inContextOf ,
        gsn:relationshipType ;
    gsndesign:ruleName "Contextual Relation" ;
    gsndesign:translatesStatement gsndesign:st-0127 ;
    gsndesign:restsOnStatement gsndesign:st-0120 ,
        gsndesign:st-0218 ;
    gsndesign:queryText """# rule:      S2
# name:      Contextual Relation
# section:   Core GSN
# operation: rule
# expect:    insert
# swrl:      rdf:subject(?R, ?A) ^ 'in context of'(?A, ?B) ^ rdf:object(?R, ?B) -> 'relationship
#            type'(?R, "contextual")
# reads:     IF R has subject A AND A is in context of B AND R has object B THEN R is a
#            contextual relationship

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DELETE { ?R gsn:relationshipType ?old }
INSERT { ?R gsn:relationshipType "contextual" }
WHERE {
  ?R rdf:subject ?A ;
     rdf:object ?B .
  ?A gsn:inContextOf ?B .
  OPTIONAL { ?R gsn:relationshipType ?old }
  FILTER(!BOUND(?old) || ?old != "contextual")
}
""" .

gsndesign:query-rules-s03-evidential-relation
    a gsndesign:Query ;
    rdfs:label "rules/s03_evidential_relation.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s03_evidential_relation.rq" ;
    gsndesign:fileChecksum "136ca93ad4f8aee65664ad63ee4358a27f9ff578c7f62b94c01e45a8f557b799" ;
    gsndesign:declaresNamespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Solution ,
        gsn:relationshipType ,
        gsn:supportedBy ;
    gsndesign:ruleName "Evidential Relation" ;
    gsndesign:translatesStatement gsndesign:st-0137 ;
    gsndesign:restsOnStatement gsndesign:st-0120 ,
        gsndesign:st-0175 ,
        gsndesign:st-0207 ;
    gsndesign:queryText """# rule:      S3
# name:      Evidential Relation
# section:   Core GSN
# operation: rule
# expect:    insert
# swrl:      Solution(?B) ^ 'supported by'(?A, ?B) ^ rdf:subject(?R, ?A) ^ rdf:object(?R, ?B) ->
#            'relationship type'(?R, "evidential")
# reads:     IF B is a Solution AND A is supported by B AND R has subject A AND R has object B
#            THEN R is an evidential relationship

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DELETE { ?R gsn:relationshipType ?old }
INSERT { ?R gsn:relationshipType "evidential" }
WHERE {
  ?B a gsn:Solution .
  ?A gsn:supportedBy ?B .
  ?R rdf:subject ?A ;
     rdf:object ?B .
  OPTIONAL { ?R gsn:relationshipType ?old }
  FILTER(!BOUND(?old) || ?old != "evidential")
}
""" .

gsndesign:query-rules-s04-inferential-relation
    a gsndesign:Query ;
    rdfs:label "rules/s04_inferential_relation.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s04_inferential_relation.rq" ;
    gsndesign:fileChecksum "70d11bb3e28c9343c21ea81c214e046922b57628ab2a2458e88f52e251de34bc" ;
    gsndesign:declaresNamespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Strategy ,
        gsn:relationshipType ,
        gsn:supportedBy ;
    gsndesign:ruleName "Inferential Relation" ;
    gsndesign:translatesStatement gsndesign:st-0142 ;
    gsndesign:restsOnStatement gsndesign:st-0120 ,
        gsndesign:st-0167 ,
        gsndesign:st-0207 ;
    gsndesign:queryText """# rule:      S4
# name:      Inferential Relation
# section:   Core GSN
# operation: rule
# expect:    insert
# swrl:      Strategy(?B) ^ 'supported by'(?A, ?B) ^ rdf:subject(?R, ?A) ^ rdf:object(?R, ?B) ->
#            'relationship type'(?R, "inferential")
# reads:     IF B is a Strategy AND A is supported by B AND R has subject A AND R has object B
#            THEN R is an inferential relationship

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DELETE { ?R gsn:relationshipType ?old }
INSERT { ?R gsn:relationshipType "inferential" }
WHERE {
  ?B a gsn:Strategy .
  ?A gsn:supportedBy ?B .
  ?R rdf:subject ?A ;
     rdf:object ?B .
  OPTIONAL { ?R gsn:relationshipType ?old }
  FILTER(!BOUND(?old) || ?old != "inferential")
}
""" .

gsndesign:query-rules-s05-inferential-relation-goal
    a gsndesign:Query ;
    rdfs:label "rules/s05_inferential_relation_goal.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s05_inferential_relation_goal.rq" ;
    gsndesign:fileChecksum "b2775331f9d1465575aa5df193570f5cf66234277e5c2a62f45ad6ad3b647358" ;
    gsndesign:declaresNamespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:relationshipType ,
        gsn:supportedBy ;
    gsndesign:ruleName "Inferential Relation (Goal)" ;
    gsndesign:translatesStatement gsndesign:st-0143 ;
    gsndesign:restsOnStatement gsndesign:st-0120 ,
        gsndesign:st-0161 ,
        gsndesign:st-0207 ;
    gsndesign:queryText """# rule:      S5
# name:      Inferential Relation (Goal)
# section:   Core GSN
# operation: rule
# expect:    insert
# swrl:      'supported by'(?A, ?B) ^ rdf:subject(?R, ?A) ^ rdf:object(?R, ?B) ^ Goal(?B) ->
#            'relationship type'(?R, "inferential")
# reads:     IF B is a Goal AND A is supported by B AND R has subject A AND R has object B THEN R
#            is an inferential relationship

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DELETE { ?R gsn:relationshipType ?old }
INSERT { ?R gsn:relationshipType "inferential" }
WHERE {
  ?B a gsn:Goal .
  ?A gsn:supportedBy ?B .
  ?R rdf:subject ?A ;
     rdf:object ?B .
  OPTIONAL { ?R gsn:relationshipType ?old }
  FILTER(!BOUND(?old) || ?old != "inferential")
}
""" .

gsndesign:query-rules-s06-goal-top-flag
    a gsndesign:Query ;
    rdfs:label "rules/s06_goal_top_flag.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s06_goal_top_flag.rq" ;
    gsndesign:fileChecksum "092563c3216778aaad4d3856dd9f20488cdfa3aba0f9cddc952d3a12f6fca0b2" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:Module ,
        gsn:challenges ,
        gsn:contains ,
        gsn:inModule ,
        gsn:supportedBy ,
        gsn:top ;
    gsndesign:ruleName "Goal Top Flag" ;
    gsndesign:translatesStatement gsndesign:st-0148 ;
    gsndesign:restsOnStatement gsndesign:st-0144 ,
        gsndesign:st-0161 ,
        gsndesign:st-0207 ,
        gsndesign:st-0469 ,
        gsndesign:st-0474 ,
        gsndesign:st-0696 ,
        gsndesign:st-0740 ,
        gsndesign:st-0944 ;
    gsndesign:queryText """# rule:      S6
# name:      Goal Top Flag
# section:   Core GSN
# operation: rule
# expect:    change
# swrl:      'supported by'(?X, ?A) ^ Goal(?A) -> 'top (goal)'(?A, false)
# reads:     IF X is supported by A AND A is a Goal AND X is in scope for A THEN A is NOT a
#            top-level goal; likewise IF A challenges anything THEN A is NOT a top-level goal

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

# ?X is a Goal or a Strategy without saying so: those are the rdfs:domain of gsn:supportedBy.
# A strategy parent counts, which is the whole point - a goal reached through a strategy is
# not the pinnacle claim, and the earlier form of this rule missed every one of them.
#
# A parent counts only when it is IN SCOPE. The top goal is the pinnacle claim of an
# argument, not of the whole store, so an away goal reached from another module stays the top
# goal of its own module: a parent is discounted exactly when some module holds the parent and
# not the goal. Written as containment rather than gsn:inModule so that the rule does not
# depend on S53 and S54 having run first. With no modules in the graph nothing is ever
# discounted, which is the unscoped reading this rule used to have.
#
# A goal that challenges something is never a top goal either. It is the root of a dialectic
# structure, not the overall claim the author is asserting, and nothing supports it precisely
# because it is levied against the argument rather than part of it.
DELETE { ?A gsn:top ?old }
INSERT { ?A gsn:top false }
WHERE {
  ?A a gsn:Goal .
  {
    ?X gsn:supportedBy ?A .
    FILTER NOT EXISTS {
      ?M a gsn:Module .
      ?M gsn:contains+ ?X .
      FILTER NOT EXISTS { ?M gsn:contains+ ?A }
    }
  }
  UNION
  { ?A gsn:challenges ?target }
  OPTIONAL { ?A gsn:top ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsndesign:query-rules-s08-contradictory-goal-truth
    a gsndesign:Query ;
    rdfs:label "rules/s08_contradictory_goal_truth.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s08_contradictory_goal_truth.rq" ;
    gsndesign:fileChecksum "be6df26573c3d9c4d348a15e28820187cb995d266427d0dc764443bdf97c7ee3" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:supportedBy ,
        gsn:true ,
        gsn:valid ;
    gsndesign:ruleName "Contradictory Goal Truth" ;
    gsndesign:translatesStatement gsndesign:st-0239 ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0161 ,
        gsndesign:st-0207 ,
        gsndesign:st-0234 ;
    gsndesign:queryText """# rule:      S8
# name:      Contradictory Goal Truth
# section:   Core GSN
# operation: rule
# expect:    insert
# swrl:      true(?A, false) ^ true(?B, true) ^ 'supported by'(?B, ?A) ^ Goal(?A) -> valid(?B,
#            false)
# reads:     IF A is NOT true AND B is true AND B is supported by A AND A is a Goal THEN B is NOT
#            valid

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?B gsn:valid ?old }
INSERT { ?B gsn:valid false }
WHERE {
  ?A a gsn:Goal ;
     gsn:true ?tA .
  FILTER(STR(?tA) = "false")
  ?B gsn:supportedBy ?A ;
     gsn:true ?tB .
  FILTER(STR(?tB) = "true")
  OPTIONAL { ?B gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsndesign:query-rules-s10-solution-propagation-true
    a gsndesign:Query ;
    rdfs:label "rules/s10_solution_propagation_true.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s10_solution_propagation_true.rq" ;
    gsndesign:fileChecksum "d9d359414893c2b3f99d3d4fcb0c362708c1e2c870ec2c461c7505a4ae217d75" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Assumption ,
        gsn:Solution ,
        gsn:inContextOf ,
        gsn:supportedBy ,
        gsn:true ;
    gsndesign:ruleName "Solution Propagation (True)" ;
    gsndesign:translatesStatement gsndesign:st-0243 ;
    gsndesign:restsOnStatement gsndesign:st-0175 ,
        gsndesign:st-0188 ,
        gsndesign:st-0207 ,
        gsndesign:st-0218 ,
        gsndesign:st-0234 ;
    gsndesign:queryText """# rule:      S10
# name:      Solution Propagation (True)
# section:   Core GSN
# operation: rule
# expect:    insert
# swrl:      Solution(?A) ^ 'supported by'(?B, ?A) ^ true(?A, true) -> true(?B, true)
# reads:     IF A is a Solution AND B is supported by A AND A is true AND no other solution
#            supporting B is untrue or undetermined AND no assumption B sits in the context of
#            is untrue THEN B becomes true
# note:      THE GUARD BELOW IS NOT IN THE SWRL. Support in GSN is a composition: a claim
#            follows only when everything supporting it holds. Expressing "and nothing else
#            supporting it fails" needs negation as failure, which SWRL does not have, so the
#            source rule states the positive half and this translation adds the guard. See
#            NOTES-tbox-corrections.md, Part C. Without it S10 and S11/S13/S16 alternate
#            forever on any claim with mixed support.

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?B gsn:true ?old }
INSERT { ?B gsn:true true }
WHERE {
  ?A a gsn:Solution ;
     gsn:true ?tA .
  FILTER(STR(?tA) = "true")
  ?B gsn:supportedBy ?A .

  # no sibling solution that is untrue, or that has no truth value yet
  FILTER NOT EXISTS {
    ?B gsn:supportedBy ?other .
    ?other a gsn:Solution .
    FILTER NOT EXISTS { ?other gsn:true ?tOther . FILTER(STR(?tOther) = "true") }
  }
  # and nothing S16 would turn false underneath us
  FILTER NOT EXISTS {
    ?B gsn:inContextOf ?asm .
    ?asm a gsn:Assumption ; gsn:true ?tAsm .
    FILTER(STR(?tAsm) = "false")
  }

  OPTIONAL { ?B gsn:true ?old }
  FILTER(!BOUND(?old) || STR(?old) != "true")
}
""" .

gsndesign:query-rules-s11-solution-propagation-false
    a gsndesign:Query ;
    rdfs:label "rules/s11_solution_propagation_false.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s11_solution_propagation_false.rq" ;
    gsndesign:fileChecksum "9f719838865b7570129b57174c5756085d4a725e8b0fa84acf060118d602c888" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Solution ,
        gsn:supportedBy ,
        gsn:true ;
    gsndesign:ruleName "Solution Propagation (False)" ;
    gsndesign:translatesStatement gsndesign:st-0244 ;
    gsndesign:restsOnStatement gsndesign:st-0175 ,
        gsndesign:st-0207 ,
        gsndesign:st-0234 ;
    gsndesign:queryText """# rule:      S11
# name:      Solution Propagation (False)
# section:   Core GSN
# operation: rule
# expect:    insert
# swrl:      Solution(?A) ^ true(?A, false) ^ 'supported by'(?B, ?A) -> true(?B, false)
# reads:     IF A is a Solution AND A is NOT true AND B is supported by A THEN B becomes NOT true

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?B gsn:true ?old }
INSERT { ?B gsn:true false }
WHERE {
  ?A a gsn:Solution ;
     gsn:true ?tA .
  FILTER(STR(?tA) = "false")
  ?B gsn:supportedBy ?A .
  OPTIONAL { ?B gsn:true ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsndesign:query-rules-s12-mixed-support-invalidation
    a gsndesign:Query ;
    rdfs:label "rules/s12_mixed_support_invalidation.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s12_mixed_support_invalidation.rq" ;
    gsndesign:fileChecksum "ce877d80c7823912c91c97d04c12d024d58129a2e00b9c8086df5a0c9a2a425c" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:supportedBy ,
        gsn:valid ;
    gsndesign:ruleName "Mixed Support Invalidation" ;
    gsndesign:translatesStatement gsndesign:st-0245 ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0207 ;
    gsndesign:queryText """# rule:      S12
# name:      Mixed Support Invalidation
# section:   Core GSN
# operation: rule
# expect:    insert
# swrl:      valid(?B, false) ^ valid(?A, true) ^ 'supported by'(?C, ?B) ^ 'supported by'(?C, ?A)
#            -> valid(?C, false)
# reads:     IF B is NOT valid AND A is valid AND C is supported by B and A THEN C is NOT valid

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?C gsn:valid ?old }
INSERT { ?C gsn:valid false }
WHERE {
  ?A gsn:valid ?vA .
  FILTER(STR(?vA) = "true")
  ?B gsn:valid ?vB .
  FILTER(STR(?vB) = "false")
  ?C gsn:supportedBy ?A , ?B .
  OPTIONAL { ?C gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsndesign:query-rules-s14-relation-false-propagation
    a gsndesign:Query ;
    rdfs:label "rules/s14_relation_false_propagation.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s14_relation_false_propagation.rq" ;
    gsndesign:fileChecksum "37b40fd510b7aa5b3770264939f60f3bfde092139178caf03940b6ce91ffa645" ;
    gsndesign:declaresNamespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Relationship ,
        gsn:inContextOf ,
        gsn:true ;
    gsndesign:ruleName "Relation False Propagation" ;
    gsndesign:translatesStatement gsndesign:st-0248 ;
    gsndesign:restsOnStatement gsndesign:st-0218 ,
        gsndesign:st-0234 ,
        gsndesign:st-0291 ;
    gsndesign:queryText """# rule:      S14
# name:      Relation False Propagation
# section:   Core GSN
# operation: rule
# expect:    insert
# swrl:      true(?R, false) ^ rdf:subject(?R, ?A) ^ 'in context of'(?A, ?B) ^ Relationship(?R) ^
#            rdf:object(?R, ?B) -> true(?A, false)
# reads:     IF R is NOT true AND R has subject A and object B AND A is in context of B AND R is
#            a Relationship THEN A is NOT true

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DELETE { ?A gsn:true ?old }
INSERT { ?A gsn:true false }
WHERE {
  ?R a gsn:Relationship ;
     gsn:true ?tR ;
     rdf:subject ?A ;
     rdf:object ?B .
  FILTER(STR(?tR) = "false")
  ?A gsn:inContextOf ?B .
  OPTIONAL { ?A gsn:true ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsndesign:query-rules-s16-assumption-false-propagation
    a gsndesign:Query ;
    rdfs:label "rules/s16_assumption_false_propagation.rq"@en ;
