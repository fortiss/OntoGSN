    gsndesign:mentionsTerm gsn:Module ,
        gsn:contract ,
        gsn:inModule ,
        gsn:supportedBy ,
        gsn:valid ;
    gsndesign:ruleName "Contract Violation Relation" ;
    gsndesign:translatesStatement gsndesign:st-0523 ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0207 ,
        gsndesign:st-0469 ,
        gsndesign:st-0525 ,
        gsndesign:st-0944 ;
    gsndesign:queryText """# rule:      S26
# name:      Contract Violation Relation

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DELETE { ?R gsn:valid ?old }
INSERT { ?R gsn:valid false }
WHERE {
  ?M1 a gsn:Module .
  ?M2 a gsn:Module ;
      gsn:contract ?contract .
  ?A gsn:inModule ?M2 .
  FILTER(STR(?contract) = "true")
  ?A gsn:supportedBy ?M1 .
  ?R rdf:subject ?A ;
     rdf:object ?M1 .
  OPTIONAL { ?R gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

