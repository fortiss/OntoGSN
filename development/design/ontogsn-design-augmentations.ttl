gsndesign:query-read-elements-unreachable-from-top-goal
    a gsndesign:Query ;
    rdfs:label "read_elements_unreachable_from_top_goal.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/read_elements_unreachable_from_top_goal.rq" ;
    gsndesign:fileChecksum "6ed158158f1a7867861a99708045291c01ea3cb3cfe2c52b668e0cd7b63c3a02" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:GSNElement ,
        gsn:Goal ,
        gsn:inContextOf ,
        gsn:refersTo ,
        gsn:statement ,
        gsn:supportedBy ,
        gsn:top ;
    gsndesign:restsOnStatement gsndesign:st-0132 ,
        gsndesign:st-0144 ,
        gsndesign:st-0161 ,
        gsndesign:st-0207 ,
        gsndesign:st-0218 ,
        gsndesign:st-0265 ,
        gsndesign:st-0289 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-11 ;
    gsndesign:queryText """PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

SELECT ?elementId ?type ?statement
WHERE {
  ?element a ?type ;
           schema:identifier ?elementId .
  ?type rdfs:subClassOf* gsn:GSNElement .
  OPTIONAL { ?element gsn:statement ?statement }

  FILTER NOT EXISTS {
    ?top a gsn:Goal ;
         gsn:top ?t .
    FILTER(STR(?t) = "true")
    ?top (gsn:supportedBy|gsn:inContextOf|gsn:refersTo)* ?element .
  }
}
ORDER BY ?elementId
""" .

gsndesign:query-read-evidence-supporting-goal
    a gsndesign:Query ;
    rdfs:label "read_evidence_supporting_goal.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/read_evidence_supporting_goal.rq" ;
    gsndesign:fileChecksum "9754924885e4db88d8f7794481cc5a5f6864c95309b38af4e9dcab0368532fd8" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Solution ,
        gsn:refersTo ,
        gsn:statement ,
        gsn:supportedBy ;
    gsndesign:restsOnStatement gsndesign:st-0175 ,
        gsndesign:st-0207 ,
        gsndesign:st-0265 ,
        gsndesign:st-0289 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-51 ;
    gsndesign:queryText """PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

SELECT DISTINCT ?solutionId ?solutionStatement ?artefactId ?artefactLabel
WHERE {
  VALUES ?goalId { "G1" }

  ?goal schema:identifier ?goalId .
  ?goal gsn:supportedBy+ ?solution .
  ?solution a gsn:Solution ;
            schema:identifier ?solutionId .
  OPTIONAL { ?solution gsn:statement ?solutionStatement }
  OPTIONAL {
    ?solution gsn:refersTo ?artefact .
    ?artefact schema:identifier ?artefactId .
    OPTIONAL { ?artefact rdfs:label ?artefactLabel }
  }
}
ORDER BY ?solutionId
""" .

gsndesign:query-read-goal-support-tree
    a gsndesign:Query ;
    rdfs:label "read_goal_support_tree.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/read_goal_support_tree.rq" ;
    gsndesign:fileChecksum "f4e5e7f368affc6533d9dc1a6cf8482809b0c98518fd7e653a5212f49a670092" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:statement ,
        gsn:supportedBy ;
    gsndesign:restsOnStatement gsndesign:st-0207 ,
        gsndesign:st-0265 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-47 ;
    gsndesign:queryText """PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT ?descendantId ?type ?statement (MIN(?hops) AS ?depth)
WHERE {
  VALUES ?rootId { "G1" }

  ?root schema:identifier ?rootId .
  ?root gsn:supportedBy+ ?descendant .
  ?descendant a ?type ;
              schema:identifier ?descendantId .
  OPTIONAL { ?descendant gsn:statement ?statement }
  {
    SELECT ?root ?descendant (COUNT(?step) AS ?hops)
    WHERE {
      ?root gsn:supportedBy* ?step .
      ?step gsn:supportedBy+ ?descendant .
    }
    GROUP BY ?root ?descendant
  }
}
GROUP BY ?descendantId ?type ?statement
ORDER BY ?depth ?descendantId
""" .

