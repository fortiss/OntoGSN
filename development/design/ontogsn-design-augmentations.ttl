gsndesign:query-rules-s23-cross-module-away-support
    a gsndesign:Query ;
    rdfs:label "rules/s23_cross_module_away_support.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s23_cross_module_away_support.rq" ;
    gsndesign:fileChecksum "e60a7bf1577d62b66727a2324464ef606f544622b5ae1a3ff2699b99fc95e21d" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:away ,
        gsn:inModule ,
        gsn:supportedBy ;
    gsndesign:ruleName "Cross-Module Away Support" ;
    gsndesign:translatesStatement gsndesign:st-1078 ;
    gsndesign:restsOnStatement gsndesign:st-0207 ,
        gsndesign:st-0490 ,
        gsndesign:st-0944 ;
    gsndesign:queryText """# rule:      S23
# name:      Cross-Module Away Support

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?B gsn:away ?old }
INSERT { ?B gsn:away true }
WHERE {
  ?A gsn:inModule ?M .
  ?B gsn:inModule ?N .
  FILTER(?M != ?N)
  ?A gsn:supportedBy ?B .
  OPTIONAL { ?B gsn:away ?old }
  FILTER(!BOUND(?old) || STR(?old) != "true")
}
""" .

