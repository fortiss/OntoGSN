    gsndesign:fileChecksum "115a146d57309af705784647607c9f56657da168d980c5fe76c81601083eb3ce" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Module ,
        gsn:contract ,
        gsn:inModule ,
        gsn:toBeSupportedByContract ,
        gsn:valid ;
    gsndesign:ruleName "Contract Support Invalidation" ;
    gsndesign:translatesStatement gsndesign:st-0550 ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0469 ,
        gsndesign:st-0525 ,
        gsndesign:st-0542 ,
        gsndesign:st-0944 ;
    gsndesign:queryText """# rule:      S28
# name:      Contract Support Invalidation
# section:   Modular Extension
# operation: rule
# expect:    insert
# swrl:      'in module'(?A, ?M) ^ 'to be supported by contract'(?A, true) ^ contract(?M, true) ^
#            Module(?M) -> valid(?A, false)
# reads:     IF Module M contains A AND A is to be supported by contract AND M is under contract
#            THEN A is NOT valid

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?A gsn:valid ?old }
INSERT { ?A gsn:valid false }
WHERE {
  ?M a gsn:Module ;
     gsn:contract ?contract .
  ?A gsn:inModule ?M .
  FILTER(STR(?contract) = "true")
  ?A gsn:toBeSupportedByContract ?flag .
  FILTER(STR(?flag) = "true")
  OPTIONAL { ?A gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsndesign:query-rules-s29-away-goal-invalidation
    a gsndesign:Query ;
    rdfs:label "rules/s29_away_goal_invalidation.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s29_away_goal_invalidation.rq" ;
    gsndesign:fileChecksum "c5c50511b0131a4a6cacb0e1cb122f00867170cda41af1d4f650d667c5ab3a88" ;
    gsndesign:declaresNamespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:away ,
        gsn:inModule ,
        gsn:supportedBy ,
        gsn:valid ;
    gsndesign:ruleName "Away Goal Invalidation" ;
    gsndesign:translatesStatement gsndesign:st-0559 ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0161 ,
        gsndesign:st-0207 ,
        gsndesign:st-0490 ,
        gsndesign:st-0944 ;
    gsndesign:queryText """# rule:      S29
# name:      Away Goal Invalidation
# section:   Modular Extension
# operation: rule
# expect:    insert
# swrl:      rdf:subject(?R, ?G1) ^ Module(?M1) ^ Goal(?G1) ^ rdf:object(?R, ?G2) ^ Module(?M2) ^
#            'supported by'(?G1, ?G2) ^ away(?G1, true) ^ 'in module'(?G1, ?M1) ^ 'in module'(?G2, ?M2)
#            -> valid(?R, false)
# reads:     IF Relationship R links Goal G1 to Goal G2 AND M1 and M2 are Modules AND G1 is a
#            Goal contained in M1 AND G2 is a Goal contained in M2 AND G1 is away and supported
#            by G2 THEN R is NOT valid

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DELETE { ?R gsn:valid ?old }
INSERT { ?R gsn:valid false }
WHERE {
  ?G1 a gsn:Goal ;
      gsn:supportedBy ?G2 ;
      gsn:away ?away .
  FILTER(STR(?away) = "true")
  ?R rdf:subject ?G1 ;
     rdf:object ?G2 .
  ?G1 gsn:inModule ?M1 .
  ?G2 gsn:inModule ?M2 .
  OPTIONAL { ?R gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsndesign:query-rules-s30-contract-activation
    a gsndesign:Query ;
    rdfs:label "rules/s30_contract_activation.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s30_contract_activation.rq" ;
    gsndesign:fileChecksum "028c399754d78407c423aed3117bd7fd79708ad2ff88658b9a3ef744a6280811" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:away ,
        gsn:contract ,
        gsn:inModule ,
        gsn:supportedBy ,
        gsn:toBeSupportedByContract ;
    gsndesign:ruleName "Contract Activation" ;
    gsndesign:translatesStatement gsndesign:st-1080 ;
    gsndesign:restsOnStatement gsndesign:st-0207 ,
        gsndesign:st-0490 ,
        gsndesign:st-0525 ,
        gsndesign:st-0542 ,
        gsndesign:st-0944 ;
    gsndesign:queryText """# rule:      S30
# name:      Contract Activation
# section:   Modular Extension
# operation: rule
# expect:    insert
# swrl:      away(?A, true) ^ 'to be supported by contract'(?A, true) ^ Module(?M1) ^ Module(?M2)
#            ^ 'in module'(?A, ?M1) ^ 'in module'(?B, ?M2) ^ 'supported by'(?A, ?B) ^
#            differentFrom(?M1, ?M2) -> contract(?M2, true)
# reads:     IF A is away and must be supported by contract AND M1 and M2 are Modules AND A is in
#            M1 AND B is in M2 AND A is supported by B AND M1 and M2 are distinct THEN M2 becomes
#            a contract Module

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?M2 gsn:contract ?old }
INSERT { ?M2 gsn:contract true }
WHERE {
  ?A gsn:away ?away ;
     gsn:toBeSupportedByContract ?byContract ;
     gsn:supportedBy ?B .
  FILTER(STR(?away) = "true")
  FILTER(STR(?byContract) = "true")
  ?A gsn:inModule ?M1 .
  ?B gsn:inModule ?M2 .
  FILTER(?M1 != ?M2)
  OPTIONAL { ?M2 gsn:contract ?old }
  FILTER(!BOUND(?old) || STR(?old) != "true")
}
""" .

gsndesign:query-rules-s31-contract-relation-invalidation
    a gsndesign:Query ;
    rdfs:label "rules/s31_contract_relation_invalidation.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s31_contract_relation_invalidation.rq" ;
    gsndesign:fileChecksum "6fb854f6c01944250720917dc8114ee96d621828a414824a5ca62f67a436189e" ;
    gsndesign:declaresNamespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:inModule ,
        gsn:supportedBy ,
        gsn:toBeSupportedByContract ,
        gsn:valid ;
    gsndesign:ruleName "Contract Relation Invalidation" ;
    gsndesign:translatesStatement gsndesign:st-0562 ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0207 ,
        gsndesign:st-0542 ,
        gsndesign:st-0944 ;
    gsndesign:queryText """# rule:      S31
# name:      Contract Relation Invalidation
# section:   Modular Extension
# operation: rule
# expect:    insert
# swrl:      'in module'(?B, ?M) ^ 'in module'(?A, ?M) ^ 'to be supported by contract'(?A, true) ^
#            'supported by'(?A, ?B) ^ rdf:subject(?R, ?A) ^ Module(?M) ^ rdf:object(?R, ?B) ->
#            valid(?R, false)
# reads:     IF Module M contains both A and B AND A is to be supported by contract and is
#            supported by B AND Relationship R links A to B THEN R is NOT valid

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DELETE { ?R gsn:valid ?old }
INSERT { ?R gsn:valid false }
WHERE {
  ?A gsn:inModule ?M .
  ?B gsn:inModule ?M .
  ?A gsn:toBeSupportedByContract ?flag ;
     gsn:supportedBy ?B .
  FILTER(STR(?flag) = "true")
  ?R rdf:subject ?A ;
     rdf:object ?B .
  OPTIONAL { ?R gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsndesign:query-rules-s32-context-consistency
    a gsndesign:Query ;
    rdfs:label "rules/s32_context_consistency.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s32_context_consistency.rq" ;
    gsndesign:fileChecksum "f556f5a729d6c3980671fc3e1ae83333c38f8a2152c4fe171eb29d1db3e40211" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Context ,
        gsn:Goal ,
        gsn:away ,
        gsn:consistentWith ,
        gsn:inContextOf ,
        gsn:supportedBy ;
    gsndesign:ruleName "Context Consistency" ;
    gsndesign:translatesStatement gsndesign:st-0572 ;
    gsndesign:restsOnStatement gsndesign:st-0161 ,
        gsndesign:st-0181 ,
        gsndesign:st-0207 ,
        gsndesign:st-0218 ,
        gsndesign:st-0490 ,
        gsndesign:st-0565 ;
    gsndesign:queryText """# rule:      S32
# name:      Context Consistency
# section:   Modular Extension
# operation: rule
# expect:    insert
# swrl:      'in context of'(?G1, ?C1) ^ 'in context of'(?G2, ?C2) ^ Goal(?G1) ^ Goal(?G2) ^
#            away(?G2, true) ^ 'supported by'(?G1, ?G2) ^ Context(?C2) -> 'consistent with'(?C1,
#            ?C2)
# reads:     IF G1 is in context of C1 AND G2 is in context of C2 AND G1 and G2 are Goals AND G2
#            is away AND G1 is supported by G2 AND C2 is a Context THEN C1 is consistent with C2

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

INSERT { ?C1 gsn:consistentWith ?C2 }
WHERE {
  ?G1 a gsn:Goal ;
      gsn:inContextOf ?C1 ;
      gsn:supportedBy ?G2 .
  ?G2 a gsn:Goal ;
      gsn:inContextOf ?C2 ;
      gsn:away ?away .
  FILTER(STR(?away) = "true")
  ?C2 a gsn:Context .
  FILTER(?C1 != ?C2)
  FILTER NOT EXISTS { ?C1 gsn:consistentWith ?C2 }
}
""" .

gsndesign:query-rules-s33-substitution-invalidation
    a gsndesign:Query ;
    rdfs:label "rules/s33_substitution_invalidation.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s33_substitution_invalidation.rq" ;
    gsndesign:fileChecksum "ab0cab024db6fc0498c6fa5c38c35502d3e9559f3041c95bb820d21470d5caf1" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Justification ,
        gsn:inContextOf ,
        gsn:inModule ,
        gsn:substitutedBy ,
        gsn:valid ;
    gsndesign:ruleName "Substitution Invalidation" ;
    gsndesign:translatesStatement gsndesign:st-1076 ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0194 ,
        gsndesign:st-0218 ,
        gsndesign:st-0574 ,
        gsndesign:st-0944 ;
    gsndesign:queryText """# rule:      S33
# name:      Substitution Invalidation
# section:   Modular Extension
# operation: rule
# expect:    insert
# swrl:      contains(?M2, ?G) ^ Module(?M1) ^ Module(?M2) ^ 'substituted by'(?J, ?G) ^
#            contains(?M1, ?J) ^ Justification(?J) ^ 'in context of'(?E, ?J) ^
#            differentFrom(?M1, ?M2) -> valid(?J, false)
# reads:     IF Module M2 contains Goal G AND M1 and M2 are Modules AND Justification J is
#            substituted by G AND M1 contains J AND J is a Justification AND some element E is in
#            context of J AND M1 and M2 are distinct THEN J is NOT valid

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?J gsn:valid ?old }
INSERT { ?J gsn:valid false }
WHERE {
  ?J gsn:inModule ?M1 .
  ?G gsn:inModule ?M2 .
  FILTER(?M1 != ?M2)
  ?J a gsn:Justification ;
     gsn:substitutedBy ?G .
  ?E gsn:inContextOf ?J .
  OPTIONAL { ?J gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsndesign:query-rules-s34-module-support-propagation
    a gsndesign:Query ;
    rdfs:label "rules/s34_module_support_propagation.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s34_module_support_propagation.rq" ;
    gsndesign:fileChecksum "42a80cf6dc4df37929308c6b9cc2ac383b6b0695c6e3bd7f1743bf12c39a75b5" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:inModule ,
        gsn:supportedBy ;
    gsndesign:ruleName "Module Support Propagation" ;
    gsndesign:translatesStatement gsndesign:st-1082 ;
    gsndesign:restsOnStatement gsndesign:st-0207 ,
        gsndesign:st-0944 ;
    gsndesign:queryText """# rule:      S34
# name:      Module Support Propagation
# section:   Modular Extension
# operation: rule
# expect:    insert
# swrl:      Module(?M1) ^ Module(?M2) ^ 'supported by'(?E1, ?E2) ^ 'in module'(?E1, ?M1) ^
#            contains(?M2, ?E2) ^ differentFrom(?M1, ?M2) -> 'supported by'(?M1, ?M2)
# reads:     IF M1 and M2 are Modules AND E1 in M1 is supported by E2 in M2 AND M1 and M2 are
#            distinct THEN M1 is supported by M2

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

INSERT { ?M1 gsn:supportedBy ?M2 }
WHERE {
  ?E1 gsn:inModule ?M1 .
  ?E2 gsn:inModule ?M2 .
  FILTER(?M1 != ?M2)
  ?E1 gsn:supportedBy ?E2 .
  FILTER NOT EXISTS { ?M1 gsn:supportedBy ?M2 }
}
""" .

gsndesign:query-rules-s35-module-context-propagation
    a gsndesign:Query ;
    rdfs:label "rules/s35_module_context_propagation.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s35_module_context_propagation.rq" ;
    gsndesign:fileChecksum "bc46a4b0820ef46dbea88d2e0a25efe3b61456fecc1005ca0a09e15e63d97e06" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:inContextOf ,
        gsn:inModule ;
    gsndesign:ruleName "Module Context Propagation" ;
    gsndesign:translatesStatement gsndesign:st-1081 ;
    gsndesign:restsOnStatement gsndesign:st-0218 ,
        gsndesign:st-0944 ;
    gsndesign:queryText """# rule:      S35
# name:      Module Context Propagation
# section:   Modular Extension
# operation: rule
# expect:    insert
# swrl:      Module(?M1) ^ Module(?M2) ^ 'in module'(?E1, ?M1) ^ 'in module'(?E2, ?M2) ^ 'in context
#            of'(?E1, ?E2) ^ differentFrom(?M1, ?M2) -> 'in context of'(?M1, ?M2)
# reads:     IF M1 and M2 are Modules AND E1 in M1 is in context of E2 in M2 AND M1 and M2 are
#            distinct THEN M1 is in context of M2

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

INSERT { ?M1 gsn:inContextOf ?M2 }
WHERE {
  ?E1 gsn:inModule ?M1 .
  ?E2 gsn:inModule ?M2 .
  FILTER(?M1 != ?M2)
  ?E1 gsn:inContextOf ?E2 .
  FILTER NOT EXISTS { ?M1 gsn:inContextOf ?M2 }
}
""" .

gsndesign:query-rules-s36-cross-module-support
    a gsndesign:Query ;
    rdfs:label "rules/s36_cross_module_support.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s36_cross_module_support.rq" ;
    gsndesign:fileChecksum "1e8386ce11ae5342f7605265fed326d25ce0b1812baab592052a16b6e33dda60" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Module ,
        gsn:inModule ,
        gsn:supportedBy ;
    gsndesign:ruleName "Cross-Module Support" ;
    gsndesign:translatesStatement gsndesign:st-1083 ;
    gsndesign:restsOnStatement gsndesign:st-0207 ,
        gsndesign:st-0469 ,
        gsndesign:st-0944 ;
    gsndesign:queryText """# rule:      S36
# name:      Cross-Module Support
# section:   Modular Extension
# operation: rule
# expect:    insert
# swrl:      'supported by'(?E1, ?M2) ^ Module(?M1) ^ Module(?M2) ^ 'in module'(?E1, ?M1) ^
#            differentFrom(?M1, ?M2) -> 'supported by'(?M1, ?M2)
# reads:     IF E1 is supported by Module M2 AND M1 and M2 are Modules AND M1 contains E1 AND M1
#            and M2 are distinct THEN M1 is supported by M2

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

INSERT { ?M1 gsn:supportedBy ?M2 }
WHERE {
  ?E1 gsn:inModule ?M1 .
  ?M2 a gsn:Module .
  FILTER(?M1 != ?M2)
  ?E1 gsn:supportedBy ?M2 .
  FILTER NOT EXISTS { ?M1 gsn:supportedBy ?M2 }
}
""" .

gsndesign:query-rules-s38-public-context-propagation
    a gsndesign:Query ;
    rdfs:label "rules/s38_public_context_propagation.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s38_public_context_propagation.rq" ;
    gsndesign:fileChecksum "a45b82184ba34d5ce299d0ed932ca2f63ac38213d546dd25765c4a5c3b4c6849" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:inContextOf ,
        gsn:public ;
    gsndesign:ruleName "Public Context Propagation" ;
    gsndesign:translatesStatement gsndesign:st-0618 ;
    gsndesign:restsOnStatement gsndesign:st-0161 ,
        gsndesign:st-0218 ,
        gsndesign:st-0534 ;
    gsndesign:queryText """# rule:      S38
# name:      Public Context Propagation
# section:   Modular Extension
# operation: rule
# expect:    insert
# swrl:      public(?G, true) ^ 'in context of'(?G, ?C) ^ Goal(?G) -> public(?C, true)
# reads:     IF G is a public Goal AND G is in context of C THEN C is public

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?C gsn:public ?old }
INSERT { ?C gsn:public true }
WHERE {
  ?G a gsn:Goal ;
     gsn:public ?public ;
     gsn:inContextOf ?C .
  FILTER(STR(?public) = "true")
  OPTIONAL { ?C gsn:public ?old }
  FILTER(!BOUND(?old) || STR(?old) != "true")
}
""" .

gsndesign:query-rules-s39-public-contract-invalidation
    a gsndesign:Query ;
    rdfs:label "rules/s39_public_contract_invalidation.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s39_public_contract_invalidation.rq" ;
    gsndesign:fileChecksum "a7f2a96abbba7a16c4ab783290ce600823198a6156003f4128ac851ce335e3ed" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:contract ,
        gsn:inModule ,
        gsn:public ,
        gsn:valid ;
    gsndesign:ruleName "Public Contract Invalidation" ;
    gsndesign:translatesStatement gsndesign:st-0632 ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0525 ,
        gsndesign:st-0534 ,
        gsndesign:st-0944 ;
    gsndesign:queryText """# rule:      S39
# name:      Public Contract Invalidation
# section:   Modular Extension
# operation: rule
# expect:    insert
# swrl:      contract(?C, true) ^ public(?E, true) ^ 'in module'(?E, ?C) -> valid(?E, false)
# reads:     IF C is a contract AND E is public AND C contains E THEN E is NOT valid

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?E gsn:valid ?old }
INSERT { ?E gsn:valid false }
WHERE {
  ?C gsn:contract ?contract .
  ?E gsn:inModule ?C .
  FILTER(STR(?contract) = "true")
  ?E gsn:public ?public .
  FILTER(STR(?public) = "true")
  OPTIONAL { ?E gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsndesign:query-rules-s40-confidence-relation-creation
    a gsndesign:Query ;
    rdfs:label "rules/s40_confidence_relation_creation.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s40_confidence_relation_creation.rq" ;
    gsndesign:fileChecksum "e7acdfd56d256e8d5be3524b1a5e6be02b1875da7936a82770763c23083bef19" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:ArtefactReference ,
        gsn:RelationshipWithConfidence ,
        gsn:assuranceClaimPoint ;
    gsndesign:ruleName "Confidence Relation Creation" ;
    gsndesign:translatesStatement gsndesign:st-1067 ;
    gsndesign:restsOnStatement gsndesign:st-0287 ,
        gsndesign:st-0635 ,
        gsndesign:st-0648 ;
    gsndesign:queryText """# rule:      S40
# name:      Confidence Relation Creation
# section:   Confidence Argument Extension
# operation: rule
# expect:    insert
# swrl:      'assurance claim point'(?A, true) ^ 'Artefact Reference'(?A) ^
#            swrlx:makeOWLThing(?R, ?A) -> 'Relationship with Confidence'(?R) ^ rdf:subject(?R,
#            ?A) ^ 'assurance claim point'(?R, true)
# reads:     IF A is an Artefact Reference marked as an assurance claim point AND we introduce a
#            reified confidence Relationship R for A THEN R is a Relationship with Confidence
#            whose subject is A and which is itself an assurance claim point

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

INSERT {
  ?R a gsn:RelationshipWithConfidence ;
     schema:identifier ?relationshipId ;
     rdf:subject ?A ;
     gsn:assuranceClaimPoint true .
}
WHERE {
  ?A a/rdfs:subClassOf* gsn:ArtefactReference ;
     gsn:assuranceClaimPoint ?acp ;
     schema:identifier ?idA .
  FILTER(STR(?acp) = "true")
  BIND(CONCAT("RC-", ?idA) AS ?relationshipId)
  # the IRI is built from the IRIs of the elements, not from their identifiers,
  # because two elements in different modules may share an identifier
  BIND(CONCAT("RC-", REPLACE(STR(?A), "^.*[#/]", "")) AS ?iriKey)
  BIND(IRI(CONCAT(REPLACE(STR(?A), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?iriKey))) AS ?R)
  FILTER NOT EXISTS {
    ?existing a gsn:RelationshipWithConfidence ;
              rdf:subject ?A .
  }
}
""" .

gsndesign:query-rules-s41-duplicate-acp-identifier-invalidation
    a gsndesign:Query ;
    rdfs:label "rules/s41_duplicate_acp_identifier_invalidation.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s41_duplicate_acp_identifier_invalidation.rq" ;
    gsndesign:fileChecksum "e74ed3f7be93cd760386fc3b3704ebdab2c51bdd0a0f30aefe5d93ed4409aaf7" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:assuranceClaimPoint ,
        gsn:valid ;
    gsndesign:ruleName "Duplicate ACP Identifier Invalidation" ;
    gsndesign:translatesStatement gsndesign:st-1013 ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0635 ;
    gsndesign:queryText """# rule:      S41
# name:      Duplicate ACP Identifier Invalidation
# section:   Confidence Argument Extension
# operation: rule
# expect:    insert
# swrl:      'assurance claim point'(?A, true) ^ 'assurance claim point'(?B, true) ^
#            schema:identifier(?A, ?N) ^ schema:identifier(?B, ?N) ^ differentFrom(?A, ?B)
#            -> valid(?A, false) ^ valid(?B, false)
# reads:     IF A and B are assurance claim points AND A and B have the same schema
#            identifier N AND A and B are distinct THEN A is NOT valid AND B is NOT valid

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

DELETE { ?target gsn:valid ?old }
INSERT { ?target gsn:valid false }
WHERE {
  ?A gsn:assuranceClaimPoint ?acpA .
  ?B gsn:assuranceClaimPoint ?acpB .
  FILTER(STR(?acpA) = "true" && STR(?acpB) = "true")
  ?A schema:identifier ?id .
  ?B schema:identifier ?id .
  FILTER(?A != ?B)
  VALUES ?slot { 1 2 }
  BIND(IF(?slot = 1, ?A, ?B) AS ?target)
  OPTIONAL { ?target gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsndesign:query-rules-s42-strategy-confidence-relation
    a gsndesign:Query ;
    rdfs:label "rules/s42_strategy_confidence_relation.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s42_strategy_confidence_relation.rq" ;
    gsndesign:fileChecksum "948075273ddcf4bff6bf4688c5fd3e11d6d48c1d0a19fac4b6ed09fff6a16c23" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:RelationshipWithConfidence ,
        gsn:Strategy ,
        gsn:associatedWith ,
        gsn:assuranceClaimPoint ,
        gsn:supportedBy ;
    gsndesign:ruleName "Strategy Confidence Relation" ;
    gsndesign:translatesStatement gsndesign:st-1072 ;
    gsndesign:restsOnStatement gsndesign:st-0161 ,
        gsndesign:st-0167 ,
        gsndesign:st-0207 ,
        gsndesign:st-0635 ,
        gsndesign:st-0648 ,
        gsndesign:st-0658 ;
    gsndesign:queryText """# rule:      S42
# name:      Strategy Confidence Relation
# section:   Confidence Argument Extension
# operation: rule
# expect:    insert
# swrl:      'supported by'(?G1, ?S) ^ 'supported by'(?S, ?G2) ^ 'Relationship with
#            Confidence'(?R1) ^ swrlx:makeOWLThing(?R2, ?S, ?G2) ^ Strategy(?S) ^ Goal(?G1) ^
#            Goal(?G2) ^ rdf:object(?R1, ?S) ^ 'associated with'(?R1, ?A) ^ rdf:subject(?R1, ?G1)
#            -> rdf:subject(?R2, ?S) ^ 'Relationship with Confidence'(?R2) ^ rdf:object(?R2, ?G2)
#            ^ 'associated with'(?R2, ?A) ^ 'assurance claim point'(?R2, true)
# reads:     IF Goal G1 is supported by Strategy S AND S is supported by Goal G2 AND there is a
#            Relationship with Confidence R1 from G1 to S associated with A THEN we create a
#            Relationship with Confidence R2 from S to G2 associated with the same A AND mark R2
#            as an assurance claim point

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

INSERT {
  ?R2 a gsn:RelationshipWithConfidence ;
      schema:identifier ?relationshipId ;
      rdf:subject ?S ;
      rdf:predicate gsn:supportedBy ;
      rdf:object ?G2 ;
      gsn:associatedWith ?A ;
      gsn:assuranceClaimPoint true .
}
WHERE {
  ?R1 a gsn:RelationshipWithConfidence ;
      rdf:subject ?G1 ;
      rdf:object ?S ;
      gsn:associatedWith ?A .
  ?G1 a gsn:Goal ;
      gsn:supportedBy ?S .
  ?S a gsn:Strategy ;
     gsn:supportedBy ?G2 ;
     schema:identifier ?idS .
  ?G2 a gsn:Goal ;
      schema:identifier ?idG2 .
  BIND(CONCAT("RC-", ?idS, "-", ?idG2) AS ?relationshipId)
  # the IRI is built from the IRIs of the elements, not from their identifiers,
  # because two elements in different modules may share an identifier
  BIND(CONCAT("RC-", REPLACE(STR(?S), "^.*[#/]", ""), "-", REPLACE(STR(?G2), "^.*[#/]", "")) AS ?iriKey)
  BIND(IRI(CONCAT(REPLACE(STR(?S), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?iriKey))) AS ?R2)
  FILTER NOT EXISTS {
    ?existing a gsn:RelationshipWithConfidence ;
              rdf:subject ?S ;
              rdf:object ?G2 .
  }
}
""" .

gsndesign:query-rules-s43-goal-strategy-confidence
    a gsndesign:Query ;
    rdfs:label "rules/s43_goal_strategy_confidence.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s43_goal_strategy_confidence.rq" ;
    gsndesign:fileChecksum "1e738120291a6e765463e2576a95862e953d77e55d12f814516a5d0170c0c875" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:RelationshipWithConfidence ,
        gsn:Strategy ,
        gsn:associatedWith ,
        gsn:assuranceClaimPoint ,
        gsn:supportedBy ;
    gsndesign:ruleName "Goal-Strategy Confidence" ;
    gsndesign:translatesStatement gsndesign:st-1071 ;
    gsndesign:restsOnStatement gsndesign:st-0161 ,
        gsndesign:st-0167 ,
        gsndesign:st-0207 ,
        gsndesign:st-0635 ,
        gsndesign:st-0648 ,
        gsndesign:st-0658 ;
    gsndesign:queryText """# rule:      S43
# name:      Goal-Strategy Confidence
# section:   Confidence Argument Extension
# operation: rule
# expect:    insert
# swrl:      'supported by'(?G2, ?S) ^ 'Relationship with Confidence'(?R1) ^ rdf:subject(?R1, ?S)
#            ^ 'supported by'(?S, ?G1) ^ swrlx:makeOWLThing(?R2, ?G2, ?S) ^ rdf:object(?R1, ?G1) ^
#            Strategy(?S) ^ Goal(?G1) ^ Goal(?G2) ^ 'associated with'(?R1, ?A) -> 'Relationship
#            with Confidence'(?R2) ^ 'associated with'(?R2, ?A) ^ 'assurance claim point'(?R2,
#            true) ^ rdf:subject(?R2, ?G2) ^ rdf:object(?R2, ?S)
# reads:     IF Goal G2 is supported by Strategy S AND S is supported by Goal G1 AND there is a
#            Relationship with Confidence R1 from S to G1 associated with A THEN we create a
#            Relationship with Confidence R2 from G2 to S associated with the same A AND mark R2
#            as an assurance claim point

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

INSERT {
  ?R2 a gsn:RelationshipWithConfidence ;
      schema:identifier ?relationshipId ;
      rdf:subject ?G2 ;
      rdf:predicate gsn:supportedBy ;
      rdf:object ?S ;
      gsn:associatedWith ?A ;
      gsn:assuranceClaimPoint true .
}
WHERE {
  ?R1 a gsn:RelationshipWithConfidence ;
      rdf:subject ?S ;
      rdf:object ?G1 ;
      gsn:associatedWith ?A .
  ?S a gsn:Strategy ;
     gsn:supportedBy ?G1 ;
     schema:identifier ?idS .
  ?G1 a gsn:Goal .
  ?G2 a gsn:Goal ;
      gsn:supportedBy ?S ;
      schema:identifier ?idG2 .
  BIND(CONCAT("RC-", ?idG2, "-", ?idS) AS ?relationshipId)
  # the IRI is built from the IRIs of the elements, not from their identifiers,
  # because two elements in different modules may share an identifier
  BIND(CONCAT("RC-", REPLACE(STR(?G2), "^.*[#/]", ""), "-", REPLACE(STR(?S), "^.*[#/]", "")) AS ?iriKey)
  BIND(IRI(CONCAT(REPLACE(STR(?G2), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?iriKey))) AS ?R2)
  FILTER NOT EXISTS {
    ?existing a gsn:RelationshipWithConfidence ;
              rdf:subject ?G2 ;
              rdf:object ?S .
  }
}
""" .

gsndesign:query-rules-s44-solution-confidence-relation
    a gsndesign:Query ;
    rdfs:label "rules/s44_solution_confidence_relation.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s44_solution_confidence_relation.rq" ;
    gsndesign:fileChecksum "9375d33627f1e6b9f898b03a67df54c8287c4c0d0fcf6234635704692d5ad2b1" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:RelationshipWithConfidence ,
        gsn:Solution ,
        gsn:associatedWith ,
        gsn:assuranceClaimPoint ,
        gsn:supportedBy ;
    gsndesign:ruleName "Solution Confidence Relation" ;
    gsndesign:translatesStatement gsndesign:st-1069 ;
    gsndesign:restsOnStatement gsndesign:st-0161 ,
        gsndesign:st-0175 ,
        gsndesign:st-0207 ,
        gsndesign:st-0635 ,
        gsndesign:st-0648 ,
        gsndesign:st-0658 ;
    gsndesign:queryText """# rule:      S44
# name:      Solution Confidence Relation
# section:   Confidence Argument Extension
# operation: rule
# expect:    insert
# swrl:      'supported by'(?G, ?S2) ^ Solution(?S1) ^ rdf:object(?R1, ?S1) ^ 'Relationship with
#            Confidence'(?R1) ^ swrlx:makeOWLThing(?R2, ?G, ?S2) ^ 'supported by'(?G, ?S1) ^ Goal(?G)
#            ^ differentFrom(?S1, ?S2) ^ 'associated with'(?R1, ?A) ^ rdf:subject(?R1, ?G) ^
#            Solution(?S2) -> rdf:object(?R2, ?S2) ^ 'Relationship with Confidence'(?R2) ^
#            rdf:subject(?R2, ?G) ^ 'associated with'(?R2, ?A) ^ 'assurance claim point'(?R2,
#            true)
# reads:     IF Goal G is supported by two distinct Solutions S1 and S2 AND there is a
#            Relationship with Confidence R1 from G to S1 associated with A THEN we create a
#            Relationship with Confidence R2 from G to S2 associated with the same A AND mark R2
#            as an assurance claim point

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

INSERT {
  ?R2 a gsn:RelationshipWithConfidence ;
      schema:identifier ?relationshipId ;
      rdf:subject ?G ;
      rdf:predicate gsn:supportedBy ;
      rdf:object ?S2 ;
      gsn:associatedWith ?A ;
      gsn:assuranceClaimPoint true .
}
WHERE {
  ?R1 a gsn:RelationshipWithConfidence ;
      rdf:subject ?G ;
      rdf:object ?S1 ;
      gsn:associatedWith ?A .
  ?G a gsn:Goal ;
     gsn:supportedBy ?S1 , ?S2 ;
     schema:identifier ?idG .
  ?S1 a gsn:Solution .
  ?S2 a gsn:Solution ;
      schema:identifier ?idS2 .
  FILTER(?S1 != ?S2)
  BIND(CONCAT("RC-", ?idG, "-", ?idS2) AS ?relationshipId)
  # the IRI is built from the IRIs of the elements, not from their identifiers,
  # because two elements in different modules may share an identifier
  BIND(CONCAT("RC-", REPLACE(STR(?G), "^.*[#/]", ""), "-", REPLACE(STR(?S2), "^.*[#/]", "")) AS ?iriKey)
  BIND(IRI(CONCAT(REPLACE(STR(?G), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?iriKey))) AS ?R2)
  FILTER NOT EXISTS {
    ?existing a gsn:RelationshipWithConfidence ;
              rdf:subject ?G ;
              rdf:object ?S2 .
  }
}
""" .

gsndesign:query-rules-s45-goal-confidence-relation
    a gsndesign:Query ;
    rdfs:label "rules/s45_goal_confidence_relation.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s45_goal_confidence_relation.rq" ;
    gsndesign:fileChecksum "c542fc6a24264514890eb08c3a5870a0932ee6d140858ac35f06c7a0ec0c6c13" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:RelationshipWithConfidence ,
        gsn:associatedWith ,
        gsn:assuranceClaimPoint ,
        gsn:supportedBy ;
    gsndesign:ruleName "Goal Confidence Relation" ;
    gsndesign:translatesStatement gsndesign:st-1068 ;
    gsndesign:restsOnStatement gsndesign:st-0161 ,
        gsndesign:st-0207 ,
        gsndesign:st-0635 ,
        gsndesign:st-0648 ,
        gsndesign:st-0658 ;
    gsndesign:queryText """# rule:      S45
# name:      Goal Confidence Relation
# section:   Confidence Argument Extension
# operation: rule
# expect:    insert
# swrl:      'supported by'(?G, ?S2) ^ Goal(?S1) ^ rdf:object(?R1, ?S1) ^ 'Relationship with
#            Confidence'(?R1) ^ swrlx:makeOWLThing(?R2, ?G, ?S2) ^ 'supported by'(?G, ?S1) ^
#            Goal(?S2) ^ Goal(?G) ^ differentFrom(?S1, ?S2) ^ 'associated with'(?R1, ?A) ^
#            rdf:subject(?R1, ?G) -> rdf:object(?R2, ?S2) ^ 'Relationship with Confidence'(?R2) ^
#            rdf:subject(?R2, ?G) ^ 'associated with'(?R2, ?A) ^ 'assurance claim point'(?R2,
#            true)
# reads:     IF Goal G is supported by two distinct Goals S1 and S2 AND there is a Relationship
#            with Confidence R1 from G to S1 associated with A THEN we create a Relationship with
#            Confidence R2 from G to S2 associated with the same A AND mark R2 as an assurance
#            claim point

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

INSERT {
  ?R2 a gsn:RelationshipWithConfidence ;
      schema:identifier ?relationshipId ;
      rdf:subject ?G ;
      rdf:predicate gsn:supportedBy ;
      rdf:object ?S2 ;
      gsn:associatedWith ?A ;
      gsn:assuranceClaimPoint true .
}
WHERE {
  ?R1 a gsn:RelationshipWithConfidence ;
      rdf:subject ?G ;
      rdf:object ?S1 ;
      gsn:associatedWith ?A .
  ?G a gsn:Goal ;
     gsn:supportedBy ?S1 , ?S2 ;
     schema:identifier ?idG .
  ?S1 a gsn:Goal .
  ?S2 a gsn:Goal ;
      schema:identifier ?idS2 .
  FILTER(?S1 != ?S2)
  BIND(CONCAT("RC-", ?idG, "-", ?idS2) AS ?relationshipId)
  # the IRI is built from the IRIs of the elements, not from their identifiers,
  # because two elements in different modules may share an identifier
  BIND(CONCAT("RC-", REPLACE(STR(?G), "^.*[#/]", ""), "-", REPLACE(STR(?S2), "^.*[#/]", "")) AS ?iriKey)
  BIND(IRI(CONCAT(REPLACE(STR(?G), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?iriKey))) AS ?R2)
  FILTER NOT EXISTS {
    ?existing a gsn:RelationshipWithConfidence ;
              rdf:subject ?G ;
              rdf:object ?S2 .
  }
}
""" .

gsndesign:query-rules-s46-challenge-defeat
    a gsndesign:Query ;
    rdfs:label "rules/s46_challenge_defeat.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s46_challenge_defeat.rq" ;
    gsndesign:fileChecksum "0a7f4bf2607a40887e01e3d92d28bf68cb73d991d4a87b04420ea014b5e39ec0" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Solution ,
        gsn:challenges ,
        gsn:defeated ,
        gsn:valid ;
    gsndesign:ruleName "Challenge Defeat" ;
    gsndesign:translatesStatement gsndesign:st-0729 ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0175 ,
        gsndesign:st-0696 ,
        gsndesign:st-0699 ,
        gsndesign:st-0740 ;
    gsndesign:queryText """# rule:      S46
# name:      Challenge Defeat
# section:   Dialectic Extension
# operation: rule
# expect:    insert
# swrl:      valid(?S, true) ^ challenges(?S, ?E) ^ Solution(?S) -> defeated(?E, true)
# reads:     IF S is a valid Solution AND S challenges E THEN E is defeated

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?E gsn:defeated ?old }
INSERT { ?E gsn:defeated true }
WHERE {
  ?S a gsn:Solution ;
     gsn:valid ?valid ;
     gsn:challenges ?E .
  FILTER(STR(?valid) = "true")
  OPTIONAL { ?E gsn:defeated ?old }
  FILTER(!BOUND(?old) || STR(?old) != "true")
}
""" .

gsndesign:query-rules-s47-defeated-invalidation
    a gsndesign:Query ;
    rdfs:label "rules/s47_defeated_invalidation.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s47_defeated_invalidation.rq" ;
    gsndesign:fileChecksum "6f77396ae7f820b378ceb4e6ccf74fa3024219daa5015316e787b2fffe1db35c" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:defeated ,
        gsn:valid ;
    gsndesign:ruleName "Defeated Invalidation" ;
    gsndesign:translatesStatement gsndesign:st-0730 ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0699 ;
    gsndesign:queryText """# rule:      S47
# name:      Defeated Invalidation
# section:   Dialectic Extension
# operation: rule
# expect:    insert
# swrl:      defeated(?E, true) -> valid(?E, false)
# reads:     IF E is defeated THEN E is NOT valid

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?E gsn:valid ?old }
INSERT { ?E gsn:valid false }
WHERE {
  ?E gsn:defeated ?defeated .
  FILTER(STR(?defeated) = "true")
  OPTIONAL { ?E gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsndesign:query-rules-s48-challenge-doubt
    a gsndesign:Query ;
    rdfs:label "rules/s48_challenge_doubt.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s48_challenge_doubt.rq" ;
    gsndesign:fileChecksum "bbc230404c06f0b0969a234f9204945d9982f505e72535a0078835620289ef1a" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:challenges ,
        gsn:inDoubt ,
        gsn:true ;
    gsndesign:ruleName "Challenge Doubt" ;
    gsndesign:translatesStatement gsndesign:st-0737 ;
    gsndesign:restsOnStatement gsndesign:st-0161 ,
        gsndesign:st-0234 ,
        gsndesign:st-0696 ,
        gsndesign:st-0731 ,
        gsndesign:st-0740 ;
    gsndesign:queryText """# rule:      S48
# name:      Challenge Doubt
# section:   Dialectic Extension
# operation: rule
# expect:    insert
# swrl:      challenges(?G, ?E) ^ true(?G, true) ^ Goal(?G) -> 'in doubt'(?E, true)
# reads:     IF Goal G challenges E AND G is true THEN E is in doubt

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?E gsn:inDoubt ?old }
INSERT { ?E gsn:inDoubt true }
WHERE {
  ?G a gsn:Goal ;
     gsn:true ?tG ;
     gsn:challenges ?E .
  FILTER(STR(?tG) = "true")
  OPTIONAL { ?E gsn:inDoubt ?old }
  FILTER(!BOUND(?old) || STR(?old) != "true")
}
""" .

gsndesign:query-rules-s49-undeveloped-defeat
    a gsndesign:Query ;
    rdfs:label "rules/s49_undeveloped_defeat.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s49_undeveloped_defeat.rq" ;
    gsndesign:fileChecksum "0fdcbb5cfe29b42d66747c4fa35d10fd3e0a7eb7102bf47903cc91f8bd43d2d5" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:challenges ,
        gsn:defeated ,
        gsn:inDoubt ,
        gsn:undeveloped ;
    gsndesign:ruleName "Undeveloped Defeat" ;
    gsndesign:translatesStatement gsndesign:st-0738 ;
    gsndesign:restsOnStatement gsndesign:st-0161 ,
        gsndesign:st-0200 ,
        gsndesign:st-0696 ,
        gsndesign:st-0699 ,
        gsndesign:st-0731 ,
        gsndesign:st-0740 ;
    gsndesign:queryText """# rule:      S49
# name:      Undeveloped Defeat
# section:   Dialectic Extension
# operation: rule
# expect:    insert
# swrl:      undeveloped(?G, false) ^ challenges(?G, ?E) ^ Goal(?G) ^ 'in doubt'(?E, true) ->
#            defeated(?E, true)
# reads:     IF Goal G challenges E AND G is NOT undeveloped AND E is in doubt THEN E is defeated

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?E gsn:defeated ?old }
INSERT { ?E gsn:defeated true }
WHERE {
  ?G a gsn:Goal ;
     gsn:undeveloped ?undeveloped ;
     gsn:challenges ?E .
  FILTER(STR(?undeveloped) = "false")
  ?E gsn:inDoubt ?doubt .
  FILTER(STR(?doubt) = "true")
  OPTIONAL { ?E gsn:defeated ?old }
  FILTER(!BOUND(?old) || STR(?old) != "true")
}
""" .

gsndesign:query-rules-s50-challenge-relation-creation
    a gsndesign:Query ;
    rdfs:label "rules/s50_challenge_relation_creation.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s50_challenge_relation_creation.rq" ;
    gsndesign:fileChecksum "30429beb5d23b2f88172eef97f0b6d91ab9dee6e40b5190ef5f4b46f21c7aaba" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Relationship ,
        gsn:challenges ,
        gsn:relationshipType ;
    gsndesign:ruleName "Challenge Relation Creation" ;
    gsndesign:translatesStatement gsndesign:st-1073 ;
    gsndesign:restsOnStatement gsndesign:st-0120 ,
        gsndesign:st-0291 ,
        gsndesign:st-0696 ,
        gsndesign:st-0740 ;
    gsndesign:queryText """# rule:      S50
# name:      Challenge Relation Creation
# section:   Dialectic Extension
# operation: rule
# expect:    insert
# swrl:      challenges(?A, ?B) ^ swrlx:makeOWLThing(?R, ?A, ?B) -> rdf:subject(?R, ?A) ^
#            Relationship(?R) ^ rdf:object(?R, ?B) ^ 'relationship type'(?R, dialectic)
# reads:     IF A challenges B AND we reify this challenge as a Relationship R THEN R is a
#            reified Relationship with subject A, object B and the dialectic type

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

INSERT {
  ?R a gsn:Relationship ;
     schema:identifier ?relationshipId ;
     rdf:subject ?A ;
     rdf:predicate gsn:challenges ;
     rdf:object ?B ;
     gsn:relationshipType "dialectic" .
}
WHERE {
  ?A gsn:challenges ?B ;
     schema:identifier ?idA .
  ?B schema:identifier ?idB .
  BIND(CONCAT("R-", ?idA, "-challenges-", ?idB) AS ?relationshipId)
  # the IRI is built from the IRIs of the elements, not from their identifiers,
  # because two elements in different modules may share an identifier
  BIND(CONCAT("R-", REPLACE(STR(?A), "^.*[#/]", ""), "-challenges-", REPLACE(STR(?B), "^.*[#/]", "")) AS ?iriKey)
  BIND(IRI(CONCAT(REPLACE(STR(?A), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?iriKey))) AS ?R)
  FILTER NOT EXISTS {
    ?existing rdf:subject ?A ;
              rdf:predicate gsn:challenges ;
              rdf:object ?B .
  }
}
""" .

gsndesign:query-rules-s51-challenge-chain-invalidation
    a gsndesign:Query ;
    rdfs:label "rules/s51_challenge_chain_invalidation.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s51_challenge_chain_invalidation.rq" ;
    gsndesign:fileChecksum "30da917bc49f4e833cc781c022d2f74e11455a63dfa41c697ff51bea5ba5df05" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:Strategy ,
        gsn:challenges ,
        gsn:supportedBy ,
        gsn:valid ;
    gsndesign:ruleName "Challenge Chain Invalidation" ;
    gsndesign:translatesStatement gsndesign:st-1070 ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0161 ,
        gsndesign:st-0167 ,
        gsndesign:st-0207 ,
        gsndesign:st-0696 ,
        gsndesign:st-0740 ;
    gsndesign:queryText """# rule:      S51
# name:      Challenge Chain Invalidation
# section:   Dialectic Extension
# operation: rule
# expect:    insert
# swrl:      challenges(?D, ?R) ^ rdf:subject(?R, ?G3) ^ rdf:object(?R, ?G1) ^ Goal(?G1) ^
#            Goal(?G3) ^ swrlx:makeOWLThing(?S, ?G3) ^ Goal(?G2) ^ 'supported by'(?G3, ?G1) ^
#            'supported by'(?G3, ?G2) ^ differentFrom(?G1, ?G2) -> 'supported by'(?S, ?G2) ^
#            'supported by'(?G3, ?S) ^ valid(?D, false) ^ 'supported by'(?S, ?G1) ^
#            challenges(?D, ?S) ^ valid(?S, false) ^ valid(?R, false) ^ Strategy(?S)
# reads:     IF Defeater D challenges Relationship R between Goals G3 (subject) and G1 (object)
#            AND G3 is ALSO supported by a second Goal G2 distinct from G1 AND we introduce a
#            Strategy S for G3 THEN Strategy S is supported by G1 and G2 AND G3 is supported by S
#            AND D now challenges S AND D, S and R are all marked NOT valid
#
# The inference between a goal and its supporting goals is indivisible, so a challenge aimed at
# one SupportedBy link where the goal has several is not a challenge that can be made; the
# standard says such a challenge requires a strategy to be inserted (1:6.3.12, page 54). ?G2 is
# therefore a sibling supporter of ?G3, not any goal in the store. Without the supportedBy(?G3,
# ?G2) atom it was unconstrained, and the rule attached the new strategy to every other goal.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

DELETE {
  ?D gsn:valid ?oldD .
  ?R gsn:valid ?oldR .
}
INSERT {
  ?S a gsn:Strategy ;
     schema:identifier ?strategyId ;
     gsn:supportedBy ?G1 , ?G2 ;
     gsn:valid false .
  ?G3 gsn:supportedBy ?S .
  ?D gsn:challenges ?S ;
     gsn:valid false .
  ?R gsn:valid false .
}
WHERE {
  ?D gsn:challenges ?R .
  ?R rdf:subject ?G3 ;
     rdf:object ?G1 .
  ?G1 a gsn:Goal .
  ?G3 a gsn:Goal ;
      gsn:supportedBy ?G1 ;
      schema:identifier ?idG3 .
  ?G3 gsn:supportedBy ?G2 .
  ?G2 a gsn:Goal .
  FILTER(?G1 != ?G2)
  BIND(CONCAT("St-", ?idG3, "-rebutted") AS ?strategyId)
  # the IRI is built from the IRIs of the elements, not from their identifiers,
  # because two elements in different modules may share an identifier
  BIND(CONCAT("St-", REPLACE(STR(?G3), "^.*[#/]", ""), "-rebutted") AS ?iriKey)
  BIND(IRI(CONCAT(REPLACE(STR(?G3), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?iriKey))) AS ?S)
  OPTIONAL { ?D gsn:valid ?oldD }
  OPTIONAL { ?R gsn:valid ?oldR }
  FILTER NOT EXISTS { ?G3 gsn:supportedBy ?S }
}
""" .

gsndesign:query-rules-s52-defeater-declaration
    a gsndesign:Query ;
    rdfs:label "rules/s52_defeater_declaration.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s52_defeater_declaration.rq" ;
    gsndesign:fileChecksum "dbeeb2e321f40ed231e79f121e82dad4149808829fa6060e383a98e60307a6e4" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Defeater ,
        gsn:challenges ;
    gsndesign:ruleName "Defeater Declaration" ;
    gsndesign:translatesStatement gsndesign:st-0766 ;
    gsndesign:restsOnStatement gsndesign:st-0696 ,
        gsndesign:st-0740 ,
        gsndesign:st-0760 ;
    gsndesign:queryText """# rule:      S52
# name:      Defeater Declaration
# section:   Dialectic Extension
# operation: rule
# expect:    insert
# swrl:      challenges(?A, ?B) -> Defeater(?A)
# reads:     IF A challenges B THEN A is a Defeater

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

INSERT { ?A a gsn:Defeater }
WHERE {
  ?A gsn:challenges ?B .
  FILTER NOT EXISTS { ?A a gsn:Defeater }
}
""" .

gsndesign:query-rules-s53-module-membership
    a gsndesign:Query ;
    rdfs:label "rules/s53_module_membership.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s53_module_membership.rq" ;
    gsndesign:fileChecksum "022d4c800a27efdb6b6502b797e3f0bd4c67253751449c6a9c950ced8131ef4c" ;
    gsndesign:declaresNamespace "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Argument ,
        gsn:GSNElement ,
        gsn:Module ,
        gsn:contains ,
        gsn:inModule ;
    gsndesign:ruleName "Module Membership" ;
    gsndesign:translatesStatement gsndesign:st-0962 ;
    gsndesign:restsOnStatement gsndesign:st-0085 ,
        gsndesign:st-0132 ,
        gsndesign:st-0469 ,
        gsndesign:st-0474 ,
        gsndesign:st-0944 ;
    gsndesign:queryText """# rule:      S53
# name:      Module Membership
# section:   Modular Extension
# operation: rule
# expect:    insert
# swrl:      Module(?M) ^ contains(?M, ?Arg) ^ Argument(?Arg) ^ contains(?Arg, ?E) ^
#            GSNElement(?E) -> 'in module'(?E, ?M)
# reads:     IF M is a Module AND M contains Argument Arg AND Arg contains GSN element E THEN E
#            is in module M

PREFIX gsn:  <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# A module contains arguments and other modules, never elements directly, so the module an
# element belongs to is always two steps away. Every rule of the Modular Extension needs that
# traversal, so it is derived once here and stated in one atom everywhere else.
INSERT { ?E gsn:inModule ?M }
WHERE {
  ?M a gsn:Module ;
     gsn:contains ?Arg .
  ?Arg a gsn:Argument ;
       gsn:contains ?E .
  ?E a/rdfs:subClassOf* gsn:GSNElement .
  FILTER NOT EXISTS { ?E gsn:inModule ?M }
}
""" .

gsndesign:query-rules-s54-nested-module-membership
    a gsndesign:Query ;
    rdfs:label "rules/s54_nested_module_membership.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s54_nested_module_membership.rq" ;
    gsndesign:fileChecksum "88eb75622173d6954f7b43fc65fdf88775b15c49cf243790742d8162e4628880" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Module ,
        gsn:contains ,
        gsn:inModule ;
    gsndesign:ruleName "Nested Module Membership" ;
    gsndesign:translatesStatement gsndesign:st-0963 ;
    gsndesign:restsOnStatement gsndesign:st-0469 ,
        gsndesign:st-0474 ,
        gsndesign:st-0944 ;
    gsndesign:queryText """# rule:      S54
# name:      Nested Module Membership
# section:   Modular Extension
# operation: rule
# expect:    insert
# swrl:      Module(?M) ^ contains(?M, ?N) ^ Module(?N) ^ 'in module'(?E, ?N) ->
#            'in module'(?E, ?M)
# reads:     IF M is a Module AND M contains Module N AND E is in module N THEN E is also in
#            module M

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

# A module may contain other modules, so membership carries upward. Applied to a fixpoint by
# ontology/example/run_rules.py this reaches any depth of nesting; on its own it advances one level, which
# is why its trigger in rule_cases.ttl states the inner membership S53 would otherwise derive.
INSERT { ?E gsn:inModule ?M }
WHERE {
  ?M a gsn:Module ;
     gsn:contains ?N .
  ?N a gsn:Module .
  ?E gsn:inModule ?N .
  FILTER NOT EXISTS { ?E gsn:inModule ?M }
}
""" .

gsndesign:query-rules-s55-support-closure
    a gsndesign:Query ;
    rdfs:label "rules/s55_support_closure.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s55_support_closure.rq" ;
    gsndesign:fileChecksum "5072aa8b102fc42030817e0da0a47c2dd3851d179d85b4c7596897e0342abc69" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:supportedBy ,
        gsn:transitivelySupportedBy ;
    gsndesign:ruleName "Support Closure" ;
    gsndesign:translatesStatement gsndesign:st-1040 ;
    gsndesign:restsOnStatement gsndesign:st-0207 ,
        gsndesign:st-1023 ;
    gsndesign:queryText """# rule:      S55
# name:      Support Closure
# section:   Core GSN
# operation: rule
# expect:    insert
# swrl:      'supported by'(?A, ?B) -> 'transitively supported by'(?A, ?B)
# reads:     IF A is supported by B THEN A is transitively supported by B
# note:      The SWRL rule states one step and leaves the chain to owl:TransitiveProperty.
#            SPARQL has no such axiom, so the property path inserts the whole chain at once.

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

INSERT { ?A gsn:transitivelySupportedBy ?B }
WHERE {
  ?A gsn:supportedBy+ ?B .
  FILTER NOT EXISTS { ?A gsn:transitivelySupportedBy ?B }
}
""" .

gsndesign:query-rules-s56-support-cycle-invalidation
    a gsndesign:Query ;
    rdfs:label "rules/s56_support_cycle_invalidation.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s56_support_cycle_invalidation.rq" ;
    gsndesign:fileChecksum "ebd2aa9bd5e10baf0a8425f70eefb74e22277d8aa30e44c65b3b62587ee22547" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:transitivelySupportedBy ,
        gsn:valid ;
    gsndesign:ruleName "Support Cycle Invalidation" ;
    gsndesign:translatesStatement gsndesign:st-1041 ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-1023 ;
    gsndesign:queryText """# rule:      S56
# name:      Support Cycle Invalidation
# section:   Core GSN
# operation: rule
# expect:    insert
# swrl:      'transitively supported by'(?E, ?E) -> valid(?E, false)
# reads:     IF E is transitively supported by itself THEN E is NOT valid

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?E gsn:valid ?old }
INSERT { ?E gsn:valid false }
WHERE {
  ?E gsn:transitivelySupportedBy ?E .
  OPTIONAL { ?E gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsndesign:query-rules-s57-support-cycle-relationship-invalidation
    a gsndesign:Query ;
    rdfs:label "rules/s57_support_cycle_relationship_invalidation.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s57_support_cycle_relationship_invalidation.rq" ;
    gsndesign:fileChecksum "b401c97aab8bcd2e5aaddd2038eb738f729ae0e77beb37ce39a9c8311b30c633" ;
    gsndesign:declaresNamespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Relationship ,
        gsn:supportedBy ,
        gsn:transitivelySupportedBy ,
        gsn:valid ;
    gsndesign:ruleName "Support Cycle Relationship Invalidation" ;
    gsndesign:translatesStatement gsndesign:st-1042 ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0207 ,
        gsndesign:st-0291 ,
        gsndesign:st-1023 ;
    gsndesign:queryText """# rule:      S57
# name:      Support Cycle Relationship Invalidation
# section:   Core GSN
# operation: rule
# expect:    insert
# swrl:      Relationship(?R) ^ rdf:subject(?R, ?A) ^ rdf:object(?R, ?B) ^ 'supported by'(?A,
#            ?B) ^ 'transitively supported by'(?B, ?A) -> valid(?R, false)
# reads:     IF R is a Relationship from A to B AND A is supported by B AND B is transitively
#            supported by A THEN R is NOT valid

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DELETE { ?R gsn:valid ?old }
INSERT { ?R gsn:valid false }
WHERE {
  ?R a gsn:Relationship ;
     rdf:subject ?A ;
     rdf:object ?B .
  ?A gsn:supportedBy ?B .
  ?B gsn:transitivelySupportedBy ?A .
  OPTIONAL { ?R gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsndesign:query-rules-s58-module-context-closure
    a gsndesign:Query ;
    rdfs:label "rules/s58_module_context_closure.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s58_module_context_closure.rq" ;
    gsndesign:fileChecksum "64ac6de11070145232274205a84296854abf18379875fdb8b0a0bb75afee06ca" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Module ,
        gsn:inContextOf ,
        gsn:transitivelyInContextOf ;
    gsndesign:ruleName "Module Context Closure" ;
    gsndesign:translatesStatement gsndesign:st-1043 ;
    gsndesign:restsOnStatement gsndesign:st-0218 ,
        gsndesign:st-0469 ,
        gsndesign:st-1028 ;
    gsndesign:queryText """# rule:      S58
# name:      Module Context Closure
# section:   Modular Extension
# operation: rule
# expect:    insert
# swrl:      Module(?A) ^ Module(?B) ^ 'in context of'(?A, ?B) -> 'transitively in context
#            of'(?A, ?B)
# reads:     IF A and B are Modules AND A is in the context of B THEN A is transitively in the
#            context of B
# note:      The SWRL rule states one step and leaves the chain to owl:TransitiveProperty.
#            SPARQL has no such axiom, so the property path inserts the whole chain at
#            once. The path runs through modules only. A module is the only class in both
#            the domain and the range of gsn:inContextOf, so every node inside a chain of
#            in-context-of links between two modules is a module.

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

INSERT { ?A gsn:transitivelyInContextOf ?B }
WHERE {
  ?A a gsn:Module .
  ?B a gsn:Module .
  ?A gsn:inContextOf+ ?B .
  FILTER NOT EXISTS { ?A gsn:transitivelyInContextOf ?B }
}
""" .

