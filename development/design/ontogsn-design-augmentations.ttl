        gsndesign:st-0658 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-02 ;
    gsndesign:queryText """PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

SELECT ?relationshipId ?subjectId ?objectId ?confidenceArgumentId ?confidenceStatement
WHERE {
  ?relationship gsn:assuranceClaimPoint ?acp ;
                schema:identifier ?relationshipId .
  FILTER(STR(?acp) = "true")
  OPTIONAL { ?relationship rdf:subject ?subject . ?subject schema:identifier ?subjectId }
  OPTIONAL { ?relationship rdf:object  ?object  . ?object  schema:identifier ?objectId }
  OPTIONAL {
    ?relationship gsn:associatedWith ?argument .
    ?argument schema:identifier ?confidenceArgumentId .
    OPTIONAL { ?argument gsn:statement ?confidenceStatement }
  }
}
ORDER BY ?relationshipId
""" .

gsndesign:query-read-away-elements
    a gsndesign:Query ;
