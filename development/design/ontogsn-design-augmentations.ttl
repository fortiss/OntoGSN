    gsndesign:path "ontology/queries/rules/s16_assumption_false_propagation.rq" ;
    gsndesign:fileChecksum "619637eeca98bf0e19a5e94f09aabacbfa7c5aa7693cdb3778aa502aadf9635e" ;
