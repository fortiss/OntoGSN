        gsn:valid ;
    gsndesign:ruleName "Template Undeveloped Invalidation (A)" ;
    gsndesign:translatesStatement gsndesign:st-0449 ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0200 ,
        gsndesign:st-0438 ,
        gsndesign:st-0444 ;
    gsndesign:queryText """# rule:      S21
# name:      Template Undeveloped Invalidation (A)

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DELETE { ?target gsn:valid ?old }
INSERT { ?target gsn:valid false }
WHERE {
  ?A a gsn:Template ;
     gsn:published ?published .
  FILTER(STR(?published) = "true")
  ?R gsn:undeveloped ?undeveloped ;
     rdf:subject ?A .
  FILTER(STR(?undeveloped) = "true")
  VALUES ?slot { 1 2 }
  BIND(IF(?slot = 1, ?A, ?R) AS ?target)
  OPTIONAL { ?target gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

