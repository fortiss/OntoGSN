        gsn:defeated ,
        gsn:inDoubt ,
        gsn:undeveloped ;
    gsndesign:ruleName "Undeveloped Defeat" ;
    gsndesign:translatesStatement gsndesign:st-0738 ;
    gsndesign:restsOnStatement gsndesign:st-0161 ,
        gsndesign:st-0200 ,
        gsndesign:st-0696 ,
        gsndesign:st-0699 ,
        gsndesign:st-0731 ,
        gsndesign:st-0740 ;
    gsndesign:queryText """# rule:      S49
# name:      Undeveloped Defeat

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?E gsn:defeated ?old }
INSERT { ?E gsn:defeated true }
WHERE {
  ?G a gsn:Goal ;
     gsn:undeveloped ?undeveloped ;
     gsn:challenges ?E .
  FILTER(STR(?undeveloped) = "false")
  ?E gsn:inDoubt ?doubt .
  FILTER(STR(?doubt) = "true")
  OPTIONAL { ?E gsn:defeated ?old }
  FILTER(!BOUND(?old) || STR(?old) != "true")
}
""" .

gsndesign:query-rules-s50-challenge-relation-creation
    a gsndesign:Query ;
    rdfs:label "rules/s50_challenge_relation_creation.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s50_challenge_relation_creation.rq" ;
    gsndesign:fileChecksum "14bf89bda314eb1a31b0152f1c2497ec0b13424630de185070b921688ae901b0" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Relationship ,
        gsn:challenges ,
        gsn:relationshipType ;
    gsndesign:ruleName "Challenge Relation Creation" ;
    gsndesign:translatesStatement gsndesign:st-1073 ;
    gsndesign:restsOnStatement gsndesign:st-0120 ,
        gsndesign:st-0291 ,
        gsndesign:st-0696 ,
        gsndesign:st-0740 ;
    gsndesign:queryText """# rule:      S50
# name:      Challenge Relation Creation

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

INSERT {
  ?R a gsn:Relationship ;
     schema:identifier ?relationshipId ;
     rdf:subject ?A ;
     rdf:predicate gsn:challenges ;
     rdf:object ?B ;
     gsn:relationshipType "dialectic" .
}
WHERE {
  ?A gsn:challenges ?B ;
     schema:identifier ?idA .
  ?B schema:identifier ?idB .
  BIND(CONCAT("R-", ?idA, "-challenges-", ?idB) AS ?relationshipId)
  BIND(CONCAT("R-", REPLACE(STR(?A), "^.*[#/]", ""), "-challenges-", REPLACE(STR(?B), "^.*[#/]", "")) AS ?iriKey)
  BIND(IRI(CONCAT(REPLACE(STR(?A), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?iriKey))) AS ?R)
  FILTER NOT EXISTS {
    ?existing rdf:subject ?A ;
              rdf:predicate gsn:challenges ;
              rdf:object ?B .
  }
}
""" .

gsndesign:query-rules-s51-challenge-chain-invalidation
    a gsndesign:Query ;
    rdfs:label "rules/s51_challenge_chain_invalidation.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s51_challenge_chain_invalidation.rq" ;
    gsndesign:fileChecksum "c2dfd3c4aeedf1eea28da2104ad04eaff98f5d8b68f68a40a11272b2e8b942bc" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:Strategy ,
        gsn:challenges ,
        gsn:supportedBy ,
        gsn:valid ;
    gsndesign:ruleName "Challenge Chain Invalidation" ;
    gsndesign:translatesStatement gsndesign:st-1070 ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0161 ,
        gsndesign:st-0167 ,
        gsndesign:st-0207 ,
        gsndesign:st-0696 ,
        gsndesign:st-0740 ;
    gsndesign:queryText """# rule:      S51
# name:      Challenge Chain Invalidation

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

DELETE {
  ?D gsn:valid ?oldD .
  ?R gsn:valid ?oldR .
}
INSERT {
  ?S a gsn:Strategy ;
     schema:identifier ?strategyId ;
     gsn:supportedBy ?G1 , ?G2 ;
     gsn:valid false .
  ?G3 gsn:supportedBy ?S .
  ?D gsn:challenges ?S ;
     gsn:valid false .
  ?R gsn:valid false .
}
WHERE {
  ?D gsn:challenges ?R .
  ?R rdf:subject ?G3 ;
     rdf:object ?G1 .
  ?G1 a gsn:Goal .
  ?G3 a gsn:Goal ;
      gsn:supportedBy ?G1 ;
      schema:identifier ?idG3 .
  ?G3 gsn:supportedBy ?G2 .
  ?G2 a gsn:Goal .
  FILTER(?G1 != ?G2)
  BIND(CONCAT("St-", ?idG3, "-rebutted") AS ?strategyId)
  BIND(CONCAT("St-", REPLACE(STR(?G3), "^.*[#/]", ""), "-rebutted") AS ?iriKey)
  BIND(IRI(CONCAT(REPLACE(STR(?G3), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?iriKey))) AS ?S)
  OPTIONAL { ?D gsn:valid ?oldD }
  OPTIONAL { ?R gsn:valid ?oldR }
  FILTER NOT EXISTS { ?G3 gsn:supportedBy ?S }
}
""" .

