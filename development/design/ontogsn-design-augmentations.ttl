    gsndesign:ruleName "Cross-Module Away Context" ;
    gsndesign:translatesStatement gsndesign:st-1077 ;
    gsndesign:restsOnStatement gsndesign:st-0218 ,
        gsndesign:st-0490 ,
        gsndesign:st-0944 ;
    gsndesign:queryText """# rule:      S24
# name:      Cross-Module Away Context
# section:   Modular Extension
# operation: rule
# expect:    insert
# swrl:      'in module'(?A, ?M) ^ 'in module'(?B, ?N) ^ Module(?N) ^ 'in context of'(?A, ?B) ^
#            Module(?M) ^ differentFrom(?M, ?N) -> away(?B, true)
# reads:     IF Module M contains A AND Module N contains B AND A is in context of B AND M and N
#            are distinct Modules THEN B is away (in another Module)

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?B gsn:away ?old }
INSERT { ?B gsn:away true }
WHERE {
  ?A gsn:inModule ?M .
  ?B gsn:inModule ?N .
  FILTER(?M != ?N)
  ?A gsn:inContextOf ?B .
  OPTIONAL { ?B gsn:away ?old }
  FILTER(!BOUND(?old) || STR(?old) != "true")
}
""" .

gsndesign:query-rules-s25-duplicate-identifier-invalidation
    a gsndesign:Query ;
    rdfs:label "rules/s25_duplicate_identifier_invalidation.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s25_duplicate_identifier_invalidation.rq" ;
    gsndesign:fileChecksum "5318fb2bacb4d75bc6529b843160619cc7c059511c42b053511cb973f5847c79" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:inModule ,
        gsn:valid ;
    gsndesign:ruleName "Duplicate Identifier Invalidation" ;
    gsndesign:translatesStatement gsndesign:st-1079 ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0944 ;
    gsndesign:queryText """# rule:      S25
# name:      Duplicate Identifier Invalidation
# section:   Modular Extension
# operation: rule
# expect:    insert
# swrl:      'in module'(?B, ?M) ^ 'in module'(?A, ?M) ^ schema:identifier(?A, ?ID) ^ Module(?M) ^
#            differentFrom(?A, ?B) ^ schema:identifier(?B, ?ID) -> valid(?A, false) ^ valid(?B,
#            false)
# reads:     IF Module M contains both A and B AND A and B share the same schema identifier ID
#            AND A and B are distinct THEN A is NOT valid AND B is NOT valid

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

DELETE { ?target gsn:valid ?old }
INSERT { ?target gsn:valid false }
WHERE {
  ?A gsn:inModule ?M .
  ?B gsn:inModule ?M .
  ?A schema:identifier ?id .
  ?B schema:identifier ?id .
  FILTER(?A != ?B)
  VALUES ?slot { 1 2 }
  BIND(IF(?slot = 1, ?A, ?B) AS ?target)
  OPTIONAL { ?target gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsndesign:query-rules-s26-contract-violation-relation
    a gsndesign:Query ;
    rdfs:label "rules/s26_contract_violation_relation.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s26_contract_violation_relation.rq" ;
    gsndesign:fileChecksum "33107bf9d973079520560100478e38d30ec9762183269df02c9f8d1e12771792" ;
    gsndesign:declaresNamespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Module ,
        gsn:contract ,
        gsn:inModule ,
        gsn:supportedBy ,
        gsn:valid ;
    gsndesign:ruleName "Contract Violation Relation" ;
    gsndesign:translatesStatement gsndesign:st-0523 ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0207 ,
        gsndesign:st-0469 ,
        gsndesign:st-0525 ,
        gsndesign:st-0944 ;
    gsndesign:queryText """# rule:      S26
# name:      Contract Violation Relation
# section:   Modular Extension
# operation: rule
# expect:    insert
# swrl:      rdf:object(?R, ?M1) ^ Module(?M1) ^ Module(?M2) ^ 'in module'(?A, ?M2) ^ 'supported
#            by'(?A, ?M1) ^ rdf:subject(?R, ?A) ^ contract(?M2, true) -> valid(?R, false)
# reads:     IF Relationship R has object Module M1 AND M1 and M2 are Modules AND M2 contains A
#            AND A is supported by M1 AND R has subject A AND M2 is under contract THEN R is NOT
#            valid

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DELETE { ?R gsn:valid ?old }
INSERT { ?R gsn:valid false }
WHERE {
  ?M1 a gsn:Module .
  ?M2 a gsn:Module ;
      gsn:contract ?contract .
  ?A gsn:inModule ?M2 .
  FILTER(STR(?contract) = "true")
  ?A gsn:supportedBy ?M1 .
  ?R rdf:subject ?A ;
     rdf:object ?M1 .
  OPTIONAL { ?R gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsndesign:query-rules-s27-context-contract-invalidation
    a gsndesign:Query ;
    rdfs:label "rules/s27_context_contract_invalidation.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s27_context_contract_invalidation.rq" ;
    gsndesign:fileChecksum "7693fd377c48937ac9d20c997ac829f5ba04eb6abf5e9631f675c5ec25ba5b02" ;
    gsndesign:declaresNamespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Module ,
        gsn:contract ,
        gsn:inContextOf ,
        gsn:inModule ,
        gsn:valid ;
    gsndesign:ruleName "Context Contract Invalidation" ;
    gsndesign:translatesStatement gsndesign:st-0524 ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0218 ,
        gsndesign:st-0469 ,
        gsndesign:st-0525 ,
        gsndesign:st-0944 ;
    gsndesign:queryText """# rule:      S27
# name:      Context Contract Invalidation
# section:   Modular Extension
# operation: rule
# expect:    insert
# swrl:      'in context of'(?A, ?M1) ^ rdf:object(?R, ?M1) ^ Module(?M1) ^ Module(?M2) ^
#            'in module'(?A, ?M2) ^ rdf:subject(?R, ?A) ^ contract(?M2, true) -> valid(?R, false)
# reads:     IF A is in context of Module M1 AND Relationship R has object M1 AND M1 and M2 are
#            Modules AND M2 contains A AND R has subject A AND M2 is under contract THEN R is NOT
#            valid

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DELETE { ?R gsn:valid ?old }
INSERT { ?R gsn:valid false }
WHERE {
  ?M1 a gsn:Module .
  ?M2 a gsn:Module ;
      gsn:contract ?contract .
  ?A gsn:inModule ?M2 .
  FILTER(STR(?contract) = "true")
  ?A gsn:inContextOf ?M1 .
  ?R rdf:subject ?A ;
     rdf:object ?M1 .
  OPTIONAL { ?R gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsndesign:query-rules-s28-contract-support-invalidation
    a gsndesign:Query ;
    rdfs:label "rules/s28_contract_support_invalidation.rq"@en ;
