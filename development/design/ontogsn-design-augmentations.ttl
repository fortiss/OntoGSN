gsndesign:query-rules-s17-context-inheritance
    a gsndesign:Query ;
    rdfs:label "rules/s17_context_inheritance.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s17_context_inheritance.rq" ;
    gsndesign:fileChecksum "3938d52ca10ae2e4f4e5e83047b85a6905c1dfadcf009578cbb3a923b4ebb43d" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Assumption ,
        gsn:Goal ,
        gsn:inContextOf ,
        gsn:supportedBy ;
    gsndesign:ruleName "Context Inheritance" ;
    gsndesign:translatesStatement gsndesign:st-0256 ;
    gsndesign:restsOnStatement gsndesign:st-0161 ,
        gsndesign:st-0188 ,
        gsndesign:st-0207 ,
        gsndesign:st-0218 ;
    gsndesign:queryText """# rule:      S17
# name:      Context Inheritance
# section:   Core GSN
# operation: rule
# expect:    insert
# swrl:      'supported by'(?B, ?C) ^ 'in context of'(?B, ?A) ^ Assumption(?A) ^ Goal(?C) -> 'in
#            context of'(?C, ?A)
# reads:     IF B is supported by C AND B is in context of A AND A is an Assumption AND C is a
#            Goal THEN C is in context of A

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

INSERT { ?C gsn:inContextOf ?A }
WHERE {
  ?A a gsn:Assumption .
  ?C a gsn:Goal .
  ?B gsn:supportedBy ?C ;
     gsn:inContextOf ?A .
  FILTER NOT EXISTS { ?C gsn:inContextOf ?A }
}
""" .

gsndesign:query-rules-s18-support-relation-creation
    a gsndesign:Query ;
    rdfs:label "rules/s18_support_relation_creation.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s18_support_relation_creation.rq" ;
    gsndesign:fileChecksum "4d23027aae7d266bf3835ce160e2a0f49b1308d6741df380df30a45d3eff129b" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Relationship ,
        gsn:supportedBy ;
    gsndesign:ruleName "Support Relation Creation" ;
    gsndesign:translatesStatement gsndesign:st-1075 ;
    gsndesign:restsOnStatement gsndesign:st-0207 ,
        gsndesign:st-0291 ;
    gsndesign:queryText """# rule:      S18
# name:      Support Relation Creation
# section:   Core GSN
# operation: rule
# expect:    insert
# swrl:      'supported by'(?A, ?B) ^ swrlx:makeOWLThing(?R, ?A, ?B) -> rdf:subject(?R, ?A) ^
#            Relationship(?R) ^ rdf:object(?R, ?B)
# reads:     IF A is supported by B THEN Create R AND R has subject A and object B

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

INSERT {
  ?R a gsn:Relationship ;
     schema:identifier ?relationshipId ;
     rdf:subject ?A ;
     rdf:predicate gsn:supportedBy ;
     rdf:object ?B .
}
WHERE {
  ?A gsn:supportedBy ?B ;
     schema:identifier ?idA .
  ?B schema:identifier ?idB .
  BIND(CONCAT("R-", ?idA, "-supportedBy-", ?idB) AS ?relationshipId)
  # the IRI is built from the IRIs of the elements, not from their identifiers,
  # because two elements in different modules may share an identifier
  BIND(CONCAT("R-", REPLACE(STR(?A), "^.*[#/]", ""), "-supportedBy-", REPLACE(STR(?B), "^.*[#/]", "")) AS ?iriKey)
  BIND(IRI(CONCAT(REPLACE(STR(?A), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?iriKey))) AS ?R)
  FILTER NOT EXISTS {
    ?existing rdf:subject ?A ;
              rdf:predicate gsn:supportedBy ;
              rdf:object ?B .
  }
}
""" .

gsndesign:query-rules-s19-context-relation-creation
    a gsndesign:Query ;
    rdfs:label "rules/s19_context_relation_creation.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s19_context_relation_creation.rq" ;
    gsndesign:fileChecksum "a1ca4b5e82fc529394b3439a8463c73c979a7dd78adc2414b7bba23ca77bd150" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Relationship ,
        gsn:inContextOf ;
    gsndesign:ruleName "Context Relation Creation" ;
    gsndesign:translatesStatement gsndesign:st-1074 ;
    gsndesign:restsOnStatement gsndesign:st-0218 ,
        gsndesign:st-0291 ;
    gsndesign:queryText """# rule:      S19
# name:      Context Relation Creation
# section:   Core GSN
# operation: rule
# expect:    insert
# swrl:      'in context of'(?A, ?B) ^ swrlx:makeOWLThing(?R, ?A, ?B) -> rdf:subject(?R, ?A) ^
#            Relationship(?R) ^ rdf:object(?R, ?B)
# reads:     IF A is in context of B THEN Create R AND R has subject A and object B

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

INSERT {
  ?R a gsn:Relationship ;
     schema:identifier ?relationshipId ;
     rdf:subject ?A ;
     rdf:predicate gsn:inContextOf ;
     rdf:object ?B .
}
WHERE {
  ?A gsn:inContextOf ?B ;
     schema:identifier ?idA .
  ?B schema:identifier ?idB .
  BIND(CONCAT("R-", ?idA, "-inContextOf-", ?idB) AS ?relationshipId)
  # the IRI is built from the IRIs of the elements, not from their identifiers,
  # because two elements in different modules may share an identifier
  BIND(CONCAT("R-", REPLACE(STR(?A), "^.*[#/]", ""), "-inContextOf-", REPLACE(STR(?B), "^.*[#/]", "")) AS ?iriKey)
  BIND(IRI(CONCAT(REPLACE(STR(?A), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?iriKey))) AS ?R)
  FILTER NOT EXISTS {
    ?existing rdf:subject ?A ;
              rdf:predicate gsn:inContextOf ;
              rdf:object ?B .
  }
}
""" .

gsndesign:query-rules-s20-final-pattern-invalidation
    a gsndesign:Query ;
    rdfs:label "rules/s20_final_pattern_invalidation.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s20_final_pattern_invalidation.rq" ;
    gsndesign:fileChecksum "c9052a30731006d77faca56571b38bdc6328152f674ec6bdbb06b126eac046d0" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Pattern ,
        gsn:contains ,
        gsn:final ,
        gsn:instantiationOf ,
        gsn:valid ;
    gsndesign:ruleName "Final Pattern Invalidation" ;
    gsndesign:translatesStatement gsndesign:st-0310 ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0305 ,
        gsndesign:st-0330 ,
        gsndesign:st-0369 ,
        gsndesign:st-0474 ;
    gsndesign:queryText """# rule:      S20
# name:      Final Pattern Invalidation
# section:   Argument Pattern Extension
# operation: rule
# expect:    insert
# swrl:      'instantiation of'(?B, ?C) ^ final(?A, true) ^ Pattern(?C) ^ contains(?A, ?B) ^
#            contains(?A, ?C) -> valid(?A, false)
# reads:     IF B is an instantiation of Pattern C inside container A AND A is marked final AND A
#            contains both B and C AND C is a Pattern THEN A is NOT valid

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?A gsn:valid ?old }
INSERT { ?A gsn:valid false }
WHERE {
  ?C a gsn:Pattern .
  ?B gsn:instantiationOf ?C .
  ?A gsn:final ?final ;
     gsn:contains ?B , ?C .
  FILTER(STR(?final) = "true")
  OPTIONAL { ?A gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsndesign:query-rules-s21-template-undeveloped-invalidation-a
    a gsndesign:Query ;
    rdfs:label "rules/s21_template_undeveloped_invalidation_a.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s21_template_undeveloped_invalidation_a.rq" ;
    gsndesign:fileChecksum "00dd085415a8aaabf70717a800ee4012d2921d6cd536cca21320553f52202e28" ;
    gsndesign:declaresNamespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Template ,
        gsn:published ,
        gsn:undeveloped ,
        gsn:valid ;
    gsndesign:ruleName "Template Undeveloped Invalidation (A)" ;
    gsndesign:translatesStatement gsndesign:st-0449 ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0200 ,
        gsndesign:st-0438 ,
        gsndesign:st-0444 ;
    gsndesign:queryText """# rule:      S21
# name:      Template Undeveloped Invalidation (A)
# section:   Argument Pattern Extension
# operation: rule
# expect:    insert
# swrl:      Template(?A) ^ undeveloped(?R, true) ^ rdf:subject(?R, ?A) ^ published(?A, true) ->
#            valid(?A, false) ^ valid(?R, false)
# reads:     IF A is a Template AND there is an undeveloped Relation R whose subject is A AND A
#            is published THEN A is NOT valid AND R is NOT valid

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DELETE { ?target gsn:valid ?old }
INSERT { ?target gsn:valid false }
WHERE {
  ?A a gsn:Template ;
     gsn:published ?published .
  FILTER(STR(?published) = "true")
  ?R gsn:undeveloped ?undeveloped ;
     rdf:subject ?A .
  FILTER(STR(?undeveloped) = "true")
  VALUES ?slot { 1 2 }
  BIND(IF(?slot = 1, ?A, ?R) AS ?target)
  OPTIONAL { ?target gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsndesign:query-rules-s22-template-undeveloped-invalidation-b
    a gsndesign:Query ;
