gsndesign:query-update-element-statement
    a gsndesign:Query ;
    rdfs:label "update_element_statement.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/update_element_statement.rq" ;
    gsndesign:fileChecksum "c177ba4cecde245cfbb8048e48d263d23dfff6a154d12255aa12bd110ffe194c" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:statement ;
    gsndesign:restsOnStatement gsndesign:st-0265 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-35 ;
    gsndesign:queryText """# id:        CQ-35
# operation: update
# question:  How is the wording of a claim, strategy or context corrected?
# expect:    change
#
# DELETE then INSERT in one operation, not two: gsn:statement is single-valued in
# practice, and a bare INSERT would leave the element asserting both wordings at once.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

DELETE { ?element gsn:statement ?old }
INSERT { ?element gsn:statement ?new }
WHERE {
  VALUES (?elementId ?new) {                          # PARAMETERS
    ("G1.2" "False positive detections do not lead to unsafe braking demands in any operating mode.")
  }
  ?element schema:identifier ?elementId .
  OPTIONAL { ?element gsn:statement ?old }
}
""" .

gsndesign:query-update-mark-element-invalid
    a gsndesign:Query ;
    rdfs:label "update_mark_element_invalid.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/update_mark_element_invalid.rq" ;
    gsndesign:fileChecksum "02906314d29470cc5b70107fdc6fa598671a3e9b184ced793dd3c2274ffa82a4" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:valid ;
    gsndesign:restsOnStatement gsndesign:st-0114 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-36 ;
    gsndesign:queryText """# id:        CQ-36
# operation: update
# question:  How is a single element marked invalid?
# expect:    change
#
# The flag-setting idiom used by every update below: delete whatever value is there,
# insert the new one, and skip the row entirely if it already says what you want.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

DELETE { ?element gsn:valid ?old }
INSERT { ?element gsn:valid false }
WHERE {
  VALUES ?elementId { "G1.1" }                        # PARAMETER
  ?element schema:identifier ?elementId .
  OPTIONAL { ?element gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsndesign:query-update-retarget-solution-to-new-artefact
    a gsndesign:Query ;
    rdfs:label "update_retarget_solution_to_new_artefact.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/update_retarget_solution_to_new_artefact.rq" ;
    gsndesign:fileChecksum "32ca5229a5433bb3b2ee52c587f9afb54ec6a19b9c29f177ead266ce122edf00" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Artefact ,
        gsn:Solution ,
        gsn:refersTo ;
    gsndesign:restsOnStatement gsndesign:st-0111 ,
        gsndesign:st-0175 ,
        gsndesign:st-0289 ;
    gsndesign:answersQuestion gsndesign:cq-CQ-37 ;
    gsndesign:queryText """# id:        CQ-37
# operation: update
# question:  How is a solution repointed when its evidence is superseded by a new version?
# expect:    change
#
# The re-baselining operation. The solution - the argument's reference - stays put and
# keeps its identifier; only the artefact behind it moves.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

DELETE { ?solution gsn:refersTo ?oldArtefact }
INSERT { ?solution gsn:refersTo ?newArtefact }
WHERE {
  VALUES (?solutionId ?newArtefactId) {               # PARAMETERS
    ("Sn3" "Ev1")
  }
  ?solution a gsn:Solution ;
            schema:identifier ?solutionId .
  ?newArtefact a gsn:Artefact ;
               schema:identifier ?newArtefactId .
  OPTIONAL { ?solution gsn:refersTo ?oldArtefact }
  FILTER(!BOUND(?oldArtefact) || ?oldArtefact != ?newArtefact)
}
""" .


