# GENERATED by development/dev_tools/prov_augment.py. Everything here is recoverable from the
# repository, so unlike ontogsn-design-data.ttl this file is rebuilt, not
# edited. Re-run after adding a query or rebuilding a serialization.

<https://w3id.org/OntoGSN/design/augmentations> a owl:Ontology ;
    owl:imports <https://w3id.org/OntoGSN/design> ;
    dc:title "OntoGSN Design Record - requirements, questions, queries and builds"@en ;
    owl:versionInfo "1.0.0" .


#################################################################
#    Requirements (7)
#    What OntoGSN set out to do, before any of it was built.
#################################################################

gsndesign:req-R1
    a gsndesign:Requirement ;
    rdfs:label "R1"@en ;
    gsndesign:requirementText "User should be capable of performing every aspect in the normative GSN v3 standard with OntoGSN."@en ;
    gsndesign:appliesTo "ontology" ;
    dc:source "GSN Standard"@en .

gsndesign:req-R2
    a gsndesign:Requirement ;
    rdfs:label "R2"@en ;
    gsndesign:requirementText "OntoGSN should represent knowledge about GSN assurance cases in direct conformity with the standard metamodel."@en ;
    gsndesign:appliesTo "ontology" ;
    dc:source "GSN Standard"@en .

gsndesign:req-R3
    a gsndesign:Requirement ;
    rdfs:label "R3"@en ;
    gsndesign:requirementText "OntoGSN should be aligned with the ASCE XML schema."@en ;
    gsndesign:appliesTo "ontology" ;
    dc:source "https://scsc.uk/index.php/tools; feedback"@en .

gsndesign:req-R4
    a gsndesign:Requirement ;
    rdfs:label "R4"@en ;
    gsndesign:requirementText "The user should be able to use OntoGSN as a standalone framework."@en ;
    gsndesign:appliesTo "framework" ,
        "supporting tools" .

gsndesign:req-R5
    a gsndesign:Requirement ;
    rdfs:label "R5"@en ;
    gsndesign:requirementText "The user should be able to use OntoGSN in an accessible manner."@en ;
    gsndesign:appliesTo "framework" ,
        "supporting tools" ;
    dc:source "feedback"@en .

gsndesign:req-R6
    a gsndesign:Requirement ;
    rdfs:label "R6"@en ;
    gsndesign:requirementText "OntoGSN should not duplicate the features provided by existing tools and frameworks (e.g., GUI, imports/exports)."@en ;
    gsndesign:appliesTo "supporting tools" ;
    dc:source "https://scsc.uk/index.php/tools"@en .

gsndesign:req-R7
    a gsndesign:Requirement ;
    rdfs:label "R7"@en ;
    gsndesign:requirementText "The user should have an accessible and easy way to create SPARQL queries based on a case ABox conformant to the OntoGSN TBox."@en ;
    gsndesign:appliesTo "supporting tools" .


#################################################################
#    Competency questions (65)
