        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:associatedWith ,
        gsn:challenges ,
        gsn:inContextOf ,
        gsn:instantiationOf ,
        gsn:refersTo ,
        gsn:statement ,
        gsn:substitutedBy ,
        gsn:supportedBy ;
    gsndesign:restsOnStatement gsndesign:st-0207 ,
