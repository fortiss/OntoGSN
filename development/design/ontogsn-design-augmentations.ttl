    gsndesign:answersQuestion gsndesign:cq-CQ-09 ;
    gsndesign:queryText """PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

SELECT ?element ?type ?label ?statement ?property ?linkedId
WHERE {
  VALUES ?elementId { "G1" }

  ?element schema:identifier ?elementId ;
           a ?type .
  OPTIONAL { ?element rdfs:label ?label }
  OPTIONAL { ?element gsn:statement ?statement }
  OPTIONAL {
    VALUES ?property { gsn:supportedBy gsn:inContextOf gsn:refersTo gsn:challenges
                       gsn:instantiationOf gsn:substitutedBy gsn:associatedWith }
    ?element ?property ?linked .
    ?linked schema:identifier ?linkedId .
  }
}
ORDER BY ?type ?property ?linkedId
""" .

