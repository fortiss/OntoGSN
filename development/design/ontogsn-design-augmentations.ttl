    gsndesign:queryText """# rule:      S45
# name:      Goal Confidence Relation

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
