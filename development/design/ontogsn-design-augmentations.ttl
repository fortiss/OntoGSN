gsndesign:query-rules-s53-module-membership
    a gsndesign:Query ;
    rdfs:label "rules/s53_module_membership.rq"@en ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/s53_module_membership.rq" ;
    gsndesign:fileChecksum "d57097387b23f028e514c8585b8dc40855e89d8b8aadb0a28b6b864958d36f6b" ;
    gsndesign:declaresNamespace "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Argument ,
        gsn:GSNElement ,
        gsn:Module ,
        gsn:contains ,
        gsn:inModule ;
    gsndesign:ruleName "Module Membership" ;
    gsndesign:translatesStatement gsndesign:st-0962 ;
    gsndesign:restsOnStatement gsndesign:st-0085 ,
        gsndesign:st-0132 ,
        gsndesign:st-0469 ,
        gsndesign:st-0474 ,
        gsndesign:st-0944 ;
    gsndesign:queryText """# rule:      S53
# name:      Module Membership

PREFIX gsn:  <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

INSERT { ?E gsn:inModule ?M }
WHERE {
  ?M a gsn:Module ;
     gsn:contains ?Arg .
  ?Arg a gsn:Argument ;
       gsn:contains ?E .
  ?E a/rdfs:subClassOf* gsn:GSNElement .
  FILTER NOT EXISTS { ?E gsn:inModule ?M }
}
""" .

