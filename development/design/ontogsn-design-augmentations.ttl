    gsndesign:fileChecksum "f79abbbdb49688eb7871a9c382f57547368d8f4e42879232ef908b5f49c34e68" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Justification ,
        gsn:inContextOf ,
        gsn:inModule ,
        gsn:substitutedBy ,
        gsn:valid ;
    gsndesign:ruleName "Substitution Invalidation" ;
    gsndesign:translatesStatement gsndesign:st-1076 ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0194 ,
        gsndesign:st-0218 ,
        gsndesign:st-0574 ,
        gsndesign:st-0944 ;
    gsndesign:queryText """# rule:      S33
# name:      Substitution Invalidation

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?J gsn:valid ?old }
INSERT { ?J gsn:valid false }
WHERE {
  ?J gsn:inModule ?M1 .
  ?G gsn:inModule ?M2 .
  FILTER(?M1 != ?M2)
  ?J a gsn:Justification ;
     gsn:substitutedBy ?G .
  ?E gsn:inContextOf ?J .
  OPTIONAL { ?J gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

