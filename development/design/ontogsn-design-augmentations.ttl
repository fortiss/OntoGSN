        gsndesign:st-0696 ,
        gsndesign:st-0731 ,
        gsndesign:st-0740 ;
    gsndesign:queryText """# rule:      S48
# name:      Challenge Doubt

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?E gsn:inDoubt ?old }
INSERT { ?E gsn:inDoubt true }
WHERE {
  ?G a gsn:Goal ;
     gsn:true ?tG ;
     gsn:challenges ?E .
  FILTER(STR(?tG) = "true")
  OPTIONAL { ?E gsn:inDoubt ?old }
  FILTER(!BOUND(?old) || STR(?old) != "true")
}
""" .

