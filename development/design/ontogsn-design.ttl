@prefix gsndesign: <https://w3id.org/OntoGSN/design#> .
@prefix gsn:     <https://w3id.org/OntoGSN/ontology#> .
@prefix gsnsh:   <https://w3id.org/OntoGSN/shapes#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix dc:      <http://purl.org/dc/elements/1.1/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@base <https://w3id.org/OntoGSN/design> .

<https://w3id.org/OntoGSN/design> rdf:type owl:Ontology ;
    owl:imports <http://www.w3.org/ns/prov-o> ;
    dc:title "OntoGSN Design Record"@en ;
    dc:creator "Tomas Bueno Momčilović"@en ;
    dc:publisher "https://www.fortiss.org/"@en ;
    dc:description """Records why each axiom, rule and constraint of OntoGSN exists: which passage of
the GSN Community Standard v3 it came from, what was decided, the reasoning, and what the artefact
said at the time the decision was made. PROV-O supplies the backbone; this vocabulary adds only the
terms PROV-O has no room for.

This ontology describes https://w3id.org/OntoGSN/ontology and https://w3id.org/OntoGSN/shapes but is
deliberately NOT imported by either of them: doing so would drag roughly two thousand design-record
individuals into the ABox of every reasoner run over an assurance case."""@en ;
    dc:source "The Assurance Case Working Group (ACWG). (2021 May). Goal Structuring Notation Community Standard Version 3. URL: http://scsc.uk/SCSC-141C"@en ;
    vann:preferredNamespacePrefix "gsndesign" ;
    owl:versionInfo "1.3.0" ;
    rdfs:seeAlso <https://w3id.org/OntoGSN/ontology> , <https://w3id.org/OntoGSN/shapes> .


#################################################################
#    How an axiom is identified
#################################################################
#
#  Two roles are kept apart, because conflating them is what broke the earlier attempts:
#
#    IDENTITY  - which axiom a record is *about*, stable across re-serialization.
#                gsndesign:structuralKey, the blank-node-free (subject, predicate, object)
#                key produced by development/dev_tools/ttl_model.py and development/dev_tools/shapes_model.py.
#
#    EVIDENCE  - what the axiom literally said when the decision was taken.
#                gsndesign:statementText plus gsndesign:statementChecksum.
#
#  Verbatim text cannot serve as identity: whitespace, operand order and blank-node ids
#  (_:genid83) all change on re-save, and a namespace move once invalidated every record.
#  Structural keys survive all three.
#
#  gsndesign:aboutTerm and gsndesign:mentionsTerm are a THIRD, weaker thing: a direct IRI link
#  into the ontology, for joining the two graphs in SPARQL. They are one-to-many and
#  deliberately not granular - see their definitions below.


#################################################################
#    Classes
#################################################################

###  https://w3id.org/OntoGSN/design#DesignDecision
gsndesign:DesignDecision rdf:type owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "design decision"@en ;
    skos:definition "One recorded act of deciding how - or whether - to represent something in OntoGSN. It prov:used the source passages it was based on and prov:generated the statement it produced."@en ;
    skos:note "Modelled as an Activity rather than an Entity so that a decision to represent nothing is still well-formed: it simply generated no statement. Roughly an eighth of all decisions are of that kind, and PROV-O has no notion of an entity that deliberately does not exist."@en ;
    skos:scopeNote "The IRI local name is the workbook's stable uid (dd-0001). It never changes. gsndesign:positionKey holds the positional row_key, which does."@en .

###  https://w3id.org/OntoGSN/design#RetiredDecision
gsndesign:RetiredDecision rdf:type owl:Class ;
    rdfs:subClassOf gsndesign:DesignDecision ;
    rdfs:label "retired decision"@en ;
    skos:definition "A design decision the ontology has since moved away from. It is retired rather than deleted, because the reasoning remains the record of a real decision."@en ;
    skos:note "Membership of this class is the sole authority on whether a decision is retired; it is not derivable from whether the statement still resolves. Some retired decisions still describe a live axiom, because another decision now documents that axiom - gsndesign:retirementReason says so."@en .

###  https://w3id.org/OntoGSN/design#SourcePassage
gsndesign:SourcePassage rdf:type owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "source passage"@en ;
    skos:definition "A quoted passage of the GSN Community Standard v3, located by clause and page."@en ;
    skos:note "Deduplicated: one passage commonly justifies several axioms, and one axiom commonly rests on several passages. Related to the standard by prov:specializationOf."@en .

###  https://w3id.org/OntoGSN/design#Rationale
gsndesign:Rationale rdf:type owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "rationale"@en ;
    skos:definition "The reasoning for including, excluding or reshaping something - the editorial commentary that neither the standard nor the ontology carries."@en ;
    skos:note "A first-class node rather than a literal on the decision, because the same reasoning is reused across decisions and needs to be addressable and citable."@en .

###  https://w3id.org/OntoGSN/design#StatementRecord
gsndesign:StatementRecord rdf:type owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "statement record"@en ;
    skos:definition "What a decision produced in a formal language: an OWL axiom, a SWRL rule, or a SHACL constraint - held as verbatim text plus a checksum, and identified by a structural key."@en ;
    skos:note "One record per decision that produced something. Records are NOT deduplicated by text: distinct axioms can share a rendering (dc:description and schema:description both render as 'description a AnnotationProperty'), and merging them would lose the distinction."@en .

###  https://w3id.org/OntoGSN/design#FormalGraph
gsndesign:FormalGraph rdf:type owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "formal graph"@en ;
    skos:definition "A released graph that statement records live in - the ontology or the shapes, at a stated version."@en .

###  https://w3id.org/OntoGSN/design#File
gsndesign:File rdf:type owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "file"@en ;
    skos:definition "A file in the repository, identified by its path and fingerprinted by its contents."@en ;
    skos:note "Recorded so that the generated files can say what they were generated from, and by which script. A derived file with no generating activity is a file nobody knows how to rebuild."@en .

###  https://w3id.org/OntoGSN/design#Requirement
gsndesign:Requirement rdf:type owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "requirement"@en ;
    skos:definition "A requirement OntoGSN set itself before any of it was built."@en .

###  https://w3id.org/OntoGSN/design#CompetencyQuestion
gsndesign:CompetencyQuestion rdf:type owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "competency question"@en ;
    skos:definition "A question the ontology is supposed to be able to answer, stated from the point of view of a particular role."@en ;
    skos:note "The test of whether the modelling was worth doing: a competency question with no query that answers it is a claim nobody has checked."@en .

###  https://w3id.org/OntoGSN/design#Query
gsndesign:Query rdf:type owl:Class ;
    rdfs:subClassOf prov:Plan ;
    rdfs:label "query"@en ;
    skos:definition "A stored SPARQL query - a plan for getting an answer out of an assurance case."@en ;
    skos:note "A Plan rather than a plain Entity, because that is what PROV-O calls a specification of how something is to be done."@en .

###  https://w3id.org/OntoGSN/design#QueryVerification
gsndesign:QueryVerification rdf:type owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "query verification"@en ;
    skos:definition "One occasion on which a stored query was executed against the example ABox and found to work: what form it took, what came back, and what it was verified against."@en ;
    skos:note "Recorded rather than recomputed, because re-running every query on every change is the cost this record exists to avoid. gsndesign:verificationKey is what makes that safe: it covers the query, the ontology, the example ABox and the checker's own version, so a key that still matches is a question already answered and a key that no longer matches is an unverified query rather than a failing one."@en ;
    skos:scopeNote "Written by development/dev_tools/query_check.py into development/design/ontogsn-design-queries.ttl. A query with no verification has never been run; a verification whose key is stale describes a state of the repository that no longer exists."@en .


###  https://w3id.org/OntoGSN/design#Formalism
gsndesign:Formalism rdf:type owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "formalism"@en ;
    skos:definition "The language a decision expressed itself in. Everything here is RDF underneath, so the useful distinction is the language layered on top of it."@en .

###  https://w3id.org/OntoGSN/design#StandardPart
gsndesign:StandardPart rdf:type owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "standard part"@en ;
    skos:definition "A top-level division of the GSN Community Standard v3."@en .

###  https://w3id.org/OntoGSN/design#StandardSection
gsndesign:StandardSection rdf:type owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "standard section"@en ;
    skos:definition "A section of the GSN Community Standard v3, or one of the two groupings that sit outside it (ontology-specific statements, preamble)."@en .


#################################################################
#    Object properties
#################################################################

###  https://w3id.org/OntoGSN/design#hasRationale
gsndesign:hasRationale rdf:type owl:ObjectProperty ;
    rdfs:domain gsndesign:DesignDecision ;
    rdfs:range gsndesign:Rationale ;
    rdfs:label "has rationale"@en ;
    skos:definition "The reasoning behind this decision."@en ;
    skos:note "Attached to the decision, which is itself the mapping between a source passage and the statement it produced. That is what makes the rationale reachable from either end: from a statement, follow prov:qualifiedDerivation to prov:hadActivity; from a passage, follow the decisions that prov:used it."@en .

###  https://w3id.org/OntoGSN/design#supersededBy
gsndesign:supersededBy rdf:type owl:ObjectProperty ;
    rdfs:domain gsndesign:RetiredDecision ;
    rdfs:range gsndesign:DesignDecision ;
    rdfs:label "superseded by"@en ;
    skos:definition "The decision that now carries what this one used to record."@en ;
    skos:note "Asserted only where the retirement reason names a successor. Absence means the decision was dropped, not replaced."@en .

###  https://w3id.org/OntoGSN/design#formalism
gsndesign:formalism rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:range gsndesign:Formalism ;
    rdfs:label "formalism"@en ;
    skos:definition "The language a decision expressed itself in, or a stored query is written in."@en ;
    skos:note "On the decision rather than the statement, so that decisions producing no statement can still say which language they declined to work in."@en ;
    skos:note "Carries no rdfs:domain. It applies to a gsndesign:DesignDecision and to a gsndesign:Query, and those two have nothing in common worth naming - a query is a plan, a decision is an activity. Asserting either one as the domain would make a reasoner type the other as it, which is worse than saying nothing: rdfs:domain licenses an inference, it does not impose a constraint. The intended domain is stated here, and ontology/shapes/ is where it would be enforced if it ever needed to be."@en .

###  https://w3id.org/OntoGSN/design#part
gsndesign:part rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain gsndesign:DesignDecision ;
    rdfs:range gsndesign:StandardPart ;
    rdfs:label "part"@en .

###  https://w3id.org/OntoGSN/design#section
gsndesign:section rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain gsndesign:DesignDecision ;
    rdfs:range gsndesign:StandardSection ;
    rdfs:label "section"@en .

###  https://w3id.org/OntoGSN/design#inGraph
gsndesign:inGraph rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain gsndesign:StatementRecord ;
    rdfs:range gsndesign:FormalGraph ;
    rdfs:label "in graph"@en ;
    skos:definition "The released graph this statement belongs to."@en .

###  https://w3id.org/OntoGSN/design#aboutTerm
gsndesign:aboutTerm rdf:type owl:ObjectProperty ;
    rdfs:domain gsndesign:StatementRecord ;
    rdfs:label "about term"@en ;
    skos:definition "The ontology or shapes term this statement is asserted about - the subject of its structural key."@en ;
    skos:note "A direct IRI link into the described graph, for joining the two in SPARQL: 'every decision touching gsn:Goal'. It is deliberately coarse. It names a TERM, never a triple, so it is one-to-many and cannot distinguish two statements about the same subject. It is a convenience, NOT the identity mechanism - gsndesign:structuralKey is. Treat a mismatch as a hint to look, not as evidence of drift."@en ;
    skos:scopeNote "Absent where the subject is anonymous, as it is for a general class axiom or a SWRL rule."@en .

###  https://w3id.org/OntoGSN/design#mentionsTerm
gsndesign:mentionsTerm rdf:type owl:ObjectProperty ;
    rdfs:domain prov:Entity ;
    rdfs:label "mentions term"@en ;
    skos:definition "Every ontology or shapes term appearing anywhere in this statement or query."@en ;
    skos:note "Best-effort and one-to-many, recovered by scanning text. Use it to find candidates - 'what might break if gsn:Solution changes' - never to prove content. The same caveats as gsndesign:aboutTerm apply, more strongly."@en ;
    skos:scopeNote "Domain is prov:Entity rather than gsndesign:StatementRecord because stored queries name ontology terms too, and the same question is asked of them."@en .

###  https://w3id.org/OntoGSN/design#answersQuestion
gsndesign:answersQuestion rdf:type owl:ObjectProperty ;
    rdfs:domain gsndesign:Query ;
    rdfs:range gsndesign:CompetencyQuestion ;
    rdfs:label "answers question"@en ;
    skos:definition "The competency question this query was written to answer."@en .

###  https://w3id.org/OntoGSN/design#translatesStatement
gsndesign:translatesStatement rdf:type owl:ObjectProperty ;
    rdfs:domain gsndesign:Query ;
    rdfs:range gsndesign:StatementRecord ;
    rdfs:label "translates statement"@en ;
    skos:definition "The axiom of the ontology this query is a re-expression of in SPARQL - for the rule queries, the SWRL rule they carry out."@en ;
    skos:note "An exact correspondence, not an approximation: one stored update per SWRL rule, joined on the rule's name. It is what makes the two formalisms comparable - the SWRL rule is what the ontology says, the SPARQL update is what a store with no reasoner can run, and this says they are meant to be the same thing. A query that translates a statement inherits that statement's design decision, and with it the passage of the standard behind the rule."@en ;
    skos:scopeNote "Asserted only where a query re-expresses an axiom. The CRUD queries translate nothing - they ask questions of a case rather than restate what GSN is - and use gsndesign:restsOnStatement instead."@en .

###  https://w3id.org/OntoGSN/design#restsOnStatement
gsndesign:restsOnStatement rdf:type owl:ObjectProperty ;
    rdfs:domain gsndesign:Query ;
    rdfs:range gsndesign:StatementRecord ;
    rdfs:label "rests on statement"@en ;
    skos:definition "An axiom that has to hold for this query to be answerable - the axiom declaring a term the query uses."@en ;
    skos:note "Weaker than gsndesign:translatesStatement and derived rather than curated: for every gsn: term the query names, the axiom that declares that term to be a class or a property. It answers 'which part of the ontology is this query standing on, and why does that part exist?' in one hop, because the declaring axiom carries the design decision, the rationale and the passage of the standard."@en ;
    skos:note "It is deliberately the DECLARATION and not every axiom about the term. A query naming gsn:Goal rests on 'Goal is a class'; it does not rest on every restriction ever written about goals, and linking it to all of them would produce a few thousand edges that say nothing."@en ;
    skos:note "One term may resolve to more than one declaring record, where two ontology terms share a rendering - dc:description and schema:description both read as 'description a AnnotationProperty'. Both are asserted, since the query rests on whichever the store resolves."@en .


#################################################################
#    Datatype properties - the decision
#################################################################

###  https://w3id.org/OntoGSN/design#positionKey
gsndesign:positionKey rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain gsndesign:DesignDecision ;
    rdfs:range xsd:string ;
    rdfs:label "position key"@en ;
    skos:definition "Where this decision sits in the reading order of the standard (S04.R062 = section 4, row 62; S04.SH001 = its first shape)."@en ;
    skos:note "Positional, not identifying. It is renumbered when statements are inserted, so nothing may be keyed on it. The stable identity is the IRI."@en .

###  https://w3id.org/OntoGSN/design#naturalLanguage
gsndesign:naturalLanguage rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain gsndesign:DesignDecision ;
    rdfs:range xsd:string ;
    rdfs:label "natural language"@en ;
    skos:definition "What this decision says, in English, for a reader who does not read Turtle."@en ;
    skos:note "Generated once from the statement by development/dev_tools/nl.py, then STORED and never regenerated, so that wording improved by hand survives. Retired decisions are written in the past tense, since they describe something the ontology no longer has. It is prose about the ontology, not a competing claim - disagreements belong in the rationale."@en .

###  https://w3id.org/OntoGSN/design#nlWrittenFor
gsndesign:nlWrittenFor rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain gsndesign:DesignDecision ;
    rdfs:range xsd:string ;
    rdfs:label "prose written for"@en ;
    skos:definition "The statement checksum the English sentence was written against."@en ;
    skos:note "Kept apart from gsndesign:statementChecksum precisely so the two can disagree. When they do, the axiom changed after the sentence was written and the sentence needs rewriting by hand - it is not something a script should silently resolve."@en .

###  https://w3id.org/OntoGSN/design#retirementReason
gsndesign:retirementReason rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain gsndesign:RetiredDecision ;
    rdfs:range xsd:string ;
    rdfs:label "retirement reason"@en ;
    skos:definition "Why this decision was retired, and where its content went."@en ;
    skos:note "A human judgement, not recoverable by computation, and therefore stored rather than derived."@en .

###  https://w3id.org/OntoGSN/design#noSourceRecorded
gsndesign:noSourceRecorded rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain gsndesign:DesignDecision ;
    rdfs:range xsd:boolean ;
    rdfs:label "no source recorded"@en ;
    skos:definition "True where this decision was checked against the standard and found to rest on no passage of it."@en ;
    skos:note "Distinguishes 'checked, there is none' from 'nobody has looked yet', which is the absence of both this flag and any source passage. Ontology-specific statements and SHACL constraints are the usual bearers."@en .

###  https://w3id.org/OntoGSN/design#noRationaleRecorded
gsndesign:noRationaleRecorded rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain gsndesign:DesignDecision ;
    rdfs:range xsd:boolean ;
    rdfs:label "no rationale recorded"@en ;
    skos:definition "True where this decision was judged to need no reasoning beyond the source passage itself."@en ;
    skos:note "As with gsndesign:noSourceRecorded, this is the deliberate 'none', not the absent 'not yet written'."@en .


#################################################################
#    Datatype properties - the source passage
#################################################################

###  https://w3id.org/OntoGSN/design#quotedText
gsndesign:quotedText rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain gsndesign:SourcePassage ;
    rdfs:range xsd:string ;
    rdfs:label "quoted text"@en ;
    skos:definition "The passage, quoted verbatim from the standard."@en ;
    skos:note "May concatenate several passages and a glossary entry, as the standard states one requirement in more than one place."@en .

###  https://w3id.org/OntoGSN/design#clause
gsndesign:clause rdf:type owl:DatatypeProperty ;
    rdfs:domain gsndesign:SourcePassage ;
    rdfs:range xsd:string ;
    rdfs:label "clause"@en ;
    skos:definition "The clause citation the passage carries, as part:clause - '0:4.3', '1:5.3.1'."@en ;
    skos:note "Repeatable, and recovered from the quoted text rather than recorded separately."@en .

###  https://w3id.org/OntoGSN/design#page
gsndesign:page rdf:type owl:DatatypeProperty ;
    rdfs:domain gsndesign:SourcePassage ;
    rdfs:range xsd:string ;
    rdfs:label "page"@en ;
    skos:definition "A page of the standard the passage appears on."@en ;
    skos:note "Repeatable, one value per page. gsndesign:pageRef holds the same information as it was originally written."@en .

###  https://w3id.org/OntoGSN/design#pageRef
gsndesign:pageRef rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain gsndesign:SourcePassage ;
    rdfs:range xsd:string ;
    rdfs:label "page reference"@en ;
    skos:definition "The page reference exactly as written, separators and all."@en ;
    skos:note "Redundant against gsndesign:page, and kept only so the human-readable workbook can be regenerated character-for-character. Query gsndesign:page instead."@en .


#################################################################
#    Datatype properties - the statement
#################################################################

###  https://w3id.org/OntoGSN/design#statementText
gsndesign:statementText rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain gsndesign:StatementRecord ;
    rdfs:range xsd:string ;
    rdfs:label "statement text"@en ;
    skos:definition "What the axiom said, verbatim, when the decision was taken."@en ;
    skos:note "EVIDENCE, not identity. Rendered blank-node-free, so it survives re-serialization; it is still text, and text varies in ways that do not matter. Identify by gsndesign:structuralKey."@en .

###  https://w3id.org/OntoGSN/design#queryText
gsndesign:queryText rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain gsndesign:Query ;
    rdfs:range xsd:string ;
    rdfs:label "query text"@en ;
    skos:definition "The stored query verbatim, header comments and all, as the file held it."@en ;
    skos:note "The counterpart of gsndesign:statementText, and evidence in the same way: it records what the query said, never which query it is. Identity is gsndesign:path; change is detected by gsndesign:fileChecksum. Held verbatim - including the header, which carries the competency question and the expected outcome - so the record answers what a query asked at a given version without the file having to still exist."@en .

###  https://w3id.org/OntoGSN/design#statementChecksum
gsndesign:statementChecksum rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain gsndesign:StatementRecord ;
    rdfs:range xsd:string ;
    rdfs:label "statement checksum"@en ;
    skos:definition "Fingerprint of gsndesign:statementText - the first eight hex characters of its SHA-1."@en ;
    skos:note "Short by design: it is read by people comparing two rows, not used as a cryptographic commitment."@en .

###  https://w3id.org/OntoGSN/design#structuralKey
gsndesign:structuralKey rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain gsndesign:StatementRecord ;
    rdfs:range xsd:string ;
    rdfs:label "structural key"@en ;
    skos:definition "The identity of the axiom: its subject, predicate and object rendered structurally and without blank-node identifiers, as subject|predicate|object."@en ;
    skos:note "THE identity mechanism. It is what lets a record keep pointing at the same axiom when the file is re-saved, reformatted, or its blank nodes renumbered. Produced by development/dev_tools/ttl_model.py for the ontology and development/dev_tools/shapes_model.py for the shapes."@en .

###  https://w3id.org/OntoGSN/design#ruleName
gsndesign:ruleName rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain gsndesign:StatementRecord ;
    rdfs:range xsd:string ;
    rdfs:label "rule name"@en ;
    skos:definition "The SWRL rule's own name, taken from its rdfs:label in the ontology - 'Assumption Invalidation', 'Cross-Module Support'."@en ;
    skos:note "The descriptive name is the only identifier a rule carries in the ontology: nothing there records the S1 to S52 numbering the rules were catalogued under. That numbering survives in the file names of ontology/queries/rules/, so a rule is joined to its SPARQL translation by name, never by number."@en .

###  https://w3id.org/OntoGSN/design#fileChecksum
gsndesign:fileChecksum rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain prov:Entity ;
    rdfs:range xsd:string ;
    rdfs:label "file checksum"@en ;
    skos:definition "SHA-256 of a file entity's bytes."@en .


#################################################################
#    Datatype properties - files, queries and requirements
#################################################################

###  https://w3id.org/OntoGSN/design#path
gsndesign:path rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain prov:Entity ;
    rdfs:range xsd:string ;
    rdfs:label "path"@en ;
    skos:definition "The file's path, relative to the repository root, with forward slashes."@en .

###  https://w3id.org/OntoGSN/design#declaresNamespace
gsndesign:declaresNamespace rdf:type owl:DatatypeProperty ;
    rdfs:domain prov:Entity ;
    rdfs:range xsd:string ;
    rdfs:label "declares namespace"@en ;
    skos:definition "A namespace this file binds a prefix to."@en ;
    skos:note "Recorded so that a file naming the ontology under the wrong namespace can be found. A query that binds gsn: to something other than the ontology's own IRI silently returns nothing, which is the hardest kind of wrong to notice."@en .

###  https://w3id.org/OntoGSN/design#declaredVersion
gsndesign:declaredVersion rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain prov:Entity ;
    rdfs:range xsd:string ;
    rdfs:label "declared version"@en ;
    skos:definition "The owl:versionInfo the file states for itself."@en ;
    skos:note "Compared against the version of the file it was derived from; a derived file claiming an older version has not been rebuilt."@en .

###  https://w3id.org/OntoGSN/design#requirementText
gsndesign:requirementText rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain gsndesign:Requirement ;
    rdfs:range xsd:string ;
    rdfs:label "requirement text"@en .

###  https://w3id.org/OntoGSN/design#questionText
gsndesign:questionText rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain gsndesign:CompetencyQuestion ;
    rdfs:range xsd:string ;
    rdfs:label "question text"@en .

###  https://w3id.org/OntoGSN/design#role
gsndesign:role rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain gsndesign:CompetencyQuestion ;
    rdfs:range xsd:string ;
    rdfs:label "role"@en ;
    skos:definition "The role in the process that asks this question."@en .

###  https://w3id.org/OntoGSN/design#operation
gsndesign:operation rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain prov:Entity ;
    rdfs:range xsd:string ;
    rdfs:label "operation"@en ;
    skos:definition "Which of create, read, update or delete a stored query performs."@en ;
    skos:note "Kept as the query's own declaration rather than derived from its SPARQL form, because the two can legitimately disagree: inserting a strategy between a goal and its sub-goals is a DELETE/INSERT pair and is still a create."@en .


#################################################################
#    Datatype properties - verifying a query
#################################################################

###  https://w3id.org/OntoGSN/design#verificationKey
gsndesign:verificationKey rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain gsndesign:QueryVerification ;
    rdfs:range xsd:string ;
    rdfs:label "verification key"@en ;
    skos:definition "A hash over everything the verification depended on: the query text, the ontology, the example ABox, and the version of the checker."@en ;
    skos:note "The whole point of recording verifications. Recompute the key and compare: equal means the query has already been verified in exactly this state and need not be run again; different means something it depends on has moved. It deliberately covers the ontology as well as the query, because a query's meaning is made of the terms it names."@en .

###  https://w3id.org/OntoGSN/design#expectation
gsndesign:expectation rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain gsndesign:QueryVerification ;
    rdfs:range xsd:string ;
    rdfs:label "expectation"@en ;
    skos:definition "What the query declares should happen when it runs against the example ABox - rows, empty, insert, delete or change."@en ;
    skos:note "Stated in the query's own header. Without it, verification could only show that a query parses; with it, a query that quietly stops matching anything is a failure rather than a zero."@en .

###  https://w3id.org/OntoGSN/design#resultForm
gsndesign:resultForm rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain gsndesign:QueryVerification ;
    rdfs:range xsd:string ;
    rdfs:label "result form"@en ;
    skos:definition "The SPARQL form the query takes - SELECT, ASK, CONSTRUCT, INSERT, DELETE."@en .

###  https://w3id.org/OntoGSN/design#verificationOutcome
gsndesign:verificationOutcome rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain gsndesign:QueryVerification ;
    rdfs:range xsd:string ;
    rdfs:label "verification outcome"@en ;
    skos:definition "Whether the query passed or failed when it was last executed."@en .

###  https://w3id.org/OntoGSN/design#verifiedWith
gsndesign:verifiedWith rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain gsndesign:QueryVerification ;
    rdfs:range xsd:string ;
    rdfs:label "verified with"@en ;
    skos:definition "The SPARQL engine and version the query was executed on."@en ;
    skos:note "Recorded because 'it executes' is a claim about an engine, not about SPARQL. Engines differ in what they accept, and a query verified on one is evidence about that one."@en .

###  https://w3id.org/OntoGSN/design#rowCount
gsndesign:rowCount rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain gsndesign:QueryVerification ;
    rdfs:range xsd:integer ;
    rdfs:label "row count"@en ;
    skos:definition "How many rows the query returned against the example ABox."@en ;
    skos:note "A number about the fixture, not about any real case. It is worth watching all the same: a count that changes when nobody changed the query is a change in the ontology or the fixture showing through."@en .

###  https://w3id.org/OntoGSN/design#triplesAdded
gsndesign:triplesAdded rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain gsndesign:QueryVerification ;
    rdfs:range xsd:integer ;
    rdfs:label "triples added"@en ;
    skos:definition "How many triples the update inserted into the example ABox."@en .

###  https://w3id.org/OntoGSN/design#triplesRemoved
gsndesign:triplesRemoved rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain gsndesign:QueryVerification ;
    rdfs:range xsd:integer ;
    rdfs:label "triples removed"@en ;
    skos:definition "How many triples the update deleted from the example ABox."@en .


#################################################################
#    Datatype properties - requirements
#################################################################

###  https://w3id.org/OntoGSN/design#appliesTo
gsndesign:appliesTo rdf:type owl:DatatypeProperty ;
    rdfs:domain gsndesign:Requirement ;
    rdfs:range xsd:string ;
    rdfs:label "applies to"@en ;
    skos:definition "What the requirement constrains - the ontology, the framework, the supporting tools."@en .


#################################################################
#    Controlled vocabularies
#################################################################

gsndesign:OWL   rdf:type gsndesign:Formalism ; skos:prefLabel "OWL" ;
    skos:definition "An OWL 2 axiom."@en .
gsndesign:SWRL  rdf:type gsndesign:Formalism ; skos:prefLabel "SWRL" ;
    skos:definition "A SWRL inference rule."@en .
gsndesign:SHACL rdf:type gsndesign:Formalism ; skos:prefLabel "SHACL" ;
    skos:definition "A SHACL validation constraint."@en .
gsndesign:RDF   rdf:type gsndesign:Formalism ; skos:prefLabel "RDF" ;
    skos:definition "A namespace declaration - RDF plumbing rather than an axiom."@en .
gsndesign:SPARQL rdf:type gsndesign:Formalism ; skos:prefLabel "SPARQL" ;
    skos:definition "A stored SPARQL query or update."@en ;
    skos:note "The odd one out, and deliberately so. The other formalisms say what an axiom of the ontology is written in; this one says what a query over an assurance case is written in. A query states nothing about GSN - it asks something of a case - so it carries no source passage and generates no statement. It is a member of this vocabulary because a query is still a thing written in a language, and because it lets 'what is written in SPARQL?' be asked the same way as 'what is written in SWRL?'."@en .
gsndesign:NoFormalism rdf:type gsndesign:Formalism ; skos:prefLabel "(none)" ;
    skos:definition "A deliberate decision to represent nothing."@en ;
    skos:note "Not the absence of a formalism but a decision about one, which is why it is a member of the vocabulary rather than a missing value."@en .

gsndesign:part-0 rdf:type gsndesign:StandardPart ; skos:prefLabel "Part 0 etc." .
gsndesign:part-1 rdf:type gsndesign:StandardPart ; skos:prefLabel "Part 1" .
gsndesign:part-2 rdf:type gsndesign:StandardPart ; skos:prefLabel "Part 2" .

gsndesign:sec-ontology-specific rdf:type gsndesign:StandardSection ;
    skos:prefLabel "Ontology-Specific Statements" ; gsndesign:sectionCode "S01" .
gsndesign:sec-preamble rdf:type gsndesign:StandardSection ;
    skos:prefLabel "Preamble" ; gsndesign:sectionCode "S02" .
gsndesign:sec-part0-glossary rdf:type gsndesign:StandardSection ;
    skos:prefLabel "Part 0, Glossary & Annex" ; gsndesign:sectionCode "S03" .
gsndesign:sec-core rdf:type gsndesign:StandardSection ;
    skos:prefLabel "Core GSN" ; gsndesign:sectionCode "S04" .
gsndesign:sec-pattern rdf:type gsndesign:StandardSection ;
    skos:prefLabel "Argument Pattern Extension" ; gsndesign:sectionCode "S05" .
gsndesign:sec-modular rdf:type gsndesign:StandardSection ;
    skos:prefLabel "Modular Extension" ; gsndesign:sectionCode "S06" .
gsndesign:sec-confidence rdf:type gsndesign:StandardSection ;
    skos:prefLabel "Confidence Argument Extension" ; gsndesign:sectionCode "S07" .
gsndesign:sec-dialectic rdf:type gsndesign:StandardSection ;
    skos:prefLabel "Dialectic Extension" ; gsndesign:sectionCode "S08" .
gsndesign:sec-part2 rdf:type gsndesign:StandardSection ;
    skos:prefLabel "Part 2" ; gsndesign:sectionCode "S09" .

###  https://w3id.org/OntoGSN/design#sectionCode
gsndesign:sectionCode rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain gsndesign:StandardSection ;
    rdfs:range xsd:string ;
    rdfs:label "section code"@en ;
    skos:definition "The section's prefix in a position key - S01 ... S09."@en .


#################################################################
#    The source document
#################################################################

###  https://w3id.org/OntoGSN/design#GSNCommunityStandardV3
gsndesign:GSNCommunityStandardV3 rdf:type prov:Entity , prov:Plan ;
    rdfs:label "GSN Community Standard, Version 3"@en ;
    dc:identifier "SCSC-141C" ;
    dc:creator "The Assurance Case Working Group (ACWG)"@en ;
    dc:date "2021-05" ;
    dc:publisher "Safety-Critical Systems Club"@en ;
    rdfs:seeAlso <http://scsc.uk/SCSC-141C> ;
    skos:definition "The normative source. Every OntoGSN term traces to a passage of it; the document itself is not redistributed in this repository."@en .
