gsndesign:query-RL-AUG-issue_goal_context
    a gsndesign:Query ;
    rdfs:label "RL-AUG-issue_goal_context" ;
    skos:hiddenLabel "A8b" ,
        "a08b_issue_goal_context.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/rules/RL-AUG-issue_goal_context.rq" ;
    gsndesign:fileChecksum "63e2186ea0df47901d5c3904a6996f5d2c11ee6129c276c9b92d52523ee126e9" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:challenges ,
        gsn:inContextOf ;
    gsndesign:ruleName "Issue Goal Context" ;
    gsndesign:restsOnStatement gsndesign:st-0161 ,
        gsndesign:st-0218 ,
        gsndesign:st-0696 ,
        gsndesign:st-0740 ;
    gsndesign:queryText """# name:      Issue Goal Context

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug: <https://w3id.org/OntoGSN/augmentation#>

INSERT {
  ?I gsn:inContextOf ?C .
}
WHERE {
  {
    SELECT DISTINCT ?I ?C
    WHERE {
      ?I a gsnaug:Issue , gsn:Goal ;
         gsn:challenges ?E .
      ?E a gsn:Goal ;
         gsn:inContextOf ?C .
      FILTER NOT EXISTS { ?I gsn:inContextOf ?any }
    }
  }
}
""" .

