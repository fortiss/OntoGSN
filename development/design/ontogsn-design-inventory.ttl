gsndesign:query-RQ-AUG-resolution_state
    a gsndesign:Query ;
    rdfs:label "RQ-AUG-resolution_state" ;
    skos:hiddenLabel "fc27" ,
        "FC-27" ,
        "FC27" ,
        "CQ-69" ,
        "fc27_resolution_state.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/RQ-AUG-resolution_state.rq" ;
    gsndesign:fileChecksum "652aee1c2c2b9e19b215f658d1cfcf62ff1eb2cd250357f849eeb13e68a0ca73" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ;
    gsndesign:answersQuestion gsndesign:cq-RQ-AUG-resolution_state ;
    gsndesign:queryText """PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?issueId ?targetId ?state ?responded
WHERE {
  ?issue a gsnaug:Issue ;
         schema:identifier ?issueId ;
         gsnaug:issueType gsnaug:resolve ;
         gsnaug:raisedAgainst ?target .
  ?target schema:identifier ?targetId .
  OPTIONAL { ?issue gsnaug:issueOutcome ?outcome }
  BIND( IF(BOUND(?outcome), STR(?outcome), "open") AS ?state )
  BIND( EXISTS { ?response gsnaug:respondsTo ?issue } AS ?responded )
}
ORDER BY ?issueId
""" .

gsndesign:query-RQ-AUG-revision_diff
    a gsndesign:Query ;
    rdfs:label "RQ-AUG-revision_diff" ;
    skos:hiddenLabel "fc24" ,
        "FC-24" ,
        "FC24" ,
        "CQ-66" ,
        "fc24_revision_diff.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/RQ-AUG-revision_diff.rq" ;
    gsndesign:fileChecksum "f81ce339290345de53ed93287df6fc85b8178ae19468697c0d80764c1919a3c5" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/ns/prov#" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:inContextOf ,
        gsn:refersTo ,
        gsn:supportedBy ;
    gsndesign:restsOnStatement gsndesign:st-0207 ,
        gsndesign:st-0218 ,
        gsndesign:st-0289 ;
    gsndesign:answersQuestion gsndesign:cq-RQ-AUG-revision_diff ;
    gsndesign:queryText """PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX prov:    <http://www.w3.org/ns/prov#>
PREFIX schema:  <http://schema.org/>

SELECT DISTINCT ?newer ?older ?mechanism ?issueId
WHERE {
  ?newer gsnaug:replaces ?older .
  OPTIONAL { ?newer gsnaug:generatedWith ?mechanism }
  OPTIONAL {
    {
      ?solution gsn:refersTo ?older .
      ?issue gsnaug:raisedAgainst ?solution .
    }
    UNION
    {
      ?context gsn:refersTo ?older .
      ?issue gsn:inContextOf ?context .
    }
    UNION
    {
      ?copy gsn:refersTo ?older .
      ?archived gsn:supportedBy ?copy .
      ?revised prov:wasRevisionOf ?archived .
      ?issue gsnaug:raisedAgainst ?target .
      FILTER(?target IN (?archived, ?revised))
    }
    ?issue gsnaug:issueType ?type ;
           schema:identifier ?issueId .
    FILTER(?type IN (gsnaug:revise, gsnaug:resolve))
  }
}
ORDER BY ?newer
""" .

gsndesign:query-RQ-AUG-revision_rounds
    a gsndesign:Query ;
    rdfs:label "RQ-AUG-revision_rounds" ;
    skos:hiddenLabel "fc23" ,
        "FC-23" ,
        "FC23" ,
        "CQ-65" ,
        "fc23_revision_rounds.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/RQ-AUG-revision_rounds.rq" ;
    gsndesign:fileChecksum "cb9c138034c993dc55f1a56ff602603f74843c77cfcdc0014c09da244b8e8bdf" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ;
    gsndesign:answersQuestion gsndesign:cq-RQ-AUG-revision_rounds ;
    gsndesign:queryText """PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?targetId (COUNT(DISTINCT ?issue) AS ?rounds)
       (GROUP_CONCAT(DISTINCT STR(?response); separator=", ") AS ?responses)
WHERE {
  ?issue a gsnaug:Issue ;
         gsnaug:issueType gsnaug:revise ;
         gsnaug:raisedAgainst ?target .
  ?target schema:identifier ?targetId .
  OPTIONAL {
    ?response a gsnaug:Response ;
              gsnaug:respondsTo ?issue
  }
}
GROUP BY ?targetId
ORDER BY DESC(?rounds)
""" .

