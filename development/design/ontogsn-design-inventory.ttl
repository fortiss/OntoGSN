gsndesign:query-RL-GSN-solution_confidence_relation
    a gsndesign:Query ;
    rdfs:label "RL-GSN-solution_confidence_relation" ;
    skos:hiddenLabel "S44" ,
        "s44_solution_confidence_relation.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/RL-GSN-solution_confidence_relation.rq" ;
    gsndesign:fileChecksum "7b48401986a1846c75964e24a2f7bf58a429e82c825e284ed44cb48441cf7535" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:RelationshipWithConfidence ,
        gsn:Solution ,
        gsn:associatedWith ,
        gsn:assuranceClaimPoint ,
        gsn:supportedBy ;
    gsndesign:ruleName "Solution Confidence Relation" ;
    gsndesign:translatesStatement gsndesign:st-1107 ;
    gsndesign:differsBy gsndesign:NodeContent ;
    gsndesign:restsOnStatement gsndesign:st-0161 ,
        gsndesign:st-0175 ,
        gsndesign:st-0207 ,
        gsndesign:st-0635 ,
        gsndesign:st-0648 ,
        gsndesign:st-0658 ;
    gsndesign:queryText """# name:      Solution Confidence Relation
# expect:    insert

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

INSERT {
  ?R2 a gsn:RelationshipWithConfidence ;
      schema:identifier ?relationshipId ;
      rdf:subject ?G ;
      rdf:predicate gsn:supportedBy ;
      rdf:object ?S2 ;
      gsn:associatedWith ?A ;
      gsn:assuranceClaimPoint true .
}
WHERE {
  ?R1 a gsn:RelationshipWithConfidence ;
      rdf:subject ?G ;
      rdf:object ?S1 ;
      gsn:associatedWith ?A .
  ?G a gsn:Goal ;
     gsn:supportedBy ?S1 , ?S2 ;
     schema:identifier ?idG .
  ?S1 a gsn:Solution .
  ?S2 a gsn:Solution ;
      schema:identifier ?idS2 .
  FILTER(?S1 != ?S2)
  BIND(CONCAT("RC-", ?idG, "-", ?idS2) AS ?relationshipId)
  BIND(CONCAT("RC-", REPLACE(STR(?G), "^.*[#/]", ""), "-", REPLACE(STR(?S2), "^.*[#/]", "")) AS ?iriKey)
  BIND(IRI(CONCAT(REPLACE(STR(?G), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?iriKey))) AS ?R2)
  FILTER NOT EXISTS {
    ?existing a gsn:RelationshipWithConfidence ;
              rdf:subject ?G ;
              rdf:object ?S2 .
  }
}
""" .

