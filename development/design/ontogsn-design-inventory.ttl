    gsndesign:translatesStatement gsndesign:st-1067 ;
    gsndesign:differsBy gsndesign:NodeContent ;
    gsndesign:restsOnStatement gsndesign:st-0287 ,
        gsndesign:st-0635 ,
        gsndesign:st-0648 ;
    gsndesign:queryText """# name:      Confidence Relation Creation
# expect:    insert

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

INSERT {
  ?R a gsn:RelationshipWithConfidence ;
     schema:identifier ?relationshipId ;
     rdf:subject ?A ;
     gsn:assuranceClaimPoint true .
}
WHERE {
  ?A a/rdfs:subClassOf* gsn:ArtefactReference ;
     gsn:assuranceClaimPoint ?acp ;
     schema:identifier ?idA .
  FILTER(STR(?acp) = "true")
  BIND(CONCAT("RC-", ?idA) AS ?relationshipId)
  BIND(CONCAT("RC-", REPLACE(STR(?A), "^.*[#/]", "")) AS ?iriKey)
  BIND(IRI(CONCAT(REPLACE(STR(?A), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?iriKey))) AS ?R)
  FILTER NOT EXISTS {
    ?existing a gsn:RelationshipWithConfidence ;
              rdf:subject ?A .
  }
}
""" .

gsndesign:query-RL-GSN-context_consistency
    a gsndesign:Query ;
    rdfs:label "RL-GSN-context_consistency" ;
    skos:hiddenLabel "S32" ,
        "s32_context_consistency.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/RL-GSN-context_consistency.rq" ;
    gsndesign:fileChecksum "06b99cfb0f32e3ed53c3e293ebcb1e2a333239e59c3039377cb254f0f94f025c" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Context ,
        gsn:Goal ,
        gsn:away ,
        gsn:consistentWith ,
        gsn:inContextOf ,
        gsn:supportedBy ;
    gsndesign:ruleName "Context Consistency" ;
    gsndesign:translatesStatement gsndesign:st-0572 ;
    gsndesign:differsBy gsndesign:Guard ;
    gsndesign:restsOnStatement gsndesign:st-0161 ,
        gsndesign:st-0181 ,
        gsndesign:st-0207 ,
        gsndesign:st-0218 ,
        gsndesign:st-0490 ,
        gsndesign:st-0565 ;
    gsndesign:queryText """# name:      Context Consistency
# expect:    insert

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

INSERT { ?C1 gsn:consistentWith ?C2 }
WHERE {
  ?G1 a gsn:Goal ;
      gsn:inContextOf ?C1 ;
      gsn:supportedBy ?G2 .
  ?G2 a gsn:Goal ;
      gsn:inContextOf ?C2 ;
      gsn:away ?away .
  FILTER(STR(?away) = "true")
  ?C2 a gsn:Context .
  FILTER(?C1 != ?C2)
  FILTER NOT EXISTS { ?C1 gsn:consistentWith ?C2 }
}
""" .

gsndesign:query-RL-GSN-context_contract_invalidation
    a gsndesign:Query ;
    rdfs:label "RL-GSN-context_contract_invalidation" ;
    skos:hiddenLabel "S27" ,
        "s27_context_contract_invalidation.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/RL-GSN-context_contract_invalidation.rq" ;
    gsndesign:fileChecksum "a329293584ca14a66f802c670b8945c1c5472e1f5978b8ef26762cf81002a560" ;
    gsndesign:declaresNamespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Module ,
        gsn:contract ,
        gsn:inContextOf ,
        gsn:inModule ,
        gsn:valid ;
    gsndesign:ruleName "Context Contract Invalidation" ;
    gsndesign:translatesStatement gsndesign:st-1113 ;
    gsndesign:differsBy gsndesign:Retraction ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0218 ,
        gsndesign:st-0469 ,
        gsndesign:st-0525 ,
        gsndesign:st-0944 ;
    gsndesign:queryText """# name:      Context Contract Invalidation
# expect:    insert

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DELETE { ?R gsn:valid ?old }
INSERT { ?R gsn:valid false }
WHERE {
  ?M1 a gsn:Module .
  ?M2 a gsn:Module ;
      gsn:contract ?contract .
  ?A gsn:inModule ?M2 .
  FILTER(STR(?contract) = "true")
  ?A gsn:inContextOf ?M1 .
  ?R rdf:subject ?A ;
     rdf:object ?M1 .
  OPTIONAL { ?R gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

