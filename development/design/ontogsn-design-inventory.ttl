    gsndesign:mentionsTerm gsn:Goal ,
        gsn:statement ;
    gsndesign:ruleName "Issue Goal Statement" ;
    gsndesign:restsOnStatement gsndesign:st-0161 ,
        gsndesign:st-0265 ;
    gsndesign:queryText """# name:      Issue Goal Statement

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug: <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema: <http://schema.org/>

INSERT {
  ?I gsn:statement ?D .
}
WHERE {
  {
    SELECT DISTINCT ?I ?D
    WHERE {
      ?I a gsnaug:Issue , gsn:Goal ;
         schema:description ?D .
      FILTER NOT EXISTS { ?I gsn:statement ?any }
    }
  }
}
""" .

