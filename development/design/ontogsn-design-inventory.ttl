gsndesign:query-RQ-GSN-claims_awaiting_evidence
    a gsndesign:Query ;
    rdfs:label "RQ-GSN-claims_awaiting_evidence" ;
    skos:hiddenLabel "CQ-48" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/RQ-GSN-claims_awaiting_evidence.rq" ;
    gsndesign:fileChecksum "f3d94b84cddf18f5a06acb300f5acb4f99c9909afcbd9c775447166547d134a9" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:Solution ,
        gsn:away ,
        gsn:challenges ,
        gsn:refersTo ,
        gsn:statement ,
        gsn:supportedBy ,
        gsn:toBeSupportedByContract ,
        gsn:undeveloped ,
        gsn:uninstantiated ;
    gsndesign:restsOnStatement gsndesign:st-0161 ,
        gsndesign:st-0175 ,
        gsndesign:st-0200 ,
        gsndesign:st-0207 ,
        gsndesign:st-0265 ,
        gsndesign:st-0289 ,
        gsndesign:st-0358 ,
        gsndesign:st-0490 ,
        gsndesign:st-0542 ,
        gsndesign:st-0696 ,
        gsndesign:st-0740 ;
    gsndesign:answersQuestion gsndesign:cq-RQ-GSN-claims_awaiting_evidence ;
    gsndesign:queryText """# expect: rows

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT DISTINCT ?goalId ?statement ?reason ?solutionId
WHERE {
  {
    ?goal a gsn:Goal .
    FILTER NOT EXISTS { ?goal gsn:supportedBy ?anything }
    FILTER NOT EXISTS { ?goal gsn:toBeSupportedByContract ?c . FILTER(STR(?c) = "true") }
    FILTER NOT EXISTS { ?goal gsn:away ?a . FILTER(STR(?a) = "true") }
    BIND("no support" AS ?reason)
  } UNION {
    ?goal a gsn:Goal ;
          gsn:undeveloped ?u .
    FILTER(STR(?u) = "true")
    BIND("undeveloped" AS ?reason)
  } UNION {
    ?goal a gsn:Goal ;
          gsn:supportedBy ?solution .
    ?solution a gsn:Solution ;
              schema:identifier ?solutionId .
    FILTER NOT EXISTS { ?solution gsn:refersTo ?artefact }
    BIND("solution without artefact" AS ?reason)
  } UNION {
    ?goal a gsn:Goal ;
          gsn:supportedBy ?solution .
    ?solution a gsn:Solution ;
              schema:identifier ?solutionId ;
              gsn:uninstantiated ?i .
    FILTER(STR(?i) = "true")
    BIND("uninstantiated solution" AS ?reason)
  }
  FILTER NOT EXISTS { ?goal gsn:challenges ?target }
  ?goal schema:identifier ?goalId .
  OPTIONAL { ?goal gsn:statement ?statement }
}
ORDER BY ?goalId ?reason ?solutionId
""" .

gsndesign:query-RQ-GSN-context_in_scope_for_goal
    a gsndesign:Query ;
    rdfs:label "RQ-GSN-context_in_scope_for_goal" ;
