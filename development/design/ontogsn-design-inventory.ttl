    gsndesign:fileChecksum "b3f20cd8b62460422beb7d4dfba754552cc1d44ace6aa41dfb0872e1faf31975" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:away ,
        gsn:contract ,
        gsn:inModule ,
        gsn:supportedBy ,
        gsn:toBeSupportedByContract ;
    gsndesign:ruleName "Contract Activation" ;
    gsndesign:translatesStatement gsndesign:st-1080 ;
    gsndesign:differsBy gsndesign:Retraction ;
    gsndesign:restsOnStatement gsndesign:st-0207 ,
        gsndesign:st-0490 ,
        gsndesign:st-0525 ,
        gsndesign:st-0542 ,
        gsndesign:st-0944 ;
    gsndesign:queryText """# name:      Contract Activation
# expect:    insert

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?M2 gsn:contract ?old }
INSERT { ?M2 gsn:contract true }
WHERE {
  ?A gsn:away ?away ;
     gsn:toBeSupportedByContract ?byContract ;
     gsn:supportedBy ?B .
  FILTER(STR(?away) = "true")
  FILTER(STR(?byContract) = "true")
  ?A gsn:inModule ?M1 .
  ?B gsn:inModule ?M2 .
  FILTER(?M1 != ?M2)
  OPTIONAL { ?M2 gsn:contract ?old }
  FILTER(!BOUND(?old) || STR(?old) != "true")
}
""" .

gsndesign:query-RL-GSN-contract_relation_invalidation
    a gsndesign:Query ;
    rdfs:label "RL-GSN-contract_relation_invalidation" ;
