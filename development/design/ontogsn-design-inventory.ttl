    gsndesign:queryText """PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?targetId ?type (COUNT(DISTINCT ?issue) AS ?rounds)
