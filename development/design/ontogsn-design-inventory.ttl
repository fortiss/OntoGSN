    gsndesign:fileChecksum "923cbca39f5b6b4ae648ab8e388a0c4b33951ad42d6b0d61c75e47c10129c59f" ;
    gsndesign:declaresNamespace "http://www.w3.org/ns/prov#" ,
        "http://www.w3.org/ns/shacl#" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Artefact ,
        gsn:Solution ,
        gsn:refersTo ,
        gsn:valid ;
    gsndesign:ruleName "Conforming Report Validates Solution" ;
    gsndesign:restsOnStatement gsndesign:st-0111 ,
        gsndesign:st-0114 ,
        gsndesign:st-0175 ,
        gsndesign:st-0289 ;
    gsndesign:queryText """# name:      Conforming Report Validates Solution

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug: <https://w3id.org/OntoGSN/augmentation#>
PREFIX prov:   <http://www.w3.org/ns/prov#>
PREFIX sh:     <http://www.w3.org/ns/shacl#>

INSERT {
  ?S gsn:valid true .
}
WHERE {
  ?S a gsn:Solution ;
     gsn:refersTo ?A .
  ?A a gsn:Artefact ;
     gsnaug:checkableWith ?M .
  ?M gsnaug:decides "validity" .
  ?R a sh:ValidationReport ;
     prov:wasGeneratedBy ?M ;
     prov:used ?A ;
     sh:conforms ?conforms .
  FILTER(STR(?conforms) = "true")
  FILTER NOT EXISTS { ?R prov:invalidatedAtTime|prov:wasInvalidatedBy ?struck }
  OPTIONAL { ?R prov:generatedAtTime ?t }
  FILTER NOT EXISTS {
    ?newer a sh:ValidationReport ;
           prov:wasGeneratedBy ?M ;
           prov:used ?A ;
           prov:generatedAtTime ?tNewer .
    FILTER(?tNewer > ?t)
    FILTER NOT EXISTS { ?newer prov:invalidatedAtTime|prov:wasInvalidatedBy ?struckNewer }
  }
  FILTER NOT EXISTS { ?S gsn:valid ?any }
}
""" .

gsndesign:query-RL-AUG-current_report
    a gsndesign:Query ;
    rdfs:label "RL-AUG-current_report" ;
    skos:hiddenLabel "D4" ,
        "d04_current_report.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/derivations/RL-AUG-current_report.rq" ;
    gsndesign:fileChecksum "51c36b532bfd93ca877d44b73cb1a9a73cb80ed19d5599d3f92800a327734187" ;
    gsndesign:declaresNamespace "http://www.w3.org/ns/prov#" ,
        "http://www.w3.org/ns/shacl#" ,
        "https://w3id.org/OntoGSN/augmentation#" ;
    gsndesign:ruleName "Current Report" ;
    gsndesign:queryText """# name:      Current Report

PREFIX gsnaug: <https://w3id.org/OntoGSN/augmentation#>
PREFIX prov:   <http://www.w3.org/ns/prov#>
PREFIX sh:     <http://www.w3.org/ns/shacl#>

DELETE { ?target gsnaug:currentReport ?stale }
INSERT { ?target gsnaug:currentReport ?report }
WHERE {
  {
    ?report a sh:ValidationReport ;
            prov:wasGeneratedBy ?mechanism ;
            prov:used ?target .
    FILTER NOT EXISTS { ?report prov:invalidatedAtTime|prov:wasInvalidatedBy ?struck }
    OPTIONAL { ?report prov:generatedAtTime ?t }
    FILTER NOT EXISTS {
      ?newer a sh:ValidationReport ;
             prov:wasGeneratedBy ?mechanism ;
             prov:used ?target ;
             prov:generatedAtTime ?tNewer .
      FILTER(?tNewer > ?t)
      FILTER NOT EXISTS { ?newer prov:invalidatedAtTime|prov:wasInvalidatedBy ?struckNewer }
    }
    FILTER NOT EXISTS { ?target gsnaug:currentReport ?report }
  }
  UNION
  {
    ?target gsnaug:currentReport ?stale .
    FILTER NOT EXISTS {
      ?stale a sh:ValidationReport ;
             prov:wasGeneratedBy ?mechanism ;
             prov:used ?target .
      FILTER NOT EXISTS { ?stale prov:invalidatedAtTime|prov:wasInvalidatedBy ?struck }
      OPTIONAL { ?stale prov:generatedAtTime ?t }
      FILTER NOT EXISTS {
        ?newer a sh:ValidationReport ;
               prov:wasGeneratedBy ?mechanism ;
               prov:used ?target ;
               prov:generatedAtTime ?tNewer .
        FILTER(?tNewer > ?t)
        FILTER NOT EXISTS { ?newer prov:invalidatedAtTime|prov:wasInvalidatedBy ?struckNewer }
      }
    }
  }
}
""" .

