# GENERATED by development/dev_tools/prov_inventory.py. Everything here is recoverable from the
# repository, so unlike ontogsn-design-data.ttl this file is rebuilt, not
# edited. Re-run after adding a query or rebuilding a serialization.

<https://w3id.org/OntoGSN/design/inventory> a owl:Ontology ;
    owl:imports <https://w3id.org/OntoGSN/design> ;
    dc:title "OntoGSN Design Record - requirements, questions, queries and builds"@en ;
    owl:versionInfo "1.0.0" .


#################################################################
#    Requirements (7)
#    What OntoGSN set out to do, before any of it was built.
#################################################################

gsndesign:req-R1
    a gsndesign:Requirement ;
    rdfs:label "R1"@en ;
    gsndesign:requirementText "User should be capable of performing every aspect in the normative GSN v3 standard with OntoGSN."@en ;
    gsndesign:appliesTo "ontology" ;
    dc:source "GSN Standard"@en .

gsndesign:req-R2
    a gsndesign:Requirement ;
    rdfs:label "R2"@en ;
    gsndesign:requirementText "OntoGSN should represent knowledge about GSN assurance cases in direct conformity with the standard metamodel."@en ;
    gsndesign:appliesTo "ontology" ;
    dc:source "GSN Standard"@en .

gsndesign:req-R3
    a gsndesign:Requirement ;
    rdfs:label "R3"@en ;
    gsndesign:requirementText "OntoGSN should be aligned with the ASCE XML schema."@en ;
    gsndesign:appliesTo "ontology" ;
    dc:source "https://scsc.uk/index.php/tools; feedback"@en .

gsndesign:req-R4
    a gsndesign:Requirement ;
    rdfs:label "R4"@en ;
    gsndesign:requirementText "The user should be able to use OntoGSN as a standalone framework."@en ;
    gsndesign:appliesTo "framework" ,
        "supporting tools" .

gsndesign:req-R5
    a gsndesign:Requirement ;
    rdfs:label "R5"@en ;
    gsndesign:requirementText "The user should be able to use OntoGSN in an accessible manner."@en ;
    gsndesign:appliesTo "framework" ,
        "supporting tools" ;
    dc:source "feedback"@en .

gsndesign:req-R6
    a gsndesign:Requirement ;
    rdfs:label "R6"@en ;
    gsndesign:requirementText "OntoGSN should not duplicate the features provided by existing tools and frameworks (e.g., GUI, imports/exports)."@en ;
    gsndesign:appliesTo "supporting tools" ;
    dc:source "https://scsc.uk/index.php/tools"@en .

gsndesign:req-R7
    a gsndesign:Requirement ;
    rdfs:label "R7"@en ;
    gsndesign:requirementText "The user should have an accessible and easy way to create SPARQL queries based on a case ABox conformant to the OntoGSN TBox."@en ;
    gsndesign:appliesTo "supporting tools" .


#################################################################
#    Competency questions (84)
#    What the ontology has to be able to answer, and for whom. A question has the ID of
#    the query that answers it.
#################################################################

gsndesign:cq-RQ-AUG-alternative_provision
    a gsndesign:CompetencyQuestion ;
    rdfs:label "RQ-AUG-alternative_provision" ;
    gsndesign:role "Process/Software Owner"@en ;
    gsndesign:questionText "Which evidence needs an alternative provision mechanism - an interview, a call, paper?"@en .

gsndesign:cq-RQ-AUG-artefacts_to_change
    a gsndesign:CompetencyQuestion ;
    rdfs:label "RQ-AUG-artefacts_to_change" ;
    gsndesign:role "Developer"@en ;
    gsndesign:questionText "Which artefacts need changing, and who owns the change?"@en .

gsndesign:cq-RQ-AUG-assured_system
    a gsndesign:CompetencyQuestion ;
    rdfs:label "RQ-AUG-assured_system" ;
    gsndesign:role "Auditor"@en ;
    gsndesign:questionText "What system and organisation is this case about?"@en .

gsndesign:cq-RQ-AUG-automated_evidence
    a gsndesign:CompetencyQuestion ;
    rdfs:label "RQ-AUG-automated_evidence" ;
    gsndesign:role "Developer"@en ;
    gsndesign:questionText "Which evidence is generated automatically, and how or where from can it be retrieved?"@en .

gsndesign:cq-RQ-AUG-automation_feasibility
    a gsndesign:CompetencyQuestion ;
    rdfs:label "RQ-AUG-automation_feasibility" ;
    gsndesign:role "Developer"@en ;
    gsndesign:questionText "Which evidence can be generated automatically, and which has been assessed as manual?"@en .

gsndesign:cq-RQ-AUG-cannot_resolve
    a gsndesign:CompetencyQuestion ;
    rdfs:label "RQ-AUG-cannot_resolve" ;
    gsndesign:role "Auditor"@en ;
    gsndesign:questionText "Which issue cannot be resolved at all, as opposed to not yet resolved?"@en .

