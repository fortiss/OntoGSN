gsndesign:query-RL-GSN-support_cycle_relationship_invalidation
    a gsndesign:Query ;
    rdfs:label "RL-GSN-support_cycle_relationship_invalidation" ;
    skos:hiddenLabel "S57" ,
        "s57_support_cycle_relationship_invalidation.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/RL-GSN-support_cycle_relationship_invalidation.rq" ;
    gsndesign:fileChecksum "424126167c977c6e1fa25acee5ee09fd9276706ed1a78604ca5783729ac9df87" ;
    gsndesign:declaresNamespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Relationship ,
        gsn:supportedBy ,
        gsn:transitivelySupportedBy ,
        gsn:valid ;
    gsndesign:ruleName "Support Cycle Relationship Invalidation" ;
    gsndesign:translatesStatement gsndesign:st-1042 ;
    gsndesign:differsBy gsndesign:Retraction ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0207 ,
        gsndesign:st-0291 ,
        gsndesign:st-1023 ;
    gsndesign:queryText """# name:      Support Cycle Relationship Invalidation
# expect:    insert

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DELETE { ?R gsn:valid ?old }
INSERT { ?R gsn:valid false }
WHERE {
  ?R a gsn:Relationship ;
     rdf:subject ?A ;
     rdf:object ?B .
  ?A gsn:supportedBy ?B .
  ?B gsn:transitivelySupportedBy ?A .
  OPTIONAL { ?R gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsndesign:query-RL-GSN-support_doubt_propagation
    a gsndesign:Query ;
    rdfs:label "RL-GSN-support_doubt_propagation" ;
    skos:hiddenLabel "S64" ,
        "s64_support_doubt_propagation.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/RL-GSN-support_doubt_propagation.rq" ;
    gsndesign:fileChecksum "32846397c401667a83979641aec5146d5923fe7f8473002305eb5ef109365794" ;
    gsndesign:declaresNamespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Relationship ,
        gsn:inDoubt ,
        gsn:supportedBy ;
    gsndesign:ruleName "Support Doubt Propagation" ;
    gsndesign:translatesStatement gsndesign:st-1099 ;
    gsndesign:differsBy gsndesign:Retraction ;
    gsndesign:restsOnStatement gsndesign:st-0207 ,
        gsndesign:st-0291 ,
        gsndesign:st-0731 ;
    gsndesign:queryText """# name:      Support Doubt Propagation
# expect:    insert

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DELETE { ?A gsn:inDoubt ?old }
INSERT { ?A gsn:inDoubt true }
WHERE {
  ?R a gsn:Relationship ;
     gsn:inDoubt ?dR ;
     rdf:subject ?A ;
     rdf:object ?B .
  FILTER(STR(?dR) = "true")
  ?A gsn:supportedBy ?B .
  OPTIONAL { ?A gsn:inDoubt ?old }
  FILTER(!BOUND(?old) || STR(?old) != "true")
}
""" .

gsndesign:query-RL-GSN-support_relation_creation
    a gsndesign:Query ;
    rdfs:label "RL-GSN-support_relation_creation" ;
    skos:hiddenLabel "S18" ,
        "s18_support_relation_creation.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/RL-GSN-support_relation_creation.rq" ;
    gsndesign:fileChecksum "26f7a3a3faa7f21cc9485efce116ac7d05ac0516e7fc66db3c54ecfa156347c7" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Relationship ,
        gsn:supportedBy ;
    gsndesign:ruleName "Support Relation Creation" ;
    gsndesign:translatesStatement gsndesign:st-1075 ;
    gsndesign:differsBy gsndesign:Guard ,
        gsndesign:NodeContent ;
    gsndesign:restsOnStatement gsndesign:st-0207 ,
        gsndesign:st-0291 ;
    gsndesign:queryText """# name:      Support Relation Creation
# expect:    insert

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

INSERT {
  ?R a gsn:Relationship ;
     schema:identifier ?relationshipId ;
     rdf:subject ?A ;
     rdf:predicate gsn:supportedBy ;
     rdf:object ?B .
}
WHERE {
  ?A gsn:supportedBy ?B ;
     schema:identifier ?idA .
  ?B schema:identifier ?idB .
  BIND(CONCAT("R-", ?idA, "-supportedBy-", ?idB) AS ?relationshipId)
  BIND(CONCAT("R-", REPLACE(STR(?A), "^.*[#/]", ""), "-supportedBy-", REPLACE(STR(?B), "^.*[#/]", "")) AS ?iriKey)
  BIND(IRI(CONCAT(REPLACE(STR(?A), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?iriKey))) AS ?R)
  FILTER NOT EXISTS {
    ?existing rdf:subject ?A ;
              rdf:predicate gsn:supportedBy ;
              rdf:object ?B .
  }
}
""" .

gsndesign:query-RL-GSN-template_undeveloped_invalidation_a
    a gsndesign:Query ;
    rdfs:label "RL-GSN-template_undeveloped_invalidation_a" ;
    skos:hiddenLabel "S21" ,
        "s21_template_undeveloped_invalidation_a.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/RL-GSN-template_undeveloped_invalidation_a.rq" ;
    gsndesign:fileChecksum "77bf136d7699a6d29372ee9320d5fec586f19e5855373d3f881c963fc6a03e62" ;
    gsndesign:declaresNamespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Template ,
        gsn:published ,
        gsn:undeveloped ,
        gsn:valid ;
    gsndesign:ruleName "Template Undeveloped Invalidation (A)" ;
    gsndesign:translatesStatement gsndesign:st-0449 ;
    gsndesign:differsBy gsndesign:Retraction ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0200 ,
        gsndesign:st-0438 ,
        gsndesign:st-0444 ;
    gsndesign:queryText """# name:      Template Undeveloped Invalidation (A)
# expect:    insert

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DELETE { ?target gsn:valid ?old }
INSERT { ?target gsn:valid false }
WHERE {
  ?A a gsn:Template ;
     gsn:published ?published .
  FILTER(STR(?published) = "true")
  ?R gsn:undeveloped ?undeveloped ;
     rdf:subject ?A .
  FILTER(STR(?undeveloped) = "true")
  VALUES ?slot { 1 2 }
  BIND(IF(?slot = 1, ?A, ?R) AS ?target)
  OPTIONAL { ?target gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsndesign:query-RL-GSN-template_undeveloped_invalidation_b
    a gsndesign:Query ;
    rdfs:label "RL-GSN-template_undeveloped_invalidation_b" ;
    skos:hiddenLabel "S22" ,
        "s22_template_undeveloped_invalidation_b.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/RL-GSN-template_undeveloped_invalidation_b.rq" ;
    gsndesign:fileChecksum "8b962590a0f604375b00698988e24a84a0d2bfdb23d3aadfd59152fb8ee4ed50" ;
    gsndesign:declaresNamespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Template ,
        gsn:contains ,
        gsn:published ,
        gsn:undeveloped ,
        gsn:valid ;
    gsndesign:ruleName "Template Undeveloped Invalidation (B)" ;
    gsndesign:translatesStatement gsndesign:st-0450 ;
    gsndesign:differsBy gsndesign:Retraction ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0200 ,
        gsndesign:st-0438 ,
        gsndesign:st-0444 ,
        gsndesign:st-0474 ;
    gsndesign:queryText """# name:      Template Undeveloped Invalidation (B)
# expect:    insert

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DELETE { ?target gsn:valid ?old }
INSERT { ?target gsn:valid false }
WHERE {
  ?A a gsn:Template ;
     gsn:published ?published ;
     gsn:contains ?B .
  FILTER(STR(?published) = "true")
  ?R gsn:undeveloped ?undeveloped ;
     rdf:subject ?B .
  FILTER(STR(?undeveloped) = "true")
  VALUES ?slot { 1 2 }
  BIND(IF(?slot = 1, ?A, ?R) AS ?target)
  OPTIONAL { ?target gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsndesign:query-RL-GSN-undeveloped_defeat
    a gsndesign:Query ;
    rdfs:label "RL-GSN-undeveloped_defeat" ;
    skos:hiddenLabel "S49" ,
        "s49_undeveloped_defeat.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/RL-GSN-undeveloped_defeat.rq" ;
    gsndesign:fileChecksum "8645c960459dfbcbe6a377663c2992bed52c84934ef56064dd9a762a636c8846" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:challenges ,
        gsn:defeated ,
        gsn:inDoubt ,
        gsn:undeveloped ;
    gsndesign:ruleName "Undeveloped Defeat" ;
    gsndesign:translatesStatement gsndesign:st-0738 ;
    gsndesign:differsBy gsndesign:Retraction ;
    gsndesign:restsOnStatement gsndesign:st-0161 ,
        gsndesign:st-0200 ,
        gsndesign:st-0696 ,
        gsndesign:st-0699 ,
        gsndesign:st-0731 ,
        gsndesign:st-0740 ;
    gsndesign:queryText """# name:      Undeveloped Defeat
# expect:    insert

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?E gsn:defeated ?old }
INSERT { ?E gsn:defeated true }
WHERE {
  ?G a gsn:Goal ;
     gsn:undeveloped ?undeveloped ;
     gsn:challenges ?E .
  FILTER(STR(?undeveloped) = "false")
  ?E gsn:inDoubt ?doubt .
  FILTER(STR(?doubt) = "true")
  OPTIONAL { ?E gsn:defeated ?old }
  FILTER(!BOUND(?old) || STR(?old) != "true")
}
""" .

gsndesign:query-RQ-AUG-alternative_provision
    a gsndesign:Query ;
    rdfs:label "RQ-AUG-alternative_provision" ;
    skos:hiddenLabel "fc30" ,
        "FC-30" ,
        "FC30" ,
        "CQ-72" ,
        "fc30_alternative_provision.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/RQ-AUG-alternative_provision.rq" ;
    gsndesign:fileChecksum "dd23b8539b4dca53923a06901a657b1c33f5564b02b2a96bda64f5e8e5635930" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Solution ,
        gsn:refersTo ;
    gsndesign:restsOnStatement gsndesign:st-0175 ,
        gsndesign:st-0289 ;
    gsndesign:answersQuestion gsndesign:cq-RQ-AUG-alternative_provision ;
    gsndesign:queryText """PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?solutionId ?artefact ?retrieval ?automated
WHERE {
  ?solution a gsn:Solution ;
            schema:identifier ?solutionId ;
            gsn:refersTo ?artefact .
  OPTIONAL {
    ?artefact gsnaug:retrievableWith ?retrieval .
    OPTIONAL { ?retrieval gsnaug:automated ?automated }
  }
  FILTER ( !BOUND(?retrieval) || !BOUND(?automated) || ?automated = false )
}
ORDER BY ?solutionId
""" .

gsndesign:query-RQ-AUG-artefacts_to_change
    a gsndesign:Query ;
    rdfs:label "RQ-AUG-artefacts_to_change" ;
    skos:hiddenLabel "fc35" ,
        "FC-35" ,
        "FC35" ,
        "CQ-77" ,
        "fc35_artefacts_to_change.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/RQ-AUG-artefacts_to_change.rq" ;
    gsndesign:fileChecksum "4a48e8f760442968ab0d1e6644a956745d7150ae6a97ed426f4c29e4278567c0" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Solution ,
        gsn:defeated ,
        gsn:refersTo ,
        gsn:supportedBy ;
    gsndesign:restsOnStatement gsndesign:st-0175 ,
        gsndesign:st-0207 ,
        gsndesign:st-0289 ,
        gsndesign:st-0699 ;
    gsndesign:answersQuestion gsndesign:cq-RQ-AUG-artefacts_to_change ;
    gsndesign:queryText """PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?solutionId ?artefact ?owner ?author ?alsoRestingOnIt
WHERE {
  ?solution a gsn:Solution ;
            schema:identifier ?solutionId ;
            gsn:defeated true ;
            gsn:refersTo ?artefact .
  OPTIONAL { ?solution gsnaug:ownedBy ?owner }
  OPTIONAL { ?artefact gsnaug:generatedBy ?author }
  OPTIONAL {
    ?otherSolution gsn:refersTo ?artefact .
    ?claim gsn:supportedBy ?otherSolution ;
           schema:identifier ?alsoRestingOnIt
  }
}
ORDER BY ?solutionId
""" .

