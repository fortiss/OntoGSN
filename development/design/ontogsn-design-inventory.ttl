    gsndesign:queryText """# name:      Contradictory Goal Truth
# expect:    insert

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?B gsn:valid ?old }
INSERT { ?B gsn:valid false }
WHERE {
  ?A a gsn:Goal ;
     gsn:true ?tA .
  FILTER(STR(?tA) = "false")
  ?B gsn:supportedBy ?A ;
     gsn:true ?tB .
  FILTER(STR(?tB) = "true")
  OPTIONAL { ?B gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

