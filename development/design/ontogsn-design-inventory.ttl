gsndesign:query-RL-GSN-solution_propagation_true
    a gsndesign:Query ;
    rdfs:label "RL-GSN-solution_propagation_true" ;
    skos:hiddenLabel "S10" ,
        "s10_solution_propagation_true.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/RL-GSN-solution_propagation_true.rq" ;
    gsndesign:fileChecksum "3757a41deeb9c4749739856cc029523a4acb829492fabed1e96d227082a0ad6e" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Assumption ,
        gsn:Solution ,
        gsn:defeated ,
        gsn:inContextOf ,
        gsn:supportedBy ,
        gsn:true ;
    gsndesign:ruleName "Solution Propagation (True)" ;
    gsndesign:translatesStatement gsndesign:st-0243 ;
    gsndesign:differsBy gsndesign:Retraction ,
        gsndesign:Guard ;
    gsndesign:restsOnStatement gsndesign:st-0175 ,
        gsndesign:st-0188 ,
        gsndesign:st-0207 ,
        gsndesign:st-0218 ,
        gsndesign:st-0234 ,
        gsndesign:st-0699 ;
    gsndesign:queryText """# name:      Solution Propagation (True)
# expect:    insert

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?B gsn:true ?old }
INSERT { ?B gsn:true true }
WHERE {
  ?A a gsn:Solution ;
     gsn:true ?tA .
  FILTER(STR(?tA) = "true")
  ?B gsn:supportedBy ?A .

  FILTER NOT EXISTS {
    ?B gsn:supportedBy ?other .
    ?other a gsn:Solution .
    FILTER NOT EXISTS { ?other gsn:true ?tOther . FILTER(STR(?tOther) = "true") }
  }
  FILTER NOT EXISTS {
    ?B gsn:inContextOf ?asm .
    ?asm a gsn:Assumption ; gsn:true ?tAsm .
    FILTER(STR(?tAsm) = "false")
  }
  FILTER NOT EXISTS {
    ?B gsn:defeated ?dB .
    FILTER(STR(?dB) = "true")
  }

  OPTIONAL { ?B gsn:true ?old }
  FILTER(!BOUND(?old) || STR(?old) != "true")
}
""" .

gsndesign:query-RL-GSN-strategy_confidence_relation
    a gsndesign:Query ;
    rdfs:label "RL-GSN-strategy_confidence_relation" ;
    skos:hiddenLabel "S42" ,
        "s42_strategy_confidence_relation.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/RL-GSN-strategy_confidence_relation.rq" ;
    gsndesign:fileChecksum "9b60a96e92e597db4ddac3f1a4e1d4b975e69f0316053cf23bcc03be9564495e" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:RelationshipWithConfidence ,
        gsn:Strategy ,
        gsn:associatedWith ,
        gsn:assuranceClaimPoint ,
        gsn:supportedBy ;
    gsndesign:ruleName "Strategy Confidence Relation" ;
    gsndesign:translatesStatement gsndesign:st-1109 ;
    gsndesign:differsBy gsndesign:NodeContent ;
    gsndesign:restsOnStatement gsndesign:st-0161 ,
        gsndesign:st-0167 ,
        gsndesign:st-0207 ,
        gsndesign:st-0635 ,
        gsndesign:st-0648 ,
        gsndesign:st-0658 ;
    gsndesign:queryText """# name:      Strategy Confidence Relation
# expect:    insert

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

INSERT {
  ?R2 a gsn:RelationshipWithConfidence ;
      schema:identifier ?relationshipId ;
      rdf:subject ?S ;
      rdf:predicate gsn:supportedBy ;
      rdf:object ?G2 ;
      gsn:associatedWith ?A ;
      gsn:assuranceClaimPoint true .
}
WHERE {
  ?R1 a gsn:RelationshipWithConfidence ;
      rdf:subject ?G1 ;
      rdf:object ?S ;
      gsn:associatedWith ?A .
  ?G1 a gsn:Goal ;
      gsn:supportedBy ?S .
  ?S a gsn:Strategy ;
     gsn:supportedBy ?G2 ;
     schema:identifier ?idS .
  ?G2 a gsn:Goal ;
      schema:identifier ?idG2 .
  BIND(CONCAT("RC-", ?idS, "-", ?idG2) AS ?relationshipId)
  BIND(CONCAT("RC-", REPLACE(STR(?S), "^.*[#/]", ""), "-", REPLACE(STR(?G2), "^.*[#/]", "")) AS ?iriKey)
  BIND(IRI(CONCAT(REPLACE(STR(?S), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?iriKey))) AS ?R2)
  FILTER NOT EXISTS {
    ?existing a gsn:RelationshipWithConfidence ;
              rdf:subject ?S ;
              rdf:object ?G2 .
  }
}
""" .

gsndesign:query-RL-GSN-substitution_invalidation
    a gsndesign:Query ;
    rdfs:label "RL-GSN-substitution_invalidation" ;
    skos:hiddenLabel "S33" ,
        "s33_substitution_invalidation.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/RL-GSN-substitution_invalidation.rq" ;
    gsndesign:fileChecksum "915d7cb02e0e0699b976a3853d72e42a1bc39b74a8f057f9ef9b038bcfd83677" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Justification ,
        gsn:inContextOf ,
        gsn:inModule ,
        gsn:substitutedBy ,
        gsn:valid ;
    gsndesign:ruleName "Substitution Invalidation" ;
    gsndesign:translatesStatement gsndesign:st-1076 ;
    gsndesign:differsBy gsndesign:Retraction ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0194 ,
        gsndesign:st-0218 ,
        gsndesign:st-0574 ,
        gsndesign:st-0944 ;
    gsndesign:queryText """# name:      Substitution Invalidation
# expect:    insert

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?J gsn:valid ?old }
INSERT { ?J gsn:valid false }
WHERE {
  ?J gsn:inModule ?M1 .
  ?G gsn:inModule ?M2 .
  FILTER(?M1 != ?M2)
  ?J a gsn:Justification ;
     gsn:substitutedBy ?G .
  ?E gsn:inContextOf ?J .
  OPTIONAL { ?J gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsndesign:query-RL-GSN-support_closure
    a gsndesign:Query ;
