        gsndesign:st-0542 ,
        gsndesign:st-0944 ;
    gsndesign:queryText """# name:      Contract Relation Invalidation
# expect:    insert

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DELETE { ?R gsn:valid ?old }
INSERT { ?R gsn:valid false }
WHERE {
  ?A gsn:inModule ?M .
