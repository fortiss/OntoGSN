gsndesign:query-RL-GSN-away_goal_invalidation
    a gsndesign:Query ;
    rdfs:label "RL-GSN-away_goal_invalidation" ;
    skos:hiddenLabel "S29" ,
        "s29_away_goal_invalidation.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/RL-GSN-away_goal_invalidation.rq" ;
    gsndesign:fileChecksum "c5713eefbb18a55a45fc29ba8c8be8bae9a1396426f92c9f5f2b6519c07fbebc" ;
    gsndesign:declaresNamespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:away ,
        gsn:inModule ,
        gsn:supportedBy ,
        gsn:valid ;
    gsndesign:ruleName "Away Goal Invalidation" ;
    gsndesign:translatesStatement gsndesign:st-0559 ;
    gsndesign:differsBy gsndesign:Retraction ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0161 ,
        gsndesign:st-0207 ,
        gsndesign:st-0490 ,
        gsndesign:st-0944 ;
    gsndesign:queryText """# name:      Away Goal Invalidation
# expect:    insert

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DELETE { ?R gsn:valid ?old }
INSERT { ?R gsn:valid false }
WHERE {
  ?G1 a gsn:Goal ;
      gsn:supportedBy ?G2 ;
      gsn:away ?away .
  FILTER(STR(?away) = "true")
  ?R rdf:subject ?G1 ;
     rdf:object ?G2 .
  ?G1 gsn:inModule ?M1 .
  ?G2 gsn:inModule ?M2 .
  OPTIONAL { ?R gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsndesign:query-RL-GSN-challenge_chain_invalidation
    a gsndesign:Query ;
    rdfs:label "RL-GSN-challenge_chain_invalidation" ;
    skos:hiddenLabel "S51" ,
        "s51_challenge_chain_invalidation.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/RL-GSN-challenge_chain_invalidation.rq" ;
    gsndesign:fileChecksum "cb9d2ffc9527988a664610c6093b91a1e0dfe59634c331a6b0a843ee2d3637fd" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:Strategy ,
        gsn:challenges ,
        gsn:supportedBy ,
        gsn:valid ;
    gsndesign:ruleName "Challenge Chain Invalidation" ;
    gsndesign:translatesStatement gsndesign:st-1070 ;
    gsndesign:differsBy gsndesign:Retraction ,
        gsndesign:NodeContent ;
    gsndesign:restsOnStatement gsndesign:st-0114 ,
        gsndesign:st-0161 ,
        gsndesign:st-0167 ,
        gsndesign:st-0207 ,
        gsndesign:st-0696 ,
        gsndesign:st-0740 ;
    gsndesign:queryText """# name:      Challenge Chain Invalidation
# expect:    insert

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

DELETE {
  ?D gsn:valid ?oldD .
  ?R gsn:valid ?oldR .
}
INSERT {
  ?S a gsn:Strategy ;
     schema:identifier ?strategyId ;
     gsn:supportedBy ?G1 , ?G2 ;
     gsn:valid false .
  ?G3 gsn:supportedBy ?S .
  ?D gsn:challenges ?S ;
     gsn:valid false .
  ?R gsn:valid false .
}
WHERE {
  ?D gsn:challenges ?R .
  ?R rdf:subject ?G3 ;
     rdf:object ?G1 .
  ?G1 a gsn:Goal .
  ?G3 a gsn:Goal ;
      gsn:supportedBy ?G1 ;
      schema:identifier ?idG3 .
  ?G3 gsn:supportedBy ?G2 .
  ?G2 a gsn:Goal .
  FILTER(?G1 != ?G2)
  BIND(CONCAT("St-", ?idG3, "-rebutted") AS ?strategyId)
  BIND(CONCAT("St-", REPLACE(STR(?G3), "^.*[#/]", ""), "-rebutted") AS ?iriKey)
  BIND(IRI(CONCAT(REPLACE(STR(?G3), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?iriKey))) AS ?S)
  OPTIONAL { ?D gsn:valid ?oldD }
  OPTIONAL { ?R gsn:valid ?oldR }
  FILTER NOT EXISTS { ?G3 gsn:supportedBy ?S }
}
""" .

