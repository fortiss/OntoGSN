    gsndesign:fileChecksum "38e704d84bcdfd09ca34669b319c142c87fa07b60b1acad1ba2219ad693818e9" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://example.org/my-assurance-case#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Argument ,
        gsn:AssuranceCase ,
        gsn:Goal ,
        gsn:argumentType ,
        gsn:contains ,
        gsn:final ,
        gsn:published ,
        gsn:statement ,
        gsn:structured ,
        gsn:top ,
        gsn:undeveloped ;
    gsndesign:restsOnStatement gsndesign:st-0077 ,
        gsndesign:st-0085 ,
        gsndesign:st-0096 ,
        gsndesign:st-0144 ,
        gsndesign:st-0161 ,
        gsndesign:st-0200 ,
        gsndesign:st-0265 ,
        gsndesign:st-0330 ,
        gsndesign:st-0444 ,
        gsndesign:st-0474 ,
        gsndesign:st-0640 ;
    gsndesign:answersQuestion gsndesign:cq-WQ-GSN-create_assurance_case_skeleton ;
    gsndesign:queryText """# expect: insert

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>
PREFIX case:   <https://example.org/my-assurance-case#>

INSERT DATA {
  case:AC1 a gsn:AssuranceCase ;
           schema:identifier "AC1" ;
           rdfs:label "New assurance case" ;
           gsn:statement "The system is acceptably safe for its intended use." ;
           gsn:contains case:Arg1 .

  case:Arg1 a gsn:Argument ;
            schema:identifier "Arg1" ;
            rdfs:label "Top-level argument" ;
            gsn:statement "Argument over the identified hazards." ;
            gsn:argumentType "risk" ;
            gsn:structured true ;
            gsn:final false ;
            gsn:published false ;
            gsn:contains case:G1 .

  case:G1 a gsn:Goal ;
          schema:identifier "G1" ;
          rdfs:label "Goal G1" ;
          gsn:statement "The system is acceptably safe for its intended use." ;
          gsn:top true ;
          gsn:undeveloped true .
}
""" .

gsndesign:query-WQ-GSN-create_challenge_to_element
    a gsndesign:Query ;
    rdfs:label "WQ-GSN-create_challenge_to_element" ;
    skos:hiddenLabel "CQ-29" ,
        "create_challenge_to_element.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/WQ-GSN-create_challenge_to_element.rq" ;
    gsndesign:fileChecksum "f5d778389175843f04094d8b5735daa40eef2274f6b55f57630798476ee98a2d" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:challenges ,
        gsn:statement ,
        gsn:undeveloped ;
    gsndesign:restsOnStatement gsndesign:st-0161 ,
        gsndesign:st-0200 ,
        gsndesign:st-0265 ,
        gsndesign:st-0696 ,
        gsndesign:st-0740 ;
    gsndesign:answersQuestion gsndesign:cq-WQ-GSN-create_challenge_to_element ;
    gsndesign:queryText """# expect: insert

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

INSERT {
  ?challenge a ?challengeType ;
             schema:identifier ?challengeId ;
             rdfs:label ?challengeId ;
             gsn:statement ?challengeStatement ;
             gsn:undeveloped true ;
             gsn:challenges ?target .
}
WHERE {
  VALUES (?targetId ?challengeId ?challengeType ?challengeStatement) {
    ("G1.1" "CG3" gsn:Goal
     "The field trial did not cover the night-time subset of the operational design domain.")
  }
  ?target schema:identifier ?targetId .
  FILTER NOT EXISTS { ?existing schema:identifier ?challengeId }
  BIND(IRI(CONCAT(REPLACE(STR(?target), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?challengeId))) AS ?challenge)
}
""" .

