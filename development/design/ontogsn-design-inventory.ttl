    gsndesign:queryText """# name:      Final Pattern Invalidation
# expect:    insert

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?A gsn:valid ?old }
INSERT { ?A gsn:valid false }
WHERE {
  ?C a gsn:Pattern .
  ?B gsn:instantiationOf ?C .
  ?A gsn:final ?final ;
     gsn:contains ?B , ?C .
  FILTER(STR(?final) = "true")
  OPTIONAL { ?A gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsndesign:query-RL-GSN-goal_confidence_relation
    a gsndesign:Query ;
    rdfs:label "RL-GSN-goal_confidence_relation" ;
    skos:hiddenLabel "S45" ,
        "s45_goal_confidence_relation.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/RL-GSN-goal_confidence_relation.rq" ;
    gsndesign:fileChecksum "1895098d0fa15b3b99b77e4daed71c0e97caa96f300451aecf59c02ea6c79cf5" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:RelationshipWithConfidence ,
        gsn:associatedWith ,
        gsn:assuranceClaimPoint ,
        gsn:supportedBy ;
    gsndesign:ruleName "Goal Confidence Relation" ;
    gsndesign:translatesStatement gsndesign:st-1106 ;
    gsndesign:differsBy gsndesign:NodeContent ;
    gsndesign:restsOnStatement gsndesign:st-0161 ,
        gsndesign:st-0207 ,
        gsndesign:st-0635 ,
        gsndesign:st-0648 ,
        gsndesign:st-0658 ;
    gsndesign:queryText """# name:      Goal Confidence Relation
# expect:    insert

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

INSERT {
  ?R2 a gsn:RelationshipWithConfidence ;
      schema:identifier ?relationshipId ;
      rdf:subject ?G ;
      rdf:predicate gsn:supportedBy ;
      rdf:object ?S2 ;
      gsn:associatedWith ?A ;
      gsn:assuranceClaimPoint true .
}
WHERE {
  ?R1 a gsn:RelationshipWithConfidence ;
      rdf:subject ?G ;
      rdf:object ?S1 ;
      gsn:associatedWith ?A .
  ?G a gsn:Goal ;
     gsn:supportedBy ?S1 , ?S2 ;
     schema:identifier ?idG .
  ?S1 a gsn:Goal .
  ?S2 a gsn:Goal ;
      schema:identifier ?idS2 .
  FILTER(?S1 != ?S2)
  BIND(CONCAT("RC-", ?idG, "-", ?idS2) AS ?relationshipId)
  BIND(CONCAT("RC-", REPLACE(STR(?G), "^.*[#/]", ""), "-", REPLACE(STR(?S2), "^.*[#/]", "")) AS ?iriKey)
  BIND(IRI(CONCAT(REPLACE(STR(?G), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?iriKey))) AS ?R2)
  FILTER NOT EXISTS {
    ?existing a gsn:RelationshipWithConfidence ;
              rdf:subject ?G ;
              rdf:object ?S2 .
  }
}
""" .

gsndesign:query-RL-GSN-goal_strategy_confidence
    a gsndesign:Query ;
    rdfs:label "RL-GSN-goal_strategy_confidence" ;
    skos:hiddenLabel "S43" ,
        "s43_goal_strategy_confidence.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
