    gsndesign:fileChecksum "7c09c6d3f70cdf8f6d8b322ddb510f5084421bea01f87a1198fb6f390bd72ff7" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:statement ,
        gsn:supportedBy ,
        gsn:top ;
    gsndesign:restsOnStatement gsndesign:st-0144 ,
        gsndesign:st-0161 ,
        gsndesign:st-0207 ,
