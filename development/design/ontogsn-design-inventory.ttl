gsndesign:query-RQ-AUG-context_revised
    a gsndesign:Query ;
    rdfs:label "RQ-AUG-context_revised" ;
    skos:hiddenLabel "fc41" ,
        "FC-41" ,
        "FC41" ,
        "CQ-83" ,
        "fc41_context_revised.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/RQ-AUG-context_revised.rq" ;
    gsndesign:fileChecksum "d5b71ac31679e3fc7ba517d5673786555cf120c976b83a84d790a18659d6388b" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/ns/prov#" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Context ,
        gsn:Goal ,
        gsn:inContextOf ,
        gsn:refersTo ,
        gsn:supportedBy ;
    gsndesign:restsOnStatement gsndesign:st-0161 ,
        gsndesign:st-0181 ,
        gsndesign:st-0207 ,
        gsndesign:st-0218 ,
        gsndesign:st-0289 ;
    gsndesign:answersQuestion gsndesign:cq-RQ-AUG-context_revised ;
    gsndesign:queryText """PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX prov:    <http://www.w3.org/ns/prov#>
PREFIX schema:  <http://schema.org/>

SELECT DISTINCT ?goalId ?contextId ?artefact ?newerArtefact
WHERE {
  ?context a gsn:Context ;
           schema:identifier ?contextId ;
           gsn:refersTo ?artefact .
  ?newerArtefact (gsnaug:replaces|prov:wasRevisionOf)+ ?artefact .
  FILTER NOT EXISTS { ?context gsn:refersTo ?newerArtefact }
  ?holder gsn:inContextOf ?context ;
          gsn:supportedBy* ?goal .
  ?goal a gsn:Goal ;
        schema:identifier ?goalId .
}
ORDER BY ?goalId ?contextId
""" .

gsndesign:query-RQ-AUG-element_revisions
    a gsndesign:Query ;
    rdfs:label "RQ-AUG-element_revisions" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/RQ-AUG-element_revisions.rq" ;
    gsndesign:fileChecksum "74020f2dce46f1f494d90e632124b0f4c6aaba75f099b4bb33bab7287b0f0727" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "http://www.w3.org/ns/prov#" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:GSNElement ,
        gsn:statement ;
    gsndesign:restsOnStatement gsndesign:st-0132 ,
        gsndesign:st-0265 ;
    gsndesign:answersQuestion gsndesign:cq-RQ-AUG-element_revisions ;
    gsndesign:queryText """PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX prov:    <http://www.w3.org/ns/prov#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema:  <http://schema.org/>

SELECT ?revisedId ?earlierId ?revisedStatement ?earlierStatement ?issueId
WHERE {
  ?revised prov:wasRevisionOf ?earlier ;
           a/rdfs:subClassOf* gsn:GSNElement ;
           schema:identifier ?revisedId .
  ?earlier schema:identifier ?earlierId .
  OPTIONAL { ?revised gsn:statement ?revisedStatement }
  OPTIONAL { ?earlier gsn:statement ?earlierStatement }
  OPTIONAL {
    ?issue gsnaug:raisedAgainst ?target ;
           schema:identifier ?issueId .
    FILTER(?target IN (?revised, ?earlier))
  }
}
ORDER BY ?revisedId ?earlierId
""" .

gsndesign:query-RQ-AUG-escalation_count
    a gsndesign:Query ;
    rdfs:label "RQ-AUG-escalation_count" ;
    skos:hiddenLabel "fc20" ,
        "FC-20" ,
        "FC20" ,
        "CQ-62" ,
        "fc20_escalation_count.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/RQ-AUG-escalation_count.rq" ;
    gsndesign:fileChecksum "13abdc05111667bc0e788ae00244b667f89db6fc33f8bb8ea6776f205100f812" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ;
    gsndesign:answersQuestion gsndesign:cq-RQ-AUG-escalation_count ;
    gsndesign:queryText """PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?originalId (COUNT(DISTINCT ?later) AS ?escalations)
WHERE {
  ?original a gsnaug:Issue ;
            schema:identifier ?originalId .
  FILTER NOT EXISTS { ?original gsnaug:supersedes ?earlier }

  ?later gsnaug:supersedes+ ?original ;
         gsnaug:supersedes ?predecessor .
  ?predecessor gsnaug:issueOutcome "cannot answer" .
}
GROUP BY ?originalId
ORDER BY DESC(?escalations)
""" .

