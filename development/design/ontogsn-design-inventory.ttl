    gsndesign:fileChecksum "f2d6c63fc897a0e357120d69f7f717a4bebb8cc49fa9bc48dd9b6c96ef734cce" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:Module ,
        gsn:contains ,
        gsn:supportedBy ,
        gsn:top ;
    gsndesign:ruleName "Goal Top Flag" ;
    gsndesign:translatesStatement gsndesign:st-0148 ;
    gsndesign:differsBy gsndesign:Retraction ,
        gsndesign:Guard ;
    gsndesign:restsOnStatement gsndesign:st-0144 ,
        gsndesign:st-0161 ,
        gsndesign:st-0207 ,
        gsndesign:st-0469 ,
        gsndesign:st-0474 ;
    gsndesign:queryText """# name:      Goal Top Flag
# expect:    change

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?A gsn:top ?old }
INSERT { ?A gsn:top false }
WHERE {
  ?A a gsn:Goal .
  ?X gsn:supportedBy ?A .
  FILTER NOT EXISTS {
    ?M a gsn:Module .
    ?M gsn:contains+ ?X .
    FILTER NOT EXISTS { ?M gsn:contains+ ?A }
  }
  OPTIONAL { ?A gsn:top ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

