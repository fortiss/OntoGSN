        "FC29" ,
        "CQ-71" ,
        "fc29_automated_evidence.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/RQ-AUG-automated_evidence.rq" ;
    gsndesign:fileChecksum "0a38e4df8193d99d397942b0a341bd4a91535074e92fb88af41aef6dd50c48ff" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Solution ,
        gsn:refersTo ;
    gsndesign:restsOnStatement gsndesign:st-0175 ,
        gsndesign:st-0289 ;
    gsndesign:answersQuestion gsndesign:cq-RQ-AUG-automated_evidence ;
    gsndesign:queryText """PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>

SELECT DISTINCT ?artefact ?mechanism ?source ?storage ?retrieval
WHERE {
  ?artefact gsnaug:generatedWith ?mechanism .
  ?mechanism gsnaug:automated true .
  ?solution a gsn:Solution ;
            gsn:refersTo ?artefact .
  OPTIONAL { ?artefact gsnaug:generatedFrom  ?source }
  OPTIONAL { ?artefact gsnaug:storedIn       ?storage }
  OPTIONAL { ?artefact gsnaug:retrievableWith ?retrieval }
}
ORDER BY ?artefact
""" .

gsndesign:query-RQ-AUG-automation_feasibility
    a gsndesign:Query ;
    rdfs:label "RQ-AUG-automation_feasibility" ;
    skos:hiddenLabel "fc36" ,
        "FC-36" ,
        "FC36" ,
        "CQ-78" ,
        "fc36_automation_feasibility.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/queries/RQ-AUG-automation_feasibility.rq" ;
    gsndesign:fileChecksum "1dc946a2d1139eea745545ed6fa6d69c45e4fd178956e6aa332465615087bf1b" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Solution ,
        gsn:refersTo ;
    gsndesign:restsOnStatement gsndesign:st-0175 ,
        gsndesign:st-0289 ;
    gsndesign:answersQuestion gsndesign:cq-RQ-AUG-automation_feasibility ;
    gsndesign:queryText """PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?solutionId ?artefact ?mechanism ?assessment
WHERE {
  ?solution a gsn:Solution ;
            schema:identifier ?solutionId ;
            gsn:refersTo ?artefact .
  OPTIONAL {
    ?artefact gsnaug:generatedWith ?mechanism .
    OPTIONAL { ?mechanism gsnaug:automated ?automated }
  }
  BIND( IF(!BOUND(?mechanism),  "not assessed",
        IF(!BOUND(?automated),  "mechanism named, not flagged",
        IF(?automated,          "automated",
                                "assessed: manual"))) AS ?assessment )
}
ORDER BY ?solutionId
""" .

