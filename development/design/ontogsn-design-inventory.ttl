        gsndesign:st-0188 ,
        gsndesign:st-0207 ,
        gsndesign:st-0218 ;
    gsndesign:queryText """# name:      Context Inheritance
# expect:    insert

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

INSERT { ?C gsn:inContextOf ?A }
WHERE {
  ?A a gsn:Assumption .
  ?C a gsn:Goal .
  ?B gsn:supportedBy ?C ;
     gsn:inContextOf ?A .
  FILTER NOT EXISTS { ?C gsn:inContextOf ?A }
}
""" .

gsndesign:query-RL-GSN-context_relation_creation
    a gsndesign:Query ;
    rdfs:label "RL-GSN-context_relation_creation" ;
    skos:hiddenLabel "S19" ,
        "s19_context_relation_creation.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/RL-GSN-context_relation_creation.rq" ;
    gsndesign:fileChecksum "5a259eff23f1c32f442a190b9c323efd449e9432379bee70fe8093c5b3ee7a17" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Relationship ,
        gsn:inContextOf ;
    gsndesign:ruleName "Context Relation Creation" ;
    gsndesign:translatesStatement gsndesign:st-1074 ;
    gsndesign:differsBy gsndesign:Guard ,
        gsndesign:NodeContent ;
    gsndesign:restsOnStatement gsndesign:st-0218 ,
        gsndesign:st-0291 ;
    gsndesign:queryText """# name:      Context Relation Creation
# expect:    insert

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

INSERT {
  ?R a gsn:Relationship ;
     schema:identifier ?relationshipId ;
     rdf:subject ?A ;
     rdf:predicate gsn:inContextOf ;
     rdf:object ?B .
}
WHERE {
  ?A gsn:inContextOf ?B ;
     schema:identifier ?idA .
  ?B schema:identifier ?idB .
  BIND(CONCAT("R-", ?idA, "-inContextOf-", ?idB) AS ?relationshipId)
  BIND(CONCAT("R-", REPLACE(STR(?A), "^.*[#/]", ""), "-inContextOf-", REPLACE(STR(?B), "^.*[#/]", "")) AS ?iriKey)
  BIND(IRI(CONCAT(REPLACE(STR(?A), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?iriKey))) AS ?R)
  FILTER NOT EXISTS {
    ?existing rdf:subject ?A ;
              rdf:predicate gsn:inContextOf ;
              rdf:object ?B .
  }
}
""" .

gsndesign:query-RL-GSN-contextual_relation
    a gsndesign:Query ;
    rdfs:label "RL-GSN-contextual_relation" ;
    skos:hiddenLabel "S2" ,
        "s02_contextual_relation.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/RL-GSN-contextual_relation.rq" ;
    gsndesign:fileChecksum "3a550786f9af82db11d45f5a1b7bc17327cf5e52e353156486c0dae296cd439c" ;
    gsndesign:declaresNamespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:inContextOf ,
        gsn:relationshipType ;
    gsndesign:ruleName "Contextual Relation" ;
    gsndesign:translatesStatement gsndesign:st-0127 ;
    gsndesign:differsBy gsndesign:Retraction ;
    gsndesign:restsOnStatement gsndesign:st-0120 ,
        gsndesign:st-0218 ;
    gsndesign:queryText """# name:      Contextual Relation
# expect:    insert

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DELETE { ?R gsn:relationshipType ?old }
INSERT { ?R gsn:relationshipType "contextual" }
WHERE {
  ?R rdf:subject ?A ;
     rdf:object ?B .
  ?A gsn:inContextOf ?B .
  OPTIONAL { ?R gsn:relationshipType ?old }
  FILTER(!BOUND(?old) || ?old != "contextual")
}
""" .

gsndesign:query-RL-GSN-contract_activation
    a gsndesign:Query ;
    rdfs:label "RL-GSN-contract_activation" ;
    skos:hiddenLabel "S30" ,
        "s30_contract_activation.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
