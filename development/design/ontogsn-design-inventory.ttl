    gsndesign:path "augmentation/derivations/RL-AUG-rule_mechanism_reads.rq" ;
    gsndesign:fileChecksum "9ce53ea0b8abe5ac045897d9d42dd26ecb99a87e6f99b9e92ef6afb9a42c61ca" ;
    gsndesign:declaresNamespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "http://www.w3.org/2003/11/swrl#" ,
        "https://w3id.org/OntoGSN/augmentation#" ;
    gsndesign:ruleName "Rule Mechanism Reads" ;
    gsndesign:queryText """# name:      Rule Mechanism Reads

PREFIX gsnaug: <https://w3id.org/OntoGSN/augmentation#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX swrl:   <http://www.w3.org/2003/11/swrl#>

INSERT { ?mechanism gsnaug:readsTerm ?term }
WHERE {
  ?definition a swrl:Imp ;
              gsnaug:implements ?mechanism ;
              swrl:body/rdf:rest*/rdf:first ?atom .
  ?mechanism a gsnaug:Mechanism .
  ?atom swrl:classPredicate|swrl:propertyPredicate ?term .
  FILTER ( isIRI(?term) )
}
""" .

gsndesign:query-RL-AUG-rule_mechanism_writes
    a gsndesign:Query ;
    rdfs:label "RL-AUG-rule_mechanism_writes" ;
    skos:hiddenLabel "D3" ,
        "d03_rule_mechanism_writes.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/derivations/RL-AUG-rule_mechanism_writes.rq" ;
    gsndesign:fileChecksum "080ada7e167fde5940d80dcdceeb5970e7cad0db874548663f8634b013552030" ;
    gsndesign:declaresNamespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "http://www.w3.org/2003/11/swrl#" ,
        "https://w3id.org/OntoGSN/augmentation#" ;
    gsndesign:ruleName "Rule Mechanism Writes" ;
    gsndesign:queryText """# name:      Rule Mechanism Writes

PREFIX gsnaug: <https://w3id.org/OntoGSN/augmentation#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX swrl:   <http://www.w3.org/2003/11/swrl#>

INSERT { ?mechanism gsnaug:writesTerm ?term }
WHERE {
  ?definition a swrl:Imp ;
              gsnaug:implements ?mechanism ;
              swrl:head/rdf:rest*/rdf:first ?atom .
  ?mechanism a gsnaug:Mechanism .
  ?atom swrl:classPredicate|swrl:propertyPredicate ?term .
  FILTER ( isIRI(?term) )
}
""" .

gsndesign:query-RL-AUG-shape_mechanism_reads
    a gsndesign:Query ;
    rdfs:label "RL-AUG-shape_mechanism_reads" ;
    skos:hiddenLabel "D1" ,
        "d01_shape_mechanism_reads.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/derivations/RL-AUG-shape_mechanism_reads.rq" ;
    gsndesign:fileChecksum "ed76a20d351453596d0d60f147a7eab8c932105ddf1b123d5904b3e9e5cb8e03" ;
    gsndesign:declaresNamespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "http://www.w3.org/ns/shacl#" ,
        "https://w3id.org/OntoGSN/augmentation#" ;
    gsndesign:ruleName "Shape Mechanism Reads" ;
    gsndesign:queryText """# name:      Shape Mechanism Reads

PREFIX gsnaug: <https://w3id.org/OntoGSN/augmentation#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX sh:     <http://www.w3.org/ns/shacl#>

INSERT { ?mechanism gsnaug:readsTerm ?term }
WHERE {
  ?definition gsnaug:implements ?mechanism ;
              a ?shapeType .
  ?mechanism a gsnaug:Mechanism .
  FILTER ( ?shapeType IN ( sh:NodeShape, sh:PropertyShape ) )

  ?definition ( sh:property | sh:node | sh:not | (sh:and|sh:or|sh:xone)/rdf:rest*/rdf:first )* ?shape .

  {
    ?shape sh:targetClass|sh:targetSubjectsOf|sh:targetObjectsOf|sh:class ?term .
  } UNION {
    ?shape sh:path ?path .
    ?path ( sh:inversePath | sh:zeroOrMorePath | sh:oneOrMorePath | sh:zeroOrOnePath
          | sh:alternativePath/rdf:rest*/rdf:first | rdf:rest*/rdf:first )* ?term .
  }
  FILTER ( isIRI(?term) )
}
""" .

gsndesign:query-RL-GSN-assumption_false_propagation
    a gsndesign:Query ;
    rdfs:label "RL-GSN-assumption_false_propagation" ;
    skos:hiddenLabel "S16" ,
        "s16_assumption_false_propagation.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "ontology/queries/rules/RL-GSN-assumption_false_propagation.rq" ;
    gsndesign:fileChecksum "3ae725c091c074b5c7040dd4ce74c89318693cc38f96d0101515fabed163b201" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Assumption ,
        gsn:inContextOf ,
        gsn:true ;
    gsndesign:ruleName "Assumption False Propagation" ;
    gsndesign:translatesStatement gsndesign:st-0254 ;
    gsndesign:differsBy gsndesign:Retraction ;
    gsndesign:restsOnStatement gsndesign:st-0188 ,
        gsndesign:st-0218 ,
        gsndesign:st-0234 ;
    gsndesign:queryText """# name:      Assumption False Propagation
# expect:    insert

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?B gsn:true ?old }
INSERT { ?B gsn:true false }
WHERE {
  ?A a gsn:Assumption ;
     gsn:true ?tA .
  FILTER(STR(?tA) = "false")
  ?B gsn:inContextOf ?A .
  OPTIONAL { ?B gsn:true ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

