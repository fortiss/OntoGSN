#################################################################
#    Stored queries (165)
#    The IRI and the label of a query are its ID, which is also its file name.
#    skos:hiddenLabel keeps each ID and file name that the ID replaced, so an old name
#    still finds the query.
#    
#    gsndesign:declaresNamespace records what each file binds its prefixes to, which is
#    how a query pointing at the wrong namespace becomes findable.
#    
#    gsndesign:queryText holds the query verbatim, so the record says what was asked at
#    a given version without the file having to still exist. gsndesign:fileChecksum is
#    what detects that it changed.
#    
#    Two links reach back into the ontology, and they are not the same strength.
#    gsndesign:translatesStatement joins each file under ontology/queries/rules/ to the SWRL
#    rule that it re-expresses for a store with no reasoner, and the join is the rule's
#    name. gsndesign:differsBy says where the update does what the rule cannot: it
#    retracts an old value, or it has a guard. gsndesign:restsOnStatement is weaker and derived: the
#    axiom declaring each gsn: term the query names. Either way the target is a
#    StatementRecord, so one hop further reaches why that axiom exists at all.
#################################################################

gsndesign:query-RL-AUG-conforming_part_report_confirms_solution
    a gsndesign:Query ;
    rdfs:label "RL-AUG-conforming_part_report_confirms_solution" ;
    skos:hiddenLabel "A6c" ,
        "a06c_conforming_part_report_confirms_solution.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/rules/RL-AUG-conforming_part_report_confirms_solution.rq" ;
    gsndesign:fileChecksum "e0c03ba29613549bc28fa33a128277376dd4761d912403e35ffcda495ce32511" ;
    gsndesign:declaresNamespace "http://www.w3.org/ns/prov#" ,
        "http://www.w3.org/ns/shacl#" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Artefact ,
        gsn:Solution ,
        gsn:refersTo ,
        gsn:true ;
    gsndesign:ruleName "Conforming Part Report Confirms Solution" ;
    gsndesign:restsOnStatement gsndesign:st-0111 ,
        gsndesign:st-0175 ,
        gsndesign:st-0234 ,
        gsndesign:st-0289 ;
    gsndesign:queryText """# name:      Conforming Part Report Confirms Solution

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug: <https://w3id.org/OntoGSN/augmentation#>
PREFIX prov:   <http://www.w3.org/ns/prov#>
PREFIX sh:     <http://www.w3.org/ns/shacl#>

DELETE {
  ?S gsn:true ?old .
}
INSERT {
  ?S gsn:true true .
}
WHERE {
  ?S a gsn:Solution ;
     gsn:refersTo ?A .
  ?A a gsn:Artefact .
  ?P a gsnaug:ArtefactPart ;
     gsnaug:partOf ?A ;
     gsnaug:checkableWith ?M .
  {
    SELECT DISTINCT (?Mc AS ?M) (?Tc AS ?P) WHERE {
      {
        ?Mc gsnaug:decides "truth" .
        ?Rc a sh:ValidationReport ;
            prov:wasGeneratedBy ?Mc ;
            prov:used ?Tc ;
            sh:conforms ?c ;
            prov:generatedAtTime ?tc .
        FILTER NOT EXISTS { ?Rc prov:invalidatedAtTime|prov:wasInvalidatedBy ?struck }
        {
          SELECT DISTINCT ?Mc ?Tc (MAX(?tn) AS ?latest) WHERE {
            ?Rn a sh:ValidationReport ;
                prov:wasGeneratedBy ?Mc ;
                prov:used ?Tc ;
                prov:generatedAtTime ?tn .
            FILTER NOT EXISTS { ?Rn prov:invalidatedAtTime|prov:wasInvalidatedBy ?struckNewer }
          } GROUP BY ?Mc ?Tc
        }
        FILTER(?tc >= ?latest)
      } UNION {
        ?Mc gsnaug:decides "truth" .
        ?Rc a sh:ValidationReport ;
            prov:wasGeneratedBy ?Mc ;
            prov:used ?Tc ;
            sh:conforms ?c .
        FILTER NOT EXISTS { ?Rc prov:invalidatedAtTime|prov:wasInvalidatedBy ?struck }
        FILTER NOT EXISTS { ?Rc prov:generatedAtTime ?untimed }
      }
      FILTER(STR(?c) = "true")
    }
  }
  FILTER(EXISTS { ?S gsn:refersTo ?P } || NOT EXISTS { ?S gsn:refersTo ?namedPart . ?namedPart gsnaug:partOf ?A })
  MINUS {
    ?S gsn:refersTo ?A2 .
    ?A2 gsnaug:checkableWith ?M2 .
    {
      SELECT DISTINCT (?Mc AS ?M2) (?Tc AS ?A2) WHERE {
        {
          ?Mc gsnaug:decides "truth" .
          ?Rc a sh:ValidationReport ;
              prov:wasGeneratedBy ?Mc ;
              prov:used ?Tc ;
              sh:conforms ?c ;
              prov:generatedAtTime ?tc .
          FILTER NOT EXISTS { ?Rc prov:invalidatedAtTime|prov:wasInvalidatedBy ?struck }
          {
            SELECT DISTINCT ?Mc ?Tc (MAX(?tn) AS ?latest) WHERE {
              ?Rn a sh:ValidationReport ;
                  prov:wasGeneratedBy ?Mc ;
                  prov:used ?Tc ;
                  prov:generatedAtTime ?tn .
              FILTER NOT EXISTS { ?Rn prov:invalidatedAtTime|prov:wasInvalidatedBy ?struckNewer }
            } GROUP BY ?Mc ?Tc
          }
          FILTER(?tc >= ?latest)
        } UNION {
          ?Mc gsnaug:decides "truth" .
          ?Rc a sh:ValidationReport ;
              prov:wasGeneratedBy ?Mc ;
              prov:used ?Tc ;
              sh:conforms ?c .
          FILTER NOT EXISTS { ?Rc prov:invalidatedAtTime|prov:wasInvalidatedBy ?struck }
          FILTER NOT EXISTS { ?Rc prov:generatedAtTime ?untimed }
        }
        FILTER(STR(?c) = "false")
      }
    }
  }
  MINUS {
    ?S gsn:refersTo ?A2 .
    ?T2 gsnaug:partOf ?A2 ;
        gsnaug:checkableWith ?M2 .
    FILTER(EXISTS { ?S gsn:refersTo ?T2 } || NOT EXISTS { ?S gsn:refersTo ?namedPart . ?namedPart gsnaug:partOf ?A2 })
    {
      SELECT DISTINCT (?Mc AS ?M2) (?Tc AS ?T2) WHERE {
        {
          ?Mc gsnaug:decides "truth" .
          ?Rc a sh:ValidationReport ;
              prov:wasGeneratedBy ?Mc ;
              prov:used ?Tc ;
              sh:conforms ?c ;
              prov:generatedAtTime ?tc .
          FILTER NOT EXISTS { ?Rc prov:invalidatedAtTime|prov:wasInvalidatedBy ?struck }
          {
            SELECT DISTINCT ?Mc ?Tc (MAX(?tn) AS ?latest) WHERE {
              ?Rn a sh:ValidationReport ;
                  prov:wasGeneratedBy ?Mc ;
                  prov:used ?Tc ;
                  prov:generatedAtTime ?tn .
              FILTER NOT EXISTS { ?Rn prov:invalidatedAtTime|prov:wasInvalidatedBy ?struckNewer }
            } GROUP BY ?Mc ?Tc
          }
          FILTER(?tc >= ?latest)
        } UNION {
          ?Mc gsnaug:decides "truth" .
          ?Rc a sh:ValidationReport ;
              prov:wasGeneratedBy ?Mc ;
              prov:used ?Tc ;
              sh:conforms ?c .
          FILTER NOT EXISTS { ?Rc prov:invalidatedAtTime|prov:wasInvalidatedBy ?struck }
          FILTER NOT EXISTS { ?Rc prov:generatedAtTime ?untimed }
        }
        FILTER(STR(?c) = "false")
      }
    }
  }
  OPTIONAL { ?S gsn:true ?old }
  FILTER(!BOUND(?old) || STR(?old) != "true")
}
""" .

