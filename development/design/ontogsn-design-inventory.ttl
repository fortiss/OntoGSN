    gsndesign:queryText """# name:      Solution Propagation (False)
# expect:    insert

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?B gsn:true ?old }
INSERT { ?B gsn:true false }
WHERE {
  ?A a gsn:Solution ;
     gsn:true ?tA .
  FILTER(STR(?tA) = "false")
