    gsndesign:queryText """PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>
PREFIX prov:    <http://www.w3.org/ns/prov#>

SELECT ?cycleId ?issueId ?targetId ?outcome ?opened
