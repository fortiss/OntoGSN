}
""" .

gsndesign:query-RL-AUG-resolve_issue_defeats_goal
    a gsndesign:Query ;
    rdfs:label "RL-AUG-resolve_issue_defeats_goal" ;
    skos:hiddenLabel "A3a" ,
        "a03a_resolve_issue_defeats_goal.rq" ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:path "augmentation/rules/RL-AUG-resolve_issue_defeats_goal.rq" ;
    gsndesign:fileChecksum "dd8c71a04fd431c7add322a340a7e0bc398f557cc690988d8668677e22b4810a" ;
    gsndesign:declaresNamespace "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:challenges ,
        gsn:defeated ;
    gsndesign:ruleName "Resolve Issue Defeats Goal" ;
    gsndesign:restsOnStatement gsndesign:st-0161 ,
        gsndesign:st-0696 ,
        gsndesign:st-0699 ,
        gsndesign:st-0740 ;
    gsndesign:queryText """# name:      Resolve Issue Defeats Goal

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug: <https://w3id.org/OntoGSN/augmentation#>

DELETE { ?E gsn:defeated ?old }
INSERT { ?E gsn:defeated true }
WHERE {
  ?I a gsnaug:Issue ;
     gsnaug:issueType gsnaug:resolve ;
     gsnaug:raisedAgainst ?E .
  ?E a gsn:Goal .
  OPTIONAL { ?E gsn:defeated ?old }
  FILTER(!BOUND(?old) || STR(?old) != "true")
} ;

INSERT {
  ?I a gsn:Goal ;
     gsn:challenges ?E .
}
WHERE {
  ?I a gsnaug:Issue ;
     gsnaug:issueType gsnaug:resolve ;
     gsnaug:raisedAgainst ?E .
  ?E a gsn:Goal .
  FILTER NOT EXISTS { ?I gsn:challenges ?E }
}
""" .

