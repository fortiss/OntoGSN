    gsndesign:fileChecksum "8b33dbc3d87167c73098826922200f1a549cccba7a459e76a9e842258c4b4233" ;
    gsndesign:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsndesign:mentionsTerm gsn:Goal ,
        gsn:away ,
        gsn:statement ,
        gsn:supportedBy ,
        gsn:toBeSupportedByContract ,
        gsn:undeveloped ;
    gsndesign:restsOnStatement gsndesign:st-0161 ,
        gsndesign:st-0200 ,
        gsndesign:st-0207 ,
        gsndesign:st-0265 ,
        gsndesign:st-0490 ,
