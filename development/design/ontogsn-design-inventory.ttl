    gsndesign:answersQuestion gsndesign:cq-RQ-GSN-elements_unreachable_from_top_goal ;
    gsndesign:queryText """# expect: rows

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

SELECT ?elementId ?type ?statement
WHERE {
  ?element a ?type ;
           schema:identifier ?elementId .
  ?type rdfs:subClassOf* gsn:GSNElement .
  OPTIONAL { ?element gsn:statement ?statement }

  FILTER NOT EXISTS {
    ?top a gsn:Goal ;
         gsn:top ?t .
    FILTER(STR(?t) = "true")
    ?top (gsn:supportedBy|gsn:inContextOf|gsn:refersTo)* ?element .
  }
}
ORDER BY ?elementId
""" .

