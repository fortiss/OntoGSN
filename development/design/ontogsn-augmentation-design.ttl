gsnaugdesign:dd-0026
    a gsndesign:DesignDecision ;
    gsndesign:formalism gsndesign:SHACL ;
    gsndesign:naturalLanguage "Every range declared in the vocabulary is repeated as a shape, because a range infers a type rather than rejecting a wrong one."@en ;
    gsndesign:noSourceRecorded "true"^^xsd:boolean ;
    gsndesign:hasRationale gsnaugdesign:why-0018 ;
    prov:generated gsnaugdesign:st-0026 .

