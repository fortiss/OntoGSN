gsnaugdesign:dd-0029
    a gsndesign:RetiredDecision ;
    gsndesign:retirementReason "Retired at 0.3.1: simplification of classes and relations. The answer subclasses are gone, so there is nothing left to pair."@en ;
    gsndesign:supersededBy gsnaugdesign:dd-0059 ;
    gsndesign:formalism gsndesign:SHACL ;
    gsndesign:naturalLanguage "The shape pairing each kind of answer with its kind of issue is one flat filter, because neither of the two natural ways to write it works."@en ;
    prov:used gsnaugdesign:src-0005 ;
    gsndesign:hasRationale gsnaugdesign:why-0021 ;
    prov:generated gsnaugdesign:st-0029 .

