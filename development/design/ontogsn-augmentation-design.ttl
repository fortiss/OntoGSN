    a gsndesign:RetiredDecision ;
    gsndesign:retirementReason """Withdrawn at 0.2.0 with gsnaugsh:TopContextCompletenessShape. A shape that ships switched off and whose classes no longer exist constrains nothing at all."""@en ;
    gsndesign:supersededBy gsnaugdesign:dd-0041 ;
