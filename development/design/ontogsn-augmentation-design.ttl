gsnaugdesign:dd-0059
    a gsndesign:DesignDecision ;
    gsndesign:formalism gsndesign:SHACL ;
    gsndesign:naturalLanguage "The shapes follow the simplified vocabulary: the shape for each withdrawn term goes, one for each new term comes, and the closure test reads the outcome string."@en ;
    gsndesign:noSourceRecorded "true"^^xsd:boolean ;
    gsndesign:hasRationale gsnaugdesign:why-0042 ;
    prov:generated gsnaugdesign:st-0059 .

gsnaugdesign:st-0059
    a gsndesign:StatementRecord ;
    prov:wasGeneratedBy gsnaugdesign:dd-0059 ;
    gsndesign:inGraph gsnaugdesign:augmentation-shapes-0.3.1 ;
    gsndesign:statementText "gsnaugsh:AnswerAgreementShape is removed, and gsnaugsh:AnswerShape no longer constrains gsnaug:accepted. gsnaugsh:IssueShape constrains gsnaug:issueType to the three individuals and gsnaug:issueOutcome to the four strings. gsnaugsh:IssueClosureShape reports an answer on an issue whose outcome is not \"resolved\". gsnaugsh:ArtefactShape constrains the six mechanism properties to gsnaug:Mechanism, gsnaug:storedIn to gsnaug:System and gsnaug:replaces to gsn:Artefact. gsnaugsh:ArtefactPartShape, gsnaugsh:AccountabilityShape and gsnaugsh:LinkShape are added. gsnaugsh:AgentShape covers gsnaug:hasRole only, and gsnaugsh:AssuranceScopeShape also checks its subject." ;
    gsndesign:aboutTerm gsnaugsh:IssueShape ;
    gsndesign:mentionsTerm gsnaug:issueOutcome , gsnaug:issueType , gsnaug:replaces , gsnaugsh:AccountabilityShape ,
        gsnaugsh:AgentShape , gsnaugsh:AnswerShape , gsnaugsh:ArtefactPartShape , gsnaugsh:ArtefactShape ,
        gsnaugsh:AssuranceScopeShape , gsnaugsh:IssueClosureShape , gsnaugsh:IssueShape , gsnaugsh:LinkShape .

gsnaugdesign:dd-0060
    a gsndesign:DesignDecision ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:naturalLanguage "The twelve stored queries that read a withdrawn term are rewritten to the simplified one, and an open ask is one with neither an outcome nor an answer."@en ;
    gsndesign:noSourceRecorded "true"^^xsd:boolean ;
    gsndesign:hasRationale gsnaugdesign:why-0042 ;
    prov:generated gsnaugdesign:st-0060 .

gsnaugdesign:st-0060
    a gsndesign:StatementRecord ;
    prov:wasGeneratedBy gsnaugdesign:dd-0060 ;
    gsndesign:inGraph gsnaugdesign:augmentation-queries-0.3.1 ;
    gsndesign:statementText "augmentation/queries/fc13, fc14, fc16, fc19, fc20, fc23, fc24, fc26, fc27, fc30, fc31, fc32: gsnaug:accepted, gsnaug:Clarification, gsnaug:Revision, gsnaug:Resolution, gsnaug:revisionOf and the three outcome concepts are replaced; an open ask is FILTER NOT EXISTS { ?answer gsnaug:answers ?issue } ." ;
    gsndesign:aboutTerm gsnaug:answers ;
    gsndesign:mentionsTerm gsnaug:Answer , gsnaug:answers , gsnaug:issueOutcome , gsnaug:replaces .

gsnaugdesign:dd-0061
    a gsndesign:DesignDecision ;
    gsndesign:formalism gsndesign:OWL ;
    gsndesign:naturalLanguage "A mechanism names the domain terms it reads and writes. A mechanism that is a shape, a rule or a query is that node, typed as both."@en ;
    gsndesign:noSourceRecorded "true"^^xsd:boolean ;
    gsndesign:hasRationale gsnaugdesign:why-0043 ;
    prov:generated gsnaugdesign:st-0061 .

