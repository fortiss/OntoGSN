    a gsndesign:DesignDecision ;
    gsndesign:formalism gsndesign:OWL ;
    gsndesign:naturalLanguage "The eight provenance properties of an artefact also apply to a part of one; where it is stored and what it replaces do not."@en ;
    gsndesign:noSourceRecorded "true"^^xsd:boolean ;
    gsndesign:hasRationale gsnaugdesign:why-0046 ;
