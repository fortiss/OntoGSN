#    Decisions - the rules
#################################################################

gsnaugdesign:dd-0020
    a gsndesign:DesignDecision ;
    gsndesign:formalism gsndesign:SWRL ;
    gsndesign:naturalLanguage "An issue becomes a defeater only when it asks for a revision or a resolution and its target is a goal or a solution."@en ;
    prov:used gsnaugdesign:src-0002 ;
    gsndesign:hasRationale gsnaugdesign:why-0010 ;
    prov:generated gsnaugdesign:st-0020 .

gsnaugdesign:st-0020
    a gsndesign:StatementRecord ;
    prov:wasGeneratedBy gsnaugdesign:dd-0020 ;
    gsndesign:inGraph gsnaugdesign:augmentation-0.3.1 ;
    gsndesign:statementText "Four rules, and no fifth: A2a, A2b, A3a, A3b each test both the issue type and the class of the target. No rule fires on gsnaug:clarify, and none fires on a target that is neither gsn:Goal nor gsn:Solution." ;
    gsndesign:aboutTerm gsnaug:Issue ;
    gsndesign:mentionsTerm gsn:Goal , gsn:Solution , gsnaug:clarify , gsnaug:resolve , gsnaug:revise .

gsnaugdesign:dd-0021
    a gsndesign:DesignDecision ;
    gsndesign:formalism gsndesign:SWRL ;
    gsndesign:naturalLanguage "A revise issue against a claim becomes a true goal that challenges it, and nothing more."@en ;
    prov:used gsnaugdesign:src-0006 ;
    gsndesign:hasRationale gsnaugdesign:why-0011 ;
    prov:generated gsnaugdesign:st-0021 .

gsnaugdesign:st-0021
    a gsndesign:StatementRecord ;
    prov:wasGeneratedBy gsnaugdesign:dd-0021 ;
    gsndesign:inGraph gsnaugdesign:augmentation-0.3.1 ;
    gsndesign:statementText "Issue(?I) ^ issueType(?I, revise) ^ raisedAgainst(?I, ?E) ^ Goal(?E) -> Goal(?I) ^ true(?I, true) ^ challenges(?I, ?E)" ;
    gsndesign:aboutTerm gsnaug:ReviseIssueChallengesGoal ;
    gsndesign:mentionsTerm gsn:challenges , gsn:true , gsnaug:ReviseIssueChallengesGoal , gsnaug:ReviseIssueChallengesSolution .

gsnaugdesign:dd-0022
    a gsndesign:DesignDecision ;
    gsndesign:formalism gsndesign:SWRL ;
    gsndesign:naturalLanguage "A resolve issue against a claim asserts the defeat directly, because the rule that would otherwise derive it needs valid evidence and an issue is an ask."@en ;
    prov:used gsnaugdesign:src-0006 ;
    gsndesign:hasRationale gsnaugdesign:why-0011 ;
    prov:generated gsnaugdesign:st-0022 .

gsnaugdesign:st-0022
