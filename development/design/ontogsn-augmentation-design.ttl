    gsndesign:inGraph gsnaugdesign:augmentation-shapes-0.2.0 ;
    gsndesign:statementText "gsnaugsh:IssueClosureShape sh:sparql [ sh:select \"SELECT $this ?answer WHERE { $this gsnaug:issueOutcome ?outcome . ?answer gsnaug:answers $this ; gsnaug:accepted true . }\" ] ." ;
    gsndesign:aboutTerm gsnaugsh:IssueClosureShape ;
    gsndesign:mentionsTerm gsnaug:accepted , gsnaug:answers , gsnaug:issueOutcome , gsnaugsh:IssueClosureShape .


