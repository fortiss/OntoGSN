    gsndesign:statementText "Issue(?I) ^ issueType(?I, resolve) ^ raisedAgainst(?I, ?E) ^ Goal(?E) -> Goal(?I) ^ challenges(?I, ?E) ^ defeated(?E, true)" ;
    gsndesign:aboutTerm gsnaug:ResolveIssueDefeatsGoal ;
    gsndesign:mentionsTerm gsn:challenges , gsn:defeated , gsnaug:ResolveIssueDefeatsGoal , gsnaug:ResolveIssueDefeatsSolution .

gsnaugdesign:dd-0023
    a gsndesign:DesignDecision ;
    gsndesign:formalism gsndesign:SWRL ;
    gsndesign:naturalLanguage "Each of the two issue rules is written twice, once for a goal target and once for a solution target."@en ;
    gsndesign:noSourceRecorded "true"^^xsd:boolean ;
    gsndesign:hasRationale gsnaugdesign:why-0012 ;
    prov:generated gsnaugdesign:st-0023 .

