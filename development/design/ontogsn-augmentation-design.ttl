    gsndesign:aboutTerm gsnaugsh:AnswerAgreementShape ;
    gsndesign:mentionsTerm gsnaugsh:AnswerAgreementShape .

gsnaugdesign:dd-0030
    a gsndesign:DesignDecision ;
    gsndesign:formalism gsndesign:SHACL ;
    gsndesign:naturalLanguage "That an issue cannot supersede itself is checked by a shape as well as stated in the vocabulary."@en ;
    gsndesign:noSourceRecorded "true"^^xsd:boolean ;
    gsndesign:hasRationale gsnaugdesign:why-0025 ;
    prov:generated gsnaugdesign:st-0030 .

