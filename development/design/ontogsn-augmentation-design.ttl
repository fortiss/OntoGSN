    a gsndesign:StatementRecord ;
    prov:wasGeneratedBy gsnaugdesign:dd-0061 ;
    gsndesign:inGraph gsnaugdesign:augmentation-0.3.1 ;
    gsndesign:statementText "gsnaug:readsTerm, gsnaug:writesTerm a owl:ObjectProperty ; rdfs:domain gsnaug:Mechanism . No rdfs:range on either." ;
    gsndesign:aboutTerm gsnaug:readsTerm ;
    gsndesign:mentionsTerm gsnaug:Mechanism , gsnaug:readsTerm , gsnaug:writesTerm .

gsnaugdesign:dd-0062
    a gsndesign:DesignDecision ;
    gsndesign:formalism gsndesign:SHACL ;
    gsndesign:naturalLanguage "A term is an IRI that some loaded ontology declares, a script is one string, and only a mechanism carries either."@en ;
    prov:used gsnaugdesign:src-0005 ;
    gsndesign:hasRationale gsnaugdesign:why-0043 ;
    prov:generated gsnaugdesign:st-0062 .

gsnaugdesign:st-0062
    a gsndesign:StatementRecord ;
    prov:wasGeneratedBy gsnaugdesign:dd-0062 ;
    gsndesign:inGraph gsnaugdesign:augmentation-shapes-0.3.1 ;
    gsndesign:statementText "gsnaugsh:MechanismInterfaceShape targets the subjects of gsnaug:readsTerm, gsnaug:writesTerm and gsnaug:script; requires the subject to be a gsnaug:Mechanism; requires a term to be an IRI (violation) declared as a class or property by a loaded ontology (warning); requires a script to be one xsd:string (violation)." ;
    gsndesign:aboutTerm gsnaugsh:MechanismInterfaceShape ;
    gsndesign:mentionsTerm gsnaug:Mechanism , gsnaug:readsTerm , gsnaug:script , gsnaug:writesTerm ,
        gsnaugsh:MechanismInterfaceShape .

gsnaugdesign:dd-0063
    a gsndesign:DesignDecision ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:naturalLanguage "Two stored queries read the interface: one walks from a domain term to the claims that rest on it, the other sorts each mechanism under a solution into in the graph, script in the graph, declared by hand, or opaque."@en ;
    gsndesign:noSourceRecorded "true"^^xsd:boolean ;
    gsndesign:hasRationale gsnaugdesign:why-0043 ;
    prov:generated gsnaugdesign:st-0063 .

gsnaugdesign:st-0063
    a gsndesign:StatementRecord ;
    prov:wasGeneratedBy gsnaugdesign:dd-0063 ;
    gsndesign:inGraph gsnaugdesign:augmentation-queries-0.3.1 ;
    gsndesign:statementText "augmentation/queries/fc37_term_impact.rq (CQ-79): ?mechanism gsnaug:readsTerm ?term, then any of the six mechanism properties to the artefact, gsn:refersTo to the solution and gsn:supportedBy+ to the goals. augmentation/queries/fc38_inspectable_mechanisms.rq (CQ-80): per solution, artefact and mechanism, state = in the graph if the mechanism is typed sh:NodeShape, sh:PropertyShape, a sh:SPARQL*Executable, swrl:Imp or sp:Query; script in the graph if gsnaug:script is bound; terms declared by hand if only gsnaug:readsTerm is; else opaque." ;
    gsndesign:aboutTerm gsnaug:readsTerm ;
    gsndesign:mentionsTerm gsnaug:readsTerm , gsnaug:script .

gsnaugdesign:dd-0064
    a gsndesign:DesignDecision ;
    gsndesign:formalism gsndesign:OWL ;
    gsndesign:naturalLanguage "A mechanism that is code carries the text of its script as one string literal."@en ;
    gsndesign:noSourceRecorded "true"^^xsd:boolean ;
    gsndesign:hasRationale gsnaugdesign:why-0044 ;
    prov:generated gsnaugdesign:st-0064 .

gsnaugdesign:st-0064
    a gsndesign:StatementRecord ;
    prov:wasGeneratedBy gsnaugdesign:dd-0064 ;
    gsndesign:inGraph gsnaugdesign:augmentation-0.3.1 ;
    gsndesign:statementText "gsnaug:script a owl:DatatypeProperty ; rdfs:domain gsnaug:Mechanism ; rdfs:range xsd:string . gsnaugsh:MechanismInterfaceShape also targets the subjects of gsnaug:script and constrains it to one xsd:string. fc38_inspectable_mechanisms.rq reports a scripted mechanism as \"script in the graph\"." ;
    gsndesign:aboutTerm gsnaug:script ;
    gsndesign:mentionsTerm gsnaug:Mechanism , gsnaug:readsTerm , gsnaug:script ,
        gsnaugsh:MechanismInterfaceShape .

gsnaugdesign:dd-0065
    a gsndesign:DesignDecision ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:naturalLanguage "The terms a shape or rule mechanism reads, and the terms a rule mechanism writes, are derived from the node by SPARQL updates that have no SWRL twin."@en ;
    gsndesign:noSourceRecorded "true"^^xsd:boolean ;
    gsndesign:hasRationale gsnaugdesign:why-0045 ;
    prov:generated gsnaugdesign:st-0065 .

gsnaugdesign:st-0065
    a gsndesign:StatementRecord ;
    prov:wasGeneratedBy gsnaugdesign:dd-0065 ;
    gsndesign:inGraph gsnaugdesign:augmentation-derivations-0.3.1 ;
    gsndesign:statementText "augmentation/derivations/d01_shape_mechanism_reads.rq: a gsnaug:Mechanism typed sh:NodeShape or sh:PropertyShape readsTerm every IRI reached by sh:targetClass, sh:targetSubjectsOf, sh:targetObjectsOf, sh:class and sh:path (unwrapping sh:inversePath, sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath, sh:alternativePath and sequence lists) on itself and on shapes reached by sh:property, sh:node, sh:not, sh:and, sh:or, sh:xone. d02_rule_mechanism_reads.rq: a gsnaug:Mechanism typed swrl:Imp readsTerm every IRI swrl:classPredicate or swrl:propertyPredicate in its swrl:body. d03_rule_mechanism_writes.rq: the same over swrl:head, into gsnaug:writesTerm." ;
    gsndesign:aboutTerm gsnaug:readsTerm ;
    gsndesign:mentionsTerm gsnaug:Mechanism , gsnaug:readsTerm , gsnaug:writesTerm .

