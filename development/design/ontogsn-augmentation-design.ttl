    prov:wasGeneratedBy gsnaugdesign:dd-0024 ;
    gsndesign:inGraph gsnaugdesign:augmentation-0.1.0 ;
    gsndesign:statementText "Goal(?G) ^ top(?G, true) ^ inContextOf(?G, ?C) ^ TopObjectContext(?C) ^ refersTo(?C, ?S) -> assures(?G, ?S) ; and the matching rule for TopSubjectContext and requiredBy." ;
    gsndesign:aboutTerm gsnaug:TopObjectContextAssurance ;
    gsndesign:mentionsTerm gsnaug:TopObjectContextAssurance , gsnaug:TopSubjectContextRequirement , gsnaug:assures , gsnaug:requiredBy .

gsnaugdesign:dd-0025
    a gsndesign:DesignDecision ;
    gsndesign:formalism gsndesign:SPARQL ;
    gsndesign:naturalLanguage "Every SWRL rule is also written as a SPARQL update, so the augmentation runs without a reasoner."@en ;
