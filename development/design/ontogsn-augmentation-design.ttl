    gsndesign:statementText "gsnaugsh:IssueSupersessionShape sh:sparql [ sh:select \"SELECT $this WHERE { $this gsnaug:supersedes $this . }\" ] ." ;
    gsndesign:aboutTerm gsnaugsh:IssueSupersessionShape ;
    gsndesign:mentionsTerm gsnaug:supersedes , gsnaugsh:IssueSupersessionShape .

gsnaugdesign:dd-0038
    a gsndesign:RetiredDecision ;
    gsndesign:retirementReason "Retired at 0.3.1: simplification of classes and relations. The shapes follow the simplified terms."@en ;
    gsndesign:supersededBy gsnaugdesign:dd-0059 ;
    gsndesign:formalism gsndesign:SHACL ;
    gsndesign:naturalLanguage "The ranges and arities of the seven terms added for the compliance process are repeated as shapes, on the same reasoning as the first six."@en ;
    gsndesign:noSourceRecorded "true"^^xsd:boolean ;
    gsndesign:hasRationale gsnaugdesign:why-0018 ;
    prov:generated gsnaugdesign:st-0038 .

gsnaugdesign:st-0038
    a gsndesign:StatementRecord ;
    prov:wasGeneratedBy gsnaugdesign:dd-0038 ;
    gsndesign:inGraph gsnaugdesign:augmentation-shapes-0.2.0 ;
    gsndesign:statementText "gsnaugsh:IssueShape constrains gsnaug:issueOutcome to the three concepts and gsnaug:raisedIn, gsnaug:raisedBy and gsnaug:heldBy to their ranges, each at most once. gsnaugsh:AnswerShape constrains gsnaug:accepted to one boolean. gsnaugsh:ArtefactShape constrains gsnaug:revisionOf to gsn:Artefact. gsnaugsh:MechanismAutomationShape constrains gsnaug:automated to one boolean." ;
    gsndesign:aboutTerm gsnaugsh:IssueShape ;
    gsndesign:mentionsTerm gsnaug:accepted , gsnaug:automated , gsnaug:heldBy , gsnaug:issueOutcome ,
        gsnaug:raisedBy , gsnaug:raisedIn , gsnaug:revisionOf , gsnaugsh:MechanismAutomationShape .

gsnaugdesign:dd-0039
    a gsndesign:RetiredDecision ;
    gsndesign:retirementReason "Retired at 0.3.1: simplification of classes and relations. The closure shape now tests the outcome string instead of the withdrawn acceptance flag."@en ;
    gsndesign:supersededBy gsnaugdesign:dd-0059 ;
    gsndesign:formalism gsndesign:SHACL ;
    gsndesign:naturalLanguage "An issue closed both by an outcome and by an answer the raiser accepted is reported, because the two ways of ending an ask are exclusive."@en ;
    prov:used gsnaugdesign:src-0010 ;
    gsndesign:hasRationale gsnaugdesign:why-0033 ;
    prov:generated gsnaugdesign:st-0039 .

gsnaugdesign:st-0039
