    gsnprov:path "queries/rules/s24_cross_module_away_context.rq" ;
    gsnprov:fileChecksum "6d26e0c8e06c0ea25f96526bccfdbb6c5efc968b190375cda13d43b8b92fe617" ;
    gsnprov:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:away ,
        gsn:inContextOf ,
        gsn:inModule ;
    gsnprov:ruleName "Cross-Module Away Context" ;
    gsnprov:translatesStatement gsnprov:st-0497 ;
    gsnprov:restsOnStatement gsnprov:st-0218 ,
        gsnprov:st-0490 ,
        gsnprov:st-0944 ;
    gsnprov:queryText """# rule:      S24
# name:      Cross-Module Away Context
# section:   Modular Extension
# operation: rule
# expect:    insert
# swrl:      'in module'(?A, ?M) ^ 'in module'(?B, ?N) ^ Module(?N) ^ 'in context of'(?A, ?B) ^
#            Module(?M) ^ swrlb:notEqual(?M, ?N) -> away(?B, true)
# reads:     IF Module M contains A AND Module N contains B AND A is in context of B AND M and N
#            are distinct Modules THEN B is away (in another Module)

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?B gsn:away ?old }
INSERT { ?B gsn:away true }
WHERE {
  ?A gsn:inModule ?M .
  ?B gsn:inModule ?N .
  FILTER(?M != ?N)
  ?A gsn:inContextOf ?B .
  OPTIONAL { ?B gsn:away ?old }
  FILTER(!BOUND(?old) || STR(?old) != "true")
}
""" .

gsnprov:query-rules-s25-duplicate-identifier-invalidation
    a gsnprov:Query ;
    rdfs:label "rules/s25_duplicate_identifier_invalidation.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s25_duplicate_identifier_invalidation.rq" ;
    gsnprov:fileChecksum "3d7246b6888994413d5cd446913747d8751ae80a614761d637852db26b2c5262" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:inModule ,
        gsn:valid ;
    gsnprov:ruleName "Duplicate Identifier Invalidation" ;
    gsnprov:translatesStatement gsnprov:st-0499 ;
    gsnprov:restsOnStatement gsnprov:st-0114 ,
        gsnprov:st-0944 ;
    gsnprov:queryText """# rule:      S25
# name:      Duplicate Identifier Invalidation
# section:   Modular Extension
# operation: rule
# expect:    insert
# swrl:      'in module'(?B, ?M) ^ 'in module'(?A, ?M) ^ schema:identifier(?A, ?ID) ^ Module(?M) ^
#            swrlb:notEqual(?A, ?B) ^ schema:identifier(?B, ?ID) -> valid(?A, false) ^ valid(?B,
#            false)
# reads:     IF Module M contains both A and B AND A and B share the same schema identifier ID
#            AND A and B are distinct THEN A is NOT valid AND B is NOT valid

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

DELETE { ?target gsn:valid ?old }
INSERT { ?target gsn:valid false }
WHERE {
  ?A gsn:inModule ?M .
  ?B gsn:inModule ?M .
  ?A schema:identifier ?id .
  ?B schema:identifier ?id .
  FILTER(?A != ?B)
  VALUES ?slot { 1 2 }
  BIND(IF(?slot = 1, ?A, ?B) AS ?target)
  OPTIONAL { ?target gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsnprov:query-rules-s26-contract-violation-relation
    a gsnprov:Query ;
    rdfs:label "rules/s26_contract_violation_relation.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
