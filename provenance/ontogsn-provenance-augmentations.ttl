        gsnprov:st-0438 ,
        gsnprov:st-0444 ,
        gsnprov:st-0474 ;
    gsnprov:queryText """# rule:      S22
# name:      Template Undeveloped Invalidation (B)
# section:   Argument Pattern Extension
# operation: rule
# expect:    insert
# swrl:      Template(?A) ^ undeveloped(?R, true) ^ rdf:subject(?R, ?B) ^ published(?A, true) ^
#            contains(?A, ?B) -> valid(?A, false) ^ valid(?R, false)
# reads:     IF A is a Template AND there is an undeveloped Relation R whose subject is B AND A
#            is published and contains B THEN A is NOT valid AND R is NOT valid

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DELETE { ?target gsn:valid ?old }
INSERT { ?target gsn:valid false }
WHERE {
  ?A a gsn:Template ;
     gsn:published ?published ;
     gsn:contains ?B .
  FILTER(STR(?published) = "true")
  ?R gsn:undeveloped ?undeveloped ;
     rdf:subject ?B .
  FILTER(STR(?undeveloped) = "true")
  VALUES ?slot { 1 2 }
  BIND(IF(?slot = 1, ?A, ?R) AS ?target)
  OPTIONAL { ?target gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsnprov:query-rules-s23-cross-module-away-support
    a gsnprov:Query ;
    rdfs:label "rules/s23_cross_module_away_support.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s23_cross_module_away_support.rq" ;
    gsnprov:fileChecksum "58dd7e5308047b40daac6a67e067cf0dc60238f84149ca67a7aa466d9f411894" ;
    gsnprov:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:away ,
        gsn:inModule ,
        gsn:supportedBy ;
    gsnprov:ruleName "Cross-Module Away Support" ;
    gsnprov:translatesStatement gsnprov:st-0496 ;
    gsnprov:restsOnStatement gsnprov:st-0207 ,
        gsnprov:st-0490 ,
        gsnprov:st-0944 ;
    gsnprov:queryText """# rule:      S23
# name:      Cross-Module Away Support
# section:   Modular Extension
# operation: rule
# expect:    insert
# swrl:      'in module'(?A, ?M) ^ 'in module'(?B, ?N) ^ 'supported by'(?A, ?B) ^ Module(?N) ^
#            Module(?M) ^ swrlb:notEqual(?M, ?N) -> away(?B, true)
# reads:     IF M is a Module AND M contains A AND N is a Module AND N contains B AND A is
#            supported by B AND M and N are distinct THEN B is away (in another Module)

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?B gsn:away ?old }
INSERT { ?B gsn:away true }
WHERE {
  ?A gsn:inModule ?M .
  ?B gsn:inModule ?N .
  FILTER(?M != ?N)
  ?A gsn:supportedBy ?B .
  OPTIONAL { ?B gsn:away ?old }
  FILTER(!BOUND(?old) || STR(?old) != "true")
}
""" .

gsnprov:query-rules-s24-cross-module-away-context
    a gsnprov:Query ;
    rdfs:label "rules/s24_cross_module_away_context.rq"@en ;
