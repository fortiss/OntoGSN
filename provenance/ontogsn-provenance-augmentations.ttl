gsnprov:query-rules-s05-goal-inference
    a gsnprov:Query ;
    rdfs:label "rules/s05_goal_inference.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s05_goal_inference.rq" ;
    gsnprov:fileChecksum "ded354f840d46de207ecdea2c5e4705a5d45221f7254d9f80eed2d83e77ff2c7" ;
    gsnprov:declaresNamespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Goal ,
        gsn:relationshipType ,
