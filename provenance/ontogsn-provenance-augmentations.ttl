gsnprov:query-rules-s40-confidence-relation-creation
    a gsnprov:Query ;
    rdfs:label "rules/s40_confidence_relation_creation.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s40_confidence_relation_creation.rq" ;
    gsnprov:fileChecksum "472dec8dd39f5f932ad411a13ac274fb3c60ed4c15bb36ef3f9669e6cc0f210e" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:ArtefactReference ,
        gsn:RelationshipWithConfidence ,
        gsn:assuranceClaimPoint ;
    gsnprov:ruleName "Confidence Relation Creation" ;
    gsnprov:translatesStatement gsnprov:st-0663 ;
    gsnprov:restsOnStatement gsnprov:st-0287 ,
        gsnprov:st-0635 ,
        gsnprov:st-0648 ;
    gsnprov:queryText """# rule:      S40
# name:      Confidence Relation Creation
# section:   Confidence Argument Extension
# operation: rule
# expect:    insert
# swrl:      'assurance claim point'(?A, true) ^ 'Artefact Reference'(?A) ^
#            swrlx:makeOWLThing(?A, ?R) -> 'Relationship with Confidence'(?R) ^ rdf:subject(?R,
#            ?A) ^ 'assurance claim point'(?R, true)
# reads:     IF A is an Artefact Reference marked as an assurance claim point AND we introduce a
#            reified confidence Relationship R for A THEN R is a Relationship with Confidence
#            whose subject is A and which is itself an assurance claim point

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

INSERT {
  ?R a gsn:RelationshipWithConfidence ;
     schema:identifier ?relationshipId ;
     rdf:subject ?A ;
     gsn:assuranceClaimPoint true .
}
WHERE {
  ?A a/rdfs:subClassOf* gsn:ArtefactReference ;
     gsn:assuranceClaimPoint ?acp ;
     schema:identifier ?idA .
  FILTER(STR(?acp) = "true")
  BIND(CONCAT("RC-", ?idA) AS ?relationshipId)
  BIND(IRI(CONCAT(REPLACE(STR(?A), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?relationshipId))) AS ?R)
  FILTER NOT EXISTS {
    ?existing a gsn:RelationshipWithConfidence ;
              rdf:subject ?A .
  }
}
""" .

gsnprov:query-rules-s41-duplicate-name-invalidation
    a gsnprov:Query ;
    rdfs:label "rules/s41_duplicate_name_invalidation.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s41_duplicate_name_invalidation.rq" ;
    gsnprov:fileChecksum "5b588c776933e76d5768cda6f41f424989e2991b1669702eb9e107be91e6cc58" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:valid ;
    gsnprov:ruleName "Duplicate Name Invalidation" ;
    gsnprov:translatesStatement gsnprov:st-0665 ;
    gsnprov:restsOnStatement gsnprov:st-0114 ;
    gsnprov:queryText """# rule:      S41
# name:      Duplicate Name Invalidation
# section:   Confidence Argument Extension
# operation: rule
# expect:    insert
# swrl:      schema:identifier(?A, ?N) ^ schema:identifier(?B, ?M) ^ swrlb:notEqual(?A, ?B) ^
#            swrlb:equal(?N, ?M) -> valid(?A, false) ^ valid(?B, false)
# reads:     IF A has schema identifier N AND B has schema identifier M AND A and B are distinct
#            AND N and M are equal THEN A is NOT valid AND B is NOT valid

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

DELETE { ?target gsn:valid ?old }
INSERT { ?target gsn:valid false }
WHERE {
  ?A schema:identifier ?id .
  ?B schema:identifier ?id .
  FILTER(?A != ?B)
  VALUES ?slot { 1 2 }
  BIND(IF(?slot = 1, ?A, ?B) AS ?target)
  OPTIONAL { ?target gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsnprov:query-rules-s42-strategy-confidence-relation
    a gsnprov:Query ;
    rdfs:label "rules/s42_strategy_confidence_relation.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s42_strategy_confidence_relation.rq" ;
    gsnprov:fileChecksum "e6b557e0da9eecfbb72e2296490cef927127e4f2777a0b3c7ac5ee8b1701b211" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Goal ,
        gsn:RelationshipWithConfidence ,
        gsn:Strategy ,
        gsn:associatedWith ,
        gsn:assuranceClaimPoint ,
        gsn:supportedBy ;
    gsnprov:ruleName "Strategy Confidence Relation" ;
    gsnprov:translatesStatement gsnprov:st-0685 ;
    gsnprov:restsOnStatement gsnprov:st-0161 ,
        gsnprov:st-0167 ,
        gsnprov:st-0207 ,
        gsnprov:st-0635 ,
        gsnprov:st-0648 ,
        gsnprov:st-0658 ;
    gsnprov:queryText """# rule:      S42
# name:      Strategy Confidence Relation
# section:   Confidence Argument Extension
# operation: rule
# expect:    insert
# swrl:      'supported by'(?G1, ?S) ^ 'supported by'(?S, ?G2) ^ 'Relationship with
#            Confidence'(?R1) ^ swrlx:makeOWLThing(?G2, ?R2) ^ Strategy(?S) ^ Goal(?G1) ^
#            Goal(?G2) ^ rdf:object(?R1, ?S) ^ 'associated with'(?R1, ?A) ^ rdf:subject(?R1, ?G1)
#            -> rdf:subject(?R2, ?S) ^ 'Relationship with Confidence'(?R2) ^ rdf:object(?R2, ?G2)
#            ^ 'associated with'(?R2, ?A) ^ 'assurance claim point'(?R2, true)
# reads:     IF Goal G1 is supported by Strategy S AND S is supported by Goal G2 AND there is a
#            Relationship with Confidence R1 from G1 to S associated with A THEN we create a
#            Relationship with Confidence R2 from S to G2 associated with the same A AND mark R2
#            as an assurance claim point

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

INSERT {
  ?R2 a gsn:RelationshipWithConfidence ;
      schema:identifier ?relationshipId ;
      rdf:subject ?S ;
      rdf:predicate gsn:supportedBy ;
      rdf:object ?G2 ;
      gsn:associatedWith ?A ;
      gsn:assuranceClaimPoint true .
}
WHERE {
  ?R1 a gsn:RelationshipWithConfidence ;
      rdf:subject ?G1 ;
      rdf:object ?S ;
      gsn:associatedWith ?A .
  ?G1 a gsn:Goal ;
      gsn:supportedBy ?S .
  ?S a gsn:Strategy ;
     gsn:supportedBy ?G2 ;
     schema:identifier ?idS .
  ?G2 a gsn:Goal ;
      schema:identifier ?idG2 .
  BIND(CONCAT("RC-", ?idS, "-", ?idG2) AS ?relationshipId)
  BIND(IRI(CONCAT(REPLACE(STR(?S), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?relationshipId))) AS ?R2)
  FILTER NOT EXISTS {
    ?existing a gsn:RelationshipWithConfidence ;
              rdf:subject ?S ;
              rdf:object ?G2 .
  }
}
""" .

gsnprov:query-rules-s43-goal-strategy-confidence
    a gsnprov:Query ;
    rdfs:label "rules/s43_goal_strategy_confidence.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s43_goal_strategy_confidence.rq" ;
    gsnprov:fileChecksum "e2a8ae83d4c0142946811f914be5f186625c41b43d693493aa3f65a6320733c6" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Goal ,
        gsn:RelationshipWithConfidence ,
        gsn:Strategy ,
        gsn:associatedWith ,
        gsn:assuranceClaimPoint ,
        gsn:supportedBy ;
    gsnprov:ruleName "Goal-Strategy Confidence" ;
    gsnprov:translatesStatement gsnprov:st-0687 ;
    gsnprov:restsOnStatement gsnprov:st-0161 ,
        gsnprov:st-0167 ,
        gsnprov:st-0207 ,
        gsnprov:st-0635 ,
        gsnprov:st-0648 ,
        gsnprov:st-0658 ;
    gsnprov:queryText """# rule:      S43
# name:      Goal-Strategy Confidence
# section:   Confidence Argument Extension
# operation: rule
# expect:    insert
# swrl:      'supported by'(?G2, ?S) ^ 'Relationship with Confidence'(?R1) ^ rdf:subject(?R1, ?S)
#            ^ 'supported by'(?S, ?G1) ^ swrlx:makeOWLThing(?G2, ?R2) ^ rdf:object(?R1, ?G1) ^
#            Strategy(?S) ^ Goal(?G1) ^ Goal(?G2) ^ 'associated with'(?R1, ?A) -> 'Relationship
#            with Confidence'(?R2) ^ 'associated with'(?R2, ?A) ^ 'assurance claim point'(?R2,
#            true) ^ rdf:subject(?R2, ?G2) ^ rdf:object(?R2, ?S)
# reads:     IF Goal G2 is supported by Strategy S AND S is supported by Goal G1 AND there is a
#            Relationship with Confidence R1 from S to G1 associated with A THEN we create a
#            Relationship with Confidence R2 from G2 to S associated with the same A AND mark R2
#            as an assurance claim point

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

INSERT {
  ?R2 a gsn:RelationshipWithConfidence ;
      schema:identifier ?relationshipId ;
      rdf:subject ?G2 ;
      rdf:predicate gsn:supportedBy ;
      rdf:object ?S ;
      gsn:associatedWith ?A ;
      gsn:assuranceClaimPoint true .
}
WHERE {
  ?R1 a gsn:RelationshipWithConfidence ;
      rdf:subject ?S ;
      rdf:object ?G1 ;
      gsn:associatedWith ?A .
  ?S a gsn:Strategy ;
     gsn:supportedBy ?G1 ;
     schema:identifier ?idS .
  ?G1 a gsn:Goal .
  ?G2 a gsn:Goal ;
      gsn:supportedBy ?S ;
      schema:identifier ?idG2 .
  BIND(CONCAT("RC-", ?idG2, "-", ?idS) AS ?relationshipId)
  BIND(IRI(CONCAT(REPLACE(STR(?G2), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?relationshipId))) AS ?R2)
  FILTER NOT EXISTS {
    ?existing a gsn:RelationshipWithConfidence ;
              rdf:subject ?G2 ;
              rdf:object ?S .
  }
}
""" .

gsnprov:query-rules-s44-solution-confidence-relation
    a gsnprov:Query ;
    rdfs:label "rules/s44_solution_confidence_relation.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s44_solution_confidence_relation.rq" ;
    gsnprov:fileChecksum "1b11a179e0e2ede02487bdc39da43181ed1d5c5846e73fab11898f55d0f1b29b" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Goal ,
        gsn:RelationshipWithConfidence ,
        gsn:Solution ,
        gsn:associatedWith ,
        gsn:assuranceClaimPoint ,
        gsn:supportedBy ;
    gsnprov:ruleName "Solution Confidence Relation" ;
    gsnprov:translatesStatement gsnprov:st-0690 ;
    gsnprov:restsOnStatement gsnprov:st-0161 ,
        gsnprov:st-0175 ,
        gsnprov:st-0207 ,
        gsnprov:st-0635 ,
        gsnprov:st-0648 ,
        gsnprov:st-0658 ;
    gsnprov:queryText """# rule:      S44
# name:      Solution Confidence Relation
# section:   Confidence Argument Extension
# operation: rule
# expect:    insert
# swrl:      'supported by'(?G, ?S2) ^ Solution(?S1) ^ rdf:object(?R1, ?S1) ^ 'Relationship with
#            Confidence'(?R1) ^ swrlx:makeOWLThing(?S2, ?R2) ^ 'supported by'(?G, ?S1) ^ Goal(?G)
#            ^ swrlb:notEqual(?S1, ?S2) ^ 'associated with'(?R1, ?A) ^ rdf:subject(?R1, ?G) ^
#            Solution(?S2) -> rdf:object(?R2, ?S2) ^ 'Relationship with Confidence'(?R2) ^
#            rdf:subject(?R2, ?G) ^ 'associated with'(?R2, ?A) ^ 'assurance claim point'(?R2,
#            true)
# reads:     IF Goal G is supported by two distinct Solutions S1 and S2 AND there is a
#            Relationship with Confidence R1 from G to S1 associated with A THEN we create a
#            Relationship with Confidence R2 from G to S2 associated with the same A AND mark R2
#            as an assurance claim point

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

INSERT {
  ?R2 a gsn:RelationshipWithConfidence ;
      schema:identifier ?relationshipId ;
      rdf:subject ?G ;
      rdf:predicate gsn:supportedBy ;
      rdf:object ?S2 ;
      gsn:associatedWith ?A ;
      gsn:assuranceClaimPoint true .
}
WHERE {
  ?R1 a gsn:RelationshipWithConfidence ;
      rdf:subject ?G ;
      rdf:object ?S1 ;
      gsn:associatedWith ?A .
  ?G a gsn:Goal ;
     gsn:supportedBy ?S1 , ?S2 ;
     schema:identifier ?idG .
  ?S1 a gsn:Solution .
  ?S2 a gsn:Solution ;
      schema:identifier ?idS2 .
  FILTER(?S1 != ?S2)
  BIND(CONCAT("RC-", ?idG, "-", ?idS2) AS ?relationshipId)
  BIND(IRI(CONCAT(REPLACE(STR(?G), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?relationshipId))) AS ?R2)
  FILTER NOT EXISTS {
    ?existing a gsn:RelationshipWithConfidence ;
              rdf:subject ?G ;
              rdf:object ?S2 .
  }
}
""" .

gsnprov:query-rules-s45-goal-confidence-relation
    a gsnprov:Query ;
    rdfs:label "rules/s45_goal_confidence_relation.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s45_goal_confidence_relation.rq" ;
    gsnprov:fileChecksum "0052c2d2ea938aa8dcb1bd01db0c42347e800e1b4a357613697ffc38d482c6f0" ;
