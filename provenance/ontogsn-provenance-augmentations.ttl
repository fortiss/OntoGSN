gsnprov:query-rules-s05-goal-inference
    a gsnprov:Query ;
    rdfs:label "rules/s05_goal_inference.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s05_goal_inference.rq" ;
    gsnprov:fileChecksum "ded354f840d46de207ecdea2c5e4705a5d45221f7254d9f80eed2d83e77ff2c7" ;
    gsnprov:declaresNamespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Goal ,
        gsn:relationshipType ,
        gsn:supportedBy ;
    gsnprov:ruleName "Goal Inference" ;
    gsnprov:translatesStatement gsnprov:st-0143 ;
    gsnprov:restsOnStatement gsnprov:st-0120 ,
        gsnprov:st-0161 ,
        gsnprov:st-0207 ;
    gsnprov:queryText """# rule:      S5
# name:      Goal Inference
# section:   Core GSN
# operation: rule
# expect:    insert
# swrl:      'supported by'(?A, ?B) ^ rdf:subject(?R, ?A) ^ rdf:object(?R, ?B) ^ Goal(?B) ->
#            'relationship type'(?R, "inferential")
# reads:     IF B is a Goal AND A is supported by B AND R has subject A AND R has object B THEN R
#            is an inferential relationship

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DELETE { ?R gsn:relationshipType ?old }
INSERT { ?R gsn:relationshipType "inferential" }
WHERE {
  ?B a gsn:Goal .
  ?A gsn:supportedBy ?B .
  ?R rdf:subject ?A ;
     rdf:object ?B .
  OPTIONAL { ?R gsn:relationshipType ?old }
  FILTER(!BOUND(?old) || ?old != "inferential")
}
""" .

gsnprov:query-rules-s06-goal-top-flag
    a gsnprov:Query ;
    rdfs:label "rules/s06_goal_top_flag.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s06_goal_top_flag.rq" ;
    gsnprov:fileChecksum "bf4590cc4304b79963b6e3253f7702aef03e4f86a550d730037beef19ccfa99e" ;
    gsnprov:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Goal ,
        gsn:supportedBy ,
        gsn:top ;
    gsnprov:ruleName "Goal Top Flag" ;
    gsnprov:translatesStatement gsnprov:st-0148 ;
    gsnprov:restsOnStatement gsnprov:st-0144 ,
        gsnprov:st-0161 ,
        gsnprov:st-0207 ;
    gsnprov:queryText """# rule:      S6
# name:      Goal Top Flag
# section:   Core GSN
# operation: rule
# expect:    change
# swrl:      'supported by'(?X, ?A) ^ Goal(?A) -> 'top (goal)'(?A, false)
# reads:     IF X is supported by A AND A is a Goal THEN A is NOT a top-level goal

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

# ?X is a Goal or a Strategy without saying so: those are the rdfs:domain of gsn:supportedBy.
# A strategy parent counts, which is the whole point - a goal reached through a strategy is
# not the pinnacle claim, and the earlier form of this rule missed every one of them.
DELETE { ?A gsn:top ?old }
INSERT { ?A gsn:top false }
WHERE {
  ?A a gsn:Goal .
  ?X gsn:supportedBy ?A .
  OPTIONAL { ?A gsn:top ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsnprov:query-rules-s07-predicate-conflict-invalidation
    a gsnprov:Query ;
    rdfs:label "rules/s07_predicate_conflict_invalidation.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s07_predicate_conflict_invalidation.rq" ;
    gsnprov:fileChecksum "59d15530f0978c93f47252264aeb2912fb5730ae9b464bd795835e097d1f47d3" ;
    gsnprov:declaresNamespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:valid ;
    gsnprov:ruleName "Predicate Conflict Invalidation" ;
    gsnprov:translatesStatement gsnprov:st-0226 ;
    gsnprov:restsOnStatement gsnprov:st-0114 ;
    gsnprov:queryText """# rule:      S7
# name:      Predicate Conflict Invalidation
# section:   Core GSN
# operation: rule
# expect:    insert
# swrl:      rdf:object(?R3, ?A) ^ rdf:subject(?R1, ?A) ^ rdf:subject(?R2, ?B) ^ rdf:subject(?R3,
#            ?C) ^ rdf:predicate(?R3, ?P) ^ rdf:predicate(?R2, ?P) ^ rdf:object(?R1, ?B) ^
#            rdf:object(?R2, ?C) ^ rdf:predicate(?R1, ?P) -> valid(?R1, false) ^ valid(?R2,
#            false) ^ valid(?R3, false)
# reads:     IF R1 has subject A, predicate P, and object B AND R2 has subject B, predicate P,
#            and object C AND R3 has subject C, predicate P, and object A THEN R1 is NOT valid
#            AND R2 is NOT valid AND R3 is NOT valid

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DELETE { ?R gsn:valid ?old }
INSERT { ?R gsn:valid false }
WHERE {
  ?R1 rdf:subject ?A ; rdf:predicate ?P ; rdf:object ?B .
  ?R2 rdf:subject ?B ; rdf:predicate ?P ; rdf:object ?C .
  ?R3 rdf:subject ?C ; rdf:predicate ?P ; rdf:object ?A .
  FILTER(?R1 != ?R2 && ?R1 != ?R3 && ?R2 != ?R3)
  VALUES ?slot { 1 2 3 }
  BIND(IF(?slot = 1, ?R1, IF(?slot = 2, ?R2, ?R3)) AS ?R)
  OPTIONAL { ?R gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsnprov:query-rules-s08-contradictory-goal-truth
    a gsnprov:Query ;
    rdfs:label "rules/s08_contradictory_goal_truth.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s08_contradictory_goal_truth.rq" ;
    gsnprov:fileChecksum "be6df26573c3d9c4d348a15e28820187cb995d266427d0dc764443bdf97c7ee3" ;
    gsnprov:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Goal ,
        gsn:supportedBy ,
        gsn:true ,
        gsn:valid ;
    gsnprov:ruleName "Contradictory Goal Truth" ;
    gsnprov:translatesStatement gsnprov:st-0239 ;
    gsnprov:restsOnStatement gsnprov:st-0114 ,
        gsnprov:st-0161 ,
        gsnprov:st-0207 ,
        gsnprov:st-0234 ;
    gsnprov:queryText """# rule:      S8
# name:      Contradictory Goal Truth
# section:   Core GSN
# operation: rule
# expect:    insert
# swrl:      true(?A, false) ^ true(?B, true) ^ 'supported by'(?B, ?A) ^ Goal(?A) -> valid(?B,
#            false)
# reads:     IF A is NOT true AND B is true AND B is supported by A AND A is a Goal THEN B is NOT
#            valid

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?B gsn:valid ?old }
INSERT { ?B gsn:valid false }
WHERE {
  ?A a gsn:Goal ;
     gsn:true ?tA .
  FILTER(STR(?tA) = "false")
  ?B gsn:supportedBy ?A ;
     gsn:true ?tB .
  FILTER(STR(?tB) = "true")
  OPTIONAL { ?B gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsnprov:query-rules-s09-tri-goal-conflict
    a gsnprov:Query ;
    rdfs:label "rules/s09_tri_goal_conflict.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s09_tri_goal_conflict.rq" ;
    gsnprov:fileChecksum "45b728fc15ab75cb139a050bcaf522e8d3ad8f45b15d324ef1df1c08b4f9eb99" ;
    gsnprov:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Goal ,
        gsn:supportedBy ,
        gsn:true ,
        gsn:valid ;
    gsnprov:ruleName "Tri-Goal Conflict" ;
    gsnprov:translatesStatement gsnprov:st-0240 ;
    gsnprov:restsOnStatement gsnprov:st-0114 ,
        gsnprov:st-0161 ,
        gsnprov:st-0207 ,
        gsnprov:st-0234 ;
    gsnprov:queryText """# rule:      S9
# name:      Tri-Goal Conflict
# section:   Core GSN
# operation: rule
# expect:    insert
# swrl:      true(?C, true) ^ true(?B, false) ^ 'supported by'(?C, ?B) ^ true(?A, true) ^
#            'supported by'(?C, ?A) ^ Goal(?A) ^ Goal(?B) -> valid(?C, false)
# reads:     IF C is true AND B is false AND C is supported by B and A AND A is true AND A and B
#            are Goals THEN C is NOT valid

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?C gsn:valid ?old }
INSERT { ?C gsn:valid false }
WHERE {
  ?C gsn:true ?tC ;
     gsn:supportedBy ?A , ?B .
  FILTER(STR(?tC) = "true")
  ?A a gsn:Goal ; gsn:true ?tA .
  ?B a gsn:Goal ; gsn:true ?tB .
  FILTER(STR(?tA) = "true")
  FILTER(STR(?tB) = "false")
  OPTIONAL { ?C gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsnprov:query-rules-s10-solution-propagation-true
    a gsnprov:Query ;
    rdfs:label "rules/s10_solution_propagation_true.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s10_solution_propagation_true.rq" ;
    gsnprov:fileChecksum "d9d359414893c2b3f99d3d4fcb0c362708c1e2c870ec2c461c7505a4ae217d75" ;
    gsnprov:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Assumption ,
        gsn:Solution ,
        gsn:inContextOf ,
        gsn:supportedBy ,
        gsn:true ;
    gsnprov:ruleName "Solution Propagation (True)" ;
    gsnprov:translatesStatement gsnprov:st-0243 ;
    gsnprov:restsOnStatement gsnprov:st-0175 ,
        gsnprov:st-0188 ,
        gsnprov:st-0207 ,
        gsnprov:st-0218 ,
        gsnprov:st-0234 ;
    gsnprov:queryText """# rule:      S10
# name:      Solution Propagation (True)
# section:   Core GSN
# operation: rule
# expect:    insert
# swrl:      Solution(?A) ^ 'supported by'(?B, ?A) ^ true(?A, true) -> true(?B, true)
# reads:     IF A is a Solution AND B is supported by A AND A is true AND no other solution
#            supporting B is untrue or undetermined AND no assumption B sits in the context of
#            is untrue THEN B becomes true
# note:      THE GUARD BELOW IS NOT IN THE SWRL. Support in GSN is a composition: a claim
#            follows only when everything supporting it holds. Expressing "and nothing else
#            supporting it fails" needs negation as failure, which SWRL does not have, so the
#            source rule states the positive half and this translation adds the guard. See
#            NOTES-tbox-corrections.md, Part C. Without it S10 and S11/S13/S16 alternate
#            forever on any claim with mixed support.

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?B gsn:true ?old }
INSERT { ?B gsn:true true }
WHERE {
  ?A a gsn:Solution ;
     gsn:true ?tA .
  FILTER(STR(?tA) = "true")
  ?B gsn:supportedBy ?A .

  # no sibling solution that is untrue, or that has no truth value yet
  FILTER NOT EXISTS {
    ?B gsn:supportedBy ?other .
    ?other a gsn:Solution .
    FILTER NOT EXISTS { ?other gsn:true ?tOther . FILTER(STR(?tOther) = "true") }
  }
  # and nothing S16 would turn false underneath us
  FILTER NOT EXISTS {
    ?B gsn:inContextOf ?asm .
    ?asm a gsn:Assumption ; gsn:true ?tAsm .
    FILTER(STR(?tAsm) = "false")
  }

  OPTIONAL { ?B gsn:true ?old }
  FILTER(!BOUND(?old) || STR(?old) != "true")
}
""" .

gsnprov:query-rules-s11-solution-propagation-false
    a gsnprov:Query ;
    rdfs:label "rules/s11_solution_propagation_false.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
