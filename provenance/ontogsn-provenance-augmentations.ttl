#################################################################
#    Stored queries (124)
#    gsnprov:declaresNamespace records what each file binds its prefixes to, which is
#    how a query pointing at the wrong namespace becomes findable.
#    
#    gsnprov:queryText holds the query verbatim, so the record says what was asked at
#    a given version without the file having to still exist. gsnprov:fileChecksum is
#    what detects that it changed.
#    
#    Two links reach back into the ontology, and they are not the same strength.
#    gsnprov:translatesStatement is an exact correspondence: the files under
#    queries/rules/ ARE the SWRL rules, re-expressed for a store with no reasoner, and
#    the join is the rule's name. gsnprov:restsOnStatement is weaker and derived: the
#    axiom declaring each gsn: term the query names. Either way the target is a
#    StatementRecord, so one hop further reaches why that axiom exists at all.
#################################################################

gsnprov:query-augmentation-queries-fc01-requirement-source
    a gsnprov:Query ;
    rdfs:label "augmentation/queries/fc01_requirement_source.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "augmentation/queries/fc01_requirement_source.rq" ;
    gsnprov:fileChecksum "613bfc2cafc07c8bf3289eb756857500e1f9fedfb239344f5d5c8ecd5c71293c" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ;
    gsnprov:answersQuestion gsnprov:cq-CQ-44 ;
    gsnprov:queryText """# id:        CQ-44
# role:      Auditor
# operation: read
# question:  What law or requirement source does the case answer to?
# expect:    rows
#
# Any element may answer to a requirement, not only the top goal: a control claim usually names
# the clause it implements. A case that names none reads through CQ-07 instead, which returns
# every context in scope without saying which of them is the requirement.

PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?elementId ?source
WHERE {
  ?element gsnaug:requiredBy ?source .
  OPTIONAL { ?element schema:identifier ?elementId }
}
ORDER BY ?elementId ?source
""" .

gsnprov:query-augmentation-queries-fc02-assured-system
    a gsnprov:Query ;
    rdfs:label "augmentation/queries/fc02_assured_system.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "augmentation/queries/fc02_assured_system.rq" ;
    gsnprov:fileChecksum "e806043db229bd89d64ed0f07b7fedb2b597e9dab039888d358b06536e882530" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ;
    gsnprov:answersQuestion gsnprov:cq-CQ-45 ;
    gsnprov:queryText """# id:        CQ-45
# role:      Auditor
# operation: read
# question:  What system and organisation is this case about?
# expect:    rows
#
# The subject is an argument, an assurance case or a goal - the three granularities at which a
# reader would say the case is about something.

PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?subjectId ?system
WHERE {
  ?subject gsnaug:assures ?system .
  OPTIONAL { ?subject schema:identifier ?subjectId }
}
ORDER BY ?subjectId ?system
""" .

gsnprov:query-augmentation-queries-fc03-undeveloped-claims-for-system
    a gsnprov:Query ;
    rdfs:label "augmentation/queries/fc03_undeveloped_claims_for_system.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "augmentation/queries/fc03_undeveloped_claims_for_system.rq" ;
    gsnprov:fileChecksum "9a2f5d1a47a97f94b204cd8d40c1425ee3ddbbcaff2d09aa00c7d201407db500" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Goal ,
        gsn:inContextOf ,
        gsn:statement ,
        gsn:supportedBy ,
        gsn:undeveloped ;
    gsnprov:restsOnStatement gsnprov:st-0161 ,
        gsnprov:st-0200 ,
        gsnprov:st-0207 ,
        gsnprov:st-0218 ,
        gsnprov:st-0265 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-46 ;
    gsnprov:queryText """# id:        CQ-46
# role:      Compliance Officer
# operation: read
# question:  Which low-level claims need development for each system?
# expect:    rows
#
# The inverse-path walk does the context inheritance in the query, so the answer does not depend
# on S17 having been run first.

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX schema:  <http://schema.org/>

SELECT DISTINCT ?goalId ?statement ?contextStatement
WHERE {
  VALUES ?system { "IT system" }                    # PARAMETER

  ?goal a gsn:Goal ;
        schema:identifier ?goalId ;
        gsn:undeveloped true .
  OPTIONAL { ?goal gsn:statement ?statement }

  ?goal (^gsn:supportedBy)* ?ancestor .
  ?ancestor gsn:inContextOf ?context .
  ?context gsn:statement ?contextStatement .
  FILTER ( CONTAINS(LCASE(?contextStatement), LCASE(?system)) )
}
ORDER BY ?goalId
""" .

gsnprov:query-augmentation-queries-fc07-evidence-location
    a gsnprov:Query ;
    rdfs:label "augmentation/queries/fc07_evidence_location.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "augmentation/queries/fc07_evidence_location.rq" ;
    gsnprov:fileChecksum "a90a0950a38884929a40ac42adac81d8e222c56b1a8efd53b5f3071bfe17135f" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Solution ,
        gsn:refersTo ;
    gsnprov:restsOnStatement gsnprov:st-0175 ,
        gsnprov:st-0289 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-49 ;
    gsnprov:queryText """# id:        CQ-49
# role:      Developer
# operation: read
# question:  Where is the requested evidence kept and how is it fetched?
# expect:    rows

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?solutionId ?artefact ?storage ?retrieval ?automated
WHERE {
  ?solution a gsn:Solution ;
            schema:identifier ?solutionId ;
            gsn:refersTo ?artefact .
  OPTIONAL { ?artefact gsnaug:storedIn ?storage }
  OPTIONAL {
    ?artefact gsnaug:retrievableWith ?retrieval .
    OPTIONAL { ?retrieval gsnaug:automated ?automated }
  }
}
ORDER BY ?solutionId
""" .

gsnprov:query-augmentation-queries-fc08-evidence-production
    a gsnprov:Query ;
    rdfs:label "augmentation/queries/fc08_evidence_production.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "augmentation/queries/fc08_evidence_production.rq" ;
    gsnprov:fileChecksum "1952ca8d5d24f60c84cd1a5eaf48f2f7301a3d4406fe62085fbe1e633a6855a2" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Solution ,
        gsn:refersTo ;
    gsnprov:restsOnStatement gsnprov:st-0175 ,
        gsnprov:st-0289 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-50 ;
    gsnprov:queryText """# id:        CQ-50
# role:      Developer
# operation: read
# question:  Does the evidence exist yet, and how was it produced - by whom, with what, from what?
# expect:    rows
#
# A solution with no artefact is evidence that does not exist yet, so the artefact is optional.

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?solutionId ?artefact ?author ?mechanism ?source
WHERE {
  ?solution a gsn:Solution ;
            schema:identifier ?solutionId .
  OPTIONAL {
    ?solution gsn:refersTo ?artefact .
    OPTIONAL { ?artefact gsnaug:generatedBy   ?author }
    OPTIONAL { ?artefact gsnaug:generatedWith ?mechanism }
    OPTIONAL { ?artefact gsnaug:generatedFrom ?source }
  }
}
ORDER BY ?solutionId
""" .

gsnprov:query-augmentation-queries-fc10-evidence-verification
    a gsnprov:Query ;
    rdfs:label "augmentation/queries/fc10_evidence_verification.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "augmentation/queries/fc10_evidence_verification.rq" ;
    gsnprov:fileChecksum "7c7ca56b191fd4d09296f8e19208e4777fadb245f93539d8282f585f5457e0d5" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Solution ,
        gsn:refersTo ,
        gsn:valid ;
    gsnprov:restsOnStatement gsnprov:st-0114 ,
        gsnprov:st-0175 ,
        gsnprov:st-0289 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-52 ;
    gsnprov:queryText """# id:        CQ-52
# role:      Process/Software Owner
# operation: read
# question:  Was this evidence verified - by whom, with what mechanism, and did it pass?
# expect:    rows

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?solutionId ?artefact ?mechanism ?reviewer ?valid
WHERE {
  ?solution a gsn:Solution ;
            schema:identifier ?solutionId ;
            gsn:refersTo ?artefact .
  OPTIONAL { ?artefact gsnaug:verifiedWith ?mechanism }
  OPTIONAL { ?artefact gsnaug:reviewedBy   ?reviewer }
  OPTIONAL { ?solution gsn:valid ?valid }
}
ORDER BY ?solutionId
""" .

gsnprov:query-augmentation-queries-fc11-controls-ready-for-review
    a gsnprov:Query ;
    rdfs:label "augmentation/queries/fc11_controls_ready_for_review.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "augmentation/queries/fc11_controls_ready_for_review.rq" ;
    gsnprov:fileChecksum "cb4037bd18bc1fcf2a84fbd1ade2f042ced516596c143ac31b6bbbb3dfa4d806" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Goal ,
        gsn:Solution ,
        gsn:refersTo ,
        gsn:supportedBy ,
        gsn:undeveloped ;
    gsnprov:restsOnStatement gsnprov:st-0161 ,
        gsnprov:st-0175 ,
        gsnprov:st-0200 ,
        gsnprov:st-0207 ,
        gsnprov:st-0289 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-53 ;
    gsnprov:queryText """# id:        CQ-53
# role:      Auditor
# operation: read
# question:  Which controls are ready for review?
# expect:    rows
#
# Ready means developed and backed by an artefact. Whether it passed is CQ-54; what is still
# missing is CQ-26 and CQ-16.

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX schema:  <http://schema.org/>

SELECT ?goalId ?solutionId ?artefact
WHERE {
  ?goal a gsn:Goal ;
        schema:identifier ?goalId ;
        gsn:supportedBy ?solution .
  ?solution a gsn:Solution ;
            schema:identifier ?solutionId ;
            gsn:refersTo ?artefact .
  FILTER NOT EXISTS { ?goal     gsn:undeveloped true }
  FILTER NOT EXISTS { ?solution gsn:undeveloped true }
}
ORDER BY ?goalId ?solutionId
""" .

gsnprov:query-augmentation-queries-fc13-case-compliance
    a gsnprov:Query ;
    rdfs:label "augmentation/queries/fc13_case_compliance.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "augmentation/queries/fc13_case_compliance.rq" ;
    gsnprov:fileChecksum "26c1ac10e2b7999f9524bdf2250bc418633aba04993e682fe2c942bb519dab96" ;
    gsnprov:declaresNamespace "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:defeated ,
        gsn:inDoubt ;
    gsnprov:restsOnStatement gsnprov:st-0699 ,
        gsnprov:st-0731 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-55 ;
    gsnprov:queryText """# id:        CQ-55
# role:      Auditor
# operation: read
# question:  Is the case fully compliant?
# expect:    rows
#
# Compliant is all three counts at zero. The status is derived on every run rather than stored,
# so it cannot go stale; the price is that it cannot be reproduced for a past report entry.

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>

SELECT ?openIssues ?defeated ?inDoubt
WHERE {
  {
    SELECT (COUNT(DISTINCT ?issue) AS ?openIssues)
    WHERE {
      ?issue a gsnaug:Issue .
      FILTER NOT EXISTS { ?issue gsnaug:issueOutcome ?outcome }
      FILTER NOT EXISTS {
        ?answer gsnaug:answers ?issue .
        FILTER NOT EXISTS { ?answer gsnaug:accepted false }
      }
    }
  }
  { SELECT (COUNT(DISTINCT ?e) AS ?defeated) WHERE { ?e gsn:defeated true } }
  { SELECT (COUNT(DISTINCT ?d) AS ?inDoubt)  WHERE { ?d gsn:inDoubt  true } }
}
""" .

gsnprov:query-augmentation-queries-fc14-open-clarifications
    a gsnprov:Query ;
    rdfs:label "augmentation/queries/fc14_open_clarifications.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "augmentation/queries/fc14_open_clarifications.rq" ;
    gsnprov:fileChecksum "dfdeed5ff048d72198e83a3f0abe40a83456061192dc9e7b30b6891c51579b83" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:answersQuestion gsnprov:cq-CQ-56 ;
    gsnprov:queryText """# id:        CQ-56
# role:      Auditor
# operation: read
# question:  Which elements have an open clarification against them?
# expect:    rows
#
# Open means neither ended by an outcome nor closed by an answer the raiser accepted. An answer
# marked accepted false leaves the ask open, which is what sends it round again.

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?issueId ?targetId ?holder ?description
WHERE {
  ?issue a gsnaug:Issue ;
         schema:identifier ?issueId ;
         gsnaug:issueType gsnaug:clarify ;
         gsnaug:raisedAgainst ?target .
  ?target schema:identifier ?targetId .
  OPTIONAL { ?issue gsnaug:heldBy ?holder }
  OPTIONAL { ?issue schema:description ?description }
  FILTER NOT EXISTS { ?issue gsnaug:issueOutcome ?outcome }
  FILTER NOT EXISTS {
    ?answer gsnaug:answers ?issue .
    FILTER NOT EXISTS { ?answer gsnaug:accepted false }
  }
}
ORDER BY ?issueId
""" .

gsnprov:query-augmentation-queries-fc15-who-answers-for-element
    a gsnprov:Query ;
    rdfs:label "augmentation/queries/fc15_who_answers_for_element.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "augmentation/queries/fc15_who_answers_for_element.rq" ;
    gsnprov:fileChecksum "bbe67cbd29a910db9178e31e73313daae411d3e3b28abbba342ff401d2e40bf7" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:refersTo ;
    gsnprov:restsOnStatement gsnprov:st-0289 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-57 ;
    gsnprov:queryText """# id:        CQ-57
# role:      Process/Software Owner
# operation: read
# question:  Who can answer for this element - its owner, or the author of its evidence?
# expect:    rows

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?elementId ?owner ?author
WHERE {
  ?element schema:identifier ?elementId .
  OPTIONAL { ?element gsnaug:ownedBy ?owner }
  OPTIONAL {
    ?element gsn:refersTo ?artefact .
    ?artefact gsnaug:generatedBy ?author
  }
  FILTER ( BOUND(?owner) || BOUND(?author) )
}
ORDER BY ?elementId
""" .

gsnprov:query-augmentation-queries-fc16-clarification-answers
    a gsnprov:Query ;
    rdfs:label "augmentation/queries/fc16_clarification_answers.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "augmentation/queries/fc16_clarification_answers.rq" ;
    gsnprov:fileChecksum "5fd60c96741206dfa44ed53a2045a9b5d2b50a24ac27ef6c1232c65d9d78c1c6" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ;
    gsnprov:answersQuestion gsnprov:cq-CQ-58 ;
    gsnprov:queryText """# id:        CQ-58
# role:      Auditor
# operation: read
# question:  What answered a clarification, and which ask did it close?
# expect:    rows

PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?answer ?issueId ?description ?accepted
WHERE {
  ?answer a gsnaug:Clarification ;
          gsnaug:answers ?issue .
  ?issue schema:identifier ?issueId .
  OPTIONAL { ?answer schema:description ?description }
  OPTIONAL { ?answer gsnaug:accepted ?accepted }
}
ORDER BY ?issueId
""" .

gsnprov:query-augmentation-queries-fc17-rounds-per-element
    a gsnprov:Query ;
    rdfs:label "augmentation/queries/fc17_rounds_per_element.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "augmentation/queries/fc17_rounds_per_element.rq" ;
    gsnprov:fileChecksum "bea2d09322bf380b7587c778f04ccbfc5306efd95763a1a9b4ba74ca029eb939" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ;
    gsnprov:answersQuestion gsnprov:cq-CQ-59 ;
    gsnprov:queryText """# id:        CQ-59
# role:      Auditor
# operation: read
# question:  How many rounds has this element taken, and of which kind?
# expect:    rows
#
# One issue per round is what makes this a COUNT. A flag on the target would report one.

PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?targetId ?type (COUNT(DISTINCT ?issue) AS ?rounds)
WHERE {
  ?issue a gsnaug:Issue ;
         gsnaug:raisedAgainst ?target ;
         gsnaug:issueType ?type .
  ?target schema:identifier ?targetId .
}
GROUP BY ?targetId ?type
ORDER BY DESC(?rounds) ?targetId
""" .

gsnprov:query-augmentation-queries-fc18-superseded-asks
    a gsnprov:Query ;
    rdfs:label "augmentation/queries/fc18_superseded_asks.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "augmentation/queries/fc18_superseded_asks.rq" ;
    gsnprov:fileChecksum "8b0b361fe8d6d8ce38d08aaaeea6eb0342f682e25b6cb3279a5d89e462a80720" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ;
    gsnprov:answersQuestion gsnprov:cq-CQ-60 ;
    gsnprov:queryText """# id:        CQ-60
# role:      Auditor
# operation: read
# question:  Which pending ask was displaced by a newer one?
# expect:    rows

PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?newerId ?olderId ?outcome ?holder
WHERE {
  ?newer gsnaug:supersedes ?older ;
         schema:identifier ?newerId .
  ?older schema:identifier ?olderId .
  OPTIONAL { ?older gsnaug:issueOutcome ?outcome }
  OPTIONAL { ?newer gsnaug:heldBy ?holder }
}
ORDER BY ?olderId
""" .

gsnprov:query-augmentation-queries-fc19-who-holds-the-ask
    a gsnprov:Query ;
    rdfs:label "augmentation/queries/fc19_who_holds_the_ask.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "augmentation/queries/fc19_who_holds_the_ask.rq" ;
    gsnprov:fileChecksum "c1fb56d7a8d549f9353a5d3ebf89e6f61567d1e4b72177a2bd173b3d0669d4eb" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ;
    gsnprov:answersQuestion gsnprov:cq-CQ-61 ;
    gsnprov:queryText """# id:        CQ-61
# role:      Auditor
# operation: read
# question:  Who currently holds a relayed ask - where is it stuck?
# expect:    rows

PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?issueId ?holder ?raiser ?targetId
WHERE {
  ?issue a gsnaug:Issue ;
         schema:identifier ?issueId ;
         gsnaug:heldBy ?holder ;
         gsnaug:raisedAgainst ?target .
  ?target schema:identifier ?targetId .
  OPTIONAL { ?issue gsnaug:raisedBy ?raiser }
  FILTER NOT EXISTS { ?issue gsnaug:issueOutcome ?outcome }
  FILTER NOT EXISTS {
    ?answer gsnaug:answers ?issue .
    FILTER NOT EXISTS { ?answer gsnaug:accepted false }
  }
}
ORDER BY ?issueId
""" .

gsnprov:query-augmentation-queries-fc20-escalation-count
    a gsnprov:Query ;
    rdfs:label "augmentation/queries/fc20_escalation_count.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "augmentation/queries/fc20_escalation_count.rq" ;
    gsnprov:fileChecksum "f5d5dcbafb2492b19280059910a11250b82b894d617dc96ddab1f43a0f4a4581" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ;
    gsnprov:answersQuestion gsnprov:cq-CQ-62 ;
    gsnprov:queryText """# id:        CQ-62
# role:      Auditor
# operation: read
# question:  How many times was an ask escalated because the holder could not answer?
# expect:    rows
#
# An escalation is a hop whose predecessor was closed as cannot-answer, counted from the first
# ask in the chain - the one that supersedes nothing.

PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?originalId (COUNT(DISTINCT ?later) AS ?escalations)
WHERE {
  ?original a gsnaug:Issue ;
            schema:identifier ?originalId .
  FILTER NOT EXISTS { ?original gsnaug:supersedes ?earlier }

  ?later gsnaug:supersedes+ ?original ;
         gsnaug:supersedes ?predecessor .
  ?predecessor gsnaug:issueOutcome gsnaug:cannotAnswer .
}
GROUP BY ?originalId
ORDER BY DESC(?escalations)
""" .

gsnprov:query-augmentation-queries-fc22-what-to-revise
    a gsnprov:Query ;
    rdfs:label "augmentation/queries/fc22_what_to_revise.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "augmentation/queries/fc22_what_to_revise.rq" ;
    gsnprov:fileChecksum "1458aaebd0722a11c764f04545d3603c68d367150708a157645069046d02683f" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Goal ,
        gsn:Solution ;
    gsnprov:restsOnStatement gsnprov:st-0161 ,
        gsnprov:st-0175 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-64 ;
    gsnprov:queryText """# id:        CQ-64
# role:      Compliance Officer
# operation: read
# question:  What has to be revised, and by whom?
# expect:    rows
#
# The class of the target says whether the claim or the evidence is at fault. A revise issue
# against a context is a remark about wording and is deliberately not returned here.

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?issueId ?targetId ?targetKind ?owner ?description
WHERE {
  ?issue a gsnaug:Issue ;
         schema:identifier ?issueId ;
         gsnaug:issueType gsnaug:revise ;
         gsnaug:raisedAgainst ?target .
  ?target schema:identifier ?targetId ;
          a ?targetKind .
  VALUES ?targetKind { gsn:Goal gsn:Solution }
  OPTIONAL { ?target gsnaug:ownedBy ?owner }
  OPTIONAL { ?issue schema:description ?description }
}
ORDER BY ?issueId
""" .

gsnprov:query-augmentation-queries-fc23-revision-rounds
    a gsnprov:Query ;
    rdfs:label "augmentation/queries/fc23_revision_rounds.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "augmentation/queries/fc23_revision_rounds.rq" ;
    gsnprov:fileChecksum "1d09f2fce27406eefeb647a6539b3d2533519065b8f33dfd6fb3de3213874272" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ;
    gsnprov:answersQuestion gsnprov:cq-CQ-65 ;
    gsnprov:queryText """# id:        CQ-65
# role:      Compliance Officer
# operation: read
# question:  How many revision rounds, and which revision closed which ask?
# expect:    rows

PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?targetId (COUNT(DISTINCT ?issue) AS ?rounds)
       (GROUP_CONCAT(DISTINCT STR(?answer); separator=", ") AS ?revisions)
WHERE {
  ?issue a gsnaug:Issue ;
         gsnaug:issueType gsnaug:revise ;
         gsnaug:raisedAgainst ?target .
  ?target schema:identifier ?targetId .
  OPTIONAL {
    ?answer a gsnaug:Revision ;
            gsnaug:answers ?issue
  }
}
GROUP BY ?targetId
ORDER BY DESC(?rounds)
""" .

gsnprov:query-augmentation-queries-fc24-revision-diff
    a gsnprov:Query ;
    rdfs:label "augmentation/queries/fc24_revision_diff.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "augmentation/queries/fc24_revision_diff.rq" ;
    gsnprov:fileChecksum "bbbf2fd3f34812b85c44a3e70265af9381b1424fdc9c7593f2161fdb25fc784e" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:refersTo ;
    gsnprov:restsOnStatement gsnprov:st-0289 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-66 ;
    gsnprov:queryText """# id:        CQ-66
# role:      Developer
# operation: read
# question:  What did a revision actually change - which artefact replaced which?
# expect:    rows
#
# Artefact versions only. A reworded claim is not a revision in this sense.

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?newer ?older ?mechanism ?issueId
WHERE {
  ?newer gsnaug:revisionOf ?older .
  OPTIONAL { ?newer gsnaug:generatedWith ?mechanism }
  OPTIONAL {
    ?solution gsn:refersTo ?older .
    ?issue gsnaug:raisedAgainst ?solution ;
           gsnaug:issueType gsnaug:revise ;
           schema:identifier ?issueId
  }
}
ORDER BY ?newer
""" .

gsnprov:query-augmentation-queries-fc26-unresolved-at-audit
    a gsnprov:Query ;
    rdfs:label "augmentation/queries/fc26_unresolved_at_audit.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "augmentation/queries/fc26_unresolved_at_audit.rq" ;
    gsnprov:fileChecksum "bf597b3c87d1f788e1ad3679bdc5a42e66fe70d40d184e37fed0e0281a280dd9" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/ns/prov#" ,
        "https://w3id.org/OntoGSN/augmentation#" ;
    gsnprov:answersQuestion gsnprov:cq-CQ-68 ;
    gsnprov:queryText """# id:        CQ-68
# role:      Auditor
# operation: read
# question:  What was left unresolved at the last audit, and what is due by the next one?
# expect:    rows
#
# Scoped by cycle rather than by date, because two audits may overlap in time and the question
# asked is always which round.

PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>
PREFIX prov:    <http://www.w3.org/ns/prov#>

SELECT ?cycleId ?issueId ?targetId ?outcome ?opened
WHERE {
  ?issue a gsnaug:Issue ;
         schema:identifier ?issueId ;
         gsnaug:issueType gsnaug:resolve ;
         gsnaug:raisedIn ?cycle ;
         gsnaug:raisedAgainst ?target .
  ?cycle schema:identifier ?cycleId .
  ?target schema:identifier ?targetId .
  OPTIONAL { ?issue gsnaug:issueOutcome ?outcome }
  OPTIONAL { ?cycle prov:startedAtTime ?opened }
  FILTER NOT EXISTS {
    ?answer gsnaug:answers ?issue .
    FILTER NOT EXISTS { ?answer gsnaug:accepted false }
  }
}
ORDER BY ?cycleId ?issueId
""" .

gsnprov:query-augmentation-queries-fc27-resolution-state
    a gsnprov:Query ;
    rdfs:label "augmentation/queries/fc27_resolution_state.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "augmentation/queries/fc27_resolution_state.rq" ;
    gsnprov:fileChecksum "68532e5f2ef35bb4e6d6060b6ecb47fd941da07d460eadfad9681eda697ff6b0" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ;
    gsnprov:answersQuestion gsnprov:cq-CQ-69 ;
    gsnprov:queryText """# id:        CQ-69
# role:      Auditor
# operation: read
# question:  Was a resolution implemented, declined, or infeasible?
# expect:    rows

PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?issueId ?targetId ?state
WHERE {
  ?issue a gsnaug:Issue ;
         schema:identifier ?issueId ;
         gsnaug:issueType gsnaug:resolve ;
         gsnaug:raisedAgainst ?target .
  ?target schema:identifier ?targetId .
  OPTIONAL { ?issue gsnaug:issueOutcome ?outcome }
  OPTIONAL {
    ?answer a gsnaug:Resolution ;
            gsnaug:answers ?issue
  }
  BIND( IF(BOUND(?answer), "implemented",
        IF(BOUND(?outcome), STRAFTER(STR(?outcome), "#"), "open")) AS ?state )
}
ORDER BY ?issueId
""" .

gsnprov:query-augmentation-queries-fc28-manual-evidence
    a gsnprov:Query ;
    rdfs:label "augmentation/queries/fc28_manual_evidence.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "augmentation/queries/fc28_manual_evidence.rq" ;
    gsnprov:fileChecksum "bf666727ba643822fa84bfcd6d93ee7fc834e7ab3821abc55373235a3cad3a1c" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Solution ,
        gsn:refersTo ;
    gsnprov:restsOnStatement gsnprov:st-0175 ,
        gsnprov:st-0289 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-70 ;
    gsnprov:queryText """# id:        CQ-70
# role:      Developer
# operation: read
# question:  Which evidence needs to be generated manually?
# expect:    rows

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?solutionId ?artefact ?mechanism ?automated
WHERE {
  ?solution a gsn:Solution ;
            schema:identifier ?solutionId ;
            gsn:refersTo ?artefact .
  OPTIONAL {
    ?artefact gsnaug:generatedWith ?mechanism .
    OPTIONAL { ?mechanism gsnaug:automated ?automated }
  }
  FILTER ( !BOUND(?mechanism) || !BOUND(?automated) || ?automated = false )
}
ORDER BY ?solutionId
""" .

gsnprov:query-augmentation-queries-fc29-automated-evidence
    a gsnprov:Query ;
    rdfs:label "augmentation/queries/fc29_automated_evidence.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "augmentation/queries/fc29_automated_evidence.rq" ;
    gsnprov:fileChecksum "20b2cf4d152ad135206acb9bb8bede9a8f2d4bb5b0df992dc0f7afd912d29215" ;
    gsnprov:declaresNamespace "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:answersQuestion gsnprov:cq-CQ-71 ;
    gsnprov:queryText """# id:        CQ-71
# role:      Developer
# operation: read
# question:  Which evidence is generated automatically, and how or where from can it be retrieved?
# expect:    rows

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>

SELECT ?artefact ?mechanism ?source ?storage ?retrieval
WHERE {
  ?artefact gsnaug:generatedWith ?mechanism .
  ?mechanism gsnaug:automated true .
  OPTIONAL { ?artefact gsnaug:generatedFrom  ?source }
  OPTIONAL { ?artefact gsnaug:storedIn       ?storage }
  OPTIONAL { ?artefact gsnaug:retrievableWith ?retrieval }
}
ORDER BY ?artefact
""" .

gsnprov:query-augmentation-queries-fc30-alternative-provision
    a gsnprov:Query ;
    rdfs:label "augmentation/queries/fc30_alternative_provision.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "augmentation/queries/fc30_alternative_provision.rq" ;
    gsnprov:fileChecksum "bf69f97a81d297c8774535869e1bdc4048cc405fb359dbbc55e54ee961d56ca1" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Solution ,
        gsn:refersTo ;
    gsnprov:restsOnStatement gsnprov:st-0175 ,
        gsnprov:st-0289 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-72 ;
    gsnprov:queryText """# id:        CQ-72
# role:      Process/Software Owner
# operation: read
# question:  Which evidence needs an alternative provision mechanism - an interview, a call, paper?
# expect:    rows
#
# Which mechanism it is - interview, paper, call - is a subclass of gsnaug:EvidenceRetrievalMechanism
# in the domain ontology; this returns the ones a person has to run.

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?solutionId ?artefact ?retrieval ?automated
WHERE {
  ?solution a gsn:Solution ;
            schema:identifier ?solutionId ;
            gsn:refersTo ?artefact .
  OPTIONAL {
    ?artefact gsnaug:retrievableWith ?retrieval .
    OPTIONAL { ?retrieval gsnaug:automated ?automated }
  }
  FILTER ( !BOUND(?retrieval) || !BOUND(?automated) || ?automated = false )
}
ORDER BY ?solutionId
""" .

gsnprov:query-augmentation-queries-fc31-evidence-cannot-be-produced
    a gsnprov:Query ;
    rdfs:label "augmentation/queries/fc31_evidence_cannot_be_produced.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "augmentation/queries/fc31_evidence_cannot_be_produced.rq" ;
    gsnprov:fileChecksum "287e94f6c1ad04e099bdc9bd4a7521a1bf2babffcdd7b9cb785b19822d7747bd" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ;
    gsnprov:mentionsTerm gsn:undeveloped ,
        gsn:uninstantiated ;
    gsnprov:restsOnStatement gsnprov:st-0200 ,
        gsnprov:st-0358 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-73 ;
    gsnprov:queryText """# id:        CQ-73
# role:      Developer
# operation: read
# question:  Which evidence cannot be produced at all, as opposed to not yet produced?
# expect:    rows
#
# Not yet produced is gsn:undeveloped and gsn:uninstantiated, which CQ-26 and CQ-27 report.
# Cannot be produced is an ask closed as infeasible, which is a different answer.

PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?targetId ?issueId ?cycleId
WHERE {
  ?issue a gsnaug:Issue ;
         schema:identifier ?issueId ;
         gsnaug:issueOutcome gsnaug:infeasible ;
         gsnaug:raisedAgainst ?target .
  ?target schema:identifier ?targetId .
  OPTIONAL {
    ?issue gsnaug:raisedIn ?cycle .
    ?cycle schema:identifier ?cycleId
  }
}
ORDER BY ?targetId
""" .

gsnprov:query-augmentation-queries-fc32-cannot-resolve
    a gsnprov:Query ;
    rdfs:label "augmentation/queries/fc32_cannot_resolve.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "augmentation/queries/fc32_cannot_resolve.rq" ;
    gsnprov:fileChecksum "302355090d69d9b23430225a8975ccb6c47ac80814e77f7d24d59a7bad89d0d2" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ;
    gsnprov:answersQuestion gsnprov:cq-CQ-74 ;
    gsnprov:queryText """# id:        CQ-74
# role:      Auditor
# operation: read
# question:  Which issue cannot be resolved at all, as opposed to not yet resolved?
# expect:    rows

PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?issueId ?targetId ?outcome ?holder
WHERE {
  ?issue a gsnaug:Issue ;
         schema:identifier ?issueId ;
         gsnaug:issueType gsnaug:resolve ;
         gsnaug:issueOutcome ?outcome ;
         gsnaug:raisedAgainst ?target .
  ?target schema:identifier ?targetId .
  OPTIONAL { ?issue gsnaug:heldBy ?holder }
  FILTER ( ?outcome IN ( gsnaug:declined, gsnaug:infeasible ) )
}
ORDER BY ?issueId
""" .

gsnprov:query-augmentation-queries-fc33-instantiated-elements
    a gsnprov:Query ;
    rdfs:label "augmentation/queries/fc33_instantiated_elements.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "augmentation/queries/fc33_instantiated_elements.rq" ;
    gsnprov:fileChecksum "3c5c78b0ba8477f430b8cdf65c5fe7a049fdba7f2f058f5719922ffc3145491a" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Goal ,
        gsn:InstantiationDataReference ,
        gsn:Solution ,
        gsn:attachedTo ,
        gsn:refersTo ;
    gsnprov:restsOnStatement gsnprov:st-0161 ,
        gsnprov:st-0175 ,
        gsnprov:st-0289 ,
        gsnprov:st-0456 ,
        gsnprov:st-0462 ,
        gsnprov:st-0463 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-75 ;
    gsnprov:queryText """# id:        CQ-75
# role:      Compliance Officer
# operation: read
# question:  How is the interpretation instantiated into claims and evidence?
# expect:    rows
#
# The reference says which data governs the subtree; gsnaug:instantiatedFrom says which row of it
# produced this element.

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?elementId ?kind ?data ?row
WHERE {
  ?reference a gsn:InstantiationDataReference ;
             gsn:attachedTo ?element .
  ?element schema:identifier ?elementId ;
           a ?kind .
  VALUES ?kind { gsn:Goal gsn:Solution }
  OPTIONAL { ?reference gsn:refersTo ?data }
  OPTIONAL { ?element gsnaug:instantiatedFrom ?row }
}
ORDER BY ?elementId
""" .

gsnprov:query-augmentation-queries-fc34-who-retrieves-evidence
    a gsnprov:Query ;
    rdfs:label "augmentation/queries/fc34_who_retrieves_evidence.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "augmentation/queries/fc34_who_retrieves_evidence.rq" ;
    gsnprov:fileChecksum "52c599061645f893691388c4c022e89da10283c72d05e5b6701b80b5e0a10aaf" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Solution ,
        gsn:refersTo ,
        gsn:supportedBy ;
    gsnprov:restsOnStatement gsnprov:st-0175 ,
        gsnprov:st-0207 ,
        gsnprov:st-0289 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-76 ;
    gsnprov:queryText """# id:        CQ-76
# role:      Compliance Officer
# operation: read
# question:  Who is responsible for retrieving the evidence for a particular system?
# expect:    rows
#
# gsnaug:assures is asserted, not derived. It names a gsnaug:System directly, so the answer does
# not depend on how - or whether - the case draws its top-level context.

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?system ?solutionId ?owner ?author
WHERE {
  ?goal gsnaug:assures ?system .
  ?goal gsn:supportedBy* ?descendant .
  ?descendant a gsn:Solution ;
              schema:identifier ?solutionId .
  OPTIONAL { ?descendant gsnaug:ownedBy ?owner }
  OPTIONAL {
    ?descendant gsn:refersTo ?artefact .
    ?artefact gsnaug:generatedBy ?author
  }
}
ORDER BY ?system ?solutionId
""" .

gsnprov:query-augmentation-queries-fc35-artefacts-to-change
    a gsnprov:Query ;
    rdfs:label "augmentation/queries/fc35_artefacts_to_change.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "augmentation/queries/fc35_artefacts_to_change.rq" ;
    gsnprov:fileChecksum "e89a580b48ba45bc8675d710e860b3d8ef2da76a93a8f7a02fb3dc3c7707b788" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Solution ,
        gsn:defeated ,
        gsn:refersTo ,
        gsn:supportedBy ;
    gsnprov:restsOnStatement gsnprov:st-0175 ,
        gsnprov:st-0207 ,
        gsnprov:st-0289 ,
        gsnprov:st-0699 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-77 ;
    gsnprov:queryText """# id:        CQ-77
# role:      Developer
# operation: read
# question:  Which artefacts need changing, and who owns the change?
# expect:    rows
#
# The last column is the impact of the change, which CQ-15 answers in full for a given artefact.

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?solutionId ?artefact ?owner ?author ?alsoRestingOnIt
WHERE {
  ?solution a gsn:Solution ;
            schema:identifier ?solutionId ;
            gsn:defeated true ;
            gsn:refersTo ?artefact .
  OPTIONAL { ?solution gsnaug:ownedBy ?owner }
  OPTIONAL { ?artefact gsnaug:generatedBy ?author }
  OPTIONAL {
    ?otherSolution gsn:refersTo ?artefact .
    ?claim gsn:supportedBy ?otherSolution ;
           schema:identifier ?alsoRestingOnIt
  }
}
ORDER BY ?solutionId
""" .

gsnprov:query-augmentation-queries-fc36-automation-feasibility
    a gsnprov:Query ;
    rdfs:label "augmentation/queries/fc36_automation_feasibility.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "augmentation/queries/fc36_automation_feasibility.rq" ;
    gsnprov:fileChecksum "9817ed9644f22dd997e0e2d4a529d9f806bc92e8f182273b3a2b98195eb83585" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/augmentation#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Solution ,
        gsn:refersTo ;
    gsnprov:restsOnStatement gsnprov:st-0175 ,
        gsnprov:st-0289 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-78 ;
    gsnprov:queryText """# id:        CQ-78
# role:      Developer
# operation: read
# question:  Which evidence can be generated automatically, and which has been assessed as manual?
# expect:    rows
#
# No mechanism at all means nobody has looked; a mechanism flagged false means automation was
# assessed and rejected. The two are different answers.

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?solutionId ?artefact ?mechanism ?assessment
WHERE {
  ?solution a gsn:Solution ;
            schema:identifier ?solutionId ;
            gsn:refersTo ?artefact .
  OPTIONAL {
    ?artefact gsnaug:generatedWith ?mechanism .
    OPTIONAL { ?mechanism gsnaug:automated ?automated }
  }
  BIND( IF(!BOUND(?mechanism),  "not assessed",
        IF(!BOUND(?automated),  "mechanism named, not flagged",
        IF(?automated,          "automated",
                                "assessed: manual"))) AS ?assessment )
}
ORDER BY ?solutionId
""" .

gsnprov:query-create-assurance-case-skeleton
    a gsnprov:Query ;
    rdfs:label "create_assurance_case_skeleton.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/create_assurance_case_skeleton.rq" ;
    gsnprov:fileChecksum "99fe96c7562077dc87a8e58131a464b386ca5eaa4a264ec372fe4e7c9ce56b53" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://example.org/my-assurance-case#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Argument ,
        gsn:AssuranceCase ,
        gsn:Goal ,
        gsn:argumentType ,
        gsn:contains ,
        gsn:final ,
        gsn:published ,
        gsn:statement ,
        gsn:structured ,
        gsn:top ,
        gsn:undeveloped ;
    gsnprov:restsOnStatement gsnprov:st-0077 ,
        gsnprov:st-0085 ,
        gsnprov:st-0096 ,
        gsnprov:st-0144 ,
        gsnprov:st-0161 ,
        gsnprov:st-0200 ,
        gsnprov:st-0265 ,
        gsnprov:st-0330 ,
        gsnprov:st-0444 ,
        gsnprov:st-0474 ,
        gsnprov:st-0640 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-28 ;
    gsnprov:queryText """# id:        CQ-28
# operation: create
# question:  How is a new, empty assurance case started?
# expect:    insert
#
# The only query in the set that names a case namespace of its own, because there is no
# existing element to derive one from. Change the case: prefix below before running it.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>
PREFIX case:   <https://example.org/my-assurance-case#>

INSERT DATA {
  case:AC1 a gsn:AssuranceCase ;
           schema:identifier "AC1" ;
           rdfs:label "New assurance case" ;
           gsn:statement "The system is acceptably safe for its intended use." ;
           gsn:contains case:Arg1 .

  case:Arg1 a gsn:Argument ;
            schema:identifier "Arg1" ;
            rdfs:label "Top-level argument" ;
            gsn:statement "Argument over the identified hazards." ;
            gsn:argumentType "risk" ;
            gsn:structured true ;
            gsn:final false ;
            gsn:published false ;
            gsn:contains case:G1 .

  case:G1 a gsn:Goal ;
          schema:identifier "G1" ;
          rdfs:label "Goal G1" ;
          gsn:statement "The system is acceptably safe for its intended use." ;
          gsn:top true ;
          gsn:undeveloped true .
}
""" .

gsnprov:query-create-challenge-to-element
    a gsnprov:Query ;
    rdfs:label "create_challenge_to_element.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/create_challenge_to_element.rq" ;
    gsnprov:fileChecksum "9ecdaa6b9abd7310973e4c4e31e6f1930e94c572371b073a4431ec61b37dfe24" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Defeater ,
        gsn:Goal ,
        gsn:challenges ,
        gsn:statement ,
        gsn:undeveloped ;
    gsnprov:restsOnStatement gsnprov:st-0161 ,
        gsnprov:st-0200 ,
        gsnprov:st-0265 ,
        gsnprov:st-0696 ,
        gsnprov:st-0740 ,
        gsnprov:st-0760 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-29 ;
    gsnprov:queryText """# id:        CQ-29
# operation: create
# question:  How is a challenge recorded against part of the argument?
# expect:    insert
#
# A challenge shaped as a goal asserts a counter-claim and puts its target in doubt; one
# shaped as a solution cites evidence and defeats it. Change ?challengeType to pick.
# gsn:Defeater is inferred from gsn:challenges, never asserted - see the class's note.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

INSERT {
  ?challenge a ?challengeType ;
             schema:identifier ?challengeId ;
             rdfs:label ?challengeId ;
             gsn:statement ?challengeStatement ;
             gsn:undeveloped true ;
             gsn:challenges ?target .
}
WHERE {
  VALUES (?targetId ?challengeId ?challengeType ?challengeStatement) {   # PARAMETERS
    ("G1.1" "CG3" gsn:Goal
     "The field trial did not cover the night-time subset of the operational design domain.")
  }
  ?target schema:identifier ?targetId .
  FILTER NOT EXISTS { ?existing schema:identifier ?challengeId }
  BIND(IRI(CONCAT(REPLACE(STR(?target), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?challengeId))) AS ?challenge)
}
""" .

gsnprov:query-create-context-for-goal
    a gsnprov:Query ;
    rdfs:label "create_context_for_goal.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/create_context_for_goal.rq" ;
    gsnprov:fileChecksum "25305ea9b02f68914c2b8c42b6b3e8346df9123a572d3f5dfcf6ff71babdcb2a" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Artefact ,
        gsn:Context ,
        gsn:inContextOf ,
        gsn:refersTo ,
        gsn:statement ;
    gsnprov:restsOnStatement gsnprov:st-0111 ,
        gsnprov:st-0181 ,
        gsnprov:st-0218 ,
        gsnprov:st-0265 ,
        gsnprov:st-0289 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-30 ;
    gsnprov:queryText """# id:        CQ-30
# operation: create
# question:  How is a context element added to a goal or strategy, pointing at an artefact?
# expect:    insert

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

INSERT {
  ?element gsn:inContextOf ?context .
  ?context a gsn:Context ;
           schema:identifier ?contextId ;
           rdfs:label ?contextId ;
           gsn:statement ?contextStatement ;
           gsn:refersTo ?artefact .
}
WHERE {
  VALUES (?elementId ?contextId ?contextStatement ?artefactId) {   # PARAMETERS
    ("G1.2" "C4" "The braking demand arbitration is specified in ARB-SPEC-02." "Ev3")
  }
  ?element schema:identifier ?elementId .
  ?artefact a gsn:Artefact ;
            schema:identifier ?artefactId .
  FILTER NOT EXISTS { ?existing schema:identifier ?contextId }
  BIND(IRI(CONCAT(REPLACE(STR(?element), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?contextId))) AS ?context)
}
""" .

gsnprov:query-create-goal-under-parent
    a gsnprov:Query ;
    rdfs:label "create_goal_under_parent.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/create_goal_under_parent.rq" ;
    gsnprov:fileChecksum "3a7e7e1d22a180c5af67bb4c25cd9d0edc866fda20b2c1df3482efdea68ff3a7" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Goal ,
        gsn:statement ,
        gsn:supportedBy ,
        gsn:top ,
        gsn:undeveloped ;
    gsnprov:restsOnStatement gsnprov:st-0144 ,
        gsnprov:st-0161 ,
        gsnprov:st-0200 ,
        gsnprov:st-0207 ,
        gsnprov:st-0265 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-31 ;
    gsnprov:queryText """# id:        CQ-31
# operation: create
# question:  How is a sub-goal added beneath an existing goal or strategy?
# expect:    insert
#
# The new element's IRI is minted in the parent's own namespace, so the query never has
# to know which case it is being run against. Every create query below does the same.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

INSERT {
  ?parent gsn:supportedBy ?new .
  ?new a gsn:Goal ;
       schema:identifier ?newId ;
       rdfs:label ?newId ;
       gsn:statement ?newStatement ;
       gsn:top false ;
       gsn:undeveloped true .
}
WHERE {
  VALUES (?parentId ?newId ?newStatement) {           # PARAMETERS
    ("St1" "G1.4" "Sensor occlusion is detected before it affects the detection rate.")
  }
  ?parent schema:identifier ?parentId .
  FILTER NOT EXISTS { ?existing schema:identifier ?newId }
  BIND(IRI(CONCAT(REPLACE(STR(?parent), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?newId))) AS ?new)
}
""" .

gsnprov:query-create-solution-with-artefact
    a gsnprov:Query ;
    rdfs:label "create_solution_with_artefact.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/create_solution_with_artefact.rq" ;
    gsnprov:fileChecksum "66c5f770e616e3857d1c28332a5377b63d2570f441bf5c15d8eea3cadb3cc50f" ;
    gsnprov:declaresNamespace "http://purl.org/dc/terms/" ,
        "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "http://www.w3.org/2001/XMLSchema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Artefact ,
        gsn:Solution ,
        gsn:refersTo ,
        gsn:statement ,
        gsn:supportedBy ;
    gsnprov:restsOnStatement gsnprov:st-0111 ,
        gsnprov:st-0175 ,
        gsnprov:st-0207 ,
        gsnprov:st-0265 ,
        gsnprov:st-0289 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-32 ;
    gsnprov:queryText """# id:        CQ-32
# operation: create
# question:  How is a new piece of evidence attached to a goal?
# expect:    insert
#
# Evidence enters as two nodes, not one: the artefact is the thing that exists, the
# solution is the argument's reference to it. Conflating them is the commonest ABox error.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>
PREFIX terms:  <http://purl.org/dc/terms/>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>

INSERT {
  ?goal gsn:supportedBy ?solution .
  ?solution a gsn:Solution ;
            schema:identifier ?solutionId ;
            rdfs:label ?solutionId ;
            gsn:statement ?solutionStatement ;
            gsn:refersTo ?artefact .
  ?artefact a gsn:Artefact ;
            schema:identifier ?artefactId ;
            rdfs:label ?artefactLabel ;
            schema:description ?solutionStatement ;
            terms:created ?created .
}
WHERE {
  VALUES (?goalId ?solutionId ?solutionStatement ?artefactId ?artefactLabel ?created) {
    ("G1.2" "Sn6" "Degraded-mode arbitration test report."
     "Ev7" "ARBITRATION-TEST-2026-07" "2026-07-14"^^xsd:date)     # PARAMETERS
  }
  ?goal schema:identifier ?goalId .
  FILTER NOT EXISTS { ?existing schema:identifier ?solutionId }
  BIND(IRI(CONCAT(REPLACE(STR(?goal), "[^#/]*$", ""), ENCODE_FOR_URI(?solutionId))) AS ?solution)
  BIND(IRI(CONCAT(REPLACE(STR(?goal), "[^#/]*$", ""), ENCODE_FOR_URI(?artefactId))) AS ?artefact)
}
""" .

gsnprov:query-create-solutions-for-unreferenced-artefacts
    a gsnprov:Query ;
    rdfs:label "create_solutions_for_unreferenced_artefacts.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/create_solutions_for_unreferenced_artefacts.rq" ;
    gsnprov:fileChecksum "92851d627daf4938cb6f24150e2c8ad6a3c34db63231003009712c89ec589776" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Artefact ,
        gsn:Solution ,
        gsn:refersTo ,
        gsn:statement ;
    gsnprov:restsOnStatement gsnprov:st-0111 ,
        gsnprov:st-0175 ,
        gsnprov:st-0265 ,
        gsnprov:st-0289 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-33 ;
    gsnprov:queryText """# id:        CQ-33
# operation: create
# question:  How are artefacts already in the store turned into solutions in bulk?
# expect:    insert
#
# The import case: evidence arrives from a test pipeline as artefacts, and each one needs
# a solution before the argument can cite it. The identifier is derived from the artefact's,
# so re-running the query adds nothing the second time.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

INSERT {
  ?solution a gsn:Solution ;
            schema:identifier ?solutionId ;
            rdfs:label ?label ;
            gsn:statement ?statement ;
            gsn:refersTo ?artefact .
}
WHERE {
  ?artefact a gsn:Artefact ;
            schema:identifier ?artefactId .
  FILTER NOT EXISTS { ?anySolution gsn:refersTo ?artefact }

  OPTIONAL { ?artefact rdfs:label ?artefactLabel }
  BIND(CONCAT("Sn-", ?artefactId) AS ?solutionId)
  BIND(CONCAT("Solution ", ?solutionId) AS ?label)
  BIND(CONCAT("Reference to ", COALESCE(STR(?artefactLabel), ?artefactId), ".") AS ?statement)
  BIND(IRI(CONCAT(REPLACE(STR(?artefact), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?solutionId))) AS ?solution)
  FILTER NOT EXISTS { ?existing schema:identifier ?solutionId }
}
""" .

gsnprov:query-create-strategy-between-goals
    a gsnprov:Query ;
    rdfs:label "create_strategy_between_goals.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/create_strategy_between_goals.rq" ;
    gsnprov:fileChecksum "7c789447d74acb77fffb07656e2da2e92bfa4d3c650d0e871f85835d2b782776" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Strategy ,
        gsn:statement ,
        gsn:supportedBy ,
        gsn:undeveloped ;
    gsnprov:restsOnStatement gsnprov:st-0167 ,
        gsnprov:st-0200 ,
        gsnprov:st-0207 ,
        gsnprov:st-0265 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-34 ;
    gsnprov:queryText """# id:        CQ-34
# operation: create
# question:  How is a strategy inserted between a goal and the sub-goals it already has?
# expect:    change
#
# Inserting a strategy is a re-parenting, not an addition: the parent's existing support
# links move onto the strategy, or the argument ends up with two routes to the same place.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

DELETE {
  ?parent gsn:supportedBy ?child .
}
INSERT {
  ?parent gsn:supportedBy ?strategy .
  ?strategy a gsn:Strategy ;
            schema:identifier ?strategyId ;
            rdfs:label ?strategyId ;
            gsn:statement ?strategyStatement ;
            gsn:undeveloped false ;
            gsn:supportedBy ?child .
}
WHERE {
  VALUES (?parentId ?strategyId ?strategyStatement) {   # PARAMETERS
    ("G1.1" "St2" "Argument over each detection failure mode in turn.")
  }
  ?parent schema:identifier ?parentId ;
          gsn:supportedBy ?child .
  FILTER NOT EXISTS { ?existing schema:identifier ?strategyId }
  BIND(IRI(CONCAT(REPLACE(STR(?parent), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?strategyId))) AS ?strategy)
}
""" .

gsnprov:query-delete-assurance-case
    a gsnprov:Query ;
    rdfs:label "delete_assurance_case.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/delete_assurance_case.rq" ;
    gsnprov:fileChecksum "444ee763c1ae3f5d3b019eea266e843f539df40af41cd360317d1e80652e3454" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Artefact ,
        gsn:AssuranceCase ,
        gsn:challenges ,
        gsn:contains ,
        gsn:inContextOf ,
        gsn:supportedBy ;
    gsnprov:restsOnStatement gsnprov:st-0077 ,
        gsnprov:st-0111 ,
        gsnprov:st-0207 ,
        gsnprov:st-0218 ,
        gsnprov:st-0474 ,
        gsnprov:st-0696 ,
        gsnprov:st-0740 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-38 ;
    gsnprov:queryText """# id:        CQ-38
# operation: delete
# question:  How is a whole assurance case and everything under it removed?
# expect:    delete
#
# Follows reachability, not gsn:contains alone, which misses elements reached only through
# supportedBy. Artefacts are spared - another case may cite them; use
# delete_unreferenced_artefacts.rq for those.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

DELETE {
  ?node ?outgoing ?object .
  ?subject ?incoming ?node .
}
WHERE {
  VALUES ?caseId { "AC1" }                            # PARAMETER
  ?case a gsn:AssuranceCase ;
        schema:identifier ?caseId .
  ?case (gsn:contains|gsn:supportedBy|gsn:inContextOf|gsn:challenges)* ?node .
  FILTER NOT EXISTS { ?node a gsn:Artefact }
  {
    ?node ?outgoing ?object .
  } UNION {
    ?subject ?incoming ?node .
  }
}
""" .

gsnprov:query-delete-challenge-and-its-effects
    a gsnprov:Query ;
    rdfs:label "delete_challenge_and_its_effects.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/delete_challenge_and_its_effects.rq" ;
    gsnprov:fileChecksum "3248e8f70f1a0fc69c5e0ee3f9ce1db854a6cc0b324562a13497504b9b1c614d" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:challenges ,
        gsn:defeated ,
        gsn:inDoubt ;
    gsnprov:restsOnStatement gsnprov:st-0696 ,
        gsnprov:st-0699 ,
        gsnprov:st-0731 ,
        gsnprov:st-0740 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-39 ;
    gsnprov:queryText """# id:        CQ-39
# operation: delete
# question:  How is a challenge withdrawn, together with the doubt and defeat it caused?
# expect:    delete
#
# Withdrawing the challenge is not enough on its own: gsn:inDoubt and gsn:defeated were
# written onto the target by a rule, and nothing retracts them when the reason goes away.
# Clear them here, then re-run the dialectic updates to re-derive what still holds.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

DELETE {
  ?challenge ?outgoing ?object .
  ?subject ?incoming ?challenge .
  ?relationship ?relationshipProperty ?relationshipValue .
  ?target gsn:inDoubt ?doubt .
  ?target gsn:defeated ?defeated .
}
WHERE {
  VALUES ?challengeId { "CG1" }                       # PARAMETER
  ?challenge schema:identifier ?challengeId .
  {
    ?challenge gsn:challenges ?target .
    OPTIONAL { ?target gsn:inDoubt ?doubt }
    OPTIONAL { ?target gsn:defeated ?defeated }
  } UNION {
    ?challenge ?outgoing ?object .
  } UNION {
    ?subject ?incoming ?challenge .
  } UNION {
    ?relationship (rdf:subject|rdf:object) ?challenge ;
                  ?relationshipProperty ?relationshipValue .
  }
}
""" .

gsnprov:query-delete-element-and-its-links
    a gsnprov:Query ;
    rdfs:label "delete_element_and_its_links.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/delete_element_and_its_links.rq" ;
    gsnprov:fileChecksum "aaa56b36759483509e238e594c89017d77ad5367c95fca14d0e446e31cf5cfbf" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:answersQuestion gsnprov:cq-CQ-40 ;
    gsnprov:queryText """# id:        CQ-40
# operation: delete
# question:  How is an element removed without leaving dangling references to it?
# expect:    delete
#
# Both directions and the reifications. Deleting only the outgoing triples leaves the
# element's identifier gone but its parents still pointing at a node with no type.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

DELETE {
  ?element ?outgoing ?object .
  ?subject ?incoming ?element .
  ?relationship ?relationshipProperty ?relationshipValue .
}
WHERE {
  VALUES ?elementId { "G1.2" }                        # PARAMETER
  ?element schema:identifier ?elementId .
  {
    ?element ?outgoing ?object .
  } UNION {
    ?subject ?incoming ?element .
  } UNION {
    ?relationship (rdf:subject|rdf:object) ?element ;
                  ?relationshipProperty ?relationshipValue .
  }
}
""" .

gsnprov:query-delete-materialised-inferences
    a gsnprov:Query ;
    rdfs:label "delete_materialised_inferences.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/delete_materialised_inferences.rq" ;
    gsnprov:fileChecksum "7dc8f0bcf9b63788527a1a744b74af5886f19814fefd107c7d2d94ee4b94318c" ;
    gsnprov:declaresNamespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Defeater ,
        gsn:away ,
        gsn:consistentWith ,
        gsn:contract ,
        gsn:defeated ,
        gsn:inDoubt ,
        gsn:public ,
        gsn:relationshipType ,
        gsn:top ,
        gsn:true ,
        gsn:valid ;
    gsnprov:restsOnStatement gsnprov:st-0114 ,
        gsnprov:st-0120 ,
        gsnprov:st-0144 ,
        gsnprov:st-0234 ,
        gsnprov:st-0490 ,
        gsnprov:st-0525 ,
        gsnprov:st-0534 ,
        gsnprov:st-0565 ,
        gsnprov:st-0699 ,
        gsnprov:st-0731 ,
        gsnprov:st-0760 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-41 ;
    gsnprov:queryText """# id:        CQ-41
# operation: delete
# question:  How are the conclusions written by queries/rules/ cleared before re-running them?
# expect:    delete
#
# Only the four things nothing but a rule ever writes. gsn:valid, gsn:true, gsn:away,
# gsn:top, gsn:public and gsn:contract are also set by hand, so clearing them would destroy
# assertions; the reified relationships the rules mint cannot be told from hand-drawn ones.
#
# To keep derived and asserted apart, run tools/run_rules.py --out on a copy instead of
# materialising in place.

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DELETE {
  ?element gsn:inDoubt ?doubt .
  ?element gsn:defeated ?defeated .
  ?element gsn:consistentWith ?consistent .
  ?relationship gsn:relationshipType ?type .
  ?defeater rdf:type gsn:Defeater .
}
WHERE {
  { ?element gsn:inDoubt ?doubt }
  UNION
  { ?element gsn:defeated ?defeated }
  UNION
  { ?element gsn:consistentWith ?consistent }
  UNION
  { ?relationship rdf:subject ?any ; gsn:relationshipType ?type }
  UNION
  { ?defeater rdf:type gsn:Defeater }
}
""" .

gsnprov:query-delete-support-link
    a gsnprov:Query ;
    rdfs:label "delete_support_link.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/delete_support_link.rq" ;
    gsnprov:fileChecksum "0416f4d84351725f716521677b455fb5343e9c6b0f88b987bc26ce979cf3ba6c" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:supportedBy ;
    gsnprov:restsOnStatement gsnprov:st-0207 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-42 ;
    gsnprov:queryText """# id:        CQ-42
# operation: delete
# question:  How is one support or context link removed, leaving both elements in place?
# expect:    delete
#
# Detaching a branch rather than deleting it - the sub-argument survives and can be
# re-parented. The reification of the link goes with it, or it outlives what it describes.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

DELETE {
  ?from ?predicate ?to .
  ?relationship ?relationshipProperty ?relationshipValue .
}
WHERE {
  VALUES (?fromId ?toId ?predicate) {                 # PARAMETERS
    ("G1.1" "Sn2" gsn:supportedBy)
  }
  ?from schema:identifier ?fromId .
  ?to schema:identifier ?toId .
  ?from ?predicate ?to .
  OPTIONAL {
    ?relationship rdf:subject ?from ;
                  rdf:object ?to ;
                  ?relationshipProperty ?relationshipValue .
  }
}
""" .

gsnprov:query-delete-unreferenced-artefacts
    a gsnprov:Query ;
    rdfs:label "delete_unreferenced_artefacts.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/delete_unreferenced_artefacts.rq" ;
    gsnprov:fileChecksum "ecfbe561c95d89139bdf90f61683681b4bfa65c9aa44c3aba7a47b22b534c040" ;
    gsnprov:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Artefact ,
        gsn:refersTo ;
    gsnprov:restsOnStatement gsnprov:st-0111 ,
        gsnprov:st-0289 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-43 ;
    gsnprov:queryText """# id:        CQ-43
# operation: delete
# question:  How are artefacts no solution or context cites any more cleared out?
# expect:    delete
#
# Run read_solutions_without_artefact first. An artefact that looks unreferenced because
# the solution meant to cite it was never linked is not rubbish, it is a broken link.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>

DELETE {
  ?artefact ?property ?value .
  ?subject ?incoming ?artefact .
}
WHERE {
  ?artefact a gsn:Artefact .
  FILTER NOT EXISTS { ?reference gsn:refersTo ?artefact }
  {
    ?artefact ?property ?value .
  } UNION {
    ?subject ?incoming ?artefact .
  }
}
""" .

gsnprov:query-read-assurance-case-inventory
    a gsnprov:Query ;
    rdfs:label "read_assurance_case_inventory.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/read_assurance_case_inventory.rq" ;
    gsnprov:fileChecksum "2f59a0919c604d195396dd58797947023cf2e40f040ed2a4527b00f26e5e737a" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Argument ,
        gsn:AssuranceCase ,
        gsn:contains ,
        gsn:statement ;
    gsnprov:restsOnStatement gsnprov:st-0077 ,
        gsnprov:st-0085 ,
        gsnprov:st-0265 ,
        gsnprov:st-0474 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-01 ;
    gsnprov:queryText """# id:        CQ-01
# operation: read
# question:  What assurance cases are in the store, and what arguments does each contain?
# expect:    rows
#
# The orientation query: run this first against an unfamiliar store.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

SELECT ?caseId ?caseLabel ?argumentId ?argumentStatement
WHERE {
  ?case a gsn:AssuranceCase ;
        schema:identifier ?caseId .
  OPTIONAL { ?case rdfs:label ?caseLabel }
  OPTIONAL {
    ?case gsn:contains ?argument .
    ?argument a gsn:Argument ;
              schema:identifier ?argumentId .
    OPTIONAL { ?argument gsn:statement ?argumentStatement }
  }
}
ORDER BY ?caseId ?argumentId
""" .

gsnprov:query-read-assurance-claim-points
    a gsnprov:Query ;
    rdfs:label "read_assurance_claim_points.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/read_assurance_claim_points.rq" ;
    gsnprov:fileChecksum "b6b8ea7624ad201071feb9436e1625bf752ecf13a05fbbbc1b20eaf5ce490bc7" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:associatedWith ,
        gsn:assuranceClaimPoint ,
        gsn:statement ;
    gsnprov:restsOnStatement gsnprov:st-0265 ,
        gsnprov:st-0635 ,
        gsnprov:st-0658 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-02 ;
    gsnprov:queryText """# id:        CQ-02
# operation: read
# question:  Where are the assurance claim points, and what confidence argument backs each?
# expect:    rows

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

SELECT ?relationshipId ?subjectId ?objectId ?confidenceArgumentId ?confidenceStatement
WHERE {
  ?relationship gsn:assuranceClaimPoint ?acp ;
                schema:identifier ?relationshipId .
  FILTER(STR(?acp) = "true")
  OPTIONAL { ?relationship rdf:subject ?subject . ?subject schema:identifier ?subjectId }
  OPTIONAL { ?relationship rdf:object  ?object  . ?object  schema:identifier ?objectId }
  OPTIONAL {
    ?relationship gsn:associatedWith ?argument .
    ?argument schema:identifier ?confidenceArgumentId .
    OPTIONAL { ?argument gsn:statement ?confidenceStatement }
  }
}
ORDER BY ?relationshipId
""" .

gsnprov:query-read-away-elements
    a gsnprov:Query ;
    rdfs:label "read_away_elements.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/read_away_elements.rq" ;
    gsnprov:fileChecksum "ed83828a1994547893bad1f18f35f7139c61133bb21e3ffdcb05a2a99fd18bad" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Module ,
        gsn:away ,
        gsn:contains ,
        gsn:public ;
    gsnprov:restsOnStatement gsnprov:st-0469 ,
        gsnprov:st-0474 ,
        gsnprov:st-0490 ,
        gsnprov:st-0534 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-03 ;
    gsnprov:queryText """# id:        CQ-03
# operation: read
# question:  Which away elements are referenced, and does the module they come from exist?
# expect:    rows
#
# An away element repeats something declared elsewhere. If the elsewhere is not in the
# store, the reference is dangling and the argument is not self-contained.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT ?elementId ?type ?homeModuleId ?public
WHERE {
  ?element gsn:away ?away ;
           a ?type ;
           schema:identifier ?elementId .
  FILTER(STR(?away) = "true")
  OPTIONAL {
    ?home a gsn:Module ;
          gsn:contains+ ?element ;
          schema:identifier ?homeModuleId .
  }
  BIND(EXISTS { ?element gsn:public ?p . FILTER(STR(?p) = "true") } AS ?public)
}
ORDER BY ?elementId
""" .

gsnprov:query-read-case-summary-counts
    a gsnprov:Query ;
    rdfs:label "read_case_summary_counts.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/read_case_summary_counts.rq" ;
    gsnprov:fileChecksum "83e367a79bafed47fc4c678a116cef186e8bce7cf566aba82c29ae20f1fb4ba0" ;
    gsnprov:declaresNamespace "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:GSNElement ;
    gsnprov:restsOnStatement gsnprov:st-0132 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-04 ;
    gsnprov:queryText """# id:        CQ-04
# operation: read
# question:  How many elements of each GSN type does the case contain?
# expect:    rows
#
# rdfs:subClassOf* walks the TBox, so a Solution is counted as a Solution and the query
# still knows it is a GSN element. Nothing here needs a reasoner to have run first.

PREFIX gsn:  <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?type (COUNT(DISTINCT ?element) AS ?count)
WHERE {
  ?element a ?type .
  ?type rdfs:subClassOf* gsn:GSNElement .
}
GROUP BY ?type
ORDER BY DESC(?count) ?type
""" .

gsnprov:query-read-challenges-and-their-targets
    a gsnprov:Query ;
    rdfs:label "read_challenges_and_their_targets.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/read_challenges_and_their_targets.rq" ;
    gsnprov:fileChecksum "230d55b9f4a3f4e5124a52fa306af604a00fde65535fdc58aec7322e5999e5d1" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Defeater ,
        gsn:Goal ,
        gsn:Solution ,
        gsn:challenges ,
        gsn:statement ;
    gsnprov:restsOnStatement gsnprov:st-0161 ,
        gsnprov:st-0175 ,
        gsnprov:st-0265 ,
        gsnprov:st-0696 ,
        gsnprov:st-0740 ,
        gsnprov:st-0760 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-63 ;
    gsnprov:queryText """# id:        CQ-05
# operation: read
# question:  What challenges have been raised, against what, and by what kind of defeater?
# expect:    rows
#
# A goal-shaped challenge puts its target in doubt; a solution-shaped one cites evidence
# and defeats it. The distinction decides how urgent the row is.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT ?challengeId ?challengeKind ?challengeStatement ?targetId ?targetType
WHERE {
  ?challenge gsn:challenges ?target ;
             schema:identifier ?challengeId ;
             a ?challengeKind .
  FILTER(?challengeKind IN (gsn:Goal, gsn:Solution, gsn:Defeater))
  OPTIONAL { ?challenge gsn:statement ?challengeStatement }
  OPTIONAL {
    ?target schema:identifier ?targetId ;
            a ?targetType .
  }
}
ORDER BY ?challengeId
""" .

gsnprov:query-read-claim-points-without-confidence-argument
    a gsnprov:Query ;
    rdfs:label "read_claim_points_without_confidence_argument.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/read_claim_points_without_confidence_argument.rq" ;
    gsnprov:fileChecksum "471a118c45f8bc641f08e337f6692c785a05a0b80eedda99953956d9d5cbac47" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:argumentType ,
        gsn:associatedWith ,
        gsn:assuranceClaimPoint ;
    gsnprov:restsOnStatement gsnprov:st-0635 ,
        gsnprov:st-0640 ,
        gsnprov:st-0658 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-06 ;
    gsnprov:queryText """# id:        CQ-06
# operation: read
# question:  Which assurance claim points have no confidence argument behind them?
# expect:    rows
#
# An assurance claim point is a promise that confidence in this step has been argued
# somewhere. One with nothing associated is the promise unkept.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

SELECT ?relationshipId ?subjectId ?objectId
WHERE {
  ?relationship gsn:assuranceClaimPoint ?acp ;
                schema:identifier ?relationshipId .
  FILTER(STR(?acp) = "true")
  OPTIONAL { ?relationship rdf:subject ?subject . ?subject schema:identifier ?subjectId }
  OPTIONAL { ?relationship rdf:object  ?object  . ?object  schema:identifier ?objectId }

  FILTER NOT EXISTS {
    ?relationship gsn:associatedWith ?argument .
    ?argument gsn:argumentType "confidence" .
  }
}
ORDER BY ?relationshipId
""" .

gsnprov:query-read-context-in-scope-for-goal
    a gsnprov:Query ;
    rdfs:label "read_context_in_scope_for_goal.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/read_context_in_scope_for_goal.rq" ;
    gsnprov:fileChecksum "4608835e631e66d96c5c2d70139a3c57bdcb0c65f0c1b1aedcac83980958319e" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:GSNElement ,
        gsn:inContextOf ,
        gsn:statement ,
        gsn:supportedBy ;
    gsnprov:restsOnStatement gsnprov:st-0132 ,
        gsnprov:st-0207 ,
        gsnprov:st-0218 ,
        gsnprov:st-0265 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-44 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-45 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-46 ;
    gsnprov:queryText """# id:        CQ-07
# operation: read
# question:  What context, assumptions and justifications are in scope for a given goal?
# expect:    rows
#
# Context is inherited down the support chain (SWRL rule "Context Inheritance"), so a
# goal is read in the context declared on it AND on everything above it.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

SELECT DISTINCT ?contextId ?type ?statement ?declaredOnId ?inherited
WHERE {
  VALUES ?goalId { "G1.1" }           # PARAMETER: the goal being read

  ?goal schema:identifier ?goalId .
  ?ancestor gsn:supportedBy* ?goal .
  ?ancestor gsn:inContextOf ?context ;
            schema:identifier ?declaredOnId .
  ?context a ?type ;
           schema:identifier ?contextId .
  ?type rdfs:subClassOf* gsn:GSNElement .
  OPTIONAL { ?context gsn:statement ?statement }
  BIND(?ancestor != ?goal AS ?inherited)
}
ORDER BY ?inherited ?contextId
""" .

gsnprov:query-read-duplicate-identifiers
    a gsnprov:Query ;
    rdfs:label "read_duplicate_identifiers.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/read_duplicate_identifiers.rq" ;
    gsnprov:fileChecksum "e4877600a29008497c46ad7528f8d38f20d9e2d392907d53af064ec140501079" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Argument ,
        gsn:Artefact ,
        gsn:AssuranceCase ,
        gsn:GSNElement ,
        gsn:Pattern ,
        gsn:Relationship ;
    gsnprov:restsOnStatement gsnprov:st-0077 ,
        gsnprov:st-0085 ,
        gsnprov:st-0111 ,
        gsnprov:st-0132 ,
        gsnprov:st-0291 ,
        gsnprov:st-0369 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-08 ;
    gsnprov:queryText """# id:        CQ-08
# operation: read
# question:  Do two distinct elements share a schema:identifier?
# expect:    rows
#
# The ontology requires exactly one identifier per element and the SWRL rules invalidate
# both parties to a clash (S25, S41), because every other query addresses elements by it.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

SELECT ?identifier (COUNT(DISTINCT ?element) AS ?holders) (GROUP_CONCAT(DISTINCT STR(?element); separator=" ") AS ?elements)
WHERE {
  VALUES ?kind { gsn:GSNElement gsn:Argument gsn:Artefact gsn:AssuranceCase
                 gsn:Pattern gsn:Relationship }
  ?element a/rdfs:subClassOf* ?kind ;
           schema:identifier ?identifier .
}
GROUP BY ?identifier
HAVING (COUNT(DISTINCT ?element) > 1)
ORDER BY ?identifier
""" .

gsnprov:query-read-element-by-identifier
    a gsnprov:Query ;
    rdfs:label "read_element_by_identifier.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/read_element_by_identifier.rq" ;
    gsnprov:fileChecksum "665b5562757baf278d6632c8de9521066b33ded437130f6f8708e5e0e9e38397" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:associatedWith ,
        gsn:challenges ,
        gsn:inContextOf ,
        gsn:instantiationOf ,
        gsn:refersTo ,
        gsn:statement ,
        gsn:substitutedBy ,
        gsn:supportedBy ;
    gsnprov:restsOnStatement gsnprov:st-0207 ,
        gsnprov:st-0218 ,
        gsnprov:st-0265 ,
        gsnprov:st-0289 ,
        gsnprov:st-0305 ,
        gsnprov:st-0574 ,
        gsnprov:st-0658 ,
        gsnprov:st-0696 ,
        gsnprov:st-0740 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-09 ;
    gsnprov:queryText """# id:        CQ-09
# operation: read
# question:  What does the element with a given identifier say, and what is it linked to?
# expect:    rows
#
# The addressing primitive. Every GSN element carries exactly one schema:identifier, so
# that - not the IRI - is how a person refers to an element.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

SELECT ?element ?type ?label ?statement ?property ?linkedId
WHERE {
  VALUES ?elementId { "G1" }          # PARAMETER: the identifier to look up

  ?element schema:identifier ?elementId ;
           a ?type .
  OPTIONAL { ?element rdfs:label ?label }
  OPTIONAL { ?element gsn:statement ?statement }
  OPTIONAL {
    VALUES ?property { gsn:supportedBy gsn:inContextOf gsn:refersTo gsn:challenges
                       gsn:instantiationOf gsn:substitutedBy gsn:associatedWith }
    ?element ?property ?linked .
    ?linked schema:identifier ?linkedId .
  }
}
ORDER BY ?type ?property ?linkedId
""" .

gsnprov:query-read-element-status-flags
    a gsnprov:Query ;
    rdfs:label "read_element_status_flags.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/read_element_status_flags.rq" ;
    gsnprov:fileChecksum "1f5c76ac39a52f90207843d019b52c9d1f8ac2531c25d28b6a989cdfa144cde8" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:defeated ,
        gsn:inDoubt ,
        gsn:true ,
        gsn:valid ;
    gsnprov:restsOnStatement gsnprov:st-0114 ,
        gsnprov:st-0234 ,
        gsnprov:st-0699 ,
        gsnprov:st-0731 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-54 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-67 ;
    gsnprov:queryText """# id:        CQ-10
# operation: read
# question:  What is the current status of every element - valid, true, in doubt, defeated?
# expect:    rows
#
# One row per flag rather than one row per element, because the flags are set by different
# rules at different times and the useful question is usually about one of them.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT ?elementId ?flag ?value
WHERE {
  VALUES ?flag { gsn:valid gsn:true gsn:inDoubt gsn:defeated }
  ?element ?flag ?value ;
           schema:identifier ?elementId .
}
ORDER BY ?elementId ?flag
""" .

gsnprov:query-read-elements-unreachable-from-top-goal
    a gsnprov:Query ;
    rdfs:label "read_elements_unreachable_from_top_goal.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/read_elements_unreachable_from_top_goal.rq" ;
    gsnprov:fileChecksum "33caeb3a5a6ba6b0b02733f9c4a8034d7cd41535edd6c9b716e6f82a79e59edc" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:GSNElement ,
        gsn:Goal ,
        gsn:inContextOf ,
        gsn:refersTo ,
        gsn:statement ,
        gsn:supportedBy ,
        gsn:top ;
    gsnprov:restsOnStatement gsnprov:st-0132 ,
        gsnprov:st-0144 ,
        gsnprov:st-0161 ,
        gsnprov:st-0207 ,
        gsnprov:st-0218 ,
        gsnprov:st-0265 ,
        gsnprov:st-0289 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-11 ;
    gsnprov:queryText """# id:        CQ-11
# operation: read
# question:  Which elements are not reachable from any top goal - present but unargued?
# expect:    rows
#
# Reachability is over support and context together, since a context element is part of
# the argument without ever being supported by anything.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

SELECT ?elementId ?type ?statement
WHERE {
  ?element a ?type ;
           schema:identifier ?elementId .
  ?type rdfs:subClassOf* gsn:GSNElement .
  OPTIONAL { ?element gsn:statement ?statement }

  FILTER NOT EXISTS {
    ?top a gsn:Goal ;
         gsn:top ?t .
    FILTER(STR(?t) = "true")
    ?top (gsn:supportedBy|gsn:inContextOf|gsn:refersTo)* ?element .
  }
}
ORDER BY ?elementId
""" .

gsnprov:query-read-evidence-supporting-goal
    a gsnprov:Query ;
    rdfs:label "read_evidence_supporting_goal.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/read_evidence_supporting_goal.rq" ;
    gsnprov:fileChecksum "f5add6cda83ba879c298b56f8e1d95cf40247564a68b72b98313eea44fe92a58" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Solution ,
        gsn:refersTo ,
        gsn:statement ,
        gsn:supportedBy ;
    gsnprov:restsOnStatement gsnprov:st-0175 ,
        gsnprov:st-0207 ,
        gsnprov:st-0265 ,
        gsnprov:st-0289 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-51 ;
    gsnprov:queryText """# id:        CQ-12
# operation: read
# question:  What evidence ultimately supports a given goal?
# expect:    rows
#
# Solutions are references to evidence; the artefact behind the reference is what an
# auditor actually asks to see, so both are returned.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

SELECT DISTINCT ?solutionId ?solutionStatement ?artefactId ?artefactLabel
WHERE {
  VALUES ?goalId { "G1" }             # PARAMETER: the goal to trace

  ?goal schema:identifier ?goalId .
  ?goal gsn:supportedBy+ ?solution .
  ?solution a gsn:Solution ;
            schema:identifier ?solutionId .
  OPTIONAL { ?solution gsn:statement ?solutionStatement }
  OPTIONAL {
    ?solution gsn:refersTo ?artefact .
    ?artefact schema:identifier ?artefactId .
    OPTIONAL { ?artefact rdfs:label ?artefactLabel }
  }
}
ORDER BY ?solutionId
""" .

gsnprov:query-read-goal-support-tree
    a gsnprov:Query ;
    rdfs:label "read_goal_support_tree.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/read_goal_support_tree.rq" ;
    gsnprov:fileChecksum "9d9dc8c5968292ba00c14b18c96064a868c50c4bcd34289b22edb21fd7031caa" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:statement ,
        gsn:supportedBy ;
    gsnprov:restsOnStatement gsnprov:st-0207 ,
        gsnprov:st-0265 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-47 ;
    gsnprov:queryText """# id:        CQ-13
# operation: read
# question:  What is the whole argument beneath a given goal?
# expect:    rows
#
# ?depth is the length of the shortest support chain from the root, which is what makes
# the result readable as a tree rather than a bag of elements.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT ?descendantId ?type ?statement (MIN(?hops) AS ?depth)
WHERE {
  VALUES ?rootId { "G1" }             # PARAMETER: the goal to expand

  ?root schema:identifier ?rootId .
  ?root gsn:supportedBy+ ?descendant .
  ?descendant a ?type ;
              schema:identifier ?descendantId .
  OPTIONAL { ?descendant gsn:statement ?statement }
  {
    SELECT ?root ?descendant (COUNT(?step) AS ?hops)
    WHERE {
      ?root gsn:supportedBy* ?step .
      ?step gsn:supportedBy+ ?descendant .
    }
    GROUP BY ?root ?descendant
  }
}
GROUP BY ?descendantId ?type ?statement
ORDER BY ?depth ?descendantId
""" .

gsnprov:query-read-goals-affected-by-challenge
    a gsnprov:Query ;
    rdfs:label "read_goals_affected_by_challenge.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/read_goals_affected_by_challenge.rq" ;
    gsnprov:fileChecksum "5416f069e4c972b3e8e218f861cf7ec7e9e2e780b7a359b1cc0a78412f193923" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Goal ,
        gsn:Strategy ,
        gsn:challenges ,
        gsn:statement ,
        gsn:supportedBy ;
    gsnprov:restsOnStatement gsnprov:st-0161 ,
        gsnprov:st-0167 ,
        gsnprov:st-0207 ,
        gsnprov:st-0265 ,
        gsnprov:st-0696 ,
        gsnprov:st-0740 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-63 ;
    gsnprov:queryText """# id:        CQ-14
# operation: read
# question:  Which claims above a challenged element lose support if the challenge stands?
# expect:    rows
#
# The challenge is levied at one element; what matters is everything resting on it.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT DISTINCT ?affectedId ?type ?statement ?challengeId ?targetId
WHERE {
  ?challenge gsn:challenges ?target ;
             schema:identifier ?challengeId .
  ?target schema:identifier ?targetId .
  ?affected gsn:supportedBy* ?target ;
            a ?type ;
            schema:identifier ?affectedId .
  FILTER(?type IN (gsn:Goal, gsn:Strategy))
  OPTIONAL { ?affected gsn:statement ?statement }
}
ORDER BY ?challengeId ?affectedId
""" .

gsnprov:query-read-goals-resting-on-artefact
    a gsnprov:Query ;
    rdfs:label "read_goals_resting_on_artefact.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/read_goals_resting_on_artefact.rq" ;
    gsnprov:fileChecksum "31dad7722729a2ee585e5393d75ebec3903ca8a35ff136c714b8e883db17d98d" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Goal ,
        gsn:refersTo ,
        gsn:statement ,
        gsn:supportedBy ;
    gsnprov:restsOnStatement gsnprov:st-0161 ,
        gsnprov:st-0207 ,
        gsnprov:st-0265 ,
        gsnprov:st-0289 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-77 ;
    gsnprov:queryText """# id:        CQ-15
# operation: read
# question:  If a given artefact is withdrawn or superseded, which claims are affected?
# expect:    rows
#
# The impact analysis that has to be run before any evidence item is replaced.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT DISTINCT ?goalId ?statement ?solutionId
WHERE {
  VALUES ?artefactId { "Ev2" }        # PARAMETER: the artefact in question

  ?artefact schema:identifier ?artefactId .
  ?solution gsn:refersTo ?artefact ;
            schema:identifier ?solutionId .
  ?goal gsn:supportedBy+ ?solution ;
        a gsn:Goal ;
        schema:identifier ?goalId .
  OPTIONAL { ?goal gsn:statement ?statement }
}
ORDER BY ?goalId
""" .

gsnprov:query-read-goals-without-support
    a gsnprov:Query ;
    rdfs:label "read_goals_without_support.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/read_goals_without_support.rq" ;
    gsnprov:fileChecksum "0fb730490c0b533ecb77bbf85d3b986fc7763f768190076e7ef7f5b0a9e54e60" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Goal ,
        gsn:away ,
        gsn:statement ,
        gsn:supportedBy ,
        gsn:toBeSupportedByContract ,
        gsn:undeveloped ;
    gsnprov:restsOnStatement gsnprov:st-0161 ,
        gsnprov:st-0200 ,
        gsnprov:st-0207 ,
        gsnprov:st-0265 ,
        gsnprov:st-0490 ,
        gsnprov:st-0542 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-46 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-48 ;
    gsnprov:queryText """# id:        CQ-16
# operation: read
# question:  Which goals have no support at all and are not admitted to be undeveloped?
# expect:    rows
#
# An unadmitted gap: the argument stops, and nothing on the diagram says so. This is the
# single most useful completeness check in the set.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT ?goalId ?statement
WHERE {
  ?goal a gsn:Goal ;
        schema:identifier ?goalId .
  OPTIONAL { ?goal gsn:statement ?statement }

  FILTER NOT EXISTS { ?goal gsn:supportedBy ?anything }
  FILTER NOT EXISTS { ?goal gsn:undeveloped ?u . FILTER(STR(?u) = "true") }
  FILTER NOT EXISTS { ?goal gsn:toBeSupportedByContract ?c . FILTER(STR(?c) = "true") }
  FILTER NOT EXISTS { ?goal gsn:away ?a . FILTER(STR(?a) = "true") }
}
ORDER BY ?goalId
""" .

gsnprov:query-read-invalid-elements
    a gsnprov:Query ;
    rdfs:label "read_invalid_elements.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/read_invalid_elements.rq" ;
    gsnprov:fileChecksum "03b4c76fd1e749ef9a44d4886bb4ce178fe466406d079bb0b7de800f29dd52e0" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:defeated ,
        gsn:inDoubt ,
        gsn:statement ,
        gsn:true ,
        gsn:valid ;
    gsnprov:restsOnStatement gsnprov:st-0114 ,
        gsnprov:st-0234 ,
        gsnprov:st-0265 ,
        gsnprov:st-0699 ,
        gsnprov:st-0731 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-54 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-67 ;
    gsnprov:queryText """# id:        CQ-17
# operation: read
# question:  Which elements or relationships are currently invalid, in doubt or defeated?
# expect:    rows
#
# The three dialectic and validity flags collapsed into one worklist, with the reason.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT DISTINCT ?elementId ?reason ?statement
WHERE {
  ?element schema:identifier ?elementId .
  OPTIONAL { ?element gsn:statement ?statement }
  {
    ?element gsn:valid ?v . FILTER(STR(?v) = "false")
    BIND("invalid" AS ?reason)
  } UNION {
    ?element gsn:defeated ?d . FILTER(STR(?d) = "true")
    BIND("defeated" AS ?reason)
  } UNION {
    ?element gsn:inDoubt ?i . FILTER(STR(?i) = "true")
    BIND("in doubt" AS ?reason)
  } UNION {
    ?element gsn:true ?t . FILTER(STR(?t) = "false")
    BIND("asserted false" AS ?reason)
  }
}
ORDER BY ?elementId ?reason
""" .

gsnprov:query-read-module-dependencies
    a gsnprov:Query ;
    rdfs:label "read_module_dependencies.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/read_module_dependencies.rq" ;
    gsnprov:fileChecksum "ab7348099f64abe9d2bcd827e009bc50440cd5cd86cd7480fc74196dc5bbc06d" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Module ,
        gsn:contains ,
        gsn:inContextOf ,
        gsn:supportedBy ;
    gsnprov:restsOnStatement gsnprov:st-0207 ,
        gsnprov:st-0218 ,
        gsnprov:st-0469 ,
        gsnprov:st-0474 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-18 ;
    gsnprov:queryText """# id:        CQ-18
# operation: read
# question:  Which modules depend on which, and through which elements?
# expect:    rows
#
# The module-level edge is derived from the element-level one, so the witness element is
# returned with it: a dependency nobody can point at an element for is a modelling error.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT DISTINCT ?fromModuleId ?kind ?toModuleId ?viaFromId ?viaToId
WHERE {
  ?from a gsn:Module ; schema:identifier ?fromModuleId ; gsn:contains+ ?viaFrom .
  ?to   a gsn:Module ; schema:identifier ?toModuleId   ; gsn:contains+ ?viaTo .
  FILTER(?from != ?to)
  ?viaFrom schema:identifier ?viaFromId .
  ?viaTo   schema:identifier ?viaToId .
  {
    ?viaFrom gsn:supportedBy ?viaTo .
    BIND("supportedBy" AS ?kind)
  } UNION {
    ?viaFrom gsn:inContextOf ?viaTo .
    BIND("inContextOf" AS ?kind)
  }
}
ORDER BY ?fromModuleId ?toModuleId
""" .

gsnprov:query-read-pattern-instantiations
    a gsnprov:Query ;
    rdfs:label "read_pattern_instantiations.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/read_pattern_instantiations.rq" ;
    gsnprov:fileChecksum "99bb0072389050021722288ead795489c9cbf5a8749497fed6b0df94e7be1973" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Pattern ,
        gsn:applicability ,
        gsn:consequences ,
        gsn:instantiationOf ,
        gsn:intent ;
    gsnprov:restsOnStatement gsnprov:st-0305 ,
        gsnprov:st-0369 ,
        gsnprov:st-0382 ,
        gsnprov:st-0407 ,
        gsnprov:st-0412 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-75 ;
    gsnprov:queryText """# id:        CQ-19
# operation: read
# question:  Which elements instantiate which argument pattern, and is the pattern's own
#            documentation complete?
# expect:    rows
#
# The standard asks a pattern to state its intent, applicability and consequences before
# anyone reuses it. Missing sections are how a pattern gets applied out of context.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

SELECT ?patternId ?patternLabel ?instanceId ?hasIntent ?hasApplicability ?hasConsequences
WHERE {
  ?pattern a/rdfs:subClassOf* gsn:Pattern ;
           schema:identifier ?patternId .
  OPTIONAL { ?pattern rdfs:label ?patternLabel }
  OPTIONAL {
    ?instance gsn:instantiationOf ?pattern ;
              schema:identifier ?instanceId .
  }
  BIND(EXISTS { ?pattern gsn:intent        ?i } AS ?hasIntent)
  BIND(EXISTS { ?pattern gsn:applicability ?a } AS ?hasApplicability)
  BIND(EXISTS { ?pattern gsn:consequences  ?c } AS ?hasConsequences)
}
ORDER BY ?patternId ?instanceId
""" .

gsnprov:query-read-public-elements-in-contract-modules
    a gsnprov:Query ;
    rdfs:label "read_public_elements_in_contract_modules.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/read_public_elements_in_contract_modules.rq" ;
    gsnprov:fileChecksum "c50bf6532d81502e06248f087f7060711f663bc5e740ddf5a8b493f8ac59431c" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:contains ,
        gsn:contract ,
        gsn:public ;
    gsnprov:restsOnStatement gsnprov:st-0474 ,
        gsnprov:st-0525 ,
        gsnprov:st-0534 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-20 ;
    gsnprov:queryText """# id:        CQ-20
# operation: read
# question:  Which public elements sit inside a contract module, where they must not?
# expect:    rows
#
# SWRL rule "Public Contract Invalidation" (S39) as a read: a contract module mediates
# between interfaces and has no interface of its own to publish through.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT ?moduleId ?elementId ?type
WHERE {
  ?module gsn:contract ?contract ;
          gsn:contains+ ?element ;
          schema:identifier ?moduleId .
  FILTER(STR(?contract) = "true")
  ?element gsn:public ?public ;
           a ?type ;
           schema:identifier ?elementId .
  FILTER(STR(?public) = "true")
}
ORDER BY ?moduleId ?elementId
""" .

gsnprov:query-read-relationship-decorators
    a gsnprov:Query ;
    rdfs:label "read_relationship_decorators.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/read_relationship_decorators.rq" ;
    gsnprov:fileChecksum "1d4a8fd283db36e9fe6bfc76594f398facd6783f068cffd92386f2aae23aa7fb" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Relationship ,
        gsn:choice ,
        gsn:maxCardinality ,
        gsn:minCardinality ,
        gsn:multiple ,
        gsn:optional ;
    gsnprov:restsOnStatement gsnprov:st-0291 ,
        gsnprov:st-0312 ,
        gsnprov:st-0316 ,
        gsnprov:st-0334 ,
        gsnprov:st-0336 ,
        gsnprov:st-0340 ,
        gsnprov:st-0353 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-21 ;
    gsnprov:queryText """# id:        CQ-21
# operation: read
# question:  Which relationships carry pattern decorators - optional, multiple, cardinality?
# expect:    rows
#
# These say how a pattern is to be instantiated, and are the part most often lost when a
# pattern is copied into a concrete case by hand.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>

SELECT ?relationshipId ?subjectId ?objectId ?optional ?multiple ?choice ?minCardinality ?maxCardinality
WHERE {
  ?relationship a/rdfs:subClassOf* gsn:Relationship ;
                schema:identifier ?relationshipId .
  OPTIONAL { ?relationship rdf:subject ?subject . ?subject schema:identifier ?subjectId }
  OPTIONAL { ?relationship rdf:object  ?object  . ?object  schema:identifier ?objectId }
  OPTIONAL { ?relationship gsn:optional       ?optional }
  OPTIONAL { ?relationship gsn:multiple       ?multiple }
  OPTIONAL { ?relationship gsn:choice         ?choice }
  OPTIONAL { ?relationship gsn:minCardinality ?minCardinality }
  OPTIONAL { ?relationship gsn:maxCardinality ?maxCardinality }
  FILTER(BOUND(?optional) || BOUND(?multiple) || BOUND(?choice)
         || BOUND(?minCardinality) || BOUND(?maxCardinality))
}
ORDER BY ?relationshipId
""" .

gsnprov:query-read-solutions-without-artefact
    a gsnprov:Query ;
    rdfs:label "read_solutions_without_artefact.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/read_solutions_without_artefact.rq" ;
    gsnprov:fileChecksum "9153b986a67079d7673790e1a5d80c6b211c3e5d73425aece6b77d7699a15924" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Solution ,
        gsn:refersTo ,
        gsn:statement ;
    gsnprov:restsOnStatement gsnprov:st-0175 ,
        gsnprov:st-0265 ,
        gsnprov:st-0289 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-48 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-51 ;
    gsnprov:queryText """# id:        CQ-22
# operation: read
# question:  Which solutions cite no artefact - evidence claimed but not identified?
# expect:    rows

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT ?solutionId ?statement
WHERE {
  ?solution a gsn:Solution ;
            schema:identifier ?solutionId .
  OPTIONAL { ?solution gsn:statement ?statement }
  FILTER NOT EXISTS { ?solution gsn:refersTo ?artefact }
}
ORDER BY ?solutionId
""" .

gsnprov:query-read-stale-evidence
    a gsnprov:Query ;
    rdfs:label "read_stale_evidence.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/read_stale_evidence.rq" ;
    gsnprov:fileChecksum "5a30c0d76ec94ad1424e205c9e72bbe278acd49496044564d97b3cce655d4e78" ;
    gsnprov:declaresNamespace "http://purl.org/dc/terms/" ,
        "http://schema.org/" ,
        "http://www.w3.org/2000/01/rdf-schema#" ,
        "http://www.w3.org/2001/XMLSchema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Artefact ,
        gsn:Goal ,
        gsn:refersTo ,
        gsn:supportedBy ;
    gsnprov:restsOnStatement gsnprov:st-0111 ,
        gsnprov:st-0161 ,
        gsnprov:st-0207 ,
        gsnprov:st-0289 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-23 ;
    gsnprov:queryText """# id:        CQ-23
# operation: read
# question:  Which artefacts predate a given date, and which claims still rest on them?
# expect:    rows
#
# OntoGSN dates nothing itself - an artefact is dated by whatever the ABox uses, here
# dcterms:created. Change the property below if your case records it differently.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>
PREFIX terms:  <http://purl.org/dc/terms/>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>

SELECT ?artefactId ?artefactLabel ?created ?solutionId ?goalId
WHERE {
  VALUES ?cutoff { "2025-01-01"^^xsd:date }   # PARAMETER: anything older than this

  ?artefact a gsn:Artefact ;
            schema:identifier ?artefactId ;
            terms:created ?created .
  FILTER(?created < ?cutoff)
  OPTIONAL { ?artefact rdfs:label ?artefactLabel }
  OPTIONAL {
    ?solution gsn:refersTo ?artefact ;
              schema:identifier ?solutionId .
    OPTIONAL {
      ?goal gsn:supportedBy+ ?solution ;
            a gsn:Goal ;
            schema:identifier ?goalId .
    }
  }
}
ORDER BY ?created ?artefactId
""" .

gsnprov:query-read-support-cycles
    a gsnprov:Query ;
    rdfs:label "read_support_cycles.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/read_support_cycles.rq" ;
    gsnprov:fileChecksum "44a990e8ba2dc1566333c02caf9a47f55048e15e147feedf93361e3dd9a68e8f" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:supportedBy ;
    gsnprov:restsOnStatement gsnprov:st-0207 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-24 ;
    gsnprov:queryText """# id:        CQ-24
# operation: read
# question:  Does any element support itself through a chain - a circular argument?
# expect:    rows
#
# gsn:supportedBy is asymmetric and irreflexive, so a cycle is a contradiction rather
# than a warning; an OWL reasoner would report the whole ABox inconsistent instead of
# telling you where. This says where.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT DISTINCT ?elementId ?type ?viaId
WHERE {
  ?element gsn:supportedBy+ ?element ;
           a ?type ;
           schema:identifier ?elementId .
  ?element gsn:supportedBy ?via .
  ?via schema:identifier ?viaId .
}
ORDER BY ?elementId
""" .

gsnprov:query-read-top-goals
    a gsnprov:Query ;
    rdfs:label "read_top_goals.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/read_top_goals.rq" ;
    gsnprov:fileChecksum "6bfd41458019a2d218a2029403362f6152e81c0a4055bbd2e8b8ff31966d2eba" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Goal ,
        gsn:statement ,
        gsn:supportedBy ,
        gsn:top ;
    gsnprov:restsOnStatement gsnprov:st-0144 ,
        gsnprov:st-0161 ,
        gsnprov:st-0207 ,
        gsnprov:st-0265 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-25 ;
    gsnprov:queryText """# id:        CQ-25
# operation: read
# question:  What is the top goal of each argument - the claim everything else supports?
# expect:    rows
#
# Two ways of being top are accepted: the gsn:top decorator, and being a goal that no
# other element supports. A case where the two disagree is worth looking at.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT DISTINCT ?goalId ?statement ?flaggedTop ?unsupportedFromAbove
WHERE {
  ?goal a gsn:Goal ;
        schema:identifier ?goalId .
  OPTIONAL { ?goal gsn:statement ?statement }
  BIND(EXISTS { ?goal gsn:top ?t . FILTER(STR(?t) = "true") } AS ?flaggedTop)
  BIND(NOT EXISTS { ?parent gsn:supportedBy ?goal } AS ?unsupportedFromAbove)
  FILTER(?flaggedTop || ?unsupportedFromAbove)
}
ORDER BY ?goalId
""" .

gsnprov:query-read-undeveloped-elements
    a gsnprov:Query ;
    rdfs:label "read_undeveloped_elements.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/read_undeveloped_elements.rq" ;
    gsnprov:fileChecksum "7641554bc40a94a8311abb4182b500e5f4073c0d316f95b26374d24940f78f43" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:statement ,
        gsn:supportedBy ,
        gsn:undeveloped ;
    gsnprov:restsOnStatement gsnprov:st-0200 ,
        gsnprov:st-0207 ,
        gsnprov:st-0265 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-46 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-53 ;
    gsnprov:queryText """# id:        CQ-26
# operation: read
# question:  Which lines of argument are declared undeveloped, and are still undeveloped?
# expect:    rows
#
# The decorator is a promise. This finds the ones still outstanding, and separately the
# ones that have since been developed and whose decorator nobody cleared.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT ?elementId ?type ?statement ?stillUndeveloped
WHERE {
  ?element gsn:undeveloped ?flag ;
           a ?type ;
           schema:identifier ?elementId .
  FILTER(STR(?flag) = "true")
  OPTIONAL { ?element gsn:statement ?statement }
  BIND(NOT EXISTS { ?element gsn:supportedBy ?child } AS ?stillUndeveloped)
}
ORDER BY DESC(?stillUndeveloped) ?elementId
""" .

gsnprov:query-read-uninstantiated-elements
    a gsnprov:Query ;
    rdfs:label "read_uninstantiated_elements.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/read_uninstantiated_elements.rq" ;
    gsnprov:fileChecksum "c49b4655a01f2e1744e5ab50b3a61a58acd37743cb1d6c4b20184746ce4ae4cc" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:instantiationOf ,
        gsn:statement ,
        gsn:uninstantiated ;
    gsnprov:restsOnStatement gsnprov:st-0265 ,
        gsnprov:st-0305 ,
        gsnprov:st-0358 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-48 ;
    gsnprov:queryText """# id:        CQ-27
# operation: read
# question:  Which elements are still uninstantiated placeholders from a pattern?
# expect:    rows
#
# The hollow triangle. A published case carrying one is a case that was never finished.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

SELECT ?elementId ?type ?statement ?patternId
WHERE {
  ?element gsn:uninstantiated ?flag ;
           a ?type ;
           schema:identifier ?elementId .
  FILTER(STR(?flag) = "true")
  OPTIONAL { ?element gsn:statement ?statement }
  OPTIONAL {
    ?element gsn:instantiationOf ?pattern .
    ?pattern schema:identifier ?patternId .
  }
}
ORDER BY ?elementId
""" .

gsnprov:query-rules-s01-assumption-invalidation
    a gsnprov:Query ;
    rdfs:label "rules/s01_assumption_invalidation.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s01_assumption_invalidation.rq" ;
    gsnprov:fileChecksum "c68a5497b161a2566d2cc29467a1b9c462f582e5517f6878278ff2dfe9e5f3e1" ;
    gsnprov:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Assumption ,
        gsn:inContextOf ,
        gsn:valid ;
    gsnprov:ruleName "Assumption Invalidation" ;
    gsnprov:translatesStatement gsnprov:st-0119 ;
    gsnprov:restsOnStatement gsnprov:st-0114 ,
        gsnprov:st-0188 ,
        gsnprov:st-0218 ;
    gsnprov:queryText """# rule:      S1
# name:      Assumption Invalidation
# section:   Core GSN
# operation: rule
# expect:    insert
# swrl:      Assumption(?A) ^ valid(?A, false) ^ 'in context of'(?B, ?A) -> valid(?B, false)
# reads:     IF A is an Assumption AND A is NOT valid AND B is in context of A THEN B is NOT
#            valid

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?B gsn:valid ?old }
INSERT { ?B gsn:valid false }
WHERE {
  ?A a gsn:Assumption ;
     gsn:valid ?vA .
  FILTER(STR(?vA) = "false")
  ?B gsn:inContextOf ?A .
  OPTIONAL { ?B gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsnprov:query-rules-s02-contextual-relation
    a gsnprov:Query ;
    rdfs:label "rules/s02_contextual_relation.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s02_contextual_relation.rq" ;
    gsnprov:fileChecksum "44e2e3ae3803341ed59e5d9748defead46234c2d33bbac9b39bc0ac9b2cfcc47" ;
    gsnprov:declaresNamespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:inContextOf ,
        gsn:relationshipType ;
    gsnprov:ruleName "Contextual Relation" ;
    gsnprov:translatesStatement gsnprov:st-0127 ;
    gsnprov:restsOnStatement gsnprov:st-0120 ,
        gsnprov:st-0218 ;
    gsnprov:queryText """# rule:      S2
# name:      Contextual Relation
# section:   Core GSN
# operation: rule
# expect:    insert
# swrl:      rdf:subject(?R, ?A) ^ 'in context of'(?A, ?B) ^ rdf:object(?R, ?B) -> 'relationship
#            type'(?R, "contextual")
# reads:     IF R has subject A AND A is in context of B AND R has object B THEN R is a
#            contextual relationship

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DELETE { ?R gsn:relationshipType ?old }
INSERT { ?R gsn:relationshipType "contextual" }
WHERE {
  ?R rdf:subject ?A ;
     rdf:object ?B .
  ?A gsn:inContextOf ?B .
  OPTIONAL { ?R gsn:relationshipType ?old }
  FILTER(!BOUND(?old) || ?old != "contextual")
}
""" .

