# GENERATED by tools/prov_augment.py. Everything here is recoverable from the
# repository, so unlike ontogsn-provenance-data.ttl this file is rebuilt, not
# edited. Re-run after adding a query or rebuilding a serialization.

<https://w3id.org/OntoGSN/provenance/augmentations> a owl:Ontology ;
    owl:imports <https://w3id.org/OntoGSN/provenance> ;
    dc:title "OntoGSN Provenance - requirements, questions, queries and builds"@en ;
    owl:versionInfo "1.0.0" .


#################################################################
#    Requirements (7)
#    What OntoGSN set out to do, before any of it was built.
#################################################################

gsnprov:req-R1
    a gsnprov:Requirement ;
    rdfs:label "R1"@en ;
    gsnprov:requirementText "User should be capable of performing every aspect in the normative GSN v3 standard with OntoGSN."@en ;
    gsnprov:appliesTo "ontology" ;
    dc:source "GSN Standard"@en .

gsnprov:req-R2
    a gsnprov:Requirement ;
    rdfs:label "R2"@en ;
    gsnprov:requirementText "OntoGSN should represent knowledge about GSN assurance cases in direct conformity with the standard metamodel."@en ;
    gsnprov:appliesTo "ontology" ;
    dc:source "GSN Standard"@en .

gsnprov:req-R3
    a gsnprov:Requirement ;
    rdfs:label "R3"@en ;
    gsnprov:requirementText "OntoGSN should be aligned with the ASCE XML schema."@en ;
    gsnprov:appliesTo "ontology" ;
    dc:source "https://scsc.uk/index.php/tools; feedback"@en .

gsnprov:req-R4
    a gsnprov:Requirement ;
    rdfs:label "R4"@en ;
    gsnprov:requirementText "The user should be able to use OntoGSN as a standalone framework."@en ;
    gsnprov:appliesTo "framework" ,
        "supporting tools" .

gsnprov:req-R5
    a gsnprov:Requirement ;
    rdfs:label "R5"@en ;
    gsnprov:requirementText "The user should be able to use OntoGSN in an accessible manner."@en ;
    gsnprov:appliesTo "framework" ,
        "supporting tools" ;
    dc:source "feedback"@en .

gsnprov:req-R6
    a gsnprov:Requirement ;
    rdfs:label "R6"@en ;
    gsnprov:requirementText "OntoGSN should not duplicate the features provided by existing tools and frameworks (e.g., GUI, imports/exports)."@en ;
    gsnprov:appliesTo "supporting tools" ;
    dc:source "https://scsc.uk/index.php/tools"@en .

gsnprov:req-R7
    a gsnprov:Requirement ;
    rdfs:label "R7"@en ;
    gsnprov:requirementText "The user should have an accessible and easy way to create SPARQL queries based on a case ABox conformant to the OntoGSN TBox."@en ;
    gsnprov:appliesTo "supporting tools" .


#################################################################
#    Competency questions (15)
#    What the ontology has to be able to answer, and for whom.
#################################################################

gsnprov:cq-AE-01
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AE–01"@en ;
    gsnprov:persona "Assurance engineer"@en ;
    gsnprov:questionText "Which Goals or Strategies are affected by the Defeater “Jailbreak”?"@en .

gsnprov:cq-AE-02
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AE–02"@en ;
    gsnprov:persona "Assurance engineer"@en ;
    gsnprov:questionText "Which Solution instances are flagged inDoubt=true?"@en .

gsnprov:cq-AE-03
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AE–03"@en ;
    gsnprov:persona "Assurance engineer"@en ;
    gsnprov:questionText "Which bottom-level Goals in the “Robustness” argument lack any supporting Solution?"@en .

gsnprov:cq-AE-04
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AE–04"@en ;
    gsnprov:persona "Assurance engineer"@en ;
    gsnprov:questionText "Which Solution items do not reference any Artefact?"@en .

gsnprov:cq-AE-05
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AE–05"@en ;
    gsnprov:persona "Assurance engineer"@en ;
    gsnprov:questionText "Which Solution instances were added more than 180 days ago?"@en .

gsnprov:cq-DE-01
    a gsnprov:CompetencyQuestion ;
    rdfs:label "DE-01"@en ;
    gsnprov:persona "Domain expert"@en ;
    gsnprov:questionText "Which Goals mention “Benchmark” currently lack any associated Evidence?"@en .

gsnprov:cq-DE-02
    a gsnprov:CompetencyQuestion ;
    rdfs:label "DE-02"@en ;
    gsnprov:persona "Domain expert"@en ;
    gsnprov:questionText "How can listed Artefacts be instantiated as Solutions using the template “Test against {attack prompt}”?"@en .

gsnprov:cq-DE-03
    a gsnprov:CompetencyQuestion ;
    rdfs:label "DE-03"@en ;
    gsnprov:persona "Domain expert"@en ;
    gsnprov:questionText "How can bottom-level Goals with “Perturbation Robustness” be attached to a new Artefact file every 30 days?"@en .

gsnprov:cq-DE-04
    a gsnprov:CompetencyQuestion ;
    rdfs:label "DE-04"@en ;
    gsnprov:persona "Domain expert"@en ;
    gsnprov:questionText "How can the Goal “Attack Resistance” receive a Defeater once an Artefact with “adversarialSample” is created?"@en .

gsnprov:cq-DE-05
    a gsnprov:CompetencyQuestion ;
    rdfs:label "DE-05"@en ;
    gsnprov:persona "Domain expert"@en ;
    gsnprov:questionText "Which Goals are in context of a Context that refers to the “GPT” Model?"@en .

gsnprov:cq-AU-01
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AU-01"@en ;
    gsnprov:persona "Auditor"@en ;
    gsnprov:questionText "AU–01 How can elements in the branch rooted at the Goal “Attack Resistance” be made invalid?"@en .

gsnprov:cq-AU-02
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AU-02"@en ;
    gsnprov:persona "Auditor"@en ;
    gsnprov:questionText "AU–02 How can all bottom-level Goals, Solutions, and Artefacts under the Goal “Attack Resistance” be found?"@en .

gsnprov:cq-AU-03
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AU-03"@en ;
    gsnprov:persona "Auditor"@en ;
    gsnprov:questionText "AU–03 Which elements with “Jailbreak” require a Defeater?"@en .

gsnprov:cq-AU-04
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AU-04"@en ;
    gsnprov:persona "Auditor"@en ;
    gsnprov:questionText "AU–04 How can elements connected to the valid Artefact “Benchmark-Dataset” be also marked as valid=true?"@en .

gsnprov:cq-AU-05
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AU-05"@en ;
    gsnprov:persona "Auditor"@en ;
    gsnprov:questionText "AU–05 Which Solutions are attached to a ConfidenceArgument containing a Goal with “Perplexity”?"@en .


