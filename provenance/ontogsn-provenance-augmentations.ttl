# GENERATED by tools/prov_augment.py. Everything here is recoverable from the
# repository, so unlike ontogsn-provenance-data.ttl this file is rebuilt, not
# edited. Re-run after adding a query or rebuilding a serialization.

<https://w3id.org/OntoGSN/provenance/augmentations> a owl:Ontology ;
    owl:imports <https://w3id.org/OntoGSN/provenance> ;
    dc:title "OntoGSN Provenance - requirements, questions, queries and builds"@en ;
    owl:versionInfo "1.0.0" .


#################################################################
#    Requirements (7)
#    What OntoGSN set out to do, before any of it was built.
#################################################################

gsnprov:req-R1
    a gsnprov:Requirement ;
    rdfs:label "R1"@en ;
    gsnprov:requirementText "User should be capable of performing every aspect in the normative GSN v3 standard with OntoGSN."@en ;
    gsnprov:appliesTo "ontology" ;
    dc:source "GSN Standard"@en .

gsnprov:req-R2
    a gsnprov:Requirement ;
    rdfs:label "R2"@en ;
    gsnprov:requirementText "OntoGSN should represent knowledge about GSN assurance cases in direct conformity with the standard metamodel."@en ;
    gsnprov:appliesTo "ontology" ;
    dc:source "GSN Standard"@en .

gsnprov:req-R3
    a gsnprov:Requirement ;
    rdfs:label "R3"@en ;
    gsnprov:requirementText "OntoGSN should be aligned with the ASCE XML schema."@en ;
    gsnprov:appliesTo "ontology" ;
    dc:source "https://scsc.uk/index.php/tools; feedback"@en .

gsnprov:req-R4
    a gsnprov:Requirement ;
    rdfs:label "R4"@en ;
    gsnprov:requirementText "The user should be able to use OntoGSN as a standalone framework."@en ;
    gsnprov:appliesTo "framework" ,
        "supporting tools" .

gsnprov:req-R5
    a gsnprov:Requirement ;
    rdfs:label "R5"@en ;
    gsnprov:requirementText "The user should be able to use OntoGSN in an accessible manner."@en ;
    gsnprov:appliesTo "framework" ,
        "supporting tools" ;
    dc:source "feedback"@en .

gsnprov:req-R6
    a gsnprov:Requirement ;
    rdfs:label "R6"@en ;
    gsnprov:requirementText "OntoGSN should not duplicate the features provided by existing tools and frameworks (e.g., GUI, imports/exports)."@en ;
    gsnprov:appliesTo "supporting tools" ;
    dc:source "https://scsc.uk/index.php/tools"@en .

gsnprov:req-R7
    a gsnprov:Requirement ;
    rdfs:label "R7"@en ;
    gsnprov:requirementText "The user should have an accessible and easy way to create SPARQL queries based on a case ABox conformant to the OntoGSN TBox."@en ;
    gsnprov:appliesTo "supporting tools" .


#################################################################
#    Competency questions (43)
#    What the ontology has to be able to answer, and for whom.
#################################################################

gsnprov:cq-AE-01
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AE-01"@en ;
    gsnprov:persona "Assurance engineer"@en ;
    gsnprov:questionText "What assurance cases are in the store, and what arguments does each contain?"@en .

gsnprov:cq-AE-02
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AE-02"@en ;
    gsnprov:persona "Assurance engineer"@en ;
    gsnprov:questionText "How many elements of each GSN type does the case contain?"@en .

gsnprov:cq-AE-03
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AE-03"@en ;
    gsnprov:persona "Assurance engineer"@en ;
    gsnprov:questionText "What is the top goal of each argument - the claim everything else supports?"@en .

gsnprov:cq-AE-04
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AE-04"@en ;
    gsnprov:persona "Assurance engineer"@en ;
    gsnprov:questionText "What does the element with a given identifier say, and what is it linked to?"@en .

gsnprov:cq-AE-05
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AE-05"@en ;
    gsnprov:persona "Assurance engineer"@en ;
    gsnprov:questionText "What is the whole argument beneath a given goal?"@en .

gsnprov:cq-AE-06
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AE-06"@en ;
    gsnprov:persona "Assurance engineer"@en ;
    gsnprov:questionText "What evidence ultimately supports a given goal?"@en .

gsnprov:cq-AE-07
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AE-07"@en ;
    gsnprov:persona "Assurance engineer"@en ;
    gsnprov:questionText "If a given artefact is withdrawn or superseded, which claims are affected?"@en .

gsnprov:cq-AE-08
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AE-08"@en ;
    gsnprov:persona "Assurance engineer"@en ;
    gsnprov:questionText "What context, assumptions and justifications are in scope for a given goal?"@en .

gsnprov:cq-AE-09
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AE-09"@en ;
    gsnprov:persona "Assurance engineer"@en ;
    gsnprov:questionText "Which lines of argument are declared undeveloped, and are still undeveloped?"@en .

gsnprov:cq-AE-10
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AE-10"@en ;
    gsnprov:persona "Assurance engineer"@en ;
    gsnprov:questionText "Which goals have no support at all and are not admitted to be undeveloped?"@en .

gsnprov:cq-AE-11
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AE-11"@en ;
    gsnprov:persona "Assurance engineer"@en ;
    gsnprov:questionText "Which solutions cite no artefact - evidence claimed but not identified?"@en .

gsnprov:cq-AE-12
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AE-12"@en ;
    gsnprov:persona "Assurance engineer"@en ;
    gsnprov:questionText "Which artefacts predate a given date, and which claims still rest on them?"@en .

gsnprov:cq-AE-13
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AE-13"@en ;
    gsnprov:persona "Assurance engineer"@en ;
    gsnprov:questionText "How is a new, empty assurance case started?"@en .

gsnprov:cq-AE-14
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AE-14"@en ;
    gsnprov:persona "Assurance engineer"@en ;
    gsnprov:questionText "How is a sub-goal added beneath an existing goal or strategy?"@en .

gsnprov:cq-AE-15
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AE-15"@en ;
    gsnprov:persona "Assurance engineer"@en ;
    gsnprov:questionText "How is a strategy inserted between a goal and the sub-goals it already has?"@en .

gsnprov:cq-AE-17
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AE-17"@en ;
    gsnprov:persona "Assurance engineer"@en ;
    gsnprov:questionText "How is the wording of a claim, strategy or context corrected?"@en .

gsnprov:cq-AE-23
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AE-23"@en ;
    gsnprov:persona "Assurance engineer"@en ;
    gsnprov:questionText "How is an element removed without leaving dangling references to it?"@en .

gsnprov:cq-AE-24
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AE-24"@en ;
    gsnprov:persona "Assurance engineer"@en ;
    gsnprov:questionText "How is one support or context link removed, leaving both elements in place?"@en .

gsnprov:cq-AE-25
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AE-25"@en ;
    gsnprov:persona "Assurance engineer"@en ;
    gsnprov:questionText "How are the conclusions written by queries/rules/ cleared before re-running them?"@en .

gsnprov:cq-AU-01
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AU-01"@en ;
    gsnprov:persona "Auditor"@en ;
    gsnprov:questionText "Which elements are not reachable from any top goal - present but unargued?"@en .

gsnprov:cq-AU-02
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AU-02"@en ;
    gsnprov:persona "Auditor"@en ;
    gsnprov:questionText "What is the current status of every element - valid, true, in doubt, defeated?"@en .

gsnprov:cq-AU-03
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AU-03"@en ;
    gsnprov:persona "Auditor"@en ;
    gsnprov:questionText "Which elements or relationships are currently invalid, in doubt or defeated?"@en .

gsnprov:cq-AU-04
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AU-04"@en ;
    gsnprov:persona "Auditor"@en ;
    gsnprov:questionText "What challenges have been raised, against what, and by what kind of defeater?"@en .

gsnprov:cq-AU-05
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AU-05"@en ;
    gsnprov:persona "Auditor"@en ;
    gsnprov:questionText "Which claims above a challenged element lose support if the challenge stands?"@en .

gsnprov:cq-AU-06
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AU-06"@en ;
    gsnprov:persona "Auditor"@en ;
    gsnprov:questionText "Do two distinct elements share a schema:identifier?"@en .

gsnprov:cq-AU-07
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AU-07"@en ;
    gsnprov:persona "Auditor"@en ;
    gsnprov:questionText "Does any element support itself through a chain - a circular argument?"@en .

gsnprov:cq-AU-08
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AU-08"@en ;
    gsnprov:persona "Auditor"@en ;
    gsnprov:questionText "How is a challenge recorded against part of the argument?"@en .

gsnprov:cq-AU-09
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AU-09"@en ;
    gsnprov:persona "Auditor"@en ;
    gsnprov:questionText "How is a single element marked invalid?"@en .

gsnprov:cq-AU-14
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AU-14"@en ;
    gsnprov:persona "Auditor"@en ;
    gsnprov:questionText "How is a challenge withdrawn, together with the doubt and defeat it caused?"@en .

gsnprov:cq-AU-15
    a gsnprov:CompetencyQuestion ;
    rdfs:label "AU-15"@en ;
    gsnprov:persona "Auditor"@en ;
    gsnprov:questionText "How is a whole assurance case and everything under it removed?"@en .

gsnprov:cq-DE-01
    a gsnprov:CompetencyQuestion ;
    rdfs:label "DE-01"@en ;
    gsnprov:persona "Domain expert"@en ;
    gsnprov:questionText "Where are the assurance claim points, and what confidence argument backs each?"@en .

gsnprov:cq-DE-02
    a gsnprov:CompetencyQuestion ;
    rdfs:label "DE-02"@en ;
    gsnprov:persona "Domain expert"@en ;
    gsnprov:questionText "Which assurance claim points have no confidence argument behind them?"@en .

gsnprov:cq-DE-03
    a gsnprov:CompetencyQuestion ;
    rdfs:label "DE-03"@en ;
    gsnprov:persona "Domain expert"@en ;
    gsnprov:questionText "Which modules depend on which, and through which elements?"@en .

gsnprov:cq-DE-04
    a gsnprov:CompetencyQuestion ;
    rdfs:label "DE-04"@en ;
    gsnprov:persona "Domain expert"@en ;
    gsnprov:questionText "Which away elements are referenced, and does the module they come from exist?"@en .

gsnprov:cq-DE-05
    a gsnprov:CompetencyQuestion ;
    rdfs:label "DE-05"@en ;
    gsnprov:persona "Domain expert"@en ;
    gsnprov:questionText "Which public elements sit inside a contract module, where they must not?"@en .

gsnprov:cq-DE-06
    a gsnprov:CompetencyQuestion ;
    rdfs:label "DE-06"@en ;
    gsnprov:persona "Domain expert"@en ;
    gsnprov:questionText "Which elements instantiate which argument pattern, and is the pattern's own documentation complete?"@en .

gsnprov:cq-DE-07
    a gsnprov:CompetencyQuestion ;
    rdfs:label "DE-07"@en ;
    gsnprov:persona "Domain expert"@en ;
    gsnprov:questionText "Which elements are still uninstantiated placeholders from a pattern?"@en .

gsnprov:cq-DE-08
    a gsnprov:CompetencyQuestion ;
    rdfs:label "DE-08"@en ;
    gsnprov:persona "Domain expert"@en ;
    gsnprov:questionText "Which relationships carry pattern decorators - optional, multiple, cardinality?"@en .

gsnprov:cq-DE-09
    a gsnprov:CompetencyQuestion ;
    rdfs:label "DE-09"@en ;
    gsnprov:persona "Domain expert"@en ;
    gsnprov:questionText "How is a context element added to a goal or strategy, pointing at an artefact?"@en .

gsnprov:cq-DE-10
    a gsnprov:CompetencyQuestion ;
    rdfs:label "DE-10"@en ;
    gsnprov:persona "Domain expert"@en ;
    gsnprov:questionText "How is a new piece of evidence attached to a goal?"@en .

gsnprov:cq-DE-11
    a gsnprov:CompetencyQuestion ;
    rdfs:label "DE-11"@en ;
    gsnprov:persona "Domain expert"@en ;
    gsnprov:questionText "How are artefacts already in the store turned into solutions in bulk?"@en .

gsnprov:cq-DE-15
    a gsnprov:CompetencyQuestion ;
    rdfs:label "DE-15"@en ;
    gsnprov:persona "Domain expert"@en ;
    gsnprov:questionText "How is a solution repointed when its evidence is superseded by a new version?"@en .

gsnprov:cq-DE-16
    a gsnprov:CompetencyQuestion ;
    rdfs:label "DE-16"@en ;
    gsnprov:persona "Domain expert"@en ;
    gsnprov:questionText "How are artefacts no solution or context cites any more cleared out?"@en .


