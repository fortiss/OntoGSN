    gsnprov:mentionsTerm gsn:Goal ,
        gsn:RelationshipWithConfidence ,
        gsn:associatedWith ,
        gsn:assuranceClaimPoint ,
        gsn:supportedBy ;
    gsnprov:ruleName "Goal Confidence Relation" ;
    gsnprov:translatesStatement gsnprov:st-0692 ;
    gsnprov:restsOnStatement gsnprov:st-0161 ,
        gsnprov:st-0207 ,
        gsnprov:st-0635 ,
        gsnprov:st-0648 ,
        gsnprov:st-0658 ;
    gsnprov:queryText """# rule:      S45
# name:      Goal Confidence Relation
# section:   Confidence Argument Extension
# operation: rule
# expect:    insert
# swrl:      'supported by'(?G, ?S2) ^ Goal(?S1) ^ rdf:object(?R1, ?S1) ^ 'Relationship with
#            Confidence'(?R1) ^ swrlx:makeOWLThing(?S2, ?R2) ^ 'supported by'(?G, ?S1) ^
#            Goal(?S2) ^ Goal(?G) ^ swrlb:notEqual(?S1, ?S2) ^ 'associated with'(?R1, ?A) ^
#            rdf:subject(?R1, ?G) -> rdf:object(?R2, ?S2) ^ 'Relationship with Confidence'(?R2) ^
#            rdf:subject(?R2, ?G) ^ 'associated with'(?R2, ?A) ^ 'assurance claim point'(?R2,
#            true)
# reads:     IF Goal G is supported by two distinct Goals S1 and S2 AND there is a Relationship
#            with Confidence R1 from G to S1 associated with A THEN we create a Relationship with
#            Confidence R2 from G to S2 associated with the same A AND mark R2 as an assurance
#            claim point

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

INSERT {
  ?R2 a gsn:RelationshipWithConfidence ;
      schema:identifier ?relationshipId ;
      rdf:subject ?G ;
      rdf:predicate gsn:supportedBy ;
      rdf:object ?S2 ;
      gsn:associatedWith ?A ;
      gsn:assuranceClaimPoint true .
}
WHERE {
  ?R1 a gsn:RelationshipWithConfidence ;
      rdf:subject ?G ;
      rdf:object ?S1 ;
      gsn:associatedWith ?A .
  ?G a gsn:Goal ;
     gsn:supportedBy ?S1 , ?S2 ;
     schema:identifier ?idG .
  ?S1 a gsn:Goal .
  ?S2 a gsn:Goal ;
      schema:identifier ?idS2 .
  FILTER(?S1 != ?S2)
  BIND(CONCAT("RC-", ?idG, "-", ?idS2) AS ?relationshipId)
  BIND(IRI(CONCAT(REPLACE(STR(?G), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?relationshipId))) AS ?R2)
  FILTER NOT EXISTS {
    ?existing a gsn:RelationshipWithConfidence ;
              rdf:subject ?G ;
              rdf:object ?S2 .
  }
}
""" .

gsnprov:query-rules-s46-challenge-defeat
    a gsnprov:Query ;
    rdfs:label "rules/s46_challenge_defeat.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s46_challenge_defeat.rq" ;
    gsnprov:fileChecksum "0a7f4bf2607a40887e01e3d92d28bf68cb73d991d4a87b04420ea014b5e39ec0" ;
    gsnprov:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Solution ,
        gsn:challenges ,
        gsn:defeated ,
        gsn:valid ;
    gsnprov:ruleName "Challenge Defeat" ;
    gsnprov:translatesStatement gsnprov:st-0729 ;
    gsnprov:restsOnStatement gsnprov:st-0114 ,
        gsnprov:st-0175 ,
        gsnprov:st-0696 ,
        gsnprov:st-0699 ,
        gsnprov:st-0740 ;
    gsnprov:queryText """# rule:      S46
# name:      Challenge Defeat
# section:   Dialectic Extension
# operation: rule
# expect:    insert
# swrl:      valid(?S, true) ^ challenges(?S, ?E) ^ Solution(?S) -> defeated(?E, true)
# reads:     IF S is a valid Solution AND S challenges E THEN E is defeated

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?E gsn:defeated ?old }
INSERT { ?E gsn:defeated true }
WHERE {
  ?S a gsn:Solution ;
     gsn:valid ?valid ;
     gsn:challenges ?E .
  FILTER(STR(?valid) = "true")
  OPTIONAL { ?E gsn:defeated ?old }
  FILTER(!BOUND(?old) || STR(?old) != "true")
}
""" .

gsnprov:query-rules-s47-defeated-invalidation
    a gsnprov:Query ;
    rdfs:label "rules/s47_defeated_invalidation.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s47_defeated_invalidation.rq" ;
    gsnprov:fileChecksum "6f77396ae7f820b378ceb4e6ccf74fa3024219daa5015316e787b2fffe1db35c" ;
    gsnprov:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:defeated ,
        gsn:valid ;
    gsnprov:ruleName "Defeated Invalidation" ;
    gsnprov:translatesStatement gsnprov:st-0730 ;
    gsnprov:restsOnStatement gsnprov:st-0114 ,
        gsnprov:st-0699 ;
    gsnprov:queryText """# rule:      S47
# name:      Defeated Invalidation
# section:   Dialectic Extension
# operation: rule
# expect:    insert
# swrl:      defeated(?E, true) -> valid(?E, false)
# reads:     IF E is defeated THEN E is NOT valid

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?E gsn:valid ?old }
INSERT { ?E gsn:valid false }
WHERE {
  ?E gsn:defeated ?defeated .
  FILTER(STR(?defeated) = "true")
  OPTIONAL { ?E gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsnprov:query-rules-s48-challenge-doubt
    a gsnprov:Query ;
    rdfs:label "rules/s48_challenge_doubt.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s48_challenge_doubt.rq" ;
    gsnprov:fileChecksum "bbc230404c06f0b0969a234f9204945d9982f505e72535a0078835620289ef1a" ;
    gsnprov:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Goal ,
        gsn:challenges ,
        gsn:inDoubt ,
        gsn:true ;
    gsnprov:ruleName "Challenge Doubt" ;
    gsnprov:translatesStatement gsnprov:st-0737 ;
    gsnprov:restsOnStatement gsnprov:st-0161 ,
        gsnprov:st-0234 ,
        gsnprov:st-0696 ,
        gsnprov:st-0731 ,
        gsnprov:st-0740 ;
    gsnprov:queryText """# rule:      S48
# name:      Challenge Doubt
# section:   Dialectic Extension
# operation: rule
# expect:    insert
# swrl:      challenges(?G, ?E) ^ true(?G, true) ^ Goal(?G) -> 'in doubt'(?E, true)
# reads:     IF Goal G challenges E AND G is true THEN E is in doubt

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?E gsn:inDoubt ?old }
INSERT { ?E gsn:inDoubt true }
WHERE {
  ?G a gsn:Goal ;
     gsn:true ?tG ;
     gsn:challenges ?E .
  FILTER(STR(?tG) = "true")
  OPTIONAL { ?E gsn:inDoubt ?old }
  FILTER(!BOUND(?old) || STR(?old) != "true")
}
""" .

gsnprov:query-rules-s49-undeveloped-defeat
    a gsnprov:Query ;
    rdfs:label "rules/s49_undeveloped_defeat.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s49_undeveloped_defeat.rq" ;
    gsnprov:fileChecksum "0fdcbb5cfe29b42d66747c4fa35d10fd3e0a7eb7102bf47903cc91f8bd43d2d5" ;
    gsnprov:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Goal ,
        gsn:challenges ,
        gsn:defeated ,
        gsn:inDoubt ,
        gsn:undeveloped ;
    gsnprov:ruleName "Undeveloped Defeat" ;
    gsnprov:translatesStatement gsnprov:st-0738 ;
    gsnprov:restsOnStatement gsnprov:st-0161 ,
        gsnprov:st-0200 ,
        gsnprov:st-0696 ,
        gsnprov:st-0699 ,
        gsnprov:st-0731 ,
        gsnprov:st-0740 ;
    gsnprov:queryText """# rule:      S49
# name:      Undeveloped Defeat
# section:   Dialectic Extension
# operation: rule
# expect:    insert
# swrl:      undeveloped(?G, false) ^ challenges(?G, ?E) ^ Goal(?G) ^ 'in doubt'(?E, true) ->
#            defeated(?E, true)
# reads:     IF Goal G challenges E AND G is NOT undeveloped AND E is in doubt THEN E is defeated

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?E gsn:defeated ?old }
INSERT { ?E gsn:defeated true }
WHERE {
  ?G a gsn:Goal ;
     gsn:undeveloped ?undeveloped ;
     gsn:challenges ?E .
  FILTER(STR(?undeveloped) = "false")
  ?E gsn:inDoubt ?doubt .
  FILTER(STR(?doubt) = "true")
  OPTIONAL { ?E gsn:defeated ?old }
  FILTER(!BOUND(?old) || STR(?old) != "true")
}
""" .

gsnprov:query-rules-s50-challenge-relation-creation
    a gsnprov:Query ;
    rdfs:label "rules/s50_challenge_relation_creation.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s50_challenge_relation_creation.rq" ;
    gsnprov:fileChecksum "8be91377b34fcf100fa9977c14a1618de16a5e571fe24913787d58105220ad7d" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Relationship ,
        gsn:challenges ,
        gsn:relationshipType ;
    gsnprov:ruleName "Challenge Relation Creation" ;
    gsnprov:translatesStatement gsnprov:st-0742 ;
    gsnprov:restsOnStatement gsnprov:st-0120 ,
        gsnprov:st-0291 ,
        gsnprov:st-0696 ,
        gsnprov:st-0740 ;
    gsnprov:queryText """# rule:      S50
# name:      Challenge Relation Creation
# section:   Dialectic Extension
# operation: rule
# expect:    insert
# swrl:      challenges(?A, ?B) ^ swrlx:makeOWLThing(?B, ?R) -> rdf:subject(?R, ?A) ^
#            Relationship(?R) ^ rdf:object(?R, ?B) ^ 'relationship type'(?R, dialectic)
# reads:     IF A challenges B AND we reify this challenge as a Relationship R THEN R is a
#            reified Relationship with subject A, object B and the dialectic type

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

INSERT {
  ?R a gsn:Relationship ;
     schema:identifier ?relationshipId ;
     rdf:subject ?A ;
     rdf:predicate gsn:challenges ;
     rdf:object ?B ;
     gsn:relationshipType "dialectic" .
}
WHERE {
  ?A gsn:challenges ?B ;
     schema:identifier ?idA .
  ?B schema:identifier ?idB .
  BIND(CONCAT("R-", ?idA, "-challenges-", ?idB) AS ?relationshipId)
  BIND(IRI(CONCAT(REPLACE(STR(?A), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?relationshipId))) AS ?R)
  FILTER NOT EXISTS {
    ?existing rdf:subject ?A ;
              rdf:predicate gsn:challenges ;
              rdf:object ?B .
  }
}
""" .

gsnprov:query-rules-s51-challenge-chain-invalidation
    a gsnprov:Query ;
    rdfs:label "rules/s51_challenge_chain_invalidation.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s51_challenge_chain_invalidation.rq" ;
    gsnprov:fileChecksum "95f05c4a427eff3f36cf69d516ccb738e53353bc408029a66672d11fa0b90676" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Goal ,
        gsn:Strategy ,
        gsn:challenges ,
        gsn:supportedBy ,
        gsn:valid ;
    gsnprov:ruleName "Challenge Chain Invalidation" ;
    gsnprov:translatesStatement gsnprov:st-0746 ;
    gsnprov:restsOnStatement gsnprov:st-0114 ,
        gsnprov:st-0161 ,
        gsnprov:st-0167 ,
        gsnprov:st-0207 ,
        gsnprov:st-0696 ,
        gsnprov:st-0740 ;
    gsnprov:queryText """# rule:      S51
# name:      Challenge Chain Invalidation
# section:   Dialectic Extension
# operation: rule
# expect:    insert
# swrl:      challenges(?D, ?R) ^ rdf:subject(?R, ?G3) ^ rdf:object(?R, ?G1) ^ Goal(?G1) ^
#            Goal(?G3) ^ swrlx:makeOWLThing(?G3, ?S) ^ Goal(?G2) ^ 'supported by'(?G3, ?G1) ^
#            'supported by'(?G3, ?G2) ^ swrlb:notEqual(?G1, ?G2) -> 'supported by'(?S, ?G2) ^
#            'supported by'(?G3, ?S) ^ valid(?D, false) ^ 'supported by'(?S, ?G1) ^
#            challenges(?D, ?S) ^ valid(?S, false) ^ valid(?R, false) ^ Strategy(?S)
# reads:     IF Defeater D challenges Relationship R between Goals G3 (subject) and G1 (object)
#            AND G3 is ALSO supported by a second Goal G2 distinct from G1 AND we introduce a
#            Strategy S for G3 THEN Strategy S is supported by G1 and G2 AND G3 is supported by S
#            AND D now challenges S AND D, S and R are all marked NOT valid
#
# The inference between a goal and its supporting goals is indivisible, so a challenge aimed at
# one SupportedBy link where the goal has several is not a challenge that can be made; the
# standard says such a challenge requires a strategy to be inserted (1:6.3.12, page 54). ?G2 is
# therefore a sibling supporter of ?G3, not any goal in the store. Without the supportedBy(?G3,
# ?G2) atom it was unconstrained, and the rule attached the new strategy to every other goal.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

DELETE {
  ?D gsn:valid ?oldD .
  ?R gsn:valid ?oldR .
}
INSERT {
  ?S a gsn:Strategy ;
     schema:identifier ?strategyId ;
     gsn:supportedBy ?G1 , ?G2 ;
     gsn:valid false .
  ?G3 gsn:supportedBy ?S .
  ?D gsn:challenges ?S ;
     gsn:valid false .
  ?R gsn:valid false .
}
WHERE {
  ?D gsn:challenges ?R .
  ?R rdf:subject ?G3 ;
     rdf:object ?G1 .
  ?G1 a gsn:Goal .
  ?G3 a gsn:Goal ;
      gsn:supportedBy ?G1 ;
      schema:identifier ?idG3 .
  ?G3 gsn:supportedBy ?G2 .
  ?G2 a gsn:Goal .
  FILTER(?G1 != ?G2)
  BIND(CONCAT("St-", ?idG3, "-rebutted") AS ?strategyId)
  BIND(IRI(CONCAT(REPLACE(STR(?G3), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?strategyId))) AS ?S)
  OPTIONAL { ?D gsn:valid ?oldD }
  OPTIONAL { ?R gsn:valid ?oldR }
  FILTER NOT EXISTS { ?G3 gsn:supportedBy ?S }
}
""" .

gsnprov:query-rules-s52-defeater-declaration
    a gsnprov:Query ;
    rdfs:label "rules/s52_defeater_declaration.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s52_defeater_declaration.rq" ;
    gsnprov:fileChecksum "dbeeb2e321f40ed231e79f121e82dad4149808829fa6060e383a98e60307a6e4" ;
    gsnprov:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Defeater ,
        gsn:challenges ;
    gsnprov:ruleName "Defeater Declaration" ;
    gsnprov:translatesStatement gsnprov:st-0766 ;
    gsnprov:restsOnStatement gsnprov:st-0696 ,
        gsnprov:st-0740 ,
        gsnprov:st-0760 ;
    gsnprov:queryText """# rule:      S52
# name:      Defeater Declaration
# section:   Dialectic Extension
# operation: rule
# expect:    insert
# swrl:      challenges(?A, ?B) -> Defeater(?A)
# reads:     IF A challenges B THEN A is a Defeater

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

INSERT { ?A a gsn:Defeater }
WHERE {
  ?A gsn:challenges ?B .
  FILTER NOT EXISTS { ?A a gsn:Defeater }
}
""" .

gsnprov:query-rules-s53-module-membership
    a gsnprov:Query ;
    rdfs:label "rules/s53_module_membership.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s53_module_membership.rq" ;
    gsnprov:fileChecksum "022d4c800a27efdb6b6502b797e3f0bd4c67253751449c6a9c950ced8131ef4c" ;
    gsnprov:declaresNamespace "http://www.w3.org/2000/01/rdf-schema#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Argument ,
        gsn:GSNElement ,
        gsn:Module ,
        gsn:contains ,
        gsn:inModule ;
    gsnprov:ruleName "Module Membership" ;
    gsnprov:translatesStatement gsnprov:st-0962 ;
    gsnprov:restsOnStatement gsnprov:st-0085 ,
        gsnprov:st-0132 ,
        gsnprov:st-0469 ,
        gsnprov:st-0474 ,
        gsnprov:st-0944 ;
    gsnprov:queryText """# rule:      S53
# name:      Module Membership
# section:   Modular Extension
# operation: rule
# expect:    insert
# swrl:      Module(?M) ^ contains(?M, ?Arg) ^ Argument(?Arg) ^ contains(?Arg, ?E) ^
#            GSNElement(?E) -> 'in module'(?E, ?M)
# reads:     IF M is a Module AND M contains Argument Arg AND Arg contains GSN element E THEN E
#            is in module M

PREFIX gsn:  <https://w3id.org/OntoGSN/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# A module contains arguments and other modules, never elements directly, so the module an
# element belongs to is always two steps away. Every rule of the Modular Extension needs that
# traversal, so it is derived once here and stated in one atom everywhere else.
INSERT { ?E gsn:inModule ?M }
WHERE {
  ?M a gsn:Module ;
     gsn:contains ?Arg .
  ?Arg a gsn:Argument ;
       gsn:contains ?E .
  ?E a/rdfs:subClassOf* gsn:GSNElement .
  FILTER NOT EXISTS { ?E gsn:inModule ?M }
}
""" .

gsnprov:query-rules-s54-nested-module-membership
    a gsnprov:Query ;
    rdfs:label "rules/s54_nested_module_membership.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s54_nested_module_membership.rq" ;
    gsnprov:fileChecksum "8011ccfc66397b3bc19065598cdec6a096ba6c59ca22315244d6cb647d4e3ab9" ;
    gsnprov:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Module ,
        gsn:contains ,
        gsn:inModule ;
    gsnprov:ruleName "Nested Module Membership" ;
    gsnprov:translatesStatement gsnprov:st-0963 ;
    gsnprov:restsOnStatement gsnprov:st-0469 ,
        gsnprov:st-0474 ,
        gsnprov:st-0944 ;
    gsnprov:queryText """# rule:      S54
# name:      Nested Module Membership
# section:   Modular Extension
# operation: rule
# expect:    insert
# swrl:      Module(?M) ^ contains(?M, ?N) ^ Module(?N) ^ 'in module'(?E, ?N) ->
#            'in module'(?E, ?M)
# reads:     IF M is a Module AND M contains Module N AND E is in module N THEN E is also in
#            module M

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

# A module may contain other modules, so membership carries upward. Applied to a fixpoint by
# tools/run_rules.py this reaches any depth of nesting; on its own it advances one level, which
# is why its trigger in rule_cases.ttl states the inner membership S53 would otherwise derive.
INSERT { ?E gsn:inModule ?M }
WHERE {
  ?M a gsn:Module ;
     gsn:contains ?N .
  ?N a gsn:Module .
  ?E gsn:inModule ?N .
  FILTER NOT EXISTS { ?E gsn:inModule ?M }
}
""" .

gsnprov:query-update-element-statement
    a gsnprov:Query ;
    rdfs:label "update_element_statement.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/update_element_statement.rq" ;
    gsnprov:fileChecksum "c177ba4cecde245cfbb8048e48d263d23dfff6a154d12255aa12bd110ffe194c" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:statement ;
    gsnprov:restsOnStatement gsnprov:st-0265 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-35 ;
    gsnprov:queryText """# id:        CQ-35
# operation: update
# question:  How is the wording of a claim, strategy or context corrected?
# expect:    change
#
# DELETE then INSERT in one operation, not two: gsn:statement is single-valued in
# practice, and a bare INSERT would leave the element asserting both wordings at once.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

DELETE { ?element gsn:statement ?old }
INSERT { ?element gsn:statement ?new }
WHERE {
  VALUES (?elementId ?new) {                          # PARAMETERS
    ("G1.2" "False positive detections do not lead to unsafe braking demands in any operating mode.")
  }
  ?element schema:identifier ?elementId .
  OPTIONAL { ?element gsn:statement ?old }
}
""" .

gsnprov:query-update-mark-element-invalid
    a gsnprov:Query ;
    rdfs:label "update_mark_element_invalid.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/update_mark_element_invalid.rq" ;
    gsnprov:fileChecksum "02906314d29470cc5b70107fdc6fa598671a3e9b184ced793dd3c2274ffa82a4" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:valid ;
    gsnprov:restsOnStatement gsnprov:st-0114 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-36 ;
    gsnprov:queryText """# id:        CQ-36
# operation: update
# question:  How is a single element marked invalid?
# expect:    change
#
# The flag-setting idiom used by every update below: delete whatever value is there,
# insert the new one, and skip the row entirely if it already says what you want.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

DELETE { ?element gsn:valid ?old }
INSERT { ?element gsn:valid false }
WHERE {
  VALUES ?elementId { "G1.1" }                        # PARAMETER
  ?element schema:identifier ?elementId .
  OPTIONAL { ?element gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsnprov:query-update-retarget-solution-to-new-artefact
    a gsnprov:Query ;
    rdfs:label "update_retarget_solution_to_new_artefact.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/update_retarget_solution_to_new_artefact.rq" ;
    gsnprov:fileChecksum "32ca5229a5433bb3b2ee52c587f9afb54ec6a19b9c29f177ead266ce122edf00" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Artefact ,
        gsn:Solution ,
        gsn:refersTo ;
    gsnprov:restsOnStatement gsnprov:st-0111 ,
        gsnprov:st-0175 ,
        gsnprov:st-0289 ;
    gsnprov:answersQuestion gsnprov:cq-CQ-37 ;
    gsnprov:queryText """# id:        CQ-37
# operation: update
# question:  How is a solution repointed when its evidence is superseded by a new version?
# expect:    change
#
# The re-baselining operation. The solution - the argument's reference - stays put and
# keeps its identifier; only the artefact behind it moves.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX schema: <http://schema.org/>

DELETE { ?solution gsn:refersTo ?oldArtefact }
INSERT { ?solution gsn:refersTo ?newArtefact }
WHERE {
  VALUES (?solutionId ?newArtefactId) {               # PARAMETERS
    ("Sn3" "Ev1")
  }
  ?solution a gsn:Solution ;
            schema:identifier ?solutionId .
  ?newArtefact a gsn:Artefact ;
               schema:identifier ?newArtefactId .
  OPTIONAL { ?solution gsn:refersTo ?oldArtefact }
  FILTER(!BOUND(?oldArtefact) || ?oldArtefact != ?newArtefact)
}
""" .


#################################################################
#    Generated files and what generates them
#    A derived file with no generating activity is one nobody knows how to rebuild.
#    The slices under serializations/separated/ are exactly that, which is why they
#    appear here with prov:wasDerivedFrom but no prov:wasGeneratedBy.
#################################################################

