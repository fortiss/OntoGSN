    gsnprov:translatesStatement gsnprov:st-0597 ;
    gsnprov:restsOnStatement gsnprov:st-0218 ,
        gsnprov:st-0944 ;
    gsnprov:queryText """# rule:      S35
# name:      Module Context Propagation
# section:   Modular Extension
# operation: rule
# expect:    insert
# swrl:      Module(?M1) ^ Module(?M2) ^ 'in module'(?E1, ?M1) ^ 'in module'(?E2, ?M2) ^ 'in context
#            of'(?E1, ?E2) ^ swrlb:notEqual(?M1, ?M2) -> 'in context of'(?M1, ?M2)
# reads:     IF M1 and M2 are Modules AND E1 in M1 is in context of E2 in M2 AND M1 and M2 are
#            distinct THEN M1 is in context of M2

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

INSERT { ?M1 gsn:inContextOf ?M2 }
WHERE {
  ?E1 gsn:inModule ?M1 .
  ?E2 gsn:inModule ?M2 .
  FILTER(?M1 != ?M2)
  ?E1 gsn:inContextOf ?E2 .
  FILTER NOT EXISTS { ?M1 gsn:inContextOf ?M2 }
}
""" .

gsnprov:query-rules-s36-cross-module-support
    a gsnprov:Query ;
    rdfs:label "rules/s36_cross_module_support.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s36_cross_module_support.rq" ;
    gsnprov:fileChecksum "0d9dfc162b6ff8ba4073d58a462328599a85587992b8c5582b64cceb73c2ef4e" ;
    gsnprov:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Module ,
