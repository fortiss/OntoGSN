    gsnprov:fileChecksum "115a146d57309af705784647607c9f56657da168d980c5fe76c81601083eb3ce" ;
    gsnprov:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Module ,
        gsn:contract ,
        gsn:inModule ,
        gsn:toBeSupportedByContract ,
        gsn:valid ;
    gsnprov:ruleName "Contract Support Invalidation" ;
    gsnprov:translatesStatement gsnprov:st-0550 ;
    gsnprov:restsOnStatement gsnprov:st-0114 ,
        gsnprov:st-0469 ,
        gsnprov:st-0525 ,
        gsnprov:st-0542 ,
        gsnprov:st-0944 ;
    gsnprov:queryText """# rule:      S28
# name:      Contract Support Invalidation
# section:   Modular Extension
# operation: rule
# expect:    insert
# swrl:      'in module'(?A, ?M) ^ 'to be supported by contract'(?A, true) ^ contract(?M, true) ^
#            Module(?M) -> valid(?A, false)
# reads:     IF Module M contains A AND A is to be supported by contract AND M is under contract
#            THEN A is NOT valid

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?A gsn:valid ?old }
INSERT { ?A gsn:valid false }
WHERE {
  ?M a gsn:Module ;
     gsn:contract ?contract .
  ?A gsn:inModule ?M .
  FILTER(STR(?contract) = "true")
  ?A gsn:toBeSupportedByContract ?flag .
  FILTER(STR(?flag) = "true")
  OPTIONAL { ?A gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsnprov:query-rules-s29-away-goal-invalidation
    a gsnprov:Query ;
    rdfs:label "rules/s29_away_goal_invalidation.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s29_away_goal_invalidation.rq" ;
    gsnprov:fileChecksum "c5c50511b0131a4a6cacb0e1cb122f00867170cda41af1d4f650d667c5ab3a88" ;
    gsnprov:declaresNamespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Goal ,
        gsn:away ,
        gsn:inModule ,
        gsn:supportedBy ,
        gsn:valid ;
    gsnprov:ruleName "Away Goal Invalidation" ;
    gsnprov:translatesStatement gsnprov:st-0559 ;
    gsnprov:restsOnStatement gsnprov:st-0114 ,
        gsnprov:st-0161 ,
        gsnprov:st-0207 ,
        gsnprov:st-0490 ,
        gsnprov:st-0944 ;
    gsnprov:queryText """# rule:      S29
# name:      Away Goal Invalidation
# section:   Modular Extension
# operation: rule
# expect:    insert
# swrl:      rdf:subject(?R, ?G1) ^ Module(?M1) ^ Goal(?G1) ^ rdf:object(?R, ?G2) ^ Module(?M2) ^
#            'supported by'(?G1, ?G2) ^ away(?G1, true) ^ 'in module'(?G1, ?M1) ^ 'in module'(?G2, ?M2)
#            -> valid(?R, false)
# reads:     IF Relationship R links Goal G1 to Goal G2 AND M1 and M2 are Modules AND G1 is a
#            Goal contained in M1 AND G2 is a Goal contained in M2 AND G1 is away and supported
#            by G2 THEN R is NOT valid

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DELETE { ?R gsn:valid ?old }
INSERT { ?R gsn:valid false }
WHERE {
  ?G1 a gsn:Goal ;
      gsn:supportedBy ?G2 ;
      gsn:away ?away .
  FILTER(STR(?away) = "true")
  ?R rdf:subject ?G1 ;
     rdf:object ?G2 .
  ?G1 gsn:inModule ?M1 .
  ?G2 gsn:inModule ?M2 .
  OPTIONAL { ?R gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsnprov:query-rules-s30-contract-activation
    a gsnprov:Query ;
    rdfs:label "rules/s30_contract_activation.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s30_contract_activation.rq" ;
    gsnprov:fileChecksum "3ad33d65ce8fc72d1c8484c16158d8495d2b4c4574a6c6aad0058f26d8cfe346" ;
    gsnprov:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:away ,
        gsn:contract ,
        gsn:inModule ,
        gsn:supportedBy ,
        gsn:toBeSupportedByContract ;
    gsnprov:ruleName "Contract Activation" ;
    gsnprov:translatesStatement gsnprov:st-0560 ;
    gsnprov:restsOnStatement gsnprov:st-0207 ,
        gsnprov:st-0490 ,
        gsnprov:st-0525 ,
        gsnprov:st-0542 ,
        gsnprov:st-0944 ;
    gsnprov:queryText """# rule:      S30
# name:      Contract Activation
# section:   Modular Extension
# operation: rule
# expect:    insert
# swrl:      away(?A, true) ^ 'to be supported by contract'(?A, true) ^ Module(?M1) ^ Module(?M2)
#            ^ 'in module'(?A, ?M1) ^ 'in module'(?B, ?M2) ^ 'supported by'(?A, ?B) ^
#            swrlb:notEqual(?M1, ?M2) -> contract(?M2, true)
# reads:     IF A is away and must be supported by contract AND M1 and M2 are Modules AND A is in
#            M1 AND B is in M2 AND A is supported by B AND M1 and M2 are distinct THEN M2 becomes
#            a contract Module

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?M2 gsn:contract ?old }
INSERT { ?M2 gsn:contract true }
WHERE {
  ?A gsn:away ?away ;
     gsn:toBeSupportedByContract ?byContract ;
     gsn:supportedBy ?B .
  FILTER(STR(?away) = "true")
  FILTER(STR(?byContract) = "true")
  ?A gsn:inModule ?M1 .
  ?B gsn:inModule ?M2 .
  FILTER(?M1 != ?M2)
  OPTIONAL { ?M2 gsn:contract ?old }
  FILTER(!BOUND(?old) || STR(?old) != "true")
}
""" .

gsnprov:query-rules-s31-contract-relation-invalidation
    a gsnprov:Query ;
    rdfs:label "rules/s31_contract_relation_invalidation.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s31_contract_relation_invalidation.rq" ;
    gsnprov:fileChecksum "6fb854f6c01944250720917dc8114ee96d621828a414824a5ca62f67a436189e" ;
    gsnprov:declaresNamespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:inModule ,
        gsn:supportedBy ,
        gsn:toBeSupportedByContract ,
        gsn:valid ;
    gsnprov:ruleName "Contract Relation Invalidation" ;
    gsnprov:translatesStatement gsnprov:st-0562 ;
    gsnprov:restsOnStatement gsnprov:st-0114 ,
        gsnprov:st-0207 ,
        gsnprov:st-0542 ,
        gsnprov:st-0944 ;
    gsnprov:queryText """# rule:      S31
# name:      Contract Relation Invalidation
# section:   Modular Extension
# operation: rule
# expect:    insert
# swrl:      'in module'(?B, ?M) ^ 'in module'(?A, ?M) ^ 'to be supported by contract'(?A, true) ^
#            'supported by'(?A, ?B) ^ rdf:subject(?R, ?A) ^ Module(?M) ^ rdf:object(?R, ?B) ->
#            valid(?R, false)
# reads:     IF Module M contains both A and B AND A is to be supported by contract and is
#            supported by B AND Relationship R links A to B THEN R is NOT valid

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DELETE { ?R gsn:valid ?old }
INSERT { ?R gsn:valid false }
WHERE {
  ?A gsn:inModule ?M .
  ?B gsn:inModule ?M .
  ?A gsn:toBeSupportedByContract ?flag ;
     gsn:supportedBy ?B .
  FILTER(STR(?flag) = "true")
  ?R rdf:subject ?A ;
     rdf:object ?B .
  OPTIONAL { ?R gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsnprov:query-rules-s32-context-consistency
    a gsnprov:Query ;
    rdfs:label "rules/s32_context_consistency.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s32_context_consistency.rq" ;
    gsnprov:fileChecksum "f556f5a729d6c3980671fc3e1ae83333c38f8a2152c4fe171eb29d1db3e40211" ;
    gsnprov:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Context ,
        gsn:Goal ,
        gsn:away ,
        gsn:consistentWith ,
        gsn:inContextOf ,
        gsn:supportedBy ;
    gsnprov:ruleName "Context Consistency" ;
    gsnprov:translatesStatement gsnprov:st-0572 ;
    gsnprov:restsOnStatement gsnprov:st-0161 ,
        gsnprov:st-0181 ,
        gsnprov:st-0207 ,
        gsnprov:st-0218 ,
        gsnprov:st-0490 ,
        gsnprov:st-0565 ;
    gsnprov:queryText """# rule:      S32
# name:      Context Consistency
# section:   Modular Extension
# operation: rule
# expect:    insert
# swrl:      'in context of'(?G1, ?C1) ^ 'in context of'(?G2, ?C2) ^ Goal(?G1) ^ Goal(?G2) ^
#            away(?G2, true) ^ 'supported by'(?G1, ?G2) ^ Context(?C2) -> 'consistent with'(?C1,
#            ?C2)
# reads:     IF G1 is in context of C1 AND G2 is in context of C2 AND G1 and G2 are Goals AND G2
#            is away AND G1 is supported by G2 AND C2 is a Context THEN C1 is consistent with C2

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

INSERT { ?C1 gsn:consistentWith ?C2 }
WHERE {
  ?G1 a gsn:Goal ;
      gsn:inContextOf ?C1 ;
      gsn:supportedBy ?G2 .
  ?G2 a gsn:Goal ;
      gsn:inContextOf ?C2 ;
      gsn:away ?away .
  FILTER(STR(?away) = "true")
  ?C2 a gsn:Context .
  FILTER(?C1 != ?C2)
  FILTER NOT EXISTS { ?C1 gsn:consistentWith ?C2 }
}
""" .

gsnprov:query-rules-s33-substitution-invalidation
    a gsnprov:Query ;
    rdfs:label "rules/s33_substitution_invalidation.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s33_substitution_invalidation.rq" ;
    gsnprov:fileChecksum "0733d7bb3f151debbdfc4f697ea26f880defe20ed142549a39b5790cd47258a4" ;
    gsnprov:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Justification ,
        gsn:inContextOf ,
        gsn:inModule ,
        gsn:substitutedBy ,
        gsn:valid ;
    gsnprov:ruleName "Substitution Invalidation" ;
    gsnprov:translatesStatement gsnprov:st-0580 ;
    gsnprov:restsOnStatement gsnprov:st-0114 ,
        gsnprov:st-0194 ,
        gsnprov:st-0218 ,
        gsnprov:st-0574 ,
        gsnprov:st-0944 ;
    gsnprov:queryText """# rule:      S33
# name:      Substitution Invalidation
# section:   Modular Extension
# operation: rule
# expect:    insert
# swrl:      contains(?M2, ?G) ^ Module(?M1) ^ Module(?M2) ^ 'substituted by'(?J, ?G) ^
#            contains(?M1, ?J) ^ Justification(?J) ^ 'in context of'(?E, ?J) ^
#            swrlb:notEqual(?M1, ?M2) -> valid(?J, false)
# reads:     IF Module M2 contains Goal G AND M1 and M2 are Modules AND Justification J is
#            substituted by G AND M1 contains J AND J is a Justification AND some element E is in
#            context of J AND M1 and M2 are distinct THEN J is NOT valid

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?J gsn:valid ?old }
INSERT { ?J gsn:valid false }
WHERE {
  ?J gsn:inModule ?M1 .
  ?G gsn:inModule ?M2 .
  FILTER(?M1 != ?M2)
  ?J a gsn:Justification ;
     gsn:substitutedBy ?G .
  ?E gsn:inContextOf ?J .
  OPTIONAL { ?J gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsnprov:query-rules-s34-module-support-propagation
    a gsnprov:Query ;
    rdfs:label "rules/s34_module_support_propagation.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s34_module_support_propagation.rq" ;
    gsnprov:fileChecksum "bceee32b8f09ff4cf060f7f1b2996d327da2b40d8493c3f2e2f53e7f9361f011" ;
    gsnprov:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:inModule ,
        gsn:supportedBy ;
    gsnprov:ruleName "Module Support Propagation" ;
    gsnprov:translatesStatement gsnprov:st-0596 ;
    gsnprov:restsOnStatement gsnprov:st-0207 ,
        gsnprov:st-0944 ;
    gsnprov:queryText """# rule:      S34
# name:      Module Support Propagation
# section:   Modular Extension
# operation: rule
# expect:    insert
# swrl:      Module(?M1) ^ Module(?M2) ^ 'supported by'(?E1, ?E2) ^ 'in module'(?E1, ?M1) ^
#            contains(?M2, ?E2) ^ swrlb:notEqual(?M1, ?M2) -> 'supported by'(?M1, ?M2)
# reads:     IF M1 and M2 are Modules AND E1 in M1 is supported by E2 in M2 AND M1 and M2 are
#            distinct THEN M1 is supported by M2

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

INSERT { ?M1 gsn:supportedBy ?M2 }
WHERE {
  ?E1 gsn:inModule ?M1 .
  ?E2 gsn:inModule ?M2 .
  FILTER(?M1 != ?M2)
  ?E1 gsn:supportedBy ?E2 .
  FILTER NOT EXISTS { ?M1 gsn:supportedBy ?M2 }
}
""" .

gsnprov:query-rules-s35-module-context-propagation
    a gsnprov:Query ;
    rdfs:label "rules/s35_module_context_propagation.rq"@en ;
