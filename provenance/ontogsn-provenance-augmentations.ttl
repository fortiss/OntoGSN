        gsn:true ;
    gsnprov:ruleName "Assumption False Propagation" ;
    gsnprov:translatesStatement gsnprov:st-0254 ;
    gsnprov:restsOnStatement gsnprov:st-0188 ,
        gsnprov:st-0218 ,
        gsnprov:st-0234 ;
    gsnprov:queryText """# rule:      S16
# name:      Assumption False Propagation
# section:   Core GSN
# operation: rule
# expect:    insert
# swrl:      Assumption(?A) ^ true(?A, false) ^ 'in context of'(?B, ?A) -> true(?B, false)
# reads:     IF A is an Assumption AND A is NOT true AND B is in context of A THEN B is NOT true

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?B gsn:true ?old }
INSERT { ?B gsn:true false }
WHERE {
  ?A a gsn:Assumption ;
     gsn:true ?tA .
  FILTER(STR(?tA) = "false")
  ?B gsn:inContextOf ?A .
  OPTIONAL { ?B gsn:true ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsnprov:query-rules-s17-context-inheritance
    a gsnprov:Query ;
    rdfs:label "rules/s17_context_inheritance.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s17_context_inheritance.rq" ;
    gsnprov:fileChecksum "3938d52ca10ae2e4f4e5e83047b85a6905c1dfadcf009578cbb3a923b4ebb43d" ;
    gsnprov:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Assumption ,
        gsn:Goal ,
        gsn:inContextOf ,
        gsn:supportedBy ;
    gsnprov:ruleName "Context Inheritance" ;
    gsnprov:translatesStatement gsnprov:st-0256 ;
    gsnprov:restsOnStatement gsnprov:st-0161 ,
        gsnprov:st-0188 ,
        gsnprov:st-0207 ,
        gsnprov:st-0218 ;
    gsnprov:queryText """# rule:      S17
# name:      Context Inheritance
# section:   Core GSN
# operation: rule
# expect:    insert
# swrl:      'supported by'(?B, ?C) ^ 'in context of'(?B, ?A) ^ Assumption(?A) ^ Goal(?C) -> 'in
#            context of'(?C, ?A)
# reads:     IF B is supported by C AND B is in context of A AND A is an Assumption AND C is a
#            Goal THEN C is in context of A

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

INSERT { ?C gsn:inContextOf ?A }
WHERE {
  ?A a gsn:Assumption .
  ?C a gsn:Goal .
  ?B gsn:supportedBy ?C ;
     gsn:inContextOf ?A .
  FILTER NOT EXISTS { ?C gsn:inContextOf ?A }
}
""" .

gsnprov:query-rules-s18-support-relation-creation
    a gsnprov:Query ;
    rdfs:label "rules/s18_support_relation_creation.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s18_support_relation_creation.rq" ;
    gsnprov:fileChecksum "7023c77fc6a796afa6f54ec298ec608df45ace1cbc61875bb4695361106a123e" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Relationship ,
        gsn:supportedBy ;
    gsnprov:ruleName "Support Relation Creation" ;
    gsnprov:translatesStatement gsnprov:st-0302 ;
    gsnprov:restsOnStatement gsnprov:st-0207 ,
        gsnprov:st-0291 ;
    gsnprov:queryText """# rule:      S18
# name:      Support Relation Creation
# section:   Core GSN
# operation: rule
# expect:    insert
# swrl:      'supported by'(?A, ?B) ^ swrlx:makeOWLThing(?B, ?R) -> rdf:subject(?R, ?A) ^
#            Relationship(?R) ^ rdf:object(?R, ?B)
# reads:     IF A is supported by B THEN Create R AND R has subject A and object B

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

INSERT {
  ?R a gsn:Relationship ;
     schema:identifier ?relationshipId ;
     rdf:subject ?A ;
     rdf:predicate gsn:supportedBy ;
     rdf:object ?B .
}
WHERE {
  ?A gsn:supportedBy ?B ;
     schema:identifier ?idA .
  ?B schema:identifier ?idB .
  BIND(CONCAT("R-", ?idA, "-supportedBy-", ?idB) AS ?relationshipId)
  BIND(IRI(CONCAT(REPLACE(STR(?A), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?relationshipId))) AS ?R)
  FILTER NOT EXISTS {
    ?existing rdf:subject ?A ;
              rdf:predicate gsn:supportedBy ;
              rdf:object ?B .
  }
}
""" .

gsnprov:query-rules-s19-context-relation-creation
    a gsnprov:Query ;
    rdfs:label "rules/s19_context_relation_creation.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s19_context_relation_creation.rq" ;
    gsnprov:fileChecksum "73e9e703ab28d602e74fe9cbe4b737c977128ceda17cb7fbc78d0b3b48f2d8d5" ;
    gsnprov:declaresNamespace "http://schema.org/" ,
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Relationship ,
        gsn:inContextOf ;
    gsnprov:ruleName "Context Relation Creation" ;
    gsnprov:translatesStatement gsnprov:st-0304 ;
    gsnprov:restsOnStatement gsnprov:st-0218 ,
        gsnprov:st-0291 ;
    gsnprov:queryText """# rule:      S19
# name:      Context Relation Creation
# section:   Core GSN
# operation: rule
# expect:    insert
# swrl:      'in context of'(?A, ?B) ^ swrlx:makeOWLThing(?B, ?R) -> rdf:subject(?R, ?A) ^
#            Relationship(?R) ^ rdf:object(?R, ?B)
# reads:     IF A is in context of B THEN Create R AND R has subject A and object B

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

INSERT {
  ?R a gsn:Relationship ;
     schema:identifier ?relationshipId ;
     rdf:subject ?A ;
     rdf:predicate gsn:inContextOf ;
     rdf:object ?B .
}
WHERE {
  ?A gsn:inContextOf ?B ;
     schema:identifier ?idA .
  ?B schema:identifier ?idB .
  BIND(CONCAT("R-", ?idA, "-inContextOf-", ?idB) AS ?relationshipId)
  BIND(IRI(CONCAT(REPLACE(STR(?A), "[^#/]*$", ""),
                  ENCODE_FOR_URI(?relationshipId))) AS ?R)
  FILTER NOT EXISTS {
    ?existing rdf:subject ?A ;
              rdf:predicate gsn:inContextOf ;
              rdf:object ?B .
  }
}
""" .

gsnprov:query-rules-s20-final-pattern-invalidation
    a gsnprov:Query ;
    rdfs:label "rules/s20_final_pattern_invalidation.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s20_final_pattern_invalidation.rq" ;
    gsnprov:fileChecksum "c9052a30731006d77faca56571b38bdc6328152f674ec6bdbb06b126eac046d0" ;
    gsnprov:declaresNamespace "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Pattern ,
        gsn:contains ,
        gsn:final ,
        gsn:instantiationOf ,
        gsn:valid ;
    gsnprov:ruleName "Final Pattern Invalidation" ;
    gsnprov:translatesStatement gsnprov:st-0310 ;
    gsnprov:restsOnStatement gsnprov:st-0114 ,
        gsnprov:st-0305 ,
        gsnprov:st-0330 ,
        gsnprov:st-0369 ,
        gsnprov:st-0474 ;
    gsnprov:queryText """# rule:      S20
# name:      Final Pattern Invalidation
# section:   Argument Pattern Extension
# operation: rule
# expect:    insert
# swrl:      'instantiation of'(?B, ?C) ^ final(?A, true) ^ Pattern(?C) ^ contains(?A, ?B) ^
#            contains(?A, ?C) -> valid(?A, false)
# reads:     IF B is an instantiation of Pattern C inside container A AND A is marked final AND A
#            contains both B and C AND C is a Pattern THEN A is NOT valid

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>

DELETE { ?A gsn:valid ?old }
INSERT { ?A gsn:valid false }
WHERE {
  ?C a gsn:Pattern .
  ?B gsn:instantiationOf ?C .
  ?A gsn:final ?final ;
     gsn:contains ?B , ?C .
  FILTER(STR(?final) = "true")
  OPTIONAL { ?A gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsnprov:query-rules-s21-template-undeveloped-invalidation-a
    a gsnprov:Query ;
    rdfs:label "rules/s21_template_undeveloped_invalidation_a.rq"@en ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:path "queries/rules/s21_template_undeveloped_invalidation_a.rq" ;
    gsnprov:fileChecksum "00dd085415a8aaabf70717a800ee4012d2921d6cd536cca21320553f52202e28" ;
    gsnprov:declaresNamespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ,
        "https://w3id.org/OntoGSN/ontology#" ;
    gsnprov:mentionsTerm gsn:Template ,
        gsn:published ,
        gsn:undeveloped ,
        gsn:valid ;
    gsnprov:ruleName "Template Undeveloped Invalidation (A)" ;
    gsnprov:translatesStatement gsnprov:st-0449 ;
    gsnprov:restsOnStatement gsnprov:st-0114 ,
        gsnprov:st-0200 ,
        gsnprov:st-0438 ,
        gsnprov:st-0444 ;
    gsnprov:queryText """# rule:      S21
# name:      Template Undeveloped Invalidation (A)
# section:   Argument Pattern Extension
# operation: rule
# expect:    insert
# swrl:      Template(?A) ^ undeveloped(?R, true) ^ rdf:subject(?R, ?A) ^ published(?A, true) ->
#            valid(?A, false) ^ valid(?R, false)
# reads:     IF A is a Template AND there is an undeveloped Relation R whose subject is A AND A
#            is published THEN A is NOT valid AND R is NOT valid

PREFIX gsn: <https://w3id.org/OntoGSN/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DELETE { ?target gsn:valid ?old }
INSERT { ?target gsn:valid false }
WHERE {
  ?A a gsn:Template ;
     gsn:published ?published .
  FILTER(STR(?published) = "true")
  ?R gsn:undeveloped ?undeveloped ;
     rdf:subject ?A .
  FILTER(STR(?undeveloped) = "true")
  VALUES ?slot { 1 2 }
  BIND(IF(?slot = 1, ?A, ?R) AS ?target)
  OPTIONAL { ?target gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
""" .

gsnprov:query-rules-s22-template-undeveloped-invalidation-b
    a gsnprov:Query ;
    rdfs:label "rules/s22_template_undeveloped_invalidation_b.rq"@en ;
