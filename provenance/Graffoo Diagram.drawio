        <mxCell id="pr-957" parent="1" style="shape=note;html=1;backgroundOutline=1;darkOpacity=0.05;strokeColor=light-dark(#A9C4EB,#334A6C);fillColor=light-dark(#CCFFFF,#002525);gradientColor=none;align=left;spacingLeft=1;fontSize=11;whiteSpace=wrap;size=0;verticalAlign=top;" value="&lt;span style=&quot;font-family: &amp;quot;courier new&amp;quot;; white-space: nowrap;&quot;&gt;Identity vs. evidence:&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-family: &amp;quot;courier new&amp;quot;; white-space: nowrap;&quot;&gt;&amp;nbsp; IDENTITY - gsnprov:structuralKey,&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: &amp;quot;courier new&amp;quot;; white-space: nowrap;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; stable across re-serialization.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: &amp;quot;courier new&amp;quot;; white-space: nowrap;&quot;&gt;&amp;nbsp; EVIDENCE - gsnprov:statementText&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: &amp;quot;courier new&amp;quot;; white-space: nowrap;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; plus gsnprov:statementChecksum.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: &amp;quot;courier new&amp;quot;; white-space: nowrap;&quot;&gt;&amp;nbsp; aboutTerm / mentionsTerm are a third,&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: &amp;quot;courier new&amp;quot;; white-space: nowrap;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; weaker thing: a join key for SPARQL.&lt;/span&gt;&lt;/div&gt;" vertex="1">
