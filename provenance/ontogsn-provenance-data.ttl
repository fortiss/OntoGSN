gsnprov:dd-0665
    a gsnprov:DesignDecision ;
    gsnprov:positionKey "S07.R026" ;
    gsnprov:part gsnprov:part-1 ;
    gsnprov:section gsnprov:sec-confidence ;
    gsnprov:formalism gsnprov:SWRL ;
    gsnprov:naturalLanguage "IF A has schema identifier N AND B has schema identifier M AND A and B are distinct AND N and M are equal THEN A is NOT valid AND B is NOT valid"@en ;
    gsnprov:nlWrittenFor "f7a0fc88" ;
