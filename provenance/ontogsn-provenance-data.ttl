gsnprov:dd-0663
    a gsnprov:DesignDecision ;
    gsnprov:positionKey "S07.R024" ;
    gsnprov:part gsnprov:part-1 ;
    gsnprov:section gsnprov:sec-confidence ;
    gsnprov:formalism gsnprov:SWRL ;
    gsnprov:naturalLanguage "IF A is an Artefact Reference marked as an assurance claim point AND we introduce a reified confidence Relationship R for A THEN R is a Relationship with Confidence whose subject is A and which is itself an assurance claim point"@en ;
    gsnprov:nlWrittenFor "e69be810" ;
    prov:used gsnprov:src-0245 ;
    gsnprov:hasRationale gsnprov:why-0129 ;
    prov:generated gsnprov:st-0663 .

gsnprov:st-0663
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnprov:dd-0663 ;
    gsnprov:inGraph gsnprov:ontology-1.2.3 ;
    gsnprov:statementText """# Confidence Relation Creation
assuranceClaimPoint(?A, true) ^ ArtefactReference(?A) ^ makeOWLThing(?A, ?R) -> RelationshipWithConfidence(?R) ^ subject(?R, ?A) ^ assuranceClaimPoint(?R, true)""" ;
    gsnprov:statementChecksum "e69be810" ;
    gsnprov:structuralKey "rule|Confidence Relation Creation" ;
    gsnprov:ruleName "Confidence Relation Creation" ;
    gsnprov:mentionsTerm gsn:ArtefactReference ,
        gsn:RelationshipWithConfidence ,
        gsn:assuranceClaimPoint ;
    prov:wasDerivedFrom gsnprov:src-0245 ;
    prov:qualifiedDerivation [ a prov:Derivation ; prov:entity gsnprov:src-0245 ; prov:hadActivity gsnprov:dd-0663 ] .

