    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnprov:dd-0936 ;
    gsnprov:inGraph gsnprov:shapes-1.0.0 ;
    gsnprov:statementText """gsnsh:SuccessfulChallengeCastsDoubtShape gsn:coreOrExtension "Dialectic Extension"@en ;
    rdf:type sh:NodeShape ;
    rdfs:comment "Complements, rather than replaces, the SWRL rules of the Dialectic Extension: if the claim presented in the challenging goal is true then this is sufficient to establish that the claim in the challenged element is in doubt. Run the reasoner if the assertion is expected to be inferred."@en ;
    rdfs:label "A successful challenge casts doubt on its target"@en ;
    sh:targetSubjectsOf gsn:challenges .""" ;
    gsnprov:statementChecksum "9128e39d" ;
    gsnprov:structuralKey "gsnsh:SuccessfulChallengeCastsDoubtShape|node|" ;
    gsnprov:aboutTerm gsnsh:SuccessfulChallengeCastsDoubtShape ;
    gsnprov:mentionsTerm gsn:challenges ,
        gsn:coreOrExtension ,
        gsnsh:SuccessfulChallengeCastsDoubtShape .

