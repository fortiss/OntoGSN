    gsnprov:statementText "gsn:Relationship rdfs:subClassOf [ subject only (Defeater or Goal or Strategy) ] ." ;
    gsnprov:statementChecksum "4e95e9e1" ;
    gsnprov:structuralKey "Relationship|subject|only (Defeater or Goal or Strategy)" ;
    gsnprov:aboutTerm gsn:Relationship ;
    gsnprov:mentionsTerm gsn:Relationship .

