    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnprov:dd-0226 ;
    gsnprov:inGraph gsnprov:ontology-1.2.3 ;
    gsnprov:statementText """# Predicate Conflict Invalidation
object(?R3, ?A) ^ subject(?R1, ?A) ^ subject(?R2, ?B) ^ subject(?R3, ?C) ^ predicate(?R3, ?P) ^ predicate(?R2, ?P) ^ object(?R1, ?B) ^ object(?R2, ?C) ^ predicate(?R1, ?P) -> valid(?R1, false) ^ valid(?R2, false) ^ valid(?R3, false)""" ;
    gsnprov:statementChecksum "ce8fada8" ;
    gsnprov:structuralKey "rule|Predicate Conflict Invalidation" ;
    gsnprov:ruleName "Predicate Conflict Invalidation" ;
    gsnprov:mentionsTerm gsn:valid ;
