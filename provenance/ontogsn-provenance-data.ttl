    a gsnprov:RetiredDecision ;
    gsnprov:positionKey "S04.R126" ;
    gsnprov:part gsnprov:part-1 ;
    gsnprov:section gsnprov:sec-core ;
    gsnprov:formalism gsnprov:OWL ;
    gsnprov:naturalLanguage "A relationship could only have as its predicate ‘challenges’, ‘in context of’ or ‘supported by’."@en ;
