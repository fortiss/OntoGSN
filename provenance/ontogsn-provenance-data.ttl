gsnprov:src-0015
    a gsnprov:SourcePassage ;
    prov:specializationOf gsnprov:GSNCommunityStandardV3 ;
    gsnprov:quotedText "1:2.1.4 Table 1:2-1 provides the definition and rendering of these elements."@en ;
