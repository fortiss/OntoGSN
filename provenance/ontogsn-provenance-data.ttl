gsnprov:dd-0572
    a gsnprov:DesignDecision ;
    gsnprov:positionKey "S06.R101" ;
    gsnprov:part gsnprov:part-1 ;
    gsnprov:section gsnprov:sec-modular ;
    gsnprov:formalism gsnprov:SWRL ;
    gsnprov:naturalLanguage "IF G1 is in context of C1 AND G2 is in context of C2 AND G1 and G2 are Goals AND G2 is away AND G1 is supported by G2 AND C2 is a Context THEN C1 is consistent with C2"@en ;
