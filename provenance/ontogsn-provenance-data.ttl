gsnprov:dd-0226
    a gsnprov:DesignDecision ;
    gsnprov:positionKey "S04.R072" ;
    gsnprov:part gsnprov:part-1 ;
    gsnprov:section gsnprov:sec-core ;
    gsnprov:formalism gsnprov:SWRL ;
    gsnprov:naturalLanguage "IF R1 has subject A, predicate P, and object B AND R2 has subject B, predicate P, and object C AND R3 has subject C, predicate P, and object A THEN R1 is NOT valid AND R2 is NOT valid AND R3 is NOT valid"@en ;
