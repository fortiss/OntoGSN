gsnprov:dd-0052
    a gsnprov:DesignDecision ;
    gsnprov:positionKey "S01.R040" ;
    gsnprov:part gsnprov:part-0 ;
    gsnprov:section gsnprov:sec-ontology-specific ;
    gsnprov:formalism gsnprov:OWL ;
    gsnprov:naturalLanguage "The ontology's description is “OntoGSN is an ontology for managing assurance cases in the Goal Structuring Notation (GSN). The goal of the ontology is to help users in linking the elements of their cases - claims and evidence - with the internationalized resource identifiers (IRIs) of represented concepts, events and data, and in evaluating the validity of their argument.”."@en ;
    gsnprov:nlWrittenFor "08c71ac7" ;
    gsnprov:noSourceRecorded "true"^^xsd:boolean ;
    gsnprov:hasRationale gsnprov:why-0006 ;
    prov:generated gsnprov:st-0052 .

