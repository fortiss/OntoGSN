    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnprov:dd-0665 ;
    gsnprov:inGraph gsnprov:ontology-1.2.3 ;
    gsnprov:statementText """# Duplicate Name Invalidation
identifier(?A, ?N) ^ identifier(?B, ?M) ^ notEqual(?A, ?B) ^ equal(?N, ?M) -> valid(?A, false) ^ valid(?B, false)""" ;
    gsnprov:statementChecksum "f7a0fc88" ;
    gsnprov:structuralKey "rule|Duplicate Name Invalidation" ;
