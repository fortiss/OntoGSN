    gsnprov:statementChecksum "0268ec1d" ;
    gsnprov:structuralKey "(Goal and not inverse supportedBy some Goal)|EquivalentTo|top value \"true\"" ;
    prov:wasDerivedFrom gsnprov:src-0041 ;
    prov:qualifiedDerivation [ a prov:Derivation ; prov:entity gsnprov:src-0041 ; prov:hadActivity gsnprov:dd-0150 ] .

