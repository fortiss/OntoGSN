gsnprov:dd-0294
    a gsnprov:RetiredDecision ;
    gsnprov:retirementReason "the subject restriction was extended with gsn:Module and gsn:Pattern in 1.2.3. Rules S18 and S19 reify module-to-module support and rule S21 reifies a link whose subject is a template, so the restriction rejected relationships the rule set creates. Superseded by the extended restriction recorded in the same release."@en ;
    gsnprov:positionKey "S04.R125" ;
    gsnprov:part gsnprov:part-1 ;
    gsnprov:section gsnprov:sec-core ;
    gsnprov:formalism gsnprov:OWL ;
    gsnprov:naturalLanguage "A relationship can only have as its subject a defeater, a goal or a strategy."@en ;
    gsnprov:nlWrittenFor "4e95e9e1" ;
    gsnprov:noSourceRecorded "true"^^xsd:boolean ;
    gsnprov:hasRationale gsnprov:why-0050 ;
    prov:generated gsnprov:st-0294 .

