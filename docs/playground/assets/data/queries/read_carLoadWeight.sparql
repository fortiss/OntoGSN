PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>
PREFIX gsn:   <https://w3id.org/OntoGSN/ontology#>
PREFIX schema:<http://schema.org/>
PREFIX ex:    <https://example.org/car-demo#>

SELECT
  (SUM(?w) AS ?currentLoadWeight)
  (xsd:float(?maxVal) AS ?maxLoadWeight)
WHERE {
  ?car a schema:Car ;
       schema:roofLoad ?roofQv .
  ?roofQv schema:value ?maxVal .
  ?roofRack schema:isPartOf ?car ;
            schema:identifier "roofRack" .
  OPTIONAL {
    ?load a schema:Product ;
          ex:isActive true ;
          schema:weight ?wQv ;
          ex:onTopOf+ ?roofRack .
    ?wQv schema:value ?wVal .
  }
  BIND(COALESCE(xsd:float(?wVal), 0.0) AS ?w)
}
GROUP BY ?maxVal
