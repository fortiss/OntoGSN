PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>
PREFIX gsn:   <https://w3id.org/OntoGSN/ontology#>
PREFIX schema:<http://schema.org/>
PREFIX ex:    <https://example.org/car-demo#>

INSERT {
  ex:car_D1_2 a gsn:Goal ;
      gsn:challenges     ex:car_G1_2 ;
      schema:identifier  "D1.2" ;
      gsn:statement      "Current load exceeds maximum allowed roof load." ;
      ex:concernsElement ?load .
  ex:ARG_CarStaticLoad gsn:contains ex:car_D1_2 .
}
WHERE {
  {
    SELECT ?roofRack
    WHERE {
    ?car a schema:Car ;
         schema:roofLoad ?roofQv .
    ?roofQv schema:value ?maxVal .
    ?roofRack schema:isPartOf ?car ;
              schema:identifier "roofRack" .
      ?load a schema:Product ;
            ex:isActive true ;
            schema:weight ?wQv ;
            ex:onTopOf+ ?roofRack .
      ?wQv schema:value ?wVal .
    }
    GROUP BY ?roofRack ?maxVal
    HAVING (SUM(xsd:float(?wVal)) > xsd:float(?maxVal))
  }
  ?load a schema:Product ;
        ex:isActive true ;
        ex:onTopOf+ ?roofRack .
}
