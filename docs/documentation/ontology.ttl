<http://schema.org/name> rdf:type owl:AnnotationProperty .


###  http://schema.org/url
<http://schema.org/url> rdf:type owl:AnnotationProperty .


###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
<http://www.w3.org/2004/02/skos/core#altLabel> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
<http://www.w3.org/2004/02/skos/core#definition> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#note
<http://www.w3.org/2004/02/skos/core#note> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#scopeNote
<http://www.w3.org/2004/02/skos/core#scopeNote> rdf:type owl:AnnotationProperty .


###  https://w3id.org/OntoGSN/ontology#applicability
:applicability rdf:type owl:AnnotationProperty ;
               rdfs:label "applicability"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "The applicability section should state under what circumstances the pattern can be applied, making clear the assumptions and principles underlying the pattern to avoid inappropriate application in a mismatched context. This section should record what contextual information is required in order to apply the pattern."@en ;
               :coreOrExtension "Argument Pattern Extension"@en ;
               rdfs:domain :Pattern .


###  https://w3id.org/OntoGSN/ontology#collaboration
:collaboration rdf:type owl:AnnotationProperty ;
               rdfs:label "collaboration"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "The collaboration section should describe how elements of the pattern work together to achieve the desired effect, particularly where there are links that are not readily apparent from the argument structure."@en ;
               :coreOrExtension "Argument Pattern Extension"@en ;
               rdfs:domain :Pattern .


###  https://w3id.org/OntoGSN/ontology#consequences
:consequences rdf:type owl:AnnotationProperty ;
              rdfs:label "consequences"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "The consequences section should make clear what work remains after the pattern has been applied. This should highlight where further support to the argument is required, and assumptions that need to be discharged."@en ;
              :coreOrExtension "Argument Pattern Extension"@en ;
              rdfs:domain :Pattern .


###  https://w3id.org/OntoGSN/ontology#coreOrExtension
:coreOrExtension rdf:type owl:AnnotationProperty ;
                 rdfs:label "core or extension"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Indicator of the sourcing section in the GSN Community Standard v3."@en .


###  https://w3id.org/OntoGSN/ontology#examples
:examples rdf:type owl:AnnotationProperty ;
          rdfs:label "examples"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "It may be useful to provide example illustrations of the application of the pattern, particularly for more abstract patterns. Illustrations should include a typical case and can be supplemented with atypical cases where more than one example is provided."@en ;
          :coreOrExtension "Argument Pattern Extension"@en ;
          rdfs:domain :Pattern .


###  https://w3id.org/OntoGSN/ontology#implementation
:implementation rdf:type owl:AnnotationProperty ;
                rdfs:label "implementation"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "The implementation section should communicate how the application of the pattern is carried out e.g. the order in which elements should be developed; communicate hints or techniques that may ease successful application; highlight common or recognised pitfalls with the application of the pattern; and record potential misinterpretation of the terms or concepts in the pattern."@en ;
                :coreOrExtension "Argument Pattern Extension"@en ;
                rdfs:domain :Pattern .


###  https://w3id.org/OntoGSN/ontology#inferredOnly
:inferredOnly rdf:type owl:AnnotationProperty ;
              rdfs:label "inferred only"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "[OntoGSN] Marks a property that a rule derives and that a case never asserts."@en ;
              :coreOrExtension "Core GSN"@en .


###  https://w3id.org/OntoGSN/ontology#intent
:intent rdf:type owl:AnnotationProperty ;
        rdfs:label "intent"@en ;
        <http://www.w3.org/2004/02/skos/core#definition> "The intent statement should state clearly what the pattern aims to achieve."@en ;
        :coreOrExtension "Argument Pattern Extension"@en ;
        rdfs:domain :Pattern .


###  https://w3id.org/OntoGSN/ontology#knownUses
:knownUses rdf:type owl:AnnotationProperty ;
           rdfs:label "known uses"@en ;
           <http://www.w3.org/2004/02/skos/core#definition> "It may be useful to provide references to known applications of the pattern. These can serve as additional examples."@en ;
           :coreOrExtension "Argument Pattern Extension"@en ;
           rdfs:domain :Pattern .


###  https://w3id.org/OntoGSN/ontology#motivation
:motivation rdf:type owl:AnnotationProperty ;
            rdfs:label "motivation"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "The motivation statement can be used to state why the pattern was created. It could be expressed in terms of previous experiences e.g. as the abstraction of a successfully presented argument, or challenges addressed e.g. argument topics that are often incompletely or poorly addressed."@en ;
            :coreOrExtension "Argument Pattern Extension"@en ;
            rdfs:domain :Pattern .


###  https://w3id.org/OntoGSN/ontology#participants
:participants rdf:type owl:AnnotationProperty ;
              rdfs:label "participants"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "The participants section augments the structure by providing a description of each element. This can provide more complete descriptions, clarify the role of the element in the overall argument and emphasise the aspects that require development or instantiation."@en ;
              :coreOrExtension "Argument Pattern Extension"@en ;
              rdfs:domain :Pattern .


###  https://w3id.org/OntoGSN/ontology#renderedAs
:renderedAs rdf:type owl:AnnotationProperty ;
            rdfs:label "rendered as"@en ;
            :coreOrExtension "Core GSN"@en .


###  https://w3id.org/OntoGSN/ontology#structure
:structure rdf:type owl:AnnotationProperty ;
           rdfs:label "structure"@en ;
           <http://www.w3.org/2004/02/skos/core#definition> "The structure uses the structural and element abstraction notations to present the pattern, clearly indicating where the argument needs to be further developed or populated with details to instantiate the pattern for a specific case."@en ;
           :coreOrExtension "Argument Pattern Extension"@en ;
           rdfs:domain :Pattern .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.w3.org/1999/02/22-rdf-syntax-ns#object
rdf:object rdf:type owl:ObjectProperty .


###  http://www.w3.org/1999/02/22-rdf-syntax-ns#predicate
rdf:predicate rdf:type owl:ObjectProperty .


###  http://www.w3.org/1999/02/22-rdf-syntax-ns#subject
rdf:subject rdf:type owl:ObjectProperty .


###  http://www.w3.org/2002/07/owl#differentFrom
owl:differentFrom rdf:type owl:ObjectProperty .


###  https://w3id.org/OntoGSN/ontology#associatedWith
:associatedWith rdf:type owl:ObjectProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :ArtefactReference
                                            :RelationshipWithConfidence
                                          )
                            ] ;
                rdfs:range :Argument ;
                rdfs:label "associated with"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "[OntoGSN] Links a relationship or an artefact reference to the confidence argument provided for it."@en ;
                :coreOrExtension "Confidence Argument Extension"@en .


###  https://w3id.org/OntoGSN/ontology#attachedTo
:attachedTo rdf:type owl:ObjectProperty ;
            rdfs:domain :InstantiationDataReference ;
            rdfs:range [ rdf:type owl:Class ;
                         owl:unionOf ( :GSNElement
                                       :Template
                                     )
                       ] ;
            rdfs:label "attached to"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "[OntoGSN] Links an instantiation data reference to the element or template argument it annotates."@en ;
            :coreOrExtension "Argument Pattern Extension"@en ;
            :renderedAs "dotted line" .


###  https://w3id.org/OntoGSN/ontology#challenges
:challenges rdf:type owl:ObjectProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( :Goal
                                        :Solution
                                      )
                        ] ;
            rdfs:range [ rdf:type owl:Class ;
                         owl:unionOf ( :GSNElement
                                       :Relationship
                                     )
                       ] ;
            rdfs:label "challenges"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "Allows a Challenge to any GSN entity to be documented. A goal, (core element) can be used in a dialectic context to assert a challenge to part of the argument. A solution, (core element) can be used to present a reference to an evidence item that asserts a challenge to part of the argument."@en ;
            <http://www.w3.org/2004/02/skos/core#note> "A challenge must be levied against the appropriate aspect of the goal structure."@en ;
            :coreOrExtension "Dialectic Extension"@en ;
            :renderedAs "dashed line with an open arrowhead" .


###  https://w3id.org/OntoGSN/ontology#consistentWith
:consistentWith rdf:type owl:ObjectProperty ,
                         owl:SymmetricProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :Assumption
                                            :Context
                                          )
                            ] ;
                rdfs:range [ rdf:type owl:Class ;
                             owl:unionOf ( :Assumption
                                           :Context
                                         )
                           ] ;
                rdfs:label "consistent with"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "By making the relationship to the away goal the author is asserting not only the inference of support for the parent goal, but also that the context in which the away goal is declared is consistent with the context and assumptions in scope for the parent goal." ;
                :coreOrExtension "Modular Extension"@en .


###  https://w3id.org/OntoGSN/ontology#contains
:contains rdf:type owl:ObjectProperty ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( :Argument
                                      :AssuranceCase
                                      :Catalogue
                                      :Module
                                      :Pattern
                                    )
                      ] ;
          rdfs:range [ rdf:type owl:Class ;
                       owl:unionOf ( :Argument
                                     :Artefact
                                     :GSNElement
                                     :Pattern
                                   )
                     ] ;
          rdfs:label "contains"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "[OntoGSN] Relates a container (e.g., an assurance case, argument, module, catalogue or pattern) to its components (e.g., elements, arguments, patterns or artefacts)."@en ;
          :coreOrExtension "Core GSN"@en .


###  https://w3id.org/OntoGSN/ontology#depicts
:depicts rdf:type owl:ObjectProperty ;
         rdfs:domain :View ;
         rdfs:range :Module ;
         rdfs:label "depicts"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "The argument view depicts the argument inside an individual module."@en ;
         :coreOrExtension "Modular Extension"@en .


###  https://w3id.org/OntoGSN/ontology#inContextOf
:inContextOf rdf:type owl:ObjectProperty ,
                      owl:AsymmetricProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :Goal
                                         :Module
                                         :Strategy
                                       )
                         ] ;
             rdfs:range [ rdf:type owl:Class ;
                          owl:unionOf ( :Assumption
                                        :Context
                                        :Justification
                                        :Module
                                      )
                        ] ;
             rdfs:label "in context of"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "InContextOf, rendered as a line with a hollow arrowhead, declares a contextual relationship."@en ;
             :coreOrExtension "Core GSN"@en ;
             :renderedAs "line with a hollow arrowhead" .


###  https://w3id.org/OntoGSN/ontology#inModule
:inModule rdf:type owl:ObjectProperty ;
          rdfs:domain :GSNElement ;
          rdfs:range :Module ;
          rdfs:label "in module"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "The module an element belongs to, whether the element sits in an argument the module contains or in a module nested inside it."@en ;
          <http://www.w3.org/2004/02/skos/core#note> "Inferred, never authored. A module contains arguments and other modules, so the module an element belongs to is always reached in two steps or more. This property names the result of that traversal so that the rules of the Modular Extension can state it in one atom. It is derived by the Module Membership and Nested Module Membership rules."@en ;
          :coreOrExtension "Modular Extension"@en ;
          :inferredOnly "true"^^xsd:boolean .


###  https://w3id.org/OntoGSN/ontology#instantiationOf
:instantiationOf rdf:type owl:ObjectProperty ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( :Argument
                                             :GSNElement
                                           )
                             ] ;
                 rdfs:range :Pattern ;
                 rdfs:label "instantiation of"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "[OntoGSN] Relates an argument or element to the pattern it was instantiated from."@en ;
                 :coreOrExtension "Argument Pattern Extension"@en .


###  https://w3id.org/OntoGSN/ontology#refersTo
:refersTo rdf:type owl:ObjectProperty ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( :ArtefactReference
                                      :InstantiationDataReference
                                    )
                      ] ;
          rdfs:range :Artefact ;
          rdfs:label "refers to"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "[OntoGSN] Relates an artefact reference or an instantiation data reference to the artefact it points at."@en ;
          :coreOrExtension "Core GSN"@en .


###  https://w3id.org/OntoGSN/ontology#relatedTo
:relatedTo rdf:type owl:ObjectProperty ;
           rdfs:domain :Pattern ;
           rdfs:range :Pattern ;
           rdfs:label "related to"@en ;
           <http://www.w3.org/2004/02/skos/core#definition> "This section can be used to reference patterns that are related e.g. addressing the same intent in a different context."@en ;
           :coreOrExtension "Argument Pattern Extension"@en .


###  https://w3id.org/OntoGSN/ontology#substitutedBy
:substitutedBy rdf:type owl:ObjectProperty ;
               rdfs:domain :Justification ;
               rdfs:range [ owl:intersectionOf ( :Goal
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty :away ;
                                                   owl:hasValue "true"^^xsd:boolean
                                                 ]
                                               ) ;
                            rdf:type owl:Class
                          ] ;
               rdfs:label "substituted by"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "There may be occasions when a goal or strategy requires fuller justification than can be provided within the confines of a GSN justification element. In such cases, an away goal can be substituted for the justification."@en ;
               :coreOrExtension "Modular Extension"@en .


###  https://w3id.org/OntoGSN/ontology#supportedBy
:supportedBy rdf:type owl:ObjectProperty ,
                      owl:AsymmetricProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :Goal
                                         :Module
                                         :Strategy
                                       )
                         ] ;
             rdfs:range [ rdf:type owl:Class ;
                          owl:unionOf ( :Goal
                                        :Module
                                        :Solution
                                        :Strategy
                                      )
                        ] ;
             rdfs:label "supported by"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "SupportedBy, rendered as a line with a solid arrowhead, allows support relationships between elements to be documented."@en ;
             :coreOrExtension "Core GSN"@en ;
             :renderedAs "line with a solid arrowhead" .


###  https://w3id.org/OntoGSN/ontology#transitivelyChallenges
:transitivelyChallenges rdf:type owl:ObjectProperty ,
                                 owl:TransitiveProperty ;
                        rdfs:domain [ rdf:type owl:Class ;
                                      owl:unionOf ( :GSNElement
                                                    :Relationship
                                                  )
                                    ] ;
                        rdfs:range [ rdf:type owl:Class ;
                                     owl:unionOf ( :GSNElement
                                                   :Relationship
                                                 )
                                   ] ;
                        rdfs:label "transitively challenges"@en ;
                        <http://www.w3.org/2004/02/skos/core#definition> "[OntoGSN] Relates an element to every element that it reaches through a chain of one or more challenges."@en ;
                        <http://www.w3.org/2004/02/skos/core#note> "Inferred, never authored. It is derived by the Challenge Closure rule, and the Challenge Cycle rules read it."@en ;
                        :coreOrExtension "Dialectic Extension"@en ;
                        :inferredOnly "true"^^xsd:boolean .


###  https://w3id.org/OntoGSN/ontology#transitivelyInContextOf
:transitivelyInContextOf rdf:type owl:ObjectProperty ,
                                  owl:TransitiveProperty ;
                         rdfs:domain :Module ;
                         rdfs:range :Module ;
                         rdfs:label "transitively in context of"@en ;
                         <http://www.w3.org/2004/02/skos/core#definition> "[OntoGSN] Relates a module to every module that it reaches through a chain of one or more in-context-of links between modules."@en ;
                         <http://www.w3.org/2004/02/skos/core#note> "Inferred, never authored. It is derived by the Module Context Closure rule, and the Module Context Cycle rules read it."@en ;
                         :coreOrExtension "Modular Extension"@en ;
                         :inferredOnly "true"^^xsd:boolean .


###  https://w3id.org/OntoGSN/ontology#transitivelySupportedBy
:transitivelySupportedBy rdf:type owl:ObjectProperty ,
                                  owl:TransitiveProperty ;
                         rdfs:domain :GSNElement ;
                         rdfs:range :GSNElement ;
                         rdfs:label "transitively supported by"@en ;
                         <http://www.w3.org/2004/02/skos/core#definition> "[OntoGSN] Relates an element to every element that it reaches through a chain of one or more supported-by links."@en ;
                         <http://www.w3.org/2004/02/skos/core#note> "Inferred, never authored. It is derived by the Support Closure rule, and the Support Cycle rules read it."@en ;
                         :coreOrExtension "Core GSN"@en ;
                         :inferredOnly "true"^^xsd:boolean .


#################################################################
#    Data properties
#################################################################

###  http://schema.org/description
<http://schema.org/description> rdf:type owl:DatatypeProperty .


###  http://schema.org/identifier
<http://schema.org/identifier> rdf:type owl:DatatypeProperty .


###  https://w3id.org/OntoGSN/ontology#argumentType
:argumentType rdf:type owl:DatatypeProperty ;
              rdfs:domain :Argument ;
              rdfs:range [ rdf:type rdfs:Datatype ;
                           owl:oneOf [ rdf:type rdf:List ;
                                       rdf:first "confidence" ;
                                       rdf:rest [ rdf:type rdf:List ;
                                                  rdf:first "dialectic" ;
                                                  rdf:rest [ rdf:type rdf:List ;
                                                             rdf:first "risk" ;
                                                             rdf:rest rdf:nil
                                                           ]
                                                ]
                                     ]
                         ] ;
              rdfs:label "argument type"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "[OntoGSN] Defines the kind of argument this is: a risk argument (i.e., the main content of assurance), a confidence argument for an assurance claim point, a compliance argument (undefined in the normative standard), or a dialectic argument."@en ;
              :coreOrExtension "Confidence Argument Extension"@en .


###  https://w3id.org/OntoGSN/ontology#assuranceClaimPoint
:assuranceClaimPoint rdf:type owl:DatatypeProperty ;
                     rdfs:domain [ rdf:type owl:Class ;
                                   owl:unionOf ( :ArtefactReference
                                                 :RelationshipWithConfidence
                                               )
                                 ] ;
                     rdfs:range xsd:boolean ;
                     rdfs:label "assurance claim point"@en ;
                     <http://www.w3.org/2004/02/skos/core#definition> "An Assurance Claim Point (ACP) can be used in GSN to indicate that a confidence argument is associated with an assertion in a risk argument."@en ;
                     :coreOrExtension "Confidence Argument Extension"@en ;
                     :renderedAs "solid square" .


###  https://w3id.org/OntoGSN/ontology#away
:away rdf:type owl:DatatypeProperty ;
      rdfs:domain [ rdf:type owl:Class ;
                    owl:unionOf ( :Assumption
                                  :Context
                                  :Goal
                                  :Justification
                                  :Solution
                                )
                  ] ;
      rdfs:range xsd:boolean ;
      <http://schema.org/description> "An away assumption repeats an assumption presented in another argument module and is typically used only in Contract Modules. An away context repeats a reference to context presented in another argument module. An away goal reference repeats a claim presented in another argument module. An away justification repeats a justification presented in another argument module and is typically used only in Contract Modules. An away solution repeats a reference to evidence items presented in another argument module."@en ;
      rdfs:label "away"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "An away element reference repeats a claim or evidence presented in another argument module."@en ;
      :coreOrExtension "Modular Extension"@en ;
      :renderedAs "bisecting line in the lower half" .


###  https://w3id.org/OntoGSN/ontology#choice
:choice rdf:type owl:DatatypeProperty ;
        rdfs:domain :Relationship ;
        rdfs:range xsd:boolean ;
        rdfs:label "choice"@en ;
        <http://www.w3.org/2004/02/skos/core#definition> "A GSN choice can be used to denote possible alternatives in satisfying a relationship."@en ;
        :coreOrExtension "Argument Pattern Extension"@en ;
        :renderedAs "solid diamond" .


###  https://w3id.org/OntoGSN/ontology#contract
:contract rdf:type owl:DatatypeProperty ;
          rdfs:domain :Module ;
          rdfs:range xsd:boolean ;
          owl:propertyDisjointWith :undeveloped ;
          rdfs:label "contract"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "A contract module is a special type of module that controls the relationship between argument module interfaces using arguments to define how a goal in one module is supported by one or more goals in one or more other modules."@en ;
          <http://www.w3.org/2004/02/skos/core#note> "A contract may be described in textual form (e.g. as a table) or for more complex relationships may be described within a contract module using GSN."@en ,
                                                     "Contract modules can be used in the support relationship between modules to aid decoupling. The de-coupling by use of a contract permits argument module construction in cases where the eventual source of support for an argument is unknown at the time of authoring or can be changed for example through re-use or planned product improvement or reconfiguration."@en ;
          :coreOrExtension "Modular Extension"@en ;
          :renderedAs "a rectangle with two smaller rectangles (of equal size to each other) adjoining at the top left and bottom right" .


###  https://w3id.org/OntoGSN/ontology#defeated
:defeated rdf:type owl:DatatypeProperty ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( :GSNElement
                                      :Relationship
                                    )
                      ] ;
          rdfs:range xsd:boolean ;
          <http://schema.org/description> "Defeated Relationship indicates that the relationship is defeated. The Defeated decorator can be applied to any of the GSN relationships."@en ;
          rdfs:label "defeated"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "This decorator symbol indicates that the element is defeated. The Defeated decorator can be applied to any of the GSN elements."@en ;
          :coreOrExtension "Dialectic Extension"@en ;
          :renderedAs "cross (‘X’) superimposed on a GSN element or relationship" .


###  https://w3id.org/OntoGSN/ontology#final
:final rdf:type owl:DatatypeProperty ;
       rdfs:domain [ rdf:type owl:Class ;
                     owl:unionOf ( :Argument
                                   :Pattern
                                 )
                   ] ;
       rdfs:range xsd:boolean ;
       rdfs:label "final"@en ;
       <http://www.w3.org/2004/02/skos/core#definition> "[OntoGSN] Determines whether this is the delivered version of the argument or pattern, in which no element remains uninstantiated or undeveloped."@en ;
       :coreOrExtension "Argument Pattern Extension"@en .


###  https://w3id.org/OntoGSN/ontology#inDoubt
:inDoubt rdf:type owl:DatatypeProperty ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( :AssuranceCase
                                     :GSNElement
                                     :Relationship
                                   )
                     ] ;
         rdfs:range xsd:boolean ;
         rdfs:label "in doubt"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "The dialectic challenge within this structure asserts that if the claim presented in Goal CG1 is true then this is sufficient to establish that the claim in Goal G1 in the original structure is in doubt."@en ;
         :coreOrExtension "Dialectic Extension"@en .


###  https://w3id.org/OntoGSN/ontology#maxCardinality
:maxCardinality rdf:type owl:DatatypeProperty ;
                rdfs:domain :Relationship ;
                rdfs:range xsd:nonNegativeInteger ;
                rdfs:label "maximum cardinality"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "[OntoGSN] The upper bound on how many instances of the related element this relationship stands for."@en ;
                :coreOrExtension "Argument Pattern Extension"@en ;
                :renderedAs "text" .


###  https://w3id.org/OntoGSN/ontology#minCardinality
:minCardinality rdf:type owl:DatatypeProperty ;
                rdfs:domain :Relationship ;
                rdfs:range xsd:nonNegativeInteger ;
                rdfs:label "minimum cardinality"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "[OntoGSN] The lower bound on how many instances of the related element this relationship stands for."@en ;
                :coreOrExtension "Argument Pattern Extension"@en ;
                :renderedAs "text" .


###  https://w3id.org/OntoGSN/ontology#multiple
:multiple rdf:type owl:DatatypeProperty ;
          rdfs:domain :Relationship ;
          rdfs:range xsd:boolean ;
          rdfs:label "multiple"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "[OntoGSN] Determines whether the relationship stands for multiple instantiations rather than a single one."@en ;
          :coreOrExtension "Argument Pattern Extension"@en ;
          :renderedAs "solid ball" .


###  https://w3id.org/OntoGSN/ontology#offDiagram
:offDiagram rdf:type owl:DatatypeProperty ;
            rdfs:domain :GSNElement ;
            rdfs:range xsd:boolean ;
            rdfs:label "off-diagram"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "[OntoGSN] Determines whether the argument at this element continues in, or is a continuation from, a separate diagram."@en ;
            :coreOrExtension "Core GSN"@en .


###  https://w3id.org/OntoGSN/ontology#optional
:optional rdf:type owl:DatatypeProperty ;
          rdfs:domain :Relationship ;
          rdfs:range xsd:boolean ;
          rdfs:label "optional"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "Optional instantiation means that the relationship and the argument below may or may not be instantiated."@en ;
          :coreOrExtension "Argument Pattern Extension"@en ;
          :renderedAs "hollow ball"@en .


###  https://w3id.org/OntoGSN/ontology#public
:public rdf:type owl:DatatypeProperty ;
        rdfs:domain [ rdf:type owl:Class ;
                      owl:unionOf ( :Assumption
                                    :Context
                                    :Goal
                                    :Justification
                                    :Solution
                                  )
                    ] ;
        rdfs:range xsd:boolean ;
        rdfs:label "public"@en ;
        <http://www.w3.org/2004/02/skos/core#definition> "This indicates that the element is publicly visible in one or more interfaces of the module and can be referenced as an away element."@en ;
        :coreOrExtension "Modular Extension"@en ;
        :renderedAs "miniature module symbol superimposed on an element at the top right" .


###  https://w3id.org/OntoGSN/ontology#published
:published rdf:type owl:DatatypeProperty ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( :Argument
                                       :Pattern
                                     )
                       ] ;
           rdfs:range xsd:boolean ;
           rdfs:label "published"@en ;
           <http://www.w3.org/2004/02/skos/core#definition> "[OntoGSN] Determines whether the argument or pattern is in its published form, in which the undeveloped decorator is not permitted."@en ;
           :coreOrExtension "Argument Pattern Extension"@en .


###  https://w3id.org/OntoGSN/ontology#relationshipType
:relationshipType rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Relationship ;
                  rdfs:range [ rdf:type rdfs:Datatype ;
                               owl:oneOf [ rdf:type rdf:List ;
                                           rdf:first "contextual" ;
                                           rdf:rest [ rdf:type rdf:List ;
                                                      rdf:first "dialectic" ;
                                                      rdf:rest [ rdf:type rdf:List ;
                                                                 rdf:first "evidential" ;
                                                                 rdf:rest [ rdf:type rdf:List ;
                                                                            rdf:first "inferential" ;
                                                                            rdf:rest rdf:nil
                                                                          ]
                                                               ]
                                                    ]
                                         ]
                             ] ;
                  rdfs:label "relationship type"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "An evidential relationship is a declared relationship between a claim and an evidence item by which the claim is substantiated. An inferential relationship is a declared inference between claims in the argument. A contextual relationship draws attention to explanatory contextual information."@en ,
                                                                   "SupportedBy relationships – represented by lines with solid arrowheads – indicate inferential or evidential relationships between elements. InContextOf relationships – represented as lines with hollow arrowheads – declare contextual relationships."@en ;
                  :coreOrExtension "Core GSN"@en .


###  https://w3id.org/OntoGSN/ontology#statement
:statement rdf:type owl:DatatypeProperty ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( :Argument
                                       :AssuranceCase
                                       :GSNElement
                                     )
                       ] ;
           rdfs:range xsd:string ;
           rdfs:label "statement"@en ;
           <http://www.w3.org/2004/02/skos/core#definition> "[OntoGSN] The text the element asserts, written to the grammatical rules the standard sets for GSN statements."@en ;
           :coreOrExtension "Core GSN"@en .


###  https://w3id.org/OntoGSN/ontology#structured
:structured rdf:type owl:DatatypeProperty ;
            rdfs:domain :Argument ;
            rdfs:range xsd:boolean ;
            rdfs:label "structured"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "A particular kind of argument where the relationships between the asserted claims, and from the evidence to the claims, are explicitly represented."@en ;
            :coreOrExtension "Core GSN"@en .


###  https://w3id.org/OntoGSN/ontology#toBeSupportedByContract
:toBeSupportedByContract rdf:type owl:DatatypeProperty ;
                         rdfs:domain :Goal ;
                         rdfs:range xsd:boolean ;
                         owl:propertyDisjointWith :undeveloped ;
                         rdfs:label "to be supported by contract"@en ;
                         <http://www.w3.org/2004/02/skos/core#definition> "Support for the claim presented by the attached goal is intended to be provided from an argument in another module linked by an as-yet-undisclosed contract."@en ;
                         :coreOrExtension "Modular Extension"@en ;
                         :renderedAs "attached centrally immediately below the goal to which it relates" .


###  https://w3id.org/OntoGSN/ontology#top
:top rdf:type owl:DatatypeProperty ;
     rdfs:domain :Goal ;
     rdfs:range xsd:boolean ;
     rdfs:label "top (goal)"@en ;
     <http://www.w3.org/2004/02/skos/core#definition> "A GSN Goal that presents the pinnacle claim in an argument. It is ‘top’ in terms of the argument hierarchy, rather than necessarily its physical layout. There may be more than one top goal in a GSN structure."@en ,
                                                      "The top goal presents the overall claim asserted by the author and it is up to the reader to determine their belief that it is adequately supported."@en ;
     :coreOrExtension "Core GSN"@en .


###  https://w3id.org/OntoGSN/ontology#true
:true rdf:type owl:DatatypeProperty ;
      rdfs:domain [ rdf:type owl:Class ;
                    owl:unionOf ( :GSNElement
                                  :Relationship
                                )
                  ] ;
      rdfs:range xsd:boolean ;
      rdfs:label "true"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "[OntoGSN] Marks whether the claim in the element or relationship is determined (e.g., by the auditor or some process) as correct or not."@en ;
      :coreOrExtension "Core GSN"@en .


###  https://w3id.org/OntoGSN/ontology#undeveloped
:undeveloped rdf:type owl:DatatypeProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :Goal
                                         :Relationship
                                         :Strategy
                                       )
                         ] ;
             rdfs:range xsd:boolean ;
             rdfs:label "undeveloped"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "Undeveloped element decorator, rendered as a hollow diamond applied to the bottom centre of an element, indicates that a line of argument has not been developed."@en ;
             :coreOrExtension "Argument Pattern Extension"@en ;
             :renderedAs "hollow diamond" .


###  https://w3id.org/OntoGSN/ontology#uninstantiated
:uninstantiated rdf:type owl:DatatypeProperty ;
                rdfs:domain :GSNElement ;
                rdfs:range xsd:boolean ;
                rdfs:label "uninstantiated"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "The attached element remains to be instantiated: at some later stage the abstract element needs to be replaced with a more concrete instance."@en ;
                :coreOrExtension "Argument Pattern Extension"@en ;
                :renderedAs "hollow triangle" .


###  https://w3id.org/OntoGSN/ontology#valid
:valid rdf:type owl:DatatypeProperty ;
       rdfs:domain [ rdf:type owl:Class ;
                     owl:unionOf ( :Argument
                                   :GSNElement
                                   :Pattern
                                   :Relationship
                                 )
                   ] ;
       rdfs:range xsd:boolean ;
       rdfs:label "valid"@en ;
       <http://www.w3.org/2004/02/skos/core#definition> "[OntoGSN] Marks whether the element is determined (e.g., by a rule or a manual evaluation) to be consistent with the argument, or otherwise correct with respect to the GSN argument syntax."@en ;
       :coreOrExtension "Core GSN"@en .


###  https://w3id.org/OntoGSN/ontology#viewType
:viewType rdf:type owl:DatatypeProperty ;
          rdfs:domain :View ;
          rdfs:range [ rdf:type rdfs:Datatype ;
                       owl:oneOf [ rdf:type rdf:List ;
                                   rdf:first "architecture" ;
                                   rdf:rest [ rdf:type rdf:List ;
                                              rdf:first "argument" ;
                                              rdf:rest rdf:nil
                                            ]
                                 ]
                     ] ;
          rdfs:label "view type"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "[OntoGSN] Determines whether the view shows the argument or the module architecture."@en ;
          :coreOrExtension "Modular Extension"@en .


#################################################################
#    Classes
#################################################################

###  http://www.w3.org/1999/02/22-rdf-syntax-ns#Statement
rdf:Statement rdf:type owl:Class .


###  https://w3id.org/OntoGSN/ontology#Argument
:Argument rdf:type owl:Class ;
          rdfs:subClassOf _:genid121 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :contains ;
                            owl:allValuesFrom [ rdf:type owl:Class ;
                                                owl:unionOf ( :GSNElement
                                                              :Pattern
                                                            )
                                              ]
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty <http://schema.org/identifier> ;
                            owl:someValuesFrom xsd:string
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty <http://schema.org/identifier> ;
                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onDataRange xsd:string
                          ] ;
          rdfs:label "Argument"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "A body of information presented with the intention to establish one or more claims through the presentation of related supporting claims, evidence and contextual information."@en ,
                                                           "A connected series of claims intended to establish an overall claim."@en ;
          :coreOrExtension "Core GSN"@en .

_:genid121 rdf:type owl:Class ;
            owl:unionOf ( [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                   owl:onProperty :contains ;
                                                   owl:someValuesFrom :ArtefactReference
                                                 ]
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty :contains ;
                                                   owl:someValuesFrom :Goal
                                                 ]
                                               ) ;
                            rdf:type owl:Class
                          ]
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :statement ;
                            owl:someValuesFrom xsd:string
                          ]
                        ) .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Argument ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid121 ;
   <http://www.w3.org/2004/02/skos/core#definition> "The corresponding argument could be located in a paragraph of accompanying text, a goal in the local argument, or a goal in a separate module."@en ;
   :coreOrExtension "Confidence Argument Extension"
 ] .


###  https://w3id.org/OntoGSN/ontology#Artefact
:Artefact rdf:type owl:Class ;
          rdfs:label "Artefact"@en ;
          <http://www.w3.org/2004/02/skos/core#altLabel> "Evidence"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "[OntoGSN] Information or objective artefacts (e.g., files) being offered in support or context of one or more claims."@en ;
          :coreOrExtension "Core GSN"@en .


###  https://w3id.org/OntoGSN/ontology#ArtefactReference
:ArtefactReference rdf:type owl:Class ;
                   rdfs:subClassOf :GSNElement ;
                   rdfs:label "Artefact Reference"@en ;
                   <http://www.w3.org/2004/02/skos/core#definition> "[OntoGSN] An element that makes no claim of its own and instead points at an artefact, such as a solution or a context expressed as a noun phrase."@en ;
                   :coreOrExtension "Core GSN"@en .


###  https://w3id.org/OntoGSN/ontology#Assumption
:Assumption rdf:type owl:Class ;
            rdfs:subClassOf :GSNElement ,
                            _:genid137 ;
            rdfs:label "Assumption"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "An assumption, rendered as an oval with the letter 'A' at the top- or bottom-right, presents an intentionally unsubstantiated statement."@en ;
            :coreOrExtension "Core GSN"@en ;
            :renderedAs "oval"@en .

_:genid137 rdf:type owl:Restriction ;
            owl:onProperty :statement ;
            owl:someValuesFrom xsd:string .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Assumption ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid137 ;
   <http://www.w3.org/2004/02/skos/core#definition> "GSN assumptions provide additional information necessary for the correct understanding of the argument. This information is stated as fully as necessary, using complete sentences in the form noun phrase + verb phrase."@en
 ] .


###  https://w3id.org/OntoGSN/ontology#AssuranceCase
:AssuranceCase rdf:type owl:Class ;
               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                 owl:onProperty :contains ;
                                 owl:someValuesFrom :Argument
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :contains ;
                                 owl:someValuesFrom :Artefact
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :contains ;
                                 owl:allValuesFrom [ rdf:type owl:Class ;
                                                     owl:unionOf ( :Argument
                                                                   :Artefact
                                                                 )
                                                   ]
                               ] ;
               rdfs:label "Assurance Case"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "A reasoned and compelling argument, supported by a body of evidence, that a system, service or organisation will operate as intended for a defined application in a defined environment."@en ,
                                                                "Arguments and evidence intended to demonstrate that a system meets its assurance requirements."@en ;
               :coreOrExtension "Core GSN"@en .


###  https://w3id.org/OntoGSN/ontology#Catalogue
:Catalogue rdf:type owl:Class ;
           rdfs:subClassOf [ rdf:type owl:Restriction ;
                             owl:onProperty :contains ;
                             owl:allValuesFrom :Pattern
                           ] ;
           rdfs:label "Catalogue"@en ;
           <http://www.w3.org/2004/02/skos/core#definition> "A pattern catalogue may be created to collate a series of patterns; where such a catalogue is created the structure and format of the definition should be consistent and each pattern’s definition should have a unique {pattern identifier}."@en ;
           :coreOrExtension "Argument Pattern Extension"@en .


###  https://w3id.org/OntoGSN/ontology#Context
:Context rdf:type owl:Class ;
         rdfs:subClassOf :ArtefactReference ,
                         _:genid146 ;
         rdfs:label "Context"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "A context, rendered as shown left, presents a contextual artefact. This can be a reference to contextual information, or a statement."@en ;
         :coreOrExtension "Core GSN"@en ;
         :renderedAs "rounded rectangle"@en .

_:genid146 rdf:type owl:Restriction ;
            owl:onProperty :statement ;
            owl:someValuesFrom xsd:string .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Context ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid146 ;
   <http://www.w3.org/2004/02/skos/core#definition> "Two kinds of GSN context statement exist. Where a context statement draws attention to explanatory contextual information (such as the definition of some term), this information shall be stated briefly using complete sentences of a noun-phrase + verb-phrase structure. Where a context statement is a reference to an artefact of some kind, which informs the reasoning step, the context statement shall be expressed as a noun phrase."@en
 ] .


###  https://w3id.org/OntoGSN/ontology#Defeater
:Defeater rdf:type owl:Class ;
          rdfs:subClassOf [ rdf:type owl:Class ;
                            owl:unionOf ( :Goal
                                          :Solution
                                        )
                          ] ;
          rdfs:label "Defeater"@en ;
          <http://www.w3.org/2004/02/skos/core#altLabel> "Dialectic Element"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "The source of challenge being applied; can be directed at any part of an argument. A defeater (goal or solution) can challenge any element in a goal structure, e.g. goal, solution, strategy, context, assumption, justification." ;
          <http://www.w3.org/2004/02/skos/core#note> "Membership of this class is only meant to be inferred, not asserted! Please do not add individuals to this class manually (i.e., assertions)."@en ,
                                                     "The goal and solution statements should be clearly expressed such that the crux of the challenge is unequivocally communicated. Thus, the link between the part of the argument that is being challenged (target) and the dialectic element (source) is self-evident."@en ;
          :coreOrExtension "Dialectic Extension"@en .


###  https://w3id.org/OntoGSN/ontology#GSNElement
:GSNElement rdf:type owl:Class ;
            rdfs:subClassOf [ rdf:type owl:Restriction ;
                              owl:onProperty <http://schema.org/identifier> ;
                              owl:someValuesFrom xsd:string
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty <http://schema.org/identifier> ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onDataRange xsd:string
                            ] ;
            rdfs:label "GSN Element"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "Goals, solutions, strategies, contexts, assumptions and justifications form the principal elements of GSN."@en ;
            :coreOrExtension "Core GSN"@en .


###  https://w3id.org/OntoGSN/ontology#Goal
:Goal rdf:type owl:Class ;
      rdfs:subClassOf :GSNElement ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :inContextOf ;
                        owl:someValuesFrom :Context
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :challenges ;
                        owl:allValuesFrom [ rdf:type owl:Class ;
                                            owl:unionOf ( :GSNElement
                                                          :Relationship
                                                        )
                                          ]
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :inContextOf ;
                        owl:allValuesFrom [ rdf:type owl:Class ;
                                            owl:unionOf ( :Assumption
                                                          :Context
                                                          :Justification
                                                          :Module
                                                        )
                                          ]
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :supportedBy ;
                        owl:allValuesFrom [ rdf:type owl:Class ;
                                            owl:unionOf ( :Goal
                                                          :Module
                                                          :Solution
                                                          :Strategy
                                                        )
                                          ]
                      ] ,
                      _:genid170 ;
      rdfs:label "Goal"@en ;
      <http://www.w3.org/2004/02/skos/core#altLabel> "Claim"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "(Claim is) A proposition being asserted by the author that is a true or false statement."@en ,
                                                       "A goal, rendered as a rectangle, presents a claim forming part of the argument."@en ;
      :coreOrExtension "Core GSN"@en ;
      :renderedAs "rectangle"@en .

_:genid170 rdf:type owl:Restriction ;
            owl:onProperty :statement ;
            owl:someValuesFrom xsd:string .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Goal ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid170 ;
   <http://www.w3.org/2004/02/skos/core#definition> "GSN goals document the claims made in the argument (i.e. premises and conclusions). Each goal shall contain a single goal statement, expressed as a proposition in the form of a noun phrase + verb-phrase sentence."@en
 ] .


###  https://w3id.org/OntoGSN/ontology#InstantiationDataReference
:InstantiationDataReference rdf:type owl:Class ;
                            rdfs:label "Instantiation Data Reference"@en ;
                            <http://www.w3.org/2004/02/skos/core#definition> "This symbol indicates that the GSN argument below the attached element is to be instantiated as a template argument. It provides a reference to the information used to instantiate the template argument." ;
                            :coreOrExtension "Argument Pattern Extension"@en ;
                            :renderedAs "hollow triangle" .


###  https://w3id.org/OntoGSN/ontology#Justification
:Justification rdf:type owl:Class ;
               rdfs:subClassOf :GSNElement ,
                               _:genid172 ;
               rdfs:label "Justification"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "A justification, rendered as an oval with the letter 'J' at the top- or bottom-right, presents a statement of rationale."@en ;
               :coreOrExtension "Core GSN"@en ;
               :renderedAs "oval"@en .

_:genid172 rdf:type owl:Restriction ;
            owl:onProperty :statement ;
            owl:someValuesFrom xsd:string .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Justification ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid172 ;
   <http://www.w3.org/2004/02/skos/core#definition> "GSN justifications provide additional information necessary for the correct understanding of the argument. This information is stated as fully as necessary, using complete sentences in the form noun phrase + verb phrase."@en
 ] .


###  https://w3id.org/OntoGSN/ontology#Module
:Module rdf:type owl:Class ;
        rdfs:subClassOf :GSNElement ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :contains ;
                          owl:allValuesFrom [ rdf:type owl:Class ;
                                              owl:unionOf ( :Argument
                                                            :Module
                                                          )
                                            ]
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :inContextOf ;
                          owl:allValuesFrom :Module
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :supportedBy ;
                          owl:allValuesFrom :Module
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :contains ;
                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :Argument
                        ] ;
        rdfs:label "Module"@en ;
        <http://www.w3.org/2004/02/skos/core#definition> "Goal structures can be partitioned into separate, but interrelated, modules. This can allow the division of an overall goal structure into separate goal structures focusing on particular aspects of the overall argument. A module may contain one or more arguments and may contain other modules."@en ;
        :coreOrExtension "Modular Extension"@en ;
        :renderedAs "a rectangle with a second smaller rectangle adjoining at the top left" .


###  https://w3id.org/OntoGSN/ontology#Pattern
:Pattern rdf:type owl:Class ;
         rdfs:subClassOf [ rdf:type owl:Restriction ;
                           owl:onProperty <http://schema.org/description> ;
                           owl:someValuesFrom rdfs:Literal
                         ] ;
         rdfs:label "Pattern"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "[OntoGSN] A reusable argument structure, accompanied by a description that defines its intent and the constraints on its use, from which concrete arguments are instantiated."@en ;
         :coreOrExtension "Argument Pattern Extension"@en .


###  https://w3id.org/OntoGSN/ontology#Relationship
:Relationship rdf:type owl:Class ;
              rdfs:subClassOf rdf:Statement ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty rdf:object ;
                                owl:allValuesFrom [ rdf:type owl:Class ;
                                                    owl:unionOf ( :GSNElement
                                                                  :Relationship
                                                                )
                                                  ]
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty rdf:subject ;
                                owl:allValuesFrom [ rdf:type owl:Class ;
                                                    owl:unionOf ( :Defeater
                                                                  :Goal
                                                                  :Module
                                                                  :Pattern
                                                                  :Strategy
                                                                )
                                                  ]
                              ] ;
              rdfs:label "Relationship"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "[OntoGSN] A link between GSN elements treated as an individual in its own right, carrying its subject, object and type, so that the link itself can be decorated and described."@en ;
              :coreOrExtension "Core GSN"@en .


###  https://w3id.org/OntoGSN/ontology#RelationshipWithConfidence
:RelationshipWithConfidence rdf:type owl:Class ;
                            rdfs:subClassOf :Relationship ,
                                            [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                     owl:onProperty :associatedWith ;
                                                                     owl:someValuesFrom :Argument
                                                                   ]
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty :assuranceClaimPoint ;
                                                                     owl:someValuesFrom xsd:boolean
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty rdf:object ;
                                              owl:allValuesFrom [ rdf:type owl:Class ;
                                                                  owl:unionOf ( :Context
                                                                                :Goal
                                                                                :Solution
                                                                                :Strategy
                                                                              )
                                                                ]
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty :associatedWith ;
                                              owl:allValuesFrom [ owl:intersectionOf ( :Argument
                                                                                       [ rdf:type owl:Restriction ;
                                                                                         owl:onProperty :argumentType ;
                                                                                         owl:hasValue "confidence"
                                                                                       ]
                                                                                     ) ;
                                                                  rdf:type owl:Class
                                                                ]
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty <http://schema.org/identifier> ;
                                              owl:someValuesFrom xsd:string
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty <http://schema.org/identifier> ;
                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:string
                                            ] ;
                            rdfs:label "Relationship with Confidence"@en ;
                            <http://www.w3.org/2004/02/skos/core#definition> "[OntoGSN] A relationship carrying an assurance claim point, whose associated confidence argument documents the reasons for having confidence in the relationship between two elements."@en ;
                            <http://www.w3.org/2004/02/skos/core#note> "The corresponding argument could be located in a paragraph of accompanying text, a goal in the local argument, or a goal in a separate module."@en ;
                            :coreOrExtension "Confidence Argument Extension"@en .


###  https://w3id.org/OntoGSN/ontology#Solution
:Solution rdf:type owl:Class ;
          rdfs:subClassOf :ArtefactReference ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :challenges ;
                            owl:allValuesFrom [ rdf:type owl:Class ;
                                                owl:unionOf ( :GSNElement
                                                              :Relationship
                                                            )
                                              ]
                          ] ,
                          _:genid215 ;
          rdfs:label "Solution"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "A solution, rendered as a circle, presents a reference to an evidence item."@en ;
          :coreOrExtension "Core GSN"@en ;
          :renderedAs "circle"@en .

_:genid215 rdf:type owl:Restriction ;
            owl:onProperty :statement ;
            owl:someValuesFrom xsd:string .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Solution ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid215 ;
   <http://www.w3.org/2004/02/skos/core#definition> "GSN solutions make no claim, but are simply references to evidence items that provide support for a particular claim. They shall therefore be stated as noun-phrases."@en
 ] .


###  https://w3id.org/OntoGSN/ontology#Strategy
:Strategy rdf:type owl:Class ;
          rdfs:subClassOf :GSNElement ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :inContextOf ;
                            owl:allValuesFrom [ rdf:type owl:Class ;
                                                owl:unionOf ( :Assumption
                                                              :Context
                                                              :Justification
                                                              :Module
                                                            )
                                              ]
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :supportedBy ;
                            owl:allValuesFrom :Goal
                          ] ,
                          _:genid224 ;
          rdfs:label "Strategy"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "A strategy, rendered as a parallelogram, describes the inference that exists between a goal and its supporting goal(s)."@en ;
          :coreOrExtension "Core GSN"@en ;
          :renderedAs "parallelogram"@en .

_:genid224 rdf:type owl:Restriction ;
            owl:onProperty :statement ;
            owl:someValuesFrom xsd:string .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Strategy ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid224 ;
   <http://www.w3.org/2004/02/skos/core#definition> "GSN strategy statements describe the reasoning that connects parent goals and their supporting goals, but the core claims and the structure connecting those claims remain unchanged. Strategy statements contain a brief description of the argument approach."@en
 ] .


###  https://w3id.org/OntoGSN/ontology#Template
:Template rdf:type owl:Class ;
          rdfs:subClassOf :Pattern ;
          rdfs:label "Template"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "A template argument is a special case of a pattern argument. It uses the core GSN and argument pattern extension to construct an argument structure which requires no further development."@en ;
          :coreOrExtension "Argument Pattern Extension"@en .


###  https://w3id.org/OntoGSN/ontology#View
:View rdf:type owl:Class ;
      rdfs:label "View"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "The argument view depicts the argument inside an individual module."@en ;
      :coreOrExtension "Modular Extension"@en .


[ :coreOrExtension "Core GSN"@en
] .

#################################################################
#    General axioms
#################################################################

[ owl:intersectionOf ( :Goal
                        [ rdf:type owl:Class ;
                          owl:complementOf [ rdf:type owl:Restriction ;
                                             owl:onProperty :challenges ;
                                             owl:someValuesFrom owl:Thing
                                           ]
                        ]
                        [ rdf:type owl:Class ;
                          owl:complementOf [ rdf:type owl:Restriction ;
                                             owl:onProperty [ owl:inverseOf :supportedBy
                                                            ] ;
                                             owl:someValuesFrom [ rdf:type owl:Class ;
                                                                  owl:unionOf ( :Goal
                                                                                :Strategy
                                                                              )
                                                                ]
                                           ]
                        ]
                      ) ;
   rdf:type owl:Class ;
   rdfs:subClassOf [ rdf:type owl:Restriction ;
                     owl:onProperty :top ;
                     owl:hasValue "true"^^xsd:boolean
                   ]
 ] .


#################################################################
#    Rules
#################################################################

<https://w3id.org/OntoGSN/swrl#A> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://w3id.org/OntoGSN/swrl#B> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://w3id.org/OntoGSN/swrl#R> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://w3id.org/OntoGSN/swrl#M> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://w3id.org/OntoGSN/swrl#Arg> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://w3id.org/OntoGSN/swrl#E> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://w3id.org/OntoGSN/swrl#N> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://w3id.org/OntoGSN/swrl#M1> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://w3id.org/OntoGSN/swrl#M2> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://w3id.org/OntoGSN/swrl#E1> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://w3id.org/OntoGSN/swrl#E2> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://w3id.org/OntoGSN/swrl#C> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://w3id.org/OntoGSN/swrl#D> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://w3id.org/OntoGSN/swrl#G3> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://w3id.org/OntoGSN/swrl#G1> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://w3id.org/OntoGSN/swrl#S> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://w3id.org/OntoGSN/swrl#G2> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://w3id.org/OntoGSN/swrl#G> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://w3id.org/OntoGSN/swrl#J> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://w3id.org/OntoGSN/swrl#S2> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://w3id.org/OntoGSN/swrl#S1> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://w3id.org/OntoGSN/swrl#R1> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://w3id.org/OntoGSN/swrl#R2> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://w3id.org/OntoGSN/swrl#C1> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://w3id.org/OntoGSN/swrl#C2> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://w3id.org/OntoGSN/swrl#ID> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://w3id.org/OntoGSN/swrl#X> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:label "Defeated Invalidation" ;
   :coreOrExtension "Dialectic Extension" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> :defeated ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> <https://w3id.org/OntoGSN/swrl#E> ;
                                                       <http://www.w3.org/2003/11/swrl#argument2> "true"^^xsd:boolean
                                                     ] ;
                                           rdf:rest rdf:nil
                                         ] ;
   <http://www.w3.org/2003/11/swrl#head> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> :valid ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> <https://w3id.org/OntoGSN/swrl#E> ;
                                                       <http://www.w3.org/2003/11/swrl#argument2> "false"^^xsd:boolean
                                                     ] ;
                                           rdf:rest rdf:nil
                                         ]
 ] .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:label "Undeveloped Defeat" ;
   :coreOrExtension "Dialectic Extension" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> :undeveloped ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> <https://w3id.org/OntoGSN/swrl#G> ;
                                                       <http://www.w3.org/2003/11/swrl#argument2> "false"^^xsd:boolean
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#propertyPredicate> :challenges ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> <https://w3id.org/OntoGSN/swrl#G> ;
                                                                  <http://www.w3.org/2003/11/swrl#argument2> <https://w3id.org/OntoGSN/swrl#E>
                                                                ] ;
                                                      rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                 rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                                             <http://www.w3.org/2003/11/swrl#classPredicate> :Goal ;
                                                                             <http://www.w3.org/2003/11/swrl#argument1> <https://w3id.org/OntoGSN/swrl#G>
                                                                           ] ;
                                                                 rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                            rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom> ;
                                                                                        <http://www.w3.org/2003/11/swrl#propertyPredicate> :inDoubt ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument1> <https://w3id.org/OntoGSN/swrl#E> ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument2> "true"^^xsd:boolean
                                                                                      ] ;
                                                                            rdf:rest rdf:nil
                                                                          ]
                                                               ]
                                                    ]
                                         ] ;
   <http://www.w3.org/2003/11/swrl#head> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> :defeated ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> <https://w3id.org/OntoGSN/swrl#E> ;
                                                       <http://www.w3.org/2003/11/swrl#argument2> "true"^^xsd:boolean
                                                     ] ;
                                           rdf:rest rdf:nil
                                         ]
 ] .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:label "Public Context Propagation" ;
   :coreOrExtension "Modular Extension" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> :public ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> <https://w3id.org/OntoGSN/swrl#G> ;
                                                       <http://www.w3.org/2003/11/swrl#argument2> "true"^^xsd:boolean
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#propertyPredicate> :inContextOf ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> <https://w3id.org/OntoGSN/swrl#G> ;
                                                                  <http://www.w3.org/2003/11/swrl#argument2> <https://w3id.org/OntoGSN/swrl#C>
                                                                ] ;
                                                      rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                 rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                                             <http://www.w3.org/2003/11/swrl#classPredicate> :Goal ;
                                                                             <http://www.w3.org/2003/11/swrl#argument1> <https://w3id.org/OntoGSN/swrl#G>
                                                                           ] ;
                                                                 rdf:rest rdf:nil
                                                               ]
                                                    ]
                                         ] ;
   <http://www.w3.org/2003/11/swrl#head> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> :public ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> <https://w3id.org/OntoGSN/swrl#C> ;
                                                       <http://www.w3.org/2003/11/swrl#argument2> "true"^^xsd:boolean
                                                     ] ;
                                           rdf:rest rdf:nil
                                         ]
 ] .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:label "Relation False Propagation" ;
   :coreOrExtension "Core GSN" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
