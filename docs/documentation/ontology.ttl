@prefix : <https://w3id.org/OntoGSN/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/OntoGSN/ontology#> .

<https://w3id.org/OntoGSN/ontology> rdf:type owl:Ontology ;
                                     owl:versionIRI <https://w3id.org/OntoGSN/ontology/1.3.0> ;
                                     <http://creativecommons.org/ns#license> <https://creativecommons.org/licenses/by/4.0/> ;
                                     <http://purl.org/dc/elements/1.1/contributor> "Barbara Gallina"@en ,
                                                                                   "Dian Balta"@en ,
                                                                                   "Ingmar Kessler"@en ,
                                                                                   "Jule Hendricks"@en ;
                                     <http://purl.org/dc/elements/1.1/creator> "Tomas Bueno Momčilović"@en ;
                                     <http://purl.org/dc/elements/1.1/description> "OntoGSN is an ontology for managing assurance cases in the Goal Structuring Notation (GSN). The goal of the ontology is to help users in linking the elements of their cases - claims and evidence - with the internationalized resource identifiers (IRIs) of represented concepts, events and data, and in evaluating the validity of their argument."@en ;
                                     <http://purl.org/dc/elements/1.1/publisher> _:genid1 ;
                                     <http://purl.org/dc/elements/1.1/source> <https://scsc.uk/SCSC-141C> ;
                                     <http://purl.org/dc/elements/1.1/title> "OntoGSN"@en ;
                                     <http://purl.org/dc/terms/bibliographicCitation> "Bueno Momčilović, T. (2026). OntoGSN (Version 1.3.0) [Ontology]. https://doi.org/10.5281/zenodo.17808330" ;
                                     <http://purl.org/dc/terms/created> "2025-02-20"^^xsd:date ;
                                     <http://purl.org/dc/terms/issued> "2026-11-05"^^xsd:date ;
                                     <http://purl.org/dc/terms/modified> "2026-11-05"^^xsd:date ;
                                     <http://purl.org/ontology/bibo/doi> "10.5281/zenodo.17808330" ;
                                     <http://purl.org/ontology/bibo/status> <http://purl.org/ontology/bibo/status/published> ;
                                     <http://purl.org/vocab/vann/preferredNamespacePrefix> "gsn" ;
                                     <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/OntoGSN/ontology#" ;
                                     <http://schema.org/disclaimer> "[Disclaimer from the GSN Community Standard v3.0]: While the authors and the publishers have used reasonable endeavours to ensure that the information and guidance given in this work is correct, all parties must rely on their own skill and judgement when making use of this work and obtain professional or specialist advice before taking, or refraining from, any action on the basis of the content of this work. Neither the authors nor the publishers make any representations or warranties of any kind, express or implied, about the completeness, accuracy, reliability, suitability or availability with respect to such information and guidance for any purpose, and they will not be liable for any loss or damage including without limitation, indirect or consequential loss or damage, or any loss or damage whatsoever (including as a result of negligence) arising out of, or in connection with, the use of this work. The views and opinions expressed in this publication are those of the authors and do not necessarily reflect those of their employers, the SCSC1 or other organisations."@en ;
                                     <http://schema.org/includedInDataCatalog> <https://zenodo.org/> ;
                                     <http://schema.org/logo> <https://fortiss.github.io/OntoGSN/assets/images/ontogsn-banner.png> ;
                                     <http://schema.org/url> "https://w3id.org/OntoGSN/"^^xsd:anyURI ;
                                     rdfs:seeAlso <https://doi.org/10.48550/arXiv.2506.11023> ;
                                     owl:priorVersion <https://w3id.org/OntoGSN/ontology/1.2.3> ;
                                     owl:versionInfo "1.3.0" ;
                                     <http://www.w3.org/2004/02/skos/core#definition> "GSN is a graphical argument notation which can be used to document explicitly the elements and structure of an argument and the argument’s relationship to evidence."@en ;
                                     <http://www.w3.org/2004/02/skos/core#scopeNote> "A definition prefixed [OntoGSN] is this ontology’s wording, not the GSN Community Standard’s. Every definition, tagged or not, has a record in the design record under development/design/ naming the passage it rests on, or stating that it rests on none."@en .

_:genid1 <http://schema.org/name> "fortiss GmbH" ;
          <http://schema.org/url> <https://www.fortiss.org/> .

