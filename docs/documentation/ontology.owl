        <swrl:classPredicate rdf:resource="https://w3id.org/OntoGSN/ontology#Context"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid223">
        <swrl:argument1 rdf:resource="https://w3id.org/OntoGSN/swrl#G"/>
        <swrl:classPredicate rdf:resource="https://w3id.org/OntoGSN/ontology#Goal"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid224">
        <swrl:argument1 rdf:resource="https://w3id.org/OntoGSN/swrl#C1"/>
        <swrl:argument2 rdf:resource="https://w3id.org/OntoGSN/swrl#C2"/>
        <swrl:propertyPredicate rdf:resource="https://w3id.org/OntoGSN/ontology#consistentWith"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid225">
        <swrl:argument1 rdf:resource="https://w3id.org/OntoGSN/swrl#E"/>
        <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2>
        <swrl:propertyPredicate rdf:resource="https://w3id.org/OntoGSN/ontology#inDoubt"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid226">
