        <swrl:argument2 rdf:resource="https://w3id.org/OntoGSN/swrl#A"/>
        <swrl:propertyPredicate rdf:resource="https://w3id.org/OntoGSN/ontology#supportedBy"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid218">
        <swrl:argument1 rdf:resource="https://w3id.org/OntoGSN/swrl#A"/>
        <swrl:classPredicate rdf:resource="https://w3id.org/OntoGSN/ontology#Goal"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid219">
        <swrl:argument1 rdf:resource="https://w3id.org/OntoGSN/swrl#B"/>
        <swrl:classPredicate rdf:resource="https://w3id.org/OntoGSN/ontology#Goal"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid220">
        <swrl:argument1 rdf:resource="https://w3id.org/OntoGSN/swrl#C"/>
        <swrl:argument2 rdf:resource="https://w3id.org/OntoGSN/swrl#B"/>
        <swrl:propertyPredicate rdf:resource="https://w3id.org/OntoGSN/ontology#supportedBy"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid221">
        <swrl:argument1 rdf:resource="https://w3id.org/OntoGSN/swrl#A"/>
        <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2>
        <swrl:propertyPredicate rdf:resource="https://w3id.org/OntoGSN/ontology#true"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid222">
