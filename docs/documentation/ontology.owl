        <swrl:propertyPredicate rdf:resource="https://w3id.org/OntoGSN/ontology#true"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid227">
        <swrl:argument1 rdf:resource="https://w3id.org/OntoGSN/swrl#E"/>
        <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2>
        <swrl:propertyPredicate rdf:resource="https://w3id.org/OntoGSN/ontology#defeated"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid228">
        <swrl:argument1 rdf:resource="https://w3id.org/OntoGSN/swrl#B"/>
        <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</swrl:argument2>
        <swrl:propertyPredicate rdf:resource="https://w3id.org/OntoGSN/ontology#true"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid229">
        <swrl:argument1 rdf:resource="https://w3id.org/OntoGSN/swrl#G"/>
        <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</swrl:argument2>
        <swrl:propertyPredicate rdf:resource="https://w3id.org/OntoGSN/ontology#undeveloped"/>
    </rdf:Description>
