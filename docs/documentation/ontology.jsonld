  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#View"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "view type"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid118"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "[OntoGSN] Determines whether the view shows the argument or the module architecture."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Modular Extension"
  } ]
