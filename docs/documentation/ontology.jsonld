  } ],
  "http://purl.org/dc/elements/1.1/description" : [ {
    "@language" : "en",
    "@value" : "OntoGSN is an ontology for managing assurance cases in the Goal Structuring Notation (GSN). The goal of the ontology is to help users in linking the elements of their cases - claims and evidence - with the internationalized resource identifiers (IRIs) of represented concepts, events and data, and in evaluating the validity of their argument."
  } ],
  "http://purl.org/dc/elements/1.1/publisher" : [ {
    "@id" : "_:genid1"
  } ],
  "http://purl.org/dc/elements/1.1/source" : [ {
    "@id" : "https://scsc.uk/SCSC-141C"
  } ],
  "http://purl.org/dc/elements/1.1/title" : [ {
    "@language" : "en",
    "@value" : "OntoGSN"
  } ],
  "http://purl.org/dc/terms/bibliographicCitation" : [ {
    "@value" : "Bueno Momčilović, T. (2026). OntoGSN (Version 1.4.0) [Ontology]. https://doi.org/10.5281/zenodo.17808330"
  } ],
