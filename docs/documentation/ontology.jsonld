  } ],
  "http://schema.org/disclaimer" : [ {
    "@language" : "en",
    "@value" : "[Disclaimer from the GSN Community Standard v3.0]: While the authors and the publishers have used reasonable endeavours to ensure that the information and guidance given in this work is correct, all parties must rely on their own skill and judgement when making use of this work and obtain professional or specialist advice before taking, or refraining from, any action on the basis of the content of this work. Neither the authors nor the publishers make any representations or warranties of any kind, express or implied, about the completeness, accuracy, reliability, suitability or availability with respect to such information and guidance for any purpose, and they will not be liable for any loss or damage including without limitation, indirect or consequential loss or damage, or any loss or damage whatsoever (including as a result of negligence) arising out of, or in connection with, the use of this work. The views and opinions expressed in this publication are those of the authors and do not necessarily reflect those of their employers, the SCSC1 or other organisations."
  } ],
  "http://schema.org/includedInDataCatalog" : [ {
    "@id" : "https://zenodo.org/"
  } ],
  "http://schema.org/logo" : [ {
    "@id" : "https://fortiss.github.io/OntoGSN/assets/images/ontogsn-banner.png"
  } ],
  "http://schema.org/url" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value" : "https://w3id.org/OntoGSN/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "https://doi.org/10.48550/arXiv.2506.11023"
  } ],
  "http://www.w3.org/2002/07/owl#priorVersion" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology/1.2.3"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology/1.3.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "1.3.0"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "GSN is a graphical argument notation which can be used to document explicitly the elements and structure of an argument and the argument’s relationship to evidence."
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "A definition prefixed [OntoGSN] is this ontology’s wording, not the GSN Community Standard’s. Every definition, tagged or not, has a record in the design record under development/design/ naming the passage it rests on, or stating that it rests on none."
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#Argument",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Argument"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid121"
  }, {
    "@id" : "_:genid131"
  }, {
    "@id" : "_:genid135"
  }, {
    "@id" : "_:genid136"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A body of information presented with the intention to establish one or more claims through the presentation of related supporting claims, evidence and contextual information."
  }, {
    "@language" : "en",
    "@value" : "A connected series of claims intended to establish an overall claim."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Core GSN"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#Artefact",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Artefact"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "Evidence"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "[OntoGSN] Information or objective artefacts (e.g., files) being offered in support or context of one or more claims."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Core GSN"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#ArtefactReference",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Artefact Reference"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#GSNElement"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "[OntoGSN] An element that makes no claim of its own and instead points at an artefact, such as a solution or a context expressed as a noun phrase."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Core GSN"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#Assumption",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Assumption"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#GSNElement"
  }, {
    "@id" : "_:genid137"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An assumption, rendered as an oval with the letter 'A' at the top- or bottom-right, presents an intentionally unsubstantiated statement."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Core GSN"
  } ],
  "https://w3id.org/OntoGSN/ontology#renderedAs" : [ {
    "@language" : "en",
    "@value" : "oval"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#AssuranceCase",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Assurance Case"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid139"
  }, {
    "@id" : "_:genid140"
  }, {
    "@id" : "_:genid141"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A reasoned and compelling argument, supported by a body of evidence, that a system, service or organisation will operate as intended for a defined application in a defined environment."
  }, {
    "@language" : "en",
    "@value" : "Arguments and evidence intended to demonstrate that a system meets its assurance requirements."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Core GSN"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#Catalogue",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Catalogue"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid145"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A pattern catalogue may be created to collate a series of patterns; where such a catalogue is created the structure and format of the definition should be consistent and each pattern’s definition should have a unique {pattern identifier}."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Argument Pattern Extension"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#Context",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Context"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#ArtefactReference"
  }, {
    "@id" : "_:genid146"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A context, rendered as shown left, presents a contextual artefact. This can be a reference to contextual information, or a statement."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Core GSN"
  } ],
  "https://w3id.org/OntoGSN/ontology#renderedAs" : [ {
    "@language" : "en",
    "@value" : "rounded rectangle"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#Defeater",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Defeater"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid148"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "Dialectic Element"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The source of challenge being applied; can be directed at any part of an argument. A defeater (goal or solution) can challenge any element in a goal structure, e.g. goal, solution, strategy, context, assumption, justification."
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "Membership of this class is only meant to be inferred, not asserted! Please do not add individuals to this class manually (i.e., assertions)."
  }, {
    "@language" : "en",
    "@value" : "The goal and solution statements should be clearly expressed such that the crux of the challenge is unequivocally communicated. Thus, the link between the part of the argument that is being challenged (target) and the dialectic element (source) is self-evident."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Dialectic Extension"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#GSNElement",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "GSN Element"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid151"
  }, {
    "@id" : "_:genid152"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Goals, solutions, strategies, contexts, assumptions and justifications form the principal elements of GSN."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Core GSN"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#Goal",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Goal"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#GSNElement"
  }, {
    "@id" : "_:genid153"
  }, {
    "@id" : "_:genid154"
  }, {
    "@id" : "_:genid158"
  }, {
    "@id" : "_:genid164"
  }, {
    "@id" : "_:genid170"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "Claim"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "(Claim is) A proposition being asserted by the author that is a true or false statement."
  }, {
    "@language" : "en",
    "@value" : "A goal, rendered as a rectangle, presents a claim forming part of the argument."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Core GSN"
  } ],
  "https://w3id.org/OntoGSN/ontology#renderedAs" : [ {
    "@language" : "en",
    "@value" : "rectangle"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#InstantiationDataReference",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Instantiation Data Reference"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "This symbol indicates that the GSN argument below the attached element is to be instantiated as a template argument. It provides a reference to the information used to instantiate the template argument."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Argument Pattern Extension"
  } ],
  "https://w3id.org/OntoGSN/ontology#renderedAs" : [ {
    "@value" : "hollow triangle"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#Justification",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Justification"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#GSNElement"
  }, {
    "@id" : "_:genid172"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A justification, rendered as an oval with the letter 'J' at the top- or bottom-right, presents a statement of rationale."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Core GSN"
  } ],
  "https://w3id.org/OntoGSN/ontology#renderedAs" : [ {
    "@language" : "en",
    "@value" : "oval"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#Module",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Module"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#GSNElement"
  }, {
    "@id" : "_:genid174"
  }, {
    "@id" : "_:genid178"
  }, {
    "@id" : "_:genid179"
  }, {
    "@id" : "_:genid180"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Goal structures can be partitioned into separate, but interrelated, modules. This can allow the division of an overall goal structure into separate goal structures focusing on particular aspects of the overall argument. A module may contain one or more arguments and may contain other modules."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Modular Extension"
  } ],
  "https://w3id.org/OntoGSN/ontology#renderedAs" : [ {
    "@value" : "a rectangle with a second smaller rectangle adjoining at the top left"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#Pattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Pattern"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid181"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "[OntoGSN] A reusable argument structure, accompanied by a description that defines its intent and the constraints on its use, from which concrete arguments are instantiated."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Argument Pattern Extension"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#Relationship",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Relationship"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#Statement"
  }, {
    "@id" : "_:genid182"
  }, {
    "@id" : "_:genid186"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "[OntoGSN] A link between GSN elements treated as an individual in its own right, carrying its subject, object and type, so that the link itself can be decorated and described."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Core GSN"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#RelationshipWithConfidence",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Relationship with Confidence"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#Relationship"
  }, {
    "@id" : "_:genid193"
  }, {
    "@id" : "_:genid198"
  }, {
    "@id" : "_:genid204"
  }, {
    "@id" : "_:genid209"
  }, {
    "@id" : "_:genid210"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "[OntoGSN] A relationship carrying an assurance claim point, whose associated confidence argument documents the reasons for having confidence in the relationship between two elements."
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "The corresponding argument could be located in a paragraph of accompanying text, a goal in the local argument, or a goal in a separate module."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Confidence Argument Extension"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#Solution",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Solution"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#ArtefactReference"
  }, {
    "@id" : "_:genid211"
  }, {
    "@id" : "_:genid215"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A solution, rendered as a circle, presents a reference to an evidence item."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Core GSN"
  } ],
  "https://w3id.org/OntoGSN/ontology#renderedAs" : [ {
    "@language" : "en",
    "@value" : "circle"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#Strategy",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Strategy"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#GSNElement"
  }, {
    "@id" : "_:genid217"
  }, {
    "@id" : "_:genid223"
  }, {
    "@id" : "_:genid224"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A strategy, rendered as a parallelogram, describes the inference that exists between a goal and its supporting goal(s)."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Core GSN"
  } ],
  "https://w3id.org/OntoGSN/ontology#renderedAs" : [ {
    "@language" : "en",
    "@value" : "parallelogram"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#Template",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Template"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#Pattern"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A template argument is a special case of a pattern argument. It uses the core GSN and argument pattern extension to construct an argument structure which requires no further development."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Argument Pattern Extension"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#View",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "View"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The argument view depicts the argument inside an individual module."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Modular Extension"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#applicability",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#Pattern"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "applicability"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The applicability section should state under what circumstances the pattern can be applied, making clear the assumptions and principles underlying the pattern to avoid inappropriate application in a mismatched context. This section should record what contextual information is required in order to apply the pattern."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Argument Pattern Extension"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#argumentType",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#Argument"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "argument type"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid65"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "[OntoGSN] Defines the kind of argument this is: a risk argument (i.e., the main content of assurance), a confidence argument for an assurance claim point, a compliance argument (undefined in the normative standard), or a dialectic argument."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Confidence Argument Extension"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#associatedWith",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid2"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "associated with"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#Argument"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "[OntoGSN] Links a relationship or an artefact reference to the confidence argument provided for it."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Confidence Argument Extension"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#assuranceClaimPoint",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid69"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "assurance claim point"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#boolean"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An Assurance Claim Point (ACP) can be used in GSN to indicate that a confidence argument is associated with an assertion in a risk argument."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Confidence Argument Extension"
  } ],
  "https://w3id.org/OntoGSN/ontology#renderedAs" : [ {
    "@value" : "solid square"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#attachedTo",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#InstantiationDataReference"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "attached to"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid5"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "[OntoGSN] Links an instantiation data reference to the element or template argument it annotates."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Argument Pattern Extension"
  } ],
  "https://w3id.org/OntoGSN/ontology#renderedAs" : [ {
    "@value" : "dotted line"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#away",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://schema.org/description" : [ {
    "@language" : "en",
    "@value" : "An away assumption repeats an assumption presented in another argument module and is typically used only in Contract Modules. An away context repeats a reference to context presented in another argument module. An away goal reference repeats a claim presented in another argument module. An away justification repeats a justification presented in another argument module and is typically used only in Contract Modules. An away solution repeats a reference to evidence items presented in another argument module."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid72"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "away"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#boolean"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An away element reference repeats a claim or evidence presented in another argument module."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Modular Extension"
  } ],
  "https://w3id.org/OntoGSN/ontology#renderedAs" : [ {
    "@value" : "bisecting line in the lower half"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#challenges",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid8"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "challenges"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid11"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Allows a Challenge to any GSN entity to be documented. A goal, (core element) can be used in a dialectic context to assert a challenge to part of the argument. A solution, (core element) can be used to present a reference to an evidence item that asserts a challenge to part of the argument."
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "A challenge must be levied against the appropriate aspect of the goal structure."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Dialectic Extension"
  } ],
  "https://w3id.org/OntoGSN/ontology#renderedAs" : [ {
    "@value" : "dashed line with an open arrowhead"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#choice",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#Relationship"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "choice"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#boolean"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A GSN choice can be used to denote possible alternatives in satisfying a relationship."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Argument Pattern Extension"
  } ],
  "https://w3id.org/OntoGSN/ontology#renderedAs" : [ {
    "@value" : "solid diamond"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#collaboration",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#Pattern"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "collaboration"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The collaboration section should describe how elements of the pattern work together to achieve the desired effect, particularly where there are links that are not readily apparent from the argument structure."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Argument Pattern Extension"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#consequences",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#Pattern"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "consequences"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The consequences section should make clear what work remains after the pattern has been applied. This should highlight where further support to the argument is required, and assumptions that need to be discharged."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Argument Pattern Extension"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#consistentWith",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#SymmetricProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid14"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "consistent with"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid17"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "By making the relationship to the away goal the author is asserting not only the inference of support for the parent goal, but also that the context in which the away goal is declared is consistent with the context and assumptions in scope for the parent goal."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Modular Extension"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#contains",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid20"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "contains"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid26"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "[OntoGSN] Relates a container (e.g., an assurance case, argument, module, catalogue or pattern) to its components (e.g., elements, arguments, patterns or artefacts)."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Core GSN"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#contract",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#Module"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "contract"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#boolean"
  } ],
  "http://www.w3.org/2002/07/owl#propertyDisjointWith" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#undeveloped"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A contract module is a special type of module that controls the relationship between argument module interfaces using arguments to define how a goal in one module is supported by one or more goals in one or more other modules."
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "A contract may be described in textual form (e.g. as a table) or for more complex relationships may be described within a contract module using GSN."
  }, {
    "@language" : "en",
    "@value" : "Contract modules can be used in the support relationship between modules to aid decoupling. The de-coupling by use of a contract permits argument module construction in cases where the eventual source of support for an argument is unknown at the time of authoring or can be changed for example through re-use or planned product improvement or reconfiguration."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Modular Extension"
  } ],
  "https://w3id.org/OntoGSN/ontology#renderedAs" : [ {
    "@value" : "a rectangle with two smaller rectangles (of equal size to each other) adjoining at the top left and bottom right"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#coreOrExtension",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "core or extension"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Indicator of the sourcing section in the GSN Community Standard v3."
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#defeated",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://schema.org/description" : [ {
    "@language" : "en",
    "@value" : "Defeated Relationship indicates that the relationship is defeated. The Defeated decorator can be applied to any of the GSN relationships."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid78"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "defeated"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#boolean"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "This decorator symbol indicates that the element is defeated. The Defeated decorator can be applied to any of the GSN elements."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Dialectic Extension"
  } ],
  "https://w3id.org/OntoGSN/ontology#renderedAs" : [ {
    "@value" : "cross (‘X’) superimposed on a GSN element or relationship"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#depicts",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#View"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "depicts"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#Module"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The argument view depicts the argument inside an individual module."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Modular Extension"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#examples",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#Pattern"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "examples"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "It may be useful to provide example illustrations of the application of the pattern, particularly for more abstract patterns. Illustrations should include a typical case and can be supplemented with atypical cases where more than one example is provided."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Argument Pattern Extension"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#final",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid81"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "final"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#boolean"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "[OntoGSN] Determines whether this is the delivered version of the argument or pattern, in which no element remains uninstantiated or undeveloped."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Argument Pattern Extension"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#implementation",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#Pattern"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "implementation"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The implementation section should communicate how the application of the pattern is carried out e.g. the order in which elements should be developed; communicate hints or techniques that may ease successful application; highlight common or recognised pitfalls with the application of the pattern; and record potential misinterpretation of the terms or concepts in the pattern."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Argument Pattern Extension"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#inContextOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#AsymmetricProperty", "http://www.w3.org/2002/07/owl#IrreflexiveProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid31"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "in context of"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid35"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "InContextOf, rendered as a line with a hollow arrowhead, declares a contextual relationship."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Core GSN"
  } ],
  "https://w3id.org/OntoGSN/ontology#renderedAs" : [ {
    "@value" : "line with a hollow arrowhead"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#inDoubt",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid84"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "in doubt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#boolean"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The dialectic challenge within this structure asserts that if the claim presented in Goal CG1 is true then this is sufficient to establish that the claim in Goal G1 in the original structure is in doubt."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Dialectic Extension"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#inModule",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#GSNElement"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "in module"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#Module"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The module an element belongs to, whether the element sits in an argument the module contains or in a module nested inside it."
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "Inferred, never authored. A module contains arguments and other modules, so the module an element belongs to is always reached in two steps or more. This property names the result of that traversal so that the rules of the Modular Extension can state it in one atom. It is derived by the Module Membership and Nested Module Membership rules."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Modular Extension"
  } ],
  "https://w3id.org/OntoGSN/ontology#inferredOnly" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#inferredOnly",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "inferred only"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "[OntoGSN] Marks a property that a rule derives and that a case never asserts."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Core GSN"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#instantiationOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid40"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "instantiation of"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#Pattern"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "[OntoGSN] Relates an argument or element to the pattern it was instantiated from."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Argument Pattern Extension"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#intent",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#Pattern"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "intent"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The intent statement should state clearly what the pattern aims to achieve."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Argument Pattern Extension"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#knownUses",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#Pattern"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "known uses"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "It may be useful to provide references to known applications of the pattern. These can serve as additional examples."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Argument Pattern Extension"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#maxCardinality",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#Relationship"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "maximum cardinality"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "[OntoGSN] The upper bound on how many instances of the related element this relationship stands for."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Argument Pattern Extension"
  } ],
  "https://w3id.org/OntoGSN/ontology#renderedAs" : [ {
    "@value" : "text"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#minCardinality",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#Relationship"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "minimum cardinality"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "[OntoGSN] The lower bound on how many instances of the related element this relationship stands for."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Argument Pattern Extension"
  } ],
  "https://w3id.org/OntoGSN/ontology#renderedAs" : [ {
    "@value" : "text"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#motivation",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#Pattern"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "motivation"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The motivation statement can be used to state why the pattern was created. It could be expressed in terms of previous experiences e.g. as the abstraction of a successfully presented argument, or challenges addressed e.g. argument topics that are often incompletely or poorly addressed."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Argument Pattern Extension"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#multiple",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#Relationship"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "multiple"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#boolean"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "[OntoGSN] Determines whether the relationship stands for multiple instantiations rather than a single one."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Argument Pattern Extension"
  } ],
  "https://w3id.org/OntoGSN/ontology#renderedAs" : [ {
    "@value" : "solid ball"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#offDiagram",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#GSNElement"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "off-diagram"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#boolean"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "[OntoGSN] Determines whether the argument at this element continues in, or is a continuation from, a separate diagram."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Core GSN"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#optional",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#Relationship"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "optional"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#boolean"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Optional instantiation means that the relationship and the argument below may or may not be instantiated."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Argument Pattern Extension"
  } ],
  "https://w3id.org/OntoGSN/ontology#renderedAs" : [ {
    "@language" : "en",
    "@value" : "hollow ball"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#participants",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#Pattern"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "participants"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The participants section augments the structure by providing a description of each element. This can provide more complete descriptions, clarify the role of the element in the overall argument and emphasise the aspects that require development or instantiation."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Argument Pattern Extension"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#public",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid88"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "public"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#boolean"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "This indicates that the element is publicly visible in one or more interfaces of the module and can be referenced as an away element."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Modular Extension"
  } ],
  "https://w3id.org/OntoGSN/ontology#renderedAs" : [ {
    "@value" : "miniature module symbol superimposed on an element at the top right"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#published",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid94"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "published"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#boolean"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "[OntoGSN] Determines whether the argument or pattern is in its published form, in which the undeveloped decorator is not permitted."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Argument Pattern Extension"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#refersTo",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid43"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "refers to"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#Artefact"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "[OntoGSN] Relates an artefact reference or an instantiation data reference to the artefact it points at."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Core GSN"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#relatedTo",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#Pattern"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "related to"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#Pattern"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "This section can be used to reference patterns that are related e.g. addressing the same intent in a different context."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Argument Pattern Extension"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#relationshipType",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#Relationship"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "relationship type"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid97"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An evidential relationship is a declared relationship between a claim and an evidence item by which the claim is substantiated. An inferential relationship is a declared inference between claims in the argument. A contextual relationship draws attention to explanatory contextual information."
  }, {
    "@language" : "en",
    "@value" : "SupportedBy relationships – represented by lines with solid arrowheads – indicate inferential or evidential relationships between elements. InContextOf relationships – represented as lines with hollow arrowheads – declare contextual relationships."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Core GSN"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#renderedAs",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "rendered as"
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Core GSN"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#statement",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid102"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "statement"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "[OntoGSN] The text the element asserts, written to the grammatical rules the standard sets for GSN statements."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Core GSN"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#structure",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#Pattern"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "structure"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The structure uses the structural and element abstraction notations to present the pattern, clearly indicating where the argument needs to be further developed or populated with details to instantiate the pattern for a specific case."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Argument Pattern Extension"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#structured",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#Argument"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "structured"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#boolean"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A particular kind of argument where the relationships between the asserted claims, and from the evidence to the claims, are explicitly represented."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Core GSN"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#substitutedBy",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#Justification"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "substituted by"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid46"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "There may be occasions when a goal or strategy requires fuller justification than can be provided within the confines of a GSN justification element. In such cases, an away goal can be substituted for the justification."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Modular Extension"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#supportedBy",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#AsymmetricProperty", "http://www.w3.org/2002/07/owl#IrreflexiveProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid50"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "supported by"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid54"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "SupportedBy, rendered as a line with a solid arrowhead, allows support relationships between elements to be documented."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Core GSN"
  } ],
  "https://w3id.org/OntoGSN/ontology#renderedAs" : [ {
    "@value" : "line with a solid arrowhead"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#toBeSupportedByContract",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#Goal"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "to be supported by contract"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#boolean"
  } ],
  "http://www.w3.org/2002/07/owl#propertyDisjointWith" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#undeveloped"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Support for the claim presented by the attached goal is intended to be provided from an argument in another module linked by an as-yet-undisclosed contract."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Modular Extension"
  } ],
  "https://w3id.org/OntoGSN/ontology#renderedAs" : [ {
    "@value" : "attached centrally immediately below the goal to which it relates"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#top",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#Goal"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "top (goal)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#boolean"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A GSN Goal that presents the pinnacle claim in an argument. It is ‘top’ in terms of the argument hierarchy, rather than necessarily its physical layout. There may be more than one top goal in a GSN structure."
  }, {
    "@language" : "en",
    "@value" : "The top goal presents the overall claim asserted by the author and it is up to the reader to determine their belief that it is adequately supported."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Core GSN"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#transitivelyChallenges",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#TransitiveProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid59"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "transitively challenges"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid62"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "[OntoGSN] Relates an element to every element that it reaches through a chain of one or more challenges."
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "Inferred, never authored. It is derived by the Challenge Closure rule, and the Challenge Cycle rules read it."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Dialectic Extension"
  } ],
  "https://w3id.org/OntoGSN/ontology#inferredOnly" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#transitivelyInContextOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#TransitiveProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#Module"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "transitively in context of"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#Module"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "[OntoGSN] Relates a module to every module that it reaches through a chain of one or more in-context-of links between modules."
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "Inferred, never authored. It is derived by the Module Context Closure rule, and the Module Context Cycle rules read it."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Modular Extension"
  } ],
  "https://w3id.org/OntoGSN/ontology#inferredOnly" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#transitivelySupportedBy",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#TransitiveProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#GSNElement"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "transitively supported by"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#GSNElement"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "[OntoGSN] Relates an element to every element that it reaches through a chain of one or more supported-by links."
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "Inferred, never authored. It is derived by the Support Closure rule, and the Support Cycle rules read it."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Core GSN"
  } ],
  "https://w3id.org/OntoGSN/ontology#inferredOnly" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#true",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid106"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "true"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#boolean"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "[OntoGSN] Marks whether the claim in the element or relationship is determined (e.g., by the auditor or some process) as correct or not."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Core GSN"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#undeveloped",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid109"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "undeveloped"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#boolean"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Undeveloped element decorator, rendered as a hollow diamond applied to the bottom centre of an element, indicates that a line of argument has not been developed."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Argument Pattern Extension"
  } ],
  "https://w3id.org/OntoGSN/ontology#renderedAs" : [ {
    "@value" : "hollow diamond"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#uninstantiated",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/OntoGSN/ontology#GSNElement"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "uninstantiated"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#boolean"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The attached element remains to be instantiated: at some later stage the abstract element needs to be replaced with a more concrete instance."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Argument Pattern Extension"
  } ],
  "https://w3id.org/OntoGSN/ontology#renderedAs" : [ {
    "@value" : "hollow triangle"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#valid",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid113"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "valid"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#boolean"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "[OntoGSN] Marks whether the element is determined (e.g., by a rule or a manual evaluation) to be consistent with the argument, or otherwise correct with respect to the GSN argument syntax."
  } ],
  "https://w3id.org/OntoGSN/ontology#coreOrExtension" : [ {
    "@language" : "en",
    "@value" : "Core GSN"
  } ]
}, {
  "@id" : "https://w3id.org/OntoGSN/ontology#viewType",
