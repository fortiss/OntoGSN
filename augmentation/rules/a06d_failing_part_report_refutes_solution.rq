# rule:      A6d
# name:      Failing Part Report Refutes Solution
# section:   Augmentation
# operation: rule
# expect:    insert
# swrl:      Solution(?S) ^ refersTo(?S, ?A) ^ Artefact(?A) ^ ArtefactPart(?P) ^ partOf(?P, ?A) ^ verifiableWith(?P, ?M) ^ ValidationReport(?R) ^ wasGeneratedBy(?R, ?M) ^ used(?R, ?P) ^ conforms(?R, false) -> true(?S, false)
# reads:     IF Solution S refers to Artefact A AND ArtefactPart P is part of A AND P is verifiable with Mechanism M AND the newest unstruck report R generated by M over P does not conform THEN S is not true
# note:      THE GUARDS BELOW ARE NOT IN THE SWRL. The source rule states the positive half,
#            as S10 and S11 in the core do, and this translation adds guards that need
#            negation as failure, which SWRL does not have. The struck-report guard: a report
#            with prov:invalidatedAtTime or prov:wasInvalidatedBy is struck; it never counts
#            and retires nothing, so the report before it counts again. The newest-report
#            guard: a report counts only while no unstruck report from the same mechanism
#            over the same target carries a later prov:generatedAtTime. A report without a
#            timestamp is never retired and retires nothing; two such reports that disagree
#            are what gsnaugsh:ReportConflictShape reports.
#            A failing report refutes regardless of what other reports say, so this rule
#            carries no composition guard.
#            The old truth value is deleted before the new one is written, as S10 does, so
#            that a status flips rather than accumulates.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug: <https://w3id.org/OntoGSN/augmentation#>
PREFIX prov:   <http://www.w3.org/ns/prov#>
PREFIX sh:     <http://www.w3.org/ns/shacl#>

DELETE {
  ?S gsn:true ?old .
}
INSERT {
  ?S gsn:true false .
}
WHERE {
  ?S a gsn:Solution ;
     gsn:refersTo ?A .
  ?A a gsn:Artefact .
  ?P a gsnaug:ArtefactPart ;
     gsnaug:partOf ?A ;
     gsnaug:verifiableWith ?M .
  ?R a sh:ValidationReport ;
     prov:wasGeneratedBy ?M ;
     prov:used ?P ;
     sh:conforms ?conforms .
  FILTER(STR(?conforms) = "false")
  # struck-report guard: a struck report never counts
  FILTER NOT EXISTS { ?R prov:invalidatedAtTime|prov:wasInvalidatedBy ?struck }
  # newest-report guard: no later unstruck report from the same mechanism over the same target
  OPTIONAL { ?R prov:generatedAtTime ?t }
  FILTER NOT EXISTS {
    ?newer a sh:ValidationReport ;
           prov:wasGeneratedBy ?M ;
           prov:used ?P ;
           prov:generatedAtTime ?tNewer .
    FILTER(?tNewer > ?t)
    FILTER NOT EXISTS { ?newer prov:invalidatedAtTime|prov:wasInvalidatedBy ?struckNewer }
  }
  OPTIONAL { ?S gsn:true ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
