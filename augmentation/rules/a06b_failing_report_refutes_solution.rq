# rule:      A6b
# name:      Failing Report Refutes Solution
# section:   Augmentation
# operation: rule
# expect:    insert
# swrl:      Solution(?S) ^ refersTo(?S, ?A) ^ Artefact(?A) ^ verifiableWith(?A, ?M) ^ ValidationReport(?R) ^ wasGeneratedBy(?R, ?M) ^ used(?R, ?A) ^ conforms(?R, false) -> true(?S, false)
# reads:     IF Solution S refers to Artefact A AND A is verifiable with Mechanism M AND a report R generated by M over A does not conform THEN S is not true

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug: <https://w3id.org/OntoGSN/augmentation#>
PREFIX prov:   <http://www.w3.org/ns/prov#>
PREFIX sh:     <http://www.w3.org/ns/shacl#>

INSERT {
  ?S gsn:true false .
}
WHERE {
  ?S a gsn:Solution ;
     gsn:refersTo ?A .
  ?A a gsn:Artefact ;
     gsnaug:verifiableWith ?M .
  ?R a sh:ValidationReport ;
     prov:wasGeneratedBy ?M ;
     prov:used ?A ;
     sh:conforms ?conforms .
  FILTER(STR(?conforms) = "false")
  FILTER NOT EXISTS { ?S gsn:true false }
}
