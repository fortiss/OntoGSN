# rule:      A2b
# name:      Revise Issue Challenges Solution

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug: <https://w3id.org/OntoGSN/augmentation#>

INSERT {
  ?I a gsn:Goal ;
     gsn:true true ;
     gsn:challenges ?E .
}
WHERE {
  ?I a gsnaug:Issue ;
     gsnaug:issueType gsnaug:revise ;
     gsnaug:raisedAgainst ?E .
  ?E a gsn:Solution .
  FILTER NOT EXISTS { ?I gsn:challenges ?E }
}
