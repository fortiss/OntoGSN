# rule:      A8c
# name:      Issue Goal Context From Solution

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug: <https://w3id.org/OntoGSN/augmentation#>

INSERT {
  ?I gsn:inContextOf ?C .
}
WHERE {
  {
    SELECT DISTINCT ?I ?C
    WHERE {
      ?I a gsnaug:Issue , gsn:Goal ;
         gsn:challenges ?E .
      ?E a gsn:Solution .
      ?P gsn:supportedBy ?E ;
         gsn:inContextOf ?C .
      FILTER NOT EXISTS { ?I gsn:inContextOf ?any }
    }
  }
}
