# rule:      A6a
# name:      Conforming Report Confirms Solution
# section:   Augmentation
# operation: rule
# expect:    insert
# swrl:      Solution(?S) ^ refersTo(?S, ?A) ^ Artefact(?A) ^ verifiableWith(?A, ?M) ^ ValidationReport(?R) ^ wasGeneratedBy(?R, ?M) ^ used(?R, ?A) ^ conforms(?R, true) -> true(?S, true)
# reads:     IF Solution S refers to Artefact A AND A is verifiable with Mechanism M AND a report R generated by M over A conforms THEN S is true

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug: <https://w3id.org/OntoGSN/augmentation#>
PREFIX prov:   <http://www.w3.org/ns/prov#>
PREFIX sh:     <http://www.w3.org/ns/shacl#>

INSERT {
  ?S gsn:true true .
}
WHERE {
  ?S a gsn:Solution ;
     gsn:refersTo ?A .
  ?A a gsn:Artefact ;
     gsnaug:verifiableWith ?M .
  ?R a sh:ValidationReport ;
     prov:wasGeneratedBy ?M ;
     prov:used ?A ;
     sh:conforms ?conforms .
  FILTER(STR(?conforms) = "true")
  FILTER NOT EXISTS { ?S gsn:true true }
}
