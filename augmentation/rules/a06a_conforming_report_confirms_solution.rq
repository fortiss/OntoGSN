# rule:      A6a
# name:      Conforming Report Confirms Solution
# section:   Augmentation
# operation: rule
# expect:    insert
# swrl:      Solution(?S) ^ refersTo(?S, ?A) ^ Artefact(?A) ^ verifiableWith(?A, ?M) ^ ValidationReport(?R) ^ wasGeneratedBy(?R, ?M) ^ used(?R, ?A) ^ conforms(?R, true) -> true(?S, true)
# reads:     IF Solution S refers to Artefact A AND A is verifiable with Mechanism M AND the newest unstruck report R generated by M over A conforms AND no current report over A or a part of A fails THEN S is true
# note:      THE GUARDS BELOW ARE NOT IN THE SWRL. The source rule states the positive half,
#            as S10 and S11 in the core do, and this translation adds guards that need
#            negation as failure, which SWRL does not have. The struck-report guard: a report
#            with prov:invalidatedAtTime or prov:wasInvalidatedBy is struck; it never counts
#            and retires nothing, so the report before it counts again. The newest-report
#            guard: a report counts only while no unstruck report from the same mechanism
#            over the same target carries a later prov:generatedAtTime. A report without a
#            timestamp is never retired and retires nothing; two such reports that disagree
#            are what gsnaugsh:ReportConflictShape reports.
#            The composition guard: support in GSN is a composition, so a conforming report
#            confirms the solution only while no current report over the artefact or over a
#            part of it fails. A6b and A6d need no such guard: a failing report refutes
#            regardless, and without the guard A6a and A6b would alternate forever on an
#            artefact whose mechanisms disagree.
#            The old truth value is deleted before the new one is written, as S10 does, so
#            that a status flips rather than accumulates.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug: <https://w3id.org/OntoGSN/augmentation#>
PREFIX prov:   <http://www.w3.org/ns/prov#>
PREFIX sh:     <http://www.w3.org/ns/shacl#>

DELETE {
  ?S gsn:true ?old .
}
INSERT {
  ?S gsn:true true .
}
WHERE {
  ?S a gsn:Solution ;
     gsn:refersTo ?A .
  ?A a gsn:Artefact ;
     gsnaug:verifiableWith ?M .
  ?R a sh:ValidationReport ;
     prov:wasGeneratedBy ?M ;
     prov:used ?A ;
     sh:conforms ?conforms .
  FILTER(STR(?conforms) = "true")
  # struck-report guard: a struck report never counts
  FILTER NOT EXISTS { ?R prov:invalidatedAtTime|prov:wasInvalidatedBy ?struck }
  # newest-report guard: no later unstruck report from the same mechanism over the same target
  OPTIONAL { ?R prov:generatedAtTime ?t }
  FILTER NOT EXISTS {
    ?newer a sh:ValidationReport ;
           prov:wasGeneratedBy ?M ;
           prov:used ?A ;
           prov:generatedAtTime ?tNewer .
    FILTER(?tNewer > ?t)
    FILTER NOT EXISTS { ?newer prov:invalidatedAtTime|prov:wasInvalidatedBy ?struckNewer }
  }
  # composition guard: no current failing report over the artefact or over a part of it
  FILTER NOT EXISTS {
    ?T2 gsnaug:verifiableWith ?M2 .
    FILTER(?T2 = ?A || EXISTS { ?T2 gsnaug:partOf ?A })
    ?R2 a sh:ValidationReport ;
        prov:wasGeneratedBy ?M2 ;
        prov:used ?T2 ;
        sh:conforms ?c2 .
    FILTER(STR(?c2) = "false")
    FILTER NOT EXISTS { ?R2 prov:invalidatedAtTime|prov:wasInvalidatedBy ?struck2 }
    OPTIONAL { ?R2 prov:generatedAtTime ?t2 }
    FILTER NOT EXISTS {
      ?newer2 a sh:ValidationReport ;
             prov:wasGeneratedBy ?M2 ;
             prov:used ?T2 ;
             prov:generatedAtTime ?tNewer2 .
      FILTER(?tNewer2 > ?t2)
      FILTER NOT EXISTS { ?newer2 prov:invalidatedAtTime|prov:wasInvalidatedBy ?struckNewer2 }
    }
  }
  OPTIONAL { ?S gsn:true ?old }
  FILTER(!BOUND(?old) || STR(?old) != "true")
}
