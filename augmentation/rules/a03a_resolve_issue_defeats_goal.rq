# rule:      A3a
# name:      Resolve Issue Defeats Goal
# section:   Augmentation
# operation: rule
# expect:    insert
# swrl:      Issue(?I) ^ issueType(?I, resolve) ^ raisedAgainst(?I, ?E) ^ Goal(?E) -> Goal(?I) ^ challenges(?I, ?E) ^ defeated(?E, true)
# reads:     IF Issue I is of type resolve AND is raised against Goal E THEN I is a goal challenging E, and E is defeated

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug: <https://w3id.org/OntoGSN/augmentation#>

DELETE { ?E gsn:defeated ?old }
INSERT {
  ?I a gsn:Goal ;
     gsn:challenges ?E .
  ?E gsn:defeated true .
}
WHERE {
  ?I a gsnaug:Issue ;
     gsnaug:issueType gsnaug:resolve ;
     gsnaug:raisedAgainst ?E .
  ?E a gsn:Goal .
  OPTIONAL { ?E gsn:defeated ?old }
  FILTER(!BOUND(?old) || STR(?old) != "true")
}
