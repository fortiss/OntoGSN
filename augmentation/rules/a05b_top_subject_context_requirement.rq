# rule:      A5b
# name:      Top Subject Context Requirement
# section:   Augmentation
# operation: rule
# expect:    insert
# swrl:      Goal(?G) ^ top(?G, true) ^ inContextOf(?G, ?C) ^ TopSubjectContext(?C) ^ refersTo(?C, ?R) -> requiredBy(?G, ?R)
# reads:     IF top Goal G is in the context of Top Subject Context C AND C refers to R THEN G is required by R

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug: <https://w3id.org/OntoGSN/augmentation#>

INSERT { ?G gsnaug:requiredBy ?R }
WHERE {
  ?G a gsn:Goal ;
     gsn:top ?top ;
     gsn:inContextOf ?C .
  FILTER(STR(?top) = "true")
  ?C a gsnaug:TopSubjectContext ;
     gsn:refersTo ?R .
  FILTER NOT EXISTS { ?G gsnaug:requiredBy ?R }
}
