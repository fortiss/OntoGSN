# rule:      A7d
# name:      Failing Part Report Invalidates Solution
# section:   Augmentation
# operation: rule
# expect:    insert
# swrl:      Solution(?S) ^ refersTo(?S, ?A) ^ Artefact(?A) ^ ArtefactPart(?P) ^ partOf(?P, ?A) ^ checkableWith(?P, ?M) ^ ValidationReport(?R) ^ wasGeneratedBy(?R, ?M) ^ used(?R, ?P) ^ conforms(?R, false) ^ decides(?M, "validity") -> valid(?S, false)
# reads:     IF Solution S refers to Artefact A AND ArtefactPart P is part of A AND P is checkable with Mechanism M, which decides validity, AND the newest unstruck report R generated by M over P does not conform THEN S is not valid
# note:      THE GUARDS BELOW ARE NOT IN THE SWRL. The struck-report guard and the
#            newest-report guard are those of A6d. The old validity value is deleted before
#            false is written, as the core rules do.

PREFIX gsn:    <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug: <https://w3id.org/OntoGSN/augmentation#>
PREFIX prov:   <http://www.w3.org/ns/prov#>
PREFIX sh:     <http://www.w3.org/ns/shacl#>

DELETE {
  ?S gsn:valid ?old .
}
INSERT {
  ?S gsn:valid false .
}
WHERE {
  ?S a gsn:Solution ;
     gsn:refersTo ?A .
  ?A a gsn:Artefact .
  ?P a gsnaug:ArtefactPart ;
     gsnaug:partOf ?A ;
     gsnaug:checkableWith ?M .
  ?M gsnaug:decides "validity" .
  ?R a sh:ValidationReport ;
     prov:wasGeneratedBy ?M ;
     prov:used ?P ;
     sh:conforms ?conforms .
  FILTER(STR(?conforms) = "false")
  # struck-report guard: a struck report never counts
  FILTER NOT EXISTS { ?R prov:invalidatedAtTime|prov:wasInvalidatedBy ?struck }
  # newest-report guard: no later unstruck report from the same mechanism over the same target
  OPTIONAL { ?R prov:generatedAtTime ?t }
  FILTER NOT EXISTS {
    ?newer a sh:ValidationReport ;
           prov:wasGeneratedBy ?M ;
           prov:used ?P ;
           prov:generatedAtTime ?tNewer .
    FILTER(?tNewer > ?t)
    FILTER NOT EXISTS { ?newer prov:invalidatedAtTime|prov:wasInvalidatedBy ?struckNewer }
  }
  OPTIONAL { ?S gsn:valid ?old }
  FILTER(!BOUND(?old) || STR(?old) != "false")
}
