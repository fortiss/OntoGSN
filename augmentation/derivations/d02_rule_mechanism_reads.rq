# rule:      D2
# name:      Rule Mechanism Reads Terms

PREFIX gsnaug: <https://w3id.org/OntoGSN/augmentation#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX swrl:   <http://www.w3.org/2003/11/swrl#>

INSERT { ?mechanism gsnaug:readsTerm ?term }
WHERE {
  ?definition a swrl:Imp ;
              gsnaug:implements ?mechanism ;
              swrl:body/rdf:rest*/rdf:first ?atom .
  ?mechanism a gsnaug:Mechanism .
  ?atom swrl:classPredicate|swrl:propertyPredicate ?term .
  FILTER ( isIRI(?term) )
}
