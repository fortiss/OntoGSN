# rule:      D2
# name:      Rule Mechanism Reads Terms
# section:   Augmentation derivations
# operation: rule
# expect:    insert
# swrl:      none. The body is an RDF list, walked with rdf:rest*, which SWRL cannot express.
# reads:     IF a mechanism is a SWRL rule THEN it reads every class predicate and property
#            predicate in its body
#
# Built-in atoms are not terms of a domain ontology and are left out. A class expression in a
# class atom is a blank node and is left out.

PREFIX gsnaug: <https://w3id.org/OntoGSN/augmentation#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX swrl:   <http://www.w3.org/2003/11/swrl#>

INSERT { ?mechanism gsnaug:readsTerm ?term }
WHERE {
  ?mechanism a gsnaug:Mechanism , swrl:Imp ;
             swrl:body/rdf:rest*/rdf:first ?atom .
  ?atom swrl:classPredicate|swrl:propertyPredicate ?term .
  FILTER ( isIRI(?term) )
}
