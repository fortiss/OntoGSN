@prefix gsnaugsh: <https://w3id.org/OntoGSN/augmentation/shapes#> .
@prefix gsnaug:   <https://w3id.org/OntoGSN/augmentation#> .
@prefix gsn:      <https://w3id.org/OntoGSN/ontology#> .
@prefix prov:     <http://www.w3.org/ns/prov#> .
@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix dc:       <http://purl.org/dc/elements/1.1/> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@base <https://w3id.org/OntoGSN/augmentation/shapes> .


<https://w3id.org/OntoGSN/augmentation/shapes> rdf:type owl:Ontology ;
    dc:title "OntoGSN Augmentation SHACL Shapes"@en ;
    dc:description """Constraints for the OntoGSN Augmentation vocabulary (https://w3id.org/OntoGSN/augmentation).

The division of labour is the one the augmentation's own stability rules set out: OWL describes,
SHACL constrains. Every rdfs:range in the vocabulary is repeated here as a shape, because an
rdfs:range infers a type rather than rejecting a wrong one: a value outside the range is silently
retyped by a reasoner and reported by nothing. The shapes are what reject it.

That applies twice over to gsnaug:raisedAgainst, whose range is a six-way union covering everything
in a case a reviewer can point at. The union is wide enough to be worth stating and wide enough that
a target outside it is almost certainly a mistake."""@en ;
    dc:source "https://w3id.org/OntoGSN/augmentation" ;
    owl:versionInfo "0.2.0" .


<https://w3id.org/OntoGSN/augmentation/shapes> sh:declare [
        sh:prefix "gsn" ;
        sh:namespace "https://w3id.org/OntoGSN/ontology#"^^xsd:anyURI ;
    ] , [
        sh:prefix "gsnaug" ;
        sh:namespace "https://w3id.org/OntoGSN/augmentation#"^^xsd:anyURI ;
    ] , [
        sh:prefix "rdf" ;
        sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ;
    ] .


#################################################################
#    Issues
#################################################################

###  gsnaug:Issue
gsnaugsh:IssueShape rdf:type sh:NodeShape ;
    rdfs:label "Issue shape"@en ;
    sh:targetClass gsnaug:Issue ;
    sh:property [
        sh:path gsnaug:raisedAgainst ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:or ( [ sh:class gsn:Argument ]
                [ sh:class gsn:Artefact ]
                [ sh:class gsn:AssuranceCase ]
                [ sh:class gsn:GSNElement ]
                [ sh:class gsn:Pattern ]
                [ sh:class gsn:Relationship ] ) ;
        sh:name "raised against" ;
        sh:description "An issue is about exactly one thing, and that thing is part of a case: an argument, an artefact, the case itself, any GSN element, a pattern, or a reified relationship."@en ;
        sh:message "An issue must be raised against exactly one thing, and that thing must be an argument, an artefact, an assurance case, a GSN element, a pattern or a reified relationship."@en ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsnaug:issueType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( gsnaug:clarify gsnaug:revise gsnaug:resolve ) ;
        sh:name "issue type" ;
        sh:message "An issue must carry exactly one type: gsnaug:clarify, gsnaug:revise or gsnaug:resolve."@en ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsnaug:supersedes ;
        sh:class gsnaug:Issue ;
        sh:name "supersedes" ;
        sh:message "An issue may only supersede another issue."@en ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsnaug:issueOutcome ;
        sh:maxCount 1 ;
        sh:in ( gsnaug:cannotAnswer gsnaug:declined gsnaug:infeasible ) ;
        sh:name "issue outcome" ;
        sh:message "An issue ends in at most one outcome: gsnaug:cannotAnswer, gsnaug:declined or gsnaug:infeasible."@en ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsnaug:raisedIn ;
        sh:class gsnaug:AuditCycle ;
        sh:maxCount 1 ;
        sh:name "raised in" ;
        sh:message "An issue belongs to at most one audit cycle, and that value must be a gsnaug:AuditCycle."@en ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsnaug:raisedBy ;
        sh:class prov:Agent ;
        sh:maxCount 1 ;
        sh:name "raised by" ;
        sh:message "An issue is raised by at most one agent."@en ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsnaug:heldBy ;
        sh:class prov:Agent ;
        sh:maxCount 1 ;
        sh:name "held by" ;
        sh:description "One holder at a time. A further hop is a new issue that supersedes this one, which is what keeps the relay countable."@en ;
        sh:message "An issue rests with at most one agent at a time."@en ;
        sh:severity sh:Violation ;
    ] .

###  gsnaug:Issue - an outcome and an answer are two ways of closing, not both
gsnaugsh:IssueClosureShape rdf:type sh:NodeShape ;
    rdfs:label "Issue closure shape"@en ;
    rdfs:comment "gsnaug:answers closes an ask positively and gsnaug:issueOutcome ends it without an answer. An issue carrying an outcome and an answer the raiser accepted has been closed twice, in two contradictory ways, and one of the two is stale."@en ;
    sh:targetClass gsnaug:Issue ;
    sh:sparql [
        sh:message "This issue is closed twice over: it carries an outcome and an accepted answer."@en ;
        sh:prefixes <https://w3id.org/OntoGSN/augmentation/shapes> ;
        sh:select """
            SELECT $this ?answer WHERE {
                $this gsnaug:issueOutcome ?outcome .
                ?answer gsnaug:answers $this ;
                        gsnaug:accepted true .
            }
        """ ;
    ] ;
    sh:severity sh:Violation .

###  gsnaug:Issue - an issue may not supersede itself
gsnaugsh:IssueSupersessionShape rdf:type sh:NodeShape ;
    rdfs:label "Issue self-supersession shape"@en ;
    rdfs:comment "gsnaug:supersedes is declared owl:IrreflexiveProperty, which makes a self-superseding issue an OWL inconsistency rather than a reported problem. A reasoner is not always in the loop, so it is also checked here."@en ;
    sh:targetClass gsnaug:Issue ;
    sh:sparql [
        sh:message "An issue cannot supersede itself."@en ;
        sh:prefixes <https://w3id.org/OntoGSN/augmentation/shapes> ;
        sh:select """
            SELECT $this WHERE { $this gsnaug:supersedes $this . }
        """ ;
    ] ;
    sh:severity sh:Violation .


#################################################################
#    Answers
#################################################################

###  gsnaug:Answer
gsnaugsh:AnswerShape rdf:type sh:NodeShape ;
    rdfs:label "Answer shape"@en ;
    sh:targetClass gsnaug:Answer ;
    sh:property [
        sh:path gsnaug:answers ;
        sh:class gsnaug:Issue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "answers" ;
        sh:message "An answer must close exactly one issue."@en ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsnaug:accepted ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:name "accepted" ;
        sh:description "Whether the agent who raised the issue took this answer. Absent means nobody has said."@en ;
        sh:message "Whether an answer was accepted is a single boolean."@en ;
        sh:severity sh:Violation ;
    ] .

###  gsnaug:Answer - the answer class has to match the issue type
gsnaugsh:AnswerAgreementShape rdf:type sh:NodeShape ;
    rdfs:label "Answer agreement shape"@en ;
    rdfs:comment "A gsnaug:Revision answers a revise issue, a gsnaug:Clarification a clarify issue, a gsnaug:Resolution a resolve issue. Written as one constraint rather than three shapes, so the pairing is stated in one place. Not a VALUES table, which SHACL-SPARQL forbids in a constraint, and not a UNION either: a filter inside a UNION branch cannot see a variable bound in the enclosing group, so the three tests are one flat disjunction."@en ;
    sh:targetClass gsnaug:Answer ;
    sh:sparql [
        sh:message "The kind of answer does not match the kind of issue it closes: a Clarification answers a clarify issue, a Revision a revise issue, and a Resolution a resolve issue."@en ;
        sh:prefixes <https://w3id.org/OntoGSN/augmentation/shapes> ;
        sh:select """
            SELECT $this ?issue WHERE {
                $this gsnaug:answers ?issue ;
                      rdf:type ?answerClass .
                ?issue gsnaug:issueType ?type .
                FILTER (   ( ?answerClass = gsnaug:Clarification && ?type != gsnaug:clarify )
                        || ( ?answerClass = gsnaug:Revision      && ?type != gsnaug:revise  )
                        || ( ?answerClass = gsnaug:Resolution    && ?type != gsnaug:resolve ) )
            }
        """ ;
    ] ;
    sh:severity sh:Violation .


#################################################################
#    Artefact provenance
#################################################################

###  gsn:Artefact
gsnaugsh:ArtefactShape rdf:type sh:NodeShape ;
    rdfs:label "Artefact augmentation shape"@en ;
    sh:targetClass gsn:Artefact ;
    sh:property [
        sh:path gsnaug:storedIn ;
        sh:class gsnaug:StorageSystem ;
        sh:name "stored in" ;
        sh:message "An artefact may only be stored in a storage system."@en ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsnaug:retrievableWith ;
        sh:class gsnaug:EvidenceRetrievalMechanism ;
        sh:name "retrievable with" ;
        sh:message "An artefact may only be retrievable with an evidence retrieval mechanism."@en ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsnaug:generatedWith ;
        sh:class gsnaug:EvidenceGenerationMechanism ;
        sh:name "generated with" ;
        sh:message "An artefact may only be generated with an evidence generation mechanism."@en ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsnaug:verifiedWith ;
        sh:class gsnaug:EvidenceVerificationMechanism ;
        sh:name "verified with" ;
        sh:message "An artefact may only be verified with an evidence verification mechanism."@en ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsnaug:generatedBy ;
        sh:class prov:Agent ;
        sh:name "generated by" ;
        sh:description "The person. The tool goes on gsnaug:generatedWith."@en ;
        sh:message "An artefact may only be generated by an agent."@en ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsnaug:containsElement ;
        sh:class gsnaug:ArtefactElement ;
        sh:name "contains element" ;
        sh:description "The rows, clauses or sections of the artefact that an element may be instantiated from."@en ;
        sh:message "An artefact may only contain artefact elements."@en ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsnaug:revisionOf ;
        sh:class gsn:Artefact ;
        sh:name "revision of" ;
        sh:description "Artefact versions only. A reworded claim is element versioning, which this vocabulary does not model."@en ;
        sh:message "An artefact may only be a revision of another artefact."@en ;
        sh:severity sh:Violation ;
    ] .

###  gsn:Solution - the provenance belongs on the artefact, not on the reference to it
gsnaugsh:SolutionProvenanceShape rdf:type sh:NodeShape ;
    rdfs:label "Solution provenance placement shape"@en ;
    rdfs:comment "A solution is the GSN element that references an artefact; the storage location, the generating tool and the verification script are facts about the file. Hanging them on the solution splits the same fact across two nodes, and every query in this vocabulary reads them from the artefact."@en ;
    sh:targetClass gsn:Solution ;
    sh:property [
        sh:path [ sh:alternativePath ( gsnaug:storedIn
                                       gsnaug:retrievableWith
                                       gsnaug:generatedBy
                                       gsnaug:generatedWith
                                       gsnaug:generatedFrom
                                       gsnaug:verifiedWith ) ] ;
        sh:maxCount 0 ;
        sh:name "evidence provenance" ;
        sh:message "Evidence provenance belongs on the artefact, not on the solution that references it. Move this to the gsn:Artefact reached by gsn:refersTo."@en ;
        sh:severity sh:Warning ;
    ] .


#################################################################
#    Mechanisms
#################################################################

###  Whether a mechanism runs without a person is a single boolean
gsnaugsh:MechanismAutomationShape rdf:type sh:NodeShape ;
    rdfs:label "Mechanism automation shape"@en ;
    rdfs:comment "Targeted at whatever carries the property rather than at the three mechanism classes, so that a value on the wrong kind of node is still checked for shape. False is an assessment that the mechanism is manual; absent means none has been made."@en ;
    sh:targetSubjectsOf gsnaug:automated ;
    sh:property [
        sh:path gsnaug:automated ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:name "automated" ;
        sh:message "Whether a mechanism is automated is a single boolean."@en ;
        sh:severity sh:Violation ;
    ] .


#################################################################
#    Roles
#################################################################

gsnaugsh:OwnershipShape rdf:type sh:NodeShape ;
    rdfs:label "Ownership shape"@en ;
    sh:targetSubjectsOf gsnaug:ownedBy ;
    sh:property [
        sh:path gsnaug:ownedBy ;
        sh:nodeKind sh:IRI ;
        sh:name "owned by" ;
        sh:message "The owner of an element must be named, not a blank node - accountability that cannot be cited is not accountability."@en ;
        sh:severity sh:Violation ;
    ] .


#################################################################
#    Agents
#################################################################

###  Whoever owns, reviews or holds a role is an agent, and each of the three
###  points somewhere specific
gsnaugsh:AgentShape rdf:type sh:NodeShape ;
    rdfs:label "Agent shape"@en ;
    rdfs:comment "Targeted at whatever carries the property rather than at prov:Agent, so that a subject the vocabulary would merely retype is reported instead."@en ;
    sh:targetSubjectsOf gsnaug:owns , gsnaug:reviews , gsnaug:hasRole ;
    sh:class prov:Agent ;
    sh:message "Only an agent owns an element, reviews one, or holds a role."@en ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path gsnaug:owns ;
        sh:class gsn:GSNElement ;
        sh:name "owns" ;
        sh:message "An agent owns a GSN element. Ownership of the artefact behind a solution is not modelled."@en ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsnaug:reviews ;
        sh:or ( [ sh:class gsn:Artefact ] [ sh:class gsn:GSNElement ] ) ;
        sh:name "reviews" ;
        sh:message "An agent reviews a GSN element or an artefact."@en ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsnaug:hasRole ;
        sh:class gsnaug:Role ;
        sh:name "has role" ;
        sh:description "Several are allowed. One agent may be both the owner of a control and the officer who signs it off."@en ;
        sh:message "An agent holds a gsnaug:Role."@en ;
        sh:severity sh:Violation ;
    ] .


#################################################################
#    What the links point at
#################################################################

###  What a case assures is a system
gsnaugsh:AssuranceScopeShape rdf:type sh:NodeShape ;
    rdfs:label "Assurance scope shape"@en ;
    rdfs:comment "gsnaug:assures replaced the top object context, which used to reach the system through gsn:refersTo and so typed it a gsn:Artefact. Naming the far end is the point of the change, and this is what makes the naming stick."@en ;
    sh:targetSubjectsOf gsnaug:assures ;
    sh:property [
        sh:path gsnaug:assures ;
        sh:class gsnaug:System ;
        sh:name "assures" ;
        sh:message "What an argument assures is a gsnaug:System - the system, service or organisation the case is about."@en ;
        sh:severity sh:Violation ;
    ] .

###  gsn:GSNElement - where an element came from, and who stands behind it
gsnaugsh:ElementLinkShape rdf:type sh:NodeShape ;
    rdfs:label "Element link shape"@en ;
    sh:targetClass gsn:GSNElement ;
    sh:property [
        sh:path gsnaug:requiredBy ;
        sh:class gsnaug:Requirement ;
        sh:name "required by" ;
        sh:description "The obligation the element answers to. Its taxonomy belongs to the user's domain ontology; that it is a gsnaug:Requirement does not."@en ;
        sh:message "What an element is required by is a gsnaug:Requirement."@en ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsnaug:instantiatedFrom ;
        sh:class gsnaug:ArtefactElement ;
        sh:name "instantiated from" ;
        sh:message "An element is instantiated from a gsnaug:ArtefactElement - the row, clause or section of an artefact, not the whole artefact."@en ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsnaug:ownedBy ;
        sh:class prov:Agent ;
        sh:name "owned by" ;
        sh:message "The owner of an element is an agent."@en ;
        sh:severity sh:Violation ;
    ] .

###  gsn:AssuranceCase - the rounds a case has been through
gsnaugsh:AuditCoverageShape rdf:type sh:NodeShape ;
    rdfs:label "Audit coverage shape"@en ;
    rdfs:comment "Targeted at whatever carries gsnaug:coveredIn, so that a subject which is not a case is reported rather than retyped. Several values are expected: a case under review for three years carries three."@en ;
    sh:targetSubjectsOf gsnaug:coveredIn ;
    sh:class gsn:AssuranceCase ;
    sh:message "Only an assurance case is covered in an audit cycle. A single ask is scoped with gsnaug:raisedIn."@en ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path gsnaug:coveredIn ;
        sh:class gsnaug:AuditCycle ;
        sh:name "covered in" ;
        sh:message "A case is covered in a gsnaug:AuditCycle."@en ;
        sh:severity sh:Violation ;
    ] .
