@prefix gsnaugsh: <https://w3id.org/OntoGSN/augmentation/shapes#> .
@prefix gsnaug:   <https://w3id.org/OntoGSN/augmentation#> .
@prefix gsn:      <https://w3id.org/OntoGSN/ontology#> .
@prefix prov:     <http://www.w3.org/ns/prov#> .
@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix dc:       <http://purl.org/dc/elements/1.1/> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix terms:    <http://purl.org/dc/terms/> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@base <https://w3id.org/OntoGSN/augmentation/shapes> .


<https://w3id.org/OntoGSN/augmentation/shapes> rdf:type owl:Ontology ;
    dc:title "OntoGSN Augmentation SHACL Shapes"@en ;
    dc:description """Constraints for the OntoGSN Augmentation vocabulary (https://w3id.org/OntoGSN/augmentation).

The division of labour is the one the augmentation's own stability rules set out: OWL describes,
SHACL constrains. Every rdfs:domain and rdfs:range in the vocabulary is repeated here as a shape,
because a domain or range infers a type rather than rejecting a wrong one: a value outside the
range is silently retyped by a reasoner and reported by nothing. The shapes are what reject it.

That applies twice over to gsnaug:raisedAgainst and gsnaug:linksTo, whose far ends are a six-way
union covering everything in a case a reviewer can point at. The union is wide enough to be worth
stating and wide enough that a node outside it is almost certainly a mistake."""@en ;
    dc:source "https://w3id.org/OntoGSN/augmentation" ;
    owl:versionInfo "0.3.1" .


<https://w3id.org/OntoGSN/augmentation/shapes> sh:declare [
        sh:prefix "gsn" ;
        sh:namespace "https://w3id.org/OntoGSN/ontology#"^^xsd:anyURI ;
    ] , [
        sh:prefix "gsnaug" ;
        sh:namespace "https://w3id.org/OntoGSN/augmentation#"^^xsd:anyURI ;
    ] , [
        sh:prefix "rdf" ;
        sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ;
    ] .


#################################################################
#    Issues
#################################################################

###  gsnaug:Issue
gsnaugsh:IssueShape rdf:type sh:NodeShape ;
    rdfs:label "Issue shape"@en ;
    sh:targetClass gsnaug:Issue ;
    sh:property [
        sh:path gsnaug:raisedAgainst ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:or ( [ sh:class gsn:Argument ]
                [ sh:class gsn:Artefact ]
                [ sh:class gsn:AssuranceCase ]
                [ sh:class gsn:GSNElement ]
                [ sh:class gsn:Pattern ]
                [ sh:class gsn:Relationship ] ) ;
        sh:name "raised against" ;
        sh:description "An issue is about exactly one thing, and that thing is part of a case: an argument, an artefact, the case itself, any GSN element, a pattern, or a reified relationship."@en ;
        sh:message "An issue must be raised against exactly one thing, and that thing must be an argument, an artefact, an assurance case, a GSN element, a pattern or a reified relationship."@en ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsnaug:issueType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:in ( gsnaug:clarify gsnaug:revise gsnaug:resolve ) ;
        sh:name "issue type" ;
        sh:message "An issue must carry exactly one type: gsnaug:clarify, gsnaug:revise or gsnaug:resolve."@en ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsnaug:supersedes ;
        sh:class gsnaug:Issue ;
        sh:name "supersedes" ;
        sh:message "An issue may only supersede another issue."@en ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsnaug:issueOutcome ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "resolved" "cannot answer" "declined" "infeasible" ) ;
        sh:name "issue outcome" ;
        sh:message "An issue ends in at most one outcome, and that outcome is one of the strings \"resolved\", \"cannot answer\", \"declined\" or \"infeasible\"."@en ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsnaug:raisedIn ;
        sh:class gsnaug:AuditCycle ;
        sh:maxCount 1 ;
        sh:name "raised in" ;
        sh:message "An issue belongs to at most one audit cycle, and that value must be a gsnaug:AuditCycle."@en ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsnaug:raisedBy ;
        sh:class prov:Agent ;
        sh:maxCount 1 ;
        sh:name "raised by" ;
        sh:message "An issue is raised by at most one agent."@en ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsnaug:heldBy ;
        sh:class prov:Agent ;
        sh:maxCount 1 ;
        sh:name "held by" ;
        sh:description "One holder at a time. A further hop is a new issue that supersedes this one, which is what keeps the relay countable."@en ;
        sh:message "An issue rests with at most one agent at a time."@en ;
        sh:severity sh:Violation ;
    ] .

###  gsnaug:Issue - an issue resolved without a response
gsnaugsh:IssueClosureShape rdf:type sh:NodeShape ;
    rdfs:label "Issue closure shape"@en ;
    rdfs:comment "Only gsnaug:issueOutcome closes an issue. \"resolved\" means the raiser accepted a response, so an issue marked resolved with no response on record is either missing the response or marked wrongly. A warning, because the first is the common case. The other three outcomes end an issue without a response, and a response beside one of them is not an error: it is what the raiser declined."@en ;
    sh:targetClass gsnaug:Issue ;
    sh:sparql [
        sh:message "This issue is marked resolved, but no response to it is on record."@en ;
        sh:prefixes <https://w3id.org/OntoGSN/augmentation/shapes> ;
        sh:select """
            SELECT $this WHERE {
                $this gsnaug:issueOutcome ?outcome .
                FILTER ( STR(?outcome) = "resolved" )
                FILTER NOT EXISTS { ?response gsnaug:respondsTo $this }
            }
        """ ;
    ] ;
    sh:severity sh:Warning .

###  gsnaug:Issue - an issue may not supersede itself
gsnaugsh:IssueSupersessionShape rdf:type sh:NodeShape ;
    rdfs:label "Issue self-supersession shape"@en ;
    rdfs:comment "gsnaug:supersedes is declared owl:IrreflexiveProperty, which makes a self-superseding issue an OWL inconsistency rather than a reported problem. A reasoner is not always in the loop, so it is also checked here."@en ;
    sh:targetClass gsnaug:Issue ;
    sh:sparql [
        sh:message "An issue cannot supersede itself."@en ;
        sh:prefixes <https://w3id.org/OntoGSN/augmentation/shapes> ;
        sh:select """
            SELECT $this WHERE { $this gsnaug:supersedes $this . }
        """ ;
    ] ;
    sh:severity sh:Violation .


#################################################################
#    Responses
#################################################################

###  gsnaug:Response
gsnaugsh:ResponseShape rdf:type sh:NodeShape ;
    rdfs:label "Response shape"@en ;
    sh:targetClass gsnaug:Response ;
    sh:property [
        sh:path gsnaug:respondsTo ;
        sh:class gsnaug:Issue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "responds to" ;
        sh:message "A response replies to exactly one issue."@en ;
        sh:severity sh:Violation ;
    ] .


#################################################################
#    Artefacts and their parts
#################################################################

###  gsn:Artefact
gsnaugsh:ArtefactShape rdf:type sh:NodeShape ;
    rdfs:label "Artefact augmentation shape"@en ;
    rdfs:comment "Targets a gsnaug:ArtefactPart as well, because a part may carry the eight provenance properties, declared by hand, or gsnaug:verifiableWith inherited by A4. gsnaug:storedIn and gsnaug:replaces stay on the whole artefact."@en ;
    sh:targetClass gsn:Artefact , gsnaug:ArtefactPart ;
    sh:property [
        sh:path gsnaug:storedIn ;
        sh:class gsnaug:System ;
        sh:name "stored in" ;
        sh:message "An artefact may only be stored in a gsnaug:System, such as a gsnaug:StorageSystem."@en ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsnaug:retrievableWith ;
        sh:class gsnaug:Mechanism ;
        sh:name "retrievable with" ;
        sh:message "An artefact, or a part of one, may only be retrievable with a gsnaug:Mechanism."@en ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsnaug:retrievedWith ;
        sh:class gsnaug:Mechanism ;
        sh:name "retrieved with" ;
        sh:message "An artefact, or a part of one, may only be retrieved with a gsnaug:Mechanism."@en ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsnaug:generableWith ;
        sh:class gsnaug:Mechanism ;
        sh:name "generable with" ;
        sh:message "An artefact, or a part of one, may only be generable with a gsnaug:Mechanism."@en ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsnaug:generatedWith ;
        sh:class gsnaug:Mechanism ;
        sh:name "generated with" ;
        sh:message "An artefact, or a part of one, may only be generated with a gsnaug:Mechanism."@en ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsnaug:verifiableWith ;
        sh:class gsnaug:Mechanism ;
        sh:name "verifiable with" ;
        sh:message "An artefact, or a part of one, may only be verifiable with a gsnaug:Mechanism."@en ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsnaug:verifiedWith ;
        sh:class gsnaug:Mechanism ;
        sh:name "verified with" ;
        sh:message "An artefact, or a part of one, may only be verified with a gsnaug:Mechanism."@en ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsnaug:generatedBy ;
        sh:class prov:Agent ;
        sh:name "generated by" ;
        sh:description "The person. The tool goes on gsnaug:generatedWith."@en ;
        sh:message "An artefact, or a part of one, may only be generated by an agent."@en ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsnaug:replaces ;
        sh:class gsn:Artefact ;
        sh:name "replaces" ;
        sh:description "Artefact versions only. A reworded claim is element versioning, which this vocabulary does not model."@en ;
        sh:message "An artefact may only replace another artefact."@en ;
        sh:severity sh:Violation ;
    ] .

###  gsnaug:ArtefactPart - a part belongs to an artefact, and only a part is part of one
gsnaugsh:ArtefactPartShape rdf:type sh:NodeShape ;
    rdfs:label "Artefact part shape"@en ;
    rdfs:comment "Targeted at whatever carries gsnaug:partOf rather than at gsnaug:ArtefactPart, so that a subject the vocabulary would merely retype is reported instead."@en ;
    sh:targetSubjectsOf gsnaug:partOf ;
    sh:class gsnaug:ArtefactPart ;
    sh:message "Only a gsnaug:ArtefactPart is part of an artefact. A whole artefact inside another is a second artefact, not a part."@en ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path gsnaug:partOf ;
        sh:class gsn:Artefact ;
        sh:name "part of" ;
        sh:message "An artefact part may only be part of a gsn:Artefact."@en ;
        sh:severity sh:Violation ;
    ] .

###  gsn:Solution - the provenance belongs on the artefact, not on the reference to it
gsnaugsh:SolutionProvenanceShape rdf:type sh:NodeShape ;
    rdfs:label "Solution provenance placement shape"@en ;
    rdfs:comment "A solution is the GSN element that references an artefact; the storage location, the generating tool and the verification script are facts about the file. Hanging them on the solution splits the same fact across two nodes, and every query in this vocabulary reads them from the artefact."@en ;
    sh:targetClass gsn:Solution ;
    sh:property [
        sh:path [ sh:alternativePath ( gsnaug:storedIn
                                       gsnaug:retrievableWith
                                       gsnaug:retrievedWith
                                       gsnaug:generableWith
                                       gsnaug:generatedWith
                                       gsnaug:generatedBy
                                       gsnaug:generatedFrom
                                       gsnaug:verifiableWith
                                       gsnaug:verifiedWith
                                       gsnaug:replaces ) ] ;
        sh:maxCount 0 ;
        sh:name "evidence provenance" ;
        sh:message "Evidence provenance belongs on the artefact, not on the solution that references it. Move this to the gsn:Artefact reached by gsn:refersTo."@en ;
        sh:severity sh:Warning ;
    ] .


#################################################################
#    Mechanisms
#################################################################

###  Whether a mechanism runs without a person is a single boolean
gsnaugsh:MechanismAutomationShape rdf:type sh:NodeShape ;
    rdfs:label "Mechanism automation shape"@en ;
    rdfs:comment "Targeted at whatever carries the property rather than at gsnaug:Mechanism, so that a value on the wrong kind of node is still checked for shape. False is an assessment that the mechanism is manual; absent means none has been made."@en ;
    sh:targetSubjectsOf gsnaug:automated ;
    sh:property [
        sh:path gsnaug:automated ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:name "automated" ;
        sh:message "Whether a mechanism is automated is a single boolean."@en ;
        sh:severity sh:Violation ;
    ] .

###  What a mechanism reads and writes, and the script it is
gsnaugsh:MechanismInterfaceShape rdf:type sh:NodeShape ;
    rdfs:label "Mechanism interface shape"@en ;
    rdfs:comment "Targeted at whatever carries the three properties, so that a subject which is not a mechanism is reported rather than retyped. A term is an IRI. A term that no loaded ontology declares is a warning, not a violation: either the domain ontology is not loaded, or it withdrew the term and the mechanism now rests on nothing, and the two cannot be told apart here."@en ;
    sh:targetSubjectsOf gsnaug:readsTerm , gsnaug:writesTerm , gsnaug:script ;
    sh:class gsnaug:Mechanism ;
    sh:message "Only a gsnaug:Mechanism reads a term, writes a term or carries a script."@en ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path [ sh:alternativePath ( gsnaug:readsTerm gsnaug:writesTerm ) ] ;
        sh:nodeKind sh:IRI ;
        sh:name "term" ;
        sh:message "A term a mechanism reads or writes is an IRI: a class or a property, not a literal and not a blank node."@en ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path [ sh:alternativePath ( gsnaug:readsTerm gsnaug:writesTerm ) ] ;
        sh:or ( [ sh:class owl:Class ]
                [ sh:class rdfs:Class ]
                [ sh:class rdf:Property ]
                [ sh:class owl:ObjectProperty ]
                [ sh:class owl:DatatypeProperty ]
                [ sh:class owl:AnnotationProperty ] ) ;
        sh:name "declared term" ;
        sh:message "No loaded ontology declares this term as a class or a property. Either the domain ontology is not loaded, or it no longer declares the term."@en ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path gsnaug:script ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:name "script" ;
        sh:message "A mechanism carries one script, as a string."@en ;
        sh:severity sh:Violation ;
    ] .

###  What a mechanism needs in order to run is a resource, not a literal
gsnaugsh:MechanismRequirementShape rdf:type sh:NodeShape ;
    rdfs:label "Mechanism requirement shape"@en ;
    rdfs:comment "Targeted at gsnaug:Mechanism and not at every subject of dcterms:requires, which other vocabularies use on other things. What the far end is - an interpreter, a package, a container image, a credential - belongs to a domain ontology; that it is a node and not a string does not."@en ;
    sh:targetClass gsnaug:Mechanism ;
    sh:property [
        sh:path terms:requires ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:name "requires" ;
        sh:message "What a mechanism requires in order to run is a resource, not a literal."@en ;
        sh:severity sh:Violation ;
    ] .


#################################################################
#    Agents and roles
#################################################################

###  Whatever is owned or reviewed is an artefact or an element, and the owner or reviewer is a named agent
gsnaugsh:AccountabilityShape rdf:type sh:NodeShape ;
    rdfs:label "Accountability shape"@en ;
    rdfs:comment "Targeted at whatever carries the property rather than at the two classes, so that a subject the vocabulary would merely retype is reported instead. The owner must be named, not a blank node: accountability that cannot be cited is not accountability."@en ;
    sh:targetSubjectsOf gsnaug:ownedBy , gsnaug:reviewedBy ;
    sh:or ( [ sh:class gsn:Artefact ] [ sh:class gsn:GSNElement ] ) ;
    sh:message "Only an artefact or a GSN element is owned or reviewed."@en ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path gsnaug:ownedBy ;
        sh:class prov:Agent ;
        sh:nodeKind sh:IRI ;
        sh:name "owned by" ;
        sh:message "The owner of an element or artefact is a named agent."@en ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsnaug:reviewedBy ;
        sh:class prov:Agent ;
        sh:nodeKind sh:IRI ;
        sh:name "reviewed by" ;
        sh:message "The reviewer of an element or artefact is a named agent."@en ;
        sh:severity sh:Violation ;
    ] .

###  The agent who reviews an element or artefact is not the agent who owns it
gsnaugsh:IndependenceShape rdf:type sh:NodeShape ;
    rdfs:label "Independence shape"@en ;
    rdfs:comment "A warning, not a violation: an owner reading their own draft is a legitimate state of a case under construction, and what the shape reports is that the review on record is not an independent one."@en ;
    sh:targetSubjectsOf gsnaug:reviewedBy ;
    sh:property [
        sh:path gsnaug:reviewedBy ;
        sh:disjoint gsnaug:ownedBy ;
        sh:name "reviewed by" ;
        sh:message "The reviewer of an element or artefact is also its owner, so the review is not independent."@en ;
        sh:severity sh:Warning ;
    ] .

###  Whoever holds a role is an agent, and what is held is a role
gsnaugsh:AgentShape rdf:type sh:NodeShape ;
    rdfs:label "Agent shape"@en ;
    rdfs:comment "Targeted at whatever carries the property rather than at prov:Agent, so that a subject the vocabulary would merely retype is reported instead."@en ;
    sh:targetSubjectsOf gsnaug:hasRole ;
    sh:class prov:Agent ;
    sh:message "Only an agent holds a role."@en ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path gsnaug:hasRole ;
        sh:class gsnaug:Role ;
        sh:name "has role" ;
        sh:description "Several are allowed. One agent may be both the owner of a control and the officer who signs it off."@en ;
        sh:message "An agent holds a gsnaug:Role."@en ;
        sh:severity sh:Violation ;
    ] .


#################################################################
#    What the links point at
#################################################################

###  What a case assures is a system, and only an argument, a case or a goal assures one
gsnaugsh:AssuranceScopeShape rdf:type sh:NodeShape ;
    rdfs:label "Assurance scope shape"@en ;
    rdfs:comment "gsnaug:assures complements the top object context, which reaches the system through gsn:refersTo and so types it a gsn:Artefact. Naming the far end is the point of the property, and this is what makes the naming stick."@en ;
    sh:targetSubjectsOf gsnaug:assures ;
    sh:or ( [ sh:class gsn:Argument ] [ sh:class gsn:AssuranceCase ] [ sh:class gsn:Goal ] ) ;
    sh:message "Only an argument, an assurance case or a goal assures a system."@en ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path gsnaug:assures ;
        sh:class gsnaug:System ;
        sh:name "assures" ;
        sh:message "What an argument assures is a gsnaug:System - the system, service or organisation the case is about."@en ;
        sh:severity sh:Violation ;
    ] .

###  gsn:GSNElement - where an element came from, and what requires it
gsnaugsh:ElementLinkShape rdf:type sh:NodeShape ;
    rdfs:label "Element link shape"@en ;
    sh:targetClass gsn:GSNElement ;
    sh:property [
        sh:path gsnaug:requiredBy ;
        sh:class gsnaug:Requirement ;
        sh:name "required by" ;
        sh:description "The obligation the element answers to. Its taxonomy belongs to the user's domain ontology; that it is a gsnaug:Requirement does not."@en ;
        sh:message "What an element is required by is a gsnaug:Requirement."@en ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsnaug:instantiatedFrom ;
        sh:class gsnaug:ArtefactPart ;
        sh:name "instantiated from" ;
        sh:message "An element is instantiated from a gsnaug:ArtefactPart - the row, clause or section of an artefact, not the whole artefact."@en ;
        sh:severity sh:Violation ;
    ] .

###  gsn:AssuranceCase - the rounds a case has been through
gsnaugsh:AuditCoverageShape rdf:type sh:NodeShape ;
    rdfs:label "Audit coverage shape"@en ;
    rdfs:comment "Targeted at whatever carries gsnaug:coveredIn, so that a subject which is not a case is reported rather than retyped. Several values are expected: a case under review for three years carries three."@en ;
    sh:targetSubjectsOf gsnaug:coveredIn ;
    sh:class gsn:AssuranceCase ;
    sh:message "Only an assurance case is covered in an audit cycle. A single ask is scoped with gsnaug:raisedIn."@en ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path gsnaug:coveredIn ;
        sh:class gsnaug:AuditCycle ;
        sh:name "covered in" ;
        sh:message "A case is covered in a gsnaug:AuditCycle."@en ;
        sh:severity sh:Violation ;
    ] .

###  gsnaug:linksTo - the near end is GSN, the far end is anything
gsnaugsh:LinkShape rdf:type sh:NodeShape ;
    rdfs:label "Link shape"@en ;
    rdfs:comment "The range is owl:Thing on purpose, so only the domain is checked: the link starts from something in a case."@en ;
    sh:targetSubjectsOf gsnaug:linksTo ;
    sh:or ( [ sh:class gsn:Argument ]
            [ sh:class gsn:Artefact ]
            [ sh:class gsn:AssuranceCase ]
            [ sh:class gsn:GSNElement ]
            [ sh:class gsn:Pattern ]
            [ sh:class gsn:Relationship ] ) ;
    sh:message "A custom link starts from an argument, an artefact, an assurance case, a GSN element, a pattern or a reified relationship."@en ;
    sh:severity sh:Violation .
