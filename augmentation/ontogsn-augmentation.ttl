@prefix gsnaug:     <https://w3id.org/OntoGSN/augmentation#> .
@prefix gsnaugswrl: <https://w3id.org/OntoGSN/augmentation/swrl#> .
@prefix gsn:        <https://w3id.org/OntoGSN/ontology#> .
@prefix prov:       <http://www.w3.org/ns/prov#> .
@prefix cc:         <http://creativecommons.org/ns#> .
@prefix dc:         <http://purl.org/dc/elements/1.1/> .
@prefix owl:        <http://www.w3.org/2002/07/owl#> .
@prefix rdf:        <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:     <http://schema.org/> .
@prefix skos:       <http://www.w3.org/2004/02/skos/core#> .
@prefix swrl:       <http://www.w3.org/2003/11/swrl#> .
@prefix swrla:      <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#> .
@prefix terms:      <http://purl.org/dc/terms/> .
@prefix vann:       <http://purl.org/vocab/vann/> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@base <https://w3id.org/OntoGSN/augmentation> .


<https://w3id.org/OntoGSN/augmentation> rdf:type owl:Ontology ;
    owl:imports <https://w3id.org/OntoGSN/ontology> ,
                <http://www.w3.org/ns/prov-o> ;
    cc:license "https://creativecommons.org/licenses/by/4.0/" ;
    dc:title "OntoGSN Augmentation"@en ;
    dc:creator "Tomas Bueno Momčilović"@en ;
    dc:publisher "https://www.fortiss.org/"@en ;
    dc:source "https://w3id.org/OntoGSN/ontology" ;
    dc:description """OntoGSN Augmentation is a container for custom extensions to the OntoGSN ontology. It contains the terms for linking a GSN assurance case to external non-GSN elements. Current version includes elements that are common to software auditing processes: the people and roles behind an element; the mechanisms for generating, retrieving and verifying an evidence artefact, or verifying that the context still holds; the issues raised against the case as defeaters, and their answers; the (regulatory) requirement a claim answers to; and the system that the case assures."""@en ;
    terms:created "2026-08-17"^^xsd:date ;
    vann:preferredNamespacePrefix "gsnaug" ;
    vann:preferredNamespaceUri "https://w3id.org/OntoGSN/augmentation#" ;
    owl:versionInfo "0.3.1" ;
    gsnaug:augmentedOntoGSNVersion "1.2.4" .

gsnaug:augmentedOntoGSNVersion rdf:type owl:AnnotationProperty ;
    rdfs:label "augmented OntoGSN version"@en ;
    rdfs:comment "The version of OntoGSN this augmentation was written against."@en .

#################################################################
#    Classes
#################################################################

gsn:Artefact rdfs:subClassOf prov:Entity .

gsnaug:ArtefactPart rdf:type owl:Class ;
    rdfs:label "Artefact Part"@en ;
    skos:altLabel "Artefact Element"@en ;
    skos:definition "A part of an artefact identified in its own right."@en .

gsnaug:Mechanism rdf:type owl:Class ;
    rdfs:label "Mechanism"@en ;
    skos:definition "Means through which some GSN-linked artefact is generated, retrieved or verified."@en ;
    skos:note "Used for maintaining the continuity between a gsn:Artefact and a gsn:GSNElement, and automating the respective activities with rules (where possible). A mechanism states which domain terms it depends on with gsnaug:readsTerm and gsnaug:writesTerm. A mechanism can be a SHACL shape, a SWRL rule, or a SPARQL query. A mechanism that is code carries its text in gsnaug:script. One that is neither, such as an interview, carries only its provenance."@en .

gsnaug:Issue rdf:type owl:Class ;
    rdfs:label "Issue"@en ;
    skos:altLabel "Request"@en ;
    skos:definition "An ask raised by a reviewer against an element in an assurance case."@en .

gsnaug:Answer rdf:type owl:Class ;
    rdfs:label "Answer"@en ;
    skos:definition "The response to a reviewer's ask that aims to close an issue."@en .

gsnaug:AuditCycle rdf:type owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Audit Cycle"@en ;
    skos:definition "One round of review, from the moment it opens to the moment its report is issued."@en ;
    skos:note "Start and end are prov:startedAtTime and prov:endedAtTime, which apply because an audit cycle is a prov:Activity. An issue carries its own date with dcterms:created."@en .

gsnaug:System rdf:type owl:Class ;
    rdfs:label "System"@en ;
    skos:altLabel "Assured system"@en ;
    skos:definition "The subject of an assurance case."@en ;
    skos:note "Can include the system where the artefact is stored."@en .

gsnaug:Requirement rdf:type owl:Class ;
    rdfs:label "Requirement"@en ;
    skos:altLabel "Obligation"@en ;
    skos:definition "The object of an assurance case; a (regulatory) statement or obligation that an element of the case answers to."@en ;
    skos:scopeNote "Distinct from gsnprov:Requirement, which records what OntoGSN itself set out to do."@en .

gsnaug:Role rdf:type owl:Class ;
    rdfs:label "Role"@en ;
    skos:definition "A role an agent holds in the auditing process."@en ;
    skos:scopeNote "One agent may hold several roles, and a role outlives whoever holds it."@en .

#################################################################
#    Object Properties
#################################################################

gsnaug:retrievableWith rdf:type owl:ObjectProperty ;
    rdfs:domain [ rdf:type owl:Class ;
                  owl:unionOf ( gsn:Artefact
                                gsnaug:ArtefactPart
                              )
                ] ;
    rdfs:range gsnaug:Mechanism ;
    rdfs:label "retrievable with"@en ;
    skos:definition "How can the artefact be fetched."@en ;
    skos:note "Describes future access via, e.g., queries."@en .

gsnaug:retrievedWith rdf:type owl:ObjectProperty ;
    rdfs:domain [ rdf:type owl:Class ;
                  owl:unionOf ( gsn:Artefact
                                gsnaug:ArtefactPart
                              )
                ] ;
    rdfs:range gsnaug:Mechanism ;
    rdfs:label "retrieved with"@en ;
    skos:definition "How was the artefact fetched."@en .

gsnaug:generableWith rdf:type owl:ObjectProperty ;
    rdfs:domain [ rdf:type owl:Class ;
                  owl:unionOf ( gsn:Artefact
                                gsnaug:ArtefactPart
                              )
                ] ;
    rdfs:range gsnaug:Mechanism ;
    rdfs:label "generable with"@en ;
    skos:definition "How is the artefact meant to be produced."@en .

gsnaug:generatedWith rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasAttributedTo ;
    rdfs:domain [ rdf:type owl:Class ;
                  owl:unionOf ( gsn:Artefact
                                gsnaug:ArtefactPart
                              )
                ] ;
    rdfs:range gsnaug:Mechanism ;
    rdfs:label "generated with"@en ;
    skos:definition "How was the artefact produced."@en .

gsnaug:verifiableWith rdf:type owl:ObjectProperty ;
    rdfs:domain [ rdf:type owl:Class ;
                  owl:unionOf ( gsn:Artefact
                                gsnaug:ArtefactPart
                              )
                ] ;
    rdfs:range gsnaug:Mechanism ;
    rdfs:label "verified with"@en ;
    skos:definition "What can check the truth or appropriateness of the artefact."@en .

gsnaug:verifiedWith rdf:type owl:ObjectProperty ;
    rdfs:domain [ rdf:type owl:Class ;
                  owl:unionOf ( gsn:Artefact
                                gsnaug:ArtefactPart
                              )
                ] ;
    rdfs:range gsnaug:Mechanism ;
    rdfs:label "verified with"@en ;
    skos:definition "What checked the truth or appropriateness of the artefact."@en ;
    skos:note "The mechanism that ran, which is provenance. Distinct from a shape or a rule that decides whether a claim holds."@en .

gsnaug:readsTerm rdf:type owl:ObjectProperty ;
    rdfs:domain gsnaug:Mechanism ;
    rdfs:label "reads term"@en ;
    skos:definition "A class or property of a domain ontology that the mechanism depends on."@en ;
    skos:note "The term is used as an individual (OWL 2 punning), so no range is declared. Used for change impact analysis: which artefacts, and through them which claims, rest on a term that the domain ontology changed or withdrew."@en .

gsnaug:writesTerm rdf:type owl:ObjectProperty ;
    rdfs:domain gsnaug:Mechanism ;
    rdfs:label "writes term"@en ;
    skos:definition "A class or property of a domain ontology that the mechanism asserts in its result."@en ;
    skos:note "Same form as gsnaug:readsTerm. Together they let the output of one mechanism be matched against the input of another."@en .

gsnaug:storedIn rdf:type owl:ObjectProperty ;
    rdfs:domain gsn:Artefact ;
    rdfs:range gsnaug:System ;
    rdfs:label "stored in"@en ;
    skos:definition "Where the artefact is kept."@en .

gsnaug:partOf rdf:type owl:ObjectProperty ;
    rdfs:domain gsnaug:ArtefactPart ;
    rdfs:range gsn:Artefact ;
    rdfs:label "part of"@en ;
    skos:definition "What part is contained by an artefact."@en ;
    skos:note "Mereorogical relation. Used when an artefact part (e.g., Excel sheet, document page) can be retrieved from an existing artefact (e.g., Excel table, document), without being stored as an artefact itself."@en .

gsnaug:replaces rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasRevisionOf ;
    rdfs:domain gsn:Artefact ;
    rdfs:range gsn:Artefact ;
    rdfs:label "replaces"@en ;
    skos:definition "What older artefact does the newer artefact substitute."@en ;
    skos:note "Artefacts only. Does not replace a version control system, but instead provides a trace of versions submitted for auditing."@en .

gsnaug:generatedFrom rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    rdfs:domain [ rdf:type owl:Class ;
                  owl:unionOf ( gsn:Artefact
                                gsnaug:ArtefactPart
                              )
                ] ;
    rdfs:range prov:Entity ;
    rdfs:label "generated from"@en ;
    skos:definition "The system the artefact was drawn from."@en ;
    skos:note "Used when the artefact is generated or retrieved from another system (e.g., monitoring tool) or even the system in question."@en .

gsnaug:generatedBy rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasAttributedTo ;
    rdfs:domain [ rdf:type owl:Class ;
                  owl:unionOf ( gsn:Artefact
                                gsnaug:ArtefactPart
                              )
                ] ;
    rdfs:range prov:Agent ;
    rdfs:label "generated by"@en ;
    skos:definition "By whom was the artefact produced."@en .

gsnaug:assures rdf:type owl:ObjectProperty ;
    rdfs:domain [ rdf:type owl:Class ;
                  owl:unionOf ( gsn:Argument
                                gsn:AssuranceCase
                                gsn:Goal
                              )
                ] ;
    rdfs:range gsnaug:System ;
    rdfs:label "assures"@en ;
    skos:definition "What the case is meant to assure."@en ;
    skos:note "Shortcut or complementary element to the top-level context. GSN recommends having the top-level context with the system, but does not require it, so a conforming case may omit it."@en .

gsnaug:requiredBy rdf:type owl:ObjectProperty ;
    rdfs:domain gsn:GSNElement ;
    rdfs:range gsnaug:Requirement ;
    rdfs:label "required by"@en ;
    skos:definition "The requirement, regulatory statement or obligation that this element answers to."@en ;
    skos:note "Close in intent to dcterms:conformsTo, and kept separate because conformance is a claim about an artefact meeting a standard, while this records where a claim in the argument came from."@en .

gsnaug:ownedBy rdf:type owl:ObjectProperty ;
    rdfs:domain [ rdf:type owl:Class ;
                  owl:unionOf ( gsn:Artefact
                                gsn:GSNElement
                              )
                ] ;
    rdfs:range prov:Agent ;
    rdfs:label "owned by"@en ;
    skos:definition "The agent who stands behind this element or artefact."@en .

gsnaug:reviewedBy rdf:type owl:ObjectProperty ;
    rdfs:domain [ rdf:type owl:Class ;
                  owl:unionOf ( gsn:Artefact
                                gsn:GSNElement
                              )
                ] ;
    rdfs:range prov:Agent ;
    rdfs:label "reviewed by"@en ;
    skos:definition "The agent who checked this element or artefact."@en .

gsnaug:hasRole rdf:type owl:ObjectProperty ;
    rdfs:domain prov:Agent ;
    rdfs:range gsnaug:Role ;
    rdfs:label "has role"@en ;
    skos:definition "A role the agent holds in the review process."@en .

gsnaug:raisedAgainst rdf:type owl:ObjectProperty ;
    rdfs:domain gsnaug:Issue ;
    rdfs:range [ rdf:type owl:Class ;
                 owl:unionOf ( gsn:Argument
                               gsn:Artefact
                               gsnaug:ArtefactPart
                               gsn:AssuranceCase
                               gsn:GSNElement
                               gsn:Pattern
                               gsn:Relationship
                             )
               ] ;
    rdfs:label "raised against"@en ;
    skos:definition "What the issue is about."@en .

gsnaug:answers rdf:type owl:ObjectProperty ;
    rdfs:domain gsnaug:Answer ;
    rdfs:range gsnaug:Issue ;
    rdfs:label "answers"@en ;
    skos:definition "The issue this answer closes."@en .

gsnaug:supersedes rdf:type owl:ObjectProperty ,
                           owl:IrreflexiveProperty ;
    rdfs:domain gsnaug:Issue ;
    rdfs:range gsnaug:Issue ;
    rdfs:label "supersedes"@en ;
    skos:definition "An older issue substituted by a newer issue."@en .

gsnaug:raisedBy rdf:type owl:ObjectProperty ;
    rdfs:domain gsnaug:Issue ;
    rdfs:range prov:Agent ;
    rdfs:label "raised by"@en ;
    skos:definition "The agent who raised the issue."@en ;
    skos:note "Distinct from gsnaug:ownedBy, which says who stands behind a GSN element. The raiser of an ask does not change; who has to answer it does."@en .

gsnaug:heldBy rdf:type owl:ObjectProperty ;
    rdfs:domain gsnaug:Issue ;
    rdfs:range prov:Agent ;
    rdfs:label "held by"@en ;
    skos:definition "The agent the issue rests with: whoever has to answer it now."@en ;
    skos:note "One issue per relay hop, chained with gsnaug:supersedes, rather than one issue whose holder is overwritten. An overwritten holder leaves no trace of the hops, and the number of escalations is a count of them."@en .

gsnaug:raisedIn rdf:type owl:ObjectProperty ;
    rdfs:domain gsnaug:Issue ;
    rdfs:range gsnaug:AuditCycle ;
    rdfs:label "raised in"@en ;
    skos:definition "The audit cycle the issue was raised in."@en ;
    skos:note "Used for issue provenance. Particularly useful for longer-standing issues."@en .

gsnaug:coveredIn rdf:type owl:ObjectProperty ;
    rdfs:domain gsn:AssuranceCase ;
    rdfs:range gsnaug:AuditCycle ;
    rdfs:label "covered in"@en ;
    skos:definition "An audit cycle that reviewed this case."@en ;
    skos:note "Used for assurance-case provenance. Particularly useful for case reuse."@en .

gsnaug:instantiatedFrom rdf:type owl:ObjectProperty ;
    rdfs:domain gsn:GSNElement ;
    rdfs:range gsnaug:ArtefactPart ;
    rdfs:label "instantiated from"@en ;
    skos:definition "The part of an artefact that produced this element."@en ;
    skos:note "Completes the pattern-instantiation loop. gsn:attachedTo points from the instantiation data reference to the element it governs, and since OntoGSN 1.2.4 gsn:refersTo points from that reference to the artefact holding the data; this says which part of that artefact produced which element. The part reaches its artefact by gsnaug:partOf."@en .

gsnaug:linksTo rdf:type owl:ObjectProperty ;
    rdfs:label "links to"@en ;
    rdfs:domain [ rdf:type owl:Class ;
                owl:unionOf ( gsn:Argument
                            gsn:Artefact
                            gsnaug:ArtefactPart
                            gsn:AssuranceCase
                            gsn:GSNElement
                            gsn:Pattern
                            gsn:Relationship
                            )
            ] ;
    rdfs:range owl:Thing ;
    skos:definition "A custom link from anything GSN-related to anything non-GSN-related."@en ;
    skos:note "Used for reaching a term in another ontology that no other property here covers."@en .

gsnaug:tag rdf:type owl:DatatypeProperty ;
    rdfs:domain [ rdf:type owl:Class ;
                owl:unionOf ( gsn:Argument
                            gsn:Artefact
                            gsnaug:ArtefactPart
                            gsn:AssuranceCase
                            gsn:GSNElement
                            gsn:Pattern
                            gsn:Relationship
                            )
            ] ;
    rdfs:label "tag"@en ;
    skos:definition "An informal keyword for adding custom metadata as literals."@en ;
    skos:note "Informal. Used for custom filtering and grouping."@en .


#################################################################
#    Data properties
#################################################################

gsnaug:automated rdf:type owl:DatatypeProperty ;
    rdfs:domain gsnaug:Mechanism ;
    rdfs:range xsd:boolean ;
    rdfs:label "automated"@en ;
    skos:definition "Whether the mechanism can be executed without manual intervention."@en ;
    skos:note "Used for automating the execution of retrieval, generation or verification of artefacts."@en .

gsnaug:script rdf:type owl:DatatypeProperty ;
    rdfs:domain gsnaug:Mechanism ;
    rdfs:range xsd:string ;
    rdfs:label "script"@en ;
    skos:definition "The text of the script or command that carries the mechanism out."@en ;
    skos:note "For a mechanism that is code rather than a shape, a rule or a query, which would be in the graph as that node. A PowerShell or shell script, a command line, a pipeline definition. Name the interpreter in the text itself, as a shebang or a PowerShell #requires line, since the literal carries no language tag. A person can read the text, but no tool here derives gsnaug:readsTerm from it, so the terms are declared by hand."@en .

gsnaug:issueOutcome rdf:type owl:DatatypeProperty ;
    rdfs:domain gsnaug:Issue ;
    rdfs:range [ rdf:type rdfs:Datatype ;
                 owl:oneOf ( "resolved" "cannot answer" "declined" "infeasible" )
               ] ;
    rdfs:label "issue outcome"@en ;
    skos:definition "How the issue ended."@en .

gsnaug:issueType rdf:type owl:ObjectProperty ;
    rdfs:domain gsnaug:Issue ;
    rdfs:range [ rdf:type owl:Class ;
                 owl:oneOf ( gsnaug:clarify gsnaug:revise gsnaug:resolve )
               ] ;
    rdfs:label "issue type"@en ;
    skos:definition "Which of the three asks this issue is: clarify, revise or resolve."@en .

#################################################################
#    Individuals
#################################################################

gsnaug:clarify rdf:type owl:NamedIndividual ;
    rdfs:label "clarify"@en ;
    skos:definition "An ask to explain the element without changing it."@en .

gsnaug:revise rdf:type owl:NamedIndividual ;
    rdfs:label "revise"@en ;
    skos:definition "An ask to change the element."@en .

gsnaug:resolve rdf:type owl:NamedIndividual ;
    rdfs:label "resolve"@en ;
    skos:definition "An ask to address a defeat of the element."@en .

#################################################################
#    SWRL rules
#################################################################

gsnaugswrl:I  rdf:type swrl:Variable .
gsnaugswrl:E  rdf:type swrl:Variable .
gsnaugswrl:P  rdf:type swrl:Variable .
gsnaugswrl:A  rdf:type swrl:Variable .
gsnaugswrl:X  rdf:type swrl:Variable .


###  A2a
gsnaug:ReviseIssueChallengesGoal swrla:isRuleEnabled "true"^^xsd:boolean ;
   rdfs:label "Revise Issue Challenges Goal" ;
   rdfs:comment "IF Issue I is of type revise AND is raised against Goal E THEN I is a goal that challenges E, and is true"@en ;
   rdf:type swrl:Imp ;
   swrl:body [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:ClassAtom ;
                           swrl:classPredicate gsnaug:Issue ;
                           swrl:argument1 gsnaugswrl:I
                         ] ;
               rdf:rest [ rdf:type swrl:AtomList ;
                          rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                      swrl:propertyPredicate gsnaug:issueType ;
                                      swrl:argument1 gsnaugswrl:I ;
                                      swrl:argument2 gsnaug:revise
                                    ] ;
                          rdf:rest [ rdf:type swrl:AtomList ;
                                     rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                 swrl:propertyPredicate gsnaug:raisedAgainst ;
                                                 swrl:argument1 gsnaugswrl:I ;
                                                 swrl:argument2 gsnaugswrl:E
                                               ] ;
                                     rdf:rest [ rdf:type swrl:AtomList ;
                                                rdf:first [ rdf:type swrl:ClassAtom ;
                                                            swrl:classPredicate gsn:Goal ;
                                                            swrl:argument1 gsnaugswrl:E
                                                          ] ;
                                                rdf:rest rdf:nil
                                              ]
                                   ]
                        ]
             ] ;
   swrl:head [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:ClassAtom ;
                           swrl:classPredicate gsn:Goal ;
                           swrl:argument1 gsnaugswrl:I
                         ] ;
               rdf:rest [ rdf:type swrl:AtomList ;
                          rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                                      swrl:propertyPredicate gsn:true ;
                                      swrl:argument1 gsnaugswrl:I ;
                                      swrl:argument2 "true"^^xsd:boolean
                                    ] ;
                          rdf:rest [ rdf:type swrl:AtomList ;
                                     rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                 swrl:propertyPredicate gsn:challenges ;
                                                 swrl:argument1 gsnaugswrl:I ;
                                                 swrl:argument2 gsnaugswrl:E
                                               ] ;
                                     rdf:rest rdf:nil
                                   ]
                        ]
             ] .


###  A2b
gsnaug:ReviseIssueChallengesSolution swrla:isRuleEnabled "true"^^xsd:boolean ;
   rdfs:label "Revise Issue Challenges Solution" ;
   rdfs:comment "IF Issue I is of type revise AND is raised against Solution E THEN I is a goal that challenges E, and is true"@en ;
   rdf:type swrl:Imp ;
   swrl:body [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:ClassAtom ;
                           swrl:classPredicate gsnaug:Issue ;
                           swrl:argument1 gsnaugswrl:I
                         ] ;
               rdf:rest [ rdf:type swrl:AtomList ;
                          rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                      swrl:propertyPredicate gsnaug:issueType ;
                                      swrl:argument1 gsnaugswrl:I ;
                                      swrl:argument2 gsnaug:revise
                                    ] ;
                          rdf:rest [ rdf:type swrl:AtomList ;
                                     rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                 swrl:propertyPredicate gsnaug:raisedAgainst ;
                                                 swrl:argument1 gsnaugswrl:I ;
                                                 swrl:argument2 gsnaugswrl:E
                                               ] ;
                                     rdf:rest [ rdf:type swrl:AtomList ;
                                                rdf:first [ rdf:type swrl:ClassAtom ;
                                                            swrl:classPredicate gsn:Solution ;
                                                            swrl:argument1 gsnaugswrl:E
                                                          ] ;
                                                rdf:rest rdf:nil
                                              ]
                                   ]
                        ]
             ] ;
   swrl:head [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:ClassAtom ;
                           swrl:classPredicate gsn:Goal ;
                           swrl:argument1 gsnaugswrl:I
                         ] ;
               rdf:rest [ rdf:type swrl:AtomList ;
                          rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                                      swrl:propertyPredicate gsn:true ;
                                      swrl:argument1 gsnaugswrl:I ;
                                      swrl:argument2 "true"^^xsd:boolean
                                    ] ;
                          rdf:rest [ rdf:type swrl:AtomList ;
                                     rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                 swrl:propertyPredicate gsn:challenges ;
                                                 swrl:argument1 gsnaugswrl:I ;
                                                 swrl:argument2 gsnaugswrl:E
                                               ] ;
                                     rdf:rest rdf:nil
                                   ]
                        ]
             ] .


###  A3a
gsnaug:ResolveIssueDefeatsGoal swrla:isRuleEnabled "true"^^xsd:boolean ;
   rdfs:label "Resolve Issue Defeats Goal" ;
   rdfs:comment "IF Issue I is of type resolve AND is raised against Goal E THEN I is a goal that challenges E, and E is defeated"@en ;
   rdf:type swrl:Imp ;
   swrl:body [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:ClassAtom ;
                           swrl:classPredicate gsnaug:Issue ;
                           swrl:argument1 gsnaugswrl:I
                         ] ;
               rdf:rest [ rdf:type swrl:AtomList ;
                          rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                      swrl:propertyPredicate gsnaug:issueType ;
                                      swrl:argument1 gsnaugswrl:I ;
                                      swrl:argument2 gsnaug:resolve
                                    ] ;
                          rdf:rest [ rdf:type swrl:AtomList ;
                                     rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                 swrl:propertyPredicate gsnaug:raisedAgainst ;
                                                 swrl:argument1 gsnaugswrl:I ;
                                                 swrl:argument2 gsnaugswrl:E
                                               ] ;
                                     rdf:rest [ rdf:type swrl:AtomList ;
                                                rdf:first [ rdf:type swrl:ClassAtom ;
                                                            swrl:classPredicate gsn:Goal ;
                                                            swrl:argument1 gsnaugswrl:E
                                                          ] ;
                                                rdf:rest rdf:nil
                                              ]
                                   ]
                        ]
             ] ;
   swrl:head [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:ClassAtom ;
                           swrl:classPredicate gsn:Goal ;
                           swrl:argument1 gsnaugswrl:I
                         ] ;
               rdf:rest [ rdf:type swrl:AtomList ;
                          rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                      swrl:propertyPredicate gsn:challenges ;
                                      swrl:argument1 gsnaugswrl:I ;
                                      swrl:argument2 gsnaugswrl:E
                                    ] ;
                          rdf:rest [ rdf:type swrl:AtomList ;
                                     rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                                                 swrl:propertyPredicate gsn:defeated ;
                                                 swrl:argument1 gsnaugswrl:E ;
                                                 swrl:argument2 "true"^^xsd:boolean
                                               ] ;
                                     rdf:rest rdf:nil
                                   ]
                        ]
             ] .


###  A3b
gsnaug:ResolveIssueDefeatsSolution swrla:isRuleEnabled "true"^^xsd:boolean ;
   rdfs:label "Resolve Issue Defeats Solution" ;
   rdfs:comment "IF Issue I is of type resolve AND is raised against Solution E THEN I is a goal that challenges E, and E is defeated"@en ;
   rdf:type swrl:Imp ;
   swrl:body [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:ClassAtom ;
                           swrl:classPredicate gsnaug:Issue ;
                           swrl:argument1 gsnaugswrl:I
                         ] ;
               rdf:rest [ rdf:type swrl:AtomList ;
                          rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                      swrl:propertyPredicate gsnaug:issueType ;
                                      swrl:argument1 gsnaugswrl:I ;
                                      swrl:argument2 gsnaug:resolve
                                    ] ;
                          rdf:rest [ rdf:type swrl:AtomList ;
                                     rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                 swrl:propertyPredicate gsnaug:raisedAgainst ;
                                                 swrl:argument1 gsnaugswrl:I ;
                                                 swrl:argument2 gsnaugswrl:E
                                               ] ;
                                     rdf:rest [ rdf:type swrl:AtomList ;
                                                rdf:first [ rdf:type swrl:ClassAtom ;
                                                            swrl:classPredicate gsn:Solution ;
                                                            swrl:argument1 gsnaugswrl:E
                                                          ] ;
                                                rdf:rest rdf:nil
                                              ]
                                   ]
                        ]
             ] ;
   swrl:head [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:ClassAtom ;
                           swrl:classPredicate gsn:Goal ;
                           swrl:argument1 gsnaugswrl:I
                         ] ;
               rdf:rest [ rdf:type swrl:AtomList ;
                          rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                      swrl:propertyPredicate gsn:challenges ;
                                      swrl:argument1 gsnaugswrl:I ;
                                      swrl:argument2 gsnaugswrl:E
                                    ] ;
                          rdf:rest [ rdf:type swrl:AtomList ;
                                     rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                                                 swrl:propertyPredicate gsn:defeated ;
                                                 swrl:argument1 gsnaugswrl:E ;
                                                 swrl:argument2 "true"^^xsd:boolean
                                               ] ;
                                     rdf:rest rdf:nil
                                   ]
                        ]
             ] .


###  A4
gsnaug:PartInheritsVerifiableWith swrla:isRuleEnabled "true"^^xsd:boolean ;
   rdfs:label "Part Inherits Verifiable With" ;
   rdfs:comment "IF ArtefactPart P is part of Artefact A AND A is verifiable with X THEN P is verifiable with X"@en ;
   rdf:type swrl:Imp ;
   swrl:body [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:ClassAtom ;
                           swrl:classPredicate gsnaug:ArtefactPart ;
                           swrl:argument1 gsnaugswrl:P
                         ] ;
               rdf:rest [ rdf:type swrl:AtomList ;
                          rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                      swrl:propertyPredicate gsnaug:partOf ;
                                      swrl:argument1 gsnaugswrl:P ;
                                      swrl:argument2 gsnaugswrl:A
                                    ] ;
                          rdf:rest [ rdf:type swrl:AtomList ;
                                     rdf:first [ rdf:type swrl:ClassAtom ;
                                                 swrl:classPredicate gsn:Artefact ;
                                                 swrl:argument1 gsnaugswrl:A
                                               ] ;
                                     rdf:rest [ rdf:type swrl:AtomList ;
                                                rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                            swrl:propertyPredicate gsnaug:verifiableWith ;
                                                            swrl:argument1 gsnaugswrl:A ;
                                                            swrl:argument2 gsnaugswrl:X
                                                          ] ;
                                                rdf:rest rdf:nil
                                              ]
                                   ]
                        ]
             ] ;
   swrl:head [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                           swrl:propertyPredicate gsnaug:verifiableWith ;
                           swrl:argument1 gsnaugswrl:P ;
                           swrl:argument2 gsnaugswrl:X
                         ] ;
               rdf:rest rdf:nil
             ] .
