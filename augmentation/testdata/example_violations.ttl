@prefix bad:    <https://example.org/bad#> .
@prefix gsn:    <https://w3id.org/OntoGSN/ontology#> .
@prefix gsnaug: <https://w3id.org/OntoGSN/augmentation#> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix schema: <http://schema.org/> .
@prefix terms:  <http://purl.org/dc/terms/> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

#  Deliberately wrong. Every node here must be reported by exactly the shape named above it;
#  a shape that stops firing on this file has stopped constraining anything.

#  IssueShape - an issue is about exactly one thing
bad:I-two-targets a gsnaug:Issue ; schema:identifier "IB1" ;
    gsnaug:issueType gsnaug:clarify ;
    gsnaug:raisedAgainst bad:G1 , bad:G2 .

#  IssueShape - an issue must carry a type
bad:I-untyped a gsnaug:Issue ; schema:identifier "IB2" ;
    gsnaug:raisedAgainst bad:G1 .

#  IssueShape - and it must be one of the three
bad:I-bogus-type a gsnaug:Issue ; schema:identifier "IB3" ;
    gsnaug:issueType bad:escalate ;
    gsnaug:raisedAgainst bad:G1 .

#  IssueSupersessionShape - nothing supersedes itself
bad:I-self a gsnaug:Issue ; schema:identifier "IB4" ;
    gsnaug:issueType gsnaug:revise ;
    gsnaug:raisedAgainst bad:G1 ;
    gsnaug:supersedes bad:I-self .

#  ResponseShape - a response replies to exactly one issue: not none, and not two
bad:A-no-issue a gsnaug:Response .

bad:I-clarify a gsnaug:Issue ; schema:identifier "IB5" ;
    gsnaug:issueType gsnaug:clarify ;
    gsnaug:raisedAgainst bad:G1 .
bad:A-two-issues a gsnaug:Response ; gsnaug:respondsTo bad:I-clarify , bad:I-untyped .

#  ArtefactShape - the ranges are not decorative
bad:artefact a gsn:Artefact ;
    gsnaug:storedIn        bad:a-person ;
    gsnaug:retrievableWith bad:a-person ;
    gsnaug:generatedWith   bad:a-person ;
    gsnaug:verifiedWith    bad:a-person .

#  ArtefactPartShape - a part is part of an artefact, not of a person
bad:part a gsnaug:ArtefactPart ;
    gsnaug:partOf bad:a-person ;
    gsnaug:verifiableWith bad:a-person .

#  SolutionProvenanceShape (warning) - provenance belongs on the artefact
bad:Sn1 a gsn:Solution ; schema:identifier "SnB1" ;
    gsnaug:generatedWith bad:some-script .

#  AssuranceScopeShape - what a case assures is a gsnaug:System, not an artefact. This is the
#  exact mistake a top object context makes when it reaches the system through gsn:refersTo.
bad:G1 a gsn:Goal ; schema:identifier "GB1" ; gsn:top true ;
    gsn:statement "A claim about one system." ;
    gsnaug:assures bad:system-b .

bad:system-b a gsn:Artefact .

#  ElementLinkShape and AccountabilityShape - a requirement is not a person, a row of a
#  catalogue is not a person, and the owner of an element is an agent.
bad:G2 a gsn:Goal ; schema:identifier "GB2" ; gsn:top true ;
    gsn:statement "A top goal wired to the wrong things." ;
    gsnaug:requiredBy       bad:a-person ;
    gsnaug:instantiatedFrom bad:a-person ;
    gsnaug:ownedBy          bad:not-an-agent .

#  AgentShape - whoever holds a role is an agent, and a role is a gsnaug:Role
bad:not-an-agent gsnaug:hasRole bad:a-person .

#  AccountabilityShape and LinkShape - only an artefact or an element is owned, reviewed or
#  linked from, and the owner or reviewer is an agent
bad:a-sticky-note gsnaug:ownedBy    bad:a-person ;
    gsnaug:reviewedBy bad:a-person ;
    gsnaug:linksTo    bad:anything .

#  AuditCoverageShape - a case is covered in an audit cycle; an ask is scoped with raisedIn
bad:case-1 a gsn:Goal ; schema:identifier "ACB1" ;
    gsnaug:coveredIn bad:last-spring .

#  IssueShape - an issue is raised against something in a case, not against a bare note
bad:I-off-target a gsnaug:Issue ; schema:identifier "IB10" ;
    gsnaug:issueType gsnaug:clarify ;
    gsnaug:raisedAgainst bad:a-sticky-note .

#  IssueShape - an outcome must be one of the four
bad:I-bogus-outcome a gsnaug:Issue ; schema:identifier "IB6" ;
    gsnaug:issueType gsnaug:resolve ;
    gsnaug:raisedAgainst bad:G1 ;
    gsnaug:issueOutcome "postponed" .

#  IssueShape - an ask rests with one holder at a time; a second hop is a new issue
bad:I-two-holders a gsnaug:Issue ; schema:identifier "IB7" ;
    gsnaug:issueType gsnaug:clarify ;
    gsnaug:raisedAgainst bad:G1 ;
    gsnaug:heldBy bad:a-person , bad:another-person .

#  IssueShape - an audit cycle is a gsnaug:AuditCycle, and a raiser is an agent
bad:I-bad-cycle a gsnaug:Issue ; schema:identifier "IB8" ;
    gsnaug:issueType gsnaug:clarify ;
    gsnaug:raisedAgainst bad:G1 ;
    gsnaug:raisedIn bad:last-spring ;
    gsnaug:raisedBy bad:nobody-in-particular .

#  IssueClosureShape (warning) - resolved means the raiser accepted a response, and there is none
bad:I-resolved-unanswered a gsnaug:Issue ; schema:identifier "IB9" ;
    gsnaug:issueType gsnaug:resolve ;
    gsnaug:raisedAgainst bad:G1 ;
    gsnaug:issueOutcome "resolved" .

#  ArtefactShape - an artefact replaces another artefact, not a person
bad:artefact-revision a gsn:Artefact ;
    gsnaug:replaces bad:a-person .

#  MechanismAutomationShape - automated is a boolean, not a word
bad:mechanism a gsnaug:Mechanism ;
    gsnaug:automated "yes" .

#  MechanismInterfaceShape - a term is an IRI, a script is one string, and only a mechanism
#  carries either
bad:mechanism-literal-term a gsnaug:Mechanism ;
    gsnaug:readsTerm "AccessLogEntry" .
bad:artefact-that-reads a gsn:Artefact ;
    gsnaug:readsTerm gsn:Goal .
bad:mechanism-two-scripts a gsnaug:Mechanism ;
    gsnaug:script "Get-WinEvent" , "Get-Date" .

#  MechanismRequirementShape - what a mechanism needs to run is a node, not a string
bad:mechanism-needs-a-word a gsnaug:Mechanism ;
    terms:requires "PowerShell 7" .

#  IndependenceShape (warning) - the agent who reviews an element is not the one who owns it
bad:G3 a gsn:Goal ; schema:identifier "GB3" ;
    gsn:statement "A claim reviewed by its own owner." ;
    gsnaug:ownedBy    bad:same-person ;
    gsnaug:reviewedBy bad:same-person .
bad:same-person a prov:Agent .

#  ReportTimestampShape (warning) - a report the rules read carries a timestamp
bad:report-undated a sh:ValidationReport ;
    sh:conforms true ;
    prov:wasGeneratedBy bad:check ;
    prov:used bad:evidence .

#  ReportConflictShape - two reports from one mechanism over one target disagree, and the
#  timestamps do not put one after the other
bad:report-yes a sh:ValidationReport ;
    sh:conforms true ;
    prov:wasGeneratedBy bad:check ;
    prov:used bad:evidence-2 ;
    prov:generatedAtTime "2026-03-08T12:00:00Z"^^xsd:dateTime .
bad:report-no a sh:ValidationReport ;
    sh:conforms false ;
    prov:wasGeneratedBy bad:check ;
    prov:used bad:evidence-2 ;
    prov:generatedAtTime "2026-03-08T12:00:00Z"^^xsd:dateTime .
bad:check a gsnaug:Mechanism .

#  ReportInvalidationShape (warning) - a struck report names the activity that struck it
bad:report-struck-anonymously a sh:ValidationReport ;
    sh:conforms true ;
    prov:wasGeneratedBy bad:check ;
    prov:used bad:evidence-3 ;
    prov:generatedAtTime "2026-03-08T12:00:00Z"^^xsd:dateTime ;
    prov:invalidatedAtTime "2026-03-09T12:00:00Z"^^xsd:dateTime .
