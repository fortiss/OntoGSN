@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex:     <https://example.org/case#> .
@prefix gsn:    <https://w3id.org/OntoGSN/ontology#> .
@prefix gsnaug: <https://w3id.org/OntoGSN/augmentation#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <http://schema.org/> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix swrl:   <http://www.w3.org/2003/11/swrl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

#  A minimal case exercising every branch of the augmentation rules: one top goal that names
#  what it assures and what requires it, one solution, one artefact carrying the full provenance
#  set, and four issues covering the combinations that do and do not become defeaters.

ex:case-1 a gsn:AssuranceCase ; schema:identifier "AC1" ;
    gsn:statement "The company IT system is compliant." ;
    gsnaug:coveredIn ex:audit-2025 , ex:audit-2026 .

ex:G1 a gsn:Goal ; schema:identifier "G1" ; gsn:top true ;
    gsn:statement "The IT system is compliant with the applicable regulation." ;
    gsn:inContextOf ex:C-subject , ex:C-object ;
    gsnaug:assures    ex:it-system ;
    gsnaug:requiredBy ex:regulation ;
    gsn:supportedBy ex:Sn1 .

#  Ordinary contexts. What the case is about and what requires it are carried by gsnaug:assures
#  and gsnaug:requiredBy, which a case that declares no top-level context can state just as well.

ex:C-subject a gsn:Context ; schema:identifier "C1" ;
    gsn:statement "Compliance as defined by the regulation." .

ex:C-object a gsn:Context ; schema:identifier "C2" ;
    gsn:refersTo ex:deployment-list ;
    gsn:statement "The company IT system." .

ex:Sn1 a gsn:Solution ; schema:identifier "Sn1" ;
    gsn:statement "Access log for the reporting period." ;
    gsn:refersTo ex:access-log .

ex:regulation a gsnaug:Requirement .
ex:it-system  a gsnaug:System .

#  Both have moved on since the case was written. G1 still answers to the old regulation, and
#  the access log was still drawn from the old system: what fc39 and fc40 report.
ex:regulation-2027 a gsnaug:Requirement ; prov:wasRevisionOf ex:regulation .
ex:it-system-r2    a gsnaug:System      ; prov:wasRevisionOf ex:it-system .

#  The environment too: the object context refers to a deployment list that was replaced, which
#  is what fc41 reports.
ex:deployment-list    a gsn:Artefact .
ex:deployment-list-v2 a gsn:Artefact ; gsnaug:replaces ex:deployment-list .

ex:access-log a gsn:Artefact ;
    gsnaug:storedIn        ex:evidence-store ;
    gsnaug:retrievableWith ex:log-query ;
    gsnaug:retrievedWith   ex:log-query ;
    gsnaug:generableWith   ex:logging-function ;
    gsnaug:generatedBy     ex:dev-anna ;
    gsnaug:generatedWith   ex:logging-function ;
    gsnaug:generatedFrom   ex:it-system ;
    gsnaug:verifiableWith  ex:retention-rule ;
    gsnaug:verifiedWith    ex:retention-rule .

ex:evidence-store   a gsnaug:System .
ex:log-query        a gsnaug:Mechanism .

# A part of the access log. It declares nothing of its own: A4 copies gsnaug:verifiableWith
# down from ex:access-log.
ex:access-log-row-42 a gsnaug:ArtefactPart ; schema:name "Access log, row 42" ;
    gsnaug:partOf ex:access-log .
ex:logging-function a gsnaug:Mechanism .
ex:retention-rule   a gsnaug:Mechanism .
ex:dev-anna         a prov:Agent .

#  I1  clarify against a goal      -> nothing inferred; clarify never defeats
#  I2  revise  against a context   -> nothing inferred; the target is not a claim
#  I3  revise  against a solution  -> challenge, and Sn1 goes in doubt
#  I4  resolve against a goal      -> challenge, and G1 is defeated

ex:I1 a gsnaug:Issue ; schema:identifier "I1" ;
    gsnaug:issueType gsnaug:clarify ;
    gsnaug:raisedAgainst ex:G1 .

ex:I2 a gsnaug:Issue ; schema:identifier "I2" ;
    gsnaug:issueType gsnaug:revise ;
    gsnaug:raisedAgainst ex:C-object .

ex:I3 a gsnaug:Issue ; schema:identifier "I3" ;
    gsnaug:issueType gsnaug:revise ;
    gsnaug:raisedAgainst ex:Sn1 .

ex:I4 a gsnaug:Issue ; schema:identifier "I4" ;
    gsnaug:issueType gsnaug:resolve ;
    gsnaug:raisedAgainst ex:G1 .

ex:A1 a gsnaug:Response ; gsnaug:respondsTo ex:I3 ;
    schema:description "The log was regenerated for the full period." .


#  ---------------------------------------------------------------------------------------
#  The deviations: two audit rounds, four roles, a clarification relayed twice and resolved,
#  a declined resolution, an infeasible one, a replaced artefact and a manual channel.
#  ---------------------------------------------------------------------------------------

ex:audit-2025 a gsnaug:AuditCycle ; schema:identifier "AUDIT-2025" ;
    prov:startedAtTime "2025-01-13T09:00:00"^^xsd:dateTime ;
    prov:endedAtTime   "2025-03-28T17:00:00"^^xsd:dateTime .

ex:audit-2026 a gsnaug:AuditCycle ; schema:identifier "AUDIT-2026" ;
    prov:startedAtTime "2026-01-12T09:00:00"^^xsd:dateTime ;
    prov:endedAtTime   "2026-03-31T17:00:00"^^xsd:dateTime .

ex:auditor-bo   a prov:Agent ; gsnaug:hasRole ex:role-auditor .
ex:officer-cara a prov:Agent ; gsnaug:hasRole ex:role-officer .
ex:owner-dan    a prov:Agent ; gsnaug:hasRole ex:role-process-owner .
ex:dev-anna     gsnaug:hasRole ex:role-developer .

ex:role-auditor       a gsnaug:Role ; schema:name "Auditor" .
ex:role-officer       a gsnaug:Role ; schema:name "Compliance Officer" .
ex:role-process-owner a gsnaug:Role ; schema:name "Process Owner" .
ex:role-developer     a gsnaug:Role ; schema:name "Developer" .

#  One agent owns a context and reviews an artefact, so both accountability properties are
#  exercised on both kinds of subject the domain allows.

ex:C-object   gsnaug:ownedBy    ex:officer-cara .
ex:access-log gsnaug:reviewedBy ex:officer-cara .

ex:G1  gsnaug:ownedBy ex:officer-cara ;
       gsn:supportedBy ex:Sn2 .
ex:Sn1 gsnaug:ownedBy ex:dev-anna .

#  I1 could not be answered by the officer, I5 could not be answered by the owner, and I6
#  reached the developer, who answered it. Three issues, two escalations, one chain.

ex:I1 gsnaug:raisedBy ex:auditor-bo ; gsnaug:heldBy ex:officer-cara ;
      gsnaug:raisedIn ex:audit-2026 ; gsnaug:issueOutcome "cannot answer" ;
      dcterms:created "2026-02-02"^^xsd:date ;
      schema:description "Which reporting period does this claim cover?" .

ex:I5 a gsnaug:Issue ; schema:identifier "I5" ;
    gsnaug:issueType gsnaug:clarify ;
    gsnaug:raisedAgainst ex:G1 ;
    gsnaug:raisedBy ex:auditor-bo ; gsnaug:heldBy ex:owner-dan ;
    gsnaug:raisedIn ex:audit-2026 ; gsnaug:supersedes ex:I1 ;
    gsnaug:issueOutcome "cannot answer" ;
    dcterms:created "2026-02-05"^^xsd:date .

ex:I6 a gsnaug:Issue ; schema:identifier "I6" ;
    gsnaug:issueType gsnaug:clarify ;
    gsnaug:raisedAgainst ex:G1 ;
    gsnaug:raisedBy ex:auditor-bo ; gsnaug:heldBy ex:dev-anna ;
    gsnaug:raisedIn ex:audit-2026 ; gsnaug:supersedes ex:I5 ;
    gsnaug:issueOutcome "resolved" ;
    dcterms:created "2026-02-07"^^xsd:date .

ex:A2 a gsnaug:Response ; gsnaug:respondsTo ex:I6 ;
    schema:description "The period is the 2025 calendar year." .

#  I4 was raised in the previous round and is still open. I7 was declined; I8 records that the
#  evidence behind Sn1 cannot be produced at all.

ex:I4 gsnaug:raisedBy ex:auditor-bo ; gsnaug:heldBy ex:dev-anna ;
      gsnaug:raisedIn ex:audit-2025 ;
      dcterms:created "2025-03-02"^^xsd:date .

ex:I2 gsnaug:raisedBy ex:auditor-bo ; gsnaug:heldBy ex:officer-cara ;
      gsnaug:raisedIn ex:audit-2026 .

ex:I3 gsnaug:raisedBy ex:officer-cara ; gsnaug:heldBy ex:dev-anna ;
      gsnaug:raisedIn ex:audit-2026 .

ex:I7 a gsnaug:Issue ; schema:identifier "I7" ;
    gsnaug:issueType gsnaug:resolve ;
    gsnaug:raisedAgainst ex:G1 ;
    gsnaug:raisedBy ex:auditor-bo ; gsnaug:heldBy ex:officer-cara ;
    gsnaug:raisedIn ex:audit-2026 ; gsnaug:issueOutcome "declined" ;
    dcterms:created "2026-03-02"^^xsd:date .

ex:I8 a gsnaug:Issue ; schema:identifier "I8" ;
    gsnaug:issueType gsnaug:resolve ;
    gsnaug:raisedAgainst ex:Sn1 ;
    gsnaug:raisedBy ex:auditor-bo ; gsnaug:heldBy ex:dev-anna ;
    gsnaug:raisedIn ex:audit-2026 ; gsnaug:issueOutcome "infeasible" ;
    dcterms:created "2026-03-05"^^xsd:date .

#  Mechanisms say whether a person is in the loop; the retention rule is checked by hand and
#  the interview is the non-digital channel.

ex:logging-function gsnaug:automated true .
ex:log-query        gsnaug:automated true .
ex:retention-rule   gsnaug:automated false .

#  A few domain terms stand in for a domain ontology. The log query is a SPARQL query in the graph
#  and declares the terms it reads by hand, since the query is text; the retention rule is checked
#  by hand, so its terms are declared by hand and nothing in the graph says what it does; the
#  logging function is a script, readable but not derivable from, and it says what it writes: the
#  entries it produces; the interview declares nothing.

ex:AccessLog      a owl:Class .
ex:AccessLogEntry a owl:Class .
ex:Expiring       a owl:Class .
ex:inLog          a owl:ObjectProperty .
ex:retainedUntil  a owl:DatatypeProperty .
ex:retentionPolicy a owl:ObjectProperty .

ex:log-query a sh:SPARQLSelectExecutable ;
    sh:select """SELECT ?entry ?until WHERE { ?entry a ex:AccessLogEntry ; ex:retainedUntil ?until }""" ;
    gsnaug:readsTerm ex:AccessLogEntry , ex:retainedUntil .

ex:logging-function gsnaug:writesTerm ex:AccessLogEntry .

ex:retention-rule gsnaug:readsTerm ex:retainedUntil .

ex:logging-function gsnaug:script """#requires -Version 7
Get-WinEvent -LogName Security | Export-Csv -Path access-log.csv""" .

#  Two mechanisms that are in the graph as what they are: a shape and a rule. Neither declares a
#  term; the rules in derivations/ read the terms off the node. The shape has a plain path, a
#  path with sh:class, and a sequence path, so that all three branches of D1 are exercised.
#  The log carries one entry, so that the shape has a focus node when check.py runs it: the
#  report the run leaves behind is what A6a reads to mark Sn1 true.

ex:access-log a ex:AccessLog ;
    ex:retentionPolicy ex:retention-policy-2025 .

ex:entry-1 a ex:AccessLogEntry ;
    ex:inLog ex:access-log ;
    ex:retainedUntil "2027-01-01"^^xsd:date .

ex:access-log gsnaug:verifiableWith ex:retention-shape , ex:expiry-rule .

ex:retention-shape a gsnaug:Mechanism , sh:NodeShape ;
    gsnaug:automated true ;
    sh:targetClass ex:AccessLogEntry ;
    sh:property [ sh:path ex:retainedUntil ; sh:minCount 1 ] ;
    sh:property [ sh:path ex:inLog ; sh:class ex:AccessLog ] ;
    sh:property [ sh:path ( ex:inLog ex:retentionPolicy ) ; sh:minCount 1 ] .

ex:expiry-rule a gsnaug:Mechanism , swrl:Imp ;
    gsnaug:automated true ;
    swrl:body [ a swrl:AtomList ;
                rdf:first [ a swrl:ClassAtom ;
                            swrl:classPredicate ex:AccessLogEntry ;
                            swrl:argument1 ex:e ] ;
                rdf:rest  [ a swrl:AtomList ;
                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                        swrl:propertyPredicate ex:retainedUntil ;
                                        swrl:argument1 ex:e ;
                                        swrl:argument2 ex:d ] ;
                            rdf:rest rdf:nil ] ] ;
    swrl:head [ a swrl:AtomList ;
                rdf:first [ a swrl:ClassAtom ;
                            swrl:classPredicate ex:Expiring ;
                            swrl:argument1 ex:e ] ;
                rdf:rest rdf:nil ] .

ex:e a swrl:Variable .
ex:d a swrl:Variable .

ex:Sn2 a gsn:Solution ; schema:identifier "Sn2" ;
    gsn:statement "Interview record with the process owner." ;
    gsn:refersTo ex:interview-note ;
    gsnaug:ownedBy ex:owner-dan .

ex:interview-note a gsn:Artefact ;
    gsnaug:retrievableWith ex:interview ;
    gsnaug:generatedBy     ex:owner-dan .

ex:interview a gsnaug:Mechanism ; gsnaug:automated false .

#  The note is also verifiable with a script. A script leaves no report of its own, so the one
#  here is written by hand in the form a SHACL engine would produce: the adapter a scripted
#  mechanism needs. It does not conform, so A6b marks Sn2 not true. The two gaps it reports are
#  the ones I9 asks about.

ex:interview-note gsnaug:verifiableWith ex:note-check .

ex:note-check a gsnaug:Mechanism ;
    gsnaug:automated true ;
    dcterms:requires <https://example.org/tools#powershell-7> ;
    gsnaug:script """Select-String -Path interview-note.md -Pattern '^Interviewee:', '^Date:' | Measure-Object""" .

ex:note-check-report-1 a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
                sh:focusNode ex:interview-note ;
                sh:resultSeverity sh:Violation ;
                sh:resultMessage "The note names no interviewee and no date." ] ;
    prov:wasGeneratedBy ex:note-check ;
    prov:used ex:interview-note ;
    prov:generatedAtTime "2026-03-08T16:40:00Z"^^xsd:dateTime .

#  Two solutions whose check ran over a part and not over the whole. The configuration export
#  declares its mechanism on the whole, so the key inherits it by A4, and the conforming report
#  over the key marks Sn3 true by A6c. The firewall rule declares its own mechanism, and the
#  failing report over it marks Sn4 not true by A6d. Neither whole carries a report of its own.

ex:G1 gsn:supportedBy ex:Sn3 , ex:Sn4 .

ex:Sn3 a gsn:Solution ; schema:identifier "Sn3" ;
    gsn:statement "Configuration export of the reporting system." ;
    gsn:refersTo ex:config-export .

ex:config-export a gsn:Artefact ;
    gsnaug:verifiableWith ex:key-check .

ex:config-export-key-7 a gsnaug:ArtefactPart ; schema:name "Configuration export, key 7" ;
    gsnaug:partOf ex:config-export .

ex:key-check a gsnaug:Mechanism ;
    gsnaug:automated true ;
    gsnaug:script """Select-String -Path config-export.json -Pattern '"session_timeout"' | Measure-Object""" .

ex:key-check-report-1 a sh:ValidationReport ;
    sh:conforms true ;
    prov:wasGeneratedBy ex:key-check ;
    prov:used ex:config-export-key-7 ;
    prov:generatedAtTime "2026-03-08T17:05:00Z"^^xsd:dateTime .

ex:Sn4 a gsn:Solution ; schema:identifier "Sn4" ;
    gsn:statement "Firewall ruleset of the reporting system." ;
    gsn:refersTo ex:firewall-ruleset .

ex:firewall-ruleset a gsn:Artefact .

ex:firewall-rule-12 a gsnaug:ArtefactPart ; schema:name "Firewall ruleset, rule 12" ;
    gsnaug:partOf ex:firewall-ruleset ;
    gsnaug:verifiableWith ex:rule-check .

ex:rule-check a gsnaug:Mechanism ;
    gsnaug:automated true ;
    gsnaug:script """Select-String -Path firewall-rules.csv -Pattern '^12,.*,0\\.0\\.0\\.0/0,' | Measure-Object""" .

ex:rule-check-report-1 a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
                sh:focusNode ex:firewall-rule-12 ;
                sh:resultSeverity sh:Violation ;
                sh:resultMessage "Rule 12 allows inbound traffic from any address." ] ;
    prov:wasGeneratedBy ex:rule-check ;
    prov:used ex:firewall-rule-12 ;
    prov:generatedAtTime "2026-03-08T17:20:00Z"^^xsd:dateTime .

ex:access-log-v2 a gsn:Artefact ;
    gsnaug:replaces       ex:access-log ;
    gsnaug:generatedBy    ex:dev-anna ;
    gsnaug:generatedWith  ex:logging-function .

#  One ask still open, one control still to be developed, and the row of the control catalogue
#  the top goal was instantiated from.

ex:I9 a gsnaug:Issue ; schema:identifier "I9" ;
    gsnaug:issueType gsnaug:clarify ;
    gsnaug:raisedAgainst ex:Sn2 ;
    gsnaug:raisedBy ex:auditor-bo ; gsnaug:heldBy ex:owner-dan ;
    gsnaug:raisedIn ex:audit-2026 ;
    dcterms:created "2026-03-09"^^xsd:date ;
    schema:description "Who was interviewed, and when?" .

ex:G2 a gsn:Goal ; schema:identifier "G2" ;
    gsn:statement "Access to the reporting system is reviewed quarterly." ;
    gsn:undeveloped true ;
    gsnaug:ownedBy ex:officer-cara .

ex:G1 gsn:supportedBy ex:G2 ;
      gsnaug:instantiatedFrom ex:ctrl-row-7 .

ex:IDR1 a gsn:InstantiationDataReference ; schema:identifier "IDR1" ;
    gsn:attachedTo ex:G1 ;
    gsn:refersTo   ex:control-catalogue .

ex:control-catalogue a gsn:Artefact .

ex:ctrl-row-7 a gsnaug:ArtefactPart ; schema:name "Control 7" ;
    gsnaug:partOf ex:control-catalogue .
