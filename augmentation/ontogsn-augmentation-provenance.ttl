    gsnprov:aboutTerm gsnaug:Answer ;
    gsnprov:mentionsTerm gsnaug:Answer , gsnaug:Clarification , gsnaug:Resolution , gsnaug:Revision , gsnaug:answers .

gsnaugprov:dd-0011
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:OWL ;
    gsnprov:naturalLanguage "An issue may be raised against anything in a case, so the property that says what it is about declares no range."@en ;
    prov:used gsnaugprov:src-0002 ;
    gsnprov:hasRationale gsnaugprov:why-0009 ;
    prov:generated gsnaugprov:st-0011 .

