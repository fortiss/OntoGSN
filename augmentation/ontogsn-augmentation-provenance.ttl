    rdfs:label "OntoGSN Augmentation SHACL shapes 0.1.0"@en ;
    owl:versionInfo "0.1.0" ;
    gsnprov:path "augmentation/ontogsn-augmentation-shapes.ttl" ;
    gsnprov:fileChecksum "9297d3d2e598b28477495ade45b2db475eaee8361bc11110c976af2dee4763fe" .

gsnaugprov:augmentation-rules-0.1.0
    a gsnprov:FormalGraph ;
