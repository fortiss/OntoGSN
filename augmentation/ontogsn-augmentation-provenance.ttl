#################################################################
#    Decisions - the rules
#################################################################

gsnaugprov:dd-0020
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:SWRL ;
    gsnprov:naturalLanguage "An issue becomes a defeater only when it asks for a revision or a resolution and its target is a goal or a solution."@en ;
    prov:used gsnaugprov:src-0002 ;
    gsnprov:hasRationale gsnaugprov:why-0010 ;
    prov:generated gsnaugprov:st-0020 .

gsnaugprov:st-0020
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0020 ;
    gsnprov:inGraph gsnaugprov:augmentation-0.1.0 ;
    gsnprov:statementText "Four rules, and no fifth: A2a, A2b, A3a, A3b each test both the issue type and the class of the target. No rule fires on gsnaug:clarify, and none fires on a target that is neither gsn:Goal nor gsn:Solution." ;
    gsnprov:aboutTerm gsnaug:Issue ;
    gsnprov:mentionsTerm gsn:Goal , gsn:Solution , gsnaug:clarify , gsnaug:resolve , gsnaug:revise .

gsnaugprov:dd-0021
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:SWRL ;
    gsnprov:naturalLanguage "A revise issue against a claim becomes a true goal that challenges it, and nothing more."@en ;
    prov:used gsnaugprov:src-0006 ;
    gsnprov:hasRationale gsnaugprov:why-0011 ;
    prov:generated gsnaugprov:st-0021 .

gsnaugprov:st-0021
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0021 ;
    gsnprov:inGraph gsnaugprov:augmentation-0.1.0 ;
    gsnprov:statementText "Issue(?I) ^ issueType(?I, revise) ^ raisedAgainst(?I, ?E) ^ Goal(?E) -> Goal(?I) ^ true(?I, true) ^ challenges(?I, ?E)" ;
    gsnprov:aboutTerm gsnaug:ReviseIssueChallengesGoal ;
    gsnprov:mentionsTerm gsn:challenges , gsn:true , gsnaug:ReviseIssueChallengesGoal , gsnaug:ReviseIssueChallengesSolution .

gsnaugprov:dd-0022
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:SWRL ;
    gsnprov:naturalLanguage "A resolve issue against a claim asserts the defeat directly, because the rule that would otherwise derive it needs valid evidence and an issue is an ask."@en ;
    prov:used gsnaugprov:src-0006 ;
    gsnprov:hasRationale gsnaugprov:why-0011 ;
    prov:generated gsnaugprov:st-0022 .

gsnaugprov:st-0022
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0022 ;
    gsnprov:inGraph gsnaugprov:augmentation-0.1.0 ;
    gsnprov:statementText "Issue(?I) ^ issueType(?I, resolve) ^ raisedAgainst(?I, ?E) ^ Goal(?E) -> Goal(?I) ^ challenges(?I, ?E) ^ defeated(?E, true)" ;
    gsnprov:aboutTerm gsnaug:ResolveIssueDefeatsGoal ;
    gsnprov:mentionsTerm gsn:challenges , gsn:defeated , gsnaug:ResolveIssueDefeatsGoal , gsnaug:ResolveIssueDefeatsSolution .

gsnaugprov:dd-0023
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:SWRL ;
    gsnprov:naturalLanguage "Each of the two issue rules is written twice, once for a goal target and once for a solution target."@en ;
    gsnprov:noSourceRecorded "true"^^xsd:boolean ;
    gsnprov:hasRationale gsnaugprov:why-0012 ;
    prov:generated gsnaugprov:st-0023 .

gsnaugprov:st-0023
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0023 ;
    gsnprov:inGraph gsnaugprov:augmentation-0.1.0 ;
    gsnprov:statementText "A2a and A2b; A3a and A3b." ;
    gsnprov:aboutTerm gsnaug:ReviseIssueChallengesSolution ;
    gsnprov:mentionsTerm gsnaug:ResolveIssueDefeatsSolution , gsnaug:ReviseIssueChallengesSolution .

gsnaugprov:dd-0024
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:SWRL ;
    gsnprov:naturalLanguage "The system and the requirement are derived from the two top-level contexts, so that a case which draws them does not have to assert them twice."@en ;
    prov:used gsnaugprov:src-0008 ;
    gsnprov:hasRationale gsnaugprov:why-0013 ;
    prov:generated gsnaugprov:st-0024 .

gsnaugprov:st-0024
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0024 ;
    gsnprov:inGraph gsnaugprov:augmentation-0.1.0 ;
    gsnprov:statementText "Goal(?G) ^ top(?G, true) ^ inContextOf(?G, ?C) ^ TopObjectContext(?C) ^ refersTo(?C, ?S) -> assures(?G, ?S) ; and the matching rule for TopSubjectContext and requiredBy." ;
    gsnprov:aboutTerm gsnaug:TopObjectContextAssurance ;
    gsnprov:mentionsTerm gsnaug:TopObjectContextAssurance , gsnaug:TopSubjectContextRequirement , gsnaug:assures , gsnaug:requiredBy .

gsnaugprov:dd-0025
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:naturalLanguage "Every SWRL rule is also written as a SPARQL update, so the augmentation runs without a reasoner."@en ;
    prov:used gsnaugprov:src-0006 ;
    gsnprov:hasRationale gsnaugprov:why-0022 ;
    prov:generated gsnaugprov:st-0025 .

gsnaugprov:st-0025
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0025 ;
    gsnprov:inGraph gsnaugprov:augmentation-rules-0.1.0 ;
    gsnprov:statementText "augmentation/rules/a02a, a02b, a03a, a03b, a05a, a05b - one per SWRL rule, count asserted by augmentation/check.py." ;
    gsnprov:aboutTerm gsnaug:ReviseIssueChallengesGoal ;
    gsnprov:mentionsTerm gsnaug:ResolveIssueDefeatsGoal , gsnaug:ReviseIssueChallengesGoal , gsnaug:TopObjectContextAssurance .


#################################################################
#    Decisions - the shapes
#################################################################

gsnaugprov:dd-0026
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:SHACL ;
    gsnprov:naturalLanguage "Every range declared in the vocabulary is repeated as a shape, because a range infers a type rather than rejecting a wrong one."@en ;
    gsnprov:noSourceRecorded "true"^^xsd:boolean ;
    gsnprov:hasRationale gsnaugprov:why-0018 ;
    prov:generated gsnaugprov:st-0026 .

gsnaugprov:st-0026
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0026 ;
    gsnprov:inGraph gsnaugprov:augmentation-shapes-0.1.0 ;
    gsnprov:statementText "gsnaugsh:ArtefactShape constrains gsnaug:storedIn, retrievableWith, generatedWith, verifiedWith and generatedBy to their declared ranges." ;
    gsnprov:aboutTerm gsnaugsh:ArtefactShape ;
    gsnprov:mentionsTerm gsnaug:generatedBy , gsnaug:generatedWith , gsnaug:retrievableWith , gsnaug:storedIn , gsnaug:verifiedWith .

gsnaugprov:dd-0027
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:SHACL ;
    gsnprov:naturalLanguage "Evidence provenance found on a solution is reported as a warning, not as a violation."@en ;
    prov:used gsnaugprov:src-0007 ;
    gsnprov:hasRationale gsnaugprov:why-0019 ;
    prov:generated gsnaugprov:st-0027 .

gsnaugprov:st-0027
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0027 ;
    gsnprov:inGraph gsnaugprov:augmentation-shapes-0.1.0 ;
    gsnprov:statementText "gsnaugsh:SolutionProvenanceShape sh:severity sh:Warning ." ;
    gsnprov:aboutTerm gsnaugsh:SolutionProvenanceShape ;
    gsnprov:mentionsTerm gsnaugsh:SolutionProvenanceShape .

gsnaugprov:dd-0028
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:SHACL ;
    gsnprov:naturalLanguage "The shape that would require both top-level contexts is shipped switched off."@en ;
    prov:used gsnaugprov:src-0008 ;
    gsnprov:hasRationale gsnaugprov:why-0020 ;
    prov:generated gsnaugprov:st-0028 .

gsnaugprov:st-0028
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0028 ;
    gsnprov:inGraph gsnaugprov:augmentation-shapes-0.1.0 ;
    gsnprov:statementText "gsnaugsh:TopContextCompletenessShape sh:deactivated true ." ;
    gsnprov:aboutTerm gsnaugsh:TopContextCompletenessShape ;
    gsnprov:mentionsTerm gsnaugsh:TopContextCompletenessShape .

gsnaugprov:dd-0029
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:SHACL ;
    gsnprov:naturalLanguage "The shape pairing each kind of answer with its kind of issue is one flat filter, because neither of the two natural ways to write it works."@en ;
    prov:used gsnaugprov:src-0005 ;
    gsnprov:hasRationale gsnaugprov:why-0021 ;
    prov:generated gsnaugprov:st-0029 .

gsnaugprov:st-0029
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0029 ;
    gsnprov:inGraph gsnaugprov:augmentation-shapes-0.1.0 ;
    gsnprov:statementText "gsnaugsh:AnswerAgreementShape sh:sparql [ sh:select \"... FILTER ( (?answerClass = gsnaug:Clarification && ?type != gsnaug:clarify) || ... )\" ] ." ;
    gsnprov:aboutTerm gsnaugsh:AnswerAgreementShape ;
    gsnprov:mentionsTerm gsnaugsh:AnswerAgreementShape .

gsnaugprov:dd-0030
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:SHACL ;
    gsnprov:naturalLanguage "That an issue cannot supersede itself is checked by a shape as well as stated in the vocabulary."@en ;
    gsnprov:noSourceRecorded "true"^^xsd:boolean ;
    gsnprov:hasRationale gsnaugprov:why-0025 ;
    prov:generated gsnaugprov:st-0030 .

gsnaugprov:st-0030
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0030 ;
    gsnprov:inGraph gsnaugprov:augmentation-shapes-0.1.0 ;
    gsnprov:statementText "gsnaugsh:IssueSupersessionShape sh:sparql [ sh:select \"SELECT $this WHERE { $this gsnaug:supersedes $this . }\" ] ." ;
    gsnprov:aboutTerm gsnaugsh:IssueSupersessionShape ;
    gsnprov:mentionsTerm gsnaug:supersedes , gsnaugsh:IssueSupersessionShape .
