gsnaugprov:dd-0018
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:RDF ;
    gsnprov:naturalLanguage "The augmentation records which version of OntoGSN it was written against."@en ;
    gsnprov:noSourceRecorded "true"^^xsd:boolean ;
    gsnprov:hasRationale gsnaugprov:why-0024 ;
