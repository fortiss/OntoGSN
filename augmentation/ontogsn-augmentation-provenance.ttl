    gsnprov:aboutTerm gsnaug:linksTo ;
    gsnprov:mentionsTerm gsnaug:linksTo , gsnaug:tag .

gsnaugprov:dd-0017
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:OWL ;
    gsnprov:naturalLanguage "Where a claim came from is a separate property rather than a reuse of the Dublin Core conformance term."@en ;
    gsnprov:noSourceRecorded "true"^^xsd:boolean ;
    gsnprov:hasRationale gsnaugprov:why-0017 ;
    prov:generated gsnaugprov:st-0017 .

gsnaugprov:st-0017
