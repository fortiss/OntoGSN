    prov:wasGeneratedBy gsnaugprov:dd-0012 ;
    gsnprov:inGraph gsnaugprov:augmentation-0.1.0 ;
    gsnprov:statementText "gsnaug:supersedes a owl:IrreflexiveProperty ; rdfs:domain gsnaug:Issue ; rdfs:range gsnaug:Issue ." ;
    gsnprov:aboutTerm gsnaug:supersedes ;
    gsnprov:mentionsTerm gsnaug:Issue , gsnaug:supersedes .

gsnaugprov:dd-0013
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:OWL ;
    gsnprov:naturalLanguage "What a case is about can be stated as a property, so that a case which omits the customary top-level context can still say it."@en ;
    prov:used gsnaugprov:src-0008 ;
    gsnprov:hasRationale gsnaugprov:why-0013 ;
    prov:generated gsnaugprov:st-0013 .

gsnaugprov:st-0013
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0013 ;
    gsnprov:inGraph gsnaugprov:augmentation-0.1.0 ;
    gsnprov:statementText "gsnaug:assures a owl:ObjectProperty . gsnaug:assuredBy owl:inverseOf gsnaug:assures ." ;
    gsnprov:aboutTerm gsnaug:assures ;
    gsnprov:mentionsTerm gsnaug:assuredBy , gsnaug:assures .

gsnaugprov:dd-0014
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:OWL ;
    gsnprov:naturalLanguage "A goal, as well as an argument or a case, can be the thing that assures a system."@en ;
    gsnprov:noSourceRecorded "true"^^xsd:boolean ;
    gsnprov:hasRationale gsnaugprov:why-0014 ;
    prov:generated gsnaugprov:st-0014 .

gsnaugprov:st-0014
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0014 ;
    gsnprov:inGraph gsnaugprov:augmentation-0.1.0 ;
    gsnprov:statementText "gsnaug:assures rdfs:domain [ (Argument or AssuranceCase or Goal) ] ." ;
    gsnprov:aboutTerm gsnaug:assures ;
    gsnprov:mentionsTerm gsn:Argument , gsn:AssuranceCase , gsn:Goal , gsnaug:assures .

gsnaugprov:dd-0015
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:OWL ;
    gsnprov:naturalLanguage "The two top-level contexts are subclasses of the GSN context, so a GSN-only tool treats them as ordinary contexts."@en ;
    prov:used gsnaugprov:src-0008 ;
    gsnprov:hasRationale gsnaugprov:why-0015 ;
    prov:generated gsnaugprov:st-0015 .

gsnaugprov:st-0015
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0015 ;
    gsnprov:inGraph gsnaugprov:augmentation-0.1.0 ;
    gsnprov:statementText "gsnaug:TopSubjectContext rdfs:subClassOf gsn:Context . gsnaug:TopObjectContext rdfs:subClassOf gsn:Context ." ;
    gsnprov:aboutTerm gsnaug:TopObjectContext ;
    gsnprov:mentionsTerm gsn:Context , gsnaug:TopObjectContext , gsnaug:TopSubjectContext .

gsnaugprov:dd-0016
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:OWL ;
    gsnprov:naturalLanguage "Two deliberately weak terms absorb everything the named properties do not cover: a link to anything, and an informal keyword."@en ;
    gsnprov:noSourceRecorded "true"^^xsd:boolean ;
    gsnprov:hasRationale gsnaugprov:why-0016 ;
    prov:generated gsnaugprov:st-0016 .

gsnaugprov:st-0016
    a gsnprov:StatementRecord ;
