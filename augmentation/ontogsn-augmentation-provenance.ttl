    gsnprov:aboutTerm gsnaug:instantiatedFrom ;
    gsnprov:mentionsTerm gsn:GSNElement , gsnaug:instantiatedFrom .


gsnaugprov:dd-0031
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:OWL ;
    gsnprov:naturalLanguage "An audit round is an individual of its own class and a PROV activity, so that an ask can be scoped to it and the round can carry its own dates."@en ;
    prov:used gsnaugprov:src-0002 ;
    gsnprov:hasRationale gsnaugprov:why-0026 ;
    prov:generated gsnaugprov:st-0031 .

gsnaugprov:st-0031
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0031 ;
    gsnprov:inGraph gsnaugprov:augmentation-0.2.0 ;
    gsnprov:statementText "gsnaug:AuditCycle rdfs:subClassOf prov:Activity . gsnaug:raisedIn rdfs:domain gsnaug:Issue ; rdfs:range gsnaug:AuditCycle . (no date properties minted: prov:startedAtTime, prov:endedAtTime, dcterms:created)" ;
    gsnprov:aboutTerm gsnaug:AuditCycle ;
    gsnprov:mentionsTerm gsnaug:AuditCycle , gsnaug:Issue , gsnaug:raisedIn .

gsnaugprov:dd-0032
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:OWL ;
    gsnprov:naturalLanguage "Who raised an ask and who currently holds it are two properties of their own, and not a reuse of the ownership property."@en ;
    prov:used gsnaugprov:src-0009 ;
    gsnprov:hasRationale gsnaugprov:why-0027 ;
    prov:generated gsnaugprov:st-0032 .

gsnaugprov:st-0032
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0032 ;
    gsnprov:inGraph gsnaugprov:augmentation-0.2.0 ;
    gsnprov:statementText "gsnaug:raisedBy rdfs:domain gsnaug:Issue ; rdfs:range prov:Agent . gsnaug:heldBy rdfs:domain gsnaug:Issue ; rdfs:range prov:Agent ." ;
    gsnprov:aboutTerm gsnaug:heldBy ;
    gsnprov:mentionsTerm gsnaug:Issue , gsnaug:heldBy , gsnaug:ownedBy , gsnaug:raisedBy , gsnaug:supersedes .

gsnaugprov:dd-0033
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:RDF ;
    gsnprov:naturalLanguage "An ask that ends without an answer records how it ended, as a concept in a scheme of three."@en ;
    prov:used gsnaugprov:src-0010 ;
    gsnprov:hasRationale gsnaugprov:why-0028 ;
    prov:generated gsnaugprov:st-0033 .

gsnaugprov:st-0033
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0033 ;
    gsnprov:inGraph gsnaugprov:augmentation-0.2.0 ;
    gsnprov:statementText "gsnaug:issueOutcome rdfs:domain gsnaug:Issue ; rdfs:range skos:Concept . gsnaug:cannotAnswer a skos:Concept . gsnaug:declined a skos:Concept . gsnaug:infeasible a skos:Concept . All three skos:inScheme gsnaug:IssueOutcomeScheme ." ;
    gsnprov:aboutTerm gsnaug:issueOutcome ;
    gsnprov:mentionsTerm gsnaug:IssueOutcomeScheme , gsnaug:cannotAnswer , gsnaug:declined , gsnaug:infeasible , gsnaug:issueOutcome .

gsnaugprov:dd-0034
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:OWL ;
    gsnprov:naturalLanguage "The earlier version of an artefact is a subproperty of the PROV revision term, declared for artefacts only."@en ;
    prov:used gsnaugprov:src-0004 ;
    gsnprov:hasRationale gsnaugprov:why-0029 ;
    prov:generated gsnaugprov:st-0034 .

gsnaugprov:st-0034
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0034 ;
    gsnprov:inGraph gsnaugprov:augmentation-0.2.0 ;
    gsnprov:statementText "gsnaug:revisionOf rdfs:subPropertyOf prov:wasRevisionOf ; rdfs:domain gsn:Artefact ; rdfs:range gsn:Artefact ." ;
    gsnprov:aboutTerm gsnaug:revisionOf ;
    gsnprov:mentionsTerm gsn:Artefact , gsnaug:Revision , gsnaug:revisionOf .

gsnaugprov:dd-0035
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:OWL ;
    gsnprov:naturalLanguage "Whether a mechanism runs without a person is one boolean on the mechanism, covering generation, retrieval and verification alike."@en ;
    prov:used gsnaugprov:src-0003 ;
    gsnprov:hasRationale gsnaugprov:why-0030 ;
    prov:generated gsnaugprov:st-0035 .

gsnaugprov:st-0035
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0035 ;
    gsnprov:inGraph gsnaugprov:augmentation-0.2.0 ;
    gsnprov:statementText "gsnaug:automated rdfs:domain [ (EvidenceGenerationMechanism or EvidenceRetrievalMechanism or EvidenceVerificationMechanism) ] ; rdfs:range xsd:boolean ." ;
    gsnprov:aboutTerm gsnaug:automated ;
    gsnprov:mentionsTerm gsnaug:EvidenceGenerationMechanism , gsnaug:EvidenceRetrievalMechanism ,
        gsnaug:EvidenceVerificationMechanism , gsnaug:automated , gsnaug:tag .

gsnaugprov:dd-0036
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:OWL ;
    gsnprov:naturalLanguage "Whether the agent who asked accepted an answer is recorded on the answer, because an issue may accumulate several."@en ;
    prov:used gsnaugprov:src-0009 ;
    gsnprov:hasRationale gsnaugprov:why-0031 ;
    prov:generated gsnaugprov:st-0036 .

gsnaugprov:st-0036
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0036 ;
    gsnprov:inGraph gsnaugprov:augmentation-0.2.0 ;
    gsnprov:statementText "gsnaug:accepted rdfs:domain gsnaug:Answer ; rdfs:range xsd:boolean ." ;
    gsnprov:aboutTerm gsnaug:accepted ;
    gsnprov:mentionsTerm gsnaug:Answer , gsnaug:accepted , gsnaug:answers .

gsnaugprov:dd-0037
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:RDF ;
    gsnprov:naturalLanguage "The text of an ask and of an answer is schema:description, and no property is minted for it."@en ;
    gsnprov:noSourceRecorded "true"^^xsd:boolean ;
    gsnprov:hasRationale gsnaugprov:why-0032 ;
    prov:generated gsnaugprov:st-0037 .

gsnaugprov:st-0037
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0037 ;
    gsnprov:inGraph gsnaugprov:augmentation-0.2.0 ;
    gsnprov:statementText "(no statement: gsnaug:Issue and gsnaug:Answer carry schema:description, which OntoGSN declares without a domain, and never gsn:statement, whose domain would retype them)" ;
    gsnprov:aboutTerm gsnaug:Issue ;
    gsnprov:mentionsTerm gsnaug:Answer , gsnaug:Issue .


#################################################################
#    Decisions - the rules
#################################################################

gsnaugprov:dd-0020
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:SWRL ;
    gsnprov:naturalLanguage "An issue becomes a defeater only when it asks for a revision or a resolution and its target is a goal or a solution."@en ;
    prov:used gsnaugprov:src-0002 ;
    gsnprov:hasRationale gsnaugprov:why-0010 ;
    prov:generated gsnaugprov:st-0020 .

gsnaugprov:st-0020
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0020 ;
    gsnprov:inGraph gsnaugprov:augmentation-0.2.0 ;
    gsnprov:statementText "Four rules, and no fifth: A2a, A2b, A3a, A3b each test both the issue type and the class of the target. No rule fires on gsnaug:clarify, and none fires on a target that is neither gsn:Goal nor gsn:Solution." ;
    gsnprov:aboutTerm gsnaug:Issue ;
    gsnprov:mentionsTerm gsn:Goal , gsn:Solution , gsnaug:clarify , gsnaug:resolve , gsnaug:revise .

gsnaugprov:dd-0021
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:SWRL ;
    gsnprov:naturalLanguage "A revise issue against a claim becomes a true goal that challenges it, and nothing more."@en ;
    prov:used gsnaugprov:src-0006 ;
    gsnprov:hasRationale gsnaugprov:why-0011 ;
    prov:generated gsnaugprov:st-0021 .

gsnaugprov:st-0021
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0021 ;
    gsnprov:inGraph gsnaugprov:augmentation-0.2.0 ;
    gsnprov:statementText "Issue(?I) ^ issueType(?I, revise) ^ raisedAgainst(?I, ?E) ^ Goal(?E) -> Goal(?I) ^ true(?I, true) ^ challenges(?I, ?E)" ;
    gsnprov:aboutTerm gsnaug:ReviseIssueChallengesGoal ;
    gsnprov:mentionsTerm gsn:challenges , gsn:true , gsnaug:ReviseIssueChallengesGoal , gsnaug:ReviseIssueChallengesSolution .

gsnaugprov:dd-0022
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:SWRL ;
    gsnprov:naturalLanguage "A resolve issue against a claim asserts the defeat directly, because the rule that would otherwise derive it needs valid evidence and an issue is an ask."@en ;
    prov:used gsnaugprov:src-0006 ;
    gsnprov:hasRationale gsnaugprov:why-0011 ;
    prov:generated gsnaugprov:st-0022 .

gsnaugprov:st-0022
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0022 ;
    gsnprov:inGraph gsnaugprov:augmentation-0.2.0 ;
    gsnprov:statementText "Issue(?I) ^ issueType(?I, resolve) ^ raisedAgainst(?I, ?E) ^ Goal(?E) -> Goal(?I) ^ challenges(?I, ?E) ^ defeated(?E, true)" ;
    gsnprov:aboutTerm gsnaug:ResolveIssueDefeatsGoal ;
    gsnprov:mentionsTerm gsn:challenges , gsn:defeated , gsnaug:ResolveIssueDefeatsGoal , gsnaug:ResolveIssueDefeatsSolution .

gsnaugprov:dd-0023
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:SWRL ;
    gsnprov:naturalLanguage "Each of the two issue rules is written twice, once for a goal target and once for a solution target."@en ;
    gsnprov:noSourceRecorded "true"^^xsd:boolean ;
    gsnprov:hasRationale gsnaugprov:why-0012 ;
    prov:generated gsnaugprov:st-0023 .

gsnaugprov:st-0023
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0023 ;
    gsnprov:inGraph gsnaugprov:augmentation-0.2.0 ;
    gsnprov:statementText "A2a and A2b; A3a and A3b." ;
    gsnprov:aboutTerm gsnaug:ReviseIssueChallengesSolution ;
    gsnprov:mentionsTerm gsnaug:ResolveIssueDefeatsSolution , gsnaug:ReviseIssueChallengesSolution .

gsnaugprov:dd-0024
    a gsnprov:RetiredDecision ;
    gsnprov:retirementReason """Withdrawn at 0.2.0 with the classes the rules read. Deriving the system through gsn:refersTo also typed it a gsn:Artefact, which naming the far end fixes."""@en ;
    gsnprov:supersededBy gsnaugprov:dd-0041 ;
    gsnprov:formalism gsnprov:SWRL ;
    gsnprov:naturalLanguage "The system and the requirement are derived from the two top-level contexts, so that a case which draws them does not have to assert them twice."@en ;
    prov:used gsnaugprov:src-0008 ;
    gsnprov:hasRationale gsnaugprov:why-0013 ;
    prov:generated gsnaugprov:st-0024 .

gsnaugprov:st-0024
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0024 ;
    gsnprov:inGraph gsnaugprov:augmentation-0.1.0 ;
    gsnprov:statementText "Goal(?G) ^ top(?G, true) ^ inContextOf(?G, ?C) ^ TopObjectContext(?C) ^ refersTo(?C, ?S) -> assures(?G, ?S) ; and the matching rule for TopSubjectContext and requiredBy." ;
    gsnprov:aboutTerm gsnaug:TopObjectContextAssurance ;
    gsnprov:mentionsTerm gsnaug:TopObjectContextAssurance , gsnaug:TopSubjectContextRequirement , gsnaug:assures , gsnaug:requiredBy .

gsnaugprov:dd-0025
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:SPARQL ;
    gsnprov:naturalLanguage "Every SWRL rule is also written as a SPARQL update, so the augmentation runs without a reasoner."@en ;
    prov:used gsnaugprov:src-0006 ;
    gsnprov:hasRationale gsnaugprov:why-0022 ;
    prov:generated gsnaugprov:st-0025 .

gsnaugprov:st-0025
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0025 ;
    gsnprov:inGraph gsnaugprov:augmentation-rules-0.2.0 ;
    gsnprov:statementText "augmentation/rules/a02a, a02b, a03a, a03b - one per SWRL rule, count asserted by augmentation/check.py." ;
    gsnprov:aboutTerm gsnaug:ReviseIssueChallengesGoal ;
    gsnprov:mentionsTerm gsnaug:ResolveIssueDefeatsGoal , gsnaug:ReviseIssueChallengesGoal .


#################################################################
#    Decisions - the shapes
#################################################################

gsnaugprov:dd-0026
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:SHACL ;
    gsnprov:naturalLanguage "Every range declared in the vocabulary is repeated as a shape, because a range infers a type rather than rejecting a wrong one."@en ;
    gsnprov:noSourceRecorded "true"^^xsd:boolean ;
    gsnprov:hasRationale gsnaugprov:why-0018 ;
    prov:generated gsnaugprov:st-0026 .

gsnaugprov:st-0026
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0026 ;
    gsnprov:inGraph gsnaugprov:augmentation-shapes-0.2.0 ;
    gsnprov:statementText "gsnaugsh:ArtefactShape constrains gsnaug:storedIn, retrievableWith, generatedWith, verifiedWith and generatedBy to their declared ranges." ;
    gsnprov:aboutTerm gsnaugsh:ArtefactShape ;
    gsnprov:mentionsTerm gsnaug:generatedBy , gsnaug:generatedWith , gsnaug:retrievableWith , gsnaug:storedIn , gsnaug:verifiedWith .

gsnaugprov:dd-0027
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:SHACL ;
    gsnprov:naturalLanguage "Evidence provenance found on a solution is reported as a warning, not as a violation."@en ;
    prov:used gsnaugprov:src-0007 ;
    gsnprov:hasRationale gsnaugprov:why-0019 ;
    prov:generated gsnaugprov:st-0027 .

gsnaugprov:st-0027
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0027 ;
    gsnprov:inGraph gsnaugprov:augmentation-shapes-0.2.0 ;
    gsnprov:statementText "gsnaugsh:SolutionProvenanceShape sh:severity sh:Warning ." ;
    gsnprov:aboutTerm gsnaugsh:SolutionProvenanceShape ;
    gsnprov:mentionsTerm gsnaugsh:SolutionProvenanceShape .

gsnaugprov:dd-0028
    a gsnprov:RetiredDecision ;
    gsnprov:retirementReason """Withdrawn at 0.2.0 with gsnaugsh:TopContextCompletenessShape. A shape that ships switched off and whose classes no longer exist constrains nothing at all."""@en ;
    gsnprov:supersededBy gsnaugprov:dd-0041 ;
    gsnprov:formalism gsnprov:SHACL ;
    gsnprov:naturalLanguage "The shape that would require both top-level contexts is shipped switched off."@en ;
    prov:used gsnaugprov:src-0008 ;
    gsnprov:hasRationale gsnaugprov:why-0020 ;
    prov:generated gsnaugprov:st-0028 .

gsnaugprov:st-0028
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0028 ;
    gsnprov:inGraph gsnaugprov:augmentation-shapes-0.1.0 ;
    gsnprov:statementText "gsnaugsh:TopContextCompletenessShape sh:deactivated true ." ;
    gsnprov:aboutTerm gsnaugsh:TopContextCompletenessShape ;
    gsnprov:mentionsTerm gsnaugsh:TopContextCompletenessShape .

gsnaugprov:dd-0029
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:SHACL ;
    gsnprov:naturalLanguage "The shape pairing each kind of answer with its kind of issue is one flat filter, because neither of the two natural ways to write it works."@en ;
    prov:used gsnaugprov:src-0005 ;
    gsnprov:hasRationale gsnaugprov:why-0021 ;
    prov:generated gsnaugprov:st-0029 .

gsnaugprov:st-0029
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0029 ;
    gsnprov:inGraph gsnaugprov:augmentation-shapes-0.2.0 ;
    gsnprov:statementText "gsnaugsh:AnswerAgreementShape sh:sparql [ sh:select \"... FILTER ( (?answerClass = gsnaug:Clarification && ?type != gsnaug:clarify) || ... )\" ] ." ;
    gsnprov:aboutTerm gsnaugsh:AnswerAgreementShape ;
    gsnprov:mentionsTerm gsnaugsh:AnswerAgreementShape .

gsnaugprov:dd-0030
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:SHACL ;
    gsnprov:naturalLanguage "That an issue cannot supersede itself is checked by a shape as well as stated in the vocabulary."@en ;
    gsnprov:noSourceRecorded "true"^^xsd:boolean ;
    gsnprov:hasRationale gsnaugprov:why-0025 ;
    prov:generated gsnaugprov:st-0030 .

gsnaugprov:st-0030
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0030 ;
    gsnprov:inGraph gsnaugprov:augmentation-shapes-0.2.0 ;
    gsnprov:statementText "gsnaugsh:IssueSupersessionShape sh:sparql [ sh:select \"SELECT $this WHERE { $this gsnaug:supersedes $this . }\" ] ." ;
    gsnprov:aboutTerm gsnaugsh:IssueSupersessionShape ;
    gsnprov:mentionsTerm gsnaug:supersedes , gsnaugsh:IssueSupersessionShape .

gsnaugprov:dd-0038
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:SHACL ;
    gsnprov:naturalLanguage "The ranges and arities of the seven terms added for the compliance process are repeated as shapes, on the same reasoning as the first six."@en ;
    gsnprov:noSourceRecorded "true"^^xsd:boolean ;
    gsnprov:hasRationale gsnaugprov:why-0018 ;
    prov:generated gsnaugprov:st-0038 .

gsnaugprov:st-0038
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0038 ;
    gsnprov:inGraph gsnaugprov:augmentation-shapes-0.2.0 ;
    gsnprov:statementText "gsnaugsh:IssueShape constrains gsnaug:issueOutcome to the three concepts and gsnaug:raisedIn, gsnaug:raisedBy and gsnaug:heldBy to their ranges, each at most once. gsnaugsh:AnswerShape constrains gsnaug:accepted to one boolean. gsnaugsh:ArtefactShape constrains gsnaug:revisionOf to gsn:Artefact. gsnaugsh:MechanismAutomationShape constrains gsnaug:automated to one boolean." ;
    gsnprov:aboutTerm gsnaugsh:IssueShape ;
    gsnprov:mentionsTerm gsnaug:accepted , gsnaug:automated , gsnaug:heldBy , gsnaug:issueOutcome ,
        gsnaug:raisedBy , gsnaug:raisedIn , gsnaug:revisionOf , gsnaugsh:MechanismAutomationShape .

gsnaugprov:dd-0039
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:SHACL ;
    gsnprov:naturalLanguage "An issue closed both by an outcome and by an answer the raiser accepted is reported, because the two ways of ending an ask are exclusive."@en ;
    prov:used gsnaugprov:src-0010 ;
    gsnprov:hasRationale gsnaugprov:why-0033 ;
    prov:generated gsnaugprov:st-0039 .

gsnaugprov:st-0039
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0039 ;
    gsnprov:inGraph gsnaugprov:augmentation-shapes-0.2.0 ;
    gsnprov:statementText "gsnaugsh:IssueClosureShape sh:sparql [ sh:select \"SELECT $this ?answer WHERE { $this gsnaug:issueOutcome ?outcome . ?answer gsnaug:answers $this ; gsnaug:accepted true . }\" ] ." ;
    gsnprov:aboutTerm gsnaugsh:IssueClosureShape ;
    gsnprov:mentionsTerm gsnaug:accepted , gsnaug:answers , gsnaug:issueOutcome , gsnaugsh:IssueClosureShape .


#################################################################
#    Decisions - 0.2.0, naming the far ends
#################################################################

gsnaugprov:dd-0040
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:OWL ;
    gsnprov:naturalLanguage "What an issue may be raised against is a union of the six kinds of thing a case is made of, and a shape rejects a target outside it."@en ;
    prov:used gsnaugprov:src-0002 ;
    gsnprov:hasRationale gsnaugprov:why-0034 ;
    prov:generated gsnaugprov:st-0040 .

gsnaugprov:st-0040
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0040 ;
    gsnprov:inGraph gsnaugprov:augmentation-0.2.0 ;
    gsnprov:statementText "gsnaug:raisedAgainst rdfs:range [ (gsn:Argument or gsn:Artefact or gsn:AssuranceCase or gsn:GSNElement or gsn:Pattern or gsn:Relationship) ] ." ;
    gsnprov:aboutTerm gsnaug:raisedAgainst ;
    gsnprov:mentionsTerm gsn:Argument , gsn:Artefact , gsn:AssuranceCase , gsn:GSNElement ,
        gsn:Pattern , gsn:Relationship , gsnaug:raisedAgainst .

gsnaugprov:dd-0041
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:OWL ;
    gsnprov:naturalLanguage "The two top-level context subclasses, the two rules that read them and the shapes that checked them are withdrawn; what they expressed is asserted directly."@en ;
    prov:used gsnaugprov:src-0008 ;
    gsnprov:hasRationale gsnaugprov:why-0035 ;
    prov:generated gsnaugprov:st-0041 .

gsnaugprov:st-0041
    a gsnprov:StatementRecord ;
    prov:wasGeneratedBy gsnaugprov:dd-0041 ;
    gsnprov:inGraph gsnaugprov:augmentation-0.2.0 ;
    gsnprov:statementText "gsnaug:TopSubjectContext, gsnaug:TopObjectContext, gsnaug:TopSubjectContextRequirement, gsnaug:TopObjectContextAssurance, gsnaugsh:TopContextAgreementShape and gsnaugsh:TopContextCompletenessShape are removed." ;
    gsnprov:aboutTerm gsnaug:assures ;
    gsnprov:mentionsTerm gsnaug:assures , gsnaug:requiredBy .

