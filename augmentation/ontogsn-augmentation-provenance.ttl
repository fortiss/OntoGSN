gsnaugprov:dd-0019
    a gsnprov:DesignDecision ;
    gsnprov:formalism gsnprov:OWL ;
    gsnprov:naturalLanguage "Which row of instantiation data produced an element is recorded on the element, and depends on the widened reference domain of OntoGSN 1.2.4."@en ;
    gsnprov:noSourceRecorded "true"^^xsd:boolean ;
    gsnprov:hasRationale gsnaugprov:why-0024 ;
    prov:generated gsnaugprov:st-0019 .

