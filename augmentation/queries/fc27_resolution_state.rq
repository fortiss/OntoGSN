PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?issueId ?targetId ?state ?responded
WHERE {
  ?issue a gsnaug:Issue ;
         schema:identifier ?issueId ;
         gsnaug:issueType gsnaug:resolve ;
         gsnaug:raisedAgainst ?target .
  ?target schema:identifier ?targetId .
  OPTIONAL { ?issue gsnaug:issueOutcome ?outcome }
  BIND( IF(BOUND(?outcome), STR(?outcome), "open") AS ?state )
  BIND( EXISTS { ?response gsnaug:respondsTo ?issue } AS ?responded )
}
ORDER BY ?issueId
