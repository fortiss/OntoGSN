# id:        CQ-66
# role:      Developer
# operation: read
# question:  What did a revision actually change - which artefact replaced which?
# expect:    rows
#
# Artefact versions only. A reworded claim is not a revision in this sense.
#
# The issue is a revise or a resolve issue, because a resolution can also replace an artefact.
# It is raised against an element that still refers to the older artefact, or it is in
# context of one that does. A case that points the revised solution at the newer artefact
# can keep the older one in the context of the issue.

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT DISTINCT ?newer ?older ?mechanism ?issueId
WHERE {
  ?newer gsnaug:replaces ?older .
  OPTIONAL { ?newer gsnaug:generatedWith ?mechanism }
  OPTIONAL {
    {
      ?solution gsn:refersTo ?older .
      ?issue gsnaug:raisedAgainst ?solution .
    }
    UNION
    {
      ?context gsn:refersTo ?older .
      ?issue gsn:inContextOf ?context .
    }
    ?issue gsnaug:issueType ?type ;
           schema:identifier ?issueId .
    FILTER(?type IN (gsnaug:revise, gsnaug:resolve))
  }
}
ORDER BY ?newer
