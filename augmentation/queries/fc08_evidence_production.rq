# id:        CQ-50
# role:      Developer
# operation: read
# question:  Does the evidence exist yet, and how was it produced - by whom, with what, from what?
# expect:    rows
#
# A solution with no artefact is evidence that does not exist yet, so the artefact is optional.

PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?solutionId ?artefact ?author ?mechanism ?source
WHERE {
  ?solution a gsn:Solution ;
            schema:identifier ?solutionId .
  OPTIONAL {
    ?solution gsn:refersTo ?artefact .
    OPTIONAL { ?artefact gsnaug:generatedBy   ?author }
    OPTIONAL { ?artefact gsnaug:generatedWith ?mechanism }
    OPTIONAL { ?artefact gsnaug:generatedFrom ?source }
  }
}
ORDER BY ?solutionId
