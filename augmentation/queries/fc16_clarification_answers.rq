PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?response ?issueId ?description ?outcome
WHERE {
  ?response a gsnaug:Response ;
            gsnaug:respondsTo ?issue .
  ?issue schema:identifier ?issueId ;
         gsnaug:issueType gsnaug:clarify .
  OPTIONAL { ?response schema:description ?description }
  OPTIONAL { ?issue gsnaug:issueOutcome ?outcome }
}
ORDER BY ?issueId
