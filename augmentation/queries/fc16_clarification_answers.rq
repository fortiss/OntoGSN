# id:        CQ-58
# role:      Auditor
# operation: read
# question:  What answered a clarification, and which ask did it close?
# expect:    rows

PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX schema:  <http://schema.org/>

SELECT ?answer ?issueId ?description
WHERE {
  ?answer a gsnaug:Answer ;
          gsnaug:answers ?issue .
  ?issue schema:identifier ?issueId ;
         gsnaug:issueType gsnaug:clarify .
  OPTIONAL { ?answer schema:description ?description }
}
ORDER BY ?issueId
