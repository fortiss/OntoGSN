PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX gsnaug:  <https://w3id.org/OntoGSN/augmentation#>
PREFIX prov:    <http://www.w3.org/ns/prov#>
PREFIX schema:  <http://schema.org/>

SELECT DISTINCT ?goalId ?contextId ?artefact ?newerArtefact
WHERE {
  ?context a gsn:Context ;
           schema:identifier ?contextId ;
           gsn:refersTo ?artefact .
  ?newerArtefact (gsnaug:replaces|prov:wasRevisionOf)+ ?artefact .
  FILTER NOT EXISTS { ?context gsn:refersTo ?newerArtefact }
  ?holder gsn:inContextOf ?context ;
          gsn:supportedBy* ?goal .
  ?goal a gsn:Goal ;
        schema:identifier ?goalId .
}
ORDER BY ?goalId ?contextId
