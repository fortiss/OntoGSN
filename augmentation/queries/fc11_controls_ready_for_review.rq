PREFIX gsn:     <https://w3id.org/OntoGSN/ontology#>
PREFIX schema:  <http://schema.org/>

SELECT ?goalId ?solutionId ?artefact
WHERE {
  ?goal a gsn:Goal ;
        schema:identifier ?goalId ;
        gsn:supportedBy ?solution .
  ?solution a gsn:Solution ;
            schema:identifier ?solutionId ;
            gsn:refersTo ?artefact .
  FILTER NOT EXISTS { ?goal     gsn:undeveloped true }
  FILTER NOT EXISTS { ?solution gsn:undeveloped true }
}
ORDER BY ?goalId ?solutionId
