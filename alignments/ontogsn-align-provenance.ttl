gsnalignprov:ArgOPaper
    a gsnalignprov:CitedArtefact ;
    rdfs:label "ArgO: Arguments Ontology (paper)"@en ;
    dc:creator "John Beverley, J. Neil Otte, Francesco Franda, Jean-Baptiste Guillon, Brian Donohue, Alan Ruttenberg, Yonatan Schreiber"@en ;
    skos:note "The design rationale for ARGO. Cited where the ontology file records a decision without explaining it, and for the two extensions ARGO recommends but does not implement."@en .

